---
/**
 * Feature detail page, on the ZenML Labs shell (integrations + features
 * cutover #318): short shader band (breadcrumb, category eyebrow, title,
 * deck) → an optional framed figure (a drawn highlight figure on the five
 * `FEATURE_HIGHLIGHT_FIGURES` slugs, else the entry's own `hero.image`) →
 * the content-driven block sequence (`labs.feature-split` value blocks and
 * `labs.compliance-card` compliance blocks) → an optional testimonial quote
 * → an optional closing band.
 *
 * Generates /features/<slug> for each of the 12 published feature pages.
 */
import { getCollection } from "astro:content";
import ComplianceCard from "../../components/labs/ComplianceCard.astro";
import FeatureSplit from "../../components/labs/FeatureSplit.astro";
import { HIGHLIGHT_FIGURES } from "../../components/labs/highlights";
import LabsBand from "../../components/labs/LabsBand.astro";
import LabsCloseCta from "../../components/labs/LabsCloseCta.astro";
import LabsStoryCard from "../../components/labs/LabsStoryCard.astro";
import Breadcrumb from "../../components/system/Breadcrumb.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BAND_CONTENT_GAP } from "../../lib/blogLayout";
import {
  FEATURE_COMPLIANCE_DEFAULTS,
  FEATURE_DETAIL_CLOSE,
  FEATURE_HIGHLIGHT_FIGURES,
} from "../../lib/features";

export async function getStaticPaths() {
  const features = await getCollection(
    "feature-pages",
    ({ data }) => !data.draft,
  );
  return features.map((feature) => ({
    params: { slug: feature.data.slug },
    props: { feature },
  }));
}

const { feature } = Astro.props;
const { data } = feature;

const highlightId = FEATURE_HIGHLIGHT_FIGURES[data.slug];
const HighlightFigure = highlightId
  ? HIGHLIGHT_FIGURES[highlightId]
  : undefined;

// The reveal's stagger classes only go up to 3 (the copied style block
// below); a page with more than 3 blocks cycles back through them rather
// than growing new delay tiers.
const staggerClass = (i: number) => `stagger-${(i % 3) + 1}`;

// SEO
const seoTitle = data.seo?.title || `${data.hub.title} - ZenML Features`;
const seoDescription = data.seo?.description || data.hero.deck;
const ogImage = data.seo?.ogImage || data.hero.image?.url;
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  ogImage={ogImage}
  ogTitle={data.seo?.ogTitle}
  ogDescription={data.seo?.ogDescription}
  canonical={data.seo?.canonical}
  surface="ml"
  app="labs"
  product="zenml"
>
  <LabsBand size="short">
    <div class="scroll-reveal-section">
      <div class="flex flex-col gap-4">
        <Breadcrumb
          class="reveal-child"
          items={[
            { label: "Features", href: "/features" },
            { label: data.hub.title },
          ]}
          separator="chevron"
        />
        <div class="reveal-child stagger-1">
          <p class="font-label text-[13px] leading-4 tracking-[0.05em] uppercase text-(--color-cream-700)">
            {data.hub.category}
          </p>
          <h1 class="font-display text-[40px] leading-[44px] text-(--color-cream-900) md:text-[64px] md:leading-[70px]">
            {data.title}
          </h1>
          <p class="mt-space-sm max-w-[690px] font-sans text-[17px] leading-[26px] text-foreground md:text-xl md:leading-[30px]">
            {data.hero.deck}
          </p>
        </div>
      </div>
    </div>
  </LabsBand>

  {(HighlightFigure || data.hero.image) && (
    <section class:list={["scroll-reveal-section pb-24 md:pb-32", BAND_CONTENT_GAP]}>
      <div class="reveal-child mx-auto max-w-content px-gutter">
        {HighlightFigure ? (
          <div
            class="flex justify-center rounded-[20px] border border-(--color-border) bg-(--background) p-6 md:p-10"
            data-highlight-active
          >
            <HighlightFigure label={data.hero.image?.alt ?? data.title} />
          </div>
        ) : (
          data.hero.image && (
            <img
              class="w-full rounded-[20px] border border-(--color-border) bg-card p-6"
              src={data.hero.image.url}
              alt={data.hero.image.alt || data.title}
              loading="eager"
            />
          )
        )}
      </div>
    </section>
  )}

  <section id="feature-blocks" class="scroll-reveal-section pb-24 md:pb-32">
    <div class="mx-auto flex max-w-content flex-col gap-20 px-gutter">
      {data.blocks.map((block, i) =>
        block.kind === "value" ? (
          <div class:list={["reveal-child", staggerClass(i)]}>
            <FeatureSplit
              title={block.title}
              body={block.body}
              bullets={block.bullets}
              image={block.image}
              imageSide={block.imageSide ?? "right"}
            />
          </div>
        ) : (
          <div class:list={["reveal-child", staggerClass(i)]}>
            <ComplianceCard
              badges={(block.badges ?? []).map((b) => ({
                url: b.url,
                alt: b.alt ?? "Compliance badge",
              }))}
              eyebrow={block.eyebrow ?? FEATURE_COMPLIANCE_DEFAULTS.eyebrow}
              headline={block.headline ?? FEATURE_COMPLIANCE_DEFAULTS.headline}
              body={block.body ?? FEATURE_COMPLIANCE_DEFAULTS.body}
            />
          </div>
        ),
      )}
    </div>
  </section>

  {data.testimonial && (
    <section class="scroll-reveal-section pb-24 md:pb-32">
      <div class="mx-auto max-w-content px-gutter">
        <div class="reveal-child mx-auto max-w-[768px]">
          <LabsStoryCard
            kind="quote"
            quote={data.testimonial.quote}
            name={data.testimonial.name}
            title={data.testimonial.title}
            avatar={data.testimonial.avatar?.url}
            logo={
              data.testimonial.companyLogo
                ? {
                    url: data.testimonial.companyLogo.url,
                    alt: data.testimonial.companyLogo.alt ?? data.testimonial.name,
                  }
                : undefined
            }
          />
        </div>
      </div>
    </section>
  )}

  {data.showFinalCta && <LabsCloseCta content={FEATURE_DETAIL_CLOSE} />}
</BaseLayout>

<style>
  /* House scroll-reveal pattern (reference: LabsRelatedBand.astro). */
  .reveal-child {
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }
  .stagger-1 { transition-delay: 60ms; }
  .stagger-2 { transition-delay: 120ms; }
  .stagger-3 { transition-delay: 180ms; }

  .scroll-reveal-section.reveal-armed:not(.in-view) .reveal-child {
    opacity: 0;
    transform: translateY(12px);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-child,
    .scroll-reveal-section.reveal-armed:not(.in-view) .reveal-child {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  import { initScrollReveal } from "../../scripts/labs-scroll-reveal";

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initScrollReveal);
  } else {
    initScrollReveal();
  }
</script>
