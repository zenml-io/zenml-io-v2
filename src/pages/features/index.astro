---
/**
 * Features hub page, on the ZenML Labs shell (integrations + features
 * cutover #318): short shader band (eyebrow + headline + deck), a grid of
 * the 7 feature category cards (`labs.feature-card`, from the hardcoded
 * `HUB_CARDS` list, not a collection), then one closing CTA band.
 *
 * Route: /features
 */
import FeatureCard from "../../components/labs/FeatureCard.astro";
import LabsBand from "../../components/labs/LabsBand.astro";
import LabsCloseCta from "../../components/labs/LabsCloseCta.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BAND_CONTENT_GAP } from "../../lib/blogLayout";
import {
  FEATURES_HUB_CLOSE,
  FEATURES_HUB_HERO,
  HUB_CARDS,
} from "../../lib/features";
---

<BaseLayout
  title="ZenML - AI Orchestration Features"
  description="Orchestrate AI workflows with ZenML: end manual deployments and non-reproducible experiments with production-ready pipelines on your own stack."
  ogTitle="ZenML - AI Orchestration Features"
  surface="ml"
  app="labs"
  product="zenml"
>
  <LabsBand size="short">
    <div class="scroll-reveal-section">
      <div class="flex flex-col gap-4">
        <p class="reveal-child font-label text-[13px] leading-4 tracking-[0.05em] uppercase text-(--color-cream-700)">
          Features
        </p>
        <div class="reveal-child stagger-1">
          <h1 class="font-display text-[40px] leading-[44px] text-(--color-cream-900) md:text-[64px] md:leading-[70px]">
            {FEATURES_HUB_HERO.headline}
          </h1>
          <p class="mt-space-sm max-w-[690px] font-sans text-[17px] leading-[26px] text-foreground md:text-xl md:leading-[30px]">
            {FEATURES_HUB_HERO.body}
          </p>
        </div>
      </div>
    </div>
  </LabsBand>

  <section class:list={["scroll-reveal-section pb-24 md:pb-32", BAND_CONTENT_GAP]}>
    <div class="reveal-child stagger-1 mx-auto max-w-content px-gutter">
      <div id="features-grid" class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {HUB_CARDS.map((card) => (
          <FeatureCard
            href={`/features/${card.slug}`}
            category={card.category}
            title={card.title}
            summary={card.summary}
          />
        ))}
      </div>
    </div>
  </section>

  <LabsCloseCta content={FEATURES_HUB_CLOSE} />
</BaseLayout>

<style>
  /* House scroll-reveal pattern (reference: LabsRelatedBand.astro). */
  .reveal-child {
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }
  .stagger-1 { transition-delay: 60ms; }

  .scroll-reveal-section.reveal-armed:not(.in-view) .reveal-child {
    opacity: 0;
    transform: translateY(12px);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-child,
    .scroll-reveal-section.reveal-armed:not(.in-view) .reveal-child {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  import { initScrollReveal } from "../../scripts/labs-scroll-reveal";

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initScrollReveal);
  } else {
    initScrollReveal();
  }
</script>
