---
import BlogNewsletterCta from "../components/labs/BlogNewsletterCta.astro";
import LabsButton from "../components/labs/LabsButton.astro";
import LabsEditorialSection from "../components/labs/LabsEditorialSection.astro";
import LabsOpenRoles from "../components/labs/LabsOpenRoles.astro";
import LabsPageHeader from "../components/labs/LabsPageHeader.astro";
import LabsValuesGrid from "../components/labs/LabsValuesGrid.astro";
import ProcessSteps from "../components/templates/ProcessSteps.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  CAREERS_HERO,
  CAREERS_HIRING_PROCESS,
  CAREERS_MISSION,
  CAREERS_SEO,
  CAREERS_WHY,
} from "../lib/careers";
import { OPEN_POSITIONS } from "../lib/company";
---

<BaseLayout
  title={CAREERS_SEO.title}
  description={CAREERS_SEO.description}
  ogTitle={CAREERS_SEO.ogTitle}
  ogDescription={CAREERS_SEO.ogDescription}
  ogImage={CAREERS_SEO.ogImage}
  surface="unified"
  app="labs"
>
  <main>
    <LabsPageHeader
      eyebrow={CAREERS_HERO.eyebrow}
      heading={CAREERS_HERO.headline}
      description={CAREERS_HERO.deck}
      align="center"
    >
      <div class="mt-space-lg flex flex-wrap items-center justify-center gap-space-sm">
        <LabsButton
          cta={{
            label: CAREERS_HERO.primaryCta.label,
            href: CAREERS_HERO.primaryCta.href,
            analytics: "Careers-Open-Positions",
          }}
          tone="dark"
        />
        <LabsButton
          cta={{
            label: CAREERS_HERO.secondaryCta.label,
            href: CAREERS_HERO.secondaryCta.href,
            analytics: "Careers-Meet-Team",
          }}
          tone="ghost"
        />
      </div>
    </LabsPageHeader>

    <LabsEditorialSection
      headline={CAREERS_MISSION.headline}
      body={{ kind: "html", value: CAREERS_MISSION.body }}
      image={CAREERS_MISSION.image}
      ctas={[
        {
          label: CAREERS_MISSION.primaryCta.label,
          href: CAREERS_MISSION.primaryCta.href,
          external: true,
          analytics: "Careers-Mission-GitHub",
        },
        {
          label: CAREERS_MISSION.secondaryCta.label,
          href: CAREERS_MISSION.secondaryCta.href,
          analytics: "Careers-Mission-LearnMore",
        },
      ]}
    />

    <LabsValuesGrid
      id="why-here"
      heading={CAREERS_WHY.headline}
      values={CAREERS_WHY.items.map((item) => ({
        title: item.title,
        body: item.body,
      }))}
    />

    <section class="scroll-reveal-section py-space-xl md:py-space-xxl">
      <div class="mx-auto max-w-content px-gutter">
        <h2 class="font-display text-[32px] leading-[38px] text-(--color-cream-900) md:text-[40px] md:leading-[46px]">
          {CAREERS_HIRING_PROCESS.headline}
        </h2>
        <p class="mt-space-md max-w-[760px] font-sans text-[17px] leading-[26px] text-(--color-cream-700)">
          {CAREERS_HIRING_PROCESS.intro}
        </p>
        <p class="mt-space-sm max-w-[760px] font-sans text-[17px] leading-[26px] text-(--color-cream-700)">
          {CAREERS_HIRING_PROCESS.afterIntro}
        </p>
        <ProcessSteps
          layout="compact-list"
          numeralStyle="zero-padded"
          skin="labs"
          steps={CAREERS_HIRING_PROCESS.steps}
          class="mt-space-lg"
        />
      </div>
    </section>

    <LabsOpenRoles positions={OPEN_POSITIONS} />
    <BlogNewsletterCta />
  </main>
</BaseLayout>
