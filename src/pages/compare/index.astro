---
/**
 * Compare hub page — Phase 3.
 *
 * Two visually-distinct sections, one per product:
 *   - Agent comparisons (Kitaru vs X) — warm-orange tinted
 *   - ZenML comparisons — sage-green tinted
 *
 * Clicking an Agent card → /compare/kitaru-vs-X (Kitaru template,
 * theme flipped to data-app="kitaru").
 * Clicking a ZenML card → /compare/zenml-vs-X. The ZenML section merges
 * two collections into one grid; src/lib/compareHub.ts normalises both
 * sections' cards so the grid does not care which collection a row came
 * from (the Markdown mirror at /compare.md reads the same lists).
 */
import SectionIntro from "../../components/system/SectionIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getKitaruCompareCards,
  getZenmlCompareCards,
} from "../../lib/compareHub";

const [kitaruCards, zenmlCards] = await Promise.all([
  getKitaruCompareCards(),
  getZenmlCompareCards(),
]);
---

<BaseLayout
  title="Compare: ZenML and Kitaru vs. alternatives"
  description="Side-by-side comparisons of ZenML (AI orchestration) and Kitaru (agent replay) against other tools and platforms."
  surface="unified"
>
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <header class="mb-12 max-w-3xl">
      <SectionIntro
        eyebrow="Compare"
        heading="Pick the right tool for the job."
        headingLevel={1}
        description="Kitaru for agent replay, ZenML for AI workflow orchestration. See how each holds up against the other tools you might be considering."
        classOverrides={{
          eyebrow: "text-sm font-semibold uppercase tracking-wider text-zenml-600",
          heading: "text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl",
          description: "text-lg text-gray-600",
        }}
      />
    </header>
  </div>

  {/* ════════════════════════════════════════════════════════════════════
       Agents — Kitaru comparisons (warm orange tint), listed first
       ════════════════════════════════════════════════════════════════════ */}
  <section class="border-y border-orange-200/60 bg-orange-50/50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="mb-10 flex items-center gap-4">
        <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-orange-400/15 text-orange-700">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 6v6l4 2"/>
          </svg>
        </span>
        <SectionIntro
          eyebrow="Agents · Kitaru"
          heading="Kitaru vs. agent frameworks and SDKs"
          classOverrides={{
            eyebrow: "text-xs font-semibold uppercase tracking-[0.15em] text-orange-700",
            heading: "text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl",
            headingSpacing: "",
          }}
        />
      </div>

      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {kitaruCards.map((card) => (
          <a
            href={card.href}
            class="group flex items-center gap-4 rounded-lg border border-orange-200/60 bg-white p-5 transition-all hover:border-orange-400/60 hover:shadow-md"
          >
            {card.logo ? (
              <img
                src={card.logo}
                alt={card.name}
                class="h-10 w-10 shrink-0 rounded-md object-contain"
              />
            ) : (
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-orange-100 text-base font-bold text-orange-600">
                {card.name[0]}
              </div>
            )}
            <div class="min-w-0">
              <h3 class="truncate font-semibold text-gray-900 group-hover:text-orange-700">
                {card.title}
              </h3>
              {card.sub && (
                <p class="mt-0.5 text-xs leading-snug text-gray-500 line-clamp-2">
                  {card.sub.text}
                </p>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ════════════════════════════════════════════════════════════════════
       AI orchestration — ZenML comparisons (sage green tint)
       ════════════════════════════════════════════════════════════════════ */}
  <section class="border-y border-zenml-100 bg-zenml-25/50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="mb-10 flex items-center gap-4">
        <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-zenml-500/15 text-zenml-700">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2 2 7l10 5 10-5-10-5Z"/>
            <path d="m2 17 10 5 10-5"/>
            <path d="m2 12 10 5 10-5"/>
          </svg>
        </span>
        <SectionIntro
          eyebrow="AI orchestration · ZenML"
          heading="ZenML vs. orchestrators, durable execution engines & agent frameworks"
          classOverrides={{
            eyebrow: "text-xs font-semibold uppercase tracking-[0.15em] text-zenml-700",
            heading: "text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl",
            headingSpacing: "",
          }}
        />
      </div>

      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {zenmlCards.map((card) => (
          <a
            href={card.href}
            class="group flex items-center gap-4 rounded-lg border border-zenml-100 bg-white p-5 transition-all hover:border-zenml-300 hover:shadow-md"
          >
            {card.logo ? (
              <img
                src={card.logo}
                alt={card.name}
                class="h-10 w-10 shrink-0 rounded-md object-contain"
              />
            ) : (
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-zenml-50 text-base font-bold text-zenml-600">
                {card.name[0]}
              </div>
            )}
            <div class="min-w-0">
              <h3 class="truncate font-semibold text-gray-900 group-hover:text-zenml-700">
                {card.title}
              </h3>
              {card.sub && (
                <p
                  class={
                    card.sub.kind === "category"
                      ? "mt-0.5 text-xs uppercase tracking-wider text-gray-500"
                      : "mt-0.5 text-xs leading-snug text-gray-500 line-clamp-2"
                  }
                >
                  {card.sub.text}
                </p>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
