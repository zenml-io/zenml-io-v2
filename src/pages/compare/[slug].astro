---
/**
 * Compare detail dispatcher — /compare/<slug>
 *
 * Routes BOTH the MLOps (ZenML) comparisons and the Agents (Kitaru)
 * comparisons under the same URL prefix. Slug patterns don't overlap
 * (`zenml-vs-*` vs `kitaru-vs-*`), so a single getStaticPaths can emit
 * both and we branch on `kind` to the right template.
 *
 * MLOps detail = src/components/compare/_layouts/MlopsCompare.astro
 *                (the 9-section ZenML template — sage green chrome)
 * Agents detail = src/components/compare/_layouts/KitaruCompare.astro
 *                (Kitaru's MDX-driven template — warm orange chrome via
 *                data-app="kitaru")
 */
import { getCollection } from "astro:content";
import KitaruCompare from "../../components/compare/_layouts/KitaruCompare.astro";
import MlopsCompare from "../../components/compare/_layouts/MlopsCompare.astro";

export async function getStaticPaths() {
  const mlopsItems = await getCollection(
    "compare",
    ({ data }) => !data.draft,
  );
  const agentItems = await getCollection(
    "compare-kitaru",
    ({ data }) => !data.draft,
  );

  // Agent detail pages need the full list of siblings for the hero dropdown.
  const competitorOptions = agentItems
    .slice()
    .sort((a, b) => a.data.order - b.data.order)
    .map((e) => ({
      slug: e.id,
      competitor: e.data.competitor,
      competitorLogo: e.data.competitorLogo,
    }));

  return [
    ...mlopsItems.map((item) => ({
      params: { slug: item.data.slug },
      props: { kind: "mlops" as const, item },
    })),
    ...agentItems.map((entry) => ({
      params: { slug: entry.id },
      props: { kind: "agents" as const, entry, competitorOptions },
    })),
  ];
}

const props = Astro.props;
---

{
  props.kind === "agents" ? (
    <KitaruCompare
      entry={props.entry}
      competitorOptions={props.competitorOptions}
    />
  ) : (
    <MlopsCompare item={props.item} />
  )
}
