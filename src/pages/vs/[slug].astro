---
/**
 * VS category page — /vs/<slug>
 *
 * Renders static marketing pages comparing ZenML to categories of tools
 * (orchestrators, experiment trackers, e2e platforms) through the shared
 * ComparisonPage template (see its docblock for the full block/hero/SEO
 * contract for this family).
 *
 * The relatedCompare block dynamically pulls matching entries from the
 * compare collection by category — built once here and passed down, rather
 * than recomputed inside the template.
 *
 * Generates /vs/<slug> for each of the 3 VS category pages.
 */
import { getCollection } from "astro:content";
import ComparisonPage from "../../components/compare/_layouts/ComparisonPage.astro";
import type { RelatedRailItem } from "../../components/templates/RelatedRail.astro";

export async function getStaticPaths() {
  const vsPages = await getCollection("vs-pages", ({ data }) => !data.draft);
  const compareEntries = await getCollection(
    "compare",
    ({ data }) => !data.draft,
  );

  return vsPages.map((page) => {
    // Filter compare entries by this page's category
    const related: RelatedRailItem[] = compareEntries
      .filter((c) => c.data.category === page.data.hero.compareCategory)
      .map((c) => ({
        kind: "icon-link",
        title: `ZenML vs ${c.data.toolName || c.data.title}`,
        href: `/compare/${c.data.slug}`,
        icon: c.data.toolIcon
          ? { src: c.data.toolIcon.url, alt: c.data.toolIcon.alt || "" }
          : undefined,
      }));

    return {
      params: { slug: page.data.slug },
      props: { page, related },
    };
  });
}

const { page, related } = Astro.props;
---

<ComparisonPage item={page} related={related} />
