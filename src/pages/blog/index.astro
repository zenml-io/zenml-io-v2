---
/**
 * Blog listing page, in the ZenML Labs shell (`app="labs"`, `surface="ml"`
 * — D3). Rebuilt for the blog cutover (DESIGN.md): the short shader band
 * (h1 + the page's own SEO description as its dek, no copy change; the exact
 * post count sits in the results header below), then the shared
 * `DataFilterIndex` island skinned
 * "labs" (search/sort/facet-rail/pagination classes only — behaviour,
 * data semantics and PAGE_SIZE are unchanged; see BlogIndex.tsx/labsSkin.ts).
 *
 * Migrated onto the shared FilterIndex island (#249), matching the
 * LLMOps/MLOps database pages: a facet rail (Category single-select, Tags
 * multi-select) + search box + client-side pagination. The island gets the
 * search-index entries as props (not via fetch) so the first page of post
 * cards is real server-rendered HTML — /blog is a high-volume SEO surface
 * and must keep crawlable post links when JavaScript fails (guarded by
 * check-dist-smoke.ts).
 *
 * Only main-feed posts (getMainFeedPosts — excludes drafts and the
 * "discovery" tag corpus) ever reach the rail's facets or results.
 *
 * Deep links (?page=N, ?category=..., ?q=...) are honored at hydration:
 * this page is statically prerendered, so the served HTML is always page 1
 * unfiltered and the island snaps to the URL state on mount. That is the
 * same contract as the LLMOps/MLOps database pages' bookmarked filter
 * URLs — a request-time render would need prerender=false, which /blog
 * deliberately is not.
 */
import BlogIndex from "../../components/islands/filter-index/BlogIndex";
import BlogNewsletterCta from "../../components/labs/BlogNewsletterCta.astro";
import LabsHero from "../../components/labs/LabsHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  buildBlogSearchIndex,
  getCategoryCounts,
  getMainFeedPosts,
  getTagCounts,
  PAGE_SIZE,
} from "../../lib/blog";
import { BAND_CONTENT_GAP, blogLaneStyle } from "../../lib/blogLayout";

const PAGE_DESCRIPTION =
  "Insights on MLOps, LLMOps, and production machine learning from the ZenML team.";

const mainFeedPosts = await getMainFeedPosts();
const searchEntries = await buildBlogSearchIndex(mainFeedPosts);

// Facet option universes: only categories/tags with at least one main-feed
// post — a term used exclusively by the discovery corpus never appears here.
const categoryOptions = (await getCategoryCounts(mainFeedPosts))
  .map(({ slug, name }) => ({ slug, name }))
  .sort((a, b) => a.name.localeCompare(b.name));
const tagOptions = (await getTagCounts(mainFeedPosts))
  .map(({ slug, name }) => ({ slug, name }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout title="Blog - ZenML" description={PAGE_DESCRIPTION} surface="ml" app="labs">
  <div style={blogLaneStyle()}>
    {/* Opening band: the homepage hero's shader and type at ~40% of the viewport (short band), dek = the page's own SEO description. The exact post count lives in the results header below. */}
    <LabsHero band="short" content={{ headline: "Blog", deck: PAGE_DESCRIPTION }} />

    {/* Controls + facet rail + results — DataFilterIndex island owns this
        whole region (search/sort sit above the results column, not the
        page); see BlogIndex.tsx (skin="labs") and labsSkin.ts. */}
    <section class:list={["scroll-reveal-section pb-24", BAND_CONTENT_GAP]}>
      <div class="reveal-child stagger-1 mx-auto max-w-content px-gutter">
        <BlogIndex client:load items={searchEntries} categories={categoryOptions} tags={tagOptions} pageSize={PAGE_SIZE} />
      </div>
    </section>

    <section class="scroll-reveal-section">
      <div class="reveal-child stagger-1">
        <BlogNewsletterCta />
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* House scroll-reveal pattern (reference: BlogLayout.astro). The hidden
   * start state applies only once the script has armed the section, so the
   * server-rendered page is fully visible without JS. */
  .reveal-child {
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }
  .stagger-1 { transition-delay: 60ms; }

  .scroll-reveal-section.reveal-armed:not(.in-view) .reveal-child {
    opacity: 0;
    transform: translateY(12px);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-child,
    .scroll-reveal-section.reveal-armed:not(.in-view) .reveal-child {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  import { initScrollReveal } from "../../scripts/labs-scroll-reveal";

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScrollReveal);
  } else {
    initScrollReveal();
  }
</script>
