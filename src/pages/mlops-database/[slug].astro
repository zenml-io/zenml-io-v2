---
/**
 * MLOps Database detail page.
 *
 * Renders individual MLOps entries in DatabaseEntryLayout.astro:
 * company/platform metadata, tags, summary, source link, body, and related
 * entries ("More like this").
 */
import { getEntry, render } from "astro:content";
import type { RelatedRailItem } from "../../components/templates/RelatedRail.astro";
import DatabaseEntryLayout from "../../layouts/DatabaseEntryLayout.astro";
import {
  buildMLOpsRelatedIndex,
  getAllPublishedMLOpsEntries,
  getMLOpsRelatedFromIndex,
} from "../../lib/mlops";
import { STALE_RAY_SUMMIT_REDIRECTS } from "../../lib/mlopsRaySummitRedirects";

export async function getStaticPaths() {
  const allEntries = await getAllPublishedMLOpsEntries();
  const relatedIndex = buildMLOpsRelatedIndex(allEntries);
  return [
    ...allEntries.map((entry) => {
      const related = getMLOpsRelatedFromIndex(relatedIndex, entry, 3);
      return {
        params: { slug: entry.data.slug },
        props: { entry, related },
      };
    }),
    ...Object.entries(STALE_RAY_SUMMIT_REDIRECTS).map(
      ([oldSlug, targetSlug]) => ({
        params: { slug: oldSlug },
        props: { redirectTo: `/mlops-database/${targetSlug}` },
      }),
    ),
  ];
}

const { entry, redirectTo, related } = Astro.props;

if (redirectTo) {
  return Astro.redirect(redirectTo, 301);
}

// getStaticPaths returns a mixed union — entry routes vs redirect routes —
// so after the redirect branch above, entry/related are always defined.
// TS can't infer this across the union, so assert it explicitly to narrow.
if (!entry || !related) {
  throw new Error(`Missing MLOps entry props for ${Astro.url.pathname}`);
}

const { Content, headings } = await render(entry);

const tagEntries = await Promise.all(
  entry.data.mlopsTags.map((slug: string) => getEntry("mlops-tags", slug)),
);
const resolvedTags = tagEntries.flatMap((tag) =>
  tag ? [{ name: tag.data.name, slug: tag.data.slug }] : [],
);
const tags = resolvedTags.map((tag) => ({
  name: tag.name,
  href: `/mlops-tags/${tag.slug}`,
}));

const industryEntry = await getEntry("industry-tags", entry.data.industryTags);
// The schema requires industryTags on every MLOps entry (unlike LLMOps,
// where it is optional) — a missing reference is a content integrity bug,
// not a page state to render around.
if (!industryEntry) {
  throw new Error(
    `MLOps entry "${entry.data.slug}" references a missing industry tag: ${entry.data.industryTags}`,
  );
}

const relatedItems: RelatedRailItem[] = related.map((r) => ({
  kind: "hex-card" as const,
  href: `/mlops-database/${r.data.slug}`,
  title: r.data.title,
  kindLabel: [r.data.company, r.data.year ? String(r.data.year) : undefined]
    .filter(Boolean)
    .join(" · "),
}));

const seoTitle =
  entry.data.seo?.title || `${entry.data.title} - ZenML MLOps Database`;
const seoDescription = entry.data.seo?.description || entry.data.summary;
const ogImage = entry.data.seo?.ogImage;

const pagefindMeta: Record<string, string> = {
  slug: entry.data.slug,
  company: entry.data.company,
  platform: entry.data.platformName,
  contentType: entry.data.contentType,
};
if (entry.data.year) pagefindMeta.year = String(entry.data.year);

const pagefindFilters = [
  ...resolvedTags.map((tag) => ({ key: "tag", value: tag.slug })),
  { key: "industry", value: industryEntry.data.slug },
];
---

<DatabaseEntryLayout
  database="mlops"
  entryTitle={entry.data.title}
  company={entry.data.company}
  platformName={entry.data.platformName}
  contentType={entry.data.contentType}
  year={entry.data.year}
  sourceHref={entry.data.link}
  summary={entry.data.summary}
  industry={{
    name: industryEntry.data.name,
    href: `/industry-tags/${industryEntry.data.slug}`,
  }}
  tags={tags}
  headings={headings}
  related={relatedItems}
  pagefindMeta={pagefindMeta}
  pagefindFilters={pagefindFilters}
  title={seoTitle}
  description={seoDescription}
  ogImage={ogImage}
  ogTitle={entry.data.seo?.ogTitle}
  ogDescription={entry.data.seo?.ogDescription}
  canonical={entry.data.seo?.canonical}
>
  <Content />
</DatabaseEntryLayout>
