---
/**
 * MLOps Database detail page.
 *
 * Renders individual MLOps entries with company/platform metadata, tags,
 * summary, source link, body, and related entries.
 */
import { getEntry, render } from "astro:content";
import Breadcrumb from "../../components/system/Breadcrumb.astro";
import MetadataBlock, {
  type MetadataBlockItem,
} from "../../components/templates/MetadataBlock.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  buildMLOpsRelatedIndex,
  getAllPublishedMLOpsEntries,
  getMLOpsRelatedFromIndex,
} from "../../lib/mlops";
import { STALE_RAY_SUMMIT_REDIRECTS } from "../../lib/mlopsRaySummitRedirects";

export async function getStaticPaths() {
  const allEntries = await getAllPublishedMLOpsEntries();
  const relatedIndex = buildMLOpsRelatedIndex(allEntries);
  return [
    ...allEntries.map((entry) => {
      const related = getMLOpsRelatedFromIndex(relatedIndex, entry, 3);
      return {
        params: { slug: entry.data.slug },
        props: { entry, related },
      };
    }),
    ...Object.entries(STALE_RAY_SUMMIT_REDIRECTS).map(
      ([oldSlug, targetSlug]) => ({
        params: { slug: oldSlug },
        props: { redirectTo: `/mlops-database/${targetSlug}` },
      }),
    ),
  ];
}

const { entry, redirectTo, related } = Astro.props;

if (redirectTo) {
  return Astro.redirect(redirectTo, 301);
}

// getStaticPaths returns a mixed union — entry routes vs redirect routes —
// so after the redirect branch above, entry/related are always defined.
// TS can't infer this across the union, so assert it explicitly to narrow.
if (!entry || !related) {
  throw new Error(`Missing MLOps entry props for ${Astro.url.pathname}`);
}

const { Content } = await render(entry);

const tagEntries = await Promise.all(
  entry.data.mlopsTags.map((slug: string) => getEntry("mlops-tags", slug)),
);
const tags = tagEntries.flatMap((tag) =>
  tag ? [{ name: tag.data.name, slug: tag.data.slug }] : [],
);

const industryEntry = await getEntry("industry-tags", entry.data.industryTags);

const relatedWithTags = await Promise.all(
  related.map(async (relatedEntry) => {
    const relatedTags = await Promise.all(
      relatedEntry.data.mlopsTags
        .slice(0, 3)
        .map((slug: string) => getEntry("mlops-tags", slug)),
    );
    return {
      slug: relatedEntry.data.slug,
      title: relatedEntry.data.title,
      company: relatedEntry.data.company,
      platformName: relatedEntry.data.platformName,
      contentType: relatedEntry.data.contentType,
      year: relatedEntry.data.year,
      summary: relatedEntry.data.summary,
      tags: relatedTags.flatMap((tag) =>
        tag ? [{ name: tag.data.name, slug: tag.data.slug }] : [],
      ),
      extraTagCount: Math.max(0, relatedEntry.data.mlopsTags.length - 3),
    };
  }),
);

// Industry + MLOps Topics meta blocks (mirrored byte-for-byte on the LLMOps
// twin page). Trailing spacing after the block is data-dependent: whichever
// item renders last owns the gap before the body content.
const metadataItems: MetadataBlockItem[] = [];
if (industryEntry) {
  metadataItems.push({
    label: "Industry",
    value: {
      kind: "chips",
      chips: [
        {
          label: industryEntry.data.name,
          href: `/industry-tags/${industryEntry.data.slug}`,
          variant: "primary",
        },
      ],
    },
  });
}
if (tags.length > 0) {
  metadataItems.push({
    label: "MLOps Topics",
    value: {
      kind: "chips",
      chips: tags.map((tag) => ({
        label: tag.name,
        href: `/mlops-tags/${tag.slug}`,
        variant: "success",
      })),
    },
  });
}
const metadataTrailingClass =
  tags.length > 0 ? "mb-space-md" : industryEntry ? "mb-space-sm" : "";

const seoTitle =
  entry.data.seo?.title || `${entry.data.title} - ZenML MLOps Database`;
const seoDescription = entry.data.seo?.description || entry.data.summary;
const ogImage = entry.data.seo?.ogImage;
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  ogImage={ogImage}
  ogTitle={entry.data.seo?.ogTitle}
  ogDescription={entry.data.seo?.ogDescription}
  canonical={entry.data.seo?.canonical}
  surface="ml"
>
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8" data-pagefind-body>
    <span data-pagefind-meta={`slug:${entry.data.slug}`} class="hidden" />
    <span data-pagefind-meta={`company:${entry.data.company}`} class="hidden" />
    <span data-pagefind-meta={`platform:${entry.data.platformName}`} class="hidden" />
    <span data-pagefind-meta={`contentType:${entry.data.contentType}`} class="hidden" />
    {entry.data.year && <span data-pagefind-meta={`year:${entry.data.year}`} class="hidden" />}

    {tags.map((tag) => (
      <span data-pagefind-filter={`tag:${tag.slug}`} class="hidden" />
    ))}
    {industryEntry && (
      <span data-pagefind-filter={`industry:${industryEntry.data.slug}`} class="hidden" />
    )}

    <Breadcrumb
      separator="chevron"
      pagefindIgnore
      items={[
        { label: "MLOps Database", href: "/mlops-database" },
        { label: entry.data.title },
      ]}
    />

    <header class="mb-8">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-success-700">MLOps case study</p>
      <h1 class="text-3xl font-bold tracking-tight text-gray-900" data-pagefind-meta="title">{entry.data.title}</h1>

      <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-gray-500">
        <span class="font-medium text-gray-700">{entry.data.company}</span>
        {entry.data.platformName !== entry.data.company && (
          <>
            <span aria-hidden="true">&middot;</span>
            <span>{entry.data.platformName}</span>
          </>
        )}
        <>
          <span aria-hidden="true">&middot;</span>
          <span class="capitalize">{entry.data.contentType}</span>
        </>
        {entry.data.year && (
          <>
            <span aria-hidden="true">&middot;</span>
            <span>{entry.data.year}</span>
          </>
        )}
      </div>

      <a
        href={entry.data.link}
        class="mt-4 inline-flex items-center gap-2 rounded-lg bg-primary-600 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-primary-700"
        target="_blank"
        rel="noopener noreferrer"
      >
        View original source
        <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 3H3v10h10v-3M9 2h5v5M14 2L7 9" />
        </svg>
      </a>
    </header>

    <div class="mb-8 rounded-lg border border-success-500/20 bg-success-50 p-6">
      <p class="text-gray-700">{entry.data.summary}</p>
    </div>

    {metadataItems.length > 0 && (
      <MetadataBlock
        items={metadataItems}
        labelTag="h2"
        space="sm"
        class={metadataTrailingClass}
      />
    )}

    <div class="prose prose-gray max-w-none">
      <Content />
    </div>

    {relatedWithTags.length > 0 && (
      <section class="mt-16 border-t border-gray-200 pt-10" data-pagefind-ignore>
        <h2 class="mb-6 text-xl font-bold text-gray-900">More Like This</h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {relatedWithTags.map((relatedEntry) => (
            <a
              href={`/mlops-database/${relatedEntry.slug}`}
              class="group flex flex-col rounded-lg border border-gray-200 bg-white p-5 transition-shadow hover:shadow-md"
            >
              <h3 class="font-semibold text-gray-900 group-hover:text-primary-600 line-clamp-2">
                {relatedEntry.title}
              </h3>
              <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-gray-500">
                <span class="font-medium text-gray-700">{relatedEntry.company}</span>
                {relatedEntry.platformName !== relatedEntry.company && (
                  <>
                    <span aria-hidden="true">&middot;</span>
                    <span>{relatedEntry.platformName}</span>
                  </>
                )}
                <>
                  <span aria-hidden="true">&middot;</span>
                  <span class="capitalize">{relatedEntry.contentType}</span>
                </>
                {relatedEntry.year && (
                  <>
                    <span aria-hidden="true">&middot;</span>
                    <span>{relatedEntry.year}</span>
                  </>
                )}
              </div>
              <p class="mt-2 text-sm text-gray-600 line-clamp-2">{relatedEntry.summary}</p>
              {relatedEntry.tags.length > 0 && (
                <div class="mt-auto flex flex-wrap gap-1 pt-3">
                  {relatedEntry.tags.map((tag) => (
                    <span class="rounded-full bg-success-50 px-2 py-0.5 text-xs text-success-700">
                      {tag.name}
                    </span>
                  ))}
                  {relatedEntry.extraTagCount > 0 && (
                    <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-500">
                      +{relatedEntry.extraTagCount}
                    </span>
                  )}
                </div>
              )}
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
