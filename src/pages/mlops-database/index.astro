---
/**
 * MLOps Database listing page, in the ZenML Labs shell (`app="labs"`,
 * `surface="ml"`) — the same sequence as `/llmops-database` and `/blog`:
 * short shader band, the shared `DataFilterIndex` island skinned "labs",
 * closing CTA band. The one difference between the two databases is the
 * rail's third group: MLOps entries carry a content type (`?type=`), an
 * extra single-select facet the LLMOps side has no equivalent for.
 *
 * Server-side: resolves tag/industry display names and the entry count, and
 * renders the no-JS fallback. Client-side: the MlopsIndex island fetches
 * /mlops-index.json and handles filtering, search, sorting, pagination and
 * URL state in the browser.
 *
 * Route: /mlops-database
 */
import { getCollection } from "astro:content";
import {
  TERM_CHIP,
  TERM_CHIP_HEXAGON_PATH,
  TERM_CHIP_HEXAGON_VIEWBOX,
  TERM_CHIP_OVERFLOW,
} from "../../components/blog/termChipStyles";
import MlopsIndex from "../../components/islands/filter-index/MlopsIndex";
import BlogNewsletterCta from "../../components/labs/BlogNewsletterCta.astro";
import LabsHero from "../../components/labs/LabsHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BAND_CONTENT_GAP, blogLaneStyle } from "../../lib/blogLayout";
import {
  DATABASE_CTA,
  DATABASE_PAGE_SIZE,
  DATABASES,
} from "../../lib/databases";
import { BREVO_LLMOPS_CONFIG } from "../../lib/formConstants";

const copy = DATABASES.mlops;

const allTags = (await getCollection("mlops-tags"))
  .map((tag) => ({ slug: tag.data.slug, name: tag.data.name }))
  .sort((a, b) => a.name.localeCompare(b.name));

const allIndustries = (await getCollection("industry-tags"))
  .map((industry) => ({ slug: industry.data.slug, name: industry.data.name }))
  .sort((a, b) => a.name.localeCompare(b.name));

const entryCount = (
  await getCollection("mlops-database", ({ data }) => !data.draft)
).length;

/** The no-JS fallback lists the first 20 topics, then says how many are left. */
const NOSCRIPT_TAGS = 20;
const noscriptTags = allTags.slice(0, NOSCRIPT_TAGS);
const noscriptTagOverflow = allTags.length - noscriptTags.length;
const GROUP_LABEL = "text-[13px] font-medium text-(--color-cream-700)";
---

<BaseLayout
  title={copy.seoTitle}
  description={copy.seoDescription(entryCount)}
  surface="ml"
  app="labs"
>
  <div style={blogLaneStyle()}>
    <LabsHero band="short" content={{ headline: copy.name, deck: copy.description(entryCount) }} />

    <section class:list={["scroll-reveal-section pb-24", BAND_CONTENT_GAP]}>
      <div class="reveal-child stagger-1 mx-auto max-w-content px-gutter">
        <MlopsIndex
          client:load
          tags={allTags}
          industries={allIndustries}
          entryCount={entryCount}
          pageSize={DATABASE_PAGE_SIZE}
        />

        <noscript>
          <div class="flex flex-col gap-8">
            <p class="text-[15px] leading-6 text-(--color-cream-700)">{copy.noscriptIntro}</p>
            <div class="flex flex-col gap-3">
              <h2 class={GROUP_LABEL}>Browse by MLOps topic</h2>
              <div class="flex flex-wrap gap-2">
                {noscriptTags.map((tag) => (
                  <a href={`/mlops-tags/${tag.slug}`} class={TERM_CHIP}>
                    <svg viewBox={TERM_CHIP_HEXAGON_VIEWBOX} class="h-[14px] w-3 fill-(--color-sage-600)" aria-hidden="true">
                      <path d={TERM_CHIP_HEXAGON_PATH} />
                    </svg>
                    {tag.name}
                  </a>
                ))}
                {noscriptTagOverflow > 0 && (
                  <span class={TERM_CHIP_OVERFLOW}>+{noscriptTagOverflow} more</span>
                )}
              </div>
            </div>
            <div class="flex flex-col gap-3">
              <h2 class={GROUP_LABEL}>Browse by industry</h2>
              <div class="flex flex-wrap gap-2">
                {allIndustries.map((industry) => (
                  <a href={`/industry-tags/${industry.slug}`} class={TERM_CHIP}>
                    <svg viewBox={TERM_CHIP_HEXAGON_VIEWBOX} class="h-[14px] w-3 fill-(--color-sage-600)" aria-hidden="true">
                      <path d={TERM_CHIP_HEXAGON_PATH} />
                    </svg>
                    {industry.name}
                  </a>
                ))}
              </div>
            </div>
          </div>
        </noscript>
      </div>
    </section>

    <section class="scroll-reveal-section">
      <div class="reveal-child stagger-1">
        <BlogNewsletterCta content={DATABASE_CTA} brevo={BREVO_LLMOPS_CONFIG} />
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* House scroll-reveal pattern (reference: blog/index.astro). The hidden
   * start state applies only once the script has armed the section, so the
   * server-rendered page is fully visible without JS. */
  .reveal-child {
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }
  .stagger-1 { transition-delay: 60ms; }

  .scroll-reveal-section.reveal-armed:not(.in-view) .reveal-child {
    opacity: 0;
    transform: translateY(12px);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-child,
    .scroll-reveal-section.reveal-armed:not(.in-view) .reveal-child {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  import { initScrollReveal } from "../../scripts/labs-scroll-reveal";

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScrollReveal);
  } else {
    initScrollReveal();
  }
</script>
