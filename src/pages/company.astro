---
import BlogNewsletterCta from "../components/labs/BlogNewsletterCta.astro";
import LabsEditorialSection from "../components/labs/LabsEditorialSection.astro";
import LabsOpenRoles from "../components/labs/LabsOpenRoles.astro";
import LabsPageHeader from "../components/labs/LabsPageHeader.astro";
import LabsPeopleRoster from "../components/labs/LabsPeopleRoster.astro";
import LabsValuesGrid from "../components/labs/LabsValuesGrid.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  COMPANY_ABOUT,
  COMPANY_HERO,
  COMPANY_SEO,
  COMPANY_VALUES,
  OPEN_POSITIONS,
} from "../lib/company";
import { getPublishedTeamMembers } from "../lib/team";

const teamMembers = await getPublishedTeamMembers();
---

<BaseLayout
  title={COMPANY_SEO.title}
  description={COMPANY_SEO.description}
  ogTitle={COMPANY_SEO.ogTitle}
  ogDescription={COMPANY_SEO.ogDescription}
  ogImage={COMPANY_SEO.ogImage}
  surface="unified"
  app="labs"
>
  <main>
    <LabsPageHeader
      eyebrow={COMPANY_HERO.eyebrow}
      heading={COMPANY_HERO.headline}
      description={COMPANY_HERO.deck}
      align="center"
    />

    <LabsEditorialSection
      headline={COMPANY_ABOUT.headline}
      body={{ kind: "text", value: COMPANY_ABOUT.body }}
      image={COMPANY_ABOUT.image}
    />

    <LabsValuesGrid
      values={COMPANY_VALUES.map((value) => ({
        title: value.title,
        subtitle: value.subtitle,
        bullets: value.bullets,
      }))}
    />

    <LabsPeopleRoster members={teamMembers} heading="Meet the team" />
    <LabsOpenRoles positions={OPEN_POSITIONS} />
    <BlogNewsletterCta />
  </main>
</BaseLayout>
