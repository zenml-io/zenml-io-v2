---
import Button from "../components/Button.astro";
/**
 * 404 — custom not-found page.
 *
 * Uses BaseLayout directly (not ContentLayout) because this is a utility
 * page with a visual + CTA, not long-form prose content.
 *
 * Route: Astro serves this as /404.html automatically.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found — ZenML" noindex surface="ml">
  <main class="flex min-h-[60vh] items-center justify-center px-4 py-16">
    <div class="flex flex-col items-center gap-8 md:flex-row md:gap-16">
      <img
        src="/images/404.svg"
        alt="Page not found"
        class="w-64 max-w-full md:w-80"
        width="320"
        height="320"
      />
      <div class="text-center md:text-left">
        <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl">
          Oops! Page Not Found
        </h1>
        <p class="mt-4 max-w-md text-lg text-gray-600">
          The page you are looking for doesn't exist or has been moved.
        </p>
        <div class="mt-8">
          <Button href="/" size="lg">Go back home</Button>
        </div>
        <p class="mt-8 max-w-md text-sm text-gray-600">
          Looking for something specific? Try the{" "}
          <a href="/blog" class="text-primary-600 underline">blog</a>, the{" "}
          <a href="/llmops-database" class="text-primary-600 underline"
            >LLMOps Database</a
          >, the{" "}
          <a href="https://docs.zenml.io" class="text-primary-600 underline"
            >documentation</a
          >, or <a href="/contact" class="text-primary-600 underline">contact us</a>.
        </p>
        <p class="mt-2 max-w-md text-xs text-gray-500">
          A full page index lives at{" "}
          <a href="/sitemap-index.xml" class="underline">/sitemap-index.xml</a>{" "}
          and a curated one at{" "}
          <a href="/llms.txt" class="underline">/llms.txt</a>.
        </p>
      </div>
    </div>
  </main>
</BaseLayout>
