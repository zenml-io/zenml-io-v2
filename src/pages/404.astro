---
import LabsBand from "../components/labs/LabsBand.astro";
import LabsButton from "../components/labs/LabsButton.astro";
/**
 * 404 — custom not-found page.
 *
 * Uses BaseLayout directly (not ContentLayout) because this is a utility
 * page with a visual + CTA, not long-form prose content.
 *
 * Route: Astro serves this as /404.html automatically.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found - ZenML Labs" noindex surface="ml" app="labs">
  <main>
    <LabsBand size="short" class="min-h-screen">
      <div class="mx-auto w-full max-w-[640px] text-center font-sans text-foreground">
        <p class="font-sans text-sm text-(--color-sage-800)">404</p>
        <h1 class="mt-3 font-display text-5xl sm:text-6xl">This page isn’t here.</h1>
        <p class="mx-auto mt-5 max-w-xl text-lg text-muted-foreground">
          It may have moved, or the link may be out of date.
        </p>
        <div class="mt-8">
          <LabsButton cta={{ label: "Go back home", href: "/", analytics: "404-Home" }} />
        </div>
        <p class="mx-auto mt-10 max-w-xl text-sm text-muted-foreground">
          Looking for something specific? Try the{" "}
          <a href="/blog" class="text-(--color-sage-800) underline decoration-(--color-sage-500) underline-offset-4 hover:text-foreground">blog</a>, the{" "}
          <a href="/llmops-database" class="text-(--color-sage-800) underline decoration-(--color-sage-500) underline-offset-4 hover:text-foreground"
            >LLMOps Database</a
          >, the{" "}
          <a href="https://docs.zenml.io" class="text-(--color-sage-800) underline decoration-(--color-sage-500) underline-offset-4 hover:text-foreground"
            >documentation</a
          >, or <a href="/contact" class="text-(--color-sage-800) underline decoration-(--color-sage-500) underline-offset-4 hover:text-foreground">contact us</a>.
        </p>
        <p class="mx-auto mt-3 max-w-xl text-xs text-muted-foreground">
          A full page index lives at{" "}
          <a href="/sitemap-index.xml" class="underline">/sitemap-index.xml</a>{" "}
          and a curated one at{" "}
          <a href="/llms.txt" class="underline">/llms.txt</a>.
        </p>
      </div>
    </LabsBand>
  </main>
</BaseLayout>
