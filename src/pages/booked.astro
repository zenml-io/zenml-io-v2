---
import ConversionShell from "../components/templates/ConversionShell.astro";
/**
 * Booked — thank-you page after Cal.com booking.
 *
 * Route: /booked (noindex)
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { BOOKED_DATA, BOOKED_SEO } from "../lib/booked";
---

<BaseLayout
  title={BOOKED_SEO.title}
  description={BOOKED_SEO.description}
  noindex={BOOKED_SEO.noindex}
  surface="unified"
>
  <main>
    <ConversionShell
      frame="success"
      headline={BOOKED_DATA.headline}
      deck={BOOKED_DATA.body}
      primaryCta={BOOKED_DATA.primaryCta}
      secondaryCta={BOOKED_DATA.secondaryCta}
    />
  </main>
</BaseLayout>
