---
import Button from "../components/Button.astro";
import FaqSection from "../components/sections/FaqSection.astro";
import FeaturesHubCTA from "../components/sections/FeaturesHubCTA.astro";
import PricingComparisonTable from "../components/sections/PricingComparisonTable.astro";
import PricingPlanCards from "../components/sections/PricingPlanCards.astro";
import PricingProInclusions from "../components/sections/PricingProInclusions.astro";
/**
 * Pricing page.
 *
 * Route: /pricing
 *
 * Unified single-page pricing: three plan cards (Open Source / Scale /
 * Enterprise — the Scale card carries an executions slider), one feature
 * comparison table, then the "Two workspaces" breakdown. Additional
 * sections: startup/academic banner, compliance, FAQ, stats/trust,
 * and final CTA.
 */
import JsonLd from "../components/seo/JsonLd.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  PRICING_COMPARE,
  PRICING_COMPARE_KITARU,
  PRICING_COMPLIANCE,
  PRICING_FAQ,
  PRICING_FINAL_CTA,
  PRICING_HERO,
  PRICING_SEO,
  PRICING_STARTUP_BANNER,
  PRICING_STATS,
} from "../lib/pricing";
import { buildPricingJsonLd } from "../lib/pricingJsonLd";

const pricingJsonLd = buildPricingJsonLd();
---

<BaseLayout
  title={PRICING_SEO.title}
  description={PRICING_SEO.description}
  ogTitle={PRICING_SEO.ogTitle}
  ogDescription={PRICING_SEO.ogDescription}
  ogImage={PRICING_SEO.ogImage}
  surface="unified"
>
  <JsonLd data={pricingJsonLd} slot="head" />

  <main>
    {/*
      No-JS fallback: the workspace toggle needs JS to flip `hidden` on the
      [data-workspace-panel] wrappers, so without scripting the ZenML half
      of the page (plans + table) would be unreachable. This unhides every
      panel — both workspaces render stacked — whenever scripting is off.
    */}
    <noscript>
      <style>
        [data-workspace-panel][hidden] {
          display: block;
        }
      </style>
    </noscript>

    {/* Hero */}
    <section class="bg-linear-to-b from-zenml-50 to-white pt-8 pb-8 sm:pt-12 sm:pb-12">
      <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <p class="text-sm font-semibold uppercase tracking-wider text-zenml-500">
          {PRICING_HERO.eyebrow}
        </p>
        <h1 class="mt-3 text-3xl font-bold text-gray-900 sm:text-4xl lg:text-5xl">
          {PRICING_HERO.headline}
        </h1>
        <p class="mt-4 text-lg text-gray-600">{PRICING_HERO.deck}</p>
      </div>
    </section>

    {/* Plan cards — Open Source / Scale / Enterprise */}
    <PricingPlanCards />

    {/* Comparison table — one per workspace; the plan-cards toggle flips
        `hidden` on every [data-workspace-panel] on the page, so these swap
        in sync with the cards above. */}
    <section id="compare-table" class="scroll-mt-24 bg-white pb-16 sm:pb-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div data-workspace-panel="kitaru" class="kitaru-brand-vars">
          <PricingComparisonTable data={PRICING_COMPARE_KITARU} />
        </div>
        <div data-workspace-panel="zenml" hidden>
          <PricingComparisonTable data={PRICING_COMPARE} />
        </div>
      </div>
    </section>

    {/* What's included in Pro — two workspaces breakdown */}
    <PricingProInclusions />

    {/* Startup / Academic banner */}
    <section class="bg-white py-12">
      <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8">
        <div class="rounded-2xl border border-zenml-25 bg-cover bg-center px-10 py-10 sm:px-14 sm:py-12" style="background-image: url('/images/zenml_light_bg-02.avif')">
          <div class="flex flex-col items-center gap-6 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h2 class="text-2xl font-bold text-gray-900">{PRICING_STARTUP_BANNER.headline}</h2>
              <p class="mt-2 text-sm text-gray-600 leading-relaxed">{PRICING_STARTUP_BANNER.body}</p>
            </div>
            <Button href={PRICING_STARTUP_BANNER.cta.href} class="flex-shrink-0">
              {PRICING_STARTUP_BANNER.cta.label}
            </Button>
          </div>
        </div>
      </div>
    </section>

    {/* Compliance: "Your VPC, your data" */}
    <section class="bg-white py-16 sm:py-20">
      <div class="mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
        <p class="text-sm font-semibold uppercase tracking-wider text-zenml-500">
          {PRICING_COMPLIANCE.eyebrow}
        </p>
        <h2 class="mt-2 text-2xl font-bold text-gray-900 sm:text-3xl">
          {PRICING_COMPLIANCE.headline}
        </h2>
        <p class="mt-3 text-lg text-gray-600">{PRICING_COMPLIANCE.body}</p>
        <div class="mt-8">
          <picture>
            <source media="(max-width: 767px)" srcset={PRICING_COMPLIANCE.image.mobile.url} />
            <img
              src={PRICING_COMPLIANCE.image.desktop.url}
              alt={PRICING_COMPLIANCE.image.desktop.alt}
              class="w-full rounded-md"
              loading="lazy"
            />
          </picture>
        </div>
        {/* SOC2/ISO banner */}
        <div class="mt-8 rounded-md border border-gray-200 bg-gray-50 p-6">
          <div class="flex flex-col items-center gap-8 sm:flex-row">
            <div class="flex shrink-0 gap-6">
              {PRICING_COMPLIANCE.badges.map((badge) => (
                <img
                  src={badge.url}
                  alt={badge.alt}
                  class="h-28 w-auto object-contain"
                  loading="lazy"
                />
              ))}
            </div>
            <div class="text-left sm:border-l sm:border-gray-200 sm:pl-8">
              <p class="text-xs font-semibold uppercase tracking-wider text-zenml-500">
                {PRICING_COMPLIANCE.bannerEyebrow}
              </p>
              <h3 class="mt-1 text-lg font-semibold text-gray-900">
                {PRICING_COMPLIANCE.bannerHeadline}
              </h3>
              <p class="mt-1 text-sm text-gray-600">{PRICING_COMPLIANCE.bannerBody}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* FAQ */}
    <FaqSection
      eyebrow={PRICING_FAQ.eyebrow}
      headline={PRICING_FAQ.headline}
      subheadline={PRICING_FAQ.subheadline}
      items={PRICING_FAQ.items}
      slackCta={PRICING_FAQ.slackCta}
    />

    {/* Stats + Trust */}
    <section class="border-t border-gray-200 bg-cover bg-center py-20 sm:py-28" style="background-image: url('/images/zenml_light_bg-02.avif')">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        {/* Header */}
        <div class="text-center">
          <h2 class="text-2xl font-bold text-gray-900 sm:text-3xl">
            {PRICING_STATS.headline}
          </h2>
          <p class="mt-3 text-lg text-gray-600">{PRICING_STATS.deck}</p>
        </div>

        {/* Stats row — 4 across with dividers */}
        <div class="mt-14 grid grid-cols-2 gap-y-10 sm:grid-cols-4">
          {PRICING_STATS.items.map((stat, i) => (
            <div class:list={[
              "text-center px-6",
              i > 0 && "sm:border-l sm:border-gray-200",
            ]}>
              <p class="text-3xl font-bold text-gray-900 sm:text-4xl">{stat.value}</p>
              <p class="mt-2 text-sm text-gray-500">{stat.label}</p>
            </div>
          ))}
        </div>

        {/* Testimonial — centered, full-width */}
        <div class="mx-auto mt-14 max-w-3xl rounded-xl border border-gray-200 bg-gray-50/50 p-8 sm:p-10">
          <p class="text-center text-lg font-medium text-gray-900 leading-relaxed">
            {PRICING_STATS.testimonial.quote}
          </p>
          <div class="mt-6 flex flex-col items-center gap-5 sm:flex-row sm:justify-center">
            <div class="flex items-center gap-3">
              <img
                src={PRICING_STATS.testimonial.avatar}
                alt={PRICING_STATS.testimonial.name}
                class="h-12 w-12 rounded-full object-cover"
                loading="lazy"
              />
              <div>
                <p class="font-semibold text-gray-900">{PRICING_STATS.testimonial.name}</p>
                <p class="text-sm text-gray-500">{PRICING_STATS.testimonial.title}</p>
              </div>
            </div>
            <img
              src={PRICING_STATS.testimonial.companyLogo}
              alt="HashiCorp"
              class="h-7 object-contain"
              loading="lazy"
            />
          </div>
        </div>

        {/* Logo grid — even distribution */}
        <div class="mt-16 grid grid-cols-3 items-center justify-items-center gap-x-8 gap-y-8 sm:grid-cols-4 lg:grid-cols-6">
          {PRICING_STATS.logos.map((logo) => (
            <img
              src={logo.src}
              alt={logo.alt}
              class="h-8 max-w-[120px] object-contain grayscale opacity-50 transition hover:grayscale-0 hover:opacity-100"
              loading="lazy"
            />
          ))}
        </div>
      </div>
    </section>

    {/* Final CTA */}
    <FeaturesHubCTA
      headline={PRICING_FINAL_CTA.headline}
      body={PRICING_FINAL_CTA.body}
      primaryCta={PRICING_FINAL_CTA.primaryCta}
      secondaryCta={PRICING_FINAL_CTA.secondaryCta}
    />
  </main>
</BaseLayout>
