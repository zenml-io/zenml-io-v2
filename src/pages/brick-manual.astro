---
import ContactForm from "../components/islands/ContactForm.tsx";
import LabsPageHeader from "../components/labs/LabsPageHeader.astro";
/**
 * Brick Manual — email-gated PDF download for conference brick sets.
 *
 * Route: /brick-manual
 * Flow: QR code scan → email capture → instant PDF download link.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  BRICK_MANUAL_DOWNLOAD_URL,
  BRICK_MANUAL_FIELDS,
  BRICK_MANUAL_HERO,
  BRICK_MANUAL_SEO,
} from "../lib/brickManual";
import { TURNSTILE_SITE_KEY } from "../lib/formConstants";
---

<BaseLayout
  title={BRICK_MANUAL_SEO.title}
  description={BRICK_MANUAL_SEO.description}
  ogTitle={BRICK_MANUAL_SEO.ogTitle}
  ogDescription={BRICK_MANUAL_SEO.ogDescription}
  surface="ml"
  app="labs"
  product="zenml"
>
  <main>
    <LabsPageHeader
      heading={BRICK_MANUAL_HERO.headline}
      description={BRICK_MANUAL_HERO.deck}
      align="center"
    />
    <section class="bg-(--color-cream-50) py-space-xl md:py-space-xxl">
      <div class="mx-auto max-w-content px-gutter">
        {/* Decorative brick row */}
        <div class="mb-space-lg flex justify-center gap-1.5" aria-hidden="true">
          <span class="brick bg-(--color-sage-300)"></span>
          <span class="brick bg-(--color-sage-400)"></span>
          <span class="brick bg-(--color-sage-500)"></span>
          <span class="brick bg-(--color-sage-600)"></span>
          <span class="brick bg-(--color-sage-700)"></span>
        </div>

        <div class="mx-auto max-w-prose">
          <ContactForm
            client:load
            formType="brick-manual"
            endpoint="/api/forms/brick-manual"
            fields={BRICK_MANUAL_FIELDS}
            submitLabel="Unlock Instructions"
            loadingLabel="Unlocking…"
            successMessage="You're all set!"
            successDownloadUrl={BRICK_MANUAL_DOWNLOAD_URL}
            successDownloadLabel="Download Build Instructions"
            turnstileSiteKey={TURNSTILE_SITE_KEY}
          />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .brick {
    display: inline-block;
    width: 2.25rem;
    height: 1.5rem;
    border-radius: 0.25rem;
    position: relative;
  }
  .brick::before {
    content: "";
    position: absolute;
    top: -0.35rem;
    left: 50%;
    transform: translateX(-50%);
    width: 0.75rem;
    height: 0.35rem;
    border-radius: 0.125rem 0.125rem 0 0;
    background: inherit;
  }
</style>
