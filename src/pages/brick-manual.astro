---
import ContactForm from "../components/islands/ContactForm.tsx";
/**
 * Brick Manual — email-gated PDF download for conference brick sets.
 *
 * Route: /brick-manual
 * Flow: QR code scan → email capture → instant PDF download link.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  BRICK_MANUAL_DOWNLOAD_URL,
  BRICK_MANUAL_FIELDS,
  BRICK_MANUAL_HERO,
  BRICK_MANUAL_SEO,
} from "../lib/brickManual";
import { TURNSTILE_SITE_KEY } from "../lib/formConstants";
---

<BaseLayout
  title={BRICK_MANUAL_SEO.title}
  description={BRICK_MANUAL_SEO.description}
  ogTitle={BRICK_MANUAL_SEO.ogTitle}
  ogDescription={BRICK_MANUAL_SEO.ogDescription}
  surface="ml"
>
  <main>
    <section class="bg-white py-16 sm:py-24">
      <div class="mx-auto max-w-xl px-4 sm:px-6 lg:px-8">
        {/* Decorative brick row */}
        <div class="mb-6 flex justify-center gap-1.5" aria-hidden="true">
          <span class="brick bg-[#7A3EF8]"></span>
          <span class="brick bg-[#e84393]"></span>
          <span class="brick bg-[#0984e3]"></span>
          <span class="brick bg-[#f39c12]"></span>
          <span class="brick bg-[#00b894]"></span>
        </div>

        <div class="mb-8 text-center">
          <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl">
            {BRICK_MANUAL_HERO.headline}
          </h1>
          <p class="mt-3 text-lg text-gray-600">{BRICK_MANUAL_HERO.deck}</p>
        </div>

        <ContactForm
          client:load
          formType="brick-manual"
          endpoint="/api/forms/brick-manual"
          fields={BRICK_MANUAL_FIELDS}
          submitLabel="Unlock Instructions"
          loadingLabel="Unlocking…"
          successMessage="You're all set!"
          successDownloadUrl={BRICK_MANUAL_DOWNLOAD_URL}
          successDownloadLabel="Download Build Instructions"
          turnstileSiteKey={TURNSTILE_SITE_KEY}
        />
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .brick {
    display: inline-block;
    width: 2.25rem;
    height: 1.5rem;
    border-radius: 0.25rem;
    position: relative;
  }
  .brick::before {
    content: "";
    position: absolute;
    top: -0.35rem;
    left: 50%;
    transform: translateX(-50%);
    width: 0.75rem;
    height: 0.35rem;
    border-radius: 0.125rem 0.125rem 0 0;
    background: inherit;
  }
</style>
