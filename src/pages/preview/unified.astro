---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TwoWorkspaces from "../../components/sections/TwoWorkspaces.astro";
import UnifiedHero from "../../components/sections/UnifiedHero.astro";
import { HOMEPAGE_UNIFIED_SEO } from "../../lib/homepage-unified";

/**
 * /preview/unified — review surface for the Variant C hero region.
 *
 * Renders just the new pieces in scope: UnifiedHero + TwoWorkspaces widget.
 * The full Step 6 cutover (replace `/`, relocate ML deep-dive to
 * `/product/zenml`) is a later session.
 *
 * surface="unified" stamps `<html data-surface="unified">` so Plausible
 * tags the pageview correctly per CLAUDE.md (D3).
 */
---

<BaseLayout
  title={HOMEPAGE_UNIFIED_SEO.title}
  description={HOMEPAGE_UNIFIED_SEO.description}
  surface={HOMEPAGE_UNIFIED_SEO.surface}
  noindex
>
  <UnifiedHero />
  <TwoWorkspaces />
</BaseLayout>
