---
import ContactForm from "../components/islands/ContactForm.tsx";
import ConversionShell from "../components/templates/ConversionShell.astro";
/**
 * Signup for Demo — identical form to /book-a-demo, different route.
 *
 * Route: /signup-for-demo
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { TURNSTILE_SITE_KEY } from "../lib/formConstants";
import {
  SIGNUP_FOR_DEMO_FIELDS,
  SIGNUP_FOR_DEMO_HERO,
  SIGNUP_FOR_DEMO_SEO,
} from "../lib/signupForDemo";
---

<BaseLayout
  title={SIGNUP_FOR_DEMO_SEO.title}
  description={SIGNUP_FOR_DEMO_SEO.description}
  ogTitle={SIGNUP_FOR_DEMO_SEO.ogTitle}
  ogDescription={SIGNUP_FOR_DEMO_SEO.ogDescription}
  surface="unified"
>
  <main>
    <ConversionShell
      headline={SIGNUP_FOR_DEMO_HERO.headline}
      deck={SIGNUP_FOR_DEMO_HERO.deck}
      frame="form"
    >
      <ContactForm
        client:load
        formType="demo-request"
        endpoint="/api/forms/demo-request"
        fields={SIGNUP_FOR_DEMO_FIELDS}
        submitLabel="Send Request"
        loadingLabel="Sending…"
        successMessage="Thank you! We'll be in touch shortly."
        successCta={{ label: "Book a time now", href: "/book-your-demo" }}
        turnstileSiteKey={TURNSTILE_SITE_KEY}
      />
    </ConversionShell>
  </main>
</BaseLayout>
