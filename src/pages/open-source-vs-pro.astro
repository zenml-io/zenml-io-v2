---
/**
 * Open Source vs Pro page, in the ZenML Labs shell (`app="labs"`,
 * `surface="unified"` — no `product`). Rebuilt for the product one-offs
 * cutover (#317): the short shader band (eyebrow / h1 / deck — hero CTAs
 * leave the band, CONVENTIONS liberty 4), what Pro adds as value props,
 * the side-by-side table, and the closing band. Covers ZenML and Kitaru.
 *
 * Route: /open-source-vs-pro
 */
import LabsBand from "../components/labs/LabsBand.astro";
import LabsCloseCta from "../components/labs/LabsCloseCta.astro";
import LabsValueProps from "../components/labs/LabsValueProps.astro";
import { LABS_EYEBROW_CLASS } from "../components/templates/pageHeaderPresets";
import SpecTable from "../components/templates/SpecTable.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { BAND_CONTENT_GAP } from "../lib/blogLayout";
import {
  OSS_VS_PRO_CLOSE,
  OSS_VS_PRO_COMPARISON,
  OSS_VS_PRO_HERO,
  OSS_VS_PRO_SEO,
  OSS_VS_PRO_VALUE_PROPS,
} from "../lib/openSourceVsPro";
---

<BaseLayout
  title={OSS_VS_PRO_SEO.title}
  description={OSS_VS_PRO_SEO.description}
  ogTitle={OSS_VS_PRO_SEO.ogTitle}
  ogDescription={OSS_VS_PRO_SEO.ogDescription}
  ogImage={OSS_VS_PRO_SEO.ogImage}
  surface="unified"
  app="labs"
>
  <LabsBand size="short">
    <div class="flex flex-col gap-4">
      <p class={LABS_EYEBROW_CLASS}>
        {OSS_VS_PRO_HERO.eyebrow}
      </p>
      <h1 class="font-display text-[40px] leading-[44px] text-(--color-cream-900) md:text-[64px] md:leading-[70px]">
        {OSS_VS_PRO_HERO.headline}
      </h1>
      <p class="max-w-[720px] font-sans text-[18px] leading-7 text-(--color-cream-700)">
        {OSS_VS_PRO_HERO.deck}
      </p>
    </div>
  </LabsBand>

  <div class:list={[BAND_CONTENT_GAP]}>
    <LabsValueProps content={OSS_VS_PRO_VALUE_PROPS} />
  </div>

  {/* Comparison table */}
  <section class="pb-24 md:pb-32">
    <div class="mx-auto max-w-content px-gutter">
      <SpecTable
        skin="labs"
        heading={OSS_VS_PRO_COMPARISON.headline}
        subheading={OSS_VS_PRO_COMPARISON.subheadline}
        rowHeaderLabel="Feature"
        columns={OSS_VS_PRO_COMPARISON.columnHeaders}
        sections={[
          {
            rows: OSS_VS_PRO_COMPARISON.rows.map((r) => ({
              label: r.feature,
              description: r.description,
              values: r.columns,
            })),
          },
        ]}
      />
    </div>
  </section>

  <LabsCloseCta content={OSS_VS_PRO_CLOSE} />
</BaseLayout>
