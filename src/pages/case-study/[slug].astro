---
import { getCollection, render } from "astro:content";
import LabsCaseStudySidebar from "../../components/labs/LabsCaseStudySidebar.astro";
import LabsStoryCard from "../../components/labs/LabsStoryCard.astro";
import LabsDetailLayout from "../../layouts/LabsDetailLayout.astro";
import { orderCaseStudies, siblingCaseStudies } from "../../lib/case-studies";

export async function getStaticPaths() {
  const caseStudies = await getCollection(
    "case-studies",
    ({ data }) => !data.draft,
  );
  return orderCaseStudies(caseStudies).map((cs) => ({
    params: { slug: cs.data.slug },
    props: {
      cs,
      related: siblingCaseStudies(caseStudies, cs.data.slug),
    },
  }));
}

const { cs, related } = Astro.props;
const { data } = cs;
const { Content } = await render(cs);
const seoTitle = data.seo?.title || `${data.title} - ZenML Case Study`;
const seoDescription =
  data.seo?.description ||
  "How " +
    data.sidebar.company +
    " uses ZenML to build production AI workflows.";
---

<LabsDetailLayout
  title={seoTitle}
  description={seoDescription}
  ogImage={data.seo?.ogImage}
  ogTitle={data.seo?.ogTitle}
  ogDescription={data.seo?.ogDescription}
  canonical={data.seo?.canonical}
  heading={data.title}
  eyebrow={data.sidebar.company}
  breadcrumb={[
    { label: "Case studies", href: "/case-studies" },
    { label: data.sidebar.company },
  ]}
  surface="ml"
  product="zenml"
>
  <div slot="sidebar">
    <LabsCaseStudySidebar content={data.sidebar} logos={data.hero.logos} />
  </div>

  <div class="prose prose-gray max-w-none">
    <Content />
  </div>

  {related.length > 0 && <section slot="related" class="scroll-reveal-section mx-auto max-w-content px-gutter pb-24">
    <div class="border-t border-border pt-10">
      <h2 class="font-display text-[28px] leading-[34px] text-(--color-cream-800)">
        More case studies
      </h2>
      <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-4">
        {related.map((sibling) => (
          <LabsStoryCard
            href={"/case-study/" + sibling.data.slug}
            title={sibling.data.hub.cardTitle}
            company={sibling.data.sidebar.company}
            logos={sibling.data.hub.logos}
          />
        ))}
      </div>
    </div>
  </section>}
</LabsDetailLayout>
