---
/**
 * /cloud-features/ml-models-control-plane — ML Model Control Plane page, in
 * the ZenML Labs shell (`app="labs"`, `surface="ml"`, `product="zenml"`).
 * Rebuilt for the product one-offs cutover (#317): a short band with the
 * page's breadcrumb, the hero image, three alternating Split sections, and
 * the shared closing band.
 *
 * Dedicated page (NOT a redirect to /features/centralized-model-control-plane
 * — the content is distinct). Content extracted from the Webflow snapshot.
 */
import LabsBand from "../../components/labs/LabsBand.astro";
import LabsCloseCta from "../../components/labs/LabsCloseCta.astro";
import Breadcrumb from "../../components/system/Breadcrumb.astro";
import Split from "../../components/system/layout/Split.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BAND_CONTENT_GAP } from "../../lib/blogLayout";

// ── Page data ──────────────────────────────────────────────────────

const hero = {
  title: "ML Model Control Plane",
  category: "ZenML Pro",
  deck: "All your models, conveniently gathered in one place. Up-to-date information about your trainings, deployments, and endpoints all within one view. Control model lifecycle through a few clicks.",
  image: {
    url: "https://assets.zenml.io/webflow/64a817a2e7e2208272d1ce30/cc7b88fb/6525599588d1d0f3aeb57a6b_03.01.  Models - List.webp",
    alt: "Dashboard displaying machine learning models with versioning, owners, and tags",
  },
  primaryCta: {
    label: "Book a demo",
    href: "/book-your-demo",
  },
  secondaryCta: { label: "Read Docs", href: "/docs" },
};

const sections = [
  {
    title: "Beyond model registries",
    bullets: [
      "One central glass plane view over all your models.",
      "Understand where models originated.",
      "Gather all trained and deployed models in one central place.",
    ],
    image: {
      url: "https://assets.zenml.io/webflow/64a817a2e7e2208272d1ce30/234db398/65324a015f1eb2094d3e0954_27. Connect your infrastructure with ZenML Cloud.webp",
      alt: "ZenML Cloud infrastructure dashboard",
    },
    imageSide: "right" as const,
  },
  {
    title: "Trigger model promotions conveniently",
    bullets: [
      "Configure triggers that kick off pipelines to deploy models.",
      "Manage the lifecycle of model deployments.",
      "Easy to use and transparent for everyone on the team.",
    ],
    image: {
      url: "https://assets.zenml.io/webflow/64a817a2e7e2208272d1ce30/bb9c3d4e/653249cacf330ff484c21407_18. ML Model Control Plane Showcase.webp",
      alt: "ML Model Control Plane showcase dashboard",
    },
    imageSide: "left" as const,
  },
  {
    title: "Establish lineage between training and deployment",
    bullets: [
      "Track a model from training to deployments — across various infrastructures and tooling.",
      "Transition easily into production with one-click.",
      "Ensure reproducibility.",
    ],
    image: {
      url: "https://assets.zenml.io/webflow/64a817a2e7e2208272d1ce30/e6f711a9/6526aff7c4fdd6c0d6c1ea26_10_Data_Versioning_and_Lineage_Showcase.webp",
      alt: "Data versioning and lineage showcase",
    },
    imageSide: "right" as const,
  },
];
---

<BaseLayout
  title="ML Model Control Plane"
  description="All your models, conveniently gathered in one place. Up-to-date information about your trainings, deployments, and endpoints all within one view. Control model lifecycle through a few clicks."
  ogImage="https://assets.zenml.io/webflow/64a817a2e7e2208272d1ce30/c1229847/685aadfc75c3d8495ee841e1_og-img-0625.jpg"
  surface="ml"
  app="labs"
  product="zenml"
>
  <LabsBand size="short">
    <div class="flex flex-col gap-4">
      <Breadcrumb
        items={[
          { label: "ZenML Pro", href: "/pro" },
          { label: "ML Model Control Plane" },
        ]}
      />
      <div>
        <p class="font-sans text-[15px] leading-5 text-(--color-cream-700)">
          {hero.category}
        </p>
        <h1 class="mt-4 font-display text-[40px] leading-[44px] text-(--color-cream-900) md:text-[64px] md:leading-[70px]">
          {hero.title}
        </h1>
        <p class="mt-4 max-w-[720px] font-sans text-[18px] leading-7 text-(--color-cream-700)">
          {hero.deck}
        </p>
      </div>
    </div>
  </LabsBand>

  {/* Hero image */}
  <section class:list={["pb-24 md:pb-32", BAND_CONTENT_GAP]}>
    <div class="mx-auto max-w-content px-gutter">
      <img
        class="w-full rounded-[20px] border border-(--color-border) bg-card p-6"
        src={hero.image.url}
        alt={hero.image.alt}
        loading="eager"
      />
    </div>
  </section>

  {/* Alternating feature sections */}
  <section class="pb-24 md:pb-32">
    <div class="mx-auto flex max-w-content flex-col gap-20 px-gutter">
      {
        sections.map((section) => (
          <Split mediaSide={section.imageSide} space="mlg" alignY="center">
            <div>
              <h2 class="font-display text-[28px] leading-[34px] text-(--color-cream-900) md:text-[36px] md:leading-[42px]">
                {section.title}
              </h2>
              <ul class="mt-6 flex flex-col">
                {section.bullets.map((bullet) => (
                  <li class="flex items-start gap-3 border-t border-(--color-border) py-3 font-sans text-[16px] leading-6 text-(--color-cream-800) first:border-t-0">
                    <svg
                      class="mt-0.5 h-4 w-4 shrink-0 text-(--color-sage-700)"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M20 6L9 17l-5-5" />
                    </svg>
                    {bullet}
                  </li>
                ))}
              </ul>
            </div>
            <img
              slot="media"
              src={section.image.url}
              alt={section.image.alt}
              class="w-full rounded-[20px] border border-(--color-border) bg-card p-6"
              loading="lazy"
            />
          </Split>
        ))
      }
    </div>
  </section>

  <LabsCloseCta
    content={{
      headlineLines: ["Unify Your ML", "and LLM Workflows"],
      deck: "Open-source foundation, no vendor lock-in. Works with any infrastructure. Upgrade to managed Pro features.",
      cta: {
        label: "Book a demo",
        href: "/book-your-demo",
        analytics: "CloudFeatures-Close-Book-Demo",
      },
    }}
  />
</BaseLayout>
