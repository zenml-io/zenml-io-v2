---
/**
 * LLMOps tag taxonomy page.
 *
 * Shows all LLMOps database entries with this tag.
 * Generates /llmops-tags/<slug> for each tag in the collection.
 */
import { getCollection } from "astro:content";
import TermHubEntryIndex from "../../components/templates/TermHubEntryIndex.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getIndustryTagCounts } from "../../lib/llmops";

export async function getStaticPaths() {
  const llmopsTags = await getCollection("llmops-tags");
  const tagMap = Object.fromEntries(
    llmopsTags.map((t) => [t.data.slug, t.data.name]),
  );
  const allEntries = await getCollection(
    "llmops-database",
    ({ data }) => !data.draft,
  );
  const usedSlugs = new Set(allEntries.flatMap((e) => e.data.llmopsTags));
  return llmopsTags
    .filter((tag) => usedSlugs.has(tag.data.slug))
    .map((tag) => ({
      params: { slug: tag.data.slug },
      props: { tag, tagMap },
    }));
}

const { tag, tagMap } = Astro.props;

// Get all published LLMOps entries with this tag
const allEntries = (
  await getCollection(
    "llmops-database",
    ({ data }) => !data.draft && data.llmopsTags.includes(tag.data.slug),
  )
).sort((a, b) => a.data.title.localeCompare(b.data.title));

// Compute top co-occurring industries among entries with this tag
const commonIndustries = (await getIndustryTagCounts(allEntries)).slice(0, 8);
---

<BaseLayout
  title={`${tag.data.name} - LLMOps Database`}
  description={`LLMOps tools and platforms tagged with "${tag.data.name}".`}
  surface="ml"
>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <header class="mb-12">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900">
        LLMOps Tag: {tag.data.name}
      </h1>
      <p class="mt-4 text-lg text-gray-600">
        {allEntries.length} {allEntries.length === 1 ? "tool" : "tools"} with this tag
      </p>
      <a href="/llmops-database" class="mt-2 inline-block text-sm text-primary-600 hover:text-primary-700">
        &larr; Back to LLMOps Database
      </a>
    </header>

    <TermHubEntryIndex
      crossLinks={[
        {
          heading: "Common industries",
          viewAllHref: "/industry-tags",
          viewAllLabel: "View all industries",
          badgeVariant: "primary",
          items: commonIndustries.map((ind) => ({
            name: ind.name,
            slug: ind.slug,
            count: ind.count,
            href: `/industry-tags/${ind.slug}`,
          })),
        },
      ]}
      sections={[
        {
          cards: allEntries.map((entry) => ({
            title: entry.data.title,
            href: `/llmops-database/${entry.data.slug}`,
            company: entry.data.company,
            summary: entry.data.summary,
            tags: entry.data.llmopsTags.slice(0, 4).map((tagSlug: string) => ({
              label: tagMap[tagSlug] || tagSlug,
              href: `/llmops-tags/${tagSlug}`,
            })),
            extraTagCount: Math.max(0, entry.data.llmopsTags.length - 4),
            tagVariant: "blue" as const,
          })),
        },
      ]}
      emptyHeading="No LLMOps entries with this tag yet."
    />
  </div>
</BaseLayout>
