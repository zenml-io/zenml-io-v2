---
/**
 * LLMOps tags index, in the ZenML Labs shell (databases cutover #256):
 * every technology tag the database uses, as a hexagon chip carrying its
 * entry count (`labs.term-chip-index`), sorted by popularity.
 *
 * Route: /llmops-tags
 */
import { getCollection } from "astro:content";
import BlogNewsletterCta from "../../components/labs/BlogNewsletterCta.astro";
import LabsBand from "../../components/labs/LabsBand.astro";
import TermChipIndex from "../../components/labs/TermChipIndex.astro";
import Breadcrumb from "../../components/system/Breadcrumb.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BAND_CONTENT_GAP } from "../../lib/blogLayout";
import { DATABASE_CTA, DATABASES } from "../../lib/databases";
import { BREVO_LLMOPS_CONFIG } from "../../lib/formConstants";
import type { TaxonomyCount } from "../../lib/llmops";
import { getAllPublishedEntries, getLLMOpsTagCounts } from "../../lib/llmops";
import { filterUsedTerms } from "../../lib/relatedIndex";
import { defaultOgUrl, hasDefaultOgCard } from "../../lib/seo";

const copy = DATABASES.llmops;

const entries = await getAllPublishedEntries();
const usedCounts = await getLLMOpsTagCounts(entries);
const usedMap = new Map(usedCounts.map((t) => [t.slug, t.count]));

// Merge all taxonomy terms with used counts, then drop zero-count tags
// (#249) — a zero-count tag has no [slug] page to link to any more.
const allTags = await getCollection("llmops-tags");
const merged: TaxonomyCount[] = allTags.map((t) => ({
  slug: t.data.slug,
  name: t.data.name,
  count: usedMap.get(t.data.slug) ?? 0,
}));
const tags = filterUsedTerms(merged).sort(
  (a, b) => b.count - a.count || a.name.localeCompare(b.name),
);
---

<BaseLayout
  ogImage={hasDefaultOgCard("pages", "llmops-tags") ? defaultOgUrl("pages", "llmops-tags") : undefined}
  title="LLMOps Tags - ZenML"
  description="Browse all LLMOps tags used in the ZenML LLMOps Database."
  surface="ml"
  app="labs"
>
  <LabsBand size="short">
    <div class="flex flex-col gap-4">
      <Breadcrumb
        items={[
          { label: copy.name, href: copy.indexHref },
          { label: copy.tagsLabel },
        ]}
        separator="chevron"
      />
      <div>
        <h1 class="font-display text-[40px] leading-[44px] text-(--color-cream-900) md:text-[64px] md:leading-[70px]">
          {copy.tagsLabel}
        </h1>
        <p class="mt-space-sm max-w-[690px] font-sans text-[17px] leading-[26px] text-foreground md:text-xl md:leading-[30px]">
          {tags.length} technologies across the LLMOps Database
        </p>
      </div>
    </div>
  </LabsBand>

  <section class:list={["scroll-reveal-section pb-24", BAND_CONTENT_GAP]}>
    <div class="reveal-child stagger-1 mx-auto max-w-content px-gutter">
      <TermChipIndex
        ariaLabel="All LLMOps technologies"
        terms={tags.map((t) => ({
          name: t.name,
          href: `${copy.tagHubBase}/${t.slug}`,
          count: t.count,
        }))}
      />
    </div>
  </section>

  <BlogNewsletterCta content={DATABASE_CTA} brevo={BREVO_LLMOPS_CONFIG} />
</BaseLayout>

<style>
  /* House scroll-reveal pattern (reference: llmops-database/index.astro). */
  .reveal-child {
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }
  .stagger-1 { transition-delay: 60ms; }

  .scroll-reveal-section.reveal-armed:not(.in-view) .reveal-child {
    opacity: 0;
    transform: translateY(12px);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-child,
    .scroll-reveal-section.reveal-armed:not(.in-view) .reveal-child {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  import { initScrollReveal } from "../../scripts/labs-scroll-reveal";

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initScrollReveal);
  } else {
    initScrollReveal();
  }
</script>
