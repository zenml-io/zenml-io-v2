---
/**
 * Get Started — ZenML open-source onboarding, in the ZenML Labs shell
 * (`app="labs"`, `surface="ml"`, `product="zenml"`, D3). Rebuilt for the
 * product one-offs cutover (#317): the short shader band (eyebrow / h1 /
 * deck, plus the Kitaru pointer line), the code-pane step walkthrough on
 * the `labs-light` Shiki theme, the architecture section, the projects
 * grid, the resources grid, and the closing band.
 *
 * Route: /get-started · `/get-started/zenml` 301-redirects here (see
 * public/_redirects). The page still cross-links to Kitaru, whose own
 * onboarding lives on /product/kitaru.
 */
import { getCollection } from "astro:content";
import { createHighlighter } from "shiki";
import LabsBand from "../components/labs/LabsBand.astro";
import LabsButton from "../components/labs/LabsButton.astro";
import LabsCloseCta from "../components/labs/LabsCloseCta.astro";
import ProcessSteps from "../components/templates/ProcessSteps.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { BAND_CONTENT_GAP } from "../lib/blogLayout";
import {
  GET_STARTED_CLOSE,
  GET_STARTED_HERO,
  GET_STARTED_SEO,
  GET_STARTED_ZENML,
  type GetStartedStep,
} from "../lib/getStarted";
import labsLight from "../styles/labs-light.json";

type HighlighterTheme = NonNullable<
  Parameters<typeof createHighlighter>[0]["themes"]
>[number];

const highlighter = await createHighlighter({
  themes: [labsLight as HighlighterTheme],
  langs: ["python", "bash"],
});

const highlightSteps = (items: readonly GetStartedStep[]) =>
  items.map((step) => {
    const lang = step.code.includes("\n") ? "python" : "bash";
    return {
      ...step,
      language: lang,
      highlightedHtml: highlighter.codeToHtml(step.code, {
        lang,
        theme: labsLight.name,
      }),
    };
  });

const zenmlSteps = highlightSteps(GET_STARTED_ZENML.steps.items);

// Pull ZenML projects from the CMS collection if it exists
let projects: {
  data: { title: string; description?: string };
  id: string;
}[] = [];
try {
  const allProjects = await getCollection("projects");
  projects = allProjects.slice(0, 6).map((p) => ({
    data: {
      title: p.data.title ?? p.id,
      description: p.data.description,
    },
    id: p.id,
  }));
} catch {
  // Collection may not exist yet — show empty state
}
---

<BaseLayout
  title={GET_STARTED_SEO.title}
  description={GET_STARTED_SEO.description}
  ogTitle={GET_STARTED_SEO.ogTitle}
  ogDescription={GET_STARTED_SEO.ogDescription}
  ogImage={GET_STARTED_SEO.ogImage}
  surface="ml"
  app="labs"
  product="zenml"
>
  <LabsBand size="short">
    <div class="flex flex-col gap-4">
      <p class="font-sans text-[15px] leading-5 text-(--color-cream-700)">
        {GET_STARTED_HERO.eyebrow}
      </p>
      <h1 class="font-display text-[40px] leading-[44px] text-(--color-cream-900) md:text-[64px] md:leading-[70px]">
        {GET_STARTED_HERO.headline}
      </h1>
      <p class="max-w-[720px] font-sans text-[18px] leading-7 text-(--color-cream-700)">
        {GET_STARTED_HERO.deck}
      </p>
      <p class="font-sans text-[15px] leading-5 text-(--color-cream-700)">
        Looking for Kitaru? Replay and regression-test your agents from <a href="/product/kitaru" class="font-medium text-(--color-sage-700) underline underline-offset-4 hover:text-(--color-sage-800)">its own start page</a>.
      </p>
    </div>
  </LabsBand>

  {/* Steps */}
  <section class:list={["pb-24 md:pb-32", BAND_CONTENT_GAP]}>
    <div class="mx-auto max-w-content px-gutter">
      <h2 class="font-display text-[32px] leading-[36px] text-(--color-cream-900) md:text-[44px] md:leading-[48px]">
        {GET_STARTED_ZENML.steps.headline}
      </h2>
      <ProcessSteps layout="vertical-code" skin="labs" steps={zenmlSteps} class="mt-12" />
    </div>
  </section>

  {/* Architecture */}
  <section class="py-24 md:py-32 bg-(--color-sage-50)">
    <div class="mx-auto max-w-content px-gutter">
      <h2 class="font-display text-[32px] leading-[36px] text-(--color-cream-900) md:text-[44px] md:leading-[48px]">
        {GET_STARTED_ZENML.architecture.headline}
      </h2>
      <p class="mt-6 max-w-[720px] font-sans text-[17px] leading-[26px] text-(--color-cream-700)">
        {GET_STARTED_ZENML.architecture.body}
      </p>
      <img
        src={GET_STARTED_ZENML.architecture.image.url}
        alt={GET_STARTED_ZENML.architecture.image.alt}
        class="mt-10 w-full rounded-[20px] border border-(--color-border) bg-card p-6 md:p-10"
        loading="lazy"
      />
      <div class="mt-10">
        <LabsButton
          cta={{
            ...GET_STARTED_ZENML.architecture.primaryCta,
            analytics: "GetStarted-Architecture-Deploy",
          }}
        />
      </div>
    </div>
  </section>

  {/* Projects */}
  <section class="py-24 md:py-32">
    <div class="mx-auto max-w-content px-gutter">
      <h2 class="font-display text-[32px] leading-[36px] text-(--color-cream-900) md:text-[44px] md:leading-[48px]">
        {GET_STARTED_ZENML.projects.headline}
      </h2>
      <p class="mt-6 max-w-[720px] font-sans text-[17px] leading-[26px] text-(--color-cream-700)">
        {GET_STARTED_ZENML.projects.deck}
      </p>
      {projects.length > 0 ? (
        <ul class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {projects.map((project) => (
            <li>
              <a
                href={`/projects/${project.id}`}
                class="group flex h-full flex-col rounded-[20px] border border-(--color-border) bg-card p-8 transition-colors duration-200 ease-out hover:border-(--color-sage-400)"
              >
                <h3 class="font-display text-[20px] leading-[26px] text-(--color-cream-900) transition-colors duration-200 ease-out group-hover:text-(--color-sage-800)">
                  {project.data.title}
                </h3>
                {project.data.description && (
                  <p class="mt-3 line-clamp-2 font-sans text-[15px] leading-5 text-(--color-cream-700)">
                    {project.data.description}
                  </p>
                )}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-6 font-sans text-[15px] text-(--color-cream-700)">Projects coming soon.</p>
      )}
      <div class="mt-12">
        <LabsButton
          cta={{ ...GET_STARTED_ZENML.projects.cta, analytics: "GetStarted-Projects-All" }}
          tone="ghost"
        />
      </div>
    </div>
  </section>

  {/* Resources */}
  <section class="py-24 md:py-32">
    <div class="mx-auto max-w-content px-gutter">
      <h2 class="font-display text-[32px] leading-[36px] text-(--color-cream-900) md:text-[44px] md:leading-[48px]">
        {GET_STARTED_ZENML.resources.headline}
      </h2>
      <p class="mt-6 max-w-[720px] font-sans text-[17px] leading-[26px] text-(--color-cream-700)">
        {GET_STARTED_ZENML.resources.body}
      </p>
      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
        {GET_STARTED_ZENML.resources.items.map((resource) => (
          <a
            href={resource.href}
            target={resource.external ? "_blank" : undefined}
            rel={resource.external ? "noopener noreferrer" : undefined}
            class="group relative flex flex-col rounded-[20px] border border-(--color-border) bg-card p-8 transition-colors duration-200 ease-out hover:border-(--color-sage-400)"
          >
            {resource.external && (
              <svg
                width="16"
                height="16"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="absolute top-8 right-8 text-(--color-cream-500)"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M6 3H3v10h10v-3M9 2h5v5M14 2L7 9" />
              </svg>
            )}
            <h3 class="font-display text-[20px] leading-[26px] text-(--color-cream-900)">
              {resource.title}
            </h3>
            <p class="mt-3 font-sans text-[15px] leading-5 text-(--color-cream-700)">
              {resource.body}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <LabsCloseCta content={GET_STARTED_CLOSE} />
</BaseLayout>

<script>
  import { initCodeCopy } from "../scripts/code-copy";
  initCodeCopy();
</script>
