---
/**
 * Get Started — ML/Agent workspace chooser (Phase 4).
 *
 * Route: /get-started  (URL preserved per MERGE_PLAN §9 — 8.6k visitors/mo)
 *
 * Two-card chooser between the two workspaces:
 *   - ZenML (ML pipelines)  →  /get-started/zenml  (the previous deep
 *     onboarding flow, intact, moved one level down)
 *   - Kitaru (AI agents)    →  /product/kitaru  (Kitaru landing has its
 *     own pip-install + quickstart code path)
 *
 * Plan note: D6 says /get-started "becomes a chooser fork". Conversion
 * path branches here. URL stays the same. Visual polish is intentionally
 * understated — Zuri will iterate before launch.
 */
import BaseLayout from "../layouts/BaseLayout.astro";

const PAGE = {
  title: "Get started with ZenML or Kitaru",
  description:
    "Pick the workspace that fits your workload. ZenML for ML pipelines and training workflows. Kitaru for long-running AI agents with durable execution.",
};
---

<BaseLayout
  title={PAGE.title}
  description={PAGE.description}
  surface="unified"
>
  <main class="bg-linear-to-b from-zenml-50 to-white">
    <section class="mx-auto max-w-6xl px-4 pt-16 pb-20 sm:px-6 sm:pt-24 sm:pb-28 lg:px-8">
      <header class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-zenml-500">
          Get started
        </p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl lg:text-5xl">
          Pick the workspace you're building in
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-gray-600">
          ZenML and Kitaru are two workspaces under the same product. Different
          workloads, different SDKs, same infrastructure underneath.
        </p>
      </header>

      <div class="mt-12 grid gap-6 sm:mt-16 lg:grid-cols-2 lg:gap-8">
        {/* ZenML — ML pipelines */}
        <a
          href="/get-started/zenml"
          class="group relative flex flex-col rounded-2xl border border-gray-200 bg-white p-8 transition hover:border-zenml-300 hover:shadow-lg sm:p-10"
          data-analytics="GetStartedChoose:ML"
        >
          <p class="text-sm font-semibold uppercase tracking-wider text-zenml-500">
            ZenML · ML workspace
          </p>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">
            Build ML pipelines
          </h2>
          <p class="mt-4 text-base leading-relaxed text-gray-600">
            Reproducible training, batch inference, evaluation, and deployment.
            Orchestrate across your existing tools, clouds, and environments
            with explicit DAGs and versioned artifacts.
          </p>
          <ul class="mt-6 space-y-2 text-sm text-gray-700">
            <li class="flex gap-2">
              <span aria-hidden="true" class="text-zenml-500">→</span>
              Pipeline DAGs with typed step interfaces
            </li>
            <li class="flex gap-2">
              <span aria-hidden="true" class="text-zenml-500">→</span>
              Artifact store, model registry, and stack abstraction
            </li>
            <li class="flex gap-2">
              <span aria-hidden="true" class="text-zenml-500">→</span>
              Runs on Kubernetes, Vertex, SageMaker, Airflow, and more
            </li>
          </ul>
          <span class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-zenml-600 group-hover:gap-3 transition-all">
            Start with ZenML
            <span aria-hidden="true">→</span>
          </span>
        </a>

        {/* Kitaru — AI agents */}
        <a
          href="/product/kitaru"
          class="group relative flex flex-col rounded-2xl border border-gray-200 bg-white p-8 transition hover:border-zenml-300 hover:shadow-lg sm:p-10"
          data-analytics="GetStartedChoose:Agent"
        >
          <p class="text-sm font-semibold uppercase tracking-wider text-zenml-500">
            Kitaru · Agent workspace
          </p>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">
            Build AI agents
          </h2>
          <p class="mt-4 text-base leading-relaxed text-gray-600">
            Long-running Python agents with durable execution. Add checkpoints,
            replay, wait/resume, and human-in-the-loop without rewriting your
            code. Plain Python control flow, two decorators.
          </p>
          <ul class="mt-6 space-y-2 text-sm text-gray-700">
            <li class="flex gap-2">
              <span aria-hidden="true" class="text-zenml-500">→</span>
              <code class="rounded bg-gray-100 px-1.5 py-0.5 font-mono text-[13px]">@flow</code>
              and
              <code class="rounded bg-gray-100 px-1.5 py-0.5 font-mono text-[13px]">@checkpoint</code>
              — that's the API surface
            </li>
            <li class="flex gap-2">
              <span aria-hidden="true" class="text-zenml-500">→</span>
              Resume from any checkpoint after a crash, rate limit, or human review
            </li>
            <li class="flex gap-2">
              <span aria-hidden="true" class="text-zenml-500">→</span>
              MCP, CLI, and typed-client surfaces for ops control
            </li>
          </ul>
          <span class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-zenml-600 group-hover:gap-3 transition-all">
            Start with Kitaru
            <span aria-hidden="true">→</span>
          </span>
        </a>
      </div>

      <div class="mt-12 text-center text-sm text-gray-600">
        Not sure?
        <a href="/compare" class="font-semibold text-zenml-600 hover:text-zenml-700">
          Compare ZenML and Kitaru against alternatives
        </a>
        or
        <a href="/pro" class="font-semibold text-zenml-600 hover:text-zenml-700">
          see the unified Pro plan
        </a>.
      </div>
    </section>
  </main>
</BaseLayout>
