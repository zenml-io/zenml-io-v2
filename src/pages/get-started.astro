---
/**
 * Get Started — the open-source quickstart for both products, in the ZenML
 * Labs shell (`app="labs"`, `surface="unified"`). A short shader band
 * (eyebrow / h1 / deck and two jump links), then one track per product,
 * Kitaru first: a headline block, the code-pane step walkthrough on the
 * `labs-light` Shiki theme and a link to that product's docs. Then a
 * resources grid and the closing band. Commands follow the docs quickstarts.
 *
 * Route: /get-started · `/get-started/zenml` 301-redirects here (see
 * public/_redirects).
 */
import LabsBand from "../components/labs/LabsBand.astro";
import LabsButton from "../components/labs/LabsButton.astro";
import LabsCloseCta from "../components/labs/LabsCloseCta.astro";
import LabsTextLink from "../components/labs/LabsTextLink.astro";
import ProcessSteps from "../components/templates/ProcessSteps.astro";
import { LABS_EYEBROW_CLASS } from "../components/templates/pageHeaderPresets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { BAND_CONTENT_GAP } from "../lib/blogLayout";
import {
  GET_STARTED_CLOSE,
  GET_STARTED_HERO,
  GET_STARTED_KITARU,
  GET_STARTED_RESOURCES,
  GET_STARTED_SEO,
  GET_STARTED_ZENML,
  type GetStartedTrack,
} from "../lib/getStarted";
import { LABS_CODE_THEME, labsHighlighter } from "../lib/labsHighlighter";

const tracks = [GET_STARTED_KITARU, GET_STARTED_ZENML].map(
  (track: GetStartedTrack) => ({
    ...track,
    steps: track.steps.map((step) => ({
      ...step,
      language: step.lang,
      highlightedHtml: labsHighlighter.codeToHtml(step.code, {
        lang: step.lang,
        theme: LABS_CODE_THEME,
      }),
    })),
  }),
);
---

<BaseLayout
  title={GET_STARTED_SEO.title}
  description={GET_STARTED_SEO.description}
  ogTitle={GET_STARTED_SEO.ogTitle}
  ogDescription={GET_STARTED_SEO.ogDescription}
  ogImage={GET_STARTED_SEO.ogImage}
  surface="unified"
  app="labs"
>
  <LabsBand size="short">
    <div class="flex flex-col gap-4">
      <p class={LABS_EYEBROW_CLASS}>
        {GET_STARTED_HERO.eyebrow}
      </p>
      <h1 class="font-display text-[40px] leading-[44px] text-(--color-cream-900) md:text-[64px] md:leading-[70px]">
        {GET_STARTED_HERO.headline}
      </h1>
      <p class="max-w-[720px] font-sans text-[18px] leading-7 text-pretty text-(--color-cream-700)">
        {GET_STARTED_HERO.deck}
      </p>
      <nav class="mt-4 flex flex-wrap gap-3" aria-label="Jump to a product">
        {GET_STARTED_HERO.jump.map((link, index) => (
          <LabsButton cta={link} tone={index === 0 ? "dark" : "ghost"} />
        ))}
      </nav>
    </div>
  </LabsBand>

  {tracks.map((track, index) => (
    <section
      id={track.id}
      aria-labelledby={`${track.id}-title`}
      class:list={["scroll-mt-28 pb-24 md:pb-32", index === 0 ? BAND_CONTENT_GAP : "border-t border-border pt-24 md:pt-32"]}
    >
      <div class="mx-auto max-w-content px-gutter">
        <p class={LABS_EYEBROW_CLASS}>{track.eyebrow}</p>
        <h2 id={`${track.id}-title`} class="mt-3 font-display text-[32px] leading-[36px] text-(--color-cream-900) md:text-[44px] md:leading-[48px]">
          {track.headline}
        </h2>
        <p class="mt-4 max-w-[720px] font-sans text-[17px] leading-[26px] text-pretty text-(--color-cream-700)">
          {track.deck}
        </p>
        <ProcessSteps layout="vertical-code" skin="labs" steps={track.steps} class="mt-12" />
        <LabsTextLink cta={track.docs} external class="mt-10" />
      </div>
    </section>
  ))}

  <section class="border-t border-border py-24 md:py-32">
    <div class="mx-auto max-w-content px-gutter">
      <h2 class="font-display text-[32px] leading-[36px] text-(--color-cream-900) md:text-[44px] md:leading-[48px]">
        {GET_STARTED_RESOURCES.headline}
      </h2>
      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
        {GET_STARTED_RESOURCES.items.map((resource) => (
          <a
            href={resource.href}
            target={resource.external ? "_blank" : undefined}
            rel={resource.external ? "noopener noreferrer" : undefined}
            class="group relative flex flex-col rounded-[20px] border border-(--color-border) bg-card p-8 transition-colors duration-200 ease-out hover:border-(--color-sage-400)"
          >
            {resource.external && (
              <svg
                width="16"
                height="16"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="absolute top-8 right-8 text-(--color-cream-500)"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M6 3H3v10h10v-3M9 2h5v5M14 2L7 9" />
              </svg>
            )}
            <h3 class="font-display text-[20px] leading-[26px] text-(--color-cream-900)">
              {resource.title}
            </h3>
            <p class="mt-3 font-sans text-[15px] leading-5 text-(--color-cream-700)">
              {resource.body}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <LabsCloseCta content={GET_STARTED_CLOSE} />
</BaseLayout>

<script>
  import { initCodeCopy } from "../scripts/code-copy";
  initCodeCopy();
</script>
