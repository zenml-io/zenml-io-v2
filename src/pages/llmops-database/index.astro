---
/**
 * LLMOps Database listing page, in the ZenML Labs shell (`app="labs"`,
 * `surface="ml"`) — the databases cutover (#256) puts it on the same
 * sequence as `/blog`: the short shader band (name + deck), then the shared
 * `DataFilterIndex` island skinned "labs", then the closing CTA band.
 *
 * Server-side: resolves tag/industry display names and the entry count, and
 * renders the no-JS fallback. Client-side: the LlmopsIndex island fetches
 * /llmops-index.json and handles filtering, search, sorting, pagination and
 * URL state in the browser — the count is passed in because the island only
 * learns the real total after that fetch.
 *
 * Route: /llmops-database
 */
import { getCollection } from "astro:content";
import {
  TERM_CHIP,
  TERM_CHIP_HEXAGON_PATH,
  TERM_CHIP_HEXAGON_VIEWBOX,
  TERM_CHIP_OVERFLOW,
} from "../../components/blog/termChipStyles";
import LlmopsIndex from "../../components/islands/filter-index/LlmopsIndex";
import BlogNewsletterCta from "../../components/labs/BlogNewsletterCta.astro";
import LabsHero from "../../components/labs/LabsHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BAND_CONTENT_GAP, blogLaneStyle } from "../../lib/blogLayout";
import {
  DATABASE_CTA,
  DATABASE_PAGE_SIZE,
  DATABASES,
} from "../../lib/databases";
import { BREVO_LLMOPS_CONFIG } from "../../lib/formConstants";
import { getNonDraftLlmopsDatabaseCount } from "../../lib/llmops";
import { defaultOgUrl, hasDefaultOgCard } from "../../lib/seo";

const copy = DATABASES.llmops;

// Resolve tag + industry display names for the filter UI
const allTags = (await getCollection("llmops-tags"))
  .map((t) => ({ slug: t.data.slug, name: t.data.name }))
  .sort((a, b) => a.name.localeCompare(b.name));

const allIndustries = (await getCollection("industry-tags"))
  .map((i) => ({ slug: i.data.slug, name: i.data.name }))
  .sort((a, b) => a.name.localeCompare(b.name));

// Count for the band's deck and the search box (non-draft entries)
const entryCount = await getNonDraftLlmopsDatabaseCount();

/** The no-JS fallback lists the first 20 tags, then says how many are left. */
const NOSCRIPT_TAGS = 20;
const noscriptTags = allTags.slice(0, NOSCRIPT_TAGS);
const noscriptTagOverflow = allTags.length - noscriptTags.length;
const GROUP_LABEL = "text-[13px] font-medium text-(--color-cream-700)";
---

<BaseLayout
  ogImage={hasDefaultOgCard("pages", "llmops-database") ? defaultOgUrl("pages", "llmops-database") : undefined}
  title={copy.seoTitle}
  description={copy.seoDescription(entryCount)}
  surface="ml"
  app="labs"
>
  <div style={blogLaneStyle()}>
    <LabsHero band="short" content={{ headline: copy.name, deck: copy.description(entryCount) }} />

    <section class:list={["scroll-reveal-section pb-24", BAND_CONTENT_GAP]}>
      <div class="reveal-child stagger-1 mx-auto max-w-content px-gutter">
        {/* Interactive filter island — hydrates immediately */}
        <LlmopsIndex
          client:load
          tags={allTags}
          industries={allIndustries}
          entryCount={entryCount}
          pageSize={DATABASE_PAGE_SIZE}
        />

        {/* No-JS fallback: the same two axes the rail filters by, as links */}
        <noscript>
          <div class="flex flex-col gap-8">
            <p class="text-[15px] leading-6 text-(--color-cream-700)">{copy.noscriptIntro}</p>
            <div class="flex flex-col gap-3">
              <h2 class={GROUP_LABEL}>Browse by tag</h2>
              <div class="flex flex-wrap gap-2">
                {noscriptTags.map((tag) => (
                  <a href={`/llmops-tags/${tag.slug}`} class={TERM_CHIP}>
                    <svg viewBox={TERM_CHIP_HEXAGON_VIEWBOX} class="h-[14px] w-3 fill-(--color-sage-600)" aria-hidden="true">
                      <path d={TERM_CHIP_HEXAGON_PATH} />
                    </svg>
                    {tag.name}
                  </a>
                ))}
                {noscriptTagOverflow > 0 && (
                  <span class={TERM_CHIP_OVERFLOW}>+{noscriptTagOverflow} more</span>
                )}
              </div>
            </div>
            <div class="flex flex-col gap-3">
              <h2 class={GROUP_LABEL}>Browse by industry</h2>
              <div class="flex flex-wrap gap-2">
                {allIndustries.map((industry) => (
                  <a href={`/industry-tags/${industry.slug}`} class={TERM_CHIP}>
                    <svg viewBox={TERM_CHIP_HEXAGON_VIEWBOX} class="h-[14px] w-3 fill-(--color-sage-600)" aria-hidden="true">
                      <path d={TERM_CHIP_HEXAGON_PATH} />
                    </svg>
                    {industry.name}
                  </a>
                ))}
              </div>
            </div>
          </div>
        </noscript>
      </div>
    </section>

    <section class="scroll-reveal-section">
      <div class="reveal-child stagger-1">
        <BlogNewsletterCta content={DATABASE_CTA} brevo={BREVO_LLMOPS_CONFIG} />
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* House scroll-reveal pattern (reference: blog/index.astro). The hidden
   * start state applies only once the script has armed the section, so the
   * server-rendered page is fully visible without JS. */
  .reveal-child {
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }
  .stagger-1 { transition-delay: 60ms; }

  .scroll-reveal-section.reveal-armed:not(.in-view) .reveal-child {
    opacity: 0;
    transform: translateY(12px);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-child,
    .scroll-reveal-section.reveal-armed:not(.in-view) .reveal-child {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  import { initScrollReveal } from "../../scripts/labs-scroll-reveal";

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScrollReveal);
  } else {
    initScrollReveal();
  }
</script>
