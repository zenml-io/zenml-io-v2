---
/**
 * LLMOps Database detail page.
 *
 * Renders individual LLMOps entries in DatabaseEntryLayout.astro: company
 * info, tags, summary, body, and related entries ("More like this").
 * Generates /llmops-database/<slug> for each published entry.
 */
import { getEntry, render } from "astro:content";
import type { RelatedRailItem } from "../../components/templates/RelatedRail.astro";
import DatabaseEntryLayout from "../../layouts/DatabaseEntryLayout.astro";
import {
  buildRelatedIndex,
  getAllPublishedEntries,
  getRelatedFromIndex,
} from "../../lib/llmops";

export async function getStaticPaths() {
  const allEntries = await getAllPublishedEntries();
  const relatedIndex = buildRelatedIndex(allEntries);

  return allEntries.map((entry) => {
    const related = getRelatedFromIndex(relatedIndex, entry, 3);
    return {
      params: { slug: entry.data.slug },
      props: { entry, related },
    };
  });
}

const { entry, related } = Astro.props;
const { Content, headings } = await render(entry);

// Resolve llmops tags for display names
const tagEntries = await Promise.all(
  entry.data.llmopsTags.map((slug: string) => getEntry("llmops-tags", slug)),
);
const resolvedTags = tagEntries.flatMap((t) =>
  t ? [{ name: t.data.name, slug: t.data.slug }] : [],
);
const tags = resolvedTags.map((tag) => ({
  name: tag.name,
  href: `/llmops-tags/${tag.slug}`,
}));

// Resolve industry tag
const industryEntry = entry.data.industryTags
  ? await getEntry("industry-tags", entry.data.industryTags)
  : undefined;

// Resolve related entries' display data
const relatedItems: RelatedRailItem[] = related.map((r) => ({
  kind: "hex-card" as const,
  href: `/llmops-database/${r.data.slug}`,
  title: r.data.title,
  kindLabel: [r.data.company, r.data.year ? String(r.data.year) : undefined]
    .filter(Boolean)
    .join(" · "),
}));

// SEO
const seoTitle =
  entry.data.seo?.title || `${entry.data.title} - ZenML LLMOps Database`;
const seoDescription = entry.data.seo?.description || entry.data.summary;
const ogImage = entry.data.seo?.ogImage;

const pagefindMeta: Record<string, string> = { slug: entry.data.slug };
if (entry.data.company) pagefindMeta.company = entry.data.company;
if (entry.data.year) pagefindMeta.year = String(entry.data.year);

const pagefindFilters = [
  ...resolvedTags.map((tag) => ({ key: "tag", value: tag.slug })),
  ...(industryEntry
    ? [{ key: "industry", value: industryEntry.data.slug }]
    : []),
];
---

<DatabaseEntryLayout
  database="llmops"
  entryTitle={entry.data.title}
  company={entry.data.company}
  year={entry.data.year}
  sourceHref={entry.data.link}
  summary={entry.data.summary}
  industry={
    industryEntry
      ? {
          name: industryEntry.data.name,
          href: `/industry-tags/${industryEntry.data.slug}`,
        }
      : undefined
  }
  tags={tags}
  headings={headings}
  related={relatedItems}
  pagefindMeta={pagefindMeta}
  pagefindFilters={pagefindFilters}
  title={seoTitle}
  description={seoDescription}
  ogImage={ogImage}
  ogTitle={entry.data.seo?.ogTitle}
  ogDescription={entry.data.seo?.ogDescription}
  canonical={entry.data.seo?.canonical}
>
  <Content />
</DatabaseEntryLayout>
