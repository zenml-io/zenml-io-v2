---
import { getPublishedTeamMembers } from "../../lib/team";

// Retain legacy URLs without rendering individual profile pages.
// The matching Cloudflare rule in public/_redirects supplies the edge 301.
export async function getStaticPaths() {
  const members = await getPublishedTeamMembers();
  return members.map((member) => ({ params: { slug: member.data.slug } }));
}

return Astro.redirect("/team", 301);
---
