---
/**
 * Author taxonomy page.
 *
 * Shows author bio + all blog posts by this author using the shared BlogCard.
 * Generates /author/<slug> for each author in the collection.
 */
import { getCollection, getEntry } from "astro:content";
import CategoryBar from "../../components/blog/CategoryBar.astro";
import PageHeader from "../../components/templates/PageHeader.astro";
import { TAXONOMY_BAND } from "../../components/templates/pageHeaderPresets";
import TermHubEditorial from "../../components/templates/TermHubEditorial.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCategoryCounts, getMainFeedPosts } from "../../lib/blog";

export async function getStaticPaths() {
  const authors = await getCollection("authors");
  const allPosts = await getCollection("blog", ({ data }) => !data.draft);
  const usedSlugs = new Set(allPosts.map((p) => p.data.author));
  return authors
    .filter((author) => usedSlugs.has(author.data.slug))
    .map((author) => ({
      params: { slug: author.data.slug },
      props: { author },
    }));
}

const { author } = Astro.props;

const allPosts = (
  await getCollection(
    "blog",
    ({ data }) => !data.draft && data.author === author.data.slug,
  )
).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

// Category bar data
const allFeedPosts = await getMainFeedPosts();
const categories = await getCategoryCounts(allFeedPosts);

// Resolve categories for cards
const categoryMap = new Map<string, { name: string; slug: string }>();
for (const post of allPosts) {
  if (post.data.category && !categoryMap.has(post.data.category)) {
    const cat = await getEntry("categories", post.data.category);
    if (cat)
      categoryMap.set(post.data.category, {
        name: cat.data.name,
        slug: cat.data.slug,
      });
  }
}
---

<BaseLayout
  title={`${author.data.name} - ZenML Blog`}
  description={author.data.bio || `Blog posts by ${author.data.name} on the ZenML blog.`}
  surface="ml"
>
  <CategoryBar backLink categories={categories} />

  {/* Author header — gradient section */}
  <PageHeader
    tone="brand"
    {...TAXONOMY_BAND}
    heading={author.data.name}
    masthead={{
      avatar: author.data.avatar,
      name: author.data.name,
      bio: author.data.bio,
      meta: `${allPosts.length} ${allPosts.length === 1 ? "post" : "posts"}`,
      links: [
        ...(author.data.email
          ? [{ href: `mailto:${author.data.email}`, label: "Email" }]
          : []),
        ...(author.data.linkedin
          ? [{ href: author.data.linkedin, label: "LinkedIn", external: true }]
          : []),
      ],
    }}
  />

  <div class="mx-auto max-w-[1440px] px-4 py-10 sm:px-6 lg:px-8">
    <TermHubEditorial
      posts={allPosts.map((post) => {
        const category = categoryMap.get(post.data.category || "");
        return {
          href: `/blog/${post.data.slug}`,
          title: post.data.title,
          excerpt: post.data.seo?.description,
          image: post.data.mainImage,
          authorName: author.data.name,
          authorSlug: author.data.slug,
          readingTime: post.data.readingTime,
          categoryName: category?.name,
          categorySlug: category?.slug,
        };
      })}
      emptyHeading="No posts by this author yet."
    />
  </div>
</BaseLayout>
