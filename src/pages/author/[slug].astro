---
/**
 * Author taxonomy page (blog cutover, D2d/§6): the split masthead
 * (avatar/bio/links identity block, with the shared breadcrumb above it)
 * now lives directly in the `labs.band` shader band — moved out of
 * `PageHeader`'s masthead branch rather than duplicated, since this page
 * was that branch's only live consumer — plus the `term-hub.editorial`
 * card grid (`labs.blog-card`), an "Other authors" sibling strip, and
 * 12/page client pagination.
 */
import { getCollection, getEntry } from "astro:content";
import Image from "../../components/Image.astro";
import { HubPagination } from "../../components/islands/HubPagination";
import BlogNewsletterCta from "../../components/labs/BlogNewsletterCta.astro";
import LabsBand from "../../components/labs/LabsBand.astro";
import Breadcrumb from "../../components/system/Breadcrumb.astro";
import TermHubEditorial from "../../components/templates/TermHubEditorial.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getAllPublishedPosts,
  getBlogProduct,
  PAGE_SIZE,
} from "../../lib/blog";
import { BAND_CONTENT_GAP } from "../../lib/blogLayout";
import { filterUsedTerms } from "../../lib/relatedIndex";
import { defaultOgUrl, hasDefaultOgCard } from "../../lib/seo";

export async function getStaticPaths() {
  const authors = await getCollection("authors");
  const allPosts = await getCollection("blog", ({ data }) => !data.draft);
  const usedSlugs = new Set(allPosts.map((p) => p.data.author));
  return authors
    .filter((author) => usedSlugs.has(author.data.slug))
    .map((author) => ({
      params: { slug: author.data.slug },
      props: { author },
    }));
}

const { author } = Astro.props;

const allPosts = (
  await getCollection(
    "blog",
    ({ data }) => !data.draft && data.author === author.data.slug,
  )
).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const categoryMap = new Map<string, { name: string; slug: string }>();
for (const post of allPosts) {
  if (post.data.category && !categoryMap.has(post.data.category)) {
    const cat = await getEntry("categories", post.data.category);
    if (cat)
      categoryMap.set(post.data.category, {
        name: cat.data.name,
        slug: cat.data.slug,
      });
  }
}

// Sibling authors strip: every other author with at least one main-feed
// post, alphabetical.
const allFeedPosts = await getAllPublishedPosts();
const countMap = new Map<string, number>();
for (const post of allFeedPosts) {
  if (post.data.author) {
    countMap.set(post.data.author, (countMap.get(post.data.author) ?? 0) + 1);
  }
}
const allAuthors = await getCollection("authors");
const siblingAuthors = filterUsedTerms(
  allAuthors.map((a) => ({
    slug: a.data.slug,
    name: a.data.name,
    count: countMap.get(a.data.slug) ?? 0,
  })),
)
  .filter((a) => a.slug !== author.data.slug)
  .sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout
  ogImage={hasDefaultOgCard("pages", "author") ? defaultOgUrl("pages", "author") : undefined}
  title={`${author.data.name} - ZenML Blog`}
  description={author.data.bio || `Blog posts by ${author.data.name} on the ZenML blog.`}
  surface="ml"
  app="labs"
>
  <LabsBand size="short">
    <div class="flex flex-col gap-4">
      <Breadcrumb
        items={[
          { label: "Blog", href: "/blog" },
          { label: "Authors", href: "/author" },
          { label: author.data.name },
        ]}
        separator="chevron"
      />
      <div>
        <p class="mb-3 font-sans text-[15px] leading-5 text-(--color-cream-700)">
          Author
        </p>
        <div class="flex items-center gap-6">
          {author.data.avatar && (
            <Image
              image={author.data.avatar}
              alt={author.data.name}
              class="h-20 w-20 shrink-0 rounded-full border border-(--color-border) object-cover"
            />
          )}
          <div>
            <h1 class="font-display text-[40px] leading-[44px] text-(--color-cream-900) md:text-[64px] md:leading-[70px]">
              {author.data.name}
            </h1>
            {author.data.bio && (
              <p class="mt-2 max-w-[690px] font-sans text-[17px] leading-[26px] text-foreground md:text-xl md:leading-[30px]">
                {author.data.bio}
              </p>
            )}
            <div class="mt-3 flex items-center gap-4 text-[14px]">
              <span class="text-(--color-cream-700)">
                {allPosts.length} {allPosts.length === 1 ? "post" : "posts"}
              </span>
              {author.data.email && (
                <a
                  href={`mailto:${author.data.email}`}
                  class="font-medium text-(--color-sage-700) hover:text-(--color-sage-800)"
                >
                  Email
                </a>
              )}
              {author.data.linkedin && (
                <a
                  href={author.data.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-medium text-(--color-sage-700) hover:text-(--color-sage-800)"
                >
                  LinkedIn
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  </LabsBand>

  <section class:list={["scroll-reveal-section pb-24", BAND_CONTENT_GAP]}>
    <div class="mx-auto max-w-content px-gutter">
      <TermHubEditorial
        emptyHeading={`No posts by ${author.data.name} yet.`}
        siblingsHeading={siblingAuthors.length > 0 ? "Other authors" : undefined}
        siblings={siblingAuthors.map((a) => ({
          name: a.name,
          href: `/author/${a.slug}`,
        }))}
        viewAll={{ href: "/author", label: "View all" }}
        posts={allPosts.map((post) => {
          const category = categoryMap.get(post.data.category || "");
          return {
            href: `/blog/${post.data.slug}`,
            title: post.data.title,
            excerpt: post.data.seo?.description,
            image: post.data.mainImage,
            authorName: author.data.name,
            authorSlug: author.data.slug,
            authorAvatar: author.data.avatar,
            readingTime: post.data.readingTime,
            publishedDate: post.data.date,
            categoryName: category?.name,
            categorySlug: category?.slug,
            product: getBlogProduct(post),
          };
        })}
      />

      {allPosts.length > PAGE_SIZE && (
        <HubPagination
          client:idle
          containerId="term-hub-grid"
          totalItems={allPosts.length}
          pageSize={PAGE_SIZE}
        />
      )}
    </div>
  </section>

  <BlogNewsletterCta />
</BaseLayout>
