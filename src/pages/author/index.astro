---
/**
 * Blog authors index page (blog cutover, D2d/§6).
 *
 * Lists all blog authors with post counts, sorted by popularity, as
 * `data-display.stacked-list` rows (`skin="labs"`, name + count) under the
 * shared `page-header.with-breadcrumb` term-hub header. Route: /author
 */
import { getCollection } from "astro:content";
import PageHeader from "../../components/templates/PageHeader.astro";
import { TERM_HUB_HEADER_INTRO } from "../../components/templates/pageHeaderPresets";
import StackedList from "../../components/templates/StackedList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllPublishedPosts } from "../../lib/blog";
import { filterUsedTerms } from "../../lib/relatedIndex";

const allPosts = await getAllPublishedPosts();
const countMap = new Map<string, number>();
for (const post of allPosts) {
  if (post.data.author) {
    countMap.set(post.data.author, (countMap.get(post.data.author) ?? 0) + 1);
  }
}

// Merge all taxonomy terms with used counts, then drop zero-count authors
// (#249) — a zero-count author has no [slug] page to link to any more.
const allAuthors = await getCollection("authors");
const merged = allAuthors.map((a) => ({
  slug: a.data.slug,
  name: a.data.name,
  count: countMap.get(a.data.slug) ?? 0,
}));
const authors = filterUsedTerms(merged).sort(
  (a, b) => b.count - a.count || a.name.localeCompare(b.name),
);
---

<BaseLayout
  title="Blog Authors - ZenML"
  description="Browse all authors who have written for the ZenML blog."
  surface="ml"
  app="labs"
>
  {/* pt-[148px] clears the floating Labs nav (bottom edge 92px mobile /
      108px desktop) with margin to spare — matches LabsBand's "short"
      clearance so every blog-surface breadcrumb starts at the same offset. */}
  <section class="scroll-reveal-section px-gutter pt-[148px] pb-24">
    <div class="mx-auto max-w-content">
      <PageHeader
        breadcrumb={[{ label: "Blog", href: "/blog" }, { label: "Authors" }]}
        breadcrumbSeparator="chevron"
        heading="Authors"
        description={`${authors.length} ${authors.length === 1 ? "author" : "authors"} on the blog`}
        classOverrides={TERM_HUB_HEADER_INTRO}
      />

      <div class="mt-10 border-t border-(--color-border)">
        <StackedList
          skin="labs"
          items={authors.map((a) => ({
            title: a.name,
            href: `/author/${a.slug}`,
            trailingCount: a.count,
          }))}
        />
      </div>
    </div>
  </section>
</BaseLayout>
