---
import ContentLayout from "../layouts/ContentLayout.astro";
/**
 * Imprint — legal company information page (required by German law).
 *
 * Uses ContentLayout for the prose wrapper, but the content is a simple
 * three-column fact grid inside the Labs prose layout, not long-form text.
 *
 * Route: /imprint
 */
import { COMPANY_ADDRESS } from "../lib/constants";
---

<ContentLayout
  title="Imprint - ZenML"
  description="Legal company information for ZenML GmbH, Munich, Germany."
  surface="ml"
  heading="Imprint"
>
  <div class="not-prose grid grid-cols-1 gap-8 sm:grid-cols-3">
    <div>
      <p class="text-base leading-[24px] text-(--color-cream-700)">
        <strong class="text-foreground">ZenML GmbH</strong><br /><br />
        {COMPANY_ADDRESS.street}<br />
        {COMPANY_ADDRESS.postalCode} {COMPANY_ADDRESS.city}, {COMPANY_ADDRESS.countryName}
      </p>
    </div>
    <div>
      <p class="text-base leading-[24px] text-(--color-cream-700)">
        <strong class="text-foreground">Commercial Register:</strong><br /><br />
        Munich HRB 268487<br />
        VAT-ID: DE347731347
      </p>
    </div>
    <div>
      <p class="text-base leading-[24px] text-(--color-cream-700)">
        <strong class="text-foreground">Represented by:</strong><br /><br />
        Adam Probst<br />
        Hamza Tahir
      </p>
    </div>
  </div>
</ContentLayout>
