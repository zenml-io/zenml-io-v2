---
/**
 * ZenML Pro page, in the ZenML Labs shell (`app="labs"`, `surface="unified"`
 * — no `product`, D3). What ZenML Pro is: a landing-band hero, the logo
 * trust bar, what Pro adds on each product (the same ZenML and Kitaru cards
 * as /pricing), how it fits on your stack (the homepage's stack layer), the
 * customer quotes, the compliance section (shared markup with /pricing),
 * the open-source value props, the FAQ, and the closing band.
 *
 * Route: /pro
 */
import ComplianceCard from "../components/labs/ComplianceCard.astro";
import CustomerStoryCards from "../components/labs/CustomerStoryCards.astro";
import LabsCloseCta from "../components/labs/LabsCloseCta.astro";
import LabsFaq from "../components/labs/LabsFaq.astro";
import LabsHero from "../components/labs/LabsHero.astro";
import LabsStackLayer from "../components/labs/LabsStackLayer.astro";
import LabsValueProps from "../components/labs/LabsValueProps.astro";
import LogoMarquee from "../components/labs/LogoMarquee.astro";
import ProductDoors from "../components/labs/ProductDoors.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { LABS_STACK_LAYER } from "../lib/labs-home";
import {
  PRO_CLOSE,
  PRO_COMPLIANCE,
  PRO_DOORS,
  PRO_FAQ,
  PRO_HERO_BAND,
  PRO_LOGO_GRID,
  PRO_OSS_PROPS,
  PRO_QUOTES,
  PRO_SEO,
} from "../lib/pro";
---

<BaseLayout
  title={PRO_SEO.title}
  description={PRO_SEO.description}
  ogTitle={PRO_SEO.ogTitle}
  ogDescription={PRO_SEO.ogDescription}
  ogImage={PRO_SEO.ogImage}
  surface="unified"
  app="labs"
>
  <main>
    <LabsHero content={PRO_HERO_BAND} />

    <LogoMarquee content={PRO_LOGO_GRID} />

    {/* What Pro adds on each product — the same cards as /pricing */}
    <section class="bg-(--color-sage-50)">
      <ProductDoors content={PRO_DOORS} />
    </section>

    <LabsStackLayer content={LABS_STACK_LAYER} />

    {/* Featured, HashiCorp, and carousel testimonials */}
    <CustomerStoryCards content={PRO_QUOTES} />

    {/* Compliance: "Your VPC, your data" — shared markup with /pricing */}
    <section class="pb-24 md:pb-32">
      <div class="mx-auto max-w-content px-gutter">
        <h2 class="font-display text-[32px] leading-[36px] text-(--color-cream-900) md:text-[44px] md:leading-[48px]">
          {PRO_COMPLIANCE.headline}
        </h2>
        <p class="mt-6 max-w-[720px] font-sans text-[17px] leading-[26px] text-(--color-cream-700)">
          {PRO_COMPLIANCE.body}
        </p>
        <picture>
          <source media="(max-width: 767px)" srcset={PRO_COMPLIANCE.image.mobile.url} />
          <img
            src={PRO_COMPLIANCE.image.desktop.url}
            alt={PRO_COMPLIANCE.image.desktop.alt}
            class="mt-10 w-full rounded-[24px]"
            loading="lazy"
          />
        </picture>
        <ComplianceCard
          badges={PRO_COMPLIANCE.badges}
          eyebrow={PRO_COMPLIANCE.bannerEyebrow}
          headline={PRO_COMPLIANCE.bannerHeadline}
          body={PRO_COMPLIANCE.bannerBody}
        />
      </div>
    </section>

    {/* "ZenML Pro is Open Source and More" */}
    <LabsValueProps content={PRO_OSS_PROPS} />

    <LabsFaq content={PRO_FAQ} />

    <LabsCloseCta content={PRO_CLOSE} />
  </main>
</BaseLayout>

<script>
  import { initScrollProgress } from "../scripts/labs-scroll-progress";
  import { initScrollReveal } from "../scripts/labs-scroll-reveal";

  initScrollReveal();
  initScrollProgress();
</script>
