---
/**
 * ZenML Pro page, in the ZenML Labs shell (`app="labs"`, `surface="unified"`
 * — no `product`, D3). Rebuilt for the product one-offs cutover (#317):
 * a landing-band hero, the logo trust bar, the unified-pitch grid, the
 * customer-story quote cards, onboarding value props, the cloud-features
 * tabs, the compliance section (shared markup with /pricing), the
 * OSS-vs-Pro value props, the FAQ, and the closing band.
 *
 * Route: /pro
 */
import CustomerStoryCards from "../components/labs/CustomerStoryCards.astro";
import LabsCloseCta from "../components/labs/LabsCloseCta.astro";
import LabsFaq from "../components/labs/LabsFaq.astro";
import LabsFeatureTabs from "../components/labs/LabsFeatureTabs.astro";
import LabsHero from "../components/labs/LabsHero.astro";
import LabsValueProps from "../components/labs/LabsValueProps.astro";
import LogoMarquee from "../components/labs/LogoMarquee.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  PRO_CLOSE,
  PRO_COMPLIANCE,
  PRO_FAQ,
  PRO_FEATURE_TABS,
  PRO_HERO_BAND,
  PRO_LOGO_GRID,
  PRO_ONBOARDING_PROPS,
  PRO_OSS_PROPS,
  PRO_QUOTES,
  PRO_SEO,
  PRO_UNIFIED_PITCH,
} from "../lib/pro";
---

<BaseLayout
  title={PRO_SEO.title}
  description={PRO_SEO.description}
  ogTitle={PRO_SEO.ogTitle}
  ogDescription={PRO_SEO.ogDescription}
  ogImage={PRO_SEO.ogImage}
  surface="unified"
  app="labs"
>
  <LabsHero content={PRO_HERO_BAND} />

  <LogoMarquee content={PRO_LOGO_GRID} />

  {/* Unified pitch — managed plane + enterprise (Phase 7, D10) */}
  <section class="py-24 md:py-32">
    <div class="mx-auto max-w-content px-gutter">
      <h2 class="font-display text-[32px] leading-[36px] text-(--color-cream-900) md:text-[44px] md:leading-[48px]">
        {PRO_UNIFIED_PITCH.eyebrow}
      </h2>
      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        {PRO_UNIFIED_PITCH.sections.map((sec) => (
          <div class="rounded-[20px] border border-border bg-card p-8 transition-colors duration-200 ease-out hover:border-(--color-sage-400) md:p-10">
            <h3 class="font-display text-[28px] leading-[34px] text-(--color-cream-900)">
              {sec.heading}
            </h3>
            <p class="mt-3 font-sans text-[17px] leading-[26px] text-(--color-cream-700)">
              {sec.lede}
            </p>
            <dl class="mt-6 flex flex-col">
              {sec.items.map((it) => (
                <div class="border-t border-(--color-border) py-4">
                  <dt class="font-sans text-[15px] leading-5 font-medium text-(--color-cream-900)">
                    {it.name}
                  </dt>
                  <dd class="mt-1 font-sans text-[14px] leading-5 text-(--color-cream-700)">
                    {it.body}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Featured, HashiCorp, and carousel testimonials */}
  <CustomerStoryCards content={PRO_QUOTES} />

  {/* "Get set up in less than a day" */}
  <LabsValueProps content={PRO_ONBOARDING_PROPS} />

  {/* Pro cloud features (alternating image/text, now a tab slider) */}
  <div id="cloud-features">
    <LabsFeatureTabs content={PRO_FEATURE_TABS} />
  </div>

  {/* Compliance: "Your VPC, your data" — shared markup with /pricing */}
  <section class="pb-24 md:pb-32">
    <div class="mx-auto max-w-content px-gutter">
      <h2 class="font-display text-[32px] leading-[36px] text-(--color-cream-900) md:text-[44px] md:leading-[48px]">
        {PRO_COMPLIANCE.headline}
      </h2>
      <p class="mt-6 max-w-[720px] font-sans text-[17px] leading-[26px] text-(--color-cream-700)">
        {PRO_COMPLIANCE.body}
      </p>
      <picture>
        <source media="(max-width: 767px)" srcset={PRO_COMPLIANCE.image.mobile.url} />
        <img
          src={PRO_COMPLIANCE.image.desktop.url}
          alt={PRO_COMPLIANCE.image.desktop.alt}
          class="mt-10 w-full rounded-[20px] border border-(--color-border)"
          loading="lazy"
        />
      </picture>
      <div class="mt-8 flex flex-col items-center gap-8 rounded-[20px] border border-(--color-border) bg-card p-8 md:flex-row">
        <div class="flex shrink-0 gap-6">
          {PRO_COMPLIANCE.badges.map((badge) => (
            <img src={badge.url} alt={badge.alt} class="h-24 w-auto object-contain" loading="lazy" />
          ))}
        </div>
        <div class="md:border-l md:border-(--color-border) md:pl-8">
          <p class="font-sans text-[13px] leading-4 font-medium text-(--color-cream-700)">
            {PRO_COMPLIANCE.bannerEyebrow}
          </p>
          <h3 class="mt-1 font-display text-[20px] leading-[26px] text-(--color-cream-900)">
            {PRO_COMPLIANCE.bannerHeadline}
          </h3>
          <p class="mt-2 font-sans text-[15px] leading-5 text-(--color-cream-700)">
            {PRO_COMPLIANCE.bannerBody}
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* "ZenML Pro is Open Source and More" */}
  <LabsValueProps content={PRO_OSS_PROPS} />

  <LabsFaq content={PRO_FAQ} />

  <LabsCloseCta content={PRO_CLOSE} />
</BaseLayout>
