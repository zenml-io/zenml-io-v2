---
import ConversionShell from "../components/templates/ConversionShell.astro";
/**
 * Book Success — thank-you with link to success-calendar.
 *
 * Route: /book-success (noindex)
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { BOOK_SUCCESS_DATA, BOOK_SUCCESS_SEO } from "../lib/bookSuccess";
---

<BaseLayout
  title={BOOK_SUCCESS_SEO.title}
  description={BOOK_SUCCESS_SEO.description}
  noindex={BOOK_SUCCESS_SEO.noindex}
  surface="unified"
  app="labs"
>
  <main>
    <ConversionShell
      frame="success"
      headline={BOOK_SUCCESS_DATA.headline}
      deck={BOOK_SUCCESS_DATA.body}
      primaryCta={BOOK_SUCCESS_DATA.primaryCta}
      secondaryCta={BOOK_SUCCESS_DATA.secondaryCta}
    />
  </main>
</BaseLayout>
