---
import ContactForm from "../components/islands/ContactForm.tsx";
import ConversionShell from "../components/templates/ConversionShell.astro";
/**
 * Book a Demo — demo request form.
 *
 * Route: /book-a-demo
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  BOOK_A_DEMO_FIELDS,
  BOOK_A_DEMO_HERO,
  BOOK_A_DEMO_SEO,
} from "../lib/bookADemo";
import { TURNSTILE_SITE_KEY } from "../lib/formConstants";
---

<BaseLayout
  title={BOOK_A_DEMO_SEO.title}
  description={BOOK_A_DEMO_SEO.description}
  ogTitle={BOOK_A_DEMO_SEO.ogTitle}
  ogDescription={BOOK_A_DEMO_SEO.ogDescription}
  surface="unified"
>
  <main>
    <ConversionShell
      headline={BOOK_A_DEMO_HERO.headline}
      deck={BOOK_A_DEMO_HERO.deck}
      frame="form"
    >
      <ContactForm
        client:load
        formType="demo-request"
        endpoint="/api/forms/demo-request"
        fields={BOOK_A_DEMO_FIELDS}
        submitLabel="Send Request"
        loadingLabel="Sending…"
        successMessage="Thank you! We'll be in touch shortly."
        successCta={{ label: "Book a time now", href: "/book-your-demo" }}
        turnstileSiteKey={TURNSTILE_SITE_KEY}
      />
    </ConversionShell>
  </main>
</BaseLayout>
