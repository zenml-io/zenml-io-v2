---
/**
 * MLOps tags index page.
 *
 * Lists all MLOps topic tags with entry counts, sorted by popularity.
 * Route: /mlops-tags
 */
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { TaxonomyCount } from "../../lib/mlops";
import {
  getAllPublishedMLOpsEntries,
  getMLOpsTagCounts,
} from "../../lib/mlops";

const entries = await getAllPublishedMLOpsEntries();
const usedCounts = await getMLOpsTagCounts(entries);
const usedMap = new Map(usedCounts.map((tag) => [tag.slug, tag.count]));

const allTags = await getCollection("mlops-tags");
const tags: TaxonomyCount[] = allTags
  .map((tag) => ({
    slug: tag.data.slug,
    name: tag.data.name,
    count: usedMap.get(tag.data.slug) ?? 0,
  }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
---

<BaseLayout
  title="MLOps Tags - ZenML"
  description="Browse all MLOps topic tags used in the ZenML MLOps Database."
  surface="ml"
>
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <header class="mb-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-success-700">Machine Learning Operations</p>
      <h1 class="text-4xl font-bold tracking-tight text-gray-900">MLOps Tags</h1>
      <p class="mt-3 text-lg text-gray-600">
        {tags.length} {tags.length === 1 ? "tag" : "tags"} in the database
      </p>
      <a href="/mlops-database" class="mt-2 inline-block text-sm text-primary-600 hover:text-primary-700">
        &larr; Back to MLOps Database
      </a>
    </header>

    <nav aria-label="All MLOps tags">
      <ul class="divide-y divide-gray-200 rounded-lg border border-gray-200 bg-white">
        {tags.map((tag) => (
          <li>
            <a
              href={`/mlops-tags/${tag.slug}`}
              class="flex items-center justify-between px-4 py-3 text-sm hover:bg-gray-50"
            >
              <span class="font-medium text-gray-900">{tag.name}</span>
              <span class="text-xs tabular-nums text-gray-400">{tag.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</BaseLayout>
