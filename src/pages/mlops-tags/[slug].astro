---
/**
 * MLOps tag taxonomy page.
 *
 * Shows all MLOps database entries with this topic tag.
 * Generates /mlops-tags/<slug> for each tag in the collection.
 */
import { getCollection } from "astro:content";
import Badge from "../../components/Badge.astro";
import SectionIntro from "../../components/system/SectionIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getMLOpsIndustryTagCounts } from "../../lib/mlops";

export async function getStaticPaths() {
  const mlopsTags = await getCollection("mlops-tags");
  const tagMap = Object.fromEntries(
    mlopsTags.map((tag) => [tag.data.slug, tag.data.name]),
  );
  return mlopsTags.map((tag) => ({
    params: { slug: tag.data.slug },
    props: { tag, tagMap },
  }));
}

const { tag, tagMap } = Astro.props;

const allEntries = (
  await getCollection(
    "mlops-database",
    ({ data }) => !data.draft && data.mlopsTags.includes(tag.data.slug),
  )
).sort((a, b) => a.data.title.localeCompare(b.data.title));

const commonIndustries = (await getMLOpsIndustryTagCounts(allEntries)).slice(
  0,
  8,
);
---

<BaseLayout
  title={`${tag.data.name} - MLOps Database`}
  description={`MLOps case studies and production ML systems tagged with "${tag.data.name}".`}
  surface="ml"
>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <header class="mb-12">
      <SectionIntro
        eyebrow="MLOps topic"
        heading={`MLOps Tag: ${tag.data.name}`}
        headingLevel={1}
        description={`${allEntries.length} ${allEntries.length === 1 ? "entry" : "entries"} with this tag`}
        classOverrides={{
          eyebrow: "text-sm font-semibold uppercase tracking-wider text-success-700",
          heading: "text-4xl font-bold tracking-tight text-gray-900",
          headingSpacing: "mt-3",
          description: "text-lg text-gray-600",
        }}
      />
      <a href="/mlops-database" class="mt-2 inline-block text-sm text-primary-600 hover:text-primary-700">
        &larr; Back to MLOps Database
      </a>
    </header>

    {commonIndustries.length > 0 && (
      <section class="mb-10">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-400">
            Common industries
          </h2>
          <a
            href="/industry-tags"
            class="text-xs font-medium text-primary-600 hover:text-primary-700"
          >
            View all industries &rarr;
          </a>
        </div>
        <div class="mt-3 flex flex-wrap gap-2">
          {commonIndustries.map((industry) => (
            <Badge variant="primary" href={`/industry-tags/${industry.slug}`}>
              {industry.name} ({industry.count})
            </Badge>
          ))}
        </div>
      </section>
    )}

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {allEntries.map((entry) => (
        <div
          class="group relative flex flex-col rounded-lg border border-gray-200 bg-white p-5 transition-shadow hover:shadow-md"
        >
          <h2 class="text-lg font-semibold text-gray-900 group-hover:text-primary-600">
            <a
              href={`/mlops-database/${entry.data.slug}`}
              class="before:absolute before:inset-0 before:content-['']"
            >
              {entry.data.title}
            </a>
          </h2>
          <div class="mt-1 flex flex-wrap items-center gap-2 text-sm text-gray-500">
            <span>{entry.data.company}</span>
            {entry.data.platformName !== entry.data.company && (
              <>
                <span aria-hidden="true">&middot;</span>
                <span>{entry.data.platformName}</span>
              </>
            )}
            <>
              <span aria-hidden="true">&middot;</span>
              <span class="capitalize">{entry.data.contentType}</span>
            </>
          </div>
          <p class="mt-2 line-clamp-3 text-sm text-gray-600">{entry.data.summary}</p>
          <div class="mt-auto flex flex-wrap gap-1.5 pt-4">
            {entry.data.mlopsTags.slice(0, 4).map((tagSlug: string) => (
              <Badge variant="success" href={`/mlops-tags/${tagSlug}`} class="relative">{tagMap[tagSlug] || tagSlug}</Badge>
            ))}
            {entry.data.mlopsTags.length > 4 && (
              <Badge variant="gray">+{entry.data.mlopsTags.length - 4}</Badge>
            )}
          </div>
        </div>
      ))}
    </div>

    {allEntries.length === 0 && (
      <p class="text-center text-gray-500">No MLOps entries with this tag yet.</p>
    )}
  </div>
</BaseLayout>
