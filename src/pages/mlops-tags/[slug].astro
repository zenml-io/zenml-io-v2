---
/**
 * MLOps tag taxonomy page.
 *
 * Shows all MLOps database entries with this topic tag.
 * Generates /mlops-tags/<slug> for each tag in the collection.
 */
import { getCollection } from "astro:content";
import SectionIntro from "../../components/system/SectionIntro.astro";
import TermHubEntryIndex from "../../components/templates/TermHubEntryIndex.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getMLOpsIndustryTagCounts } from "../../lib/mlops";

export async function getStaticPaths() {
  const mlopsTags = await getCollection("mlops-tags");
  const tagMap = Object.fromEntries(
    mlopsTags.map((tag) => [tag.data.slug, tag.data.name]),
  );
  const allEntries = await getCollection(
    "mlops-database",
    ({ data }) => !data.draft,
  );
  const usedSlugs = new Set(allEntries.flatMap((e) => e.data.mlopsTags));
  return mlopsTags
    .filter((tag) => usedSlugs.has(tag.data.slug))
    .map((tag) => ({
      params: { slug: tag.data.slug },
      props: { tag, tagMap },
    }));
}

const { tag, tagMap } = Astro.props;

const allEntries = (
  await getCollection(
    "mlops-database",
    ({ data }) => !data.draft && data.mlopsTags.includes(tag.data.slug),
  )
).sort((a, b) => a.data.title.localeCompare(b.data.title));

const commonIndustries = (await getMLOpsIndustryTagCounts(allEntries)).slice(
  0,
  8,
);
---

<BaseLayout
  title={`${tag.data.name} - MLOps Database`}
  description={`MLOps case studies and production ML systems tagged with "${tag.data.name}".`}
  surface="ml"
>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <header class="mb-12">
      <SectionIntro
        eyebrow="MLOps topic"
        heading={`MLOps Tag: ${tag.data.name}`}
        headingLevel={1}
        description={`${allEntries.length} ${allEntries.length === 1 ? "entry" : "entries"} with this tag`}
        classOverrides={{
          eyebrow: "text-sm font-semibold uppercase tracking-wider text-success-700",
          heading: "text-4xl font-bold tracking-tight text-gray-900",
          headingSpacing: "mt-3",
          description: "text-lg text-gray-600",
        }}
      />
      <a href="/mlops-database" class="mt-2 inline-block text-sm text-primary-600 hover:text-primary-700">
        &larr; Back to MLOps Database
      </a>
    </header>

    <TermHubEntryIndex
      crossLinks={[
        {
          heading: "Common industries",
          viewAllHref: "/industry-tags",
          viewAllLabel: "View all industries",
          badgeVariant: "primary",
          items: commonIndustries.map((industry) => ({
            name: industry.name,
            slug: industry.slug,
            count: industry.count,
            href: `/industry-tags/${industry.slug}`,
          })),
        },
      ]}
      sections={[
        {
          cards: allEntries.map((entry) => ({
            title: entry.data.title,
            href: `/mlops-database/${entry.data.slug}`,
            metaLine: [
              entry.data.company,
              ...(entry.data.platformName !== entry.data.company
                ? [entry.data.platformName]
                : []),
              entry.data.contentType,
            ],
            summary: entry.data.summary,
            tags: entry.data.mlopsTags.slice(0, 4).map((tagSlug: string) => ({
              label: tagMap[tagSlug] || tagSlug,
              href: `/mlops-tags/${tagSlug}`,
            })),
            extraTagCount: Math.max(0, entry.data.mlopsTags.length - 4),
            tagVariant: "success" as const,
          })),
        },
      ]}
      emptyHeading="No MLOps entries with this tag yet."
    />
  </div>
</BaseLayout>
