---
import Cta from "../../components/kitaru/Cta.astro";
import Faq from "../../components/kitaru/Faq.astro";
import Features from "../../components/kitaru/Features.astro";
import Hero from "../../components/kitaru/Hero.astro";
/**
 * /product/kitaru — the open-source part of the product, rendered in the
 * Labs shell (`app="labs" product="kitaru"`). The `[data-app="kitaru"]`
 * scope in src/styles/global.css points the section tokens at the rebrand
 * set.
 *
 * Story (matches the homepage): our AI engineer reads your traces next to
 * your evals and shows you what they miss. Kitaru is the open-source core
 * underneath: import or record traces, review sessions, turn findings into
 * checks, replay the agent to test a fix. The AI engineer is the hosted part.
 *
 * Sections (Oct 2026 cut, about a third of the earlier page):
 *   Hero        → the install command first, docs as the ghost pill
 *   Features    → how it works in four steps, plus the hosted note
 *   OpenSource  → labs.open-source-band: licence, local, keys, GitHub stars
 *   EvalImport  → labs.eval-import-band: bring the evals you already run
 *   Faq         → short answers, incl. the multi-turn replay limit
 *   Cta         → closing band, install command first
 *
 * Motion: the hero's KitaruGrain is the one ambient section; HeroVideo
 * hydrates on idle. Everything else is static with the house reveal.
 */
import LabsEvalImportBand from "../../components/labs/LabsEvalImportBand.astro";
import LabsOpenSourceBand from "../../components/labs/LabsOpenSourceBand.astro";
import JsonLd from "../../components/seo/JsonLd.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { FAQ_ITEMS } from "../../lib/kitaru-landing";
import { KITARU_EVAL_IMPORT, KITARU_OPEN_SOURCE } from "../../lib/openSource";
import { PRODUCT_KITARU_SEO } from "../../lib/productKitaru";
import { absoluteUrl } from "../../lib/seo";
import { htmlToPlainText } from "../../lib/text";

const pageUrl = absoluteUrl("/product/kitaru");
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${pageUrl}#faq`,
  mainEntity: FAQ_ITEMS.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: htmlToPlainText(item.answer) },
  })),
};
---

<BaseLayout {...PRODUCT_KITARU_SEO} surface="agent" app="labs" product="kitaru">
  <JsonLd data={faqJsonLd} slot="head" />
  <div data-app="kitaru" class="bg-background text-foreground">
    {/* overflow-x-clip is the DESIGN.md guard: the reveal-left/right slides
        translate cards 22px past the gutter before they show, which would
        otherwise widen the page on narrow viewports. `clip` is not a scroll
        container, so the FAQ's sticky column is unaffected. */}
    <main id="kitaru-main" class="overflow-x-clip">
      <Hero />
      <Features />
      <LabsOpenSourceBand content={KITARU_OPEN_SOURCE} tint="orange" />
      <LabsEvalImportBand content={KITARU_EVAL_IMPORT} />
      <Faq />
      <Cta />
    </main>
  </div>
</BaseLayout>

{/* Scroll-reveal observer for the static sections (Hero, Features, Faq, Cta) —
    sets data-shown="true" on .reveal/.reveal-left/.reveal-right elements.
    */}
<script>
  import "../../scripts/kitaru/reveal-static";
</script>
