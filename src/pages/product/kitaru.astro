---
import Cta from "../../components/kitaru/Cta.astro";
import Faq from "../../components/kitaru/Faq.astro";
import Features from "../../components/kitaru/Features.astro";
import FirstRun from "../../components/kitaru/FirstRun.astro";
import { Hero } from "../../components/kitaru/islands/Hero";
import { ScenarioStrip } from "../../components/kitaru/islands/ScenarioStrip";
import { TwoDoors } from "../../components/kitaru/islands/TwoDoors";
/**
 * /product/kitaru — landing page introducing Kitaru as a sub-product
 * under the unified ZenML umbrella.
 *
 * Ported from the 2026 Kitaru landing redesign (design/kitaru-redesign-src).
 * Hero, ScenarioStrip, and TwoDoors are Preact islands
 * (interactive: copy buttons, hover state, in-component scroll reveal).
 * Features, Faq and Cta are static — their scroll-reveal is driven by the
 * page-level `reveal-static` script below.
 *
 * Aimed at the bullseye ICP: teams whose agent turns unstructured inbound into
 * structured writes in a system of record (logistics, fintech, insurance,
 * legal, back-office). They are replay-hungry by construction — re-running
 * live would create phantom bookings — so the page never has to argue for
 * replay, only show it. Those agents are also single-execution pipelines,
 * which is why the multi-turn divergence caveat does not surface here.
 *
 * Sections (terminal-first order, Sep 2026):
 *   Hero          → the install command, then the prompt for your coding agent
 *   FirstRun      → the first five minutes as a terminal transcript + outcomes
 *   TwoDoors      → two paths in: wrap an agent or import existing traces
 *   ScenarioStrip → four questions asked of one cohort of real sessions
 *   Features      → the model-migration wedge, in experiment/run terms
 *   Faq           → the questions that come up in every demo
 *   Cta           → closing CTA band
 *
 * The onboarding journey (login, skills, worker, triage) is deliberately
 * docs-only — it lives in PRODUCT_KITARU_MARKDOWN.journey → /product/kitaru.md.
 *
 * See MERGE_PLAN.md §4 (Phase 2b).
 */
import JsonLd from "../../components/seo/JsonLd.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { FAQ_ITEMS } from "../../lib/kitaru-landing";
import { PRODUCT_KITARU_SEO } from "../../lib/productKitaru";
import { absoluteUrl } from "../../lib/seo";
import { htmlToPlainText } from "../../lib/text";
import "../../styles/kitaru-compat.css";

const pageUrl = absoluteUrl("/product/kitaru");
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${pageUrl}#faq`,
  mainEntity: FAQ_ITEMS.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: htmlToPlainText(item.answer) },
  })),
};
---

<BaseLayout {...PRODUCT_KITARU_SEO} surface="agent">
  <JsonLd data={faqJsonLd} slot="head" />
  <div data-app="kitaru" class="bg-background text-foreground">
    <main id="kitaru-main">
      <Hero client:visible />
      <FirstRun />
      <TwoDoors client:visible />
      <ScenarioStrip client:visible />
      <Features />
      <Faq />
      <Cta />
    </main>
  </div>
</BaseLayout>

{/* Scroll-reveal observer for the static sections (Features, Faq, Cta) —
    sets data-shown="true" on .reveal/.reveal-left/.reveal-right elements.
    The hydrated islands drive their own reveal via the useReveal hook, so
    this only needs to cover the static markup. */}
<script>
  import "../../scripts/kitaru/reveal-static";
</script>
