---
import AgentDriven from "../../components/kitaru/AgentDriven.astro";
import CodeShowcase from "../../components/kitaru/CodeShowcase.astro";
import Cta from "../../components/kitaru/Cta.astro";
import Features from "../../components/kitaru/Features.astro";
import GroundTruth from "../../components/kitaru/GroundTruth.astro";
import Hero from "../../components/kitaru/Hero.astro";
import OneImport from "../../components/kitaru/OneImport.astro";
import ScenarioStrip from "../../components/kitaru/ScenarioStrip.astro";
import SocialProof from "../../components/kitaru/SocialProof.astro";
/**
 * /product/kitaru — landing page introducing Kitaru as a sub-product
 * under the unified ZenML umbrella.
 *
 * Deep port from `kitaru/site/src/pages/index.astro`. All 9 sections
 * ported verbatim with original scoped CSS preserved. Kitaru-era CSS
 * tokens (--color-bg, --color-accent, --font-ui) are bridged onto our
 * unified tokens by `src/styles/kitaru-compat.css`, scoped to the
 * `[data-app="kitaru"]` wrapper that flips the theme.
 *
 * Aimed at the bullseye ICP: teams whose agent turns unstructured inbound into
 * structured writes in a system of record (logistics, fintech, insurance,
 * legal, back-office). They are replay-hungry by construction — re-running
 * live would create phantom bookings — so the page never has to argue for
 * replay, only show it. Those agents are also single-execution pipelines,
 * which is why the multi-turn divergence caveat does not surface here.
 *
 * Sections:
 *   Hero          → the problem sentence, then history-as-test-suite
 *   ScenarioStrip → four questions asked of one cohort of real sessions
 *   GroundTruth   → the labels already exist, in the system of record
 *   OneImport     → works with your agent SDK (before/after)
 *   Features      → the model-migration wedge, in experiment/run terms
 *   CodeShowcase  → cohort → experiment → two runs, with tool policies
 *   AgentDriven   → the agent drives; the human keeps the judgement
 *
 * The onboarding journey (login, skills, worker, triage) is deliberately
 * docs-only — it lives in PRODUCT_KITARU_MARKDOWN.journey → /product/kitaru.md.
 *   SocialProof   → ZenML lineage, testimonials + logos
 *   Cta           → closing CTA band
 *
 * See MERGE_PLAN.md §4 (Phase 2b).
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PRODUCT_KITARU_SEO } from "../../lib/productKitaru";
import "../../styles/kitaru-compat.css";
---

<BaseLayout {...PRODUCT_KITARU_SEO} surface="agent">
  <div data-app="kitaru" class="bg-background text-foreground">
    <main id="kitaru-main">
      <Hero />
      <ScenarioStrip />
      <GroundTruth />
      <OneImport />
      <Features />
      <CodeShowcase />
      <AgentDriven />
      <div class="gradient-divider"></div>
      <SocialProof />
      <div class="gradient-divider"></div>
      <Cta />
    </main>
  </div>
</BaseLayout>

{/* Scroll-reveal observer — drives the [data-reveal] fade-in animations on
    every Kitaru section. Loaded once for the whole page. */}
<script>
  import "../../scripts/kitaru/scroll-reveal";
</script>
