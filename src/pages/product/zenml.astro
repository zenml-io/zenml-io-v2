---
/**
 * /product/zenml — ZenML sub-product landing, Labs shell.
 *
 * Composes the Labs section components in order: hero → logo strip →
 * feature tabs → value props → integrations → customer stories → close.
 * Copy comes from src/lib/labs-product-zenml.ts (the ZENML_* constants);
 * this page only wires content into components, nothing is retyped here.
 *
 * Route: /product/zenml
 */
import CustomerStoryCards from "../../components/labs/CustomerStoryCards.astro";
import LabsCloseCta from "../../components/labs/LabsCloseCta.astro";
import LabsFeatureTabs from "../../components/labs/LabsFeatureTabs.astro";
import LabsHero from "../../components/labs/LabsHero.astro";
import LabsIntegrationsGrid from "../../components/labs/LabsIntegrationsGrid.astro";
import LabsValueProps from "../../components/labs/LabsValueProps.astro";
import LogoMarquee from "../../components/labs/LogoMarquee.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { defaultOgUrl, hasDefaultOgCard } from "../../lib/seo";
import {
  LABS_PRODUCT_ZENML_SEO,
  ZENML_CLOSE,
  ZENML_FEATURE_TABS,
  ZENML_HERO,
  ZENML_INTEGRATIONS,
  ZENML_LOGO_GRID,
  ZENML_STORIES,
  ZENML_VALUE_PROPS,
} from "../../lib/labs-product-zenml";
---

<BaseLayout
  ogImage={hasDefaultOgCard("pages", "product-zenml") ? defaultOgUrl("pages", "product-zenml") : undefined}
  app="labs"
  product="zenml"
  surface={LABS_PRODUCT_ZENML_SEO.surface}
  title={LABS_PRODUCT_ZENML_SEO.title}
  description={LABS_PRODUCT_ZENML_SEO.description}
>
  <main>
    <LabsHero content={ZENML_HERO} />
    <LogoMarquee content={ZENML_LOGO_GRID} />
    <LabsFeatureTabs content={ZENML_FEATURE_TABS} />
    <LabsValueProps content={ZENML_VALUE_PROPS} />
    <LabsIntegrationsGrid content={ZENML_INTEGRATIONS} />
    <CustomerStoryCards content={ZENML_STORIES} />
    <LabsCloseCta content={ZENML_CLOSE} />
  </main>
</BaseLayout>
