---
import Button from "../../components/Button.astro";
import CustomerStories from "../../components/sections/CustomerStories.astro";
import FeatureTabs from "../../components/sections/FeatureTabs.astro";
import IntegrationsMarquee from "../../components/sections/IntegrationsMarquee.astro";
import LogoCloud from "../../components/sections/LogoCloud.astro";
import ValueProps from "../../components/sections/ValueProps.astro";
/**
 * /product/zenml — ZenML sub-product landing.
 *
 * Mirrors /product/kitaru in shape: hero → benefits → features (sticky tabs)
 * → integrations → social proof → final CTA. Reuses homepage section
 * components for everything below the hero — those already speak to the
 * ZenML workspace, so the page reads tight without new section code.
 *
 * Phase 9 baseline: copy + structure only. Visual polish (custom hero
 * canvas, mesh gradient, etc.) deferred to Zuri's design pass.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  PRODUCT_ZENML_BENEFITS,
  PRODUCT_ZENML_FINAL_CTA,
  PRODUCT_ZENML_HERO,
  PRODUCT_ZENML_SEO,
} from "../../lib/productZenml";
---

<BaseLayout
  title={PRODUCT_ZENML_SEO.title}
  description={PRODUCT_ZENML_SEO.description}
  surface="ml"
>
  <main>
    {/* Hero */}
    <section class="relative overflow-hidden bg-linear-to-b from-zenml-50 to-white pt-16 pb-20 sm:pt-24 sm:pb-28">
      <div class="mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-center justify-center gap-2">
          {PRODUCT_ZENML_HERO.badges.map((badge, i) => (
            <span
              class:list={[
                "inline-flex items-center gap-2 rounded-full border border-zenml-200 bg-white/60 px-3 py-1 text-xs font-medium text-zenml-700",
                i === 0 && "ring-1 ring-zenml-300",
              ]}
            >
              {i === 0 && (
                <span class="inline-block h-2 w-2 rounded-full bg-zenml-500 animate-pulse" aria-hidden="true"></span>
              )}
              {badge}
            </span>
          ))}
        </div>

        <h1 class="mt-6 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl">
          {PRODUCT_ZENML_HERO.headline}<span class="text-zenml-600">{PRODUCT_ZENML_HERO.headlineAccent}</span>.
        </h1>

        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-gray-600 sm:text-xl">
          <span class="font-semibold text-gray-900">{PRODUCT_ZENML_HERO.subtitleLead}</span>
          {' '}
          {PRODUCT_ZENML_HERO.subtitle}
        </p>

        <div class="mt-8 flex justify-center">
          <div class="inline-flex items-center gap-2 rounded-md border border-gray-200 bg-gray-50 px-4 py-2.5 font-mono text-sm">
            <span class="text-gray-400" aria-hidden="true">$</span>
            <code class="text-gray-900">{PRODUCT_ZENML_HERO.installCmd}</code>
            <button
              class="ml-2 inline-flex items-center text-gray-400 hover:text-gray-700 transition-colors"
              aria-label="Copy install command"
              data-copy={PRODUCT_ZENML_HERO.installCmd}
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2" />
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
              </svg>
            </button>
          </div>
        </div>

        <div class="mt-6 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
          <Button href={PRODUCT_ZENML_HERO.primaryCta.href} variant="primary" size="lg">
            {PRODUCT_ZENML_HERO.primaryCta.label}
          </Button>
          <Button
            href={PRODUCT_ZENML_HERO.secondaryCta.href}
            variant="secondary"
            size="lg"
          >
            {PRODUCT_ZENML_HERO.secondaryCta.label}
          </Button>
        </div>
      </div>
    </section>

    {/* Trust bar */}
    <LogoCloud bgClass="bg-white" fadeFromClass="from-white" />

    {/* 3 benefits block */}
    <section class="bg-white py-16 sm:py-20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <p class="text-center text-sm font-semibold uppercase tracking-wider text-zenml-500">
          {PRODUCT_ZENML_BENEFITS.eyebrow}
        </p>
        <div class="mt-10 grid gap-6 md:grid-cols-3 md:gap-8">
          {PRODUCT_ZENML_BENEFITS.items.map((item) => (
            <article class="rounded-xl border border-gray-200 bg-white p-6 sm:p-8">
              <h2 class="text-lg font-bold tracking-tight text-gray-900">{item.name}</h2>
              <p class="mt-3 text-sm leading-relaxed text-gray-600">{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* Feature tabs — reused from homepage */}
    <FeatureTabs />

    {/* Value props — reused from homepage */}
    <ValueProps />

    {/* Integration logos — the ZenML "deploy anywhere" story */}
    <IntegrationsMarquee />

    {/* Customer stories — social proof */}
    <CustomerStories />

    {/* Final CTA */}
    <section class="bg-linear-to-t from-zenml-50 to-white py-16 sm:py-20">
      <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
          {PRODUCT_ZENML_FINAL_CTA.headline}
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-gray-600">
          {PRODUCT_ZENML_FINAL_CTA.body}
        </p>

        <div class="mt-8 flex justify-center">
          <div class="inline-flex items-center gap-2 rounded-md border border-gray-200 bg-white px-4 py-2.5 font-mono text-sm">
            <span class="text-gray-400" aria-hidden="true">$</span>
            <code class="text-gray-900">{PRODUCT_ZENML_FINAL_CTA.installCmd}</code>
          </div>
        </div>

        <div class="mt-6 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
          <Button href={PRODUCT_ZENML_FINAL_CTA.primaryCta.href} variant="primary" size="lg">
            {PRODUCT_ZENML_FINAL_CTA.primaryCta.label}
          </Button>
          <Button href={PRODUCT_ZENML_FINAL_CTA.secondaryCta.href} variant="secondary" size="lg">
            {PRODUCT_ZENML_FINAL_CTA.secondaryCta.label}
          </Button>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  // Tiny clipboard helper for the hero install command.
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const text = btn.dataset.copy;
      if (!text) return;
      navigator.clipboard?.writeText(text);
    });
  });
</script>
