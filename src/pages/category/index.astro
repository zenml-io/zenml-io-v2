---
/**
 * Blog categories index page (blog cutover, D2d/§6).
 *
 * Lists all blog categories with post counts, sorted by popularity, as
 * `data-display.stacked-list` rows (`skin="labs"`, name + count) under the
 * shared `page-header.with-breadcrumb` term-hub header. Route: /category
 */
import { getCollection } from "astro:content";
import PageHeader from "../../components/templates/PageHeader.astro";
import { TERM_HUB_HEADER_INTRO } from "../../components/templates/pageHeaderPresets";
import StackedList from "../../components/templates/StackedList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { TaxonomyCount } from "../../lib/blog";
import { getAllPublishedPosts, getCategoryCounts } from "../../lib/blog";
import { filterUsedTerms } from "../../lib/relatedIndex";

const allPosts = await getAllPublishedPosts();
const usedCounts = await getCategoryCounts(allPosts);
const usedMap = new Map(usedCounts.map((c) => [c.slug, c.count]));

// Merge all taxonomy terms with used counts, then drop zero-count categories
// (#249) — a zero-count category has no [slug] page to link to any more.
const allCategories = await getCollection("categories");
const merged: TaxonomyCount[] = allCategories.map((c) => ({
  slug: c.data.slug,
  name: c.data.name,
  count: usedMap.get(c.data.slug) ?? 0,
}));
const categories = filterUsedTerms(merged).sort(
  (a, b) => b.count - a.count || a.name.localeCompare(b.name),
);
---

<BaseLayout
  title="Blog Categories - ZenML"
  description="Browse all categories used on the ZenML blog."
  surface="ml"
  app="labs"
>
  {/* pt-[148px] clears the floating Labs nav (bottom edge 92px mobile /
      108px desktop) with margin to spare — matches LabsBand's "short"
      clearance so every blog-surface breadcrumb starts at the same offset. */}
  <section class="scroll-reveal-section px-gutter pt-[148px] pb-24">
    <div class="mx-auto max-w-content">
      <PageHeader
        breadcrumb={[{ label: "Blog", href: "/blog" }, { label: "Categories" }]}
        breadcrumbSeparator="chevron"
        heading="Categories"
        description={`${categories.length} ${categories.length === 1 ? "category" : "categories"} on the blog`}
        classOverrides={TERM_HUB_HEADER_INTRO}
      />

      <div class="mt-10 border-t border-(--color-border)">
        <StackedList
          skin="labs"
          items={categories.map((c) => ({
            title: c.name,
            href: `/category/${c.slug}`,
            trailingCount: c.count,
          }))}
        />
      </div>
    </div>
  </section>
</BaseLayout>
