---
/**
 * Blog categories index page.
 *
 * Lists all blog categories with post counts, sorted by popularity.
 * Route: /category
 */
import { getCollection } from "astro:content";
import PageHeader from "../../components/templates/PageHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { TaxonomyCount } from "../../lib/blog";
import {
  filterUsedTerms,
  getAllPublishedPosts,
  getCategoryCounts,
} from "../../lib/blog";

const allPosts = await getAllPublishedPosts();
const usedCounts = await getCategoryCounts(allPosts);
const usedMap = new Map(usedCounts.map((c) => [c.slug, c.count]));

// Merge all taxonomy terms with used counts, then drop zero-count categories
// (#249) — a zero-count category has no [slug] page to link to any more.
const allCategories = await getCollection("categories");
const merged: TaxonomyCount[] = allCategories.map((c) => ({
  slug: c.data.slug,
  name: c.data.name,
  count: usedMap.get(c.data.slug) ?? 0,
}));
const categories = filterUsedTerms(merged).sort(
  (a, b) => b.count - a.count || a.name.localeCompare(b.name),
);
---

<BaseLayout
  title="Blog Categories - ZenML"
  description="Browse all categories used on the ZenML blog."
  surface="ml"
>
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <PageHeader
      class="mb-10"
      heading="Blog Categories"
      description={`${categories.length} ${categories.length === 1 ? "category" : "categories"} on the blog`}
      backLinks={[{ href: "/blog", label: "Back to the blog" }]}
      classOverrides={{
        heading: "text-4xl font-bold tracking-tight text-gray-900",
        description: "text-lg text-gray-600",
        descriptionSpacing: "mt-3",
      }}
    />

    <nav aria-label="All blog categories">
      <ul class="divide-y divide-gray-200 rounded-lg border border-gray-200 bg-white">
        {categories.map((c) => (
          <li>
            <a
              href={`/category/${c.slug}`}
              class="flex items-center justify-between px-4 py-3 text-sm hover:bg-gray-50"
            >
              <span class="font-medium text-gray-900">{c.name}</span>
              <span class="text-xs tabular-nums text-gray-400">{c.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</BaseLayout>
