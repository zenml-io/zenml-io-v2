---
/**
 * Category taxonomy page (blog cutover, D2d/§6): the `term-hub.editorial`
 * card grid (`labs.blog-card`), with the "Other categories" sibling strip
 * and 12/page client pagination.
 */
import { getCollection } from "astro:content";
import { HubPagination } from "../../components/islands/HubPagination";
import BlogNewsletterCta from "../../components/labs/BlogNewsletterCta.astro";
import LabsBand from "../../components/labs/LabsBand.astro";
import Breadcrumb from "../../components/system/Breadcrumb.astro";
import TermHubEditorial from "../../components/templates/TermHubEditorial.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getBlogProduct,
  getCategoryCounts,
  getMainFeedPosts,
  PAGE_SIZE,
  resolveAuthor,
} from "../../lib/blog";
import { BAND_CONTENT_GAP } from "../../lib/blogLayout";
import { filterUsedTerms } from "../../lib/relatedIndex";

export async function getStaticPaths() {
  const categories = await getCollection("categories");
  const allPosts = await getCollection("blog", ({ data }) => !data.draft);
  const usedSlugs = new Set(allPosts.map((p) => p.data.category));
  return categories
    .filter((cat) => usedSlugs.has(cat.data.slug))
    .map((cat) => ({
      params: { slug: cat.data.slug },
      props: { category: cat },
    }));
}

const { category } = Astro.props;

const allPosts = (
  await getCollection(
    "blog",
    ({ data }) => !data.draft && data.category === category.data.slug,
  )
).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const authorMap = new Map<string, Awaited<ReturnType<typeof resolveAuthor>>>();
for (const post of allPosts) {
  if (post.data.author && !authorMap.has(post.data.author)) {
    const a = await resolveAuthor(post.data.author);
    if (a) authorMap.set(post.data.author, a);
  }
}

// Sibling categories strip: every other used category, alphabetical.
const mainFeedPosts = await getMainFeedPosts();
const usedCounts = await getCategoryCounts(mainFeedPosts);
const usedMap = new Map(usedCounts.map((c) => [c.slug, c.count]));
const allCategories = await getCollection("categories");
const siblingCategories = filterUsedTerms(
  allCategories.map((c) => ({
    slug: c.data.slug,
    name: c.data.name,
    count: usedMap.get(c.data.slug) ?? 0,
  })),
)
  .filter((c) => c.slug !== category.data.slug)
  .sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout
  title={`${category.data.name} - ZenML Blog`}
  description={`Blog posts about ${category.data.name} from the ZenML team.`}
  surface="ml"
  app="labs"
>
  <LabsBand size="short" grain={category.data.slug === "kitaru" ? "kitaru" : "labs"}>
    <div class="flex flex-col gap-4">
      <Breadcrumb
        items={[
          { label: "Blog", href: "/blog" },
          { label: "Categories", href: "/category" },
          { label: category.data.name },
        ]}
        separator="chevron"
      />
      <div>
        <p class="font-sans text-[15px] leading-5 text-(--color-cream-700)">
          Category
        </p>
        <h1 class="font-display text-[40px] leading-[44px] text-(--color-cream-900) md:text-[64px] md:leading-[70px]">
          {category.data.name}
        </h1>
        <p class="mt-space-sm max-w-[690px] font-sans text-[17px] leading-[26px] text-foreground md:text-xl md:leading-[30px]">
          {allPosts.length} {allPosts.length === 1 ? "post" : "posts"} in this category
        </p>
      </div>
    </div>
  </LabsBand>

  <section class:list={["scroll-reveal-section pb-24", BAND_CONTENT_GAP]}>
    <div class="mx-auto max-w-content px-gutter">
      <TermHubEditorial
        emptyHeading={`No posts in the "${category.data.name}" category yet.`}
        siblingsHeading={siblingCategories.length > 0 ? "Other categories" : undefined}
        siblings={siblingCategories.map((c) => ({
          name: c.name,
          href: `/category/${c.slug}`,
        }))}
        viewAll={{ href: "/category", label: "View all" }}
        posts={allPosts.map((post) => {
          const author = authorMap.get(post.data.author || "");
          return {
            href: `/blog/${post.data.slug}`,
            title: post.data.title,
            excerpt: post.data.seo?.description,
            image: post.data.mainImage,
            authorName: author?.name,
            authorSlug: author?.slug,
            authorAvatar: author?.avatar,
            readingTime: post.data.readingTime,
            publishedDate: post.data.date,
            categoryName: category.data.name,
            categorySlug: category.data.slug,
            product: getBlogProduct(post),
          };
        })}
      />

      {allPosts.length > PAGE_SIZE && (
        <HubPagination
          client:idle
          containerId="term-hub-grid"
          totalItems={allPosts.length}
          pageSize={PAGE_SIZE}
        />
      )}
    </div>
  </section>

  <BlogNewsletterCta />
</BaseLayout>
