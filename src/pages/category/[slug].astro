---
/**
 * Category taxonomy page.
 *
 * Shows all blog posts in this category with the CategoryBar at top
 * and TagCloud at bottom.
 */
import { getCollection, getEntry } from "astro:content";
import CategoryBar from "../../components/blog/CategoryBar.astro";
import TagCloud from "../../components/blog/TagCloud.astro";
import PageHeader from "../../components/templates/PageHeader.astro";
import {
  TAXONOMY_BAND,
  TAXONOMY_DETAIL_INTRO,
} from "../../components/templates/pageHeaderPresets";
import TermHubEditorial from "../../components/templates/TermHubEditorial.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getCategoryCounts,
  getMainFeedPosts,
  getTagCounts,
  resolveAuthor,
} from "../../lib/blog";

export async function getStaticPaths() {
  const categories = await getCollection("categories");
  const allPosts = await getCollection("blog", ({ data }) => !data.draft);
  const usedSlugs = new Set(allPosts.map((p) => p.data.category));
  return categories
    .filter((cat) => usedSlugs.has(cat.data.slug))
    .map((cat) => ({
      params: { slug: cat.data.slug },
      props: { category: cat },
    }));
}

const { category } = Astro.props;

const allPosts = (
  await getCollection(
    "blog",
    ({ data }) => !data.draft && data.category === category.data.slug,
  )
).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

// CategoryBar needs all main feed posts for counts
const mainFeedPosts = await getMainFeedPosts();
const categories = await getCategoryCounts(mainFeedPosts);
const popularTags = await getTagCounts(mainFeedPosts);

// Resolve authors
const authorMap = new Map<string, Awaited<ReturnType<typeof resolveAuthor>>>();
const categoryMap = new Map<string, { name: string; slug: string }>();
for (const post of allPosts) {
  if (post.data.author && !authorMap.has(post.data.author)) {
    const a = await resolveAuthor(post.data.author);
    if (a) authorMap.set(post.data.author, a);
  }
  if (post.data.category && !categoryMap.has(post.data.category)) {
    const cat = await getEntry("categories", post.data.category);
    if (cat)
      categoryMap.set(post.data.category, {
        name: cat.data.name,
        slug: cat.data.slug,
      });
  }
}
---

<BaseLayout
  title={`${category.data.name} - ZenML Blog`}
  description={`Blog posts about ${category.data.name} from the ZenML team.`}
  surface="ml"
>
  {/* Section header: sticky CategoryBar with back link */}
  <CategoryBar categories={categories} activeCategory={category.data.slug} backLink />

  {/* Category header — gradient section */}
  <PageHeader
    tone="brand"
    {...TAXONOMY_BAND}
    heading={category.data.name}
    description={`${allPosts.length} ${allPosts.length === 1 ? "post" : "posts"} in this category`}
    classOverrides={TAXONOMY_DETAIL_INTRO}
  />

  <div class="mx-auto max-w-[1440px] px-4 py-10 sm:px-6 lg:px-8">
    <TermHubEditorial
      posts={allPosts.map((post) => {
        const author = authorMap.get(post.data.author || "");
        const cat = categoryMap.get(post.data.category || "");
        return {
          href: `/blog/${post.data.slug}`,
          title: post.data.title,
          excerpt: post.data.seo?.description,
          image: post.data.mainImage,
          authorName: author?.name,
          authorSlug: author?.slug,
          authorAvatar: author?.avatar,
          readingTime: post.data.readingTime,
          publishedDate: post.data.date,
          categoryName: cat?.name,
          categorySlug: cat?.slug,
        };
      })}
      emptyHeading="No posts in this category yet."
    />
  </div>

  {/* Footer tag cloud */}
  <TagCloud tags={popularTags} />
</BaseLayout>
