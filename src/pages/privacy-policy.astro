---
/**
 * Privacy Policy — legal text page.
 *
 * Thin adapter over the `legal` content collection: fetches the entry and
 * renders its body through ContentLayout, the Labs prose layout.
 *
 * Route: /privacy-policy (linked from footer via FOOTER_LEGAL)
 */
import { getEntry, render } from "astro:content";
import ContentLayout from "../layouts/ContentLayout.astro";

const entry = await getEntry("legal", "privacy-policy");
if (!entry) throw new Error("Missing legal entry: privacy-policy");
const { Content } = await render(entry);
---

<ContentLayout
  title={entry.data.seo?.title ?? entry.data.title}
  description={entry.data.seo?.description}
  surface="ml"
  heading={entry.data.title}
  deck={entry.data.lastUpdated ? `Last updated ${entry.data.lastUpdated}` : undefined}
>
  <Content />
</ContentLayout>
