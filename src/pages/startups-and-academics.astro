---
/**
 * Startups and Academics — application form for ZenML Pro program, in the
 * ZenML Labs shell (`app="labs"`, `surface="unified"`). Rebuilt for the
 * product one-offs cutover (#317): the short shader band (eyebrow / h1 /
 * deck), the untouched `ContactForm` island, and the shared closing band.
 *
 * Route: /startups-and-academics
 */
import ContactForm from "../components/islands/ContactForm.tsx";
import LabsBand from "../components/labs/LabsBand.astro";
import LabsCloseCta from "../components/labs/LabsCloseCta.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { BAND_CONTENT_GAP } from "../lib/blogLayout";
import { TURNSTILE_SITE_KEY } from "../lib/formConstants";
import { LABS_CLOSE } from "../lib/labs-home";
import {
  STARTUPS_FIELDS,
  STARTUPS_HERO,
  STARTUPS_SEO,
} from "../lib/startupsAndAcademics";
---

<BaseLayout
  title={STARTUPS_SEO.title}
  description={STARTUPS_SEO.description}
  ogTitle={STARTUPS_SEO.ogTitle}
  ogDescription={STARTUPS_SEO.ogDescription}
  surface="unified"
  app="labs"
>
  <LabsBand size="short">
    <div class="flex flex-col gap-4">
      <p class="font-sans text-[15px] leading-5 text-(--color-cream-700)">
        {STARTUPS_HERO.eyebrow}
      </p>
      <h1 class="font-display text-[40px] leading-[44px] text-(--color-cream-900) md:text-[64px] md:leading-[70px]">
        {STARTUPS_HERO.headline}
      </h1>
      <p class="max-w-[720px] font-sans text-[18px] leading-7 text-(--color-cream-700)">
        {STARTUPS_HERO.deck}
      </p>
    </div>
  </LabsBand>

  <section class:list={["pb-24 md:pb-32", BAND_CONTENT_GAP]}>
    <div class="mx-auto max-w-content px-gutter">
      <div class="mx-auto max-w-[640px]">
        <ContactForm
          client:load
          formType="startup-academic"
          endpoint="/api/forms/startup-academic"
          fields={STARTUPS_FIELDS}
          submitLabel="Apply"
          loadingLabel="Submitting…"
          successMessage="Thank you for your application! We'll review it and get back to you soon."
          turnstileSiteKey={TURNSTILE_SITE_KEY}
        />
      </div>
    </div>
  </section>

  <LabsCloseCta content={{ ...LABS_CLOSE, cta: { ...LABS_CLOSE.cta, analytics: "Startups-Close-Signup" } }} />
</BaseLayout>
