---
/**
 * Terms of Service — legal text page.
 *
 * Thin adapter over the `legal` content collection: fetches the entry,
 * wraps its rendered body in LegalArticle + ContentLayout.
 *
 * Route: /terms-of-service (linked from footer via FOOTER_LEGAL)
 */
import { getEntry, render } from "astro:content";
import LegalArticle from "../components/templates/LegalArticle.astro";
import ContentLayout from "../layouts/ContentLayout.astro";

const entry = await getEntry("legal", "terms-of-service");
if (!entry) throw new Error("Missing legal entry: terms-of-service");
const { Content } = await render(entry);
---

<ContentLayout
  title={entry.data.seo?.title ?? entry.data.title}
  description={entry.data.seo?.description}
  surface="ml"
>
  <LegalArticle title={entry.data.title} lastUpdated={entry.data.lastUpdated}>
    <Content />
  </LegalArticle>
</ContentLayout>
