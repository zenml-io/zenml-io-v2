---
/**
 * Integration types index page, on the ZenML Labs shell (integrations
 * cutover #318): a breadcrumb + short band, every integration type as a
 * hexagon chip carrying its integration count (`labs.term-chip-index`),
 * sorted by popularity — the same shape as `/llmops-tags`.
 *
 * Route: /integration-type
 */
import { getCollection } from "astro:content";
import LabsBand from "../../components/labs/LabsBand.astro";
import LabsCloseCta from "../../components/labs/LabsCloseCta.astro";
import TermChipIndex from "../../components/labs/TermChipIndex.astro";
import Breadcrumb from "../../components/system/Breadcrumb.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BAND_CONTENT_GAP } from "../../lib/blogLayout";
import {
  INTEGRATION_TYPES_HERO,
  integrationsClose,
  integrationTypesDeck,
} from "../../lib/integrations";
import { filterUsedTerms } from "../../lib/relatedIndex";

const allIntegrations = await getCollection(
  "integrations",
  ({ data }) => !data.draft,
);
const countMap = new Map<string, number>();
for (const integration of allIntegrations) {
  const t = integration.data.integrationType;
  countMap.set(t, (countMap.get(t) ?? 0) + 1);
}

// Merge all taxonomy terms with used counts, then drop zero-count types
// (#249) — a zero-count type has no [slug] page to link to any more.
const allTypes = await getCollection("integration-types");
const merged = allTypes.map((t) => ({
  slug: t.data.slug,
  name: t.data.name,
  count: countMap.get(t.data.slug) ?? 0,
}));
const types = filterUsedTerms(merged).sort(
  (a, b) => b.count - a.count || a.name.localeCompare(b.name),
);
---

<BaseLayout
  title="Integration Types - ZenML"
  description="Browse all integration categories in the ZenML MLOps landscape."
  surface="ml"
  app="labs"
  product="zenml"
>
  <LabsBand size="short">
    <div class="scroll-reveal-section">
      <div class="flex flex-col gap-4">
        <Breadcrumb
          class="reveal-child"
          items={[
            { label: "Integrations", href: "/integrations" },
            { label: "Types" },
          ]}
          separator="chevron"
        />
        <div class="reveal-child stagger-1">
          <p class="font-label text-[13px] leading-4 tracking-[0.05em] uppercase text-(--color-cream-700)">
            {INTEGRATION_TYPES_HERO.eyebrow}
          </p>
          <h1 class="font-display text-[40px] leading-[44px] text-(--color-cream-900) md:text-[64px] md:leading-[70px]">
            {INTEGRATION_TYPES_HERO.headline}
          </h1>
          <p class="mt-space-sm max-w-[690px] font-sans text-[17px] leading-[26px] text-foreground md:text-xl md:leading-[30px]">
            {integrationTypesDeck(types.length)}
          </p>
        </div>
      </div>
    </div>
  </LabsBand>

  <section class:list={["scroll-reveal-section pb-24", BAND_CONTENT_GAP]}>
    <div class="reveal-child stagger-1 mx-auto max-w-content px-gutter">
      <TermChipIndex
        ariaLabel="All integration types"
        terms={types.map((t) => ({
          name: t.name,
          href: `/integration-type/${t.slug}`,
          count: t.count,
        }))}
      />
    </div>
  </section>

  <LabsCloseCta content={integrationsClose("IntegrationTypes-Close-Book-Demo")} />
</BaseLayout>

<style>
  /* House scroll-reveal pattern (reference: llmops-tags/index.astro). */
  .reveal-child {
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }
  .stagger-1 { transition-delay: 60ms; }

  .scroll-reveal-section.reveal-armed:not(.in-view) .reveal-child {
    opacity: 0;
    transform: translateY(12px);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-child,
    .scroll-reveal-section.reveal-armed:not(.in-view) .reveal-child {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  import { initScrollReveal } from "../../scripts/labs-scroll-reveal";

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initScrollReveal);
  } else {
    initScrollReveal();
  }
</script>
