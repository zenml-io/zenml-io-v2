---
/**
 * Integration type taxonomy page.
 *
 * Renders a filtered view of integrations for this type, with a link back to
 * the hub pre-filtered. Matches the hub card style for consistency.
 *
 * Generates /integration-type/<slug> for each integration type.
 */
import { getCollection } from "astro:content";
import PageHeader from "../../components/templates/PageHeader.astro";
import TermHubCatalog from "../../components/templates/TermHubCatalog.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const integrationTypes = await getCollection("integration-types");
  const allIntegrations = await getCollection(
    "integrations",
    ({ data }) => !data.draft,
  );
  return integrationTypes
    .filter((itype) =>
      allIntegrations.some((i) => i.data.integrationType === itype.data.slug),
    )
    .map((itype) => ({
      params: { slug: itype.data.slug },
      props: { integrationType: itype },
    }));
}

const { integrationType } = Astro.props;

// Get all published integrations of this type
const allIntegrations = (
  await getCollection(
    "integrations",
    ({ data }) =>
      !data.draft && data.integrationType === integrationType.data.slug,
  )
).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout
  title={`${integrationType.data.name} Integrations - ZenML`}
  description={`ZenML integrations in the ${integrationType.data.name} category. Browse ${allIntegrations.length} integrations.`}
  surface="ml"
>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <PageHeader
      class="mb-10"
      leadingLink={{
        href: `/integrations?type=${integrationType.data.slug}`,
        label: "All integrations",
      }}
      heading={integrationType.data.name}
      description={`${allIntegrations.length} ${allIntegrations.length === 1 ? "integration" : "integrations"} in this category`}
      classOverrides={{
        heading: "text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl",
        headingSpacing: "mt-2",
        description: "text-lg text-gray-600",
        descriptionSpacing: "mt-2",
      }}
    />

    {/* Integration grid — same card style as hub */}
    <TermHubCatalog
      items={allIntegrations.map((integration) => ({
        href: `/integrations/${integration.data.slug}`,
        title: integration.data.title,
        categoryLabel: integrationType.data.name,
        logo: integration.data.logo,
      }))}
      emptyHeading="No integrations of this type yet."
    />
  </div>
</BaseLayout>
