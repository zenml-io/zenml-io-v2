---
/**
 * Case studies hub page — grid of all 5 case studies.
 *
 * Route: /case-studies
 *
 * Renders a hero section, a grid of case study cards,
 * a banner link to the LLMOps database, and a dark CTA band.
 */
import { getCollection } from "astro:content";
import Button from "../../components/Button.astro";
import CaseStudyCard from "../../components/sections/CaseStudyCard.astro";
import FeaturesHubCTA from "../../components/sections/FeaturesHubCTA.astro";
import { SECTION_INTRO_PRESETS } from "../../components/system/sectionIntro.shared";
import PageHeader from "../../components/templates/PageHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  CASE_STUDIES_HUB_BANNER,
  CASE_STUDIES_HUB_CTA,
  CASE_STUDIES_HUB_HERO,
  orderCaseStudies,
  splitAtBanner,
} from "../../lib/case-studies";

const allCaseStudies = await getCollection(
  "case-studies",
  ({ data }) => !data.draft,
);
const caseStudies = orderCaseStudies(allCaseStudies);
const { before: cardsBeforeBanner, after: cardsAfterBanner } =
  splitAtBanner(caseStudies);
---

<BaseLayout
  title="ZenML Case Studies - Real Teams, Real AI Workflows"
  description="See how teams are using ZenML to unify their AI platforms—from batch evaluations to real-time serving, traditional ML to GenAI workflows."
  ogTitle="ZenML Case Studies"
  surface="ml"
>
  <main>
    {/* Hero */}
    <PageHeader
      tone="brand"
      align="center"
      containerClass="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8"
      eyebrow={CASE_STUDIES_HUB_HERO.eyebrow}
      heading={CASE_STUDIES_HUB_HERO.headline}
      description={CASE_STUDIES_HUB_HERO.body}
      classOverrides={{
        eyebrow: SECTION_INTRO_PRESETS.cardEyebrow,
        heading: SECTION_INTRO_PRESETS.pageHero.heading,
        headingSpacing: "mt-3",
      }}
    >
      <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <Button href={CASE_STUDIES_HUB_HERO.primaryCta.href} size="lg">
          {CASE_STUDIES_HUB_HERO.primaryCta.label}
        </Button>
        <Button href={CASE_STUDIES_HUB_HERO.secondaryCta.href} variant="secondary" size="lg">
          {CASE_STUDIES_HUB_HERO.secondaryCta.label}
        </Button>
      </div>
    </PageHeader>

    {/* Case study cards, split by the LLMOps banner */}
    <section class="bg-white py-16 sm:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        {/* First row */}
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {cardsBeforeBanner.map((cs) => (
            <CaseStudyCard
              href={`/case-study/${cs.data.slug}`}
              title={cs.data.hub.cardTitle}
              logos={cs.data.hub.logos}
            />
          ))}
        </div>

        {/* LLMOps banner — between card rows */}
        <a
          href={CASE_STUDIES_HUB_BANNER.href}
          class="my-10 flex items-center justify-between rounded-md border border-gray-200 bg-gray-50 px-6 py-4 transition hover:border-zenml-300 hover:shadow-sm"
        >
          <div>
            <p class="font-semibold text-gray-900">{CASE_STUDIES_HUB_BANNER.text}</p>
            <p class="text-sm text-gray-500">{CASE_STUDIES_HUB_BANNER.supporting}</p>
          </div>
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-gray-200 bg-white">
            <svg class="h-5 w-5 text-gray-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M19 12l-7-7M19 12l-7 7" />
            </svg>
          </div>
        </a>

        {/* Second row: remaining cards */}
        {cardsAfterBanner.length > 0 && (
          <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {cardsAfterBanner.map((cs) => (
              <CaseStudyCard
                href={`/case-study/${cs.data.slug}`}
                title={cs.data.hub.cardTitle}
                logos={cs.data.hub.logos}
              />
            ))}
          </div>
        )}
      </div>
    </section>

    {/* CTA band */}
    <FeaturesHubCTA
      headline={CASE_STUDIES_HUB_CTA.headline}
      body={CASE_STUDIES_HUB_CTA.body}
      primaryCta={CASE_STUDIES_HUB_CTA.primaryCta}
      secondaryCta={CASE_STUDIES_HUB_CTA.secondaryCta}
    />
  </main>
</BaseLayout>
