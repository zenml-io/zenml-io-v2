---
import { getCollection } from "astro:content";
import BlogNewsletterCta from "../../components/labs/BlogNewsletterCta.astro";
import LabsButton from "../../components/labs/LabsButton.astro";
import LabsPageHeader from "../../components/labs/LabsPageHeader.astro";
import LabsStoryCard from "../../components/labs/LabsStoryCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BAND_CONTENT_GAP } from "../../lib/blogLayout";
import { defaultOgUrl, hasDefaultOgCard } from "../../lib/seo";
import {
  CASE_STUDIES_HUB_BANNER,
  CASE_STUDIES_HUB_HERO,
  orderCaseStudies,
  splitAtBanner,
} from "../../lib/case-studies";

const allCaseStudies = await getCollection(
  "case-studies",
  ({ data }) => !data.draft,
);
const caseStudies = orderCaseStudies(allCaseStudies);
const { before: cardsBeforeBanner, after: cardsAfterBanner } =
  splitAtBanner(caseStudies);
const heroPrimary = {
  ...CASE_STUDIES_HUB_HERO.primaryCta,
  analytics: "CaseStudies-Hero-BookDemo",
} as const;
const heroSecondary = {
  ...CASE_STUDIES_HUB_HERO.secondaryCta,
  analytics: "CaseStudies-Hero-ReadDocs",
} as const;
---

<BaseLayout
  ogImage={hasDefaultOgCard("pages", "case-studies") ? defaultOgUrl("pages", "case-studies") : undefined}
  title="ZenML Case Studies - Real Teams, Real AI Workflows"
  description="See how teams are using ZenML to unify their AI platforms—from batch evaluations to real-time serving, traditional ML to GenAI workflows."
  ogTitle="ZenML Case Studies"
  surface="ml"
  app="labs"
  product="zenml"
>
  <main>
  <LabsPageHeader
    eyebrow={CASE_STUDIES_HUB_HERO.eyebrow}
    heading={CASE_STUDIES_HUB_HERO.headline}
    description={CASE_STUDIES_HUB_HERO.body}
    align="center"
  >
    <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
      <LabsButton cta={heroPrimary} tone="dark" />
      <LabsButton cta={heroSecondary} tone="ghost" />
    </div>
  </LabsPageHeader>

  <section class:list={["scroll-reveal-section pb-24", BAND_CONTENT_GAP]}>
    <div class="mx-auto max-w-content px-gutter">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-4">
        {cardsBeforeBanner.map((cs) => (
          <LabsStoryCard
            href={"/case-study/" + cs.data.slug}
            title={cs.data.hub.cardTitle}
            company={cs.data.sidebar.company}
            logos={cs.data.hub.logos}
          />
        ))}
      </div>

      <a
        href={CASE_STUDIES_HUB_BANNER.href}
        class="my-10 flex cursor-pointer items-center justify-between gap-6 rounded-[20px] border border-border bg-card px-6 py-5 transition-colors duration-200 ease-out hover:border-(--color-sage-400)"
      >
        <div>
          <p class="font-sans text-[17px] leading-6 text-(--color-cream-900)">
            {CASE_STUDIES_HUB_BANNER.text}
          </p>
          <p class="mt-1 font-sans text-[15px] leading-6 text-(--color-cream-700)">
            {CASE_STUDIES_HUB_BANNER.supporting}
          </p>
        </div>
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-border text-(--color-cream-800)" aria-hidden="true">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </span>
      </a>

      {cardsAfterBanner.length > 0 && (
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-4">
          {cardsAfterBanner.map((cs) => (
            <LabsStoryCard
              href={"/case-study/" + cs.data.slug}
              title={cs.data.hub.cardTitle}
              company={cs.data.sidebar.company}
              logos={cs.data.hub.logos}
            />
          ))}
        </div>
      )}
    </div>
  </section>

  <BlogNewsletterCta />
  </main>
</BaseLayout>
