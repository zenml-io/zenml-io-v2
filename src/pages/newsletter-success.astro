---
import ConversionShell from "../components/templates/ConversionShell.astro";
/**
 * Newsletter Success — subscription confirmed.
 *
 * Route: /newsletter-success (noindex)
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  NEWSLETTER_SUCCESS_DATA,
  NEWSLETTER_SUCCESS_SEO,
} from "../lib/newsletterSuccess";
---

<BaseLayout
  title={NEWSLETTER_SUCCESS_SEO.title}
  description={NEWSLETTER_SUCCESS_SEO.description}
  noindex={NEWSLETTER_SUCCESS_SEO.noindex}
  surface="ml"
>
  <main>
    <ConversionShell
      frame="success"
      headline={NEWSLETTER_SUCCESS_DATA.headline}
      deck={NEWSLETTER_SUCCESS_DATA.body}
      primaryCta={NEWSLETTER_SUCCESS_DATA.primaryCta}
      secondaryCta={NEWSLETTER_SUCCESS_DATA.secondaryCta}
    />
  </main>
</BaseLayout>
