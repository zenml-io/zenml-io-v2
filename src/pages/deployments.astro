---
/**
 * Deployments page, in the ZenML Labs shell (`app="labs"`, `surface="ml"`,
 * `product="zenml"`). Rebuilt for the product one-offs cutover (#317):
 * the short shader band (headline / deck — hero CTAs leave, CONVENTIONS
 * liberty 4), the architecture split, the OSS-vs-Pro comparison table,
 * the alternating deployment-scenario splits, the deployment-methods grid,
 * the deployment-architecture tabs (+ its feature grid), and the closing
 * band.
 *
 * Route: /deployments
 */
import FeatureSplit from "../components/labs/FeatureSplit.astro";
import LabsBand from "../components/labs/LabsBand.astro";
import LabsCloseCta from "../components/labs/LabsCloseCta.astro";
import LabsFeatureTabs from "../components/labs/LabsFeatureTabs.astro";
import Split from "../components/system/layout/Split.astro";
import SpecTable from "../components/templates/SpecTable.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { BAND_CONTENT_GAP } from "../lib/blogLayout";
import {
  DEPLOYMENTS_ARCHITECTURE,
  DEPLOYMENTS_CLOSE,
  DEPLOYMENTS_COMPARISON,
  DEPLOYMENTS_FEATURE_TABS,
  DEPLOYMENTS_HERO,
  DEPLOYMENTS_METHODS,
  DEPLOYMENTS_SCENARIOS,
  DEPLOYMENTS_SEO,
  DEPLOYMENTS_TABS,
} from "../lib/deployments";
---

<BaseLayout
  title={DEPLOYMENTS_SEO.title}
  description={DEPLOYMENTS_SEO.description}
  ogTitle={DEPLOYMENTS_SEO.ogTitle}
  ogDescription={DEPLOYMENTS_SEO.ogDescription}
  ogImage={DEPLOYMENTS_SEO.ogImage}
  surface="ml"
  app="labs"
  product="zenml"
>
  <LabsBand size="short">
    <div class="flex flex-col gap-4">
      <h1 class="font-display text-[40px] leading-[44px] text-(--color-cream-900) md:text-[64px] md:leading-[70px]">
        {DEPLOYMENTS_HERO.headline}
      </h1>
      <p class="max-w-[720px] font-sans text-[18px] leading-7 text-(--color-cream-700)">
        {DEPLOYMENTS_HERO.deck}
      </p>
    </div>
  </LabsBand>

  {/* Architecture overview */}
  <section class:list={["py-24 md:py-32", BAND_CONTENT_GAP]}>
    <div class="mx-auto max-w-content px-gutter">
      <Split mediaSide="right" space="mlg" alignY="center">
        <div>
          <h2 class="font-display text-[32px] leading-[36px] text-(--color-cream-900) md:text-[44px] md:leading-[48px]">
            {DEPLOYMENTS_ARCHITECTURE.headline}
          </h2>
          <p class="mt-6 font-sans text-[17px] leading-[26px] text-(--color-cream-700)">
            {DEPLOYMENTS_ARCHITECTURE.body}
          </p>
          <dl class="mt-8 flex flex-col">
            {DEPLOYMENTS_ARCHITECTURE.features.map((feat) => (
              <div class="border-t border-(--color-border) py-4">
                <dt class="font-sans text-[15px] leading-5 font-medium text-(--color-cream-900)">
                  {feat.title}
                </dt>
                <dd class="mt-1 font-sans text-[14px] leading-5 text-(--color-cream-700)">
                  {feat.body}
                </dd>
              </div>
            ))}
          </dl>
        </div>
        <img
          slot="media"
          src={DEPLOYMENTS_ARCHITECTURE.image.url}
          alt={DEPLOYMENTS_ARCHITECTURE.image.alt}
          class="w-full rounded-[20px] border border-(--color-border) bg-card p-6"
          loading="lazy"
        />
      </Split>
    </div>
  </section>

  {/* Comparison table */}
  <section class="pb-24 md:pb-32">
    <div class="mx-auto max-w-content px-gutter">
      <SpecTable
        skin="labs"
        heading={DEPLOYMENTS_COMPARISON.headline}
        rowHeaderLabel="Feature"
        columns={DEPLOYMENTS_COMPARISON.columnHeaders}
        sections={[
          {
            rows: DEPLOYMENTS_COMPARISON.rows.map((r) => ({
              label: r.feature,
              values: r.values,
            })),
          },
        ]}
      />
    </div>
  </section>

  {/* Deployment scenarios (alternating layouts) */}
  <section class="bg-(--color-sage-50) py-24 md:py-32">
    <div class="mx-auto flex max-w-content flex-col gap-20 px-gutter">
      {
        DEPLOYMENTS_SCENARIOS.map((scenario, i) => (
          <FeatureSplit
            title={scenario.title}
            bullets={scenario.bullets}
            image={scenario.image}
            imageSide={i % 2 === 1 ? "left" : "right"}
            learnMore={{ href: scenario.learnMoreHref, label: "Learn More →" }}
          />
        ))
      }
    </div>
  </section>

  {/* Deployment methods grid */}
  <section class="py-24 md:py-32">
    <div class="mx-auto max-w-content px-gutter">
      <h2 class="font-display text-[32px] leading-[36px] text-(--color-cream-900) md:text-[44px] md:leading-[48px]">Various methods available</h2>
      <ul class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          DEPLOYMENTS_METHODS.map((method) => (
            <li>
              <a
                href={method.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex h-full flex-col gap-3 rounded-[20px] border border-(--color-border) bg-card p-8 transition-colors duration-200 ease-out hover:border-(--color-sage-400)"
              >
                <img src={method.icon} alt={method.iconAlt} class="h-8 w-8 object-contain" loading="lazy" />
                <h3 class="font-display text-[20px] leading-[26px] text-(--color-cream-900)">{method.title}</h3>
                <p class="font-sans text-[14px] leading-5 text-(--color-cream-700)">{method.body}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* Tabbed architecture diagrams + their feature grid */}
  <LabsFeatureTabs content={DEPLOYMENTS_FEATURE_TABS} />
  <section class="pb-24 md:pb-32">
    <div class="mx-auto max-w-content px-gutter">
      <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          DEPLOYMENTS_TABS.features.map((feat) => (
            <li class="rounded-[20px] border border-(--color-border) bg-card p-8 transition-colors duration-200 ease-out hover:border-(--color-sage-400)">
              <h3 class="font-display text-[20px] leading-[26px] text-(--color-cream-900)">{feat.title}</h3>
              <p class="mt-2 font-sans text-[15px] leading-5 text-(--color-cream-700)">{feat.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <LabsCloseCta content={DEPLOYMENTS_CLOSE} />
</BaseLayout>
