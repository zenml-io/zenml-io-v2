---
/**
 * Integrations hub page, on the ZenML Labs shell (integrations cutover
 * #318): short shader band (eyebrow + headline + deck), the labs skin of
 * the `IntegrationsIndex` filter island (search + type facet + grid), then
 * one closing CTA band.
 *
 * The card grid stays server-rendered (`labs.integration-card`); the island
 * only owns the rail + search box and toggles card visibility by
 * `data-slug` — see `ControlFilterIndex`'s TSDoc for why.
 *
 * Route: /integrations
 */
import { getCollection } from "astro:content";
import IntegrationsIndex from "../../components/islands/filter-index/IntegrationsIndex";
import IntegrationCard from "../../components/labs/IntegrationCard.astro";
import LabsBand from "../../components/labs/LabsBand.astro";
import LabsCloseCta from "../../components/labs/LabsCloseCta.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BAND_CONTENT_GAP, blogLaneStyle } from "../../lib/blogLayout";
import { INTEGRATIONS_HERO, integrationsClose } from "../../lib/integrations";
import { defaultOgUrl, hasDefaultOgCard } from "../../lib/seo";

// Get all published integrations + types
const allIntegrations = (
  await getCollection("integrations", ({ data }) => !data.draft)
).sort((a, b) => a.data.title.localeCompare(b.data.title));

const allTypes = (await getCollection("integration-types")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
const typeMap = new Map(allTypes.map((t) => [t.data.slug, t.data.name]));

// Lightweight index for the facet rail: search text + facet value only, no
// content bodies — the card markup itself stays server-rendered below.
const filterItems = allIntegrations.map((i) => ({
  slug: i.data.slug,
  title: i.data.title,
  type: i.data.integrationType,
}));
const filterTypes = allTypes.map((t) => ({
  slug: t.data.slug,
  name: t.data.name,
}));
---

<BaseLayout
  ogImage={hasDefaultOgCard("pages", "integrations") ? defaultOgUrl("pages", "integrations") : undefined}
  title="Integrations - ZenML"
  description="Explore the MLOps landscape with ZenML. Browse 60+ integrations for orchestrators, experiment trackers, artifact stores, and more."
  surface="ml"
  app="labs"
  product="zenml"
>
  <LabsBand size="short">
    <div class="scroll-reveal-section">
      <div class="flex flex-col gap-4">
        <p class="reveal-child font-label text-[13px] leading-4 tracking-[0.05em] uppercase text-(--color-cream-700)">
          {INTEGRATIONS_HERO.eyebrow}
        </p>
        <div class="reveal-child stagger-1">
          <h1 class="font-display text-[40px] leading-[44px] text-(--color-cream-900) md:text-[64px] md:leading-[70px]">
            {INTEGRATIONS_HERO.headline}
          </h1>
          <p class="mt-space-sm max-w-[690px] font-sans text-[17px] leading-[26px] text-foreground md:text-xl md:leading-[30px]">
            {INTEGRATIONS_HERO.deck}
          </p>
        </div>
      </div>
    </div>
  </LabsBand>

  <section class:list={["scroll-reveal-section pb-24 md:pb-32", BAND_CONTENT_GAP]}>
    <div class="reveal-child stagger-1 mx-auto max-w-content px-gutter" style={blogLaneStyle()}>
      <IntegrationsIndex client:load skin="labs" items={filterItems} types={filterTypes}>
        <div id="integrations-list" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {allIntegrations.map((integration) => (
            <IntegrationCard
              href={`/integrations/${integration.data.slug}`}
              title={integration.data.title}
              typeLabel={typeMap.get(integration.data.integrationType) || integration.data.integrationType}
              logo={integration.data.logo}
              dataType={integration.data.integrationType}
              slug={integration.data.slug}
            />
          ))}
        </div>
      </IntegrationsIndex>
    </div>
  </section>

  <LabsCloseCta content={integrationsClose("Integrations-Close-Book-Demo")} />
</BaseLayout>

<style>
  /* House scroll-reveal pattern (reference: llmops-database/index.astro). */
  .reveal-child {
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }
  .stagger-1 { transition-delay: 60ms; }

  .scroll-reveal-section.reveal-armed:not(.in-view) .reveal-child {
    opacity: 0;
    transform: translateY(12px);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-child,
    .scroll-reveal-section.reveal-armed:not(.in-view) .reveal-child {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  import { initScrollReveal } from "../../scripts/labs-scroll-reveal";

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initScrollReveal);
  } else {
    initScrollReveal();
  }
</script>
