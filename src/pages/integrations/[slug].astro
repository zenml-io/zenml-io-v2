---
/**
 * Integration detail page, on the ZenML Labs shell (integrations cutover
 * #318). Short band (eyebrow, mark + h1, deck, one ghost "View docs" pill)
 * → sticky breadcrumb → article body → related reading → "More
 * integrations" → closing band — but composed here in the page rather than
 * extracted into a layout: this is the only route that renders it, and
 * every block is already a shared primitive.
 *
 * Unlike a database entry (whose metadata record leads the prose via
 * `LabsArticleBody`'s `lead` slot), this page's record — Type, GitHub,
 * Compare — renders through the `rail` slot instead: from `xl` up it sits
 * in the right rail above the sticky "On this page" TOC, and below `xl` it
 * falls back to the same above-the-prose position `lead` uses. Its labels
 * render in mono (`labels="mono"` on `LabsMetadataBlock`) and its GitHub
 * row renders as a pill (`as: "pill"`, `icon: "github"`) rather than a
 * plain link — both are opt-in per this page, the database entry rendering
 * is untouched.
 *
 * The structured frontmatter fields are CMS-exported HTML: the two feature
 * fields are `<ul>` strings that go straight into `.prose`, and
 * `codeExampleHtml` holds plain (un-highlighted) `<pre><code>` blocks that
 * are highlighted here at build time on the site's Shiki theme and wrapped
 * in the code-pane chrome every other prose surface uses. See
 * `src/lib/integrationCode.ts`. The entry's `mainImage` (a Webflow-era
 * screenshot on a coloured card) is not rendered in the page any more; it
 * survives only as the Open Graph fallback. Entries with no structured field at all fall
 * back to the Markdown body.
 *
 * Generates /integrations/<slug> for each published integration.
 */
import { getCollection, getEntry, render } from "astro:content";
import { createHighlighter } from "shiki";
import LabsArticleBody from "../../components/labs/LabsArticleBody.astro";
import LabsBand from "../../components/labs/LabsBand.astro";
import LabsButton from "../../components/labs/LabsButton.astro";
import LabsCloseCta from "../../components/labs/LabsCloseCta.astro";
import LabsMetadataBlock, {
  type LabsMetadataBlockItem,
} from "../../components/labs/LabsMetadataBlock.astro";
import LabsRelatedBand from "../../components/labs/LabsRelatedBand.astro";
import StickyBreadcrumb from "../../components/labs/StickyBreadcrumb.astro";
import type { RelatedRailItem } from "../../components/templates/RelatedRail.astro";
import TermHubCatalog, {
  type TermHubCatalogItem,
} from "../../components/templates/TermHubCatalog.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { blogLaneStyle } from "../../lib/blogLayout";
import {
  codePaneHtml,
  extractCodeBlocks,
  replaceCodeBlocks,
  stripEmptyParagraphs,
} from "../../lib/integrationCode";
import {
  integrationDetailClose,
  MORE_INTEGRATIONS_COUNT,
  MORE_INTEGRATIONS_HEADING,
} from "../../lib/integrations";
import labsLight from "../../styles/labs-light.json";

type HighlighterTheme = NonNullable<
  Parameters<typeof createHighlighter>[0]["themes"]
>[number];

// Astro evaluates this module once per build, so the highlighter is built
// once for all 66 pages rather than per page.
const highlighter = await createHighlighter({
  themes: [labsLight as HighlighterTheme],
  langs: ["python", "bash"],
});

export async function getStaticPaths() {
  const integrations = await getCollection(
    "integrations",
    ({ data }) => !data.draft,
  );
  const types = await getCollection("integration-types");
  const typeNames = new Map(types.map((t) => [t.data.slug, t.data.name]));

  const allBlog = await getCollection("blog");
  const blogBySlug = new Map(allBlog.map((b) => [b.data.slug, b]));
  const categories = await getCollection("categories");
  const categoryNames = new Map(
    categories.map((c) => [c.data.slug, c.data.name]),
  );

  const byTitle = [...integrations].sort((a, b) =>
    a.data.title.localeCompare(b.data.title),
  );

  return integrations.map((integration) => {
    // Related blog posts, in the order the entry lists them.
    const relatedPosts = (integration.data.relatedBlogPosts ?? []).flatMap(
      (slug: string) => {
        const post = blogBySlug.get(slug);
        if (!post) return [];
        return [
          {
            href: `/blog/${post.data.slug}`,
            title: post.data.title,
            categoryName: post.data.category
              ? categoryNames.get(post.data.category)
              : undefined,
            date: post.data.date,
          },
        ];
      },
    );

    // Same type first (alphabetical), then everything else (alphabetical),
    // this integration excluded — a deterministic ranking, not a score.
    const others = byTitle.filter((i) => i.data.slug !== integration.data.slug);
    const sameType = others.filter(
      (i) => i.data.integrationType === integration.data.integrationType,
    );
    const rest = others.filter(
      (i) => i.data.integrationType !== integration.data.integrationType,
    );
    const moreIntegrations: TermHubCatalogItem[] = [...sameType, ...rest]
      .slice(0, MORE_INTEGRATIONS_COUNT)
      .map((i) => ({
        href: `/integrations/${i.data.slug}`,
        title: i.data.title,
        categoryLabel:
          typeNames.get(i.data.integrationType) ?? i.data.integrationType,
        logo: i.data.logo,
      }));

    return {
      params: { slug: integration.data.slug },
      props: {
        integration,
        relatedPosts,
        moreIntegrations,
        publishedCount: integrations.length,
      },
    };
  });
}

const { integration, relatedPosts, moreIntegrations, publishedCount } =
  Astro.props;
const { Content, headings } = await render(integration);
const d = integration.data;

// Resolve integration type
const typeEntry = d.integrationType
  ? await getEntry("integration-types", d.integrationType)
  : undefined;

// Resolve compare page name
let compareName: string | undefined;
if (d.compareSlug) {
  try {
    const compareEntryResult = getEntry("compare", d.compareSlug);
    const compareEntry = compareEntryResult
      ? await compareEntryResult
      : undefined;
    if (compareEntry?.data?.toolName) {
      compareName = `ZenML vs ${compareEntry.data.toolName}`;
    }
  } catch {
    compareName = undefined;
  }
}

// Determine structured rendering/fallback strategy
const hasStructuredSections = !!(
  d.overviewDescription?.trim() ||
  d.featuresWithZenmlHtml ||
  d.toolFeaturesHtml ||
  d.codeExampleHtml ||
  (d.additionalResources?.length ?? 0) > 0
);

const renderStructured = hasStructuredSections;

// Code example: highlight each block at build time, then put the finished
// panes back where they came from so the sentences a few entries use to
// introduce a block keep their place.
const codeBlocks = extractCodeBlocks(d.codeExampleHtml ?? "");
const codeExampleHtml =
  codeBlocks.length > 0
    ? stripEmptyParagraphs(
        replaceCodeBlocks(
          d.codeExampleHtml ?? "",
          codeBlocks.map((block) =>
            codePaneHtml(
              highlighter.codeToHtml(block.code, {
                lang: block.language === "text" ? "bash" : block.language,
                theme: labsLight.name,
              }),
              block.language,
            ),
          ),
        ),
      )
    : "";

// The record beside the body: the type, and the two outbound links the
// retired sidebar carried. A field the entry doesn't have takes its row
// with it.
const metadataItems: LabsMetadataBlockItem[] = [];
if (typeEntry) {
  metadataItems.push({
    label: "Type",
    value: {
      kind: "link",
      text: typeEntry.data.name,
      href: `/integration-type/${typeEntry.data.slug}`,
    },
  });
}
if (d.githubUrl) {
  metadataItems.push({
    label: "GitHub",
    value: {
      kind: "link",
      text: d.githubLinkText || "Get Started",
      href: d.githubUrl,
      external: true,
      analytics: "Integration-GitHub",
      as: "pill",
      icon: "github",
    },
  });
}
if (d.compareSlug) {
  metadataItems.push({
    label: "Compare",
    value: {
      kind: "link",
      text: compareName || d.compareSlug.replace("zenml-vs-", "ZenML vs "),
      href: `/compare/${d.compareSlug}`,
      analytics: "Integration-Compare",
    },
  });
}

// TOC headings: the sections this page actually renders. The fallback
// branch has no sections of its own, so it keeps the Markdown body's.
const structuredHeadings: { depth: number; slug: string; text: string }[] = [];
if (d.featuresWithZenmlHtml) {
  structuredHeadings.push({
    depth: 2,
    slug: "features-with-zenml",
    text: "Features with ZenML",
  });
}
if (d.toolFeaturesHtml) {
  structuredHeadings.push({
    depth: 2,
    slug: "main-features",
    text: "Main Features",
  });
}
if (codeBlocks.length > 0) {
  structuredHeadings.push({
    depth: 2,
    slug: "how-to-use",
    text: `How to use ZenML with ${d.title}`,
  });
}
if ((d.additionalResources?.length ?? 0) > 0) {
  structuredHeadings.push({
    depth: 2,
    slug: "additional-resources",
    text: "Additional Resources",
  });
}

const bodyHeadings = renderStructured ? structuredHeadings : headings;

// The house related-card shape (BlogLayout): the category is the card's
// kind label, the post date its meta line.
const relatedItems: RelatedRailItem[] = relatedPosts.map((post) => ({
  kind: "hex-card" as const,
  href: post.href,
  title: post.title,
  kindLabel: post.categoryName,
  meta: post.date
    ? new Date(post.date).toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
      })
    : undefined,
}));

// SEO
const seoTitle = d.seo?.title || `${d.title} Integration - ZenML`;
const seoDescription = d.seo?.description || d.shortDescription;
const ogImage = d.seo?.ogImage || d.mainImage?.url;
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  ogImage={ogImage}
  ogTitle={d.seo?.ogTitle}
  ogDescription={d.seo?.ogDescription}
  canonical={d.seo?.canonical}
  surface="ml"
  app="labs"
  product="zenml"
>
  <div style={blogLaneStyle()}>
    <LabsBand size="short">
      <div class="scroll-reveal-section">
        <div class="mx-auto flex max-w-(--article-lane) flex-col gap-4">
          <p class="reveal-child font-label text-[13px] leading-4 tracking-[0.05em] uppercase text-(--color-cream-700)">
            Integration
          </p>

          <div class="reveal-child stagger-1 flex items-center gap-5">
            {d.logo && (
              <span class="flex h-20 w-20 shrink-0 items-center justify-center rounded-[12px] border border-(--color-border) bg-white/90">
                <img
                  src={d.logo.url}
                  alt={d.logo.alt || d.title}
                  class="h-12 w-12 object-contain"
                  loading="eager"
                />
              </span>
            )}
            <h1 class="font-display text-[28px] leading-[34px] text-(--color-cream-800) md:text-[36px] md:leading-[42px]">
              {d.title}
            </h1>
          </div>

          {/* Deck on the left, the docs pill at the row's right end from md up. */}
          <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
            {d.shortDescription && (
              <p class="reveal-child stagger-2 max-w-[690px] font-sans text-[18px] leading-7 text-(--color-cream-700)">
                {d.shortDescription}
              </p>
            )}

            {d.docsUrl && (
              <div class="reveal-child stagger-3 md:ml-auto md:shrink-0">
              <LabsButton
                tone="ghost"
                target="_blank"
                cta={{
                  label: "View docs",
                  href: d.docsUrl,
                  analytics: "Integration-Docs",
                }}
              >
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="ml-2 inline-block"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M6 3H3v10h10v-3M9 2h5v5M14 2L7 9" />
                </svg>
              </LabsButton>
            </div>
          )}
          </div>
        </div>
      </div>
    </LabsBand>

    <div>
      <StickyBreadcrumb
        items={[
          { label: "Integrations", href: "/integrations" },
          ...(typeEntry
            ? [
                {
                  label: typeEntry.data.name,
                  href: `/integration-type/${typeEntry.data.slug}`,
                },
              ]
            : []),
          { label: d.title },
        ]}
      />

      <LabsArticleBody headings={bodyHeadings}>
        {metadataItems.length > 0 && (
          <div slot="rail" class="contents">
            <LabsMetadataBlock items={metadataItems} labels="mono" />
          </div>
        )}

        {renderStructured ? (
          <>
            {d.overviewDescription && <p>{d.overviewDescription}</p>}

            {d.featuresWithZenmlHtml && (
              <>
                <h2 id="features-with-zenml">Features with ZenML</h2>
                <Fragment set:html={stripEmptyParagraphs(d.featuresWithZenmlHtml)} />
              </>
            )}

            {d.toolFeaturesHtml && (
              <>
                <h2 id="main-features">Main Features</h2>
                <Fragment set:html={stripEmptyParagraphs(d.toolFeaturesHtml)} />
              </>
            )}

            {codeBlocks.length > 0 && (
              <>
                <h2 id="how-to-use">How to use ZenML with {d.title}</h2>
                <Fragment set:html={codeExampleHtml} />
              </>
            )}

            {(d.additionalResources?.length ?? 0) > 0 && (
              <>
                <h2 id="additional-resources">Additional Resources</h2>
                <ul>
                  {d.additionalResources.map((resource) => (
                    <li>
                      <a
                        href={resource.href}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {resource.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </>
        ) : (
          <Content />
        )}
      </LabsArticleBody>
    </div>

    <LabsRelatedBand heading="Related reading" items={relatedItems} />

    {/* The row sits on the light sage wash so it reads as its own band between
        the related-reading band and the close. */}
    <section class="scroll-reveal-section bg-(--color-sage-50) py-24 md:py-32">
      <div class="mx-auto max-w-content px-gutter">
        <h2 class="reveal-child font-display text-[28px] leading-[34px] text-(--color-cream-800)">
          {MORE_INTEGRATIONS_HEADING}
        </h2>
        <div class="reveal-child stagger-1 mt-10">
          <TermHubCatalog
            items={moreIntegrations}
            emptyHeading="No other integrations."
          />
        </div>
      </div>
    </section>

    <LabsCloseCta content={integrationDetailClose(publishedCount)} />
  </div>
</BaseLayout>

<style>
  /* House scroll-reveal pattern (reference: DatabaseEntryLayout.astro). */
  .reveal-child {
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }
  .stagger-1 { transition-delay: 60ms; }
  .stagger-2 { transition-delay: 120ms; }
  .stagger-3 { transition-delay: 180ms; }

  .scroll-reveal-section.reveal-armed:not(.in-view) .reveal-child {
    opacity: 0;
    transform: translateY(12px);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-child,
    .scroll-reveal-section.reveal-armed:not(.in-view) .reveal-child {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  import { initCodeCopy } from "../../scripts/code-copy";
  import { initScrollReveal } from "../../scripts/labs-scroll-reveal";

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      initCodeCopy();
      initScrollReveal();
    });
  } else {
    initCodeCopy();
    initScrollReveal();
  }
</script>
