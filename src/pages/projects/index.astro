---
/**
 * Projects listing page.
 *
 * Matches Webflow's uui-section_blog04 pattern: centered hero with purple
 * "ZenML Projects" badge, 3-column card grid with hover-lift animation.
 * Cards show image, title, description, license badge, and setup time.
 * Route: /projects
 *
 * The header's `classOverrides` stay inline: the nearest named preset,
 * TAXONOMY_INDEX_INTRO, differs on every line this header sets — no eyebrow
 * badge, `tracking-tight` rather than `-0.05rem`, no `sm:text-5xl` step-up,
 * and a description override this header does not take.
 */
import { getCollection } from "astro:content";
import ProjectsCTA from "../../components/sections/ProjectsCTA.astro";
import PageHeader from "../../components/templates/PageHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const allProjects = (
  await getCollection("projects", ({ data }) => !data.draft)
).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout
  title="Projects - ZenML"
  description="A home for machine learning projects built using ZenML and various integrations"
  surface="ml"
>
  {/* Hero */}
  <div class="py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
      <PageHeader
        eyebrow="ZenML Projects"
        heading="A home for machine learning projects built using ZenML and various integrations"
        description="Browse our projects for everything you need to replicate a production-grade use case — demo, video, blog, and code."
        classOverrides={{
          eyebrow: "inline-flex items-center rounded-full bg-zenml-50 px-3 py-0.5 text-sm font-semibold text-zenml-500",
          heading: "text-4xl font-bold text-gray-900 sm:text-5xl sm:leading-[1.2] tracking-[-0.05rem]",
          headingSpacing: "mt-4",
        }}
      />
    </div>
  </div>

  {/* Card grid */}
  <div class="px-4 pb-16 sm:px-6 sm:pb-20 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {allProjects.map((project) => (
          <a
            href={`/projects/${project.data.slug}`}
            class="group flex flex-col overflow-hidden rounded-lg border border-gray-200 bg-gradient-to-br from-[#fcfcfc] to-white transition-all duration-300 ease-[cubic-bezier(.77,0,.175,1)] hover:-translate-y-2.5 hover:border-zenml-500 hover:from-[#f9f4ff] hover:to-white hover:shadow-medium"
          >
            <div class="flex h-[140px] items-center justify-center overflow-hidden">
              {project.data.mainImageLink && (
                <img
                  src={project.data.mainImageLink}
                  alt={project.data.title}
                  class="h-full w-full object-cover"
                  loading="lazy"
                />
              )}
            </div>
            <div class="flex flex-1 flex-col gap-4 px-6 pb-6 pt-4">
              <h2 class="text-2xl font-bold leading-tight text-gray-900">
                {project.data.title}
              </h2>
              {project.data.description && (
                <p class="text-sm leading-relaxed text-gray-600">{project.data.description}</p>
              )}
              <div class="mt-auto flex items-center gap-1.5 rounded-full bg-zenml-50 px-2.5 py-0.5 text-sm font-semibold text-zenml-500 w-fit">
                <svg class="h-5 w-5 flex-shrink-0" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M10 2.5a1.25 1.25 0 100 2.5 1.25 1.25 0 000-2.5zM7.2 2.917a2.917 2.917 0 015.592 0H16.667a.833.833 0 010 1.666H12.796a2.917 2.917 0 01-1.963 1.963V16.667h5.834a.833.833 0 010 1.666H3.333a.833.833 0 010-1.666H9.167V6.546A2.917 2.917 0 017.204 4.583H3.333a.833.833 0 010-1.666H7.2z" fill="#7A3EF4"/>
                </svg>
                {project.data.license}
              </div>
              <p class="text-sm text-gray-600">Setup time: {project.data.setupTime}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>

  <ProjectsCTA />
</BaseLayout>
