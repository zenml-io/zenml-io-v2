---
import { getCollection } from "astro:content";
import BlogCard from "../../components/labs/BlogCard.astro";
import BlogNewsletterCta from "../../components/labs/BlogNewsletterCta.astro";
import LabsPageHeader from "../../components/labs/LabsPageHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BAND_CONTENT_GAP } from "../../lib/blogLayout";

const allProjects = (
  await getCollection("projects", ({ data }) => !data.draft)
).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout
  title="Projects - ZenML"
  description="A home for machine learning projects built using ZenML and various integrations"
  surface="ml"
  app="labs"
  product="zenml"
>
  <LabsPageHeader
    eyebrow="ZenML Projects"
    heading="A home for machine learning projects built using ZenML and various integrations"
    description="Browse our projects for everything you need to replicate a production-grade use case — demo, video, blog, and code."
  />

  <section class:list={["scroll-reveal-section pb-24", BAND_CONTENT_GAP]}>
    <div class="mx-auto max-w-content px-gutter">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {allProjects.map((project) => (
          <BlogCard
            href={`/projects/${project.data.slug}`}
            title={project.data.title}
            excerpt={project.data.description}
            image={
              project.data.mainImageLink
                ? { url: project.data.mainImageLink, alt: project.data.title }
                : undefined
            }
            categoryName={project.data.license}
            readingTime={`Setup time: ${project.data.setupTime}`}
          />
        ))}
      </div>
    </div>
  </section>

  <BlogNewsletterCta />
</BaseLayout>
