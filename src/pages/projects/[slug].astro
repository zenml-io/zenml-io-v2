---
import { getCollection } from "astro:content";
import DescriptionList, {
  type DividedDescriptionListItem,
} from "../../components/templates/DescriptionList.astro";
import LabsDetailLayout from "../../layouts/LabsDetailLayout.astro";
import { markdownToHtml } from "../../lib/projectBody";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const {
  title,
  description,
  projectId,
  githubUrl,
  pipelines,
  stackHtml,
  tools,
  tags,
  mainImageLink,
  previewImage,
} = project.data;

const seoTitle = project.data.seo?.title || `${title} - ZenML Projects`;
const seoDescription = project.data.seo?.description || description;
const detailsHtml = markdownToHtml((project.body ?? "").trim());

const sidebarItems: DividedDescriptionListItem[] = [
  { term: "Project", value: { kind: "text", text: title } },
];
if (projectId) {
  sidebarItems.push({
    term: "Project ID",
    value: {
      kind: "identifier",
      text: projectId,
      note: "Use this id to create a new project in ZenML",
    },
  });
}
if (githubUrl) {
  sidebarItems.push({
    term: "GitHub Repository",
    value: { kind: "link", href: githubUrl, label: githubUrl },
  });
}
if (pipelines.length > 0) {
  sidebarItems.push({
    term: "Pipelines",
    value: { kind: "entries", entries: pipelines },
  });
}
if (stackHtml) {
  sidebarItems.push({
    term: "Recommended Stack",
    value: { kind: "html", html: stackHtml },
  });
}
if (tools.length > 0) {
  sidebarItems.push({
    term: "Tools",
    value: { kind: "chips", chips: tools, tone: "neutral" },
  });
}
if (tags.length > 0) {
  sidebarItems.push({
    term: "Tags",
    value: { kind: "chips", chips: tags, tone: "brand" },
  });
}
---

<LabsDetailLayout
  title={seoTitle}
  description={seoDescription}
  ogImage={project.data.seo?.ogImage}
  ogTitle={project.data.seo?.ogTitle}
  ogDescription={project.data.seo?.ogDescription}
  canonical={project.data.seo?.canonical}
  heading={title}
  breadcrumb={[{ label: "Projects", href: "/projects" }, { label: title }]}
  surface="ml"
  product="zenml"
>
  <div slot="sidebar" class="overflow-hidden rounded-[20px] border border-border bg-card">
    {mainImageLink && (
      <div class="flex h-[140px] items-center justify-center overflow-hidden">
        <img
          src={mainImageLink}
          alt={title}
          class="h-full w-full object-cover"
          loading="lazy"
        />
      </div>
    )}

    <DescriptionList items={sidebarItems} frame="divided" />
  </div>

  <div class="prose prose-gray max-w-none" set:html={detailsHtml} />

  {previewImage?.url && (
    <div class="mt-10">
      <h2 class="font-sans text-[14px] text-(--color-cream-700)">
        Gallery
      </h2>
      <img
        src={previewImage.url}
        alt={previewImage.alt || title}
        class="mt-3 w-full rounded-lg"
        loading="lazy"
      />
    </div>
  )}
</LabsDetailLayout>
