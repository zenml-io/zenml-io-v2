---
/**
 * Project detail page.
 *
 * Header with back link + project image + title, then a 2-column layout with
 * a sticky left sidebar (project metadata rows) and a right content column
 * (details + gallery).
 *
 * Route: /projects/<slug>
 */
import { getCollection } from "astro:content";
import ProjectsCTA from "../../components/sections/ProjectsCTA.astro";
import DescriptionList, {
  type DividedDescriptionListItem,
} from "../../components/templates/DescriptionList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { markdownToHtml } from "../../lib/projectBody";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const {
  title,
  description,
  projectId,
  githubUrl,
  pipelines,
  stackHtml,
  tools,
  tags,
  mainImageLink,
  previewImage,
} = project.data;

const seoTitle = project.data.seo?.title || `${title} - ZenML Projects`;
const seoDescription = project.data.seo?.description || description;

const detailsHtml = markdownToHtml((project.body ?? "").trim());

const sidebarItems: DividedDescriptionListItem[] = [
  { term: "Project", value: { kind: "text", text: title } },
];
if (projectId) {
  sidebarItems.push({
    term: "Project ID",
    value: {
      kind: "identifier",
      text: projectId,
      note: "Use this id to create a new project in ZenML",
    },
  });
}
if (githubUrl) {
  sidebarItems.push({
    term: "GitHub Repository",
    value: { kind: "link", href: githubUrl, label: githubUrl },
  });
}
if (pipelines.length > 0) {
  sidebarItems.push({
    term: "Pipelines",
    value: { kind: "entries", entries: pipelines },
  });
}
if (stackHtml) {
  sidebarItems.push({
    term: "Recommended Stack",
    value: { kind: "html", html: stackHtml },
  });
}
if (tools.length > 0) {
  sidebarItems.push({
    term: "Tools",
    value: { kind: "chips", chips: tools, tone: "neutral" },
  });
}
if (tags.length > 0) {
  sidebarItems.push({
    term: "Tags",
    value: { kind: "chips", chips: tags, tone: "brand" },
  });
}
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  surface="ml"
>
  {/* Header: back link + project image + title */}
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center">
      {mainImageLink && (
        <div class="flex h-[180px] w-[180px] flex-shrink-0 items-center justify-center overflow-hidden rounded-lg border border-gray-300 bg-white">
          <img
            src={mainImageLink}
            alt={title}
            class="h-full w-full object-cover"
          />
        </div>
      )}
      <div>
        <a
          href="/projects"
          class="mb-3 inline-flex items-center gap-1.5 text-sm font-semibold text-zenml-500 hover:text-zenml-600 transition-colors"
        >
          <svg class="h-4 w-4 rotate-180" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
          </svg>
          All Projects
        </a>
        <h1 class="text-2xl font-bold text-gray-900 sm:text-3xl">{title}</h1>
        {description && (
          <p class="mt-2 text-lg leading-relaxed text-gray-600">{description}</p>
        )}
      </div>
    </div>
  </div>

  {/* Two-column body */}
  <div class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="grid gap-8 pt-4 lg:grid-cols-[1fr_2fr] lg:gap-12">

      {/* Left column: sticky sidebar */}
      <div class="lg:sticky lg:top-20 lg:self-start">
        <div class="overflow-hidden rounded-lg bg-gray-50">
          {mainImageLink && (
            <div class="flex h-[140px] items-center justify-center overflow-hidden">
              <img
                src={mainImageLink}
                alt={title}
                class="h-full w-full object-cover"
                loading="lazy"
              />
            </div>
          )}

          <DescriptionList
            items={sidebarItems}
            frame="divided"
            termTone="muted"
          />
        </div>
      </div>

      {/* Right column: details + gallery */}
      <div>
        <div class:list={["pb-6 mb-6", previewImage?.url && "border-b border-gray-100"]}>
          <div class="text-xs font-semibold uppercase tracking-wider text-gray-400">Details</div>
          <div class="prose prose-gray mt-3 max-w-none" set:html={detailsHtml} />
        </div>

        {/* Gallery — the architecture/pipeline diagram */}
        {previewImage?.url && (
          <div>
            <div class="text-xs font-semibold uppercase tracking-wider text-gray-400">Gallery</div>
            <img
              src={previewImage.url}
              alt={previewImage.alt || title}
              class="mt-3 w-full rounded-lg"
              loading="lazy"
            />
          </div>
        )}
      </div>

    </div>
  </div>

  <ProjectsCTA />
</BaseLayout>
