---
import RoiCalculatorIsland from "../components/islands/RoiCalculator";
import LabsCloseCta from "../components/labs/LabsCloseCta.astro";
import LabsPageHeader from "../components/labs/LabsPageHeader.astro";
/**
 * /roi-calculator — Interactive ROI calculator page.
 *
 * Shows three sliders (models, team size, cloud spend) and computes
 * estimated infrastructure savings, productivity gains, and ROI.
 * The calculator logic is a Preact island for client-side reactivity.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { ZENML_CLOSE } from "../lib/labs-product-zenml";
---

<BaseLayout
  title="ZenML - ROI Calculator: Understand Buy vs Build"
  description="Assess the impact of ZenML's AI orchestration platform in your company"
  surface="ml"
  app="labs"
  product="zenml"
>
  <main>
    <LabsPageHeader
      align="center"
      eyebrow="ROI Calculator"
      heading="Assess the impact of ZenML's AI orchestration platform in your company"
    />

    {/* Calculator island */}
    <section class="bg-(--color-cream-50) py-space-xl md:py-space-xxl">
      <div class="mx-auto max-w-content px-gutter">
        <RoiCalculatorIsland client:load />
      </div>
    </section>

    <LabsCloseCta content={ZENML_CLOSE} />
  </main>
</BaseLayout>
