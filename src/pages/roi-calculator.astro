---
import RoiCalculatorIsland from "../components/islands/RoiCalculator";
import FeaturesHubCTA from "../components/sections/FeaturesHubCTA.astro";
import SectionIntro from "../components/system/SectionIntro.astro";
import { SECTION_INTRO_PRESETS } from "../components/system/sectionIntro.shared";
/**
 * /roi-calculator — Interactive ROI calculator page.
 *
 * Shows three sliders (models, team size, cloud spend) and computes
 * estimated infrastructure savings, productivity gains, and ROI.
 * The calculator logic is a Preact island for client-side reactivity.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="ZenML - ROI Calculator: Understand Buy vs Build"
  description="Assess the impact of ZenML's AI orchestration platform in your company"
  surface="ml"
>
  {/* Hero / heading */}
  <section class="py-16 sm:py-20">
    <SectionIntro
      align="center"
      eyebrow="ROI Calculator"
      heading="Assess the impact of ZenML's AI orchestration platform in your company"
      headingLevel={1}
      classOverrides={{
        eyebrow: "text-sm font-semibold uppercase tracking-wider text-primary-600",
        ...SECTION_INTRO_PRESETS.pageHero,
      }}
    />
  </section>

  {/* Calculator island */}
  <section class="pb-16 sm:pb-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <RoiCalculatorIsland client:load />
    </div>
  </section>

  {/* Bottom CTA */}
  <FeaturesHubCTA
    headline="Unify Your ML and LLM Workflows"
    body="Open-source foundation, no vendor lock-in. Works with any infrastructure. Upgrade to managed Pro features."
    primaryCta={{ label: "Book a demo", href: "/book-your-demo" }}
    secondaryCta={{ label: "Read Docs", href: "/docs" }}
  />
</BaseLayout>
