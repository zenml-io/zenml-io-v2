---
import CalEmbed from "../components/sections/CalEmbed.astro";
import ConversionShell from "../components/templates/ConversionShell.astro";
/**
 * Schedule a Demo — Cal.com reschedule booking page.
 *
 * Route: /schedule-a-demo
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  SCHEDULE_A_DEMO_CAL,
  SCHEDULE_A_DEMO_HERO,
  SCHEDULE_A_DEMO_SEO,
} from "../lib/scheduleADemo";
---

<BaseLayout
  title={SCHEDULE_A_DEMO_SEO.title}
  description={SCHEDULE_A_DEMO_SEO.description}
  ogTitle={SCHEDULE_A_DEMO_SEO.ogTitle}
  ogDescription={SCHEDULE_A_DEMO_SEO.ogDescription}
  surface="unified"
>
  <main>
    <ConversionShell
      headline={SCHEDULE_A_DEMO_HERO.headline}
      deck={SCHEDULE_A_DEMO_HERO.deck}
      frame="calendar"
    >
      <CalEmbed config={SCHEDULE_A_DEMO_CAL} />
    </ConversionShell>
  </main>
</BaseLayout>
