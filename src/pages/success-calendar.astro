---
import CalEmbed from "../components/sections/CalEmbed.astro";
import ConversionShell from "../components/templates/ConversionShell.astro";
/**
 * Success Calendar — post-form thank-you page with Cal.com embed.
 *
 * Route: /success-calendar (noindex)
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  SUCCESS_CALENDAR_CAL,
  SUCCESS_CALENDAR_HERO,
  SUCCESS_CALENDAR_SEO,
} from "../lib/successCalendar";
---

<BaseLayout
  title={SUCCESS_CALENDAR_SEO.title}
  description={SUCCESS_CALENDAR_SEO.description}
  noindex={SUCCESS_CALENDAR_SEO.noindex}
  surface="unified"
>
  <main>
    <ConversionShell
      headline={SUCCESS_CALENDAR_HERO.headline}
      deck={SUCCESS_CALENDAR_HERO.deck}
      frame="calendar"
    >
      <CalEmbed config={SUCCESS_CALENDAR_CAL} />
    </ConversionShell>
  </main>
</BaseLayout>
