---
/**
 * Benchmarks hub, in the ZenML Labs shell (`surface="unified"`, no
 * `product`). `labs.page-header` with a count, last-updated line and a jump
 * row of industries, then one grid of `labs.benchmark-card`s per industry
 * (the featured one, insurance, on a sage band), each led by a small bar
 * chart from src/lib/benchmarkReports/previews.ts (each card links to its
 * report at /benchmarks/<slug>), the rules every benchmark follows and who
 * runs them as a `labs.faq`, and the shared closing band.
 */
import LabsBenchmarkCard from "../components/labs/LabsBenchmarkCard.astro";
import LabsCloseCta from "../components/labs/LabsCloseCta.astro";
import LabsFaq from "../components/labs/LabsFaq.astro";
import LabsPageHeader from "../components/labs/LabsPageHeader.astro";
import { LABS_EYEBROW_CLASS } from "../components/templates/pageHeaderPresets";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  BENCHMARK_INDUSTRIES,
  BENCHMARK_PREVIEWS,
  BENCHMARK_REPORTS,
} from "../lib/benchmarkReports";
import { longDate } from "../lib/benchmarkReports/format";
import {
  BENCHMARK_METHOD,
  BENCHMARKS_CLOSE,
  BENCHMARKS_WHO_RUNS,
} from "../lib/benchmarks";
import { SECTION_HEADING_CLASS } from "../lib/blogLayout";
import type { FaqData } from "../lib/marketingPageTypes";
import { defaultOgImage } from "../lib/seo";
import "../styles/labs-scroll-reveal.css";

const TITLE = "Benchmarks: models inside real agent work";
const DESCRIPTION =
  "How models behave inside real agents, measured as cost per correct answer, with the method, noise and caveats published for every experiment.";

const groups = BENCHMARK_INDUSTRIES.map((group) => {
  const reports = BENCHMARK_REPORTS.filter(
    (report) => report.industry === group.id,
  );
  // Two or four cards fill a two-column grid evenly; any other count uses three.
  const columns = reports.length === 2 || reports.length === 4 ? 2 : 3;
  return { ...group, reports, columns };
}).filter((group) => group.reports.length > 0);

const METHOD: FaqData = {
  headline: "How we run these benchmarks",
  items: [...BENCHMARK_METHOD, BENCHMARKS_WHO_RUNS].map((rule) => ({
    question: rule.title,
    answer: rule.body,
  })),
};

const latest = BENCHMARK_REPORTS.reduce(
  (newest, report) => (report.date > newest ? report.date : newest),
  "",
);
---

<BaseLayout
  ogImage={defaultOgImage("pages", "benchmarks")}
  title={TITLE}
  description={DESCRIPTION}
  surface="unified"
  app="labs"
>
  <LabsPageHeader
    eyebrow="Benchmarks"
    heading="The best model depends on your agent."
    description="We test models, and the infrastructure that serves them, on real agent work by industry, starting with insurance, and count what each correct answer costs. Every experiment publishes its method, its noise and what it can't show."
  >
    <p class="mt-4 font-sans text-[14px] leading-5 text-(--color-cream-700)">
      {BENCHMARK_REPORTS.length} benchmarks &middot; last updated {longDate(latest)}
    </p>
  </LabsPageHeader>

  <nav aria-label="Industries" class="mx-auto max-w-content px-gutter pt-6">
    <ul class="flex list-none flex-wrap gap-2">
      {groups.map((group) => (
        <li>
          <a
            href={`#${group.id}`}
            class:list={[
              "inline-flex min-h-11 items-center gap-2 rounded-full border px-4 font-sans text-[15px] leading-5 transition-colors duration-200 ease-out",
              group.featured
                ? "border-(--color-sage-400) bg-(--color-sage-100) text-(--color-sage-900) hover:bg-(--color-sage-200)"
                : "border-(--color-border) text-(--color-cream-900) hover:border-(--color-sage-400) hover:bg-(--color-sage-50)",
            ]}
          >
            {group.title}
            <span class="font-mono text-[13px] text-(--color-cream-700)">{group.reports.length}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div>
    {groups.map((group) => (
      <section
        id={group.id}
        aria-labelledby={`${group.id}-title`}
        class:list={[
          "scroll-reveal-section scroll-mt-28",
          group.featured ? "mt-8 bg-(--color-sage-50) py-14 md:mt-10 md:py-20" : "py-10 md:py-14",
        ]}
      >
        <div class="mx-auto max-w-content px-gutter">
          {group.featured && <p class:list={["reveal-child mb-3", LABS_EYEBROW_CLASS]}>Featured industry</p>}
          <h2 id={`${group.id}-title`} class:list={["reveal-child", SECTION_HEADING_CLASS]}>
            {group.title}
          </h2>
          <p class="reveal-child stagger-1 mt-space-xs mb-space-md max-w-[720px] font-sans text-[17px] leading-[27px] text-(--color-cream-700)">
            {group.intro}
          </p>
          <ul class:list={["grid list-none grid-cols-1 gap-4 md:grid-cols-2", group.columns === 3 && "xl:grid-cols-3"]}>
            {group.reports.map((report, index) => (
              <li class:list={["reveal-child min-w-0", index % group.columns === 1 && "stagger-1", index % group.columns === 2 && "stagger-2"]}>
                <LabsBenchmarkCard
                  report={report}
                  preview={BENCHMARK_PREVIEWS[report.slug]}
                />
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))}
  </div>

  <div class="scroll-reveal-section">
    <div class="reveal-child"><LabsFaq content={METHOD} /></div>
  </div>

  <div class="scroll-reveal-section">
    <div class="reveal-child"><LabsCloseCta content={BENCHMARKS_CLOSE} preset="comparison" /></div>
  </div>
  <script>
    import { initScrollReveal } from "../scripts/labs-scroll-reveal";
    initScrollReveal();
  </script>
</BaseLayout>
