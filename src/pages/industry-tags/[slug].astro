---
/**
 * Industry tag taxonomy page.
 *
 * Shows all LLMOps and MLOps database entries in this industry.
 * Generates /industry-tags/<slug> for each industry tag in the collection.
 */
import { getCollection } from "astro:content";
import TermHubEntryIndex from "../../components/templates/TermHubEntryIndex.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLLMOpsTagCounts } from "../../lib/llmops";
import { getMLOpsTagCounts } from "../../lib/mlops";

export async function getStaticPaths() {
  const industryTags = await getCollection("industry-tags");
  const allLLMOpsTags = await getCollection("llmops-tags");
  const allMLOpsTags = await getCollection("mlops-tags");
  const llmopsTagMap = Object.fromEntries(
    allLLMOpsTags.map((tag) => [tag.data.slug, tag.data.name]),
  );
  const mlopsTagMap = Object.fromEntries(
    allMLOpsTags.map((tag) => [tag.data.slug, tag.data.name]),
  );
  const allLLMOpsEntries = await getCollection(
    "llmops-database",
    ({ data }) => !data.draft,
  );
  const allMLOpsEntries = await getCollection(
    "mlops-database",
    ({ data }) => !data.draft,
  );

  return industryTags
    .filter(
      (tag) =>
        allLLMOpsEntries.some((e) => e.data.industryTags === tag.data.slug) ||
        allMLOpsEntries.some((e) => e.data.industryTags === tag.data.slug),
    )
    .map((tag) => ({
      params: { slug: tag.data.slug },
      props: { tag, llmopsTagMap, mlopsTagMap },
    }));
}

const { tag, llmopsTagMap, mlopsTagMap } = Astro.props;

const llmopsEntries = (
  await getCollection(
    "llmops-database",
    ({ data }) => !data.draft && data.industryTags === tag.data.slug,
  )
).sort((a, b) => a.data.title.localeCompare(b.data.title));

const mlopsEntries = (
  await getCollection(
    "mlops-database",
    ({ data }) => !data.draft && data.industryTags === tag.data.slug,
  )
).sort((a, b) => a.data.title.localeCompare(b.data.title));

const totalEntries = llmopsEntries.length + mlopsEntries.length;
const commonLLMOpsTags = (await getLLMOpsTagCounts(llmopsEntries)).slice(0, 8);
const commonMLOpsTags = (await getMLOpsTagCounts(mlopsEntries)).slice(0, 8);
---

<BaseLayout
  title={`${tag.data.name} Industry - ZenML Databases`}
  description={`LLMOps and MLOps entries in the ${tag.data.name} industry.`}
  surface="ml"
>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <header class="mb-12">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900">
        Industry: {tag.data.name}
      </h1>
      <p class="mt-4 text-lg text-gray-600">
        {totalEntries} {totalEntries === 1 ? "entry" : "entries"} in this industry
      </p>
      <div class="mt-2 flex flex-wrap gap-4 text-sm">
        <a href="/llmops-database" class="text-primary-600 hover:text-primary-700">
          &larr; LLMOps Database
        </a>
        <a href="/mlops-database" class="text-primary-600 hover:text-primary-700">
          &larr; MLOps Database
        </a>
      </div>
    </header>

    <TermHubEntryIndex
      crossLinks={[
        {
          heading: "Common LLMOps tags",
          viewAllHref: "/llmops-tags",
          viewAllLabel: "View all",
          badgeVariant: "blue",
          items: commonLLMOpsTags.map((item) => ({
            name: item.name,
            slug: item.slug,
            count: item.count,
            href: `/llmops-tags/${item.slug}`,
          })),
        },
        {
          heading: "Common MLOps topics",
          viewAllHref: "/mlops-tags",
          viewAllLabel: "View all",
          badgeVariant: "success",
          items: commonMLOpsTags.map((item) => ({
            name: item.name,
            slug: item.slug,
            count: item.count,
            href: `/mlops-tags/${item.slug}`,
          })),
        },
      ]}
      sections={[
        {
          heading: "LLMOps entries",
          cards: llmopsEntries.map((entry) => ({
            title: entry.data.title,
            href: `/llmops-database/${entry.data.slug}`,
            headingLevel: 3 as const,
            company: entry.data.company,
            summary: entry.data.summary,
            tags: entry.data.llmopsTags.slice(0, 4).map((tagSlug: string) => ({
              label: llmopsTagMap[tagSlug] || tagSlug,
              href: `/llmops-tags/${tagSlug}`,
            })),
            extraTagCount: Math.max(0, entry.data.llmopsTags.length - 4),
            tagVariant: "blue" as const,
          })),
        },
        {
          heading: "MLOps entries",
          cards: mlopsEntries.map((entry) => ({
            title: entry.data.title,
            href: `/mlops-database/${entry.data.slug}`,
            headingLevel: 3 as const,
            metaLine: [
              entry.data.company,
              ...(entry.data.platformName !== entry.data.company
                ? [entry.data.platformName]
                : []),
              entry.data.contentType,
            ],
            summary: entry.data.summary,
            tags: entry.data.mlopsTags.slice(0, 4).map((tagSlug: string) => ({
              label: mlopsTagMap[tagSlug] || tagSlug,
              href: `/mlops-tags/${tagSlug}`,
            })),
            extraTagCount: Math.max(0, entry.data.mlopsTags.length - 4),
            tagVariant: "success" as const,
          })),
        },
      ]}
      emptyHeading="No LLMOps or MLOps entries in this industry yet."
    />
  </div>
</BaseLayout>
