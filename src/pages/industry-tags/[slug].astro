---
/**
 * Industry tag taxonomy page.
 *
 * Shows all LLMOps and MLOps database entries in this industry.
 * Generates /industry-tags/<slug> for each industry tag in the collection.
 */
import { getCollection } from "astro:content";
import Badge from "../../components/Badge.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLLMOpsTagCounts } from "../../lib/llmops";
import { getMLOpsTagCounts } from "../../lib/mlops";

export async function getStaticPaths() {
  const industryTags = await getCollection("industry-tags");
  const allLLMOpsTags = await getCollection("llmops-tags");
  const allMLOpsTags = await getCollection("mlops-tags");
  const llmopsTagMap = Object.fromEntries(
    allLLMOpsTags.map((tag) => [tag.data.slug, tag.data.name]),
  );
  const mlopsTagMap = Object.fromEntries(
    allMLOpsTags.map((tag) => [tag.data.slug, tag.data.name]),
  );

  return industryTags.map((tag) => ({
    params: { slug: tag.data.slug },
    props: { tag, llmopsTagMap, mlopsTagMap },
  }));
}

const { tag, llmopsTagMap, mlopsTagMap } = Astro.props;

const llmopsEntries = (
  await getCollection(
    "llmops-database",
    ({ data }) => !data.draft && data.industryTags === tag.data.slug,
  )
).sort((a, b) => a.data.title.localeCompare(b.data.title));

const mlopsEntries = (
  await getCollection(
    "mlops-database",
    ({ data }) => !data.draft && data.industryTags === tag.data.slug,
  )
).sort((a, b) => a.data.title.localeCompare(b.data.title));

const totalEntries = llmopsEntries.length + mlopsEntries.length;
const commonLLMOpsTags = (await getLLMOpsTagCounts(llmopsEntries)).slice(0, 8);
const commonMLOpsTags = (await getMLOpsTagCounts(mlopsEntries)).slice(0, 8);
---

<BaseLayout
  title={`${tag.data.name} Industry - ZenML Databases`}
  description={`LLMOps and MLOps entries in the ${tag.data.name} industry.`}
>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <header class="mb-12">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900">
        Industry: {tag.data.name}
      </h1>
      <p class="mt-4 text-lg text-gray-600">
        {totalEntries} {totalEntries === 1 ? "entry" : "entries"} in this industry
      </p>
      <div class="mt-2 flex flex-wrap gap-4 text-sm">
        <a href="/llmops-database" class="text-primary-600 hover:text-primary-700">
          &larr; LLMOps Database
        </a>
        <a href="/mlops-database" class="text-primary-600 hover:text-primary-700">
          &larr; MLOps Database
        </a>
      </div>
    </header>

    {(commonLLMOpsTags.length > 0 || commonMLOpsTags.length > 0) && (
      <section class="mb-10 grid gap-6 md:grid-cols-2">
        {commonLLMOpsTags.length > 0 && (
          <div>
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-400">
                Common LLMOps tags
              </h2>
              <a
                href="/llmops-tags"
                class="text-xs font-medium text-primary-600 hover:text-primary-700"
              >
                View all &rarr;
              </a>
            </div>
            <div class="mt-3 flex flex-wrap gap-2">
              {commonLLMOpsTags.map((item) => (
                <Badge variant="blue" href={`/llmops-tags/${item.slug}`}>
                  {item.name} ({item.count})
                </Badge>
              ))}
            </div>
          </div>
        )}

        {commonMLOpsTags.length > 0 && (
          <div>
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-400">
                Common MLOps topics
              </h2>
              <a
                href="/mlops-tags"
                class="text-xs font-medium text-primary-600 hover:text-primary-700"
              >
                View all &rarr;
              </a>
            </div>
            <div class="mt-3 flex flex-wrap gap-2">
              {commonMLOpsTags.map((item) => (
                <Badge variant="success" href={`/mlops-tags/${item.slug}`}>
                  {item.name} ({item.count})
                </Badge>
              ))}
            </div>
          </div>
        )}
      </section>
    )}

    {llmopsEntries.length > 0 && (
      <section class={mlopsEntries.length > 0 ? "mb-14" : undefined}>
        <h2 class="mb-6 text-2xl font-bold tracking-tight text-gray-900">LLMOps entries</h2>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {llmopsEntries.map((entry) => (
            <div
              class="group relative flex flex-col rounded-lg border border-gray-200 bg-white p-5 transition-shadow hover:shadow-md"
            >
              <h3 class="text-lg font-semibold text-gray-900 group-hover:text-primary-600">
                <a
                  href={`/llmops-database/${entry.data.slug}`}
                  class="before:absolute before:inset-0 before:content-['']"
                >
                  {entry.data.title}
                </a>
              </h3>
              {entry.data.company && (
                <p class="mt-1 text-sm text-gray-500">{entry.data.company}</p>
              )}
              {entry.data.summary && (
                <p class="mt-2 line-clamp-3 text-sm text-gray-600">{entry.data.summary}</p>
              )}
              <div class="mt-auto flex flex-wrap gap-1.5 pt-4">
                {entry.data.llmopsTags.slice(0, 4).map((tagSlug: string) => (
                  <Badge variant="blue" href={`/llmops-tags/${tagSlug}`} class="relative">{llmopsTagMap[tagSlug] || tagSlug}</Badge>
                ))}
                {entry.data.llmopsTags.length > 4 && (
                  <Badge variant="gray">+{entry.data.llmopsTags.length - 4}</Badge>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    {mlopsEntries.length > 0 && (
      <section>
        <h2 class="mb-6 text-2xl font-bold tracking-tight text-gray-900">MLOps entries</h2>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {mlopsEntries.map((entry) => (
            <div
              class="group relative flex flex-col rounded-lg border border-gray-200 bg-white p-5 transition-shadow hover:shadow-md"
            >
              <h3 class="text-lg font-semibold text-gray-900 group-hover:text-primary-600">
                <a
                  href={`/mlops-database/${entry.data.slug}`}
                  class="before:absolute before:inset-0 before:content-['']"
                >
                  {entry.data.title}
                </a>
              </h3>
              <div class="mt-1 flex flex-wrap items-center gap-2 text-sm text-gray-500">
                <span>{entry.data.company}</span>
                {entry.data.platformName !== entry.data.company && (
                  <>
                    <span aria-hidden="true">&middot;</span>
                    <span>{entry.data.platformName}</span>
                  </>
                )}
                <>
                  <span aria-hidden="true">&middot;</span>
                  <span class="capitalize">{entry.data.contentType}</span>
                </>
              </div>
              <p class="mt-2 line-clamp-3 text-sm text-gray-600">{entry.data.summary}</p>
              <div class="mt-auto flex flex-wrap gap-1.5 pt-4">
                {entry.data.mlopsTags.slice(0, 4).map((tagSlug: string) => (
                  <Badge variant="success" href={`/mlops-tags/${tagSlug}`} class="relative">{mlopsTagMap[tagSlug] || tagSlug}</Badge>
                ))}
                {entry.data.mlopsTags.length > 4 && (
                  <Badge variant="gray">+{entry.data.mlopsTags.length - 4}</Badge>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    {totalEntries === 0 && (
      <p class="text-center text-gray-500">No LLMOps or MLOps entries in this industry yet.</p>
    )}
  </div>
</BaseLayout>
