---
/**
 * Industry tags index page.
 *
 * Lists all industries with combined LLMOps + MLOps entry counts, sorted by popularity.
 * Route: /industry-tags
 */
import { getCollection } from "astro:content";
import PageHeader from "../../components/templates/PageHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { filterUsedTerms } from "../../lib/blog";
import type { TaxonomyCount } from "../../lib/llmops";
import { getAllPublishedEntries, getIndustryTagCounts } from "../../lib/llmops";
import {
  getAllPublishedMLOpsEntries,
  getMLOpsIndustryTagCounts,
} from "../../lib/mlops";

const llmopsEntries = await getAllPublishedEntries();
const mlopsEntries = await getAllPublishedMLOpsEntries();
const llmopsCounts = await getIndustryTagCounts(llmopsEntries);
const mlopsCounts = await getMLOpsIndustryTagCounts(mlopsEntries);
const usedMap = new Map<string, number>();

for (const item of [...llmopsCounts, ...mlopsCounts]) {
  usedMap.set(item.slug, (usedMap.get(item.slug) ?? 0) + item.count);
}

// Merge all taxonomy terms with used counts, then drop zero-count industries
// (#249) — a zero-count industry has no [slug] page to link to any more.
const allIndustries = await getCollection("industry-tags");
const merged: TaxonomyCount[] = allIndustries.map((t) => ({
  slug: t.data.slug,
  name: t.data.name,
  count: usedMap.get(t.data.slug) ?? 0,
}));
const industries = filterUsedTerms(merged).sort(
  (a, b) => b.count - a.count || a.name.localeCompare(b.name),
);
---

<BaseLayout
  title="Industries - ZenML Databases"
  description="Browse all industries represented in the ZenML LLMOps and MLOps databases."
  surface="ml"
>
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <PageHeader
      class="mb-10"
      heading="Industries"
      description={`${industries.length} ${industries.length === 1 ? "industry" : "industries"} across the LLMOps and MLOps databases`}
      backLinks={[
        { href: "/llmops-database", label: "LLMOps Database" },
        { href: "/mlops-database", label: "MLOps Database" },
      ]}
      classOverrides={{
        heading: "text-4xl font-bold tracking-tight text-gray-900",
        description: "text-lg text-gray-600",
        descriptionSpacing: "mt-3",
      }}
    />

    <nav aria-label="All industries">
      <ul class="divide-y divide-gray-200 rounded-lg border border-gray-200 bg-white">
        {industries.map((t) => (
          <li>
            <a
              href={`/industry-tags/${t.slug}`}
              class="flex items-center justify-between px-4 py-3 text-sm hover:bg-gray-50"
            >
              <span class="font-medium text-gray-900">{t.name}</span>
              <span class="text-xs tabular-nums text-gray-400">{t.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</BaseLayout>
