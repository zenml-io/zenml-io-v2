---
/**
 * Blog tags index page (blog cutover, D2d/§6).
 *
 * Lists all blog tags with post counts, sorted by popularity, as
 * `data-display.stacked-list` rows (`skin="labs"`, name + count) under the
 * shared `page-header.with-breadcrumb` term-hub header. Route: /tags
 */
import { getCollection } from "astro:content";
import PageHeader from "../../components/templates/PageHeader.astro";
import { TERM_HUB_HEADER_INTRO } from "../../components/templates/pageHeaderPresets";
import StackedList from "../../components/templates/StackedList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { TaxonomyCount } from "../../lib/blog";
import { getMainFeedPosts, getTagCounts } from "../../lib/blog";
import { filterUsedTerms } from "../../lib/relatedIndex";

// Main-feed posts only: counts must match what the blog itself shows, and
// the internal discovery corpus must not surface on a public hub.
const allPosts = await getMainFeedPosts();
const usedCounts = await getTagCounts(allPosts);
const usedMap = new Map(usedCounts.map((t) => [t.slug, t.count]));

// Merge all taxonomy terms with used counts, then drop zero-count tags
// (#249) — a zero-count tag has no [slug] page to link to any more.
const allTags = await getCollection("tags");
const merged: TaxonomyCount[] = allTags.map((t) => ({
  slug: t.data.slug,
  name: t.data.name,
  count: usedMap.get(t.data.slug) ?? 0,
}));
const tags = filterUsedTerms(merged).sort(
  (a, b) => b.count - a.count || a.name.localeCompare(b.name),
);
---

<BaseLayout
  title="Blog Tags - ZenML"
  description="Browse all tags used on the ZenML blog."
  surface="ml"
  app="labs"
>
  {/* pt-[148px] clears the floating Labs nav (bottom edge 92px mobile /
      108px desktop) with margin to spare — matches LabsBand's "short"
      clearance so every blog-surface breadcrumb starts at the same offset. */}
  <section class="scroll-reveal-section px-gutter pt-[148px] pb-24">
    <div class="mx-auto max-w-content">
      <PageHeader
        breadcrumb={[{ label: "Blog", href: "/blog" }, { label: "Tags" }]}
        breadcrumbSeparator="chevron"
        heading="Tags"
        description={`${tags.length} ${tags.length === 1 ? "tag" : "tags"} on the blog`}
        classOverrides={TERM_HUB_HEADER_INTRO}
      />

      <div class="mt-10 border-t border-(--color-border)">
        <StackedList
          skin="labs"
          items={tags.map((t) => ({
            title: t.name,
            href: `/tags/${t.slug}`,
            trailingCount: t.count,
          }))}
        />
      </div>
    </div>
  </section>
</BaseLayout>
