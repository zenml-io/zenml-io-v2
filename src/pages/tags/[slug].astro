---
/**
 * Blog tag taxonomy page (blog cutover, D2d/§6): the stacked-row arrangement
 * of `term-hub.entry-index` (`skin="labs"`) — tags are the one term family
 * that reads better as a scannable list than a card grid, per Zuri's
 * ruling. Categories and authors use the card grid instead
 * (`term-hub.editorial`, see `category/[slug].astro` / `author/[slug].astro`).
 */
import { getCollection, getEntry } from "astro:content";
import {
  TERM_CHIP,
  TERM_CHIP_HEXAGON_PATH,
  TERM_CHIP_HEXAGON_VIEWBOX,
} from "../../components/blog/termChipStyles";
import { HubPagination } from "../../components/islands/HubPagination";
import BlogNewsletterCta from "../../components/labs/BlogNewsletterCta.astro";
import LabsBand from "../../components/labs/LabsBand.astro";
import Breadcrumb from "../../components/system/Breadcrumb.astro";
import TermHubEntryIndex from "../../components/templates/TermHubEntryIndex.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getMainFeedPosts,
  getTagCounts,
  PAGE_SIZE,
  resolveAuthor,
} from "../../lib/blog";
import { BAND_CONTENT_GAP } from "../../lib/blogLayout";
import { defaultOgUrl, hasDefaultOgCard } from "../../lib/seo";

export async function getStaticPaths() {
  const tags = await getCollection("tags");
  const allPosts = await getCollection("blog", ({ data }) => !data.draft);
  const usedSlugs = new Set(allPosts.flatMap((p) => p.data.tags));
  return tags
    .filter((tag) => usedSlugs.has(tag.data.slug))
    .map((tag) => ({
      params: { slug: tag.data.slug },
      props: { tag },
    }));
}

const { tag } = Astro.props;

const allPosts = (
  await getCollection(
    "blog",
    ({ data }) => !data.draft && data.tags.includes(tag.data.slug),
  )
).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

// Resolve authors and sibling tag names for the row chips
const authorMap = new Map<string, Awaited<ReturnType<typeof resolveAuthor>>>();
const tagNameMap = new Map<string, { name: string; slug: string }>();
for (const post of allPosts) {
  if (post.data.author && !authorMap.has(post.data.author)) {
    const a = await resolveAuthor(post.data.author);
    if (a) authorMap.set(post.data.author, a);
  }
  for (const tSlug of post.data.tags) {
    if (tSlug !== tag.data.slug && !tagNameMap.has(tSlug)) {
      const t = await getEntry("tags", tSlug);
      if (t) tagNameMap.set(tSlug, { name: t.data.name, slug: t.data.slug });
    }
  }
}

// Sibling tags strip: the blog's other popular tags (main-feed counts),
// current tag excluded, capped so the strip stays a strip.
const mainFeedPosts = await getMainFeedPosts();
const popularTags = (await getTagCounts(mainFeedPosts)).filter(
  (t) => t.slug !== tag.data.slug,
);
const SIBLING_LIMIT = 12;
const siblingTags = popularTags
  .sort((a, b) => b.count - a.count)
  .slice(0, SIBLING_LIMIT);
---

<BaseLayout
  ogImage={hasDefaultOgCard("pages", "tags") ? defaultOgUrl("pages", "tags") : undefined}
  title={`Posts tagged "${tag.data.name}" - ZenML Blog`}
  description={`Blog posts tagged with "${tag.data.name}" from the ZenML team.`}
  surface="ml"
  app="labs"
>
  <LabsBand size="short" grain={tag.data.slug === "kitaru" ? "kitaru" : "labs"}>
    <div class="flex flex-col gap-4">
      <Breadcrumb
        items={[
          { label: "Blog", href: "/blog" },
          { label: "Tags", href: "/tags" },
          { label: tag.data.name },
        ]}
        separator="chevron"
      />
      <div>
        <p class="font-sans text-[15px] leading-5 text-(--color-cream-700)">
          Tag
        </p>
        <h1 class="font-display text-[40px] leading-[44px] text-(--color-cream-900) md:text-[64px] md:leading-[70px]">
          {tag.data.name}
        </h1>
        <p class="mt-space-sm max-w-[690px] font-sans text-[17px] leading-[26px] text-foreground md:text-xl md:leading-[30px]">
          {allPosts.length} {allPosts.length === 1 ? "post" : "posts"} with this tag
        </p>
      </div>
    </div>
  </LabsBand>

  <section class:list={["scroll-reveal-section pb-24", BAND_CONTENT_GAP]}>
    <div class="mx-auto max-w-content px-gutter">
      <TermHubEntryIndex
        skin="labs"
        paginate
        id="tag-post-list"
        emptyHeading={`No posts with the "${tag.data.name}" tag yet.`}
        sections={[
          {
            items: allPosts.map((post) => {
              const author = authorMap.get(post.data.author || "");
              const siblingSlugs = post.data.tags.filter(
                (t) => t !== tag.data.slug,
              );
              return {
                title: post.data.title,
                href: `/blog/${post.data.slug}`,
                excerpt: post.data.seo?.description,
                chips: siblingSlugs.slice(0, 3).map((s) => {
                  const t = tagNameMap.get(s);
                  return { label: t?.name ?? s, href: `/tags/${s}` };
                }),
                chipOverflowCount: Math.max(0, siblingSlugs.length - 3),
                trailingLane: {
                  author: author?.name,
                  year: String(new Date(post.data.date).getFullYear()),
                },
              };
            }),
          },
        ]}
      />

      {allPosts.length > PAGE_SIZE && (
        <HubPagination
          client:idle
          containerId="tag-post-list"
          totalItems={allPosts.length}
          pageSize={PAGE_SIZE}
        />
      )}

      {siblingTags.length > 0 && (
        <div class="mt-14 flex flex-col gap-4 border-t border-(--color-border) pt-8">
          <p class="text-[12px] font-medium text-(--color-cream-800)">
            Other tags
          </p>
          <div class="flex flex-wrap items-center gap-2">
            {siblingTags.map((t) => (
              <a href={`/tags/${t.slug}`} class={TERM_CHIP}>
                <svg
                  viewBox={TERM_CHIP_HEXAGON_VIEWBOX}
                  class="h-[14px] w-3 fill-(--color-sage-600)"
                  aria-hidden="true"
                >
                  <path d={TERM_CHIP_HEXAGON_PATH} />
                </svg>
                {t.name}
              </a>
            ))}
            <a
              href="/tags"
              class="ml-1 text-[13px] font-medium text-(--color-sage-700) hover:text-(--color-sage-800)"
            >
              All {popularTags.length + 1} tags →
            </a>
          </div>
        </div>
      )}
    </div>
  </section>

  <BlogNewsletterCta />
</BaseLayout>
