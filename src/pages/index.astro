---
/**
 * Homepage — the main landing page for the ZenML Labs site.
 *
 * Composes the Labs section components into a single page. Each section
 * takes its copy through a `content` prop; this page passes the LABS_*
 * constants from src/lib/labs-home.ts, so another page can mount the same
 * sections with different content.
 *
 * Route: / (homepage)
 */
import { HeroJob } from "../components/islands/HeroJob";
import CustomerStoryCards from "../components/labs/CustomerStoryCards.astro";
import FeatureGridPanels from "../components/labs/FeatureGridPanels.astro";
import LabsCloseCta from "../components/labs/LabsCloseCta.astro";
import LabsHero from "../components/labs/LabsHero.astro";
import LabsValueProps from "../components/labs/LabsValueProps.astro";
import LogoMarquee from "../components/labs/LogoMarquee.astro";
import ProductDoors from "../components/labs/ProductDoors.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildHeroJobProof, buildHeroJobStack } from "../lib/heroJobProof";
import { buildHomepageJsonLd } from "../lib/homepageJsonLd";
import {
  LABS_CLOSE,
  LABS_CONTRAST,
  LABS_DOORS,
  LABS_FEATURE_PANELS,
  LABS_HERO,
  LABS_HERO_JOB,
  LABS_HOME_SEO,
  LABS_LOGO_GRID,
  LABS_STORIES,
} from "../lib/labs-home";
import { getAllPublishedEntries } from "../lib/llmops";
import { getAllPublishedMLOpsEntries } from "../lib/mlops";
import { defaultOgImage, ORGANIZATION_NAME } from "../lib/seo";

// The hero job box's case studies and its "@ add your stack" tools, picked
// here at build time so the island gets a few rows per use case and a ranked
// list of tool ids rather than the research databases.
const heroJobEntries = [
  ...(await getAllPublishedEntries()).map(({ data }) => ({
    source: "llmops" as const,
    slug: data.slug,
    title: data.title,
    company: data.company,
    summary: data.summary,
    year: data.year,
    tags: data.llmopsTags,
  })),
  ...(await getAllPublishedMLOpsEntries()).map(({ data }) => ({
    source: "mlops" as const,
    slug: data.slug,
    title: data.title,
    company: data.company,
    summary: data.summary,
    year: data.year,
    tags: data.mlopsTags,
  })),
];
const heroJobProof = buildHeroJobProof(
  heroJobEntries,
  LABS_HERO_JOB.stack.tools,
);
const heroJobStack = buildHeroJobStack(
  heroJobEntries,
  LABS_HERO_JOB.stack.tools,
);

const homepageJsonLd = buildHomepageJsonLd({
  organizationName: ORGANIZATION_NAME,
  logoPath: "/images/zenml-labs-lockup.svg",
});
---

<BaseLayout
  ogImage={defaultOgImage("pages", "home")}
  app="labs"
  title={LABS_HOME_SEO.title}
  description={LABS_HOME_SEO.description}
  ogTitle={LABS_HOME_SEO.title}
  surface={LABS_HOME_SEO.surface}
>
  <JsonLd data={homepageJsonLd} slot="head" />

  <main>
    <LabsHero content={LABS_HERO} align="center">
      {/* client:load: the hero's one control, above the fold. With the hero
          shader (client:visible) it is the page's second eager island. */}
      <HeroJob
        client:load
        content={LABS_HERO_JOB}
        proof={heroJobProof}
        stack={heroJobStack}
        slot="action"
      />
    </LabsHero>
    <LogoMarquee content={LABS_LOGO_GRID} />
    <ProductDoors content={LABS_DOORS} />
    <FeatureGridPanels content={LABS_FEATURE_PANELS} />
    <LabsValueProps content={LABS_CONTRAST} />
    <CustomerStoryCards content={LABS_STORIES} />
    <LabsCloseCta content={LABS_CLOSE} />
  </main>
</BaseLayout>
