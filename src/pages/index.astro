---
/**
 * Homepage — the main landing page for the ZenML Labs site, telling the
 * paid product's story: the AI engineer that reads an agent's traces next
 * to its evals and shows what they miss. The open-source products sit
 * underneath (the product doors) and have their own pages.
 *
 * Composes the Labs section components into a single page. Each section
 * takes its copy through a `content` prop; this page passes the LABS_*
 * constants from src/lib/labs-home.ts, so another page can mount the same
 * sections with different content.
 *
 * Route: / (homepage)
 */
import LabsCloseCta from "../components/labs/LabsCloseCta.astro";
import LabsGapReportVisual from "../components/labs/LabsGapReportVisual.astro";
import LabsHero from "../components/labs/LabsHero.astro";
import LabsOnboardingSteps from "../components/labs/LabsOnboardingSteps.astro";
import LabsPriceStrip from "../components/labs/LabsPriceStrip.astro";
import LabsStackLayer from "../components/labs/LabsStackLayer.astro";
import LogoMarquee from "../components/labs/LogoMarquee.astro";
import ProductDoors from "../components/labs/ProductDoors.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildHomepageJsonLd } from "../lib/homepageJsonLd";
import {
  LABS_DOORS,
  LABS_GAP_REPORT,
  LABS_HERO,
  LABS_HOME_CLOSE,
  LABS_HOME_SEO,
  LABS_LOGO_GRID,
  LABS_ONBOARDING,
  LABS_STACK_LAYER,
} from "../lib/labs-home";
import { priceStrip } from "../lib/pricing";
import { defaultOgImage, ORGANIZATION_NAME } from "../lib/seo";

const homepageJsonLd = buildHomepageJsonLd({
  organizationName: ORGANIZATION_NAME,
  logoPath: "/images/zenml-labs-lockup.svg",
});
---

<BaseLayout
  ogImage={defaultOgImage("pages", "home")}
  app="labs"
  title={LABS_HOME_SEO.title}
  description={LABS_HOME_SEO.description}
  ogTitle={LABS_HOME_SEO.title}
  surface={LABS_HOME_SEO.surface}
>
  <JsonLd data={homepageJsonLd} slot="head" />

  <main>
    <LabsHero content={LABS_HERO}>
      <LabsGapReportVisual slot="visual" content={LABS_GAP_REPORT} />
    </LabsHero>
    <LabsOnboardingSteps content={LABS_ONBOARDING} />
    <LabsStackLayer content={LABS_STACK_LAYER} />
    <LogoMarquee content={LABS_LOGO_GRID} />
    <ProductDoors content={LABS_DOORS} />
    <LabsPriceStrip content={priceStrip("Home")} />
    <LabsCloseCta content={LABS_HOME_CLOSE} />
  </main>
</BaseLayout>

<script>
  import { initScrollReveal } from "../scripts/labs-scroll-reveal";
  initScrollReveal();
</script>
