{
  "name": "kitaru-dark",
  "type": "dark",
  "settings": [],
  "colors": {
    "editor.background": "#17120E",
    "editor.foreground": "#FFF7EC"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#B7AAA0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#7EE2A3"
      }
    },
    {
      "name": "String Escape",
      "scope": ["constant.character.escape"],
      "settings": {
        "foreground": "#7EE2A3"
      }
    },
    {
      "name": "F-string expressions",
      "scope": [
        "meta.fstring",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#FF9F5A"
      }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#FF9F5A"
      }
    },
    {
      "name": "Built-in Constants (True, False, None)",
      "scope": ["constant.language"],
      "settings": {
        "foreground": "#7EE2A3"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#FFD38A"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#FFB36B"
      }
    },
    {
      "name": "Classes & Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#FFD38A"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "punctuation.definition.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#FFB36B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "punctuation.definition.parameters",
        "punctuation.separator",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#D9C9BC"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other",
        "meta.function.parameters"
      ],
      "settings": {
        "foreground": "#FFF7EC"
      }
    },
    {
      "name": "Properties & Attributes",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#F2E3D4"
      }
    },
    {
      "name": "Built-in & Self",
      "scope": [
        "variable.language",
        "variable.language.self",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#7EE2A3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Imports & Modules",
      "scope": [
        "keyword.control.import",
        "keyword.control.from",
        "keyword.other.import"
      ],
      "settings": {
        "foreground": "#FFD38A"
      }
    },
    {
      "name": "Module Names",
      "scope": [
        "entity.name.import",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#7EE2A3"
      }
    },
    {
      "name": "Type Annotations",
      "scope": [
        "meta.function.return-type",
        "punctuation.definition.type",
        "support.type.python"
      ],
      "settings": {
        "foreground": "#7EE2A3"
      }
    }
  ]
}
