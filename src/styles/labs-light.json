{
  "name": "labs-light",
  "type": "dark",
  "colors": {
    "editor.background": "#413D37",
    "editor.foreground": "#F5F7F4"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#AC947F",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.trycatch",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#BECAA6"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#DBE0C2"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "entity.name.function.python",
        "meta.function-call.generic.python"
      ],
      "settings": {
        "foreground": "#47BAD1"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.arithmetic",
        "keyword.operator.logical",
        "punctuation.separator",
        "punctuation.accessor",
        "meta.decorator",
        "punctuation.definition.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#47BAD1"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "variable.other.property",
        "variable.other.object.property",
        "variable.language",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#E0CFB7"
      }
    },
    {
      "scope": ["constant.numeric", "constant.character", "constant.other"],
      "settings": {
        "foreground": "#E0CFB7"
      }
    },
    {
      "scope": ["variable", "variable.other", "entity.name.tag", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#F5F7F4"
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#E0CFB7"
      }
    },
    {
      "scope": ["punctuation", "meta.brace", "punctuation.definition.block"],
      "settings": {
        "foreground": "#F5F7F4"
      }
    }
  ]
}
