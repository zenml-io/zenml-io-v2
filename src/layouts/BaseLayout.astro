---
import PlausibleBridge from "../components/analytics/PlausibleBridge.astro";
import SiteHeaderScripts from "../components/analytics/SiteHeaderScripts.astro";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/islands/CookieConsent.tsx";
import LabsFooter from "../components/labs/LabsFooter.astro";
import LabsNavigation from "../components/labs/LabsNavigation.astro";
import Navigation from "../components/Navigation.astro";
/**
 * BaseLayout — the root HTML shell for every page.
 * Renders <head> with full SEO meta, plus Navigation and Footer chrome.
 *
 * All page templates (ContentLayout, BlogLayout, etc.) wrap this layout
 * and pass SEOProps through to control their meta tags.
 */
import type { Surface } from "../lib/analytics";
import type { LabsProduct } from "../lib/labs-home";
import { resolveSeo, type SEOProps } from "../lib/seo";
import "../styles/global.css";

interface Props extends SEOProps {
  /** Additional classes on <body> */
  bodyClass?: string;
  /**
   * Analytics surface — drives Plausible `surface` prop + Segment page event.
   * Required: every page template must pass an explicit value. Do not omit —
   * "ml" is not a safe default because it silently misattributes cross-product
   * traffic (company pages, demo flows, etc.) to the ZenML surface.
   * Taxonomy: "ml" | "agent" | "unified" (see src/lib/analytics.ts).
   */
  surface: Surface;
  /**
   * Brand scope. "labs" mounts the ZenML Labs rebrand scope
   * (`<html data-app="labs">`, tokens in global.css) AND swaps the chrome to
   * the Labs shell (LabsNavigation + LabsFooter) — tokens and chrome always
   * travel together. Default keeps every existing page on the current ZenML
   * tokens with Navigation/Footer.
   */
  app?: "zenml" | "labs";
  /**
   * Which product a Labs-shell page belongs to. The Labs nav shows that
   * product's wordmark after the company lockup, marks it current in the
   * product switcher and points its signup pill at that product's app.
   * Omit on the homepage and other cross-product pages. Only read when
   * `app="labs"`.
   */
  product?: LabsProduct;
}

const { bodyClass, surface, app = "zenml", product, ...seoProps } = Astro.props;
const labsShell = app === "labs";
const seo = resolveSeo(seoProps, Astro.url.pathname);
---

<!doctype html>
<html lang="en" data-app={app} data-surface={surface}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/* Core SEO */}
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    {seo.noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={seo.ogTitle} />
    <meta property="og:description" content={seo.ogDescription} />
    <meta property="og:url" content={seo.canonical} />
    {seo.ogImage && <meta property="og:image" content={seo.ogImage} />}

    {/* Twitter Card */}
    <meta name="twitter:card" content={seo.twitterCard} />
    <meta name="twitter:title" content={seo.ogTitle} />
    <meta name="twitter:description" content={seo.ogDescription} />
    {seo.ogImage && <meta name="twitter:image" content={seo.ogImage} />}

    {/* Favicon & manifest */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Structured data (JSON-LD) — injected by child layouts */}
    <slot name="head" />

    <SiteHeaderScripts surface={surface} />
  </head>
  <body class:list={["min-h-screen bg-white text-gray-900 antialiased", bodyClass]}>
    <slot name="before-nav" />
    {labsShell ? (
      <LabsNavigation currentPath={Astro.url.pathname} product={product} />
    ) : (
      <Navigation currentPath={Astro.url.pathname} surface={surface} />
    )}
    <slot />
    {labsShell ? <LabsFooter /> : <Footer />}

    <script is:inline>
      (async () => {
        const starElements = document.querySelectorAll("[data-github-stars-count]");
        if (!starElements.length) return;

        // Group elements by repo (default zenml) so each repo is fetched once.
        const byRepo = new Map();
        starElements.forEach((element) => {
          const repo = element.getAttribute("data-github-stars-repo") || "zenml";
          if (!byRepo.has(repo)) byRepo.set(repo, []);
          byRepo.get(repo).push(element);
        });

        await Promise.all(
          Array.from(byRepo.entries()).map(async ([repo, elements]) => {
            try {
              const url =
                repo === "zenml"
                  ? "/api/github-stars"
                  : "/api/github-stars?repo=" + encodeURIComponent(repo);
              const response = await fetch(url, {
                headers: { Accept: "application/json" },
              });
              if (!response.ok) return;

              const data = await response.json();
              if (!data || typeof data.formatted !== "string") return;

              elements.forEach((element) => {
                element.textContent = data.formatted;
              });
            } catch {
              // Keep server-rendered fallback visible on any failure.
            }
          }),
        );
      })();
    </script>

    <PlausibleBridge />
    <CookieConsent client:load />
  </body>
</html>
