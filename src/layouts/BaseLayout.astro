---
import PlausibleBridge from "../components/analytics/PlausibleBridge.astro";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/islands/CookieConsent.tsx";
import Navigation from "../components/Navigation.astro";
/**
 * BaseLayout — the root HTML shell for every page.
 * Renders <head> with full SEO meta, plus Navigation and Footer chrome.
 *
 * All page templates (ContentLayout, BlogLayout, etc.) wrap this layout
 * and pass SEOProps through to control their meta tags.
 */
import type { Surface } from "../lib/analytics";
import { resolveSeo, type SEOProps } from "../lib/seo";
import "../styles/global.css";

interface Props extends SEOProps {
  /** Additional classes on <body> */
  bodyClass?: string;
  /**
   * Analytics surface — drives Plausible `surface` prop + Segment page event.
   * Required: every page template must pass an explicit value. Do not omit —
   * "ml" is not a safe default because it silently misattributes cross-product
   * traffic (company pages, demo flows, etc.) to the ZenML surface.
   * Taxonomy: "ml" | "agent" | "unified" (see src/lib/analytics.ts).
   */
  surface: Surface;
}

const { bodyClass, surface, ...seoProps } = Astro.props;
const seo = resolveSeo(seoProps, Astro.url.pathname);
---

<!doctype html>
<html lang="en" data-app="zenml" data-surface={surface}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/* Core SEO */}
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    {seo.noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={seo.ogTitle} />
    <meta property="og:description" content={seo.ogDescription} />
    <meta property="og:url" content={seo.canonical} />
    {seo.ogImage && <meta property="og:image" content={seo.ogImage} />}

    {/* Twitter Card */}
    <meta name="twitter:card" content={seo.twitterCard} />
    <meta name="twitter:title" content={seo.ogTitle} />
    <meta name="twitter:description" content={seo.ogDescription} />
    {seo.ogImage && <meta name="twitter:image" content={seo.ogImage} />}

    {/* Favicon & manifest */}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Structured data (JSON-LD) — injected by child layouts */}
    <slot name="head" />

    {/* Plausible — cookieless, GDPR-compliant analytics. Loaded directly
        (not gated behind cookie consent) since it doesn't use cookies or
        track personal data. Hostname-gated to prevent preview deploy noise.
        Uses `script.pageview-props.js` + `event-surface` so every pageview
        carries the `surface` custom prop (D3). */}
    <script is:inline define:vars={{ surface }}>
      if (["www.zenml.io","zenml.io"].includes(window.location.hostname)) {
        var s = document.createElement("script");
        s.defer = true;
        s.setAttribute("data-domain", "zenml.io");
        s.setAttribute("event-surface", surface);
        s.src = "https://plausible.io/js/script.pageview-props.js";
        document.head.appendChild(s);
      }
    </script>

    {/* RB2B — visitor identification for B2B lead gen. Loaded directly
        (not gated behind cookie consent) to match original Webflow behavior.
        Hostname-gated to prevent preview deploy noise. */}
    <script is:inline>
      if (["www.zenml.io","zenml.io"].includes(window.location.hostname)) {
        !function(){var reb2b=window.reb2b=window.reb2b||[];if(reb2b.invoked)return;reb2b.invoked=true;reb2b.methods=["identify","collect"];reb2b.factory=function(method){return function(){var args=Array.prototype.slice.call(arguments);args.unshift(method);reb2b.push(args);return reb2b}};for(var i=0;i<reb2b.methods.length;i++){var key=reb2b.methods[i];reb2b[key]=reb2b.factory(key)}reb2b.load=function(key){var script=document.createElement("script");script.type="text/javascript";script.async=true;script.src="https://s3-us-west-2.amazonaws.com/b2bjsstore/b/"+key+"/Z6PVLHP07Q6R.js.gz";var first=document.getElementsByTagName("script")[0];first.parentNode.insertBefore(script,first)};reb2b.SNIPPET_VERSION="1.0.1";reb2b.load("Z6PVLHP07Q6R")}();
      }
    </script>

    {/* Bullseye Pixel — hostname-gated to prevent preview deploy noise. */}
    <script is:inline>
      if (["www.zenml.io","zenml.io"].includes(window.location.hostname)) {
        var bullseye = document.createElement("script");
        bullseye.async = true;
        bullseye.defer = true;
        bullseye.src = "https://script.bullseye.so/script/dbbc38f8-20c2-42a6-9587-b4365cd23b62";
        bullseye.referrerPolicy = "strict-origin-when-cross-origin";
        bullseye.setAttribute("data-bullseye-pixel", "dbbc38f8-20c2-42a6-9587-b4365cd23b62");
        document.head.appendChild(bullseye);
      }
    </script>

    {/* Scarf — cookieless company-level analytics pixel. Tracks page views
        via a transparent 1x1 image with IP-based company attribution.
        No cookies or JS execution. Hostname-gated to prevent preview noise. */}
    <script is:inline>
      if (["www.zenml.io","zenml.io"].includes(window.location.hostname)) {
        var img = document.createElement("img");
        img.src = "https://static.scarf.sh/a.png?x-pxid=af73c4bc-4298-4759-a03c-378b9a1ef1ba";
        img.referrerPolicy = "no-referrer-when-downgrade";
        img.width = 1;
        img.height = 1;
        img.alt = "";
        img.setAttribute("aria-hidden", "true");
        img.style.position = "absolute";
        img.style.left = "-9999px";
        document.body.appendChild(img);
      }
    </script>

    {/* Other analytics (GA4, Segment, etc.) and third-party scripts are
        injected dynamically by the CookieConsent island after user consent.
        See src/lib/consentConfig.ts for the full script registry. */}
  </head>
  <body class:list={["min-h-screen bg-white text-gray-900 antialiased", bodyClass]}>
    <slot name="before-nav" />
    <Navigation currentPath={Astro.url.pathname} />
    <slot />
    <Footer />

    <script is:inline>
      (async () => {
        const starElements = document.querySelectorAll("[data-github-stars-count]");
        if (!starElements.length) return;

        // Group elements by repo (default zenml) so each repo is fetched once.
        const byRepo = new Map();
        starElements.forEach((element) => {
          const repo = element.getAttribute("data-github-stars-repo") || "zenml";
          if (!byRepo.has(repo)) byRepo.set(repo, []);
          byRepo.get(repo).push(element);
        });

        await Promise.all(
          Array.from(byRepo.entries()).map(async ([repo, elements]) => {
            try {
              const url =
                repo === "zenml"
                  ? "/api/github-stars"
                  : "/api/github-stars?repo=" + encodeURIComponent(repo);
              const response = await fetch(url, {
                headers: { Accept: "application/json" },
              });
              if (!response.ok) return;

              const data = await response.json();
              if (!data || typeof data.formatted !== "string") return;

              elements.forEach((element) => {
                element.textContent = data.formatted;
              });
            } catch {
              // Keep server-rendered fallback visible on any failure.
            }
          }),
        );
      })();
    </script>

    <PlausibleBridge />
    <CookieConsent client:load />
  </body>
</html>
