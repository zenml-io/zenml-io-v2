---
import type { Surface } from "../lib/analytics";
import type { LabsProduct } from "../lib/labs-home";
import type { SEOProps } from "../lib/seo";
/**
 * ContentLayout — the Labs prose layout for the legal pages, `/imprint` and
 * `/contact`.
 *
 * Opens on a short `LabsBand` whose slot carries the page's h1 (and an
 * optional deck) — the band carries the h1, so page bodies never render
 * their own. Below the band, a centered `.prose` column at the blog reading
 * measure (`max-w-3xl`) renders the page's own content through the default
 * slot.
 */
import BaseLayout from "./BaseLayout.astro";
import LabsBand from "../components/labs/LabsBand.astro";
import { BAND_CONTENT_GAP } from "../lib/blogLayout";

interface Props extends SEOProps {
  heading: string;
  deck?: string;
  product?: LabsProduct;
  surface?: Surface;
  /** Additional classes on the content wrapper below the band */
  class?: string;
}

const {
  heading,
  deck,
  product,
  class: className,
  surface = "ml",
  ...seoProps
} = Astro.props;
---

<BaseLayout {...seoProps} surface={surface} product={product} app="labs">
  <main>
    <LabsBand size="short">
      <div class="max-w-3xl">
        <h1 class="font-display text-[44px] leading-[48px] text-foreground md:text-[72px] md:leading-[78px]">
          {heading}
        </h1>
        {deck && (
          <p class="mt-6 max-w-2xl font-sans text-xl leading-[30px] text-(--color-cream-700)">
            {deck}
          </p>
        )}
      </div>
    </LabsBand>
    <div class:list={["mx-auto max-w-3xl px-gutter pb-space-xl md:pb-space-xxl", BAND_CONTENT_GAP, className]}>
      <article class="prose">
        <slot />
      </article>
    </div>
  </main>
</BaseLayout>
