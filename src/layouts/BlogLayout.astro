---
import Image from "../components/Image.astro";
import BlogNewsletterCta from "../components/labs/BlogNewsletterCta.astro";
import {
  BLOG_CARD_PRODUCT_PILL,
  BLOG_CARD_PRODUCT_PILL_LINK,
} from "../components/labs/blogCardStyles";
import LabsArticleBody from "../components/labs/LabsArticleBody.astro";
import LabsBand from "../components/labs/LabsBand.astro";
import LabsRelatedBand from "../components/labs/LabsRelatedBand.astro";
import StickyBreadcrumb from "../components/labs/StickyBreadcrumb.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import type { BreadcrumbItem } from "../components/system/Breadcrumb.astro";
import type { RelatedRailItem } from "../components/templates/RelatedRail.astro";
import type { Surface } from "../lib/analytics";
import type { BlogProduct } from "../lib/blog";
import { ARTICLE_TITLE_CLASS, blogLaneStyle } from "../lib/blogLayout";
import { SITE_URL } from "../lib/constants";
import type { SEOProps } from "../lib/seo";
import "../styles/blog-image-lightbox.css";
/**
 * BlogLayout — chrome for blog post detail pages, in the ZenML Labs shell
 * (`app="labs"`, `surface="ml"` — D3). Never passes BaseLayout's own
 * `product` (the Labs nav product switcher) — blog posts aren't a
 * `/product/*` page. This layout's own `product` prop (below) is a
 * different thing: the post's ZenML/Kitaru product line, which colours the
 * masthead pill, category link, tag chips, TOC, prose links, and the
 * Continue-reading band.
 *
 * Section order (the approved blog design, DESIGN.md): masthead → hero → article body
 * (prose + TOC rail) → tags → author card → prev/next → Continue reading.
 * No reading-progress bar, sidebar CTA, full-width CTA band or sticky
 * category bar — the approved design carries none of them.
 */
import BaseLayout from "./BaseLayout.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Author {
  name: string;
  slug: string;
  avatar?: { url: string; alt?: string; width?: number; height?: number };
  bio?: string;
}

interface PrevNextLink {
  title: string;
  href: string;
}

interface RelatedPost {
  href: string;
  title: string;
  excerpt?: string;
  image?: { url: string; alt?: string; width?: number; height?: number };
  authorName?: string;
  authorSlug?: string;
  readingTime?: string;
  categoryName?: string;
  categorySlug?: string;
  date?: Date;
  /** When "kitaru", the Continue-reading card badges itself orange + "Kitaru" regardless of this page's own product. */
  product?: BlogProduct;
}

interface Tag {
  name: string;
  slug: string;
}

interface Props extends SEOProps {
  /**
   * Analytics surface — forwarded to BaseLayout. Blog posts are ZenML-origin
   * content; defaults to "ml". Future Kitaru blog posts may override this.
   */
  surface?: Surface;
  /** Display title (shown as h1 — may differ from SEO title) */
  postTitle?: string;
  /** Subtitle/excerpt shown under the title */
  dek?: string;
  /** Post date (ISO string or Date) */
  date: Date;
  /** Author data (resolved from collection) */
  author?: Author;
  /** Category name */
  category?: string;
  /** Category slug (for linking) */
  categorySlug?: string;
  /** Reading time string (e.g. "5 min read") */
  readingTime?: string;
  /** Cover image — Article JSON-LD only; never rendered in the post. */
  mainImage?: { url: string; alt?: string; width?: number; height?: number };
  /** Opt-in in-page figure under the masthead (frontmatter `featuredImage`). */
  featuredImage?: {
    url: string;
    alt?: string;
    width?: number;
    height?: number;
  };
  /** Headings extracted from markdown for TOC */
  headings?: Heading[];
  /** Tags (resolved from collection) — rendered as the hexagon chip row */
  tags?: Tag[];
  /** Previous post link */
  prev?: PrevNextLink;
  /** Next post link */
  next?: PrevNextLink;
  /** Related posts for "Continue Reading" */
  relatedPosts?: RelatedPost[];
  /**
   * The post's own product (`getBlogProduct` in lib/blog.ts). Sets
   * `data-product="kitaru"` on the page wrapper, which re-points every
   * `--blog-accent-*` consumer nested inside it (category link, tag chips,
   * TOC active marker, prose links, the Continue-reading band + its cards'
   * default halo) to the orange ramp, and shows the "Kitaru" pill in the
   * meta row. Omit or "zenml" for the default (sage, no pill).
   */
  product?: BlogProduct;
}

const {
  postTitle,
  dek,
  date,
  author,
  category,
  categorySlug,
  readingTime,
  mainImage,
  featuredImage,
  headings = [],
  tags = [],
  prev,
  next,
  relatedPosts = [],
  surface = "ml",
  product = "zenml",
  ...seoProps
} = Astro.props;

// Display title: prefer postTitle (the actual post title), fall back to SEO title
const displayTitle = postTitle || seoProps.title;
const isKitaru = product === "kitaru";
// When the post's category IS "kitaru", the pill and the category token
// would both read "Kitaru" — the pill doubles as the category link instead
// (dedupe) and the separate category token is omitted.
const categoryIsKitaruPill = isKitaru && categorySlug === "kitaru";
const showCategoryToken = !!category && !categoryIsKitaruPill;

const relatedRailItems: RelatedRailItem[] = relatedPosts.map((rp) => {
  const rpIsKitaru = rp.product === "kitaru";
  return {
    kind: "hex-card",
    href: rp.href,
    title: rp.title,
    meta: rp.date
      ? new Date(rp.date).toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })
      : undefined,
    // Kind label only — the Continue-reading band stays sage everywhere
    // (ruling: no orange in this block), so a Kitaru related post is
    // still labelled "Kitaru" but its card renders identically to any
    // other card here.
    kindLabel: rpIsKitaru ? "Kitaru" : rp.categoryName,
  };
});

const formattedDate = new Date(date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

// Meta-row tokens in display order (date, reading time, category) — the
// band moved the author byline into its own row below the h1, so it is no
// longer one of these tokens. A leading dot precedes every token after the
// first one actually rendered (absent tokens collapse along with their own
// dot, never leaving an orphaned separator).
const metaTokensPresent = [true, !!readingTime, showCategoryToken];
const metaTokenIndex = (i: number) =>
  metaTokensPresent.slice(0, i).filter(Boolean).length;

// Breadcrumb — one prop list drives both the visible crumb trail and its
// BreadcrumbList JSON-LD (#248).
const breadcrumbItems: BreadcrumbItem[] = [
  { label: "Blog", href: "/blog" },
  ...(category
    ? [
        {
          label: category,
          href: categorySlug ? `/category/${categorySlug}` : undefined,
        },
      ]
    : []),
  { label: displayTitle },
];

// Article JSON-LD — shape unchanged from the pre-cutover layout (D10:
// publisher stays "ZenML" until #322).
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: displayTitle,
  datePublished: new Date(date).toISOString(),
  ...(author && { author: { "@type": "Person", name: author.name } }),
  publisher: { "@type": "Organization", name: "ZenML", url: SITE_URL },
  ...(mainImage && { image: mainImage.url }),
  ...(seoProps.description && { description: seoProps.description }),
};
---

<BaseLayout {...seoProps} surface={surface} app="labs">
  <JsonLd data={articleJsonLd} slot="head" />

  <div style={blogLaneStyle()} data-product={isKitaru ? "kitaru" : undefined}>

  {/* Masthead: shader band, meta row → h1 → dek → author row. The
      breadcrumb used to open this band; it now lives in plain flow at the
      start of the post body (see below), lined up with the article's own
      left edge rather than the band's copy. */}
  <LabsBand size="short" grain={isKitaru ? "kitaru" : "labs"}>
    <div class="scroll-reveal-section">
      <div class="mx-auto flex max-w-(--article-lane) flex-col gap-4">
        <div class="reveal-child flex flex-wrap items-center gap-x-3 gap-y-1">
          {isKitaru &&
            (categoryIsKitaruPill ? (
              <a href="/category/kitaru" class={BLOG_CARD_PRODUCT_PILL_LINK}>
                Kitaru
              </a>
            ) : (
              <span class={BLOG_CARD_PRODUCT_PILL}>Kitaru</span>
            ))}

          <time
            datetime={new Date(date).toISOString()}
            class="text-[14px] text-(--color-cream-700)"
          >
            {formattedDate}
          </time>

          {readingTime && (
            <span class="flex items-center gap-3">
              {metaTokenIndex(1) > 0 && (
                <span class="text-[14px] text-(--color-cream-500)" aria-hidden="true">&middot;</span>
              )}
              <span class="text-[14px] text-(--color-cream-700)">{readingTime}</span>
            </span>
          )}

          {showCategoryToken && (
            <span class="flex items-center gap-3">
              {metaTokenIndex(2) > 0 && (
                <span class="text-[14px] text-(--color-cream-500)" aria-hidden="true">&middot;</span>
              )}
              {categorySlug ? (
                <a
                  href={`/category/${categorySlug}`}
                  class="text-[13px] font-medium text-(--blog-accent-700) hover:text-(--blog-accent-800)"
                >
                  {category}
                </a>
              ) : (
                <span class="text-[13px] font-medium text-(--blog-accent-700)">
                  {category}
                </span>
              )}
            </span>
          )}
        </div>

        <h1 class:list={["reveal-child stagger-1", ARTICLE_TITLE_CLASS]}>
          {displayTitle}
        </h1>

        {dek && (
          <p class="reveal-child stagger-2 line-clamp-2 max-w-[720px] text-[18px] leading-[27px] text-(--color-cream-700)">
            {dek}
          </p>
        )}

        {author && (
          <div class="reveal-child stagger-2 pt-2">
            <span class="flex items-center gap-2">
              {author.avatar && (
                <Image
                  image={author.avatar}
                  alt={author.name}
                  class="h-7 w-7 rounded-full border border-(--color-border) object-cover"
                  loading="eager"
                />
              )}
              <a
                href={`/author/${author.slug}`}
                class="font-sans text-[14px] leading-4 font-medium text-(--color-cream-800) hover:text-(--color-sage-800)"
              >
                {author.name}
              </a>
            </span>
          </div>
        )}
      </div>
    </div>
  </LabsBand>

  {/* Sticky region for the breadcrumb: this classless wrapper's content box
      is what the crumb's `lg:sticky` below measures against, so the crumb
      releases as soon as the article body (the last child here) ends,
      instead of dragging through tags/author/prev-next/related rail like it
      did when it shared the page-wide wrapper above. The article section
      uses `mb-24` rather than `pb-24` for the same reason: a margin isn't
      part of this wrapper's content box, so the trailing space doesn't
      extend the sticky region either — visually the gap before the tag
      chips is unchanged, since margin still occupies layout the same way
      padding did. */}
  <div>

  {/* Breadcrumb — the first element of the post body; the row itself, its
      sticky offsets and its desktop fade live in StickyBreadcrumb.astro
      (shared with the database entry layout). See the wrapper comment above
      for why the sticky region is bounded to the article. */}
  <StickyBreadcrumb items={breadcrumbItems} pagefindIgnore />

  {/* Featured image — 16:9, opt-in via frontmatter `featuredImage` (the
      cover `mainImage` is never rendered here). It follows the breadcrumb
      (content, not the band directly), so it takes the same pt-6
      content-to-content rhythm the article body below it uses. */}
  {featuredImage && (
    <section class="scroll-reveal-section pt-6">
      <div class="mx-auto max-w-content px-gutter">
        <div class="mx-auto max-w-(--article-lane)">
          <div class="reveal-child overflow-hidden rounded-[6px] border border-(--color-border)">
            <Image
              image={featuredImage}
              alt={featuredImage.alt || displayTitle}
              class="blog-hero-zoomable aspect-video w-full object-cover"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>
  )}

  {/* Article body: prose column + sticky TOC rail, in
      LabsArticleBody.astro (shared with the database entry layout). It ends
      in `mb-24` rather than `pb-24` so its border box — and with it this
      wrapper's content box — ends where the article does; see the wrapper
      comment above. */}
  <LabsArticleBody headings={headings} proseClass="prose-zoomable">
    <slot />
  </LabsArticleBody>

  </div>

  {/* Tag chips (optional, collapses) */}
  {tags.length > 0 && (
    <section class="scroll-reveal-section">
      <div class="mx-auto max-w-content px-gutter">
        <div class="mx-auto flex max-w-(--article-lane) flex-col gap-4 border-t border-(--color-border) pt-8 pb-8">
          <p class="reveal-child text-[13px] text-(--color-cream-700)">Tags</p>
          <div class="reveal-child stagger-1 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <a
                href={`/tags/${tag.slug}`}
                class="tag-chip inline-flex h-9 cursor-pointer items-center gap-2 rounded-full border border-(--color-border) px-3.5 transition-colors duration-200 ease-out hover:border-(--blog-accent-400)"
              >
                <svg viewBox="0 0 12 13.86" class="h-[14px] w-3 fill-(--color-sage-600)" aria-hidden="true">
                  <path d="M5 0.58 A2 2 0 0 1 7 0.58 L11 2.89 A2 2 0 0 1 12 4.62 L12 9.24 A2 2 0 0 1 11 10.97 L7 13.28 A2 2 0 0 1 5 13.28 L1 10.97 A2 2 0 0 1 0 9.24 L0 4.62 A2 2 0 0 1 1 2.89 Z"></path>
                </svg>
                <span class="text-[13px] font-medium text-(--color-cream-700)">
                  {tag.name}
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  {/* Author card (optional, collapses) */}
  {author && (
    <section class="scroll-reveal-section">
      <div class="mx-auto max-w-content px-gutter">
        <div class="mx-auto max-w-(--article-lane) pt-10 pb-4">
          <a
            href={`/author/${author.slug}`}
            class="reveal-child group flex cursor-pointer items-center gap-5 rounded-[6px] border border-(--color-border) bg-(--color-card) p-6 transition-colors duration-200 ease-out hover:border-(--color-sage-400)"
          >
            {author.avatar ? (
              <Image
                image={author.avatar}
                alt={author.name}
                class="h-14 w-14 shrink-0 rounded-full object-cover"
              />
            ) : (
              <span class="h-14 w-14 shrink-0 rounded-full bg-(--color-cream-200)" aria-hidden="true"></span>
            )}
            <div>
              <p class="font-display text-[18px] leading-6 text-(--color-cream-800)">{author.name}</p>
              {author.bio ? (
                <p class="mt-0.5 font-sans text-[14px] leading-[22px] font-medium text-(--color-sage-700)">
                  {author.bio}
                </p>
              ) : (
                <p class="mt-0.5 font-sans text-[14px] leading-[22px] font-medium text-(--color-sage-700)">
                  View all posts &rarr;
                </p>
              )}
            </div>
          </a>
        </div>
      </div>
    </section>
  )}

  {/* Prev / Next — either side may be absent; a single side renders one full-width card */}
  {(prev || next) && (
    <section class="scroll-reveal-section">
      <div class="mx-auto max-w-content px-gutter">
        <div
          class:list={[
            "mx-auto grid max-w-(--article-lane) gap-6 pt-6 pb-4",
            prev && next ? "sm:grid-cols-2" : "grid-cols-1",
          ]}
        >
          {prev && (
            <a
              href={prev.href}
              class="reveal-child group flex cursor-pointer flex-col gap-2.5 rounded-[6px] border border-(--color-border) py-5 px-[22px] transition-colors duration-200 ease-out hover:border-(--color-sage-400)"
            >
              <span class="text-[12px] font-medium text-(--color-cream-700)">&larr; Previous</span>
              <span class="font-display line-clamp-2 text-[17px] leading-6 text-(--color-cream-800)">{prev.title}</span>
            </a>
          )}
          {next && (
            <a
              href={next.href}
              class="reveal-child stagger-1 group flex cursor-pointer flex-col gap-2.5 rounded-[6px] border border-(--color-border) py-5 px-[22px] transition-colors duration-200 ease-out hover:border-(--color-sage-400)"
            >
              <span class="text-[12px] font-medium text-(--color-cream-700)">Next &rarr;</span>
              <span class="font-display line-clamp-2 text-[17px] leading-6 text-(--color-cream-800)">{next.title}</span>
            </a>
          )}
        </div>
      </div>
    </section>
  )}

  {/* Continue reading — the shared sage related band (LabsRelatedBand.astro);
      it collapses when there is nothing to show. */}
  <LabsRelatedBand heading="Continue reading" items={relatedRailItems} />

  <BlogNewsletterCta />
  </div>
</BaseLayout>

<style>
  /* House scroll-reveal pattern (reference: FeatureTabs.astro): a
   * `.scroll-reveal-section` is observed once; its `.reveal-child`
   * elements slide 12px + fade with a 60ms stagger. The hidden start state
   * applies only once the script has armed the section (`reveal-armed`), so
   * the server-rendered page is fully visible without JS, and reduced
   * motion never hides anything. The article body itself is never a
   * reveal child — prose must not depend on an observer firing. */
  .reveal-child {
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }
  .stagger-1 { transition-delay: 60ms; }
  .stagger-2 { transition-delay: 120ms; }
  .stagger-3 { transition-delay: 180ms; }

  .scroll-reveal-section.reveal-armed:not(.in-view) .reveal-child {
    opacity: 0;
    transform: translateY(12px);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-child,
    .scroll-reveal-section.reveal-armed:not(.in-view) .reveal-child {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  import { initCodeCopy } from "../scripts/code-copy";
  import { initImageLightbox } from "../scripts/image-lightbox";
  import { initScrollReveal } from "../scripts/labs-scroll-reveal";

  // The mobile-TOC close handler lives in LabsArticleBody.astro, which wires
  // itself — nothing to do for it here.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initImageLightbox();
      initCodeCopy();
      initScrollReveal();
    });
  } else {
    initImageLightbox();
    initCodeCopy();
    initScrollReveal();
  }
</script>
