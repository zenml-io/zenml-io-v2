---
/**
 * LabsStackLayer (`labs.stack-layer`) — the homepage's "how it fits"
 * section: eyebrow, headline and deck, then a stone panel: the AI engineer
 * as a white layer across the top, and under it the stack a team already
 * runs, one column each (the traces and evals it reads, the agent
 * frameworks it works with). Marks with a logo come first, then the names
 * that have none. Columns sit three across from md. A text link to the trust center
 * closes it. Copy arrives through `content` (LABS_STACK_LAYER on `/`).
 */
import type { StackLayerContent } from "../../lib/labs-home";
import "../../styles/labs-scroll-reveal.css";
import { LABS_EYEBROW_CLASS } from "../templates/pageHeaderPresets";
import LabsOrb from "./LabsOrb.astro";
import LabsTextLink from "./LabsTextLink.astro";

interface Props {
  content: StackLayerContent;
}
const { content } = Astro.props;

const COLUMN_TITLE =
  "font-sans text-[14px] leading-[18px] font-semibold text-(--color-cream-900)";
const MARK =
  "flex h-7 items-center rounded-[6px] border border-(--color-border) bg-card";
---

<section class="py-24 md:py-32" aria-labelledby="stack-layer-title">
  <div class="scroll-reveal-section mx-auto max-w-content px-gutter">
    <p class:list={["reveal-child", LABS_EYEBROW_CLASS]}>{content.eyebrow}</p>
    <h2 id="stack-layer-title" class="reveal-child mt-3 max-w-[860px] font-display text-[32px] leading-[38px] text-balance text-(--color-cream-900) md:text-[48px] md:leading-[54px]">
      {content.headline}
    </h2>
    <p class="reveal-child stagger-1 mt-6 max-w-[720px] font-sans text-[17px] leading-[27px] text-(--color-cream-700)">
      {content.deck}
    </p>

    <div class="reveal-child stagger-2 mt-space-xl rounded-[24px] bg-(--secondary-fill) p-2 md:p-3">
      <div class="flex items-center gap-3 rounded-[16px] border border-(--color-border) bg-card px-5 py-4 md:px-6">
        <LabsOrb size={24} blink={2} />
        <p class="font-sans text-[15px] leading-[22px] text-(--color-cream-900)">
          <span class="font-semibold">{content.layer.title}</span>
          <span class="text-(--muted-foreground)"> · {content.layer.label}</span>
        </p>
      </div>
      <div class="grid grid-cols-1 gap-8 px-3 pt-7 pb-5 md:grid-cols-3 md:px-5 md:pb-6">
        {content.columns.map((column) => (
          <div class="flex min-w-0 flex-col gap-2.5">
            <h3 class={COLUMN_TITLE}>{column.title}</h3>
            <ul class="flex flex-wrap items-center gap-1.5">
              {[...column.marks.filter((mark) => mark.logo), ...column.marks.filter((mark) => !mark.logo)].map((mark) =>
                mark.logo ? (
                  <li class:list={[MARK, "w-7 justify-center"]}>
                    <img src={mark.logo} alt={mark.name} title={mark.name} width="18" height="18" class="size-[18px] object-contain" loading="lazy" />
                  </li>
                ) : (
                  <li class:list={[MARK, "px-2 font-sans text-[12px] leading-4 text-(--muted-foreground)"]}>{mark.name}</li>
                ),
              )}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="reveal-child mt-8"><LabsTextLink cta={content.link} external /></div>
  </div>
</section>
