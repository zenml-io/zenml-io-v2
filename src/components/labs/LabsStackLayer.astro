---
/**
 * LabsStackLayer (`labs.stack-layer`) — the homepage's "how it fits"
 * diagram, drawn as one session's thread through the stack a team already
 * runs. On a stone panel: a track with four stops (from lg), the four
 * journey cards under it (numeral, tone tag, title, detail), then a divider
 * and the sources the thread runs through, one per column: the traces it
 * reads, the evals it reads, the AI engineer layer, and the agent it
 * replays through, each with its service marks. The last stop keeps the
 * sage border as the result. Below lg the cards and sources stack and the
 * track drops out.
 *
 * Motion (one moment, no loop): once the panel is in view the stops light
 * in order and the track fills between them. With JS off or under reduced
 * motion the script never arms the panel, so the finished thread shows at
 * full strength. Compositor properties only. Copy arrives through
 * `content` (LABS_STACK_LAYER on `/`).
 */
import type { JourneyStep, StackLayerContent } from "../../lib/labs-home";
import { LABS_EYEBROW_CLASS } from "../templates/pageHeaderPresets";
import { GAP_TAG } from "./gapTags";
import LabsInstallChip from "./LabsInstallChip.astro";

interface Props {
  content: StackLayerContent;
}
const { content } = Astro.props;

const TAG_TONE: Record<JourneyStep["tone"], string> = {
  neutral: "bg-(--color-cream-100) text-(--color-cream-800)",
  missing: GAP_TAG.missing,
  new: "bg-(--color-sage-100) text-(--color-sage-800)",
  pass: "bg-(--color-sage-800) text-(--color-cream-50)",
};

const [traces, evals, agent] = content.columns;
const last = content.journey.length - 1;
const numeral = (index: number) => String(index + 1).padStart(2, "0");
const COLUMN_TITLE =
  "font-display text-[20px] leading-[26px] text-(--color-cream-900)";
const LINK_TAG = "font-mono text-[12px] leading-4 text-(--color-sage-700)";
const MARK =
  "inline-flex items-center gap-1.5 rounded-full border border-(--color-border) bg-card px-2.5 py-1 font-sans text-[13px] leading-4 text-(--color-cream-800)";
---

<section class="stack-layer scroll-reveal-section py-24 md:py-32" aria-labelledby="stack-layer-title">
  <div class="mx-auto max-w-content px-gutter">
    <p class:list={["reveal-child", LABS_EYEBROW_CLASS]}>{content.eyebrow}</p>
    <h2 id="stack-layer-title" class="reveal-child mt-3 max-w-[860px] font-display text-[32px] leading-[38px] text-balance text-(--color-cream-900) md:text-[48px] md:leading-[54px]">
      {content.headline}
    </h2>
    <p class="reveal-child stagger-1 mt-6 max-w-[720px] font-sans text-[17px] leading-[27px] text-(--color-cream-700)">
      {content.deck}
    </p>

    <div class="reveal-child mt-space-xl rounded-[24px] bg-(--secondary-fill) p-4 md:p-8" data-thread>
      <div role="group" aria-label={content.journeyLabel}>
        {/* The track: a dot over each stop, a line to the next */}
        <div class="hidden grid-cols-4 gap-4 pb-4 lg:grid" aria-hidden="true">
          {content.journey.map((_, index) => (
            <div class="relative flex h-3 items-center pl-6">
              <span class="stack-dot relative z-10 size-3 rounded-full bg-(--color-primary) ring-4 ring-(--secondary-fill)" style={`--i: ${index}`}></span>
              {index < last && (
                <span class="absolute top-1/2 right-[-1rem] left-6 h-0.5 -translate-y-1/2 bg-(--color-cream-400)">
                  <span class="stack-segment block h-full bg-(--color-primary)" style={`--i: ${index}`}></span>
                </span>
              )}
            </div>
          ))}
        </div>

        <ol class="grid list-none grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
          {content.journey.map((step, index) => (
            <li
              class:list={[
                "stack-stop flex min-w-0 flex-col gap-2 rounded-[16px] border bg-card p-6",
                index === last ? "border-(--color-primary)" : "border-(--color-border)",
              ]}
              style={`--i: ${index}`}
            >
              <span class="flex items-center gap-2">
                <span class="font-mono text-[13px] leading-6 text-(--color-sage-700)">{numeral(index)}</span>
                <span class:list={["rounded-full px-2.5 py-0.5 font-sans text-[12px] leading-4 font-medium", TAG_TONE[step.tone]]}>{step.tag}</span>
              </span>
              <span class="mt-1 font-sans text-[16px] leading-6 font-medium text-(--color-cream-900)">{step.title}</span>
              <span class="font-mono text-[12px] leading-[18px] text-(--color-cream-700)">{step.detail}</span>
            </li>
          ))}
        </ol>
      </div>

      {/* What the thread runs through */}
      <div class="mt-8 border-t border-(--color-border) pt-6">
        <p class="font-label text-[12px] leading-4 uppercase tracking-[0.08em] text-(--color-cream-700)">{content.stackLabel}</p>
        <div class="mt-4 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4 lg:gap-4">
          {[traces, evals].map((column) => (
            <div class="flex min-w-0 flex-col gap-3">
              <span class="flex items-baseline gap-2">
                <h3 class={COLUMN_TITLE}>{column.title}</h3>
                <span class={LINK_TAG}>{content.linkLabels[column.link]}</span>
              </span>
              <ul class="flex list-none flex-wrap gap-1.5">
                {column.marks.map((mark) => (
                  <li class={MARK}>
                    {mark.logo && <img src={mark.logo} alt="" aria-hidden="true" class="size-3.5 object-contain" loading="lazy" />}
                    {mark.name}
                  </li>
                ))}
              </ul>
              {column.note && (
                <p class="font-mono text-[12px] leading-[18px] text-(--color-cream-700)">
                  <span class="text-(--color-cream-900)">{column.note.title}</span> · {column.note.detail}
                </p>
              )}
            </div>
          ))}
          <div class="flex min-w-0 flex-col gap-3 rounded-[16px] bg-(--color-sage-800) p-5 text-(--color-cream-50)">
            <p class="font-label text-[12px] leading-4 uppercase tracking-[0.08em] text-(--color-sage-300)">{content.layer.label}</p>
            <p class="font-display text-[24px] leading-[30px]">{content.layer.title}</p>
          </div>
          <div class="flex min-w-0 flex-col gap-3">
            <span class="flex items-baseline gap-2">
              <h3 class={COLUMN_TITLE}>{agent.title}</h3>
              <span class={LINK_TAG}>{content.linkLabels[agent.link]}</span>
            </span>
            <ul class="flex list-none flex-wrap gap-1.5">
              {agent.marks.map((mark) => (
                <li class={MARK}>
                  {mark.logo && <img src={mark.logo} alt="" aria-hidden="true" class="size-3.5 object-contain" loading="lazy" />}
                  {mark.name}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>

    <div class="reveal-child mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
      <span class="font-sans text-[15px] leading-6 text-(--color-cream-700)">{content.installLabel}</span>
      <div class="flex max-w-full"><LabsInstallChip content={content.install} /></div>
      <a
        href={content.link.href}
        target="_blank"
        rel="noopener noreferrer"
        data-analytics={content.link.analytics}
        class="group inline-flex min-h-11 items-center gap-1.5 font-sans text-[16px] leading-6 text-(--color-sage-800) transition-colors duration-200 ease-out hover:text-(--color-sage-900)"
      >
        <span class="underline decoration-(--color-sage-400) underline-offset-4">{content.link.label}</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  /* One pass once the panel is half in view: each stop lights 700ms after
     the last and the track fills between them. Armed only by the script
     below, which skips reduced motion, so the static thread is the default. */
  .is-armed .stack-stop,
  .is-armed .stack-dot {
    opacity: 0.35;
  }
  .is-armed .stack-segment {
    transform: scaleX(0);
  }
  .stack-segment {
    transform-origin: left;
  }
  .is-playing .stack-stop,
  .is-playing .stack-dot {
    animation: stack-light 400ms ease-out calc(var(--i) * 700ms) both;
  }
  .is-playing .stack-segment {
    animation: stack-fill 500ms cubic-bezier(0.22, 1, 0.36, 1) calc(var(--i) * 700ms + 200ms) both;
  }
  @keyframes stack-light {
    from {
      opacity: 0.35;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes stack-fill {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
</style>

<script>
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLElement>("[data-thread]").forEach((panel) => {
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            panel.classList.add("is-playing");
            observer.disconnect();
          }
        },
        { threshold: 0.4 },
      );
      panel.classList.add("is-armed");
      observer.observe(panel);
    });
  }
</script>
