---
/**
 * LabsStackLayer (`labs.stack-layer`) — the "how it fits" section on `/` and
 * `/pro`: eyebrow, headline and deck, then one card. Three columns of named
 * tools (traces, evals, agent) sit above a single trust strip: where it runs,
 * the compliance badges and the trust link. Static. Copy arrives through
 * `content` (LABS_STACK_LAYER).
 */
import type { StackLayerContent } from "../../lib/labs-home";
import "../../styles/labs-scroll-reveal.css";
import { LABS_EYEBROW_CLASS } from "../templates/pageHeaderPresets";
import LabsTextLink from "./LabsTextLink.astro";

interface Props {
  content: StackLayerContent;
}
const { content } = Astro.props;

/** Lucide paths for the marks that have no logo. */
const ICONS = {
  scale: [
    "m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z",
    "m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z",
    "M7 21h10",
    "M12 3v18",
    "M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2",
  ],
  gauge: ["m12 14 4-4", "M3.34 19a10 10 0 1 1 17.32 0"],
} as const;
---

<section class="py-24 md:py-32" aria-labelledby="stack-layer-title">
  <div class="scroll-reveal-section mx-auto max-w-content px-gutter">
    <p class:list={["reveal-child", LABS_EYEBROW_CLASS]}>{content.eyebrow}</p>
    <h2 id="stack-layer-title" class="reveal-child mt-3 max-w-[860px] font-display text-[32px] leading-[38px] text-balance text-(--color-cream-900) md:text-[48px] md:leading-[54px]">
      {content.headline}
    </h2>
    <p class="reveal-child stagger-1 mt-6 max-w-[720px] font-sans text-[17px] leading-[27px] text-(--color-cream-700)">
      {content.deck}
    </p>

    <div class="reveal-child stagger-2 mt-space-xl rounded-[24px] border border-(--color-border) bg-card p-6 md:p-8">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
        {content.columns.map((column) => (
          <div class="min-w-0">
            <h3 class="font-display text-[22px] leading-[28px] text-(--color-cream-900)">{column.title}</h3>
            <ul class="mt-4 flex flex-col gap-3">
              {column.marks.map((mark) => (
                <li class="flex items-center gap-3 font-sans text-[16px] leading-6 text-(--color-cream-800)">
                  {mark.logo ? (
                    <img src={mark.logo} alt="" aria-hidden="true" width="28" height="28" class="size-7 shrink-0 object-contain" loading="lazy" />
                  ) : mark.icon ? (
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="size-7 shrink-0 text-(--color-cream-700)">
                      {ICONS[mark.icon].map((d) => <path d={d} />)}
                    </svg>
                  ) : null}
                  {mark.name}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="mt-8 flex flex-col gap-4 rounded-[16px] bg-(--secondary-fill) p-5 lg:flex-row lg:items-center lg:justify-between lg:gap-8">
        <p class="max-w-[640px] font-sans text-[16px] leading-6 text-(--color-cream-900)">{content.trust.line}</p>
        <div class="flex shrink-0 flex-wrap items-center gap-x-4 gap-y-2">
          <ul class="flex flex-wrap gap-2">
            {content.trust.badges.map((badge) => (
              <li class="rounded-full border border-(--color-border) bg-card px-3 py-1 font-sans text-[13px] leading-5 text-(--color-cream-800)">{badge}</li>
            ))}
          </ul>
          <LabsTextLink cta={content.link} external />
        </div>
      </div>
    </div>
  </div>
</section>
