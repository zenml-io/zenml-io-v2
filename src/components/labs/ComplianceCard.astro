---
/**
 * ComplianceCard (`labs.compliance-card`) — the SOC 2 / ISO 27001 badges
 * beside an eyebrow, headline and body, on the Labs card shell.
 *
 * Extracted verbatim from the card /pricing and /pro already shipped, so
 * both render byte-identically through it. The `mt-8` is part of the
 * component because every consumer sits it directly under a block.
 *
 * Consumers: /pricing (the ZenML workspace panel), /pro, and the
 * /features/[slug] compliance blocks.
 */
interface Props {
  badges: readonly { url: string; alt: string }[];
  eyebrow: string;
  headline: string;
  body: string;
}

const { badges, eyebrow, headline, body } = Astro.props;
---

<div class="mt-8 flex flex-col items-center gap-8 rounded-[20px] border border-(--color-border) bg-card p-8 md:flex-row">
  <div class="flex shrink-0 gap-6">
    {badges.map((badge) => (
      <img src={badge.url} alt={badge.alt} class="h-24 w-auto object-contain" loading="lazy" />
    ))}
  </div>
  <div class="md:border-l md:border-(--color-border) md:pl-8">
    <p class="font-sans text-[13px] leading-4 font-medium text-(--color-cream-700)">
      {eyebrow}
    </p>
    <h3 class="mt-1 font-display text-[20px] leading-[26px] text-(--color-cream-900)">
      {headline}
    </h3>
    <p class="mt-2 font-sans text-[15px] leading-5 text-(--color-cream-700)">
      {body}
    </p>
  </div>
</div>
