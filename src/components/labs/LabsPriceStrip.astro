---
/**
 * LabsPriceStrip (`labs.price-strip`) — the agent plans in one row for pages
 * outside /pricing: eyebrow, headline, deck and a "Compare plans" link in a
 * 4/12 column (above on phones), then one compact cell per plan (name,
 * price, limits line) in a 1 → 2 → 4 grid; the highlighted plan sits on
 * sage-50 with a sage-400 border. Static. Copy arrives through `content`
 * (`priceStrip(placement)` in src/lib/pricing.ts, derived from the plans).
 */
import type { PriceStripContent } from "../../lib/pricing";
import { LABS_EYEBROW_CLASS } from "../templates/pageHeaderPresets";

interface Props {
  content: PriceStripContent;
}
const { content } = Astro.props;
---

<section class="scroll-reveal-section py-24 md:py-32" aria-labelledby="price-strip-title">
  <div class="mx-auto grid max-w-content grid-cols-1 gap-10 px-gutter lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
    <div class="reveal-child">
      <p class={LABS_EYEBROW_CLASS}>{content.eyebrow}</p>
      <h2 id="price-strip-title" class="mt-3 font-display text-[32px] leading-[38px] text-balance text-(--color-cream-900) md:text-[44px] md:leading-[50px]">
        {content.headline}
      </h2>
      <p class="mt-6 font-sans text-[17px] leading-[27px] text-(--color-cream-700)">{content.deck}</p>
      <a
        href={content.link.href}
        data-analytics={content.link.analytics}
        class="mt-6 inline-flex min-h-11 items-center gap-2 font-sans text-[16px] leading-6 text-(--color-sage-800) underline decoration-(--color-sage-400) underline-offset-4 transition-colors duration-200 ease-out hover:text-(--color-sage-900)"
      >
        {content.link.label} <span aria-hidden="true">→</span>
      </a>
    </div>
    <ul class="reveal-child stagger-1 grid list-none grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4">
      {content.plans.map((plan) => (
        <li class:list={["flex flex-col rounded-[16px] border p-5 transition-colors duration-200 ease-out hover:border-(--color-sage-400)", plan.highlighted ? "border-(--color-sage-400) bg-(--color-sage-50)" : "border-(--color-border) bg-card"]}>
          <p class="font-label text-[13px] leading-5 uppercase tracking-[0.05em] text-(--color-cream-700)">{plan.name}</p>
          <p class="mt-3 font-display text-[36px] leading-[40px] text-(--color-cream-900)">
            {plan.price}{plan.suffix && <span class="font-sans text-[15px] leading-5 text-(--color-cream-700)">{plan.suffix}</span>}
          </p>
          <p class="mt-3 font-sans text-[14px] leading-[21px] text-(--color-cream-700)">{plan.line}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
