---
/**
 * labs.pricing-plan-cards — one plan card inside `PricingPlanCards`'
 * workspace panels. The ZenML Scale card carries an interactive executions
 * slider that snaps between three pricing tiers, updating the price +
 * readout live (handled by the parent's script). Display strings come from
 * `buildSliderView` so SSR and the client script share one source of truth.
 *
 * `accent` is the workspace's `"sage" | "orange"` discriminant (from
 * `pricing.ts`): it drives the highlighted card's border + "Recommended"
 * pill and the feature-list check icon colour — the panel's one bounded
 * orange moment on the Kitaru workspace.
 */
import type { LabsCta } from "../../lib/labs-home";
import type { PricingPlan } from "../../lib/marketingPageTypes";
import { buildSliderView } from "../sections/pricingSlider";
import LabsButton from "./LabsButton.astro";

interface Props {
  plan: PricingPlan;
  accent: "sage" | "orange";
  planIdx: number;
}

const { plan, accent, planIdx } = Astro.props;

const checkIcon =
  '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>';

const slider = plan.slider;
const sliderView = slider ? buildSliderView(slider) : null;
const defaultView =
  slider && sliderView ? sliderView[slider.defaultIndex] : null;

const HIGHLIGHT_BORDER =
  accent === "orange"
    ? "border-(--color-orange-300) hover:border-(--color-orange-400)"
    : "border-(--color-sage-400) hover:border-(--color-sage-600)";
const BADGE_CLASSES =
  accent === "orange"
    ? "bg-(--color-orange-600) text-(--color-cream-50)"
    : "bg-(--color-sage-800) text-(--color-cream-50)";
const CHECK_CLASSES =
  accent === "orange" ? "text-(--color-orange-600)" : "text-(--color-sage-700)";
---

<article
  class:list={[
    "scroll-slide-top relative flex flex-col rounded-[20px] border bg-card p-8 transition-colors duration-200 ease-out",
    planIdx === 1 && "stagger-1",
    planIdx === 2 && "stagger-2",
    plan.highlighted
      ? HIGHLIGHT_BORDER
      : "border-(--color-border) hover:border-(--color-sage-400)",
  ]}
>
  {
    plan.topBadge && (
      <span class:list={["absolute -top-[13px] left-8 rounded-full px-3 py-1 font-sans text-[12px] leading-4 font-medium", BADGE_CLASSES]}>
        {plan.topBadge}
      </span>
    )
  }

  {/* Header */}
  <div class="flex items-center gap-2">
    <h2 class="font-display text-[20px] leading-[26px] text-(--color-cream-900)">
      {plan.eyebrow}
    </h2>
    {
      plan.pill && (
        <span class="rounded-full bg-(--color-sage-100) px-2.5 py-0.5 font-sans text-[12px] leading-4 font-medium text-(--color-cream-800)">
          {plan.pill}
        </span>
      )
    }
  </div>
  <p class="mt-1 font-sans text-[14px] leading-5 text-(--color-cream-700)">{plan.subtitle}</p>

  {/* Price */}
  <div class="mt-6 flex flex-wrap items-baseline gap-x-2">
    <span
      class="font-display text-[40px] leading-[44px] text-(--color-cream-900)"
      data-slider-price={slider ? "" : undefined}
    >
      {plan.price}
    </span>
    {
      plan.priceSuffix && (
        <span class="font-sans text-[15px] leading-5 text-(--color-cream-700)">{plan.priceSuffix}</span>
      )
    }
  </div>

  {/* Slider (ZenML Scale) or static limits line */}
  {
    slider && sliderView && defaultView ? (
      <div class="mt-5" data-pricing-slider data-tiers={JSON.stringify(sliderView)}>
        <span class="font-sans text-[13px] leading-4 font-medium text-(--color-cream-700)">
          {slider.caption}
        </span>
        <div class="mt-2.5 flex justify-between font-sans text-[13px] leading-4 tabular-nums">
          {slider.tiers.map((tier, tierIdx) => (
            <span
              data-slider-stop={tierIdx}
              class={
                tierIdx === slider.defaultIndex
                  ? "font-medium text-(--color-cream-900)"
                  : "text-(--color-cream-600)"
              }
            >
              {tier.executions}
            </span>
          ))}
        </div>
        <input
          type="range"
          min="0"
          max={slider.tiers.length - 1}
          step="1"
          value={slider.defaultIndex}
          class="exec-slider mt-3 w-full"
          style={`--range-fill:${defaultView.fill}`}
          data-slider-input
          aria-label={slider.caption}
          aria-valuetext={defaultView.valueText}
        />
        <p
          data-slider-readout
          class="mt-3 inline-flex self-start rounded-[8px] bg-(--color-sage-50) px-3 py-1.5 font-sans text-[13px] leading-4 font-medium text-(--color-cream-800)"
        >
          {defaultView.readout}
        </p>
      </div>
    ) : (
      <p class="mt-4 font-sans text-[14px] leading-5 text-(--color-cream-700)">{plan.limitsLine}</p>
    )
  }

  {/* CTA */}
  <div class="mt-6">
    <LabsButton
      cta={plan.cta as LabsCta}
      tone={plan.ctaVariant === "secondary" ? "ghost" : "dark"}
      class="w-full justify-center"
    />
  </div>

  {/* Includes */}
  <hr class="my-6 border-t border-(--color-border)" />
  <p class="font-sans text-[14px] leading-5 font-medium text-(--color-cream-900)">{plan.includesLabel}</p>
  <ul class="mt-4 flex flex-col gap-3">
    {
      plan.features.map((feature) => (
        <li class="flex items-start gap-3 font-sans text-[15px] leading-5 text-(--color-cream-800)">
          <span class:list={["mt-0.5 shrink-0", CHECK_CLASSES]} set:html={checkIcon} />
          <span>{feature}</span>
        </li>
      ))
    }
  </ul>
</article>

<style>
  /* Scroll-reveal — cards slide in from top with a stagger. The `.in-view`
     trigger class lands on the ancestor section (PricingPlanCards), hence
     the :global() on that half of the selector. */
  .scroll-slide-top {
    transition:
      opacity 0.6s ease-out,
      transform 0.6s ease-out;
  }
  /* Hidden start state only once the house observer has armed the section,
     so a page without JS (or with a failed script) stays fully visible. */
  :global(.scroll-reveal-section.reveal-armed) .scroll-slide-top {
    opacity: 0;
    transform: translateY(-30px);
  }
  .stagger-1 {
    transition-delay: 0.12s;
  }
  .stagger-2 {
    transition-delay: 0.24s;
  }
  :global(.scroll-reveal-section.reveal-armed.in-view) .scroll-slide-top {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-slide-top {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* Executions slider — native range input styled to the Labs tokens */
  .exec-slider {
    -webkit-appearance: none;
    appearance: none;
    height: 22px;
    background: transparent;
    cursor: pointer;
  }
  .exec-slider::-webkit-slider-runnable-track {
    height: 6px;
    border-radius: 999px;
    background: linear-gradient(
      to right,
      var(--color-sage-800) 0%,
      var(--color-sage-800) var(--range-fill, 50%),
      var(--color-sage-200) var(--range-fill, 50%),
      var(--color-sage-200) 100%
    );
  }
  .exec-slider::-moz-range-track {
    height: 6px;
    border-radius: 999px;
    background: linear-gradient(
      to right,
      var(--color-sage-800) 0%,
      var(--color-sage-800) var(--range-fill, 50%),
      var(--color-sage-200) var(--range-fill, 50%),
      var(--color-sage-200) 100%
    );
  }
  .exec-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    margin-top: -8px;
    width: 22px;
    height: 22px;
    border-radius: 999px;
    background: var(--card);
    border: 3px solid var(--color-sage-800);
    cursor: pointer;
    transition: transform 0.12s ease;
  }
  .exec-slider::-webkit-slider-thumb:hover {
    transform: scale(1.08);
  }
  .exec-slider::-moz-range-thumb {
    width: 22px;
    height: 22px;
    border-radius: 999px;
    background: var(--card);
    border: 3px solid var(--color-sage-800);
    cursor: pointer;
  }
  .exec-slider:focus-visible {
    outline: none;
  }
  .exec-slider:focus-visible::-webkit-slider-thumb {
    box-shadow: 0 0 0 4px var(--color-sage-200);
  }
  .exec-slider:focus-visible::-moz-range-thumb {
    box-shadow: 0 0 0 4px var(--color-sage-200);
  }
</style>
