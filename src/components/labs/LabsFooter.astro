---
/**
 * LabsFooter — the ZenML Labs shell footer: dark band, tagline + four link
 * columns, and a legal row with compliance pills. Copy and links come from
 * `src/lib/footer.ts` + `LABS_FOOTER` (`src/lib/labs-home.ts`) — never
 * retyped here.
 *
 * The giant decorative wordmark band is retired site-wide (team request,
 * blog cutover D4) — there is no footer variant that still renders it.
 *
 * Social icons, member badges and link badges ("New") are deliberately not
 * rendered in this footer: the design keeps the columns to plain links.
 */
import { FOOTER_COLUMNS, FOOTER_LEGAL } from "../../lib/footer";
import { LABS_FOOTER } from "../../lib/labs-home";
import ZenmlLabsLogo from "../brand/ZenmlLabsLogo.astro";

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[rgba(219,224,194,0.14)] bg-(--color-sage-900) text-(--color-cream-50)">
  <div class="mx-auto max-w-content px-gutter pt-12 pb-8 md:pt-16 md:pb-12">
    <div class="flex flex-col gap-8 md:flex-row md:justify-between md:gap-16">
      <div class="flex max-w-[300px] flex-col gap-6">
        <a href="/" aria-label="ZenML Labs home" class="labs-footer-lockup inline-flex w-fit cursor-pointer text-(--color-cream-50)">
          <ZenmlLabsLogo class="h-7 w-auto" />
        </a>
        <p class="text-[18px] leading-[26px] text-(--color-sage-300)">
          {LABS_FOOTER.tagline}
        </p>
      </div>

      <nav aria-label="Footer" class="grid grid-cols-2 gap-8 min-w-0 xl:flex xl:flex-row xl:gap-16">
        {FOOTER_COLUMNS.map((col) => (
          <div class="min-w-0 xl:w-[180px]">
            <div class="font-label text-[13px] uppercase tracking-[0.05em] text-(--color-sage-400)">
              {col.title}
            </div>
            <ul class="mt-4 flex flex-col gap-2.5">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="cursor-pointer text-[16px] leading-[20px] text-(--color-cream-50) hover:text-(--color-cream-200)"
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noopener noreferrer" : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <div class="mt-16 flex flex-col gap-4 border-t border-[rgba(219,224,194,0.14)] pt-8 md:flex-row md:items-center md:justify-between">
      <div class="flex flex-wrap items-center gap-3">
        <p class="text-[16px] text-(--color-cream-50)">
          &copy; {currentYear} {LABS_FOOTER.copyright}
        </p>
        {LABS_FOOTER.compliance.map((item) => (
          <span class="flex h-7 items-center rounded-full border border-[rgba(219,224,194,0.3)] px-3 font-label text-[12px] uppercase tracking-[0.05em] text-(--color-cream-50)">
            {item}
          </span>
        ))}
      </div>

      <ul class="flex flex-wrap items-center gap-6">
        {FOOTER_LEGAL.map((link) => (
          <li>
            <a
              href={link.href}
              class="cursor-pointer font-label text-[12px] uppercase tracking-[0.05em] text-(--color-cream-50) hover:text-(--color-cream-200)"
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>
