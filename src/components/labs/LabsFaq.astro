---
/**
 * LabsFaq — the Labs shell's FAQ band: one headline over a column of native
 * `<details>` rows. Copy arrives through `content: FaqData`
 * (`marketingPageTypes.ts`); eyebrow and subheadline are not rendered (one
 * headline per band — the data keeps both fields because the Markdown
 * mirror and JSON-LD read them). An optional `slackCta` renders a single
 * text link after the list. Consumers: `/pricing` (one instance per
 * workspace panel), `/pro` and `/benchmarks`. A page whose answers are
 * components passes `headline` and its own `LabsFaqItem`s in the slot
 * instead of `content` (the `/benchmarks/<slug>` "Go deeper" list).
 * `width="content"` lets the rows span the full content column instead of
 * the prose column, for answers that hold tables and cards.
 */
import { PROSE_COLUMN } from "../../lib/blogLayout";
import type { FaqData } from "../../lib/marketingPageTypes";
import LabsFaqItem from "./LabsFaqItem.astro";

type Width = "prose" | "content";
type Props =
  | { content: FaqData; headline?: never; width?: Width; class?: string }
  | { headline: string; content?: never; width?: Width; class?: string };
const { content, width = "prose", class: className } = Astro.props;
const headline = content ? content.headline : Astro.props.headline;
---

<section class:list={["py-24 md:py-32", className]}>
  <div class="mx-auto max-w-content px-gutter">
    <h2 class="font-display text-[32px] leading-[36px] text-(--color-cream-900) md:text-[44px] md:leading-[48px]">
      {headline}
    </h2>

    <div class="mt-space-xl mx-auto" style={width === "prose" ? `max-width: ${PROSE_COLUMN}px` : undefined}>
      {content ? (
        content.items.map((item) => (
          <LabsFaqItem question={item.question}>
            <div class="[&_a]:text-(--color-sage-700) [&_a]:underline [&_a]:underline-offset-4 hover:[&_a]:text-(--color-sage-800)" set:html={item.answer} />
          </LabsFaqItem>
        ))
      ) : (
        <slot />
      )}
    </div>

    {
      content?.slackCta && (
        <a
          href={content.slackCta.href}
          data-analytics={content.slackCta.analytics}
          target={content.slackCta.external ? "_blank" : undefined}
          rel={content.slackCta.external ? "noopener noreferrer" : undefined}
          class="mt-8 inline-flex font-sans text-[15px] leading-5 font-medium text-(--color-sage-700) hover:text-(--color-sage-800)"
        >
          {content.slackCta.label} →
        </a>
      )
    }
  </div>
</section>
