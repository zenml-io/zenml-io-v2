---
/**
 * LabsWhereItRuns (`labs.where-it-runs`) — the homepage's architecture
 * section: eyebrow, headline and deck, then one framed diagram of three
 * nodes joined by arrows (side by side from lg, stacked with down arrows
 * below it). Left: the team's tracing tools as logo chips over a small
 * trace tree with an eval score on one span. Middle: the AI engineer with
 * its two deployments (the default filled, on-prem outlined). Right: the
 * open-source parts on the team's own machine, with the install command.
 * A trust-center link closes it. Static: no motion moment. Copy arrives
 * through `content` (LABS_WHERE_IT_RUNS on `/`).
 */
import type { WhereItRunsContent } from "../../lib/labs-home";
import { LABS_EYEBROW_CLASS } from "../templates/pageHeaderPresets";
import LabsInstallChip from "./LabsInstallChip.astro";

interface Props {
  content: WhereItRunsContent;
}
const { content } = Astro.props;
const { sources, engineer, local } = content;

const NODE =
  "flex min-w-0 flex-col rounded-[16px] border border-(--color-border) bg-(--color-cream-50) p-6";
const NODE_TITLE =
  "font-display text-[22px] leading-[28px] text-(--color-cream-900)";
const NODE_BODY =
  "mt-2 font-sans text-[15px] leading-[23px] text-(--color-cream-700)";
const ARROW =
  "flex items-center justify-center font-mono text-[20px] leading-none text-(--color-sage-600)";
---

<section class="scroll-reveal-section py-24 md:py-32" aria-labelledby="where-it-runs-title">
  <div class="mx-auto max-w-content px-gutter">
    <p class:list={["reveal-child", LABS_EYEBROW_CLASS]}>{content.eyebrow}</p>
    <h2 id="where-it-runs-title" class="reveal-child mt-3 max-w-[860px] font-display text-[32px] leading-[38px] text-balance text-(--color-cream-900) md:text-[48px] md:leading-[54px]">
      {content.headline}
    </h2>
    <p class="reveal-child stagger-1 mt-6 max-w-[720px] font-sans text-[17px] leading-[27px] text-(--color-cream-700)">
      {content.deck}
    </p>

    <div class="reveal-child mt-space-xl grid grid-cols-1 gap-3 rounded-[20px] border border-(--color-border) bg-card p-4 transition-colors duration-200 ease-out hover:border-(--color-sage-400) md:p-6 lg:grid-cols-[minmax(0,1fr)_32px_minmax(0,1fr)_32px_minmax(0,1fr)]">
      <div class={NODE}>
        <h3 class={NODE_TITLE}>{sources.title}</h3>
        <p class={NODE_BODY}>{sources.body}</p>
        <ul class="mt-4 flex list-none flex-wrap gap-1.5">
          {sources.providers.map((provider) => (
            <li class="inline-flex items-center gap-1.5 rounded-full border border-(--color-border) bg-card px-2.5 py-1 font-sans text-[13px] leading-4 text-(--color-cream-800)">
              {provider.logo && <img src={provider.logo} alt="" aria-hidden="true" class="size-3.5 object-contain" loading="lazy" />}
              {provider.name}
            </li>
          ))}
        </ul>
        <div class="mt-auto pt-5" aria-hidden="true">
          <div class="rounded-[12px] border border-(--color-border) bg-card p-3">
            <p class="font-mono text-[11px] leading-4 text-(--color-cream-700)">{sources.trace.label}</p>
            <ul class="mt-2 flex flex-col gap-1">
              {sources.trace.rows.map((row) => (
                <li class:list={["flex items-center justify-between gap-2 font-mono text-[12px] leading-[18px]", row.depth === 1 && "border-l border-(--color-border) pl-3 ml-1"]}>
                  <span class="truncate text-(--color-cream-900)">{row.name}</span>
                  <span class="flex shrink-0 items-center gap-1.5 text-(--color-cream-700)">
                    {row.score && (
                      <span class="rounded-full bg-(--color-sage-100) px-1.5 font-label text-[10px] leading-4 uppercase tracking-[0.05em] text-(--color-sage-800)">{row.score.label}</span>
                    )}
                    {row.meta}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <span class={ARROW} aria-hidden="true"><span class="lg:hidden">↓</span><span class="hidden lg:inline">→</span></span>

      <div class:list={[NODE, "border-(--color-sage-400) bg-(--color-sage-50)"]}>
        <h3 class={NODE_TITLE}>{engineer.title}</h3>
        <p class={NODE_BODY}>{engineer.body}</p>
        <ul class="mt-auto flex list-none flex-col gap-2 pt-5">
          {engineer.deployments.map((deployment, index) => (
            <li class:list={["flex items-center justify-between gap-3 rounded-[12px] px-4 py-3", index === 0 ? "bg-(--color-sage-800) text-(--color-cream-50)" : "border border-(--color-sage-400) bg-card text-(--color-cream-900)"]}>
              <span class="font-sans text-[15px] leading-5 font-medium">{deployment.label}</span>
              <span class:list={["text-right font-mono text-[12px] leading-4", index === 0 ? "text-(--color-sage-200)" : "text-(--color-cream-700)"]}>{deployment.note}</span>
            </li>
          ))}
        </ul>
      </div>

      <span class={ARROW} aria-hidden="true"><span class="lg:hidden">↓</span><span class="hidden lg:inline">→</span></span>

      <div class={NODE}>
        <h3 class={NODE_TITLE}>{local.title}</h3>
        <p class={NODE_BODY}>{local.body}</p>
        <ul class="mt-4 flex list-none flex-wrap gap-1.5">
          {local.pieces.map((piece) => (
            <li class="rounded-full border border-(--color-border) bg-card px-2.5 py-1 font-sans text-[13px] leading-4 text-(--color-cream-800)">{piece}</li>
          ))}
        </ul>
        <div class="mt-auto flex max-w-full pt-5">
          <LabsInstallChip content={local.install} />
        </div>
      </div>
    </div>

    <a
      href={content.link.href}
      target="_blank"
      rel="noopener noreferrer"
      data-analytics={content.link.analytics}
      class="reveal-child mt-6 inline-flex min-h-11 items-center gap-2 font-sans text-[16px] leading-6 text-(--color-sage-800) underline decoration-(--color-sage-400) underline-offset-4 transition-colors duration-200 ease-out hover:text-(--color-sage-900)"
    >
      {content.link.label} <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>
