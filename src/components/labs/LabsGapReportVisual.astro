---
/**
 * LabsGapReportVisual (`labs.gap-report-visual`) — the homepage hero's
 * example: what the AI engineer tells you about one week of an agent, as a
 * short card. Two pass-rate bars open it (what the team's evals pass against
 * what their own manual would pass), then the gaps as one-line hairline
 * rows, each tagged Wrong (an eval that passes the wrong thing, orange) or
 * Missing (a behavior nothing checks, cream outline) with its session count.
 * One motion moment on load: the bars fill, then the rows arrive; reduced
 * motion shows the finished card. The figcaption carries the whole example as text. Copy arrives through
 * `content` (LABS_GAP_REPORT).
 */
import type { GapReportVisualContent } from "../../lib/labs-home";
import { GAP_TAG } from "./gapTags";

interface Props {
  content: GapReportVisualContent;
}
const { content } = Astro.props;
---

<figure class="rounded-[20px] border border-(--color-border) bg-card p-6 transition-colors duration-200 ease-out hover:border-(--color-sage-400) md:p-8">
  <figcaption class="sr-only">{content.label}</figcaption>
  <div aria-hidden="true">
    <p class="font-label text-[13px] leading-5 uppercase tracking-[0.05em] text-(--color-sage-800)">
      {content.eyebrow}
    </p>
    <p class="mt-2 font-mono text-[13px] leading-5 text-(--color-cream-700)">
      {content.agent} · {content.window}
    </p>

    <dl class="mt-6 grid gap-3">
      {content.scores.map((score, index) => (
        <div class="grid grid-cols-[minmax(0,7.5rem)_minmax(0,1fr)_3rem] items-center gap-3">
          <dt class="font-sans text-[14px] leading-5 text-(--color-cream-800)">{score.label}</dt>
          <span class="h-2.5 overflow-hidden rounded-full bg-(--color-sage-100)">
            <span
              class:list={["gap-bar block h-full rounded-full", index === 0 ? "bg-(--color-sage-400)" : "bg-(--color-sage-800)"]}
              style={`width: ${score.value}%; --i: ${index}`}
            ></span>
          </span>
          <dd class="text-right font-mono text-[15px] leading-5 text-(--color-cream-900)">{score.value}%</dd>
        </div>
      ))}
    </dl>

    <ul class="mt-6 flex flex-col border-t border-(--color-border)">
      {content.items.map((item, index) => (
        <li style={`--i: ${index}`} class="gap-row grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-3 border-b border-(--color-border) py-3.5 last:border-b-0">
          <span class:list={["rounded-full px-2 py-0.5 font-label text-[11px] leading-4 uppercase tracking-[0.05em]", GAP_TAG[item.kind]]}>
            {content.kindLabels[item.kind]}
          </span>
          <span class="min-w-0 font-sans text-[15px] leading-[22px] text-(--color-cream-900)">{item.title}</span>
          <span class="font-mono text-[15px] leading-[22px] text-(--color-cream-900)">{item.count}</span>
        </li>
      ))}
    </ul>
  </div>
</figure>

<style>
  /* One moment on load: the two bars fill, the second (what you would
     pass) last, then the gaps arrive one by one. Server render and reduced
     motion show the finished card. Transform and opacity only. */
  @media (prefers-reduced-motion: no-preference) {
    .gap-bar {
      transform-origin: left;
      animation: gap-bar 900ms cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: calc(300ms + var(--i) * 450ms);
    }
    .gap-row {
      animation: gap-row 600ms cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: calc(1500ms + var(--i) * 250ms);
    }
  }
  @keyframes gap-bar {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes gap-row {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
</style>
