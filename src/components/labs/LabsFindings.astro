---
/**
 * LabsFindings (`labs.findings`) — the homepage hero's example: the AI
 * engineer's message card holding four findings, one per tab (Evals,
 * Reliability, Cost, Models). Each panel shows where it was found, the
 * evidence (a few mono lines, the giveaway lit), the finding on the red
 * tint, then its impact and the drafted fix.
 *
 * The tabs rotate on their own every few seconds (a thin bar under the
 * active tab shows the time left) and stop for good once a visitor clicks
 * one. Without JS, or with reduced motion, the first finding shows and the
 * tabs still switch on click when JS runs. The figcaption carries all four
 * findings as text; the drawn card is aria-hidden. Copy arrives through
 * `content` (LABS_HERO_FINDINGS).
 */
import type { FindingsContent } from "../../lib/labs-home";
import LabsAiEngineerRow from "./LabsAiEngineerRow.astro";

interface Props {
  content: FindingsContent;
}
const { content } = Astro.props;
const LABEL =
  "block font-label text-[11px] leading-4 uppercase tracking-[0.05em]";
---

<figure class="fd-card overflow-hidden rounded-[16px] border border-(--color-border) bg-card shadow-[0_1px_2px_rgba(65,61,55,0.04),0_12px_32px_rgba(65,61,55,0.08)]" data-findings>
  <figcaption class="sr-only">{content.label}</figcaption>
  <div aria-hidden="true">
    <LabsAiEngineerRow>
      <span class="shrink-0 font-mono text-[12px] leading-4 text-(--color-cream-700)">{content.findings.length} findings this week</span>
    </LabsAiEngineerRow>

    <div class="grid grid-cols-4 border-b border-(--color-border)">
      {content.findings.map((finding, index) => (
        <button
          type="button"
          tabindex="-1"
          data-tab={index}
          data-active={index === 0 ? "" : undefined}
          class="fd-tab relative cursor-pointer px-2 py-3 font-label text-[11px] leading-4 uppercase tracking-[0.05em] text-(--color-cream-600) transition-colors duration-200 ease-out hover:text-(--color-cream-900) data-active:text-(--color-cream-900)"
        >
          {finding.kind}
          <span class="fd-bar absolute inset-x-0 bottom-0 h-0.5 origin-left bg-(--color-sage-700)"></span>
        </button>
      ))}
    </div>

    <div class="grid">
      {content.findings.map((finding, index) => (
        <div
          data-panel={index}
          data-active={index === 0 ? "" : undefined}
          class="fd-panel col-start-1 row-start-1 flex flex-col gap-4 px-5 pt-5 pb-6 md:px-6"
        >
          <span class="font-mono text-[12px] leading-4 text-(--color-cream-700)">{finding.where}</span>
          <div class="rounded-[12px] bg-background p-4">
            <span class:list={[LABEL, "text-(--color-cream-600)"]}>{finding.evidence.label}</span>
            <ul class="mt-2 flex flex-col gap-1 font-mono text-[12.5px] leading-5">
              {finding.evidence.lines.map((line) => (
                <li class:list={["truncate rounded-[4px] px-1.5 whitespace-pre", line.hot ? "bg-(--color-orange-50) text-(--color-orange-600) ring-1 ring-(--color-orange-500)/40" : "text-(--color-cream-800)"]}>{line.text}</li>
              ))}
            </ul>
          </div>
          <div class="rounded-[12px] border border-destructive/20 bg-destructive/5 px-4 py-4">
            <span class:list={[LABEL, "text-destructive"]}>Your AI engineer</span>
            <span class="mt-1.5 block font-sans text-[16px] leading-6 font-medium text-(--color-cream-900)">{finding.finding}</span>
          </div>
          <div class="flex flex-wrap items-center justify-between gap-3 border-t border-(--color-border) pt-4">
            <span class="font-mono text-[15px] leading-5 font-medium text-(--color-cream-900)">{finding.impact}</span>
            <span class="rounded-full border border-(--color-sage-400) px-2.5 py-1 font-mono text-[12px] leading-4 text-(--color-sage-800)">
              Fix: {finding.fix}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</figure>

<style>
  .fd-panel:not([data-active]) {
    visibility: hidden;
    opacity: 0;
  }
  .fd-bar {
    transform: scaleX(0);
  }
  .fd-tab[data-active] .fd-bar {
    transform: scaleX(1);
  }
  @media (prefers-reduced-motion: no-preference) {
    .fd-card {
      animation: fd-card-in 900ms var(--ease-out-expo) 100ms backwards;
    }
    .fd-panel[data-active] {
      animation: fd-in 500ms var(--ease-out-quint) backwards;
    }
    [data-rotating] .fd-tab[data-active] .fd-bar {
      animation: fd-progress var(--fd-interval) linear both;
    }
  }
  @keyframes fd-card-in {
    from {
      opacity: 0;
      filter: blur(8px);
      transform: translateY(24px) scale(0.97);
    }
  }
  @keyframes fd-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  @keyframes fd-progress {
    from {
      transform: scaleX(0);
    }
  }
</style>

<script>
  const INTERVAL = 5000;
  for (const card of document.querySelectorAll<HTMLElement>("[data-findings]")) {
    const tabs = [...card.querySelectorAll<HTMLElement>("[data-tab]")];
    const panels = [...card.querySelectorAll<HTMLElement>("[data-panel]")];
    let active = 0;
    let timer: number | undefined;
    const show = (next: number) => {
      active = next;
      for (const [i, el] of [...tabs.entries(), ...panels.entries()]) {
        el.toggleAttribute("data-active", i === next);
      }
    };
    for (const tab of tabs) {
      tab.addEventListener("click", () => {
        window.clearInterval(timer);
        card.removeAttribute("data-rotating");
        show(Number(tab.dataset.tab));
      });
    }
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      card.style.setProperty("--fd-interval", `${INTERVAL}ms`);
      card.setAttribute("data-rotating", "");
      timer = window.setInterval(() => show((active + 1) % tabs.length), INTERVAL);
    }
  }
</script>
