---
import { LABS_GRAIN } from "../../lib/labs-grain-palettes";
import type { LabsProductBandContent } from "../../lib/labs-home";
// LabsHero.astro — the page's opening band: sage grain shader over a cream
// panel, two-line headline, deck, one signup pill, the block vertically
// centered in the band. Copy comes in through the `content` prop (LABS_HERO
// on `/`, ZENML_HERO on `/product/zenml`). A product page's content adds an
// optional ghost pill next to the signup and a copyable install command;
// each is absent on the homepage and its slot collapses. The site nav
// renders as an absolutely positioned overlay from BaseLayout/LabsNavigation,
// not from this component — the top 120px stay free of copy.
import { GrainBackdrop } from "../islands/GrainBackdrop";
import LabsButton from "./LabsButton.astro";
import LabsInstallChip from "./LabsInstallChip.astro";

interface Props {
  /** Headline lines, deck and the pills — e.g. LABS_HERO for `/`. */
  content: LabsProductBandContent;
}
const { content } = Astro.props;
---

<section class="relative flex min-h-[640px] flex-col overflow-hidden bg-(--color-sage-50) lg:min-h-[900px]">
  {
    /*
      client:visible on purpose: this is the page's one always-on ambient
      island (check:motion budget) — every other GrainBackdrop instance on
      the page defers with client:idle or a hover-gated `active` prop.
    */
  }
  <GrainBackdrop
    client:visible
    config={LABS_GRAIN.hero}
    class="absolute inset-0"
  />

  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-[340px] bg-gradient-to-b from-transparent to-(--color-sage-50)"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto flex w-full max-w-content flex-1 flex-col justify-center px-gutter pt-[120px] pb-space-xxl">
    <div>
      <h1 class="font-display text-[44px] leading-[48px] text-(--color-cream-900) md:text-[80px] md:leading-[86px]">
        {content.headlineLines[0]}
        <br />
        {content.headlineLines[1]}
      </h1>

      <p class="mt-space-md max-w-[690px] font-sans text-[17px] leading-[26px] text-foreground md:text-xl md:leading-[30px]">
        {content.deck}
      </p>

      <div class="mt-space-mlg flex flex-wrap items-center gap-space-md">
        <LabsButton cta={content.cta} />
        {content.secondaryCta && (
          <LabsButton cta={content.secondaryCta} tone="ghost" />
        )}
      </div>

      {content.install && (
        <div class="mt-space-md flex max-w-full">
          <LabsInstallChip content={content.install} />
        </div>
      )}
    </div>
  </div>
</section>
