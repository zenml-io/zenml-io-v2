---
/**
 * labs.entry-row — one research-database entry as a row: title, meta line,
 * two-line summary, tag chips. The listing counterpart of `labs.blog-card`
 * (a database entry has no cover image, and its record — company, year,
 * industry — is the thing a reader scans), and built the same way: an Astro
 * twin for server-rendered listings and a Preact twin (`EntryRow.tsx`) for
 * the filter island, both importing every class string and the row's data
 * shape from `entryRowStyles.ts`.
 *
 * This twin renders the row's tokens as text and its chips as links. The
 * Preact twin renders the chips and the industry token as real filter
 * controls instead — same markup otherwise.
 *
 * Consumers: the tag and industry hubs (server-rendered pages), with
 * `/llmops-database` and `/mlops-database` on the Preact twin.
 */
import {
  TERM_CHIP_HEXAGON_PATH,
  TERM_CHIP_HEXAGON_VIEWBOX,
} from "../blog/termChipStyles";
import {
  ENTRY_ROW,
  ENTRY_ROW_CHEVRON,
  ENTRY_ROW_CHEVRON_PATH,
  ENTRY_ROW_CHEVRON_VIEWBOX,
  ENTRY_ROW_CHIP,
  ENTRY_ROW_CHIP_HEXAGON,
  ENTRY_ROW_CHIP_OVERFLOW,
  ENTRY_ROW_CHIPS,
  ENTRY_ROW_MARK,
  ENTRY_ROW_META,
  ENTRY_ROW_META_DOT,
  ENTRY_ROW_META_STRONG,
  ENTRY_ROW_SUMMARY,
  ENTRY_ROW_TITLE,
  ENTRY_ROW_TITLE_LINK,
  ENTRY_ROW_TITLE_ROW,
  type EntryRowItem,
  entryRowMetaTokens,
} from "./entryRowStyles";

export type { EntryRowItem };

type Props = EntryRowItem;

const {
  href,
  title,
  mark,
  meta,
  summary,
  chips,
  chipOverflowCount = 0,
  headingLevel = 3,
} = Astro.props;

const Heading = `h${headingLevel}` as "h2" | "h3";
const tokens = entryRowMetaTokens(meta);
---

<article class={ENTRY_ROW}>
  {mark ? (
    <div class={ENTRY_ROW_TITLE_ROW}>
      <img class={ENTRY_ROW_MARK} src={mark.url} alt={mark.alt} loading="lazy" />
      <Heading class={ENTRY_ROW_TITLE}>
        <a href={href} class={ENTRY_ROW_TITLE_LINK}>{title}</a>
      </Heading>
    </div>
  ) : (
    <Heading class={ENTRY_ROW_TITLE}>
      <a href={href} class={ENTRY_ROW_TITLE_LINK}>{title}</a>
    </Heading>
  )}

  {tokens.length > 0 && (
    <div class={ENTRY_ROW_META}>
      {tokens.map((token, index) => (
        <Fragment>
          {index > 0 && <span class={ENTRY_ROW_META_DOT} aria-hidden="true">&middot;</span>}
          <span class={token.kind === "text" && token.strong ? ENTRY_ROW_META_STRONG : undefined}>
            {token.text}
          </span>
        </Fragment>
      ))}
    </div>
  )}

  {summary && <p class={ENTRY_ROW_SUMMARY}>{summary}</p>}

  {(chips.length > 0 || chipOverflowCount > 0) && (
    <div class={ENTRY_ROW_CHIPS}>
      {chips.map((chip) =>
        chip.href ? (
          <a href={chip.href} class={ENTRY_ROW_CHIP}>
            <svg viewBox={TERM_CHIP_HEXAGON_VIEWBOX} class={ENTRY_ROW_CHIP_HEXAGON} aria-hidden="true">
              <path d={TERM_CHIP_HEXAGON_PATH} />
            </svg>
            {chip.label}
          </a>
        ) : (
          <span class={ENTRY_ROW_CHIP}>
            <svg viewBox={TERM_CHIP_HEXAGON_VIEWBOX} class={ENTRY_ROW_CHIP_HEXAGON} aria-hidden="true">
              <path d={TERM_CHIP_HEXAGON_PATH} />
            </svg>
            {chip.label}
          </span>
        ),
      )}
      {chipOverflowCount > 0 && (
        <span class={ENTRY_ROW_CHIP_OVERFLOW}>+{chipOverflowCount}</span>
      )}
    </div>
  )}

  <svg
    class={ENTRY_ROW_CHEVRON}
    viewBox={ENTRY_ROW_CHEVRON_VIEWBOX}
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d={ENTRY_ROW_CHEVRON_PATH} />
  </svg>
</article>
