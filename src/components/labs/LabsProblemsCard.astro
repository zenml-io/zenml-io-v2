---
/**
 * LabsProblemsCard (`labs.problems-card`) — the homepage hero's example:
 * the AI engineer's message card for one week on one agent, listing a few
 * problems that come up after an agent ships. Each row names the problem,
 * gives the evidence in one mono line, and ends on a sage chip with what
 * it got ready for you to approve. Under the card, a text link to the
 * public benchmark the example is drawn from.
 *
 * The card rises once on load (skipped under reduced motion). The
 * figcaption carries the whole example as text; the drawn card is
 * aria-hidden. Copy arrives through `content` (LABS_HERO_PROBLEMS).
 */
import type { ProblemsCardContent } from "../../lib/labs-home";
import LabsAiEngineerRow from "./LabsAiEngineerRow.astro";

interface Props {
  content: ProblemsCardContent;
}
const { content } = Astro.props;
---

<div>
  <figure class="pc-card overflow-hidden rounded-[16px] border border-(--color-border) bg-card shadow-[0_1px_2px_rgba(65,61,55,0.04),0_12px_32px_rgba(65,61,55,0.08)]">
    <figcaption class="sr-only">{content.label}</figcaption>
    <div aria-hidden="true">
      <LabsAiEngineerRow>
        <span class="shrink-0 font-mono text-[12px] leading-4 text-(--color-cream-700)">{content.agent}</span>
      </LabsAiEngineerRow>
      <ul class="divide-y divide-(--color-border)">
        {content.problems.map((row) => (
          <li class="flex flex-col gap-2 px-5 py-5 md:px-6">
            <span class="font-sans text-[17px] leading-6 font-medium text-(--color-cream-900)">{row.problem}</span>
            <span class="font-mono text-[12.5px] leading-5 text-pretty text-(--color-cream-700)">{row.evidence}</span>
            <span class="mt-1 self-start rounded-full border border-(--color-sage-400) bg-(--color-sage-50) px-2.5 py-1 font-mono text-[12px] leading-4 text-(--color-sage-800)">
              ✓ {row.result}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </figure>
  <a
    href={content.link.href}
    data-analytics={content.link.analytics}
    class="mt-4 inline-flex items-center gap-1.5 font-mono text-[12px] leading-4 uppercase tracking-[0.05em] text-(--color-cream-800) underline-offset-4 transition-colors duration-200 ease-out hover:text-(--color-cream-900) hover:underline"
  >
    {content.link.label} <span aria-hidden="true">→</span>
  </a>
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .pc-card {
      animation: pc-card-in 900ms var(--ease-out-expo) 100ms backwards;
    }
  }
  @keyframes pc-card-in {
    from {
      opacity: 0;
      filter: blur(8px);
      transform: translateY(24px) scale(0.97);
    }
  }
</style>
