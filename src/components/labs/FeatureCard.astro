---
/**
 * FeatureCard (`labs.feature-card`) — the features hub card on the Labs
 * shell: the category line (Nudica Mono uppercase, the same label role the
 * integration card wears), a Borna title and the summary. The whole card
 * is the link and hovers (border + title colour). No icon, no badge and no
 * "Learn more" text link — the category names the card and the card itself
 * is the affordance.
 *
 * The category and summary each collapse when absent; `external` opens the
 * link in a new tab. Slotted content renders at the foot of the card (a
 * report's Hugging Face viewer); the title link then covers the card.
 *
 * Consumers: /features, and the datasets in a /benchmarks/<slug> report's
 * "Data" row (licence as the category).
 */
interface Props {
  href: string;
  category?: string;
  title: string;
  summary?: string;
  external?: boolean;
}

const { href, category, title, summary, external } = Astro.props;
// With slotted content (a disclosure, a second link) the card cannot be one
// <a>: the title link stretches over the card and the slot sits above it.
const hasSlot = Astro.slots.has("default");
const Card = hasSlot ? "article" : "a";
const linkAttrs = {
  href,
  target: external ? "_blank" : undefined,
  rel: external ? "noopener" : undefined,
};
---

<Card
  {...(hasSlot ? {} : linkAttrs)}
  class:list={["group flex h-full flex-col gap-3 rounded-[20px] border border-(--color-border) bg-card p-8 transition-colors duration-200 ease-out hover:border-(--color-sage-400)", hasSlot && "relative"]}
>
  {category && (
    <p class="font-label text-[13px] leading-4 tracking-[0.05em] uppercase text-(--color-cream-700)">
      {category}
    </p>
  )}
  <h2 class="font-display text-[24px] leading-[30px] text-(--color-cream-900) transition-colors duration-200 ease-out group-hover:text-(--color-sage-800)">
    {hasSlot ? <a {...linkAttrs} class="after:absolute after:inset-0 after:rounded-[20px]">{title}</a> : title}
  </h2>
  {summary && (
    <p class="font-sans text-[16px] leading-6 text-(--color-cream-700)">
      {summary}
    </p>
  )}
  {hasSlot && <div class="relative z-10 mt-auto pt-space-xxs"><slot /></div>}
</Card>
