---
/**
 * LabsHowItWorks — the three steps from the traces a team already has to a
 * model switch, told on one pinned stage. Left: headline, intro and the
 * steps, each with a hexagon numeral; right: a sage stage holding the
 * recorded-sessions card and the dark replay card.
 *
 * From lg (and a viewport tall enough to pin), the section becomes a tall
 * scroll track with a sticky inner frame. A small script turns the track's
 * scroll position into `--hiw-p` (0 → 1) and `data-step` (1–3) on the
 * section; every moving part on the stage derives its own 0 → 1 progress
 * from `--hiw-p` with the `.sc` helpers below, so the card scrubs with the
 * scroll in both directions: sessions drop in, the prompt card arrives and
 * its words appear, it turns into the replay card while the bars fill, then
 * the rows settle to same / differs and the one that differs lifts out.
 * `--hiw-p` is a registered property with a short transition, which smooths
 * wheel steps without lagging behind the scroll.
 *
 * Server-rendered state is the finished example (`--hiw-p` initial value 1,
 * every step expanded), which is also what small screens, short screens,
 * reduced motion and no-JS get. Motion moment: counts as one of the page's
 * three.
 */
import type { HowItWorksContent } from "../../lib/labs-home";
import "../../styles/labs-scroll-reveal.css";
import { TRACE_SOURCES } from "./traceSources";

interface Props {
  content: HowItWorksContent;
}
const { content } = Astro.props;
const { stage } = content;

const prompt = content.steps.find((step) => step.detail?.kind === "prompt")
  ?.detail as { kind: "prompt"; text: string } | undefined;
const promptWords = prompt ? prompt.text.split(" ") : [];
const unchanged = stage.sessions.length - 1;

/* Scroll timeline, as fractions of the track. Step boundaries live in the
 * script; everything else is a window [a, b] in which a part comes in, or
 * [c, d] in which it goes out. */
const T = {
  row: (i: number) => [0.04 + i * 0.05, 0.11 + i * 0.05],
  replayCard: [0.3, 0.36],
  words: [0.36, 0.46],
  promptOut: [0.48, 0.51],
  replayIn: [0.49, 0.52],
  bar: (i: number) => [0.52 + i * 0.03, 0.58 + i * 0.03],
  replayed: [0.66, 0.7],
  result: [0.7, 0.74],
  verdict: (i: number) => [0.72 + i * 0.02, 0.76 + i * 0.02],
  lift: [0.78, 0.84],
  foot: [0.86, 0.92],
};
const win = ([a, b]: number[], out?: number[]) =>
  `--a:${a.toFixed(3)};--b:${b.toFixed(3)}` +
  (out ? `;--c:${out[0].toFixed(3)};--d:${out[1].toFixed(3)}` : "");
const wordStep = (T.words[1] - T.words[0]) / Math.max(promptWords.length, 1);
---

<section class="hiw" data-hiw>
  <div class="hiw-track">
    <div class="hiw-pin">
      <div class="mx-auto grid max-w-content grid-cols-1 items-center gap-12 px-gutter lg:grid-cols-[minmax(0,460px)_minmax(0,1fr)] lg:gap-20">
        <div class="scroll-reveal-section flex flex-col gap-7">
          <div class="reveal-child flex flex-col gap-5">
            <h2 class="font-display text-[34px] leading-[38px] text-(--color-cream-900) md:text-[40px] md:leading-[46px]">
              {content.headline}
            </h2>
            <p class="font-sans text-[17px] leading-[26px] text-foreground">
              {content.intro}
            </p>
          </div>

          <ol class="reveal-child stagger-1 flex flex-col border-b border-(--color-border)">
            {content.steps.map((step, i) => (
              <li class="hiw-step flex gap-5 border-t border-(--color-border) py-4" data-i={i + 1}>
                <span class="hiw-hex relative grid h-[46px] w-10 shrink-0 place-items-center" aria-hidden="true">
                  <svg class="absolute inset-0 size-full" viewBox="0 0 46 52">
                    <path d="M23 1 L45 13.5 L45 38.5 L23 51 L1 38.5 L1 13.5 Z" stroke-width="1.5" stroke-linejoin="round" />
                  </svg>
                  <span class="relative font-label text-[13px] leading-4">{String(i + 1).padStart(2, "0")}</span>
                </span>
                <div class="flex min-w-0 flex-col pt-1.5">
                  <h3 class="hiw-title font-display text-[24px] leading-[30px] md:text-[26px] md:leading-8">
                    <span class="sr-only">Step {i + 1}: </span>{step.title}
                  </h3>
                  <div class="hiw-body grid">
                    <div class="min-h-0 overflow-hidden">
                      <p class="pt-2 font-sans text-[16px] leading-6 text-(--color-cream-700)">
                        {step.body}
                      </p>
                      {step.detail?.kind === "prompt" && (
                        <code class="hiw-detail mt-3 block rounded-[12px] bg-(--color-sage-100) px-4 py-3 font-mono text-[14px] leading-[22px] text-(--color-sage-900)">
                          {step.detail.text}
                        </code>
                      )}
                    </div>
                  </div>
                </div>
              </li>
            ))}
          </ol>

          <div class="reveal-child stagger-2">
            <a
              href={content.link.href}
              data-analytics={content.link.analytics}
              class="group inline-flex w-fit cursor-pointer items-center gap-2 font-sans text-[16px] leading-6 font-medium text-(--color-cream-900) underline decoration-(--color-sage-400) underline-offset-4 transition-colors duration-200 ease-out hover:decoration-(--color-cream-900)"
            >
              {content.link.label}
              <svg class="size-4 transition-transform duration-200 ease-out group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
          </div>
        </div>

        <div class="scroll-reveal-section">
          <figure
            class="reveal-child stagger-1 relative overflow-hidden rounded-[24px] bg-(--color-sage-100) px-5 pt-[148px] pb-8 md:px-12 md:pb-12 lg:flex lg:h-[540px] lg:flex-col lg:justify-center lg:pt-[112px]"
            aria-label={stage.label}
          >
            <div aria-hidden="true" class="contents">
              <!-- Sessions card -->
              <div class="rounded-[20px] border border-(--color-border) bg-card px-5 pt-2 pb-3 md:px-7">
                <div class="relative flex h-12 items-center">
                  <span class="sc font-label text-[13px] uppercase tracking-[0.05em] text-(--color-cream-800)" style={win([-1, 0], T.result)}>
                    {stage.sessionsLabel}
                  </span>
                  <span class="sc absolute left-0 font-label text-[13px] uppercase tracking-[0.05em] text-(--color-cream-800)" style={win(T.result)}>
                    {stage.resultLabel}
                  </span>
                </div>
                <ul>
                  {stage.sessions.map((session, i) => {
                    const differs = i === stage.differs;
                    const Source = TRACE_SOURCES[i % TRACE_SOURCES.length];
                    return (
                      <li class="sc" style={`${win(T.row(i))};--dy:16px`}>
                        <div class={`relative flex min-h-[52px] items-center justify-between gap-3 border-t py-2 border-(--color-border) ${differs ? "sc-lift" : ""}`} style={differs ? win(T.lift) : undefined}>
                          {differs && <span class="lift-bg absolute -inset-x-3 inset-y-1 rounded-[12px] border border-(--color-sage-400) bg-card"></span>}
                          <span class="relative min-w-0 font-sans text-[15px] leading-[22px] text-(--color-cream-900) md:text-[16px] md:leading-6">{session}</span>
                          <span class="relative grid h-6 w-[108px] shrink-0 md:w-[120px] place-items-center justify-items-end [&>*]:[grid-area:1/1]">
                            <span class="sc flex items-center text-(--color-cream-700)" style={win([-1, 0], T.promptOut)}>
                              <Source.Icon class={Source.class} />
                            </span>
                            <span class="sc h-1.5 w-full overflow-hidden rounded-full bg-(--color-sage-100)" style={`${win(T.replayIn, T.result)};--dy:0px`}>
                              <span class="sc-fill block h-full w-full rounded-full bg-(--color-sage-500)" style={win(T.bar(i))}></span>
                            </span>
                            {differs ? (
                              <span class="sc rounded-full bg-(--color-cream-100) px-2.5 py-0.5 font-sans text-[13px] leading-5 whitespace-nowrap md:px-3 md:text-[14px] text-(--color-cream-900)" style={win(T.verdict(i))}>
                                {stage.differsLabel}
                              </span>
                            ) : (
                              <span class="sc flex items-center gap-1 font-sans text-[14px] leading-5 text-(--color-sage-800)" style={win(T.verdict(i))}>
                                <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7" /></svg>
                                {stage.sameLabel}
                              </span>
                            )}
                          </span>
                        </div>
                      </li>
                    );
                  })}
                </ul>
                <div class="sc flex items-center justify-between gap-4 border-t border-(--color-border) pt-3" style={win(T.foot)}>
                  <span class="font-sans text-[15px] leading-[22px] text-(--color-cream-700)">
                    {unchanged} unchanged · 1 to review
                  </span>
                  <span class="rounded-full bg-(--color-sage-400) px-4 py-2 font-label text-[13px] leading-4 uppercase tracking-[0.05em] text-(--color-cream-800)">
                    {stage.switchLabel}
                  </span>
                </div>
              </div>

              <!-- Prompt → replay card -->
              <div class="absolute top-8 left-4 w-[300px] -rotate-3 md:top-10 md:left-8 md:w-[360px]">
                <div class="sc grid rounded-[16px] bg-(--color-sage-800) p-5 shadow-[0_16px_28px_rgba(21,30,25,0.22)] [&>*]:[grid-area:1/1]" style={`${win(T.replayCard)};--dy:-28px`}>
                  <p class="sc self-center font-mono text-[13px] leading-5 text-(--color-sage-100)" style={`${win([-1, 0], T.promptOut)};--dy:0px`}>
                    <span class="text-(--color-sage-400)">&gt;</span>{" "}
                    {promptWords.map((word, i) => {
                      const a = T.words[0] + i * wordStep;
                      return (
                        <span class="sc" style={`${win([a, a + wordStep])};--dy:0px`}>{word}{" "}</span>
                      );
                    })}
                  </p>
                  <div class="sc flex flex-col gap-3" style={`${win(T.replayIn)};--dy:0px`}>
                    <span class="relative block h-4 font-label text-[12px] leading-4 uppercase tracking-[0.05em] text-(--color-sage-300)">
                      <span class="sc absolute left-0" style={`${win([-1, 0], T.replayed)};--dy:0px`}>{stage.replayingLabel}</span>
                      <span class="sc absolute left-0" style={`${win(T.replayed)};--dy:0px`}>{stage.replayedLabel}</span>
                    </span>
                    <span class="font-display text-[22px] leading-[26px] text-(--color-cream-50)">
                      {stage.from} → {stage.to}
                    </span>
                    <span class="flex gap-1.5">
                      {stage.sessions.map((_, i) => (
                        <span class="h-1.5 flex-1 overflow-hidden rounded-full bg-(--color-sage-700)">
                          <span class="sc-fill block h-full w-full rounded-full bg-(--color-sage-400)" style={win(T.bar(i))}></span>
                        </span>
                      ))}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </figure>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @property --hiw-p {
    syntax: "<number>";
    inherits: true;
    initial-value: 1;
  }

  .hiw {
    padding-block: 4rem;
    transition: --hiw-p 0.3s ease-out;
  }
  @media (min-width: 768px) {
    .hiw {
      padding-block: 112px;
    }
  }

  /* Pinned mode: a tall track, a full-height sticky frame under the nav. */
  .hiw[data-scrub] {
    padding-block: 0;
  }
  .hiw[data-scrub] .hiw-track {
    height: 320vh;
  }
  .hiw[data-scrub] .hiw-pin {
    position: sticky;
    top: 0;
    display: flex;
    height: 100vh;
    align-items: center;
    padding-top: 108px; /* the floating nav: 32px offset + 76px bar */
  }

  /* Scrubbed parts. Each derives an in-progress (--a → --b) and an
   * out-progress (--c → --d) from --hiw-p; unset windows mean "always in"
   * and "never out". Opacity and transform only. */
  .sc {
    --tin: clamp(0, (var(--hiw-p) - var(--a, -1)) / (var(--b, 0) - var(--a, -1)), 1);
    --tout: clamp(0, (var(--hiw-p) - var(--c, 2)) / (var(--d, 3) - var(--c, 2)), 1);
    opacity: min(var(--tin), 1 - var(--tout));
    transform: translateY(calc((1 - var(--tin)) * var(--dy, 12px) - var(--tout) * var(--dy, 12px)));
  }
  .sc-fill {
    --tin: clamp(0, (var(--hiw-p) - var(--a)) / (var(--b) - var(--a)), 1);
    transform: scaleX(var(--tin));
    transform-origin: left;
  }
  .sc-lift {
    --tl: clamp(0, (var(--hiw-p) - var(--a)) / (var(--b) - var(--a)), 1);
    transform: translateX(calc(var(--tl) * -14px)) rotate(calc(var(--tl) * -1.5deg));
  }
  .sc-lift .lift-bg {
    opacity: var(--tl);
    box-shadow: 0 10px 24px rgb(60 76 56 / 0.14);
  }

  /* Steps: every step reads as active until pinning starts. */
  .hiw-step path {
    fill: var(--color-sage-800);
    stroke: var(--color-sage-800);
  }
  .hiw-hex > span {
    color: var(--color-cream-50);
  }
  .hiw-title {
    color: var(--color-cream-900);
  }
  .hiw-body {
    grid-template-rows: 1fr;
  }
  .hiw-step path,
  .hiw-hex > span,
  .hiw-title {
    transition: fill 0.3s ease-out, stroke 0.3s ease-out, color 0.3s ease-out;
  }
  .hiw-body {
    transition: grid-template-rows 0.4s ease-out, opacity 0.4s ease-out;
  }

  .hiw[data-scrub] .hiw-detail {
    display: none;
  }
  .hiw[data-scrub] .hiw-step path {
    fill: var(--color-sage-100);
    stroke: var(--color-sage-300);
  }
  .hiw[data-scrub] .hiw-hex > span {
    color: var(--color-sage-700);
  }
  .hiw[data-scrub] .hiw-title {
    color: var(--color-sage-600);
  }
  .hiw[data-scrub] .hiw-body {
    grid-template-rows: 0fr;
    opacity: 0;
  }

  /* The current step, while pinned. */
  .hiw[data-step="1"] .hiw-step[data-i="1"] path,
  .hiw[data-step="2"] .hiw-step[data-i="2"] path,
  .hiw[data-step="3"] .hiw-step[data-i="3"] path {
    fill: var(--color-sage-800);
    stroke: var(--color-sage-800);
  }
  .hiw[data-step="1"] .hiw-step[data-i="1"] .hiw-hex > span,
  .hiw[data-step="2"] .hiw-step[data-i="2"] .hiw-hex > span,
  .hiw[data-step="3"] .hiw-step[data-i="3"] .hiw-hex > span {
    color: var(--color-cream-50);
  }
  .hiw[data-step="1"] .hiw-step[data-i="1"] .hiw-title,
  .hiw[data-step="2"] .hiw-step[data-i="2"] .hiw-title,
  .hiw[data-step="3"] .hiw-step[data-i="3"] .hiw-title {
    color: var(--color-cream-900);
  }
  .hiw[data-step="1"] .hiw-step[data-i="1"] .hiw-body,
  .hiw[data-step="2"] .hiw-step[data-i="2"] .hiw-body,
  .hiw[data-step="3"] .hiw-step[data-i="3"] .hiw-body {
    grid-template-rows: 1fr;
    opacity: 1;
  }
</style>

<script>
  // Pin the section and scrub its stage with the scroll, only where there is
  // room to pin and motion is welcome; everywhere else the finished example
  // stays as rendered.
  const section = document.querySelector<HTMLElement>("[data-hiw]");
  const track = section?.querySelector<HTMLElement>(".hiw-track");
  if (section && track) {
    const mq = window.matchMedia(
      "(min-width: 1024px) and (min-height: 720px) and (prefers-reduced-motion: no-preference)",
    );
    let frame = 0;
    const update = () => {
      frame = 0;
      const rect = track.getBoundingClientRect();
      const span = rect.height - window.innerHeight;
      const p = span > 0 ? Math.min(1, Math.max(0, -rect.top / span)) : 1;
      section.style.setProperty("--hiw-p", p.toFixed(4));
      const step = String(p < 0.28 ? 1 : p < 0.68 ? 2 : 3);
      if (section.dataset.step !== step) section.dataset.step = step;
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    const apply = () => {
      if (mq.matches) {
        section.dataset.scrub = "";
        update();
        window.addEventListener("scroll", schedule, { passive: true });
        window.addEventListener("resize", schedule);
      } else {
        window.removeEventListener("scroll", schedule);
        window.removeEventListener("resize", schedule);
        delete section.dataset.scrub;
        delete section.dataset.step;
        section.style.removeProperty("--hiw-p");
      }
    };
    mq.addEventListener("change", apply);
    apply();
  }
</script>
