---
/**
 * LabsHowItWorks — three numbered steps from the traces a team already has
 * to a model recommendation, typographic rather than carded: a large step
 * number over a hairline, a title, one line of body, and an optional detail
 * (the trace tools' marks, or the exact prompt to give a coding agent). A
 * text link closes the section. Three columns from `lg`, stacked below.
 */
import type { HowItWorksContent } from "../../lib/labs-home";
import "../../styles/labs-scroll-reveal.css";
import {
  BraintrustIcon,
  LangChainIcon,
  LangfuseIcon,
  LogfireIcon,
} from "../kitaru/islands/brand-icons";

interface Props {
  content: HowItWorksContent;
}
const { content } = Astro.props;
const SOURCES = [
  { Icon: LangfuseIcon, name: "Langfuse" },
  { Icon: LangChainIcon, name: "LangSmith" },
  { Icon: LogfireIcon, name: "Logfire" },
  { Icon: BraintrustIcon, name: "Braintrust" },
];
---

<section class="pt-16 pb-16 md:pt-[112px] md:pb-[112px]">
  <div class="scroll-reveal-section mx-auto flex max-w-content flex-col gap-12 px-gutter md:gap-16">
    <div class="reveal-child flex max-w-[900px] flex-col gap-5">
      <h2 class="font-display text-[34px] leading-[38px] text-(--color-cream-900) md:text-[56px] md:leading-[60px]">
        {content.headline}
      </h2>
      <p class="max-w-[680px] font-sans text-[17px] leading-[26px] text-foreground md:text-[18px] md:leading-[28px]">
        {content.intro}
      </p>
    </div>

    <ol class="reveal-child stagger-1 grid grid-cols-1 gap-12 lg:grid-cols-3 lg:gap-10">
      {content.steps.map((step, i) => (
        <li class="flex flex-col gap-4 border-t border-(--color-cream-900) pt-6">
          <span class="font-display text-[56px] leading-[56px] text-(--color-sage-400) md:text-[72px] md:leading-[72px]">
            {i + 1}
          </span>
          <h3 class="font-display text-[24px] leading-[30px] text-(--color-cream-900) md:text-[28px] md:leading-[34px]">
            {step.title}
          </h3>
          <p class="max-w-[420px] font-sans text-[16px] leading-[24px] text-(--color-cream-700)">
            {step.body}
          </p>
          {step.detail?.kind === "sources" && (
            <ul class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-2">
              {SOURCES.map(({ Icon, name }) => (
                <li class="flex items-center gap-1.5 font-sans text-[14px] leading-5 text-(--color-cream-900)">
                  <Icon class="h-4 w-auto" />
                  {name}
                </li>
              ))}
            </ul>
          )}
          {step.detail?.kind === "prompt" && (
            <code class="mt-1 block max-w-[440px] rounded-[12px] bg-(--color-sage-100) px-4 py-3 font-mono text-[14px] leading-[22px] text-(--color-sage-900)">
              {step.detail.text}
            </code>
          )}
        </li>
      ))}
    </ol>

    <a
      href={content.link.href}
      data-analytics={content.link.analytics}
      class="reveal-child stagger-2 group inline-flex w-fit cursor-pointer items-center gap-2 font-sans text-[16px] leading-6 font-medium text-(--color-cream-900) underline decoration-(--color-sage-400) underline-offset-4 transition-colors duration-200 ease-out hover:decoration-(--color-cream-900)"
    >
      {content.link.label}
      <svg class="size-4 transition-transform duration-200 ease-out group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a>
  </div>
</section>
