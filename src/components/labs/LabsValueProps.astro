---
/**
 * LabsValueProps — three-card value-prop grid for /product/zenml (04 Value
 * props). Mono numerals (as in labs.open-source-band) stand in for the icon set that is still being
 * drawn; no icons, no coloured squares. Copy arrives through `content`
 * (`ZENML_VALUE_PROPS` in `src/lib/labs-product-zenml.ts`); nothing here is
 * retyped. `content.deck` is optional — absence collapses the line under
 * the headline. Three cards (or six) sit three across; any other count,
 * such as the four on /open-source-vs-pro, sits two across so no row is left
 * half empty.
 */
import type { ValuePropsContent } from "../../lib/labs-product-zenml";
import "../../styles/labs-scroll-reveal.css";
import LabsButton from "./LabsButton.astro";

interface Props {
  content: ValuePropsContent;
}
const { content } = Astro.props;
const columns =
  content.items.length % 3 === 0 ? "md:grid-cols-3" : "md:grid-cols-2";
---

<section class="py-24 md:py-32">
  <div class="scroll-reveal-section mx-auto max-w-content px-gutter">
    <h2 class="reveal-child font-display text-[32px] leading-[38px] text-(--color-cream-900) text-balance md:text-[48px] md:leading-[54px]">
      {content.headline}
    </h2>
    {content.deck && (
      <p class="reveal-child stagger-1 mt-6 max-w-[720px] font-sans text-[17px] leading-[26px] text-(--color-cream-700)">
        {content.deck}
      </p>
    )}

    <div class="reveal-child stagger-1 mt-space-xl">
      <div class:list={["scroll-reveal-section grid grid-cols-1 gap-6", columns]}>
      {content.items.map((item, index) => (
        <div class:list={["reveal-child flex flex-col gap-space-md rounded-[20px] border border-border bg-card p-8 transition-colors duration-200 ease-out hover:border-(--color-sage-400) md:p-10", `stagger-${Math.min(index + 1, 4)}`]}>
          <span class="font-mono text-[13px] leading-5 text-(--color-sage-700)">
            {item.index}
          </span>
          <h3 class="font-display text-[24px] leading-[30px] text-(--color-cream-900)">
            {item.title}
          </h3>
          <p class="font-sans text-[16px] leading-[24px] text-foreground">
            {item.body}
          </p>
        </div>
      ))}
      </div>
    </div>

    {content.cta && (
      <div class="reveal-child stagger-2 mt-space-mlg flex">
        <LabsButton cta={content.cta} />
      </div>
    )}
  </div>
</section>
