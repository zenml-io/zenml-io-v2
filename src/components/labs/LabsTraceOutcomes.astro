---
/**
 * LabsTraceOutcomes (`labs.trace-outcomes`) — the homepage's "beyond evals"
 * section: three things the AI engineer does with the same traces (finds
 * what the evals miss, fine-tunes a cheaper open model, catches drift and
 * retrains). Each card is a numeral, title and body over a stone example
 * panel: a label, two rows (label, mono value, optional bar) and a foot
 * line. Bars are drawn on the server at their final width; the house reveal
 * brings the head and cards in. Copy arrives through `content`
 * (LABS_TRACE_OUTCOMES on `/`).
 */
import type { OutcomeRow, TraceOutcomesContent } from "../../lib/labs-home";
import "../../styles/labs-scroll-reveal.css";
import { LABS_EYEBROW_CLASS } from "../templates/pageHeaderPresets";

interface Props {
  content: TraceOutcomesContent;
}
const { content } = Astro.props;

const BAR_TONE: Record<NonNullable<OutcomeRow["tone"]>, string> = {
  muted: "bg-(--color-cream-400)",
  good: "bg-(--color-sage-400)",
};
const numeral = (index: number) => `${String(index + 1).padStart(2, "0")}.`;
---

<section class="py-24 md:py-32" aria-labelledby="trace-outcomes-title">
  <div class="scroll-reveal-section mx-auto max-w-content px-gutter">
    <p class:list={["reveal-child", LABS_EYEBROW_CLASS]}>{content.eyebrow}</p>
    <h2 id="trace-outcomes-title" class="reveal-child mt-3 max-w-[860px] font-display text-[32px] leading-[38px] text-balance text-(--color-cream-900) md:text-[48px] md:leading-[54px]">
      {content.headline}
    </h2>
    <p class="reveal-child stagger-1 mt-6 max-w-[720px] font-sans text-[17px] leading-[27px] text-pretty text-(--color-cream-700)">
      {content.deck}
    </p>

    <div class="scroll-reveal-section mt-space-xl grid grid-cols-1 gap-6 lg:grid-cols-3">
      {content.cards.map((card, index) => (
        <article class:list={["reveal-child flex flex-col rounded-[20px] border border-border bg-card p-6 md:p-8", `stagger-${index + 1}`]}>
          <span class="font-mono text-[13px] leading-5 text-(--color-sage-700)">{numeral(index)}</span>
          <h3 class="mt-4 font-display text-[24px] leading-[30px] text-(--color-cream-900)">{card.title}</h3>
          <p class="mt-3 font-sans text-[16px] leading-[24px] text-pretty text-foreground">{card.body}</p>

          <div class="mt-auto pt-6">
            <div class="rounded-[12px] bg-(--secondary-fill) p-4">
              <p class:list={[LABS_EYEBROW_CLASS]}>{card.example.label}</p>
              <dl class="mt-3 flex flex-col gap-3">
                {card.example.rows.map((row) => (
                  <div>
                    <div class="flex items-baseline justify-between gap-4">
                      <dt class="font-sans text-[13px] leading-[18px] text-(--muted-foreground)">{row.label}</dt>
                      <dd class:list={["shrink-0 font-mono text-[14px] leading-5", row.tone === "good" ? "text-(--color-sage-700)" : "text-(--color-cream-900)"]}>{row.value}</dd>
                    </div>
                    {row.bar !== undefined && row.tone && (
                      <div class="mt-1.5 h-1.5 w-full rounded-full bg-(--muted)" aria-hidden="true">
                        <div class:list={["h-full rounded-full", BAR_TONE[row.tone]]} style={`width: ${Math.round(row.bar * 100)}%`}></div>
                      </div>
                    )}
                  </div>
                ))}
              </dl>
              <p class="mt-3 border-t border-border pt-3 font-sans text-[13px] leading-[18px] font-medium text-(--color-sage-700)">{card.example.foot}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
