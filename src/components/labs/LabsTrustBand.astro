---
/**
 * LabsTrustBand (`labs.trust-band`) — an industry page's security section
 * on a sage-50 band: eyebrow, headline, deck and the SOC 2 / ISO 27001
 * badges in a 5/12 column (above on phones), then the security points as
 * numbered hairline rows in a 1 → 2 grid in the 7/12 column. Static.
 * Copy arrives through `content: TrustBandContent` (src/lib/labs-industries.ts).
 */
import type { TrustBandContent } from "../../lib/labs-industries";
import { LABS_EYEBROW_CLASS } from "../templates/pageHeaderPresets";

interface Props {
  content: TrustBandContent;
}
const { content } = Astro.props;
---

<section id="security" class="scroll-reveal-section bg-(--color-sage-50) py-24 md:py-32" aria-labelledby="trust-title">
  <div class="mx-auto grid max-w-content grid-cols-1 gap-12 px-gutter lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
    <div class="reveal-child">
      <p class={LABS_EYEBROW_CLASS}>{content.eyebrow}</p>
      <h2 id="trust-title" class="mt-3 font-display text-[32px] leading-[38px] text-balance text-(--color-cream-900) md:text-[48px] md:leading-[54px]">
        {content.headline}
      </h2>
      <p class="mt-6 font-sans text-[17px] leading-[27px] text-(--color-cream-700)">{content.deck}</p>
      <div class="mt-space-mlg flex flex-wrap items-center gap-6">
        {content.badges.map((badge) => (
          <img src={badge.url} alt={badge.alt} class="h-20 w-auto object-contain" loading="lazy" />
        ))}
      </div>
    </div>

    <ol class="reveal-child stagger-1 grid min-w-0 list-none grid-cols-1 gap-x-10 md:grid-cols-2">
      {content.points.map((point, index) => (
        <li class="border-t border-(--color-cream-900) pt-5 pb-8">
          <span class="font-mono text-[13px] leading-5 text-(--color-sage-700)">{String(index + 1).padStart(2, "0")}</span>
          <h3 class="mt-2 font-display text-[22px] leading-[28px] text-(--color-cream-900)">{point.title}</h3>
          <p class="mt-2 font-sans text-[16px] leading-[25px] text-(--color-cream-700)">{point.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
