---
/**
 * LabsModelChoiceVisual — the homepage hero's animated explainer of model
 * choice, in four beats: the agent's existing traces slide in, pulses carry
 * their calls to four candidate models, each model's row of marks fills in
 * (match or differs, per call), then the goals cycle and the highlight moves
 * to the model that wins each one. The trace tools and models are named
 * with their marks so the picture reads as the visitor's own stack.
 *
 * Pure SVG and CSS, no island. Two drawings share the markup recipe: a wide
 * one from `lg` and a compact one below it, re-authored rather than scaled
 * so labels stay legible. Under reduced motion everything is drawn at once
 * and the highlight rests on "Best mix".
 */

import {
  AnthropicIcon,
  BraintrustIcon,
  LangChainIcon,
  LangfuseIcon,
  LogfireIcon,
  OpenAIIcon,
} from "../kitaru/islands/brand-icons";

interface Props {
  /** Accessible summary of what the animation shows. */
  label: string;
}
const { label } = Astro.props;

type ModelId = "today" | "haiku" | "deepseek" | "glm";
/** `open` and `chip` are neutral glyphs for models without an approved
 *  service-logo mark yet (see DESIGN.md "Integration cards keep their marks"). */
type Mark = "openai" | "anthropic" | "open" | "chip";
const MODELS: {
  id: ModelId;
  name: string;
  /** Shorter label for the compact drawing. */
  short: string;
  mark: Mark;
  marks: string;
}[] = [
  {
    id: "today",
    name: "GPT-6 · today",
    short: "GPT-6 · today",
    mark: "openai",
    marks: "11111111",
  },
  {
    id: "haiku",
    name: "Claude Haiku 5.5",
    short: "Haiku 5.5",
    mark: "anthropic",
    marks: "11110111",
  },
  {
    id: "deepseek",
    name: "DeepSeek",
    short: "DeepSeek",
    mark: "open",
    marks: "11101101",
  },
  {
    id: "glm",
    name: "GLM · local",
    short: "GLM · local",
    mark: "chip",
    marks: "10110110",
  },
];
/** Goal chips in cycle order; the CSS below highlights each one's winners. */
const GOALS = ["Closest", "Cheapest", "Fastest", "Open", "Best mix"];
/** Trace tools shown over the traces column. */
const SOURCES = [LangfuseIcon, LangChainIcon, LogfireIcon, BraintrustIcon];

interface Geometry {
  w: number;
  h: number;
  traceX: number;
  traceW: number;
  traceRows: number;
  rowH: number;
  rowGap: number;
  traceTop: number;
  modelX: number;
  modelW: number;
  modelH: number;
  modelTop: number;
  modelGap: number;
  markX: number;
  mark: number;
  markGap: number;
  chipY: number;
  labelSize: number;
  headSize: number;
  chipSize: number;
  /** Use each model's short label. */
  shortNames: boolean;
}

const WIDE: Geometry = {
  w: 680,
  h: 560,
  traceX: 0,
  traceW: 150,
  traceRows: 7,
  rowH: 26,
  rowGap: 12,
  traceTop: 120,
  modelX: 250,
  modelW: 200,
  modelH: 46,
  modelTop: 96,
  modelGap: 30,
  markX: 474,
  mark: 15,
  markGap: 9,
  chipY: 470,
  labelSize: 17,
  headSize: 13,
  chipSize: 14,
  shortNames: false,
};

const COMPACT: Geometry = {
  w: 360,
  h: 380,
  traceX: 0,
  traceW: 74,
  traceRows: 6,
  rowH: 18,
  rowGap: 9,
  traceTop: 70,
  modelX: 104,
  modelW: 128,
  modelH: 34,
  modelTop: 56,
  modelGap: 18,
  markX: 242,
  mark: 10,
  markGap: 4,
  chipY: 316,
  labelSize: 13,
  headSize: 11,
  chipSize: 11,
  shortNames: true,
};

function build(g: Geometry) {
  const traces = Array.from({ length: g.traceRows }, (_, i) => ({
    y: g.traceTop + i * (g.rowH + g.rowGap),
    dots: [0.18, 0.42, 0.62, 0.84].slice(0, 2 + (i % 3)),
  }));
  const traceMidY =
    g.traceTop + (g.traceRows * (g.rowH + g.rowGap) - g.rowGap) / 2;
  const fromX = g.traceX + g.traceW + 8;
  const models = MODELS.map((m, i) => {
    const y = g.modelTop + i * (g.modelH + g.modelGap);
    const cy = y + g.modelH / 2;
    const midX = (fromX + g.modelX) / 2;
    return {
      ...m,
      y,
      cy,
      path: `M ${fromX} ${traceMidY} C ${midX} ${traceMidY}, ${midX} ${cy}, ${g.modelX - 6} ${cy}`,
    };
  });
  const chips = GOALS.map((name, i) => ({ name, i }));
  return { g, traces, models, chips, traceMidY };
}

const drawings = [
  { key: "wide", cls: "hidden lg:block", ...build(WIDE) },
  { key: "compact", cls: "block lg:hidden", ...build(COMPACT) },
];
---

<figure class="mcv w-full" role="img" aria-label={label}>
  {drawings.map(({ key, cls, g, traces, models, chips }) => {
    const chipW = (g.w - (chips.length - 1) * 8) / chips.length;
    return (
      <svg
        class={`mcv-svg w-full ${cls}`}
        viewBox={`0 0 ${g.w} ${g.h}`}
        aria-hidden="true"
        data-variant={key}
      >
        <g class="mcv-trace" style="--d: 0ms">
          {SOURCES.map((Icon, i) => {
            const d = g.rowH * 1.25;
            const cx = g.traceX + d / 2 + i * (d + g.rowH * 0.35);
            const cy = g.traceTop - d / 2 - 12;
            const icon = d * 0.56;
            return (
              <g>
                <circle
                  cx={cx}
                  cy={cy}
                  r={d / 2}
                  class="fill-(--color-cream-50) stroke-(--color-sage-300)"
                />
                <Icon
                  x={cx - icon / 2}
                  y={cy - icon / 2}
                  width={icon}
                  height={icon}
                  class="text-(--color-cream-900)"
                />
              </g>
            );
          })}
        </g>


        {traces.map((row, i) => (
          <g class="mcv-trace" style={`--d: ${i * 70}ms`}>
            <rect
              x={g.traceX}
              y={row.y}
              width={g.traceW}
              height={g.rowH}
              rx={g.rowH / 2}
              class="fill-(--color-cream-50) stroke-(--color-sage-300)"
            />
            {row.dots.map((at) => (
              <circle
                cx={g.traceX + g.traceW * at}
                cy={row.y + g.rowH / 2}
                r={g.rowH * 0.16}
                class="fill-(--color-sage-600)"
              />
            ))}
          </g>
        ))}

        {models.map((m, i) => (
          <g>
            <path
              d={m.path}
              class="mcv-wire stroke-(--color-sage-400)"
              fill="none"
              stroke-width={1.5}
              pathLength="1"
              style={`--d: ${900 + i * 90}ms`}
            />
            <circle
              r={g.mark * 0.28}
              class="mcv-pulse fill-(--color-sage-800)"
              style={`offset-path: path("${m.path}"); --d: ${1700 + i * 260}ms`}
            />
          </g>
        ))}

        {models.map((m, i) => (
          <g class="mcv-model" style={`--d: ${700 + i * 90}ms`} data-model={m.id}>
            <rect
              x={g.modelX}
              y={m.y}
              width={g.modelW}
              height={g.modelH}
              rx={g.modelH / 2}
              class="mcv-node fill-(--color-cream-50) stroke-(--color-sage-400)"
              stroke-width={1.5}
              stroke-dasharray={m.id === "today" ? "4 4" : undefined}
            />
            <rect
              x={g.modelX}
              y={m.y}
              width={g.modelW}
              height={g.modelH}
              rx={g.modelH / 2}
              class={`mcv-win mcv-win-${m.id} fill-(--color-sage-800)`}
            />
            {[
              "mcv-name text-(--color-cream-900)",
              `mcv-win mcv-win-${m.id} text-(--color-cream-50)`,
            ].map((layer) => {
              const icon = g.labelSize * 1.15;
              const ix = g.modelX + g.modelH * 0.42;
              const iy = m.cy - icon / 2;
              return (
                <g class={layer}>
                  {m.mark === "openai" && (
                    <OpenAIIcon x={ix} y={iy} width={icon} height={icon} />
                  )}
                  {m.mark === "anthropic" && (
                    <AnthropicIcon x={ix} y={iy} width={icon} height={icon} />
                  )}
                  {m.mark === "open" && (
                    <g fill="none" stroke="currentColor" stroke-width={1.6}>
                      <circle
                        cx={ix + icon / 2}
                        cy={iy + icon / 2}
                        r={icon * 0.42}
                      />
                      <path
                        d={`M ${ix + icon * 0.3} ${iy + icon / 2} h ${icon * 0.4} M ${ix + icon / 2} ${iy + icon * 0.3} v ${icon * 0.4}`}
                      />
                    </g>
                  )}
                  {m.mark === "chip" && (
                    <g fill="none" stroke="currentColor" stroke-width={1.6}>
                      <rect
                        x={ix + icon * 0.18}
                        y={iy + icon * 0.18}
                        width={icon * 0.64}
                        height={icon * 0.64}
                        rx={icon * 0.12}
                      />
                      <path
                        d={`M ${ix + icon * 0.38} ${iy} v ${icon * 0.18} M ${ix + icon * 0.62} ${iy} v ${icon * 0.18} M ${ix + icon * 0.38} ${iy + icon * 0.82} v ${icon * 0.18} M ${ix + icon * 0.62} ${iy + icon * 0.82} v ${icon * 0.18}`}
                      />
                    </g>
                  )}
                  <text
                    x={ix + icon + g.labelSize * 0.55}
                    y={m.cy + g.labelSize * 0.35}
                    fill="currentColor"
                    class="font-sans"
                    font-size={g.labelSize}
                  >
                    {g.shortNames ? m.short : m.name}
                  </text>
                </g>
              );
            })}
            {[...m.marks].map((bit, j) => (
              <rect
                x={g.markX + j * (g.mark + g.markGap)}
                y={m.cy - g.mark / 2}
                width={g.mark}
                height={g.mark}
                rx={g.mark * 0.28}
                class={`mcv-mark ${bit === "1" ? "fill-(--color-sage-700) stroke-(--color-sage-700)" : "fill-(--color-cream-50) stroke-(--color-cream-500)"}`}
                stroke-width={1.5}
                style={`--d: ${2000 + i * 120 + j * 55}ms`}
              />
            ))}
          </g>
        ))}

        {chips.map((chip) => (
          <g class="mcv-chip" style={`--d: ${2900 + chip.i * 60}ms`}>
            <rect
              x={chip.i * (chipW + 8)}
              y={g.chipY}
              width={chipW}
              height={g.chipSize * 2.6}
              rx={g.chipSize * 1.3}
              class="fill-(--color-cream-50) stroke-(--color-sage-300)"
            />
            <rect
              x={chip.i * (chipW + 8)}
              y={g.chipY}
              width={chipW}
              height={g.chipSize * 2.6}
              rx={g.chipSize * 1.3}
              class={`mcv-goal mcv-goal-${chip.i} fill-(--color-sage-800)`}
            />
            <text
              x={chip.i * (chipW + 8) + chipW / 2}
              y={g.chipY + g.chipSize * 1.3 + g.chipSize * 0.36}
              text-anchor="middle"
              class="fill-(--color-cream-900) font-label uppercase"
              font-size={g.chipSize}
            >
              {chip.name}
            </text>
            <text
              x={chip.i * (chipW + 8) + chipW / 2}
              y={g.chipY + g.chipSize * 1.3 + g.chipSize * 0.36}
              text-anchor="middle"
              class={`mcv-goal mcv-goal-${chip.i} fill-(--color-cream-50) font-label uppercase`}
              font-size={g.chipSize}
            >
              {chip.name}
            </text>
          </g>
        ))}
      </svg>
    );
  })}
</figure>

<style>
  /* Beats 1–3 play once on load; beat 4 (the goal cycle) loops every 10s,
     one goal per 2s. A highlight class is opaque only during its goals'
     windows, so the chip and its winning models switch together. */
  .mcv :global(.mcv-win),
  .mcv :global(.mcv-goal) {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mcv :global(.mcv-trace) {
      animation: mcv-slide 520ms cubic-bezier(0.16, 1, 0.3, 1) var(--d) both;
    }
    .mcv :global(.mcv-model),
    .mcv :global(.mcv-chip) {
      animation: mcv-fade 420ms ease-out var(--d) both;
    }
    .mcv :global(.mcv-wire) {
      stroke-dasharray: 1;
      animation: mcv-draw 700ms cubic-bezier(0.65, 0, 0.35, 1) var(--d) both;
    }
    .mcv :global(.mcv-mark) {
      animation: mcv-fade 260ms ease-out var(--d) both;
    }
    .mcv :global(.mcv-pulse) {
      opacity: 0;
      animation: mcv-travel 2.6s cubic-bezier(0.45, 0, 0.55, 1) var(--d)
        infinite;
    }
    .mcv :global(.mcv-goal-0) { animation: mcv-goal-0 10s linear 3.4s infinite; }
    .mcv :global(.mcv-goal-1) { animation: mcv-goal-1 10s linear 3.4s infinite; }
    .mcv :global(.mcv-goal-2) { animation: mcv-goal-2 10s linear 3.4s infinite; }
    .mcv :global(.mcv-goal-3) { animation: mcv-goal-3 10s linear 3.4s infinite; }
    .mcv :global(.mcv-goal-4) { animation: mcv-goal-4 10s linear 3.4s infinite; }
    /* Haiku wins Closest (0–20%) and Fastest (40–60%); DeepSeek wins
       Cheapest (20–40%) and Open (60–80%); Best mix (80–100%) is both.
       GLM, run locally, is compared but too far off to win. */
    .mcv :global(.mcv-win-haiku) { animation: mcv-win-haiku 10s linear 3.4s infinite; }
    .mcv :global(.mcv-win-deepseek) { animation: mcv-win-deepseek 10s linear 3.4s infinite; }
  }

  /* Reduced motion: the finished picture, resting on "Best mix". */
  @media (prefers-reduced-motion: reduce) {
    .mcv :global(.mcv-pulse) {
      display: none;
    }
    .mcv :global(.mcv-goal-4),
    .mcv :global(.mcv-win-haiku),
    .mcv :global(.mcv-win-deepseek) {
      opacity: 1;
    }
  }

  @keyframes mcv-slide {
    from { opacity: 0; transform: translateX(-14px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes mcv-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes mcv-draw {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }
  @keyframes mcv-travel {
    0% { offset-distance: 0%; opacity: 0; }
    12% { opacity: 1; }
    80% { opacity: 1; }
    100% { offset-distance: 100%; opacity: 0; }
  }
  @keyframes mcv-goal-0 { 0%, 18% { opacity: 1; } 20%, 100% { opacity: 0; } }
  @keyframes mcv-goal-1 { 0%, 18% { opacity: 0; } 20%, 38% { opacity: 1; } 40%, 100% { opacity: 0; } }
  @keyframes mcv-goal-2 { 0%, 38% { opacity: 0; } 40%, 58% { opacity: 1; } 60%, 100% { opacity: 0; } }
  @keyframes mcv-goal-3 { 0%, 58% { opacity: 0; } 60%, 78% { opacity: 1; } 80%, 100% { opacity: 0; } }
  @keyframes mcv-goal-4 { 0%, 78% { opacity: 0; } 80%, 98% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes mcv-win-haiku {
    0%, 18% { opacity: 1; }
    20%, 38% { opacity: 0; }
    40%, 58% { opacity: 1; }
    60%, 78% { opacity: 0; }
    80%, 98% { opacity: 1; }
    100% { opacity: 0; }
  }
  @keyframes mcv-win-deepseek {
    0%, 18% { opacity: 0; }
    20%, 38% { opacity: 1; }
    40%, 58% { opacity: 0; }
    60%, 98% { opacity: 1; }
    100% { opacity: 0; }
  }
</style>
