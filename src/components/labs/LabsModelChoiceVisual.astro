---
/**
 * LabsModelChoiceVisual — the homepage hero's explainer of model choice, as
 * an outcome you can read: an agent's kinds of calls as rows, every one on
 * today's model, then the rows switch one by one to the model each would
 * move to, ending on a best mix where one row stays put. It plays once and
 * stops on that result. Copy and models arrive through `content`.
 *
 * Plain HTML and CSS, no island. The rows reflow at every width, so phones
 * get the same picture. The finished result is the resting state, so
 * reduced-motion and no-JS visitors see it at once.
 */
import type { HeroVisualContent } from "../../lib/labs-home";
import {
  BraintrustIcon,
  LangChainIcon,
  LangfuseIcon,
  LogfireIcon,
} from "../kitaru/islands/brand-icons";
import LabsModelMark from "./LabsModelMark.astro";

interface Props {
  content: HeroVisualContent;
}
const { content } = Astro.props;
const SOURCES = [LangfuseIcon, LangChainIcon, LogfireIcon, BraintrustIcon];
const today = content.models[content.today];
/** When the first row switches, and the gap between rows. */
const FIRST_MS = 1100;
const STEP_MS = 650;
const endMs = FIRST_MS + content.rows.length * STEP_MS;
---

<figure
  class="hv rounded-[24px] border border-(--color-border) bg-card p-6 md:p-8"
  aria-label={content.label}
>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <p class="font-display text-[20px] leading-[26px] text-(--color-cream-900)">
      {content.agent}
    </p>
    <span class="flex items-center gap-1.5" aria-hidden="true">
      {SOURCES.map((Icon) => (
        <span class="flex size-7 items-center justify-center rounded-full border border-(--color-border) bg-(--color-cream-50) text-(--color-cream-900)">
          <Icon class="h-3.5 w-auto" />
        </span>
      ))}
    </span>
  </div>

  <ol class="mt-5 flex flex-col">
    {content.rows.map((row, i) => {
      const target = content.models[row.model];
      const moves = row.model !== content.today;
      return (
        <li
          class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-t border-(--color-border) py-3.5"
          style={`--at: ${FIRST_MS + i * STEP_MS}ms`}
        >
          <span class="font-sans text-[16px] leading-6 text-(--color-cream-900)">
            {row.call}
          </span>
          <span class="flex items-center gap-2">
            {moves ? (
              <>
                <span class="hv-was font-sans text-[14px] leading-5 text-(--color-cream-700)">
                  {today.name}
                </span>
                <svg
                  class="hv-arrow size-3.5 text-(--color-sage-800)"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-label="moves to"
                  role="img"
                >
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
                <span class="hv-new inline-flex items-center gap-1.5 rounded-full bg-(--color-sage-800) px-3 py-1 font-sans text-[14px] leading-5 font-medium text-(--color-cream-50)">
                  <LabsModelMark mark={target.mark} />
                  {target.name}
                </span>
              </>
            ) : (
              <>
                <span class="inline-flex items-center gap-1.5 rounded-full border border-(--color-border) bg-(--color-cream-50) px-3 py-1 font-sans text-[14px] leading-5 font-medium text-(--color-cream-900)">
                  <LabsModelMark mark={target.mark} />
                  {target.name}
                </span>
                <span class="hv-stays font-sans text-[14px] leading-5 text-(--color-cream-700)">
                  {content.staysLabel}
                </span>
              </>
            )}
          </span>
        </li>
      );
    })}
  </ol>

  <p
    class="hv-outcome border-t border-(--color-border) pt-4 font-sans text-[15px] leading-[22px] text-(--color-cream-900)"
    style={`--at: ${endMs}ms`}
  >
    {content.outcome}
  </p>
</figure>

<style>
  /* Each switching row: today's model is struck through, then the arrow
     and the new model arrive. The row that stays gets its note, and the
     outcome line lands last. Plays once and rests on the result. */
  .hv :global(.hv-was) {
    text-decoration: line-through;
    text-decoration-color: var(--color-cream-500);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hv :global(.hv-was) {
      animation: hv-strike 300ms ease-out var(--at) both;
    }
    .hv :global(.hv-arrow),
    .hv :global(.hv-new) {
      animation: hv-in 420ms cubic-bezier(0.16, 1, 0.3, 1) var(--at) both;
    }
    .hv :global(.hv-stays),
    .hv :global(.hv-outcome) {
      animation: hv-fade 420ms ease-out var(--at) both;
    }
  }
  @keyframes hv-strike {
    from {
      text-decoration-color: transparent;
    }
    to {
      text-decoration-color: var(--color-cream-500);
    }
  }
  @keyframes hv-in {
    from {
      opacity: 0;
      transform: translateX(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes hv-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
