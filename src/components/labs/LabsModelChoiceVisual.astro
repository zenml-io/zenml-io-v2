---
/**
 * LabsModelChoiceVisual — the homepage hero's explainer: one proposed update
 * to an agent at a time (a model swap, a prompt version, a config value, a
 * harness setting), replayed on the same recorded sessions. Each session
 * settles into "same" or "differs · review", and a closing line counts what
 * is safe and what needs a human. The updates cycle every few seconds;
 * which sessions differ depends on the update. Copy arrives through
 * `content`.
 *
 * Every update's chip, marks and outcome are rendered and stacked in the
 * same grid cell, and CSS crossfades between them, so it needs no island
 * and runs with JS off. Under reduced motion it rests on the first update.
 * A visually hidden caption carries the example as text.
 */
import type { HeroVisualContent } from "../../lib/labs-home";
import {
  BraintrustIcon,
  LangChainIcon,
  LangfuseIcon,
  LogfireIcon,
} from "../kitaru/islands/brand-icons";
import LabsModelMark from "./LabsModelMark.astro";

interface Props {
  content: HeroVisualContent;
}
const { content } = Astro.props;
const SOURCES = [LangfuseIcon, LangChainIcon, LogfireIcon, BraintrustIcon];
const count = content.updates.length;
/** Seconds each update stays on screen. */
const HOLD_S = 3.2;
const cycleS = HOLD_S * count;
const stateStyle = (i: number) =>
  `--state-delay: ${i * HOLD_S - cycleS}s; --cycle: ${cycleS}s`;
const outcome = (differs: number) => {
  const same = content.sessions.length - differs;
  return differs === 0
    ? `${same} unchanged · nothing to review`
    : `${same} unchanged · ${differs} for you to review`;
};
---

<figure
  class="hv rounded-[24px] border border-(--color-border) bg-card p-6 md:p-8"
  style={`--states: ${count}`}
>
  {/* The animated states are aria-hidden; this caption carries the whole
      example as plain text for screen readers and crawlers. */}
  <figcaption class="sr-only">{content.label}</figcaption>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <p class="font-label text-[13px] leading-5 uppercase tracking-[0.05em] text-(--color-sage-800)">
      {content.updateLabel}
    </p>
    <span class="flex items-center gap-1.5" aria-hidden="true">
      {SOURCES.map((Icon) => (
        <span class="flex size-7 items-center justify-center rounded-full border border-(--color-border) bg-(--color-cream-50) text-(--color-cream-900)">
          <Icon class="h-3.5 w-auto" />
        </span>
      ))}
    </span>
  </div>

  <div class="hv-stack mt-3" aria-hidden="true">
    {content.updates.map((update, i) => (
      <p class="hv-state flex flex-wrap items-center gap-x-3 gap-y-1" style={stateStyle(i)}>
        <span class="font-display text-[26px] leading-[32px] text-(--color-cream-900) md:text-[30px] md:leading-[36px]">
          {update.kind}
        </span>
        <span class="flex flex-wrap items-center gap-2 font-sans text-[16px] leading-6">
          <span class="inline-flex items-center gap-1.5 whitespace-nowrap text-(--color-cream-700) line-through decoration-(--color-cream-500)">
            {update.fromMark && <LabsModelMark mark={update.fromMark} />}
            {update.from}
          </span>
          <svg class="size-4 text-(--color-sage-800)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          <span class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-full bg-(--color-sage-800) px-3 py-1 font-medium text-(--color-cream-50)">
            {update.toMark && <LabsModelMark mark={update.toMark} />}
            {update.to}
          </span>
        </span>
      </p>
    ))}
  </div>

  <ol class="mt-5 flex flex-col" aria-hidden="true">
    {content.sessions.map((session, row) => (
      <li class="flex items-center justify-between gap-4 border-t border-(--color-border) py-3.5">
        <span class="font-sans text-[16px] leading-6 text-(--color-cream-900)">
          {session}
        </span>
        <span class="hv-stack justify-items-end">
          {content.updates.map((update, i) => {
            const differs = update.differs.includes(row);
            return (
              <span
                class={`hv-state inline-flex items-center gap-1.5 whitespace-nowrap rounded-full px-3 py-1 font-sans text-[14px] leading-5 ${differs ? "border border-(--color-cream-400) bg-(--color-cream-50) text-(--color-cream-900)" : "text-(--color-sage-800)"}`}
                style={stateStyle(i)}
              >
                {differs ? (
                  <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 8v5M12 16.5v.5" /></svg>
                ) : (
                  <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L19 7" /></svg>
                )}
                {differs ? content.differsLabel : content.sameLabel}
              </span>
            );
          })}
        </span>
      </li>
    ))}
  </ol>

  <div class="hv-stack border-t border-(--color-border) pt-4" aria-hidden="true">
    {content.updates.map((update, i) => (
      <p class="hv-state font-sans text-[15px] leading-[22px] font-medium text-(--color-cream-900)" style={stateStyle(i)}>
        {outcome(update.differs.length)}
      </p>
    ))}
  </div>
</figure>

<style>
  /* All states share one grid cell; each is visible for its slice of the
     cycle. A negative delay starts the loop already running, so the first
     update shows at once instead of after a blank pause. */
  .hv :global(.hv-stack) {
    display: grid;
  }
  .hv :global(.hv-stack > .hv-state) {
    grid-area: 1 / 1;
    opacity: 0;
  }
  .hv :global(.hv-stack > .hv-state:first-child) {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hv :global(.hv-stack > .hv-state) {
      animation: hv-slot var(--cycle) linear var(--state-delay) infinite both;
    }
  }
  /* One update's window is 1/states of the cycle (25% for four), with a
     short crossfade at each edge. */
  @keyframes hv-slot {
    0% {
      opacity: 0;
    }
    2%,
    23% {
      opacity: 1;
    }
    25%,
    100% {
      opacity: 0;
    }
  }
</style>
