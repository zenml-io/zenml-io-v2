---
/**
 * LabsModelChoiceVisual — the homepage hero's animated explainer of model
 * choice, in four beats: the agent's existing traces slide in, pulses carry
 * their calls to four candidate models, each model's row of marks fills in
 * (match or differs, per call), then the goals cycle and the highlight moves
 * to the model that wins each one. The pattern is illustrative and carries
 * no figures; the winners follow the comparison's own rules applied to it
 * (closest = most matches besides today's; cheapest and fastest = only
 * among candidates close to that; local is free but too far off to win).
 *
 * Pure SVG and CSS, no island. Two drawings share the markup recipe: a wide
 * one from `lg` and a compact one below it, re-authored rather than scaled
 * so labels stay legible. Under reduced motion everything is drawn at once
 * and the highlight rests on "Best mix".
 */

interface Props {
  /** Accessible summary of what the animation shows. */
  label: string;
}
const { label } = Astro.props;

type ModelId = "today" | "cheaper" | "open" | "local";
const MODELS: { id: ModelId; name: string; marks: string }[] = [
  { id: "today", name: "Today's model", marks: "11111111" },
  { id: "cheaper", name: "Cheaper model", marks: "11110111" },
  { id: "open", name: "Open model", marks: "11011011" },
  { id: "local", name: "Local model", marks: "10010110" },
];
/** Goal chips in cycle order, and the models each one highlights. */
const GOALS: { name: string; winners: ModelId[] }[] = [
  { name: "Closest", winners: ["cheaper"] },
  { name: "Cheapest", winners: ["open"] },
  { name: "Fastest", winners: ["cheaper"] },
  { name: "Open", winners: ["open"] },
  { name: "Best mix", winners: ["cheaper", "open"] },
];

interface Geometry {
  w: number;
  h: number;
  traceX: number;
  traceW: number;
  traceRows: number;
  rowH: number;
  rowGap: number;
  traceTop: number;
  modelX: number;
  modelW: number;
  modelH: number;
  modelTop: number;
  modelGap: number;
  markX: number;
  mark: number;
  markGap: number;
  chipY: number;
  labelSize: number;
  headSize: number;
  chipSize: number;
  /** Heading over the marks column; shorter where the drawing is narrow. */
  marksHead: string;
}

const WIDE: Geometry = {
  w: 680,
  h: 560,
  traceX: 0,
  traceW: 150,
  traceRows: 7,
  rowH: 26,
  rowGap: 12,
  traceTop: 120,
  modelX: 250,
  modelW: 170,
  modelH: 46,
  modelTop: 96,
  modelGap: 30,
  markX: 446,
  mark: 16,
  markGap: 12,
  chipY: 470,
  labelSize: 17,
  headSize: 13,
  chipSize: 14,
  marksHead: "Answers like today?",
};

const COMPACT: Geometry = {
  w: 360,
  h: 380,
  traceX: 0,
  traceW: 74,
  traceRows: 6,
  rowH: 18,
  rowGap: 9,
  traceTop: 70,
  modelX: 110,
  modelW: 118,
  modelH: 34,
  modelTop: 56,
  modelGap: 18,
  markX: 240,
  mark: 10,
  markGap: 5,
  chipY: 316,
  labelSize: 13,
  headSize: 11,
  chipSize: 11,
  marksHead: "Like today?",
};

function build(g: Geometry) {
  const traces = Array.from({ length: g.traceRows }, (_, i) => ({
    y: g.traceTop + i * (g.rowH + g.rowGap),
    dots: [0.18, 0.42, 0.62, 0.84].slice(0, 2 + (i % 3)),
  }));
  const traceMidY =
    g.traceTop + (g.traceRows * (g.rowH + g.rowGap) - g.rowGap) / 2;
  const fromX = g.traceX + g.traceW + 8;
  const models = MODELS.map((m, i) => {
    const y = g.modelTop + i * (g.modelH + g.modelGap);
    const cy = y + g.modelH / 2;
    const midX = (fromX + g.modelX) / 2;
    return {
      ...m,
      y,
      cy,
      path: `M ${fromX} ${traceMidY} C ${midX} ${traceMidY}, ${midX} ${cy}, ${g.modelX - 6} ${cy}`,
    };
  });
  const chips = GOALS.map((goal, i) => ({ ...goal, i }));
  return { g, traces, models, chips, traceMidY };
}

const drawings = [
  { key: "wide", cls: "hidden lg:block", ...build(WIDE) },
  { key: "compact", cls: "block lg:hidden", ...build(COMPACT) },
];
---

<figure class="mcv w-full" role="img" aria-label={label}>
  {drawings.map(({ key, cls, g, traces, models, chips }) => {
    const chipW = (g.w - (chips.length - 1) * 8) / chips.length;
    return (
      <svg
        class={`mcv-svg w-full ${cls}`}
        viewBox={`0 0 ${g.w} ${g.h}`}
        aria-hidden="true"
        data-variant={key}
      >
        <text
          x={g.traceX}
          y={g.traceTop - 26}
          class="fill-(--color-sage-800) font-label uppercase"
          font-size={g.headSize}
          letter-spacing="0.05em"
        >
          Your traces
        </text>
        <text
          x={g.modelX}
          y={g.modelTop - 22}
          class="fill-(--color-sage-800) font-label uppercase"
          font-size={g.headSize}
          letter-spacing="0.05em"
        >
          Tried on
        </text>

        <text
          x={g.markX}
          y={g.modelTop - 22}
          class="fill-(--color-sage-800) font-label uppercase"
          font-size={g.headSize}
          letter-spacing="0.05em"
        >
          {g.marksHead}
        </text>

        {traces.map((row, i) => (
          <g class="mcv-trace" style={`--d: ${i * 70}ms`}>
            <rect
              x={g.traceX}
              y={row.y}
              width={g.traceW}
              height={g.rowH}
              rx={g.rowH / 2}
              class="fill-(--color-cream-50) stroke-(--color-sage-300)"
            />
            {row.dots.map((at) => (
              <circle
                cx={g.traceX + g.traceW * at}
                cy={row.y + g.rowH / 2}
                r={g.rowH * 0.16}
                class="fill-(--color-sage-600)"
              />
            ))}
          </g>
        ))}

        {models.map((m, i) => (
          <g>
            <path
              d={m.path}
              class="mcv-wire stroke-(--color-sage-400)"
              fill="none"
              stroke-width={1.5}
              pathLength="1"
              style={`--d: ${900 + i * 90}ms`}
            />
            <circle
              r={g.mark * 0.28}
              class="mcv-pulse fill-(--color-sage-800)"
              style={`offset-path: path("${m.path}"); --d: ${1700 + i * 260}ms`}
            />
          </g>
        ))}

        {models.map((m, i) => (
          <g class="mcv-model" style={`--d: ${700 + i * 90}ms`} data-model={m.id}>
            <rect
              x={g.modelX}
              y={m.y}
              width={g.modelW}
              height={g.modelH}
              rx={g.modelH / 2}
              class="mcv-node fill-(--color-cream-50) stroke-(--color-sage-400)"
              stroke-width={1.5}
              stroke-dasharray={m.id === "today" ? "4 4" : undefined}
            />
            <rect
              x={g.modelX}
              y={m.y}
              width={g.modelW}
              height={g.modelH}
              rx={g.modelH / 2}
              class={`mcv-win mcv-win-${m.id} fill-(--color-sage-800)`}
            />
            <text
              x={g.modelX + g.modelW / 2}
              y={m.cy + g.labelSize * 0.35}
              text-anchor="middle"
              class="mcv-name fill-(--color-cream-900) font-sans"
              font-size={g.labelSize}
            >
              {m.name}
            </text>
            <text
              x={g.modelX + g.modelW / 2}
              y={m.cy + g.labelSize * 0.35}
              text-anchor="middle"
              class={`mcv-win mcv-win-${m.id} fill-(--color-cream-50) font-sans`}
              font-size={g.labelSize}
            >
              {m.name}
            </text>
            {[...m.marks].map((bit, j) => (
              <rect
                x={g.markX + j * (g.mark + g.markGap)}
                y={m.cy - g.mark / 2}
                width={g.mark}
                height={g.mark}
                rx={g.mark * 0.28}
                class={`mcv-mark ${bit === "1" ? "fill-(--color-sage-700) stroke-(--color-sage-700)" : "fill-(--color-cream-50) stroke-(--color-cream-500)"}`}
                stroke-width={1.5}
                style={`--d: ${2000 + i * 120 + j * 55}ms`}
              />
            ))}
          </g>
        ))}

        {chips.map((chip) => (
          <g class="mcv-chip" style={`--d: ${2900 + chip.i * 60}ms`}>
            <rect
              x={chip.i * (chipW + 8)}
              y={g.chipY}
              width={chipW}
              height={g.chipSize * 2.6}
              rx={g.chipSize * 1.3}
              class="fill-(--color-cream-50) stroke-(--color-sage-300)"
            />
            <rect
              x={chip.i * (chipW + 8)}
              y={g.chipY}
              width={chipW}
              height={g.chipSize * 2.6}
              rx={g.chipSize * 1.3}
              class={`mcv-goal mcv-goal-${chip.i} fill-(--color-sage-800)`}
            />
            <text
              x={chip.i * (chipW + 8) + chipW / 2}
              y={g.chipY + g.chipSize * 1.3 + g.chipSize * 0.36}
              text-anchor="middle"
              class="fill-(--color-cream-900) font-label uppercase"
              font-size={g.chipSize}
            >
              {chip.name}
            </text>
            <text
              x={chip.i * (chipW + 8) + chipW / 2}
              y={g.chipY + g.chipSize * 1.3 + g.chipSize * 0.36}
              text-anchor="middle"
              class={`mcv-goal mcv-goal-${chip.i} fill-(--color-cream-50) font-label uppercase`}
              font-size={g.chipSize}
            >
              {chip.name}
            </text>
          </g>
        ))}
      </svg>
    );
  })}
</figure>

<style>
  /* Beats 1–3 play once on load; beat 4 (the goal cycle) loops every 10s,
     one goal per 2s. A highlight class is opaque only during its goals'
     windows, so the chip and its winning models switch together. */
  .mcv :global(.mcv-win),
  .mcv :global(.mcv-goal) {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mcv :global(.mcv-trace) {
      animation: mcv-slide 520ms cubic-bezier(0.16, 1, 0.3, 1) var(--d) both;
    }
    .mcv :global(.mcv-model),
    .mcv :global(.mcv-chip) {
      animation: mcv-fade 420ms ease-out var(--d) both;
    }
    .mcv :global(.mcv-wire) {
      stroke-dasharray: 1;
      animation: mcv-draw 700ms cubic-bezier(0.65, 0, 0.35, 1) var(--d) both;
    }
    .mcv :global(.mcv-mark) {
      animation: mcv-fade 260ms ease-out var(--d) both;
    }
    .mcv :global(.mcv-pulse) {
      opacity: 0;
      animation: mcv-travel 2.6s cubic-bezier(0.45, 0, 0.55, 1) var(--d)
        infinite;
    }
    .mcv :global(.mcv-goal-0) { animation: mcv-goal-0 10s linear 3.4s infinite; }
    .mcv :global(.mcv-goal-1) { animation: mcv-goal-1 10s linear 3.4s infinite; }
    .mcv :global(.mcv-goal-2) { animation: mcv-goal-2 10s linear 3.4s infinite; }
    .mcv :global(.mcv-goal-3) { animation: mcv-goal-3 10s linear 3.4s infinite; }
    .mcv :global(.mcv-goal-4) { animation: mcv-goal-4 10s linear 3.4s infinite; }
    /* Cheaper wins Closest (0–20%), Fastest (40–60%) and Best mix (80–100%);
       Open wins Cheapest (20–40%), Open (60–80%) and Best mix. */
    .mcv :global(.mcv-win-cheaper) { animation: mcv-win-cheaper 10s linear 3.4s infinite; }
    .mcv :global(.mcv-win-open) { animation: mcv-win-open 10s linear 3.4s infinite; }
  }

  /* Reduced motion: the finished picture, resting on "Best mix". */
  @media (prefers-reduced-motion: reduce) {
    .mcv :global(.mcv-pulse) {
      display: none;
    }
    .mcv :global(.mcv-goal-4),
    .mcv :global(.mcv-win-cheaper),
    .mcv :global(.mcv-win-open) {
      opacity: 1;
    }
  }

  @keyframes mcv-slide {
    from { opacity: 0; transform: translateX(-14px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes mcv-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes mcv-draw {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }
  @keyframes mcv-travel {
    0% { offset-distance: 0%; opacity: 0; }
    12% { opacity: 1; }
    80% { opacity: 1; }
    100% { offset-distance: 100%; opacity: 0; }
  }
  @keyframes mcv-goal-0 { 0%, 18% { opacity: 1; } 20%, 100% { opacity: 0; } }
  @keyframes mcv-goal-1 { 0%, 18% { opacity: 0; } 20%, 38% { opacity: 1; } 40%, 100% { opacity: 0; } }
  @keyframes mcv-goal-2 { 0%, 38% { opacity: 0; } 40%, 58% { opacity: 1; } 60%, 100% { opacity: 0; } }
  @keyframes mcv-goal-3 { 0%, 58% { opacity: 0; } 60%, 78% { opacity: 1; } 80%, 100% { opacity: 0; } }
  @keyframes mcv-goal-4 { 0%, 78% { opacity: 0; } 80%, 98% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes mcv-win-cheaper {
    0%, 18% { opacity: 1; }
    20%, 38% { opacity: 0; }
    40%, 58% { opacity: 1; }
    60%, 78% { opacity: 0; }
    80%, 98% { opacity: 1; }
    100% { opacity: 0; }
  }
  @keyframes mcv-win-open {
    0%, 18% { opacity: 0; }
    20%, 38% { opacity: 1; }
    40%, 58% { opacity: 0; }
    60%, 98% { opacity: 1; }
    100% { opacity: 0; }
  }
</style>
