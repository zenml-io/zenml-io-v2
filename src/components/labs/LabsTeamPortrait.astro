---
interface Props {
  image: { url: string; alt?: string };
  name: string;
  loading?: "eager" | "lazy";
  frame?: "standalone" | "integrated";
}
const { image, name, loading = "lazy", frame = "standalone" } = Astro.props;
---

<div class:list={["team-portrait", frame === "standalone" && "portrait-frame"]}>
  <img src="/images/team/portrait-ribbon-back.svg" alt="" aria-hidden="true" class="portrait-ribbon portrait-ribbon-back" width="785" height="478" />
  <img src={image.url} alt={image.alt || name} loading={loading} class="portrait-photo" width="480" height="480" />
  <img src="/images/team/portrait-ribbon-front.svg" alt="" aria-hidden="true" class="portrait-ribbon portrait-ribbon-front" width="643" height="392" />
</div>

<style>
  .team-portrait {
    position: relative;
    isolation: isolate;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--color-sage-50);
  }
  .portrait-frame { border: 1px solid var(--color-border); border-radius: 20px; }
  .portrait-ribbon {
    position: absolute;
    max-width: none;
    pointer-events: none;
    transition: transform 900ms cubic-bezier(0.3, 0, 0.2, 1);
  }
  .portrait-ribbon-back { width: 201%; height: auto; left: -29%; top: 8%; }
  .portrait-photo {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: grayscale(1);
    transition: transform 700ms cubic-bezier(0.3, 0, 0.2, 1);
  }
  .portrait-ribbon-front { width: 165%; height: auto; left: -91%; top: 80%; transition-duration: 1100ms; }
  :global(.people-card:nth-child(even)) .portrait-ribbon-back { left: -62%; top: 17%; }
  :global(.people-card:nth-child(even)) .portrait-ribbon-front { left: 60%; top: 80%; }
  :global(.people-card:focus-within) .portrait-ribbon-back { transform: translateY(-10px); }
  :global(.people-card:focus-within) .portrait-ribbon-front { transform: translateY(-18px); }
  :global(.people-card:focus-within) .portrait-photo { transform: scale(1.025); }
  @media (hover: hover) {
    :global(.people-card:hover) .portrait-ribbon-back { transform: translateY(-10px); }
    :global(.people-card:hover) .portrait-ribbon-front { transform: translateY(-18px); }
    :global(.people-card:hover) .portrait-photo { transform: scale(1.025); }
  }
  @media (prefers-reduced-motion: reduce) {
    .portrait-ribbon, .portrait-photo { transition: none; }
    :global(.people-card:hover) .portrait-ribbon,
    :global(.people-card:focus-within) .portrait-ribbon,
    :global(.people-card:hover) .portrait-photo,
    :global(.people-card:focus-within) .portrait-photo { transform: none; }
  }
</style>
