---
/**
 * LogoGrid — the Labs homepage "teams running production AI" logo wall.
 *
 * Renders LABS_LOGO_GRID.logos in a fixed 6/4/2-column hairline grid,
 * padding out the final row with empty cells so the grid border closes
 * cleanly on every breakpoint.
 */
import { LABS_LOGO_GRID } from "../../lib/labs-home";

const { headline, logos } = LABS_LOGO_GRID;

// The grid is drawn at 6 columns at the widest breakpoint; pad the last
// row with empty cells so the hairline border closes on the right edge.
const COLUMNS = 6;
const remainder = logos.length % COLUMNS;
const padCount = remainder === 0 ? 0 : COLUMNS - remainder;
const padCells = Array.from({ length: padCount });
---

<section class="px-6 pt-32 pb-28 md:px-12 xl:px-24">
  <div class="mx-auto flex max-w-[1248px] flex-col gap-space-lg">
    <h2
      class="font-display text-[40px] leading-[46px] font-medium tracking-[-0.02em] text-(--color-cream-900)"
    >
      {headline}
    </h2>

    <div class="grid grid-cols-2 border-t border-l border-border md:grid-cols-4 xl:grid-cols-6">
      {
        logos.map((logo) => (
          <div class="flex h-[104px] items-center justify-center border-r border-b border-border p-6">
            {logo.placeholder ? (
              <span class="font-label text-[12px] uppercase tracking-[0.05em] text-(--color-cream-700)">
                {logo.name}
              </span>
            ) : (
              <img
                src={logo.src}
                alt={logo.name}
                class="max-h-9 max-w-[120px] object-contain"
                style={logo.maxWidth ? `max-width:${logo.maxWidth}` : undefined}
                loading="lazy"
              />
            )}
          </div>
        ))
      }
      {
        padCells.map(() => (
          <div class="border-r border-b border-border" aria-hidden="true" />
        ))
      }
    </div>
  </div>
</section>
