---
/**
 * ProductDoors — Labs homepage section introducing the two products as a
 * pair of cards (ZenML, Kitaru). Copy, install commands, licences and CTAs
 * all come from `LABS_DOORS` (`src/lib/labs-home.ts`); nothing here is
 * retyped. Kitaru's small orange dot next to its name is the only orange
 * mark on the page (per the section spec).
 */
import { LABS_DOORS } from "../../lib/labs-home";
---

<section class="px-6 pt-6 pb-6 md:px-12 md:pt-[128px] md:pb-[112px] xl:px-24">
  <div class="mx-auto flex max-w-[1248px] flex-col gap-[56px]">
    <h2 class="font-display text-[31px] leading-[33px] font-medium tracking-[-0.02em] text-(--color-cream-900) md:text-[56px] md:leading-[60px]">
      {LABS_DOORS.headline}
    </h2>

    <div class="flex flex-col gap-6 lg:flex-row">
      {LABS_DOORS.doors.map((door) => (
        <div class="flex flex-1 flex-col rounded-[20px] border border-border bg-card p-10 min-w-0">
          <div class="flex flex-col gap-7">
            <div class="flex items-center gap-2">
              {door.accent === "orange" && (
                <span class="h-2 w-2 rounded-full bg-(--color-orange-500)" aria-hidden="true" />
              )}
              <span class="font-label text-[13px] uppercase text-(--color-cream-700)">{door.name}</span>
            </div>
            <h3 class="font-display text-[19px] leading-[22px] font-medium tracking-[-0.01em] text-(--color-cream-900) md:text-[34px] md:leading-[40px]">
              {door.leadLine}
            </h3>
            <p class="font-sans text-[17px] leading-[26px] text-foreground">{door.body}</p>
            <div class="flex flex-wrap gap-2">
              <span class="inline-flex h-[34px] items-center whitespace-pre max-w-full overflow-x-auto [scrollbar-width:none] rounded-full border border-border px-[14px] font-mono text-[13px] text-foreground">
                {door.installCmd}
              </span>
              <span class="inline-flex h-[34px] items-center rounded-full border border-border px-[14px] font-label text-xs uppercase text-(--color-cream-700)">
                {door.license}
              </span>
            </div>
          </div>
          <a
            href={door.cta.href}
            data-analytics={door.cta.analytics}
            class="mt-4 inline-flex h-12 w-fit cursor-pointer items-center justify-center rounded-full bg-(--color-cream-900) px-[26px] font-label text-[13px] uppercase tracking-[0.05em] text-(--color-cream-50)"
          >
            {door.cta.label}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
