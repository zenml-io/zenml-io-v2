---
/**
 * labs.pricing-plan-cards — the `/pricing` plan cards: one row of plans
 * (Open Source / Starter / Enterprise, three columns from lg) under a short
 * note on what the paid plan covers. Static markup, so the numbers are in
 * the HTML for crawlers and for anyone without JS; the reveal is the house
 * `initScrollReveal()`.
 */
import { BAND_CONTENT_GAP } from "../../lib/blogLayout";
import type { PricingPlan } from "../../lib/marketingPageTypes";
import PricingPlanCard from "./PricingPlanCard.astro";

interface Props {
  plans: readonly PricingPlan[];
  note: string;
}
const { plans, note } = Astro.props;
---

<section id="pricing-plans" class:list={["scroll-reveal-section pb-24 md:pb-32", BAND_CONTENT_GAP]}>
  <div class="mx-auto max-w-content px-gutter">
    <p class="mx-auto mb-10 max-w-[720px] text-center font-sans text-[14px] leading-5 text-(--color-cream-700)">
      {note}
    </p>
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3 lg:items-start">
      {plans.map((plan, planIdx) => (
        <PricingPlanCard plan={plan} planIdx={planIdx} />
      ))}
    </div>
  </div>
</section>

<script>
  import { initScrollReveal } from "../../scripts/labs-scroll-reveal";

  initScrollReveal();
</script>
