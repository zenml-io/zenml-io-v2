---
import type { FeatureTabsContent } from "../../lib/labs-product-zenml";
/**
 * LabsFeatureTabs — the ZenML product page's capability showcase: a
 * headline block over an auto-cycling tab slider (vertical menu at 40%,
 * figure panel at 60%). Replaces `src/components/sections/FeatureTabs.astro`
 * on `/product/zenml`; the old stats grid is not ported (no rounded figures).
 * Copy arrives through the `content` prop (`ZENML_FEATURE_TABS`); nothing
 * here is retyped. The panes are server-rendered here and handed to the
 * `FeatureTabsSlider` island as children: a tab with a `figure` id draws its
 * inline SVG highlight (see `highlights/`), the rest keep their image. The
 * island only toggles which pane is current. Styles the island's class hooks
 * (.tab-slider*) from a scoped wrapper — the only global style block in this
 * build.
 */
import FeatureTabsSlider from "../islands/FeatureTabsSlider";
import { HIGHLIGHT_FIGURES } from "./highlights";

interface Props {
  content: FeatureTabsContent;
}
const { headline, deck, tabs } = Astro.props.content;

/** The tab visitors see first (the fourth where there are that many, else
 *  the last); the island receives the same value. */
const DEFAULT_INDEX = Math.min(3, tabs.length - 1);
---

<section class="labs-feature-tabs bg-card py-24 md:py-32">
  <div class="mx-auto max-w-content px-gutter">
    {headline && (
      <h2 class="font-display text-[32px] leading-[36px] text-(--color-cream-900) text-balance md:text-[44px] md:leading-[48px]">
        {headline}
      </h2>
    )}
    {deck && (
      <p class="mt-space-sm max-w-[640px] font-sans text-[17px] leading-[26px] text-foreground md:text-[18px] md:leading-[27px]">
        {deck}
      </p>
    )}

    <div class="mt-space-xl">
      {/* This page's one non-ambient client:load island: the auto-cycle is
          user-pausable interaction (click resets), not a motion moment. */}
      <FeatureTabsSlider client:load tabs={[...tabs]} defaultIndex={DEFAULT_INDEX} autoDurationMs={9000}>
        {tabs.map((tab, i) => {
          const Figure = tab.figure ? HIGHLIGHT_FIGURES[tab.figure] : null;
          const active = i === DEFAULT_INDEX;
          return (
            <div
              role="tabpanel"
              id={`adv-panel-${i}`}
              aria-labelledby={`adv-tab-${i}`}
              data-figure-index={i}
              data-highlight-active={active ? "" : undefined}
              class:list={["tab-slider-pane", { "w--tab-active": active }]}
            >
              {Figure ? (
                <Figure label={tab.imageAlt} />
              ) : (
                <img
                  src={tab.image}
                  alt={tab.imageAlt}
                  class="tab-slider-image"
                  width={720}
                  height={460}
                  loading={active ? "eager" : "lazy"}
                />
              )}
            </div>
          );
        })}
      </FeatureTabsSlider>
    </div>
  </div>
</section>

<style is:global>
  .labs-feature-tabs .tab-slider {
    display: flex;
    align-items: stretch;
    gap: 40px;
  }

  .labs-feature-tabs .tab-slider-menu {
    display: flex;
    flex-direction: column;
    flex: 0 0 40%;
  }

  .labs-feature-tabs .tab-slider-content {
    flex: 0 0 60%;
    min-height: 520px;
    border-radius: 20px;
    border: 1px solid var(--border);
    /* The figures draw their own card on the page's cream, so the panel is
       that cream edge to edge rather than a white card around a cream one. */
    background: var(--background);
    padding: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .labs-feature-tabs .tab-slider-tab {
    text-align: left;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 16px;
    padding: 20px 24px;
    cursor: pointer;
    transition: background-color 200ms ease-out, border-color 200ms ease-out;
    position: relative;
    overflow: hidden;
  }

  .labs-feature-tabs .tab-slider-tab:hover {
    border-color: var(--color-sage-400);
  }

  .labs-feature-tabs .tab-slider-tab.w--current {
    background: var(--color-sage-100);
    border-color: var(--color-sage-400);
  }

  /* The island's title element carries no utility class, so the display
   * role is bound here in CSS: the same weight the scope binds to
   * `.font-display`, and the tracking token rather than a literal. */
  .labs-feature-tabs .tab-slider-title {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: var(--tracking-heading);
    font-size: 20px;
    line-height: 26px;
    color: var(--color-cream-700);
    transition: color 200ms ease-out;
  }

  .labs-feature-tabs .tab-slider-tab.w--current .tab-slider-title {
    color: var(--color-cream-900);
  }

  .labs-feature-tabs .tab-slider-nav-desc {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 400ms ease, opacity 400ms ease;
  }

  .labs-feature-tabs .tab-slider-tab.w--current .tab-slider-nav-desc {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .labs-feature-tabs .tab-slider-nav-desc > div {
    overflow: hidden;
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 23px;
    color: var(--foreground);
    padding-top: 8px;
  }

  .labs-feature-tabs .tab-slider-progress {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: 0%;
    background: var(--color-sage-600);
  }

  .labs-feature-tabs .tab-slider-pane {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 200ms ease, visibility 0s linear 200ms;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Incoming pane: fades in and rises over ~480ms. Outgoing pane (losing
     this class) is not covered by this animation, so it only fades via the
     base rule's opacity transition above — fast, and without motion. */
  .labs-feature-tabs .tab-slider-pane.w--tab-active {
    position: relative;
    opacity: 1;
    visibility: visible;
    z-index: 2;
    transition: opacity 200ms ease;
    animation: labs-pane-in 480ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  @keyframes labs-pane-in {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .labs-feature-tabs .tab-slider-image {
    width: 100%;
    max-width: 720px;
    height: auto;
    border-radius: 12px;
  }

  @media (max-width: 1023px) {
    .labs-feature-tabs .tab-slider {
      flex-direction: column;
    }

    .labs-feature-tabs .tab-slider-menu {
      flex: 1 1 auto;
    }

    .labs-feature-tabs .tab-slider-content {
      flex: 1 1 auto;
      margin-top: 32px;
    }
  }

  @media (max-width: 479px) {
    .labs-feature-tabs .tab-slider-content {
      padding: 16px;
      min-height: auto;
    }

    .labs-feature-tabs .tab-slider-tab {
      padding: 16px 18px;
    }

    .labs-feature-tabs .tab-slider-title {
      font-size: 18px;
      line-height: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .labs-feature-tabs .tab-slider-nav-desc {
      transition: none;
    }

    .labs-feature-tabs .tab-slider-tab {
      transition: none;
    }

    .labs-feature-tabs .tab-slider-title {
      transition: none;
    }

    .labs-feature-tabs .tab-slider-pane {
      transition: opacity 150ms linear, visibility 0s linear 150ms;
    }

    .labs-feature-tabs .tab-slider-pane.w--tab-active {
      animation: none;
      transition: opacity 150ms linear;
      transform: none;
    }
  }
</style>
