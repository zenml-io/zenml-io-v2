---
/**
 * LabsStoryCard — two arrangements sharing one card shell. The default
 * (story) arrangement is the case-study card CustomerStoryCards has always
 * rendered: customer logos on a light sage grain panel, title, read label.
 * The `kind: "quote"` arrangement is a testimonial card instead: a quote,
 * an attribution footer (avatar + name + title), and an optional trailing
 * company logo — used where the source content is quotes, not case-study
 * links (e.g. /pro, the /pricing stats band).
 */
import { BLOG_CARD_TITLE } from "./blogCardStyles";

type Props =
  | {
      kind?: "story";
      href: string;
      title: string;
      company: string;
      logos: readonly { url: string; alt?: string }[];
      readLabel?: string;
    }
  | {
      kind: "quote";
      quote: string;
      name: string;
      /** Absence collapses the attribution's second line. */
      title?: string;
      avatar?: string;
      logo?: { url: string; alt: string };
      wide?: true;
    };

const props = Astro.props;
---

{
  props.kind === "quote" ? (
    <article class="flex h-full flex-col rounded-[20px] border border-border bg-card p-8 transition-colors duration-200 ease-out hover:border-(--color-sage-400)">
      <blockquote class="font-sans text-[18px] leading-7 text-(--color-cream-900)">
        {props.quote}
      </blockquote>
      <footer class="mt-auto flex items-center gap-3 pt-8">
        {props.avatar && (
          <img src={props.avatar} alt={props.name} class="h-10 w-10 rounded-full object-cover" loading="lazy" />
        )}
        <div>
          <p class="font-sans text-[15px] leading-5 font-medium text-(--color-cream-900)">{props.name}</p>
          {props.title && (
            <p class="font-sans text-[14px] leading-5 text-(--color-cream-700)">{props.title}</p>
          )}
        </div>
        {props.logo && (
          <img
            src={props.logo.url}
            alt={props.logo.alt}
            class="ml-auto h-6 w-auto max-w-[120px] object-contain"
            loading="lazy"
          />
        )}
      </footer>
    </article>
  ) : (
    <a href={props.href} class="group flex h-full cursor-pointer flex-col overflow-hidden rounded-[20px] border border-border bg-card transition-colors duration-200 ease-out hover:border-(--color-sage-400)">
      <div class="story-media flex h-[200px] flex-col items-center justify-center gap-space-sm overflow-hidden px-space-md text-center">
        {props.logos.map((logo) => <img src={logo.url} alt={logo.alt || props.company} class:list={["story-logo relative h-auto max-h-[88px] w-full max-w-[200px] object-contain", { "story-logo-brevo": logo.url === "/images/logos/brevo.svg" }]} loading="lazy" />)}
      </div>
      <div class="flex flex-1 flex-col p-space-md pt-space-xs">
        <h3 class={BLOG_CARD_TITLE}>{props.title}</h3>
        <p class="mt-auto pt-space-xs font-sans text-[14px] leading-5 text-(--color-cream-700)">{props.readLabel ?? "Read the story"}</p>
      </div>
    </a>
  )
}

<style>
  .story-media { position: relative; isolation: isolate; background: var(--color-sage-50); }
  .story-media:has(.story-logo + .story-logo) .story-logo { max-height: 60px; max-width: 160px; }
  .story-logo-brevo { max-width: 140px; }
  .story-media::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 15% 20%, var(--color-sage-200), transparent 70%), linear-gradient(145deg, var(--color-sage-50), var(--color-sage-100));
    transition: transform 500ms ease-out;
  }
  .story-media::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.1;
    pointer-events: none;
    background-image: url("/images/story-grain.svg");
  }
  .story-media::before { z-index: -2; }
  a:hover .story-media::before, a:focus-visible .story-media::before { transform: scale(1.04); }
  @media (prefers-reduced-motion: reduce) {
    a:hover .story-media::before,
    a:focus-visible .story-media::before {
      transition: none;
      transform: none;
    }
  }
</style>
