---
import { BLOG_CARD_TITLE } from "./blogCardStyles";

interface Props {
  href: string;
  title: string;
  company: string;
  logos: readonly { url: string; alt?: string }[];
  readLabel?: string;
}
const {
  href,
  title,
  company,
  logos,
  readLabel = "Read the story",
} = Astro.props;
---

<a href={href} class="group flex h-full cursor-pointer flex-col overflow-hidden rounded-[20px] border border-border bg-card transition-colors duration-200 ease-out hover:border-(--color-sage-400)">
  <div class="story-media flex h-[200px] flex-col items-center justify-center gap-space-sm overflow-hidden px-space-md text-center">
    {logos.map((logo) => <img src={logo.url} alt={logo.alt || company} class:list={["story-logo relative h-auto max-h-[88px] w-full max-w-[200px] object-contain", { "story-logo-brevo": logo.url === "/images/logos/brevo.svg" }]} loading="lazy" />)}
  </div>
  <div class="flex flex-1 flex-col p-space-md pt-space-xs">
    <h3 class={BLOG_CARD_TITLE}>{title}</h3>
    <p class="mt-auto pt-space-xs font-sans text-[14px] leading-5 text-(--color-cream-700)">{readLabel}</p>
  </div>
</a>

<style>
  .story-media { position: relative; isolation: isolate; background: var(--color-sage-50); }
  .story-media:has(.story-logo + .story-logo) .story-logo { max-height: 60px; max-width: 160px; }
  .story-logo-brevo { max-width: 140px; }
  .story-media::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 15% 20%, var(--color-sage-200), transparent 70%), linear-gradient(145deg, var(--color-sage-50), var(--color-sage-100));
    transition: transform 500ms ease-out;
  }
  .story-media::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.1;
    pointer-events: none;
    background-image: url("/images/story-grain.svg");
  }
  .story-media::before { z-index: -2; }
  a:hover .story-media::before, a:focus-visible .story-media::before { transform: scale(1.04); }
  @media (prefers-reduced-motion: reduce) {
    a:hover .story-media::before,
    a:focus-visible .story-media::before {
      transition: none;
      transform: none;
    }
  }
</style>
