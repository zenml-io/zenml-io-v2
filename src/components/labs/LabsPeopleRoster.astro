---
import { type CollectionEntry, render } from "astro:content";
import { BAND_CONTENT_GAP } from "../../lib/blogLayout";
import { LINKEDIN_ICON_PATH } from "../../lib/socialIcons";
import LabsTeamPortrait from "./LabsTeamPortrait.astro";

interface Props {
  members: CollectionEntry<"team">[];
  heading?: string;
  placement?: "section" | "after-band";
}
const { members, heading, placement = "section" } = Astro.props;
const people = await Promise.all(
  members.map(async (member) => ({ member, ...(await render(member)) })),
);
---

<section class:list={["scroll-reveal-section", placement === "after-band" ? [BAND_CONTENT_GAP, "pb-space-xxl"] : "py-space-xl md:py-space-xxl"]} aria-label={heading || "Team members"}>
  <div class="mx-auto max-w-content px-gutter">
    {heading && <h2 class="mb-space-lg font-display text-[32px] leading-[38px] text-(--color-sage-900) md:text-[40px] md:leading-[46px]">{heading}</h2>}
    <div class="grid grid-cols-1 gap-space-sm sm:grid-cols-2 lg:grid-cols-4">
      {people.map(({ member, Content }) => (
        <article class="people-card flex min-w-0 flex-col overflow-hidden rounded-[20px] border border-border bg-(--color-sage-50) transition-colors duration-200 ease-out hover:border-(--color-sage-400)">
          {member.data.photo && <LabsTeamPortrait image={member.data.photo} name={member.data.title} frame="integrated" />}
          <div class="people-card-body flex flex-1 flex-col gap-space-sm p-space-md">
            <div>
              <h3 class="font-display text-[24px] leading-[30px] text-(--color-sage-900)">
                {member.data.title}
              </h3>
              {member.data.position && <p class="mt-space-xxs font-label text-[14px] leading-5 text-(--color-sage-800)">{member.data.position}</p>}
            </div>
            {member.body?.trim() && <div class="people-facts labs-hex-list"><Content /></div>}
          </div>
          {(member.data.linkedin || member.data.email) && (
            <div class="people-contact-strip mt-auto flex border-t border-border bg-(--color-sage-100)">
              {member.data.linkedin && (
                <a class="people-contact" href={member.data.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${member.data.title} on LinkedIn (opens in a new tab)`} title="LinkedIn">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d={LINKEDIN_ICON_PATH} /></svg>
                </a>
              )}
              {member.data.email && (
                <a class="people-contact" href={`mailto:${member.data.email}`} aria-label={`Email ${member.data.title}`} title="Email">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 6 9 7 9-7" /></svg>
                </a>
              )}
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .people-card:focus-within { outline: 2px solid var(--color-sage-800); outline-offset: 3px; }
  .people-facts { --list-marker-width: 10px; --list-marker-size: 10px 12px; font-size: 14px; line-height: 22px; color: var(--color-cream-700); }
  .people-facts :global(ul) { display: flex; flex-direction: column; gap: var(--spacing-space-xs); margin: 0; padding: 0; list-style: none; }
  .people-facts :global(li) { position: relative; padding-left: var(--spacing-space-sm); }
  .people-facts :global(a) { position: relative; z-index: 1; text-decoration: underline; }
  .people-contact { display: flex; flex: 1; min-width: 44px; min-height: 52px; align-items: center; justify-content: center; cursor: pointer; color: var(--color-sage-800); transition: background-color 200ms ease-out, color 200ms ease-out; }
  .people-contact + .people-contact { border-left: 1px solid var(--color-border); }
  .people-contact:hover { background-color: var(--color-sage-200); color: var(--color-sage-900); }
  .people-contact:focus-visible { outline: 2px solid var(--color-sage-800); outline-offset: -4px; }
  .people-contact:active { background-color: var(--color-sage-300); }
  @media (prefers-reduced-motion: reduce) { .people-contact { transition: none; } }
</style>
