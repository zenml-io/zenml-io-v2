---
import type { LabsCta } from "../../lib/labs-home";
import LabsButton from "./LabsButton.astro";
import "../../styles/labs-scroll-reveal.css";

interface Props {
  headline: string;
  deck?: string;
  cta: LabsCta;
  advantages?: readonly {
    title: string;
    content: string;
    image?: { url: string; alt?: string };
  }[];
}
const { headline, deck, cta, advantages = [] } = Astro.props;
---

<section class="scroll-reveal-section bg-(--color-sage-50) py-8 md:py-10">
  <div class="scroll-reveal-section mx-auto max-w-content px-gutter">
    {advantages.length > 0 && (
      <ul class="scroll-reveal-section mb-12 grid list-none grid-cols-1 gap-6 md:grid-cols-3">
        {advantages.map((advantage, index) => (
          <li class:list={["reveal-child rounded-[20px] border border-(--color-border) bg-card p-8 transition-colors duration-200 ease-out hover:border-(--color-sage-400)", index === 1 && "stagger-1", index === 2 && "stagger-2", index === 3 && "stagger-3", index >= 4 && "stagger-4"]}>
            {advantage.image && <img src={advantage.image.url} alt={advantage.image.alt || advantage.title} class="mb-5 h-16 w-16 object-contain" loading="lazy" />}
            <h3 class="font-display text-[24px] leading-[30px] text-(--color-cream-900)">{advantage.title}</h3>
            <p class="mt-3 font-sans text-[15px] leading-5 text-(--color-cream-700)">{advantage.content}</p>
          </li>
        ))}
      </ul>
    )}
    <div class="reveal-child stagger-4 rounded-[20px] border border-(--color-border) bg-card p-8 transition-colors duration-200 ease-out hover:border-(--color-sage-400) md:p-10">
      <h2 class="font-display text-[32px] leading-[36px] text-(--color-cream-900) md:text-[44px] md:leading-[48px]">{headline}</h2>
      {deck && <p class="mt-5 max-w-[720px] font-sans text-[17px] leading-[26px] text-(--color-cream-700)">{deck}</p>}
      <div class="mt-8"><LabsButton cta={cta} /></div>
    </div>
  </div>
</section>
