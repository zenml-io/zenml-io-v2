  version: "v6",
  type: "str",
  created: "Yesterday",
  icon: ICON_FILE,
  y: 314,
} as const;

const headerY = 90;
const headerHeight = 32;
const headerLabels = [
  { label: "Artifact", x: COL_ARTIFACT },
  { label: "Version", x: COL_VERSION },
  { label: "Data Type", x: COL_TYPE },
  { label: "Created", x: COL_CREATED },
] as const;
---

<HighlightFigure label={label} id={id}>
  <defs>
    <clipPath id={`${id}-card`}>
      <rect x="48" y="48" width="624" height="364" rx="16" />
    </clipPath>
  </defs>

  {/* Run card */}
  <rect x="48.5" y="48.5" width="623" height="363" rx="16" fill="var(--color-card)" stroke="var(--color-border)" />
  <text class="hl-title" x="68" y="74" fill="var(--color-cream-900)">Artifacts</text>
  <text class="hl-label" x="652" y="73" text-anchor="end" fill="var(--color-cream-700)">2 artifacts · 6 versions</text>
  <line x1="49" y1="90.5" x2="671" y2="90.5" stroke="var(--color-border)" />

  <g clip-path={`url(#${id}-card)`}>
    {/* Header row */}
    <g class="hl-in hl-row" style="--hl-i: 0">
      {headerLabels.map((h) => (
        <text class="hl-label" x={h.x} y={headerY + 20} fill="var(--color-cream-700)">{h.label}</text>
      ))}
      <line x1="60" y1={headerY + headerHeight - 0.5} x2="660" y2={headerY + headerHeight - 0.5} stroke="var(--color-border)" />
    </g>

    {rows.map((r) => (
      <g class="hl-in hl-row" style={`--hl-i: ${r.i}`}>
        <path transform={`translate(${COL_ARTIFACT} ${r.y + 15}) scale(0.75)`} d={r.icon} fill="var(--color-sage-700)" fill-rule="evenodd" />
        <text class="hl-name" x={COL_ARTIFACT + 28} y={r.y + 28} fill="var(--color-cream-900)" style="font-size: 13px">{r.name}</text>
        <rect x={COL_VERSION} y={r.y + 14} width="32" height="20" rx="4" fill="var(--color-cream-100)" />
        <text class="hl-mono" x={COL_VERSION + 16} y={r.y + 28} text-anchor="middle" fill="var(--color-cream-700)">{r.version}</text>
        <text class="hl-body" x={COL_TYPE} y={r.y + 28} fill="var(--color-cream-700)">{r.type}</text>
        <text class="hl-body" x={COL_CREATED} y={r.y + 28} fill="var(--color-cream-700)">{r.created}</text>
        {r.hairline && <line x1="60" y1={r.y + 47.5} x2="660" y2={r.y + 47.5} stroke="var(--color-border)" />}
      </g>
    ))}

    {/* Accent row: the prompt version marked as the compare-with-last-good target */}
    <g class="hl-in" style="--hl-i: 6">
      <rect x="60.5" y={accent.y + 0.5} width="599" height="47" rx="5" fill="var(--color-sage-100)" stroke="var(--color-sage-400)" />
      <path transform={`translate(${COL_ARTIFACT} ${accent.y + 15}) scale(0.75)`} d={accent.icon} fill="var(--color-sage-800)" fill-rule="evenodd" />
      <text class="hl-name" x={COL_ARTIFACT + 28} y={accent.y + 28} fill="var(--color-sage-900)" style="font-size: 13px">{accent.name}</text>
      <rect x={COL_VERSION} y={accent.y + 14} width="32" height="20" rx="4" fill="var(--color-sage-400)" />
      <text class="hl-mono" x={COL_VERSION + 16} y={accent.y + 28} text-anchor="middle" fill="var(--color-sage-900)">{accent.version}</text>
      <text class="hl-body" x={COL_TYPE} y={accent.y + 28} fill="var(--color-sage-800)">{accent.type}</text>
      <text class="hl-body" x={COL_CREATED} y={accent.y + 28} fill="var(--color-sage-800)">{accent.created}</text>
    </g>
  </g>
</HighlightFigure>
