---
/**
 * highlight.zenml.versioning — the "Artifact versioning" figure: one
 * artifact table listing model versions and prompt versions side by side,
 * with the last-good prompt version selected as the compare target. Drawn in
 * the product UI's table anatomy: a 32px sentence-case header band, 48px rows
 * on muted dividers, mono identity cells, version tags and data-type chips.
 */
import HighlightFigure from "../HighlightFigure.astro";
import Chip from "../parts/Chip.astro";
import Glyph, { type GlyphName } from "../parts/Glyph.astro";
import LogoDefs from "../parts/LogoDefs.astro";
import { tagWidth } from "../parts/metrics";

interface Props {
  label: string;
  /** Suffixes the SVG ids when a page draws this figure twice, so each
   *  copy's url(#…) refs resolve to its own defs. */
  instance?: string;
}
const { label, instance } = Astro.props;
const id = instance ? `hl-zenml-versioning-${instance}` : "hl-zenml-versioning";

interface Row {
  name: string;
  version: string;
  type: "ClassifierMixin" | "str";
  created: string;
  icon: GlyphName;
  selected?: true;
  i: number;
}

/** Rows in reading order; the last-good prompt version is the selected row. */
const rows: readonly Row[] = [
  {
    name: "model",
    version: "v3",
    type: "ClassifierMixin",
    created: "2 min ago",
    icon: "cpu",
    i: 1,
  },
  {
    name: "model",
    version: "v2",
    type: "ClassifierMixin",
    created: "Yesterday",
    icon: "cpu",
    i: 2,
  },
  {
    name: "model",
    version: "v1",
    type: "ClassifierMixin",
    created: "3 days ago",
    icon: "cpu",
    i: 3,
  },
  {
    name: "system_prompt",
    version: "v7",
    type: "str",
    created: "2 min ago",
    icon: "file",
    i: 4,
  },
  {
    name: "system_prompt",
    version: "v6",
    type: "str",
    created: "Yesterday",
    icon: "file",
    selected: true,
    i: 6,
  },
  {
    name: "system_prompt",
    version: "v5",
    type: "str",
    created: "5 days ago",
    icon: "file",
    i: 5,
  },
];

/** Wide table: header band at y 90, 48px rows from y 122, columns inside x 68…652. */
const COL_ARTIFACT = 68;
const COL_VERSION = 278;
const COL_TYPE = 378;
const COL_CREATED = 548;
const HEAD_Y = 90;
const ROW_Y = 122;
const ROW_H = 48;
const headerLabels = [
  { label: "Artifact", x: COL_ARTIFACT },
  { label: "Version", x: COL_VERSION },
  { label: "Data type", x: COL_TYPE },
  { label: "Created", x: COL_CREATED },
] as const;

/**
 * Narrow (phone) drawing on the portrait 360×460 canvas: the same six
 * versions of the same two artifacts, with the Data type column dropped so
 * Artifact / Version / Created still fit at full type size, on 56px rows.
 */
const COL_N_ARTIFACT = 28;
const COL_N_VERSION = 186;
const COL_N_CREATED = 254;
const N_HEAD_Y = 54;
const N_ROW_Y = 86;
const N_ROW_H = 56;
const narrowHeaderLabels = [
  { label: "Artifact", x: COL_N_ARTIFACT },
  { label: "Version", x: COL_N_VERSION },
  { label: "Created", x: COL_N_CREATED },
] as const;
---

<HighlightFigure label={label} id={id}>
  <defs>
    <clipPath id={`${id}-card`}>
      <rect x="48" y="48" width="624" height="364" rx="16" />
    </clipPath>
    <LogoDefs prefix={id} names={["sklearn"]} />
  </defs>

  <rect x="48.5" y="48.5" width="623" height="363" rx="16" fill="var(--color-card)" />
  <text class="hl-title" x="68" y="69" dominant-baseline="central" fill="var(--color-cream-800)">Artifacts</text>
  <text class="hl-cell" x="652" y="69" dominant-baseline="central" text-anchor="end" fill="var(--color-cream-600)">2 artifacts · 6 versions</text>

  <g clip-path={`url(#${id}-card)`}>
    <g class="hl-in hl-row" style="--hl-i: 0">
      <rect x="48" y={HEAD_Y + 1} width="624" height="31" fill="var(--secondary)" />
      {
        headerLabels.map((h) => (
          <text class="hl-cell" x={h.x} y={HEAD_Y + 16} dominant-baseline="central" fill="var(--color-cream-600)">
            {h.label}
          </text>
        ))
      }
      <line x1="49" y1={ROW_Y - 0.5} x2="671" y2={ROW_Y - 0.5} stroke="var(--secondary-fill)" />
    </g>
    <line x1="49" y1={HEAD_Y + 0.5} x2="671" y2={HEAD_Y + 0.5} stroke="var(--color-border)" />

    {
      rows.map((r, k) => {
        const y = ROW_Y + k * ROW_H;
        const cy = y + ROW_H / 2;
        return (
          <g class:list={["hl-in hl-row", { "hl-accent": r.selected }]} style={`--hl-i: ${r.i}`}>
            {r.selected && <rect x="48" y={y} width="624" height={ROW_H - 1} fill="var(--hl-selected)" />}
            <Glyph name={r.icon} x={COL_ARTIFACT} y={cy - 8} size={16} color="var(--color-cream-600)" />
            <text class="hl-code-lead" x={COL_ARTIFACT + 26} y={cy} dominant-baseline="central" fill="var(--color-cream-800)">
              {r.name}
            </text>
            <rect
              x={COL_VERSION}
              y={cy - 10}
              width={tagWidth(r.version)}
              height="20"
              rx="4"
              fill={r.selected ? "var(--color-sage-100)" : "var(--secondary-fill)"}
            />
            <text
              class="hl-code"
              x={COL_VERSION + tagWidth(r.version) / 2}
              y={cy}
              dominant-baseline="central"
              text-anchor="middle"
              fill={r.selected ? "var(--color-sage-800)" : "var(--muted-foreground)"}
            >
              {r.version}
            </text>
            {r.type === "str" ? (
              <Chip x={COL_TYPE} cy={cy} text={r.type} glyph="type" />
            ) : (
              <Chip x={COL_TYPE} cy={cy} text={r.type} logo="sklearn" prefix={id} />
            )}
            <text class="hl-cell" x={COL_CREATED} y={cy} dominant-baseline="central" fill="var(--color-cream-700)">
              {r.created}
            </text>
            {k < rows.length - 1 && <line x1="49" y1={y + ROW_H - 0.5} x2="671" y2={y + ROW_H - 0.5} stroke="var(--secondary-fill)" />}
          </g>
        );
      })
    }
  </g>

  {/* Card outline on top, so the canvas and row fills never cover it */}
  <rect x="48.5" y="48.5" width="623" height="363" rx="16" fill="none" stroke="var(--color-border)" />

  <Fragment slot="narrow">
    <defs>
      <clipPath id={`${id}-n-card`}>
        <rect x="12" y="12" width="336" height="436" rx="12" />
      </clipPath>
    </defs>

    <rect x="12.5" y="12.5" width="335" height="435" rx="12" fill="var(--color-card)" />
    <text class="hl-title" x="28" y="33" dominant-baseline="central" fill="var(--color-cream-800)">Artifacts</text>
    <text class="hl-cell" x="332" y="33" dominant-baseline="central" text-anchor="end" fill="var(--color-cream-600)">2 artifacts · 6 versions</text>

    <g clip-path={`url(#${id}-n-card)`}>
      <g class="hl-in hl-row" style="--hl-i: 0">
        <rect x="12" y={N_HEAD_Y + 1} width="336" height="31" fill="var(--secondary)" />
        {
          narrowHeaderLabels.map((h) => (
            <text class="hl-cell" x={h.x} y={N_HEAD_Y + 16} dominant-baseline="central" fill="var(--color-cream-600)">
              {h.label}
            </text>
          ))
        }
        <line x1="13" y1={N_ROW_Y - 0.5} x2="347" y2={N_ROW_Y - 0.5} stroke="var(--secondary-fill)" />
      </g>
      <line x1="13" y1={N_HEAD_Y + 0.5} x2="347" y2={N_HEAD_Y + 0.5} stroke="var(--color-border)" />

      {
        rows.map((r, k) => {
          const y = N_ROW_Y + k * N_ROW_H;
          const cy = y + N_ROW_H / 2;
          return (
            <g class:list={["hl-in hl-row", { "hl-accent": r.selected }]} style={`--hl-i: ${r.i}`}>
              {r.selected && <rect x="12" y={y} width="336" height={N_ROW_H - 1} fill="var(--hl-selected)" />}
              <Glyph name={r.icon} x={COL_N_ARTIFACT} y={cy - 8} size={16} color="var(--color-cream-600)" />
              <text class="hl-code-lead" x={COL_N_ARTIFACT + 26} y={cy} dominant-baseline="central" fill="var(--color-cream-800)">
                {r.name}
              </text>
              <rect
                x={COL_N_VERSION}
                y={cy - 10}
                width={tagWidth(r.version)}
                height="20"
                rx="4"
                fill={r.selected ? "var(--color-sage-100)" : "var(--secondary-fill)"}
              />
              <text
                class="hl-code"
                x={COL_N_VERSION + tagWidth(r.version) / 2}
                y={cy}
                dominant-baseline="central"
                text-anchor="middle"
                fill={r.selected ? "var(--color-sage-800)" : "var(--muted-foreground)"}
              >
                {r.version}
              </text>
              <text class="hl-cell" x={COL_N_CREATED} y={cy} dominant-baseline="central" fill="var(--color-cream-700)">
                {r.created}
              </text>
              {k < rows.length - 1 && (
                <line x1="13" y1={y + N_ROW_H - 0.5} x2="347" y2={y + N_ROW_H - 0.5} stroke="var(--secondary-fill)" />
              )}
            </g>
          );
        })
      }
    </g>

    <rect x="12.5" y="12.5" width="335" height="435" rx="12" fill="none" stroke="var(--color-border)" />
  </Fragment>
</HighlightFigure>
