const steps = [
  { name: "train_model", x: 168, y: 100, state: "cached", accent: false },
  { name: "agent_loop", x: 392, y: 100, state: "cached", accent: false },
  { name: "publish_report", x: 280, y: 254, state: "12s", accent: true },
] as const;

/** Artifact pill: 150×48 at (x, y). */
