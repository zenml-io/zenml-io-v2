---

<HighlightFigure label={label} id={id}>
  <defs>
    <clipPath id={`${id}-card`}>
      <rect x="48" y="48" width="624" height="364" rx="16" />
    </clipPath>
    {/* Step-card shape, in each card's own coordinates: clips the square
        footer fill to the rounded corners. */}
    <clipPath id={`${id}-step`}>
      <rect x="0.5" y="0.5" width="159" height="61" rx="6" />
    </clipPath>
  </defs>

  {/* Run card */}
  <rect x="48.5" y="48.5" width="623" height="363" rx="16" fill="var(--color-card)" stroke="var(--color-border)" />
  <text class="hl-title" x="68" y="74" fill="var(--color-cream-900)">training_pipeline</text>
  <text class="hl-label" x="652" y="73" text-anchor="end" fill="var(--color-cream-700)">2 cached · 1 completed</text>
  <line x1="49" y1="90.5" x2="671" y2="90.5" stroke="var(--color-border)" />

  <g clip-path={`url(#${id}-card)`}>
    {/* Edges: upstream stubs and the cached branches */}
    <g class="hl-in hl-edge" style="--hl-i: 0" fill="none" stroke="var(--color-sage-400)" stroke-width="1.5">
      <path pathLength="1" d="M248 90 L248 100" />
      <path pathLength="1" d="M472 90 L472 100" />
      <path pathLength="1" d="M248 162 L248 184" />
      <path pathLength="1" d="M472 162 L472 184" />
    </g>
    {/* Edges of the re-run tail */}
    <g class="hl-in hl-edge" style="--hl-i: 3" fill="none" stroke="var(--color-sage-600)" stroke-width="1.5">
      <path pathLength="1" d="M248 232 L248 238 Q248 243 253 243 L355 243 Q360 243 360 248 L360 254" />
      <path pathLength="1" d="M472 232 L472 238 Q472 243 467 243 L365 243 Q360 243 360 248 L360 254" />
      <path pathLength="1" d="M360 316 L360 338" />
    </g>

    {steps.map((s) => (
      <g class={`hl-in${s.accent ? " hl-accent" : ""}`} style={`--hl-i: ${s.accent ? 4 : 1}`} transform={`translate(${s.x} ${s.y})`}>
        <rect
          x="0.5"
          y="0.5"
          width="159"
          height="61"
          rx="6"
          fill="var(--color-card)"
          stroke={s.accent ? "var(--color-sage-600)" : "var(--color-border)"}
        />
        <rect x="1" y="40" width="158" height="21" clip-path={`url(#${id}-step)`} fill={s.accent ? "var(--color-sage-100)" : "var(--color-background)"} />
        <line x1="1" y1="40.5" x2="159" y2="40.5" stroke={s.accent ? "var(--color-sage-600)" : "var(--color-border)"} />
        <rect x="6" y="6" width="28" height="28" rx="4" fill={s.accent ? "var(--color-sage-100)" : "var(--color-cream-100)"} />
        {s.accent ? (
          <path transform="translate(10 10) scale(0.606)" d={ICON_COMPLETED} fill="var(--color-sage-700)" fill-rule="evenodd" />
        ) : (
          <path transform="translate(10 10) scale(0.8333)" d={ICON_CACHED} fill="var(--color-cream-600)" fill-rule="evenodd" />
        )}
        <text class="hl-name" x="42" y="25" fill="var(--color-cream-900)">{s.name}</text>
        <text class="hl-mono" x="148" y="55" text-anchor="end" fill={s.accent ? "var(--color-sage-800)" : "var(--color-cream-700)"}>{s.state}</text>
      </g>
    ))}

    {artifacts.map((a, i) => (
      <g class="hl-in" style={`--hl-i: ${i === 2 ? 5 : 2}`} transform={`translate(${a.x} ${a.y})`}>
        <rect x="0.5" y="0.5" width="149" height="47" rx="12" fill="var(--color-sage-50)" stroke="var(--color-sage-200)" />
        <rect x="9" y="10" width="28" height="28" rx="8" fill="var(--color-sage-100)" />
        <path transform="translate(14 15) scale(0.75)" d={a.icon} fill="var(--color-sage-700)" fill-rule="evenodd" />
        <text class="hl-name" x="45" y="21" fill="var(--color-sage-800)" style="font-size: 13px">{a.name}</text>
        <text class="hl-body" x="45" y="36" fill="var(--color-cream-700)">{a.type}</text>
      </g>
    ))}
  </g>
</HighlightFigure>
