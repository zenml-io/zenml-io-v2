---
/**
 * highlight.zenml.caching — the "Caching and deduplication" figure: one run
 * graph of `training_pipeline` where the upstream steps (a training step and
 * an agent loop alike) are cached and only the tail step re-ran. Drawn in the
 * product UI's run-graph anatomy: cached steps go quiet (archive mark, no
 * duration), the re-run tail carries the selected state.
 */
import HighlightFigure from "../HighlightFigure.astro";
import ArtifactPill, { type ArtifactKind } from "../parts/ArtifactPill.astro";
import StepNode from "../parts/StepNode.astro";

interface Props {
  label: string;
  /** Suffixes the SVG ids when a page draws this figure twice, so each
   *  copy's url(#…) refs resolve to its own defs. */
  instance?: string;
}
const { label, instance } = Astro.props;
const id = instance ? `hl-zenml-caching-${instance}` : "hl-zenml-caching";

/** Wide drawing: two 240px lanes 32px apart, centred in the card. */
const L = 224;
const R = 496;
const MID = 360;
const TOP = 151;

const steps = [
  { name: "train_model", x: L - 120, y: TOP, status: "cached", i: 1 },
  { name: "agent_loop", x: R - 120, y: TOP, status: "cached", i: 1 },
  {
    name: "publish_report",
    x: MID - 120,
    y: TOP + 116,
    status: "completed",
    i: 4,
  },
] as const;

const artifacts: readonly {
  name: string;
  kind: ArtifactKind;
  cx: number;
  y: number;
  i: number;
}[] = [
  { name: "model", kind: "model", cx: L, y: TOP + 56, i: 2 },
  { name: "answer", kind: "other", cx: R, y: TOP + 56, i: 2 },
  { name: "report", kind: "other", cx: MID, y: TOP + 172, i: 5 },
];

const MERGE = TOP + 100;

/**
 * Narrow (phone) drawing on the 360×460 canvas: one column that keeps the
 * causal order — the two cached upstream steps (one ML, one agent) and their
 * artifacts converge on the re-run tail and its report, the training branch
 * bypassing the agent step on a rail at the left.
 */
const NC = 180;
const NT = 93;
const RAIL = 36;
const narrowSteps = [
  { name: "train_model", y: NT, status: "cached", i: 1 },
  { name: "agent_loop", y: NT + 116, status: "cached", i: 1 },
  { name: "publish_report", y: NT + 232, status: "completed", i: 4 },
] as const;
const narrowArtifacts: readonly {
  name: string;
  kind: ArtifactKind;
  y: number;
  i: number;
}[] = [
  { name: "model", kind: "model", y: NT + 56, i: 2 },
  { name: "answer", kind: "other", y: NT + 172, i: 2 },
  { name: "report", kind: "other", y: NT + 288, i: 5 },
];
const BYPASS = NT + 100;
const NMERGE = NT + 216;
---

<HighlightFigure label={label} id={id}>
  <defs>
    <clipPath id={`${id}-card`}>
      <rect x="48" y="48" width="624" height="364" rx="16" />
    </clipPath>
  </defs>

  <rect x="48.5" y="48.5" width="623" height="363" rx="16" fill="var(--color-card)" />
  <text class="hl-title" x="68" y="69" dominant-baseline="central" fill="var(--color-cream-800)">training_pipeline</text>
  <text class="hl-cell" x="652" y="69" dominant-baseline="central" text-anchor="end" fill="var(--color-cream-600)">2 cached · 1 completed</text>

  <g clip-path={`url(#${id}-card)`}>
    <rect x="48" y="91" width="624" height="321" fill="var(--secondary)" />
    <line x1="49" y1="90.5" x2="671" y2="90.5" stroke="var(--color-border)" />

    <g class="hl-in hl-edge" style="--hl-i: 0" fill="none" stroke="var(--hl-connector)" stroke-width="1">
      <path pathLength="1" d={`M${L} ${TOP + 40} V${TOP + 56}`} />
      <path pathLength="1" d={`M${R} ${TOP + 40} V${TOP + 56}`} />
    </g>
    <g class="hl-in hl-edge" style="--hl-i: 3" fill="none" stroke="var(--hl-connector)" stroke-width="1">
      <path pathLength="1" d={`M${L} ${TOP + 84} V${MERGE - 4} Q${L} ${MERGE} ${L + 4} ${MERGE} H${MID - 4} Q${MID} ${MERGE} ${MID} ${MERGE + 4} V${TOP + 116}`} />
      <path pathLength="1" d={`M${R} ${TOP + 84} V${MERGE - 4} Q${R} ${MERGE} ${R - 4} ${MERGE} H${MID + 4} Q${MID} ${MERGE} ${MID} ${MERGE + 4} V${TOP + 116}`} />
      <path pathLength="1" d={`M${MID} ${TOP + 156} V${TOP + 172}`} />
    </g>

    {
      steps.map((s) => (
        <StepNode
          name={s.name}
          x={s.x}
          y={s.y}
          status={s.status}
          duration={s.status === "completed" ? "12s" : undefined}
          selected={s.status === "completed"}
          i={s.i}
        />
      ))
    }
    {artifacts.map((a) => <ArtifactPill name={a.name} kind={a.kind} cx={a.cx} y={a.y} i={a.i} />)}
  </g>

  {/* Card outline on top, so the canvas and row fills never cover it */}
  <rect x="48.5" y="48.5" width="623" height="363" rx="16" fill="none" stroke="var(--color-border)" />

  <Fragment slot="narrow">
    <defs>
      <clipPath id={`${id}-n-card`}>
        <rect x="12" y="12" width="336" height="436" rx="12" />
      </clipPath>
    </defs>

    <rect x="12.5" y="12.5" width="335" height="435" rx="12" fill="var(--color-card)" />
    <text class="hl-title" x="28" y="33" dominant-baseline="central" fill="var(--color-cream-800)">training_pipeline</text>
    <text class="hl-cell" x="332" y="33" dominant-baseline="central" text-anchor="end" fill="var(--color-cream-600)">2 cached · 1 completed</text>

    <g clip-path={`url(#${id}-n-card)`}>
      <rect x="12" y="55" width="336" height="393" fill="var(--secondary)" />
      <line x1="13" y1="54.5" x2="347" y2="54.5" stroke="var(--color-border)" />

      <g class="hl-in hl-edge" style="--hl-i: 0" fill="none" stroke="var(--hl-connector)" stroke-width="1">
        <path pathLength="1" d={`M${NC} ${NT + 40} V${NT + 56}`} />
        <path pathLength="1" d={`M${NC} ${NT + 156} V${NT + 172}`} />
      </g>
      <g class="hl-in hl-edge" style="--hl-i: 3" fill="none" stroke="var(--hl-connector)" stroke-width="1">
        <path
          pathLength="1"
          d={`M${NC} ${NT + 84} V${BYPASS - 4} Q${NC} ${BYPASS} ${NC - 4} ${BYPASS} H${RAIL + 4} Q${RAIL} ${BYPASS} ${RAIL} ${BYPASS + 4} V${NMERGE - 4} Q${RAIL} ${NMERGE} ${RAIL + 4} ${NMERGE} H${NC - 4} Q${NC} ${NMERGE} ${NC} ${NMERGE + 4} V${NT + 232}`}
        />
        <path pathLength="1" d={`M${NC} ${NT + 200} V${NT + 232}`} />
        <path pathLength="1" d={`M${NC} ${NT + 272} V${NT + 288}`} />
      </g>

      {
        narrowSteps.map((s) => (
          <StepNode
            name={s.name}
            x={NC - 120}
            y={s.y}
            status={s.status}
            duration={s.status === "completed" ? "12s" : undefined}
            selected={s.status === "completed"}
            i={s.i}
          />
        ))
      }
      {narrowArtifacts.map((a) => <ArtifactPill name={a.name} kind={a.kind} cx={NC} y={a.y} i={a.i} />)}
    </g>

    <rect x="12.5" y="12.5" width="335" height="435" rx="12" fill="none" stroke="var(--color-border)" />
  </Fragment>
</HighlightFigure>
