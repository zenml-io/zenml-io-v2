---
/**
 * highlight.zenml.governance — the "Secrets and access" figure: a secrets
 * table holding both cloud credentials and a model-provider API key, next to
 * an execution trace of an agent run with its lineage. Drawn in the product
 * UI's anatomy: the secrets as a header-banded table with key-round icons and
 * mono keys, the trace as a run graph (artifact pill, step row, artifact pill).
 */
import HighlightFigure from "../HighlightFigure.astro";
import ArtifactPill from "../parts/ArtifactPill.astro";
import Glyph from "../parts/Glyph.astro";
import StatusBadge from "../parts/StatusBadge.astro";
import StepNode from "../parts/StepNode.astro";

interface Props {
  label: string;
  /** Suffixes the SVG ids when a page draws this figure twice, so each
   *  copy's url(#…) refs resolve to its own defs. */
  instance?: string;
}
const { label, instance } = Astro.props;
const id = instance ? `hl-zenml-governance-${instance}` : "hl-zenml-governance";

/** Secret rows in table order; `openai` is the selected row. */
const secrets = [
  { name: "aws_credentials", value: "aws_access_key_id, …", i: 1 },
  { name: "gcp_credentials", value: "service_account_json", i: 2 },
  { name: "openai", value: "api_key", i: 6, selected: true },
  { name: "anthropic", value: "api_key", i: 3 },
  { name: "github", value: "token", i: 4 },
  { name: "slack", value: "bot_token", i: 4 },
] as const;

/** Wide: secrets card x 48…408, trace card x 428…672. */
const HEAD_Y = 90;
const ROW_Y = 122;
const ROW_H = 48;
const COL_NAME = 68;
const COL_KEY = 240;
/** Trace graph: a 200px step (the card is 244 wide) centred on x 550. */
const TC = 550;
const TT = 187;

/**
 * Narrow (phone) drawing: one card — two secrets (a cloud credential and the
 * selected `openai` key) over the agent run they serve, as a second band with
 * its status badge and the same three-node trace.
 */
const N_HEAD_Y = 54;
const N_ROW_Y = 86;
const COL_N_NAME = 28;
const COL_N_KEY = 200;
const N_BAND_Y = N_ROW_Y + 2 * ROW_H;
const NC = 180;
const NT = 272;
const narrowSecrets = [
  {
    name: "aws_credentials",
    value: "aws_access_key_id",
    i: 1,
    selected: false,
  },
  { name: "openai", value: "api_key", i: 4, selected: true },
] as const;
---

<HighlightFigure label={label} id={id}>
  <defs>
    <clipPath id={`${id}-secrets`}>
      <rect x="48" y="48" width="360" height="364" rx="16" />
    </clipPath>
    <clipPath id={`${id}-trace`}>
      <rect x="428" y="48" width="244" height="364" rx="16" />
    </clipPath>
  </defs>

  <rect x="48.5" y="48.5" width="359" height="363" rx="16" fill="var(--color-card)" />
  <rect x="428.5" y="48.5" width="243" height="363" rx="16" fill="var(--color-card)" />

  <g clip-path={`url(#${id}-secrets)`}>
    <g class="hl-in" style="--hl-i: 0">
      <text class="hl-title" x="68" y="69" dominant-baseline="central" fill="var(--color-cream-800)">Secrets</text>
      <text class="hl-cell" x="388" y="69" dominant-baseline="central" text-anchor="end" fill="var(--color-cream-600)">6 secrets</text>
      <rect x="48" y={HEAD_Y + 1} width="360" height="31" fill="var(--secondary)" />
      <line x1="49" y1={HEAD_Y + 0.5} x2="407" y2={HEAD_Y + 0.5} stroke="var(--color-border)" />
      <text class="hl-cell" x={COL_NAME} y={HEAD_Y + 16} dominant-baseline="central" fill="var(--color-cream-600)">Secret</text>
      <text class="hl-cell" x={COL_KEY} y={HEAD_Y + 16} dominant-baseline="central" fill="var(--color-cream-600)">Key</text>
      <line x1="49" y1={ROW_Y - 0.5} x2="407" y2={ROW_Y - 0.5} stroke="var(--secondary-fill)" />
    </g>

    {
      secrets.map((s, k) => {
        const y = ROW_Y + k * ROW_H;
        const cy = y + ROW_H / 2;
        const selected = "selected" in s && s.selected;
        return (
          <g class:list={["hl-in hl-row", { "hl-accent": selected }]} style={`--hl-i: ${s.i}`}>
            {selected && <rect x="48" y={y} width="360" height={ROW_H - 1} fill="var(--hl-selected)" />}
            <Glyph name="key-round" x={COL_NAME} y={cy - 8} size={16} color="var(--color-cream-600)" />
            <text class="hl-code-lead" x={COL_NAME + 26} y={cy} dominant-baseline="central" fill="var(--color-cream-800)">
              {s.name}
            </text>
            <text class="hl-code" x={COL_KEY} y={cy} dominant-baseline="central" fill="var(--color-cream-700)">
              {s.value}
            </text>
            {k < secrets.length - 1 && <line x1="49" y1={y + ROW_H - 0.5} x2="407" y2={y + ROW_H - 0.5} stroke="var(--secondary-fill)" />}
          </g>
        );
      })
    }
  </g>

  <g clip-path={`url(#${id}-trace)`}>
    <rect x="428" y="91" width="244" height="321" fill="var(--secondary)" />
    <g class="hl-in" style="--hl-i: 0">
      <text class="hl-title" x="448" y="69" dominant-baseline="central" fill="var(--color-cream-800)">agent_pipeline</text>
      <StatusBadge status="completed" right={652} cy={69} />
      <line x1="429" y1="90.5" x2="671" y2="90.5" stroke="var(--color-border)" />
    </g>

    <g class="hl-in hl-edge" style="--hl-i: 5" fill="none" stroke="var(--hl-connector)" stroke-width="1">
      <path pathLength="1" d={`M${TC} ${TT + 28} V${TT + 44}`} />
      <path pathLength="1" d={`M${TC} ${TT + 84} V${TT + 100}`} />
    </g>
    <ArtifactPill name="documents" kind="data" cx={TC} y={TT} i={5} />
    <StepNode name="agent_loop" x={TC - 100} y={TT + 44} width={200} status="completed" duration="1m 14s" i={5} />
    <ArtifactPill name="answer" kind="other" cx={TC} y={TT + 100} i={5} />
  </g>

  {/* Card outlines on top, so the canvas and row fills never cover them */}
  <rect x="48.5" y="48.5" width="359" height="363" rx="16" fill="none" stroke="var(--color-border)" />
  <rect x="428.5" y="48.5" width="243" height="363" rx="16" fill="none" stroke="var(--color-border)" />

  <Fragment slot="narrow">
    <defs>
      <clipPath id={`${id}-n-card`}>
        <rect x="12" y="12" width="336" height="436" rx="12" />
      </clipPath>
    </defs>

    <rect x="12.5" y="12.5" width="335" height="435" rx="12" fill="var(--color-card)" />

    <g clip-path={`url(#${id}-n-card)`}>
      <g class="hl-in" style="--hl-i: 0">
        <text class="hl-title" x="28" y="33" dominant-baseline="central" fill="var(--color-cream-800)">Secrets</text>
        <text class="hl-cell" x="332" y="33" dominant-baseline="central" text-anchor="end" fill="var(--color-cream-600)">2 secrets</text>
        <rect x="12" y={N_HEAD_Y + 1} width="336" height="31" fill="var(--secondary)" />
        <line x1="13" y1={N_HEAD_Y + 0.5} x2="347" y2={N_HEAD_Y + 0.5} stroke="var(--color-border)" />
        <text class="hl-cell" x={COL_N_NAME} y={N_HEAD_Y + 16} dominant-baseline="central" fill="var(--color-cream-600)">Secret</text>
        <text class="hl-cell" x={COL_N_KEY} y={N_HEAD_Y + 16} dominant-baseline="central" fill="var(--color-cream-600)">Key</text>
        <line x1="13" y1={N_ROW_Y - 0.5} x2="347" y2={N_ROW_Y - 0.5} stroke="var(--secondary-fill)" />
      </g>

      {
        narrowSecrets.map((s, k) => {
          const y = N_ROW_Y + k * ROW_H;
          const cy = y + ROW_H / 2;
          return (
            <g class:list={["hl-in hl-row", { "hl-accent": s.selected }]} style={`--hl-i: ${s.i}`}>
              {s.selected && <rect x="12" y={y} width="336" height={ROW_H} fill="var(--hl-selected)" />}
              <Glyph name="key-round" x={COL_N_NAME} y={cy - 8} size={16} color="var(--color-cream-600)" />
              <text class="hl-code-lead" x={COL_N_NAME + 26} y={cy} dominant-baseline="central" fill="var(--color-cream-800)">
                {s.name}
              </text>
              <text class="hl-code" x={COL_N_KEY} y={cy} dominant-baseline="central" fill="var(--color-cream-700)">
                {s.value}
              </text>
              {!s.selected && <line x1="13" y1={y + ROW_H - 0.5} x2="347" y2={y + ROW_H - 0.5} stroke="var(--secondary-fill)" />}
            </g>
          );
        })
      }

      {/* The run those secrets serve, as a second band in the same card */}
      <g class="hl-in" style="--hl-i: 2">
        <line x1="13" y1={N_BAND_Y + 0.5} x2="347" y2={N_BAND_Y + 0.5} stroke="var(--color-border)" />
        <text class="hl-title" x="28" y={N_BAND_Y + 21} dominant-baseline="central" fill="var(--color-cream-800)">agent_pipeline</text>
        <StatusBadge status="completed" right={332} cy={N_BAND_Y + 21} />
        <rect x="12" y={N_BAND_Y + 43} width="336" height={448 - N_BAND_Y - 43} fill="var(--secondary)" />
        <line x1="13" y1={N_BAND_Y + 42.5} x2="347" y2={N_BAND_Y + 42.5} stroke="var(--color-border)" />
      </g>

      <g class="hl-in hl-edge" style="--hl-i: 3" fill="none" stroke="var(--hl-connector)" stroke-width="1">
        <path pathLength="1" d={`M${NC} ${NT + 28} V${NT + 44}`} />
        <path pathLength="1" d={`M${NC} ${NT + 84} V${NT + 100}`} />
      </g>
      <ArtifactPill name="documents" kind="data" cx={NC} y={NT} i={3} />
      <StepNode name="agent_loop" x={NC - 120} y={NT + 44} status="completed" duration="1m 14s" i={3} />
      <ArtifactPill name="answer" kind="other" cx={NC} y={NT + 100} i={3} />
    </g>

    <rect x="12.5" y="12.5" width="335" height="435" rx="12" fill="none" stroke="var(--color-border)" />
  </Fragment>
</HighlightFigure>
