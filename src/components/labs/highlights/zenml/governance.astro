/** Secret rows (non-accent), 300×48 local width, at (x, y). */
const secrets = [
  { name: "aws_credentials", value: "aws_access_key_id, …", y: 122, i: 1 },
  { name: "gcp_credentials", value: "service_account_json", y: 170, i: 2 },
  { name: "anthropic", value: "api_key", y: 266, i: 3 },
  { name: "github", value: "token", y: 314, i: 4 },
  { name: "slack", value: "bot_token", y: 362, i: 4 },
] as const;
---

<HighlightFigure label={label} id={id}>
  <defs>
    <clipPath id={`${id}-secrets`}>
      <rect x="48" y="48" width="360" height="364" rx="16" />
    </clipPath>
    <clipPath id={`${id}-trace`}>
      <rect x="428" y="48" width="244" height="364" rx="16" />
    </clipPath>
    {/* Step-card shape, in each card's own coordinates: clips the square
        footer fill to the rounded corners. */}
    <clipPath id={`${id}-step`}>
      <rect x="0.5" y="0.5" width="159" height="61" rx="6" />
    </clipPath>
  </defs>

  {/* Secrets card */}
  <rect x="48.5" y="48.5" width="359" height="363" rx="16" fill="var(--color-card)" stroke="var(--color-border)" />
  {/* agent_pipeline trace card */}
  <rect x="428.5" y="48.5" width="243" height="363" rx="16" fill="var(--color-card)" stroke="var(--color-border)" />

  <g class="hl-in" style="--hl-i: 0">
    <text class="hl-title" x="68" y="74" fill="var(--color-cream-900)">Secrets</text>
    <text class="hl-label" x="388" y="73" text-anchor="end" fill="var(--color-cream-700)">6 secrets</text>
    <line x1="49" y1="90.5" x2="407" y2="90.5" stroke="var(--color-border)" />
    <text class="hl-label" x="68" y="110" fill="var(--color-cream-700)">Secret</text>
    <text class="hl-label" x="218" y="110" fill="var(--color-cream-700)">Key</text>
    <line x1="60" y1="122.5" x2="408" y2="122.5" stroke="var(--color-border)" />

    <text class="hl-title" x="448" y="74" fill="var(--color-cream-900)">agent_pipeline</text>
    <text class="hl-label" x="652" y="73" text-anchor="end" fill="var(--color-cream-700)">completed</text>
    <line x1="429" y1="90.5" x2="671" y2="90.5" stroke="var(--color-border)" />
  </g>

  <g clip-path={`url(#${id}-secrets)`}>
    {secrets.map((s) => (
      <g class="hl-in hl-row" style={`--hl-i: ${s.i}`}>
        <rect x="68" y={s.y + 10} width="28" height="28" rx="8" fill="var(--color-sage-100)" />
        <path transform={`translate(73 ${s.y + 15}) scale(0.75)`} d={ICON_LOCK} fill="var(--color-sage-700)" fill-rule="evenodd" />
        <text class="hl-name" x="106" y={s.y + 33} fill="var(--color-cream-900)" style="font-size: 13px">{s.name}</text>
        <text class="hl-body" x="218" y={s.y + 33} fill="var(--color-cream-700)" style="font-size: 13px">{s.value}</text>
        <line x1="60" y1={s.y + 48.5} x2="408" y2={s.y + 48.5} stroke="var(--color-border)" />
      </g>
    ))}

    {/* Accent row: openai */}
    <g class="hl-in hl-accent" style="--hl-i: 6">
      <rect x="60.5" y="218.5" width="347" height="47" rx="5" fill="var(--color-sage-100)" stroke="var(--color-sage-400)" />
      <rect x="67" y="228" width="28" height="28" rx="8" fill="var(--color-sage-400)" />
      <path transform="translate(72 233) scale(0.75)" d={ICON_LOCK} fill="var(--color-sage-900)" fill-rule="evenodd" />
      <text class="hl-name" x="105" y="247" fill="var(--color-sage-900)" style="font-size: 13px">openai</text>
      <text class="hl-body" x="218" y="247" fill="var(--color-sage-800)" style="font-size: 13px">api_key</text>
    </g>
  </g>

  <g clip-path={`url(#${id}-trace)`}>
    <g class="hl-in" style="--hl-i: 5">
      {/* Lineage edges */}
      <g class="hl-edge" fill="none" stroke="var(--color-sage-400)" stroke-width="1.5">
        <path pathLength="1" d="M549 90 L549 110" />
        <path pathLength="1" d="M549 158 L549 219" />
        <path pathLength="1" d="M549 281 L549 342" />
      </g>

      {/* documents artifact pill */}
      <g transform="translate(474 110)">
        <rect x="0.5" y="0.5" width="149" height="47" rx="12" fill="var(--color-sage-50)" stroke="var(--color-sage-200)" />
        <rect x="9" y="10" width="28" height="28" rx="8" fill="var(--color-sage-100)" />
        <path transform="translate(14 15) scale(0.75)" d={ICON_DATABASE} fill="var(--color-sage-700)" fill-rule="evenodd" />
        <text class="hl-name" x="45" y="21" fill="var(--color-sage-800)" style="font-size: 13px">documents</text>
        <text class="hl-body" x="45" y="36" fill="var(--color-cream-700)">list</text>
      </g>

      {/* agent_loop step card (completed) */}
      <g transform="translate(469 219)">
        <rect x="0.5" y="0.5" width="159" height="61" rx="6" fill="var(--color-card)" stroke="var(--color-border)" />
        <rect x="1" y="40" width="158" height="21" clip-path={`url(#${id}-step)`} fill="var(--color-background)" />
        <line x1="1" y1="40.5" x2="159" y2="40.5" stroke="var(--color-border)" />
        <rect x="6" y="6" width="28" height="28" rx="4" fill="var(--color-sage-100)" />
        <path transform="translate(10 10) scale(0.606)" d={ICON_COMPLETED} fill="var(--color-sage-700)" fill-rule="evenodd" />
        <text class="hl-name" x="42" y="25" fill="var(--color-cream-900)">agent_loop</text>
        <text class="hl-mono" x="148" y="55" text-anchor="end" fill="var(--color-cream-700)">1:14min</text>
      </g>

      {/* answer artifact pill */}
      <g transform="translate(474 342)">
        <rect x="0.5" y="0.5" width="149" height="47" rx="12" fill="var(--color-sage-50)" stroke="var(--color-sage-200)" />
        <rect x="9" y="10" width="28" height="28" rx="8" fill="var(--color-sage-100)" />
        <path transform="translate(14 15) scale(0.75)" d={ICON_FILE} fill="var(--color-sage-700)" fill-rule="evenodd" />
        <text class="hl-name" x="45" y="21" fill="var(--color-sage-800)" style="font-size: 13px">answer</text>
        <text class="hl-body" x="45" y="36" fill="var(--color-cream-700)">str</text>
      </g>
    </g>
  </g>
</HighlightFigure>
