---
/**
 * highlight.zenml.orchestration — the "Pipelines and agents, one DAG" figure:
 * one run graph of `research_pipeline` where a training step and an agent
 * loop sit side by side, each fed by its own artifact, and both merge into a
 * shared evaluation step. Drawn in the product UI's run-graph anatomy: 40px
 * step rows, 28px artifact pills, 16px connectors with 4px elbows, and both
 * branches sharing one drop line into `evaluate`.
 */
import HighlightFigure from "../HighlightFigure.astro";
import ArtifactPill, { type ArtifactKind } from "../parts/ArtifactPill.astro";
import StepNode from "../parts/StepNode.astro";

interface Props {
  label: string;
  /** Suffixes the SVG ids when a page draws this figure twice, so each
   *  copy's url(#…) refs resolve to its own defs. */
  instance?: string;
}
const { label, instance } = Astro.props;
const id = instance
  ? `hl-zenml-orchestration-${instance}`
  : "hl-zenml-orchestration";

/** Wide drawing: two 240px lanes 32px apart, centred in the card. */
const L = 224;
const R = 496;
const MID = 360;
const TOP = 151;

const steps = [
  {
    name: "train_model",
    x: L - 120,
    y: TOP + 44,
    duration: "2m 41s",
    selected: false,
    i: 2,
  },
  {
    name: "agent_loop",
    x: R - 120,
    y: TOP + 44,
    duration: "1m 14s",
    selected: true,
    i: 6,
  },
  {
    name: "evaluate",
    x: MID - 120,
    y: TOP + 160,
    duration: "9s",
    selected: false,
    i: 5,
  },
] as const;

const artifacts: readonly {
  name: string;
  kind: ArtifactKind;
  cx: number;
  y: number;
  i: number;
}[] = [
  { name: "dataset", kind: "data", cx: L, y: TOP, i: 1 },
  { name: "documents", kind: "other", cx: R, y: TOP, i: 1 },
  { name: "model", kind: "model", cx: L, y: TOP + 100, i: 3 },
  { name: "answer", kind: "other", cx: R, y: TOP + 100, i: 3 },
];

/** The merge row: both branches drop 16px, turn, and share one 16px drop. */
const MERGE = TOP + 144;

/**
 * Narrow (phone) drawing on the 360×460 canvas — a re-authored variant, not a
 * scaled wide one. Two 240px lanes do not fit side by side, so the graph runs
 * as one column: `train_model` and its `model` on top, then `agent_loop` and
 * its `answer`. The training branch bypasses the agent step on a rail at the
 * left and both fold into `evaluate` through one shared drop line.
 */
const NC = 180;
const NT = 93;
const RAIL = 36;
const narrowSteps = [
  {
    name: "train_model",
    y: NT + 44,
    duration: "2m 41s",
    selected: false,
    i: 2,
  },
  { name: "agent_loop", y: NT + 160, duration: "1m 14s", selected: true, i: 5 },
  { name: "evaluate", y: NT + 276, duration: "9s", selected: false, i: 4 },
] as const;
const narrowArtifacts: readonly {
  name: string;
  kind: ArtifactKind;
  y: number;
  i: number;
}[] = [
  { name: "dataset", kind: "data", y: NT, i: 1 },
  { name: "model", kind: "model", y: NT + 100, i: 3 },
  { name: "answer", kind: "other", y: NT + 216, i: 3 },
];
const BYPASS = NT + 144;
const NMERGE = NT + 260;
---

<HighlightFigure label={label} id={id}>
  <defs>
    <clipPath id={`${id}-card`}>
      <rect x="48" y="48" width="624" height="364" rx="16" />
    </clipPath>
  </defs>

  {/* Run card: header band, then the graph on the canvas fill */}
  <rect x="48.5" y="48.5" width="623" height="363" rx="16" fill="var(--color-card)" />
  <text class="hl-title" x="68" y="69" dominant-baseline="central" fill="var(--color-cream-800)">research_pipeline</text>
  <text class="hl-cell" x="652" y="69" dominant-baseline="central" text-anchor="end" fill="var(--color-cream-600)">3 completed</text>

  <g clip-path={`url(#${id}-card)`}>
    <rect x="48" y="91" width="624" height="321" fill="var(--secondary)" />
    <line x1="49" y1="90.5" x2="671" y2="90.5" stroke="var(--color-border)" />

    <g class="hl-in hl-edge" style="--hl-i: 0" fill="none" stroke="var(--hl-connector)" stroke-width="1">
      <path pathLength="1" d={`M${L} ${TOP + 28} V${TOP + 44}`} />
      <path pathLength="1" d={`M${R} ${TOP + 28} V${TOP + 44}`} />
      <path pathLength="1" d={`M${L} ${TOP + 84} V${TOP + 100}`} />
      <path pathLength="1" d={`M${R} ${TOP + 84} V${TOP + 100}`} />
    </g>
    <g class="hl-in hl-edge" style="--hl-i: 4" fill="none" stroke="var(--hl-connector)" stroke-width="1">
      <path pathLength="1" d={`M${L} ${TOP + 128} V${MERGE - 4} Q${L} ${MERGE} ${L + 4} ${MERGE} H${MID - 4} Q${MID} ${MERGE} ${MID} ${MERGE + 4} V${TOP + 160}`} />
      <path pathLength="1" d={`M${R} ${TOP + 128} V${MERGE - 4} Q${R} ${MERGE} ${R - 4} ${MERGE} H${MID + 4} Q${MID} ${MERGE} ${MID} ${MERGE + 4} V${TOP + 160}`} />
    </g>

    {steps.map((s) => <StepNode name={s.name} x={s.x} y={s.y} status="completed" duration={s.duration} selected={s.selected} i={s.i} />)}
    {artifacts.map((a) => <ArtifactPill name={a.name} kind={a.kind} cx={a.cx} y={a.y} i={a.i} />)}
  </g>

  {/* Card outline on top, so the canvas and row fills never cover it */}
  <rect x="48.5" y="48.5" width="623" height="363" rx="16" fill="none" stroke="var(--color-border)" />

  <Fragment slot="narrow">
    <defs>
      <clipPath id={`${id}-n-card`}>
        <rect x="12" y="12" width="336" height="436" rx="12" />
      </clipPath>
    </defs>

    <rect x="12.5" y="12.5" width="335" height="435" rx="12" fill="var(--color-card)" />
    <text class="hl-title" x="28" y="33" dominant-baseline="central" fill="var(--color-cream-800)">research_pipeline</text>
    <text class="hl-cell" x="332" y="33" dominant-baseline="central" text-anchor="end" fill="var(--color-cream-600)">3 completed</text>

    <g clip-path={`url(#${id}-n-card)`}>
      <rect x="12" y="55" width="336" height="393" fill="var(--secondary)" />
      <line x1="13" y1="54.5" x2="347" y2="54.5" stroke="var(--color-border)" />

      <g class="hl-in hl-edge" style="--hl-i: 0" fill="none" stroke="var(--hl-connector)" stroke-width="1">
        <path pathLength="1" d={`M${NC} ${NT + 28} V${NT + 44}`} />
        <path pathLength="1" d={`M${NC} ${NT + 84} V${NT + 100}`} />
        <path pathLength="1" d={`M${NC} ${NT + 200} V${NT + 216}`} />
      </g>
      <g class="hl-in hl-edge" style="--hl-i: 3" fill="none" stroke="var(--hl-connector)" stroke-width="1">
        <path
          pathLength="1"
          d={`M${NC} ${NT + 128} V${BYPASS - 4} Q${NC} ${BYPASS} ${NC - 4} ${BYPASS} H${RAIL + 4} Q${RAIL} ${BYPASS} ${RAIL} ${BYPASS + 4} V${NMERGE - 4} Q${RAIL} ${NMERGE} ${RAIL + 4} ${NMERGE} H${NC - 4} Q${NC} ${NMERGE} ${NC} ${NMERGE + 4} V${NT + 276}`}
        />
        <path pathLength="1" d={`M${NC} ${NT + 244} V${NT + 276}`} />
      </g>

      {narrowSteps.map((s) => <StepNode name={s.name} x={NC - 120} y={s.y} status="completed" duration={s.duration} selected={s.selected} i={s.i} />)}
      {narrowArtifacts.map((a) => <ArtifactPill name={a.name} kind={a.kind} cx={NC} y={a.y} i={a.i} />)}
    </g>

    <rect x="12.5" y="12.5" width="335" height="435" rx="12" fill="none" stroke="var(--color-border)" />
  </Fragment>
</HighlightFigure>
