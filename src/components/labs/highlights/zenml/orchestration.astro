---

<HighlightFigure label={label} id={id}>
  <defs>
    <clipPath id={`${id}-card`}>
      <rect x="48" y="48" width="624" height="364" rx="16" />
    </clipPath>
    {/* Step-card shape, in each card's own coordinates: clips the square
        footer fill to the rounded corners. */}
    <clipPath id={`${id}-step`}>
      <rect x="0.5" y="0.5" width="159" height="61" rx="6" />
    </clipPath>
  </defs>

  {/* Run card */}
  <rect x="48.5" y="48.5" width="623" height="363" rx="16" fill="var(--color-card)" stroke="var(--color-border)" />
  <text class="hl-title" x="68" y="74" fill="var(--color-cream-900)">research_pipeline</text>
  <text class="hl-label" x="652" y="73" text-anchor="end" fill="var(--color-cream-700)">3 completed</text>
  <line x1="49" y1="90.5" x2="671" y2="90.5" stroke="var(--color-border)" />

  <g clip-path={`url(#${id}-card)`}>
    {/* Edges: incoming stubs and the two lanes feeding the step row */}
    <g class="hl-in hl-edge" style="--hl-i: 0" fill="none" stroke="var(--color-sage-400)" stroke-width="1.5">
      <path pathLength="1" d="M248 90 L248 106" />
      <path pathLength="1" d="M472 90 L472 106" />
      <path pathLength="1" d="M248 154 L248 176" />
      <path pathLength="1" d="M248 238 L248 260" />
    </g>
    <g class="hl-in hl-edge" style="--hl-i: 0" fill="none" stroke="var(--color-sage-600)" stroke-width="1.5">
      <path pathLength="1" d="M472 154 L472 176" />
      <path pathLength="1" d="M472 238 L472 260" />
    </g>
    {/* Merge edges: both lanes fold into evaluate */}
    <g class="hl-in hl-edge" style="--hl-i: 4" fill="none" stroke="var(--color-sage-400)" stroke-width="1.5">
      <path pathLength="1" d="M248 308 L248 314 Q248 319 253 319 L355 319 Q360 319 360 324 L360 330" />
      <path pathLength="1" d="M472 308 L472 314 Q472 319 467 319 L365 319 Q360 319 360 324 L360 330" />
    </g>

    {steps.map((s) => (
      <g class="hl-in" style={`--hl-i: ${s.hlI}`} transform={`translate(${s.x} ${s.y})`}>
        <rect
          x="0.5"
          y="0.5"
          width="159"
          height="61"
          rx="6"
          fill="var(--color-card)"
          stroke={s.accent ? "var(--color-sage-600)" : "var(--color-border)"}
        />
        <rect x="1" y="40" width="158" height="21" clip-path={`url(#${id}-step)`} fill={s.accent ? "var(--color-sage-100)" : "var(--color-background)"} />
        <line x1="1" y1="40.5" x2="159" y2="40.5" stroke={s.accent ? "var(--color-sage-600)" : "var(--color-border)"} />
        <rect x="6" y="6" width="28" height="28" rx="4" fill="var(--color-sage-100)" />
        <path transform="translate(10 10) scale(0.606)" d={ICON_COMPLETED} fill="var(--color-sage-700)" fill-rule="evenodd" />
        <text class="hl-name" x="42" y="25" fill="var(--color-cream-900)">{s.name}</text>
        <text class="hl-mono" x="148" y="55" text-anchor="end" fill={s.accent ? "var(--color-sage-800)" : "var(--color-cream-700)"}>{s.duration}</text>
      </g>
    ))}

    {artifacts.map((a) => (
      <g class="hl-in" style={`--hl-i: ${a.hlI}`} transform={`translate(${a.x} ${a.y})`}>
        <rect x="0.5" y="0.5" width="149" height="47" rx="12" fill="var(--color-sage-50)" stroke="var(--color-sage-200)" />
        <rect x="9" y="10" width="28" height="28" rx="8" fill="var(--color-sage-100)" />
        <path transform="translate(14 15) scale(0.75)" d={a.icon} fill="var(--color-sage-700)" fill-rule="evenodd" />
        <text class="hl-name" x="45" y="21" fill="var(--color-sage-800)" style="font-size: 13px">{a.name}</text>
        <text class="hl-body" x="45" y="36" fill="var(--color-cream-700)">{a.type}</text>
      </g>
    ))}
  </g>
</HighlightFigure>
