---

<HighlightFigure label={label} id={id}>
  <defs>
    <clipPath id={`${id}-card`}>
      <rect x="48" y="48" width="624" height="364" rx="16" />
    </clipPath>
  </defs>

  {/* Run card */}
  <rect x="48.5" y="48.5" width="623" height="363" rx="16" fill="var(--color-card)" stroke="var(--color-border)" />
  <text class="hl-title" x="68" y="74" fill="var(--color-cream-900)">k8s-prod</text>
  <text class="hl-label" x="652" y="73" text-anchor="end" fill="var(--color-cream-700)">4 components · 2 runs</text>
  <line x1="49" y1="90.5" x2="671" y2="90.5" stroke="var(--color-border)" />

  <g clip-path={`url(#${id}-card)`}>
    {components.map((c, i) => (
      <g class="hl-in hl-row" style={`--hl-i: ${i}`}>
        <rect x="68" y={c.y + 8} width="28" height="28" rx="8" fill="var(--color-sage-100)" />
        {c.name === "orchestrator" && (
          <path transform={`translate(73 ${c.y + 13}) scale(0.75)`} d={ICON_ORCHESTRATOR} fill="var(--color-sage-700)" fill-rule="evenodd" />
        )}
        {c.name === "artifact_store" &&
          ICON_S3.map((p) => (
            <path transform={`translate(73 ${c.y + 15}) scale(0.75)`} d={p.d} fill={p.fill} fill-rule="evenodd" />
          ))}
        {c.name === "deployer" && (
          <path transform={`translate(73 ${c.y + 15}) scale(0.75)`} d={ICON_DEPLOYER} fill="var(--color-sage-700)" fill-rule="evenodd" />
        )}
        {c.name === "sandbox" &&
          ICON_SANDBOX.map((d) => (
            <path transform={`translate(71.5 ${c.y + 11.5}) scale(0.875)`} d={d} fill="var(--color-sage-700)" fill-rule="evenodd" />
          ))}
        <text class="hl-name" x="106" y={c.y + 26} fill="var(--color-cream-900)">{c.name}</text>
        <text class="hl-body" x="278" y={c.y + 26} fill="var(--color-cream-700)" style="font-size: 13px">{c.flavor}</text>
        <line x1="60" y1={c.y + 44.5} x2="660" y2={c.y + 44.5} stroke="var(--color-border)" />
      </g>
    ))}

    {/* Header row */}
    <g class="hl-in hl-row" style="--hl-i: 4">
      <text class="hl-label" x="68" y="286" fill="var(--color-cream-700)">run</text>
      <text class="hl-label" x="278" y="286" fill="var(--color-cream-700)">status</text>
      <text class="hl-label" x="468" y="286" fill="var(--color-cream-700)">created at</text>
      <line x1="60" y1="298.5" x2="660" y2="298.5" stroke="var(--color-border)" />
    </g>

    {/* Completed run: training_pipeline */}
    <g class="hl-in hl-row" style="--hl-i: 5">
      <text class="hl-name" x="68" y="322" fill="var(--color-cream-900)">training_pipeline</text>
      <rect x="278" y="311" width="108" height="22" rx="4" fill="var(--color-sage-100)" />
      <path transform="translate(286 317) scale(0.4242)" d={ICON_COMPLETED} fill="var(--color-sage-700)" fill-rule="evenodd" />
      <text class="hl-mono" x="308" y="326" fill="var(--color-sage-800)" style="font-size: 13px">completed</text>
      <text class="hl-body" x="468" y="322" fill="var(--color-cream-700)" style="font-size: 13px">14 min ago</text>
    </g>

    {/* Accent run: agent_pipeline, still running on the same stack */}
    <g class="hl-in hl-row" style="--hl-i: 6">
      <rect x="60.5" y="342.5" width="599" height="47" rx="5" fill="var(--color-sage-100)" stroke="var(--color-sage-400)" />
      <text class="hl-name" x="68" y="370" fill="var(--color-sage-900)">agent_pipeline</text>
      <rect x="278" y="359" width="94" height="22" rx="4" fill="var(--color-sage-400)" />
      <path transform="translate(286 365) scale(0.5833)" d={ICON_RUNNING} fill="var(--color-sage-900)" fill-rule="evenodd" />
      <text class="hl-mono" x="308" y="374" fill="var(--color-sage-900)" style="font-size: 13px">running</text>
      <text class="hl-body" x="468" y="370" fill="var(--color-sage-800)" style="font-size: 13px">2 min ago</text>
    </g>
  </g>
</HighlightFigure>
