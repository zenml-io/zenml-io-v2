 * rows sit 4px tighter than the design so the accent run row clears the
 * card's bottom edge instead of sitting flush on it. */
const components = [
  { name: "orchestrator", flavor: "kubernetes", y: 90 },
  { name: "artifact_store", flavor: "s3", y: 134 },
  { name: "deployer", flavor: "kubernetes", y: 178 },
  { name: "sandbox", flavor: "docker", y: 222 },
