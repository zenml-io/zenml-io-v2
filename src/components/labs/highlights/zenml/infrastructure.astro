---
/**
 * highlight.zenml.infrastructure — the "Infrastructure" figure: one stack
 * (`k8s-prod`) listing its four components (orchestrator, artifact store,
 * deployer, sandbox) with two runs on it — a training run already completed
 * and an agent deployment still running on the same Kubernetes stack. Drawn
 * in the product UI's table anatomy: bare 16px component icons, flavor chips
 * with the service logo, a header band over the runs and status badges.
 */
import HighlightFigure from "../HighlightFigure.astro";
import Chip from "../parts/Chip.astro";
import Glyph, { type GlyphName } from "../parts/Glyph.astro";
import LogoDefs from "../parts/LogoDefs.astro";
import type { LogoName } from "../parts/logos";
import StatusBadge from "../parts/StatusBadge.astro";

interface Props {
  label: string;
  /** Suffixes the SVG ids when a page draws this figure twice, so each
   *  copy's url(#…) refs resolve to its own defs. */
  instance?: string;
}
const { label, instance } = Astro.props;
const id = instance
  ? `hl-zenml-infrastructure-${instance}`
  : "hl-zenml-infrastructure";

const components: readonly {
  name: string;
  flavor: string;
  icon: GlyphName;
  logo: LogoName;
}[] = [
  {
    name: "orchestrator",
    flavor: "kubernetes",
    icon: "workflow",
    logo: "kubernetes",
  },
  { name: "artifact_store", flavor: "s3", icon: "hard-drive", logo: "s3" },
  {
    name: "deployer",
    flavor: "kubernetes",
    icon: "rocket",
    logo: "kubernetes",
  },
  { name: "sandbox", flavor: "docker", icon: "container", logo: "docker" },
];
const LOGO_NAMES = ["kubernetes", "s3", "docker"] as const;

const runs = [
  {
    name: "training_pipeline",
    status: "completed",
    created: "14 min ago",
    selected: false,
  },
  {
    name: "agent_pipeline",
    status: "running",
    created: "2 min ago",
    selected: true,
  },
] as const;

/** Wide table: four 48px component rows from y 90, the runs header band, two run rows. */
const ROW_H = 48;
const COMP_Y = 90;
const HEAD_Y = COMP_Y + 4 * ROW_H;
const RUN_Y = HEAD_Y + 32;
const COL_NAME = 68;
const COL_SECOND = 278;
const COL_CREATED = 468;

/**
 * Narrow (phone) drawing: same stack, one column — the four components over
 * the two runs on 56px rows, with the `Created at` column dropped. The claim
 * (one stack, an ML run and an agent run on it) survives.
 */
const N_ROW_H = 56;
const N_COMP_Y = 54;
const N_HEAD_Y = N_COMP_Y + 4 * N_ROW_H;
const N_RUN_Y = N_HEAD_Y + 32;
const COL_N_NAME = 28;
const COL_N_SECOND = 204;
---

<HighlightFigure label={label} id={id}>
  <defs>
    <clipPath id={`${id}-card`}>
      <rect x="48" y="48" width="624" height="364" rx="16" />
    </clipPath>
    <LogoDefs prefix={id} names={LOGO_NAMES} />
  </defs>

  <rect x="48.5" y="48.5" width="623" height="363" rx="16" fill="var(--color-card)" />
  <text class="hl-title" x="68" y="69" dominant-baseline="central" fill="var(--color-cream-800)">k8s-prod</text>
  <text class="hl-cell" x="652" y="69" dominant-baseline="central" text-anchor="end" fill="var(--color-cream-600)">4 components · 2 runs</text>
  <line x1="49" y1="90.5" x2="671" y2="90.5" stroke="var(--color-border)" />

  <g clip-path={`url(#${id}-card)`}>
    {
      components.map((c, k) => {
        const cy = COMP_Y + k * ROW_H + ROW_H / 2;
        return (
          <g class="hl-in hl-row" style={`--hl-i: ${k}`}>
            <Glyph name={c.icon} x={COL_NAME} y={cy - 8} size={16} color="var(--color-cream-600)" />
            <text class="hl-code-lead" x={COL_NAME + 26} y={cy} dominant-baseline="central" fill="var(--color-cream-800)">
              {c.name}
            </text>
            <Chip x={COL_SECOND} cy={cy} text={c.flavor} logo={c.logo} prefix={id} />
            {k < components.length - 1 && (
              <line x1="49" y1={cy + ROW_H / 2 - 0.5} x2="671" y2={cy + ROW_H / 2 - 0.5} stroke="var(--secondary-fill)" />
            )}
          </g>
        );
      })
    }

    <g class="hl-in hl-row" style="--hl-i: 4">
      <rect x="48" y={HEAD_Y} width="624" height="32" fill="var(--secondary)" />
      <line x1="49" y1={HEAD_Y + 0.5} x2="671" y2={HEAD_Y + 0.5} stroke="var(--secondary-fill)" />
      <text class="hl-cell" x={COL_NAME} y={HEAD_Y + 16} dominant-baseline="central" fill="var(--color-cream-600)">Run</text>
      <text class="hl-cell" x={COL_SECOND} y={HEAD_Y + 16} dominant-baseline="central" fill="var(--color-cream-600)">Status</text>
      <text class="hl-cell" x={COL_CREATED} y={HEAD_Y + 16} dominant-baseline="central" fill="var(--color-cream-600)">Created at</text>
      <line x1="49" y1={RUN_Y - 0.5} x2="671" y2={RUN_Y - 0.5} stroke="var(--secondary-fill)" />
    </g>

    {
      runs.map((r, k) => {
        const y = RUN_Y + k * ROW_H;
        const cy = y + ROW_H / 2;
        return (
          <g class:list={["hl-in hl-row", { "hl-accent": r.selected }]} style={`--hl-i: ${5 + k}`}>
            {r.selected && <rect x="48" y={y} width="624" height={ROW_H} fill="var(--hl-selected)" />}
            <text class="hl-code-lead" x={COL_NAME} y={cy} dominant-baseline="central" fill="var(--color-cream-800)">
              {r.name}
            </text>
            <StatusBadge status={r.status} x={COL_SECOND} cy={cy} />
            <text class="hl-cell" x={COL_CREATED} y={cy} dominant-baseline="central" fill="var(--color-cream-700)">
              {r.created}
            </text>
            {k < runs.length - 1 && <line x1="49" y1={y + ROW_H - 0.5} x2="671" y2={y + ROW_H - 0.5} stroke="var(--secondary-fill)" />}
          </g>
        );
      })
    }
  </g>

  {/* Card outline on top, so the canvas and row fills never cover it */}
  <rect x="48.5" y="48.5" width="623" height="363" rx="16" fill="none" stroke="var(--color-border)" />

  <Fragment slot="narrow">
    <defs>
      <clipPath id={`${id}-n-card`}>
        <rect x="12" y="12" width="336" height="436" rx="12" />
      </clipPath>
      <LogoDefs prefix={`${id}-n`} names={LOGO_NAMES} />
    </defs>

    <rect x="12.5" y="12.5" width="335" height="435" rx="12" fill="var(--color-card)" />
    <text class="hl-title" x="28" y="33" dominant-baseline="central" fill="var(--color-cream-800)">k8s-prod</text>
    <text class="hl-cell" x="332" y="33" dominant-baseline="central" text-anchor="end" fill="var(--color-cream-600)">4 components · 2 runs</text>
    <line x1="13" y1="54.5" x2="347" y2="54.5" stroke="var(--color-border)" />

    <g clip-path={`url(#${id}-n-card)`}>
      {
        components.map((c, k) => {
          const cy = N_COMP_Y + k * N_ROW_H + N_ROW_H / 2;
          return (
            <g class="hl-in hl-row" style={`--hl-i: ${k}`}>
              <Glyph name={c.icon} x={COL_N_NAME} y={cy - 8} size={16} color="var(--color-cream-600)" />
              <text class="hl-code-lead" x={COL_N_NAME + 26} y={cy} dominant-baseline="central" fill="var(--color-cream-800)">
                {c.name}
              </text>
              <Chip x={COL_N_SECOND} cy={cy} text={c.flavor} logo={c.logo} prefix={`${id}-n`} />
              {k < components.length - 1 && (
                <line x1="13" y1={cy + N_ROW_H / 2 - 0.5} x2="347" y2={cy + N_ROW_H / 2 - 0.5} stroke="var(--secondary-fill)" />
              )}
            </g>
          );
        })
      }

      <g class="hl-in hl-row" style="--hl-i: 4">
        <rect x="12" y={N_HEAD_Y} width="336" height="32" fill="var(--secondary)" />
        <line x1="13" y1={N_HEAD_Y + 0.5} x2="347" y2={N_HEAD_Y + 0.5} stroke="var(--secondary-fill)" />
        <text class="hl-cell" x={COL_N_NAME} y={N_HEAD_Y + 16} dominant-baseline="central" fill="var(--color-cream-600)">Run</text>
        <text class="hl-cell" x={COL_N_SECOND} y={N_HEAD_Y + 16} dominant-baseline="central" fill="var(--color-cream-600)">Status</text>
        <line x1="13" y1={N_RUN_Y - 0.5} x2="347" y2={N_RUN_Y - 0.5} stroke="var(--secondary-fill)" />
      </g>

      {
        runs.map((r, k) => {
          const y = N_RUN_Y + k * N_ROW_H;
          const cy = y + N_ROW_H / 2;
          return (
            <g class:list={["hl-in hl-row", { "hl-accent": r.selected }]} style={`--hl-i: ${5 + k}`}>
              {r.selected && <rect x="12" y={y} width="336" height={N_ROW_H} fill="var(--hl-selected)" />}
              <text class="hl-code-lead" x={COL_N_NAME} y={cy} dominant-baseline="central" fill="var(--color-cream-800)">
                {r.name}
              </text>
              <StatusBadge status={r.status} x={COL_N_SECOND} cy={cy} />
              {k < runs.length - 1 && (
                <line x1="13" y1={y + N_ROW_H - 0.5} x2="347" y2={y + N_ROW_H - 0.5} stroke="var(--secondary-fill)" />
              )}
            </g>
          );
        })
      }
    </g>

    <rect x="12.5" y="12.5" width="335" height="435" rx="12" fill="none" stroke="var(--color-border)" />
  </Fragment>
</HighlightFigure>
