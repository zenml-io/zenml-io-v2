---
/**
 * LabsTraceFinding (`labs.trace-finding`) — the homepage hero's example,
 * one finding told through the trace it came from, drawn as the AI
 * engineer's message card: its author row (agent and window as meta), the
 * system prompt with the offending line lit, the calls showing the cache
 * read at zero, the finding on the red tint, then a footer with the monthly
 * cost and the drafted fix.
 *
 * Motion (one moment, on load): the card rises like
 * labs.missed-session-visual, then the parts arrive in reading order.
 * Animations fill backwards, so server render and reduced motion show the
 * finished card. The figcaption carries the whole example as text; the
 * drawn card is aria-hidden. Copy arrives through `content`
 * (LABS_HERO_TRACE).
 */
import type { TraceFindingContent } from "../../lib/labs-home";
import LabsAiEngineerRow from "./LabsAiEngineerRow.astro";

interface Props {
  content: TraceFindingContent;
}
const { content } = Astro.props;
const LABEL =
  "block font-label text-[11px] leading-4 uppercase tracking-[0.05em]";
---

<figure class="tf-card overflow-hidden rounded-[16px] border border-(--color-border) bg-card shadow-[0_1px_2px_rgba(65,61,55,0.04),0_12px_32px_rgba(65,61,55,0.08)] transition-colors duration-200 ease-out hover:border-(--color-sage-400)">
  <figcaption class="sr-only">{content.label}</figcaption>
  <div aria-hidden="true">
    <div class="tf-step" style="--i: 0">
      <LabsAiEngineerRow>
        <span class="shrink-0 font-mono text-[12px] leading-4 text-(--color-cream-700)">{content.meta}</span>
      </LabsAiEngineerRow>
    </div>

    <div class="flex flex-col gap-4 px-5 pt-5 pb-6 md:px-6">
      <div class="tf-step rounded-[12px] bg-background p-4" style="--i: 1">
        <span class:list={[LABEL, "text-(--color-cream-600)"]}>{content.prompt.label}</span>
        <ol class="mt-2 flex flex-col gap-1 font-mono text-[13px] leading-5">
          {content.prompt.lines.map((line, index) => (
            <li class:list={["flex gap-3 rounded-[4px] px-1.5", line.hot ? "bg-(--color-orange-50) text-(--color-orange-600) ring-1 ring-(--color-orange-500)/40" : "text-(--color-cream-800)"]}>
              <span class="w-3 shrink-0 text-right text-(--color-cream-600)">{index + 1}</span>
              <span class="min-w-0 truncate">{line.text}</span>
            </li>
          ))}
        </ol>
      </div>

      <div class="tf-step" style="--i: 2">
        <div class="flex items-baseline justify-between gap-3">
          <span class:list={[LABEL, "text-(--color-cream-600)"]}>{content.calls.label}</span>
          <span class="flex gap-4 font-label text-[11px] leading-4 uppercase tracking-[0.05em] text-(--color-cream-600)">
            <span class="w-14 text-right">Cached</span>
            <span class="w-14 text-right">Written</span>
          </span>
        </div>
        <ul class="mt-2 divide-y divide-(--color-border) border-y border-(--color-border) font-mono text-[13px] leading-5">
          {content.calls.rows.map((row) => (
            <li class="flex items-center justify-between gap-3 py-1.5">
              <span class="text-(--color-cream-700)">{row.id}</span>
              <span class="flex gap-4">
                <span class="w-14 text-right font-medium text-destructive">{row.read}</span>
                <span class="w-14 text-right text-(--color-cream-900)">{row.write}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>

      <div class="tf-step rounded-[12px] border border-destructive/20 bg-destructive/5 px-4 py-4" style="--i: 3">
        <span class:list={[LABEL, "text-destructive"]}>{content.finding.by}</span>
        <span class="mt-1.5 block font-sans text-[16px] leading-6 font-medium text-(--color-cream-900)">{content.finding.text}</span>
      </div>

      <div class="tf-step flex flex-wrap items-center justify-between gap-3 border-t border-(--color-border) pt-4" style="--i: 4">
        <span class="font-mono text-[15px] leading-5 font-medium text-(--color-cream-900)">{content.impact}</span>
        <span class="rounded-full border border-(--color-sage-400) px-2.5 py-1 font-mono text-[12px] leading-4 text-(--color-sage-800)">
          Fix: {content.fix}
        </span>
      </div>
    </div>
  </div>
</figure>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .tf-card {
      animation: tf-card-in 900ms var(--ease-out-expo) 100ms backwards;
    }
    .tf-step {
      animation: tf-step 600ms var(--ease-out-quint) calc(380ms + var(--i) * 380ms) backwards;
    }
  }
  @keyframes tf-card-in {
    from {
      opacity: 0;
      filter: blur(8px);
      transform: translateY(24px) scale(0.97);
    }
  }
  @keyframes tf-step {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
</style>
