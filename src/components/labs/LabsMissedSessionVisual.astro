---
/**
 * LabsMissedSessionVisual (`labs.missed-session-visual`) — the homepage
 * hero's example, told through one session: a short customer and agent
 * exchange, the team's own eval passing the reply, the AI engineer's note
 * on what the reply got wrong, then how many sessions like it passed and
 * the check it drafts. The eval verdict sits in sage, the finding on the
 * orange tint, so the disagreement reads at a glance.
 *
 * Motion (one moment, on load): the parts arrive in reading order, the
 * finding last before the footer. Server render and reduced motion show
 * the finished card. Transform and opacity only. The figcaption carries
 * the whole example as text; the drawn card is aria-hidden. Copy arrives
 * through `content` (LABS_HERO_SESSION).
 */
import type { MissedSessionVisualContent } from "../../lib/labs-home";

interface Props {
  content: MissedSessionVisualContent;
}
const { content } = Astro.props;
---

<figure class="rounded-[20px] border border-(--color-border) bg-card p-6 transition-colors duration-200 ease-out hover:border-(--color-sage-400) md:p-8">
  <figcaption class="sr-only">{content.label}</figcaption>
  <div aria-hidden="true">
    <p class="ms-step font-mono text-[13px] leading-5 text-(--color-cream-700)" style="--i: 0">{content.session}</p>

    <ul class="mt-4 flex list-none flex-col gap-2.5">
      {content.messages.map((message, index) => (
        <li
          class:list={[
            "ms-step max-w-[85%] rounded-[14px] px-3.5 py-2.5 font-sans text-[15px] leading-[22px]",
            message.from === "customer"
              ? "self-start rounded-bl-[4px] bg-(--color-cream-100) text-(--color-cream-900)"
              : "self-end rounded-br-[4px] bg-(--color-sage-800) text-(--color-cream-50)",
          ]}
          style={`--i: ${index + 1}`}
        >
          {message.text}
        </li>
      ))}
    </ul>

    <div class="ms-step mt-5 flex items-center justify-between gap-3 rounded-[12px] border border-(--color-border) px-3.5 py-2.5" style={`--i: ${content.messages.length + 1}`}>
      <span class="min-w-0">
        <span class="block font-label text-[11px] leading-4 uppercase tracking-[0.05em] text-(--color-cream-700)">{content.eval.label}</span>
        <span class="block font-mono text-[13px] leading-5 text-(--color-cream-900)">{content.eval.name}</span>
      </span>
      <span class="shrink-0 rounded-full bg-(--color-sage-100) px-2.5 py-1 font-label text-[11px] leading-4 uppercase tracking-[0.05em] text-(--color-sage-800)">
        ✓ {content.eval.verdict}
      </span>
    </div>

    <div class="ms-step mt-3 rounded-[12px] border border-(--color-orange-200) bg-(--color-orange-50) px-3.5 py-3" style={`--i: ${content.messages.length + 2}`}>
      <span class="block font-label text-[11px] leading-4 uppercase tracking-[0.05em] text-(--color-orange-700)">{content.finding.by}</span>
      <span class="mt-1 block font-sans text-[15px] leading-[22px] text-(--color-cream-900)">{content.finding.text}</span>
    </div>

    <div class="ms-step mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-(--color-border) pt-4" style={`--i: ${content.messages.length + 3}`}>
      <span class="font-sans text-[14px] leading-5 text-(--color-cream-800)">{content.tally}</span>
      <span class="rounded-full border border-(--color-sage-400) px-2.5 py-1 font-mono text-[12px] leading-4 text-(--color-sage-800)">
        + {content.check}
      </span>
    </div>
  </div>
</figure>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .ms-step {
      animation: ms-step 600ms cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: calc(200ms + var(--i) * 380ms);
    }
  }
  @keyframes ms-step {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
</style>
