---
/**
 * LabsFindingsLog (`labs.findings-log`) — the homepage's breadth moment,
 * right after the hero: eyebrow, headline and deck, then the AI engineer's
 * log in columns, one per kind of problem (Evals, Reliability, Cost,
 * Models and training), each a short stack of one-line findings with a
 * "fix drafted" mark. A closing line ties agents and models together.
 * None of it repeats the hero card (labs.findings), which goes deep on one
 * finding per kind. Columns sit four across from lg, two from md. Copy
 * arrives through `content` (LABS_FINDINGS_LOG).
 */
import type { FindingsLogContent } from "../../lib/labs-home";
import "../../styles/labs-scroll-reveal.css";
import { LABS_EYEBROW_CLASS } from "../templates/pageHeaderPresets";

interface Props {
  content: FindingsLogContent;
}
const { content } = Astro.props;
---

<section class="py-24 md:py-32">
  <div class="scroll-reveal-section mx-auto max-w-content px-gutter">
    <p class:list={["reveal-child", LABS_EYEBROW_CLASS]}>{content.eyebrow}</p>
    <h2 class="reveal-child mt-3 max-w-[860px] font-display text-[32px] leading-[38px] text-balance text-(--color-cream-900) md:text-[48px] md:leading-[54px]">
      {content.headline}
    </h2>
    <p class="reveal-child stagger-1 mt-6 max-w-[680px] font-sans text-[17px] leading-[26px] text-pretty text-(--color-cream-700)">
      {content.deck}
    </p>

    <div class="reveal-child stagger-2 mt-space-xl grid grid-cols-1 gap-x-6 gap-y-10 md:grid-cols-2 lg:grid-cols-4">
      {content.columns.map((column) => (
        <div>
          <h3 class="border-b border-(--color-cream-900) pb-3 font-label text-[12px] leading-4 uppercase tracking-[0.05em] text-(--color-cream-900)">
            {column.label}
          </h3>
          <ul class="divide-y divide-(--color-border)">
            {column.items.map((item) => (
              <li class="py-4">
                <p class="font-sans text-[15px] leading-[22px] text-pretty text-(--color-cream-900)">{item}</p>
                <p class="mt-2 font-mono text-[12px] leading-4 text-(--color-sage-700)">✓ Fix drafted</p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <p class="reveal-child mt-space-lg font-display text-[22px] leading-[28px] text-(--color-cream-900)">{content.footer}</p>
  </div>
</section>
