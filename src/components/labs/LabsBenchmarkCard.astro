---
import type {
  BenchmarkPreview,
  BenchmarkReport,
} from "../../lib/benchmarkReports";
import { longDate } from "../../lib/benchmarkReports/format";
import { ENTRY_ROW_TITLE_LINK } from "./entryRowStyles";

/**
 * labs.benchmark-card — one experiment on /benchmarks, led by its result:
 * a small label (domain · run date), the benchmark's name as the title, its
 * question in one line, topic tags as static chips, then a
 * single-hue sage bar chart of the benchmark's headline metric with direct
 * labels and a "higher/lower is better" note (DESIGN.md "Data
 * visualization"). The title link is stretched over the card to the report;
 * a published companion post adds a "Read the story" link above it.
 */
interface Props {
  report: BenchmarkReport;
  preview: BenchmarkPreview;
  /** The companion post, when it is published. */
  postHref?: string;
}
const { report, preview, postHref } = Astro.props;
const max = preview.max ?? Math.max(...preview.rows.map((row) => row.value));
const width = (value: number) =>
  `${Math.max(2, Math.round((value / max) * 100))}%`;
---

<article class="group relative flex h-full flex-col rounded-[20px] border border-(--color-border) bg-card p-6 transition-colors duration-200 ease-out hover:border-(--color-sage-400) focus-within:border-(--color-sage-400)">
  <p class="font-sans text-[13px] leading-5 text-(--color-cream-700)">
    {report.card.domain} &middot; <time datetime={report.date}>{longDate(report.date)}</time>
  </p>
  <h3 class="mt-2 font-display text-[22px] leading-[28px] text-(--color-cream-900) transition-colors duration-200 ease-out group-hover:text-(--color-sage-800)">
    <a href={`/benchmarks/${report.slug}`} class={ENTRY_ROW_TITLE_LINK}>{report.name}</a>
  </h3>
  <p class="mt-1 font-sans text-[15px] leading-[22px] text-(--color-cream-800)">{report.title}</p>
  <ul class="mt-3 flex list-none flex-wrap gap-1.5" aria-label="Tags">
    {report.tags.map((tag) => (
      <li class="inline-flex h-6 items-center rounded-full border border-(--color-border) bg-(--color-sage-50) px-2 font-sans text-[11px] leading-none font-medium text-(--color-cream-800)">{tag}</li>
    ))}
  </ul>

  <figure class="mt-5">
    <figcaption class="font-sans text-[13px] leading-[18px] text-(--color-cream-700)">
      {preview.metric} <span class="text-(--color-cream-600)">· {preview.better} is better</span>
    </figcaption>
    <dl class="mt-3 grid gap-2">
      {preview.rows.map((row) => (
        <div class="grid grid-cols-[minmax(0,9rem)_minmax(0,1fr)] items-center gap-3">
          <dt class:list={["truncate font-sans text-[13px] leading-5", row.emphasis ? "font-medium text-(--color-cream-900)" : "text-(--color-cream-800)"]} title={row.label}>
            {row.label}
          </dt>
          <dd class="flex min-w-0 items-center gap-2">
            <span class="h-2.5 min-w-0 flex-1 rounded-full bg-(--color-sage-100)" aria-hidden="true">
              <span
                class:list={["block h-full rounded-full", row.emphasis ? "bg-(--color-sage-800)" : "bg-(--color-sage-500)"]}
                style={`width: ${width(row.value)}`}
              ></span>
            </span>
            <span class="shrink-0 font-sans text-[13px] leading-5 tabular-nums text-(--color-cream-900)">{row.display}</span>
          </dd>
        </div>
      ))}
    </dl>
  </figure>

  <div class="mt-auto flex items-center justify-between gap-4 pt-6 font-sans text-[14px] leading-5">
    <span class="text-(--color-sage-800)">View the results <span aria-hidden="true">→</span></span>
    {postHref && (
      <a
        href={postHref}
        class="relative z-10 text-(--color-cream-700) underline decoration-(--color-sage-400) underline-offset-4 transition-colors duration-200 ease-out hover:text-(--color-sage-800)"
      >
        Read the story
      </a>
    )}
  </div>
</article>
