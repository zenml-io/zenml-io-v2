---
import type { BenchmarkReport } from "../../lib/benchmarkReports";
import { longDate } from "../../lib/benchmarkReports/format";
import { ENTRY_ROW_TITLE_LINK } from "./entryRowStyles";

/**
 * labs.benchmark-card — one experiment on /benchmarks: domain and data
 * source as card labels, the question as the title, the headline finding,
 * three stats and the run date. The whole card links to the report page.
 */
interface Props {
  report: BenchmarkReport;
}
const { report } = Astro.props;
const { card } = report;
---

<a
  href={`/benchmarks/${report.slug}`}
  class="group flex h-full cursor-pointer flex-col rounded-[20px] border border-(--color-border) bg-card p-8 transition-colors duration-200 ease-out hover:border-(--color-sage-400) hover:bg-(--color-sage-50) focus-visible:border-(--color-sage-400) focus-visible:bg-(--color-sage-50) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--color-sage-600) md:p-10"
>
  <p class="flex flex-wrap gap-x-3 gap-y-1 font-mono text-[13px] leading-5 uppercase tracking-[0.05em] text-(--color-sage-800)">
    <span>{card.domain}</span>
    <span aria-hidden="true">·</span>
    <span>{card.data}</span>
  </p>
  <h3 class="mt-space-sm font-display text-[26px] leading-[32px] text-(--color-cream-900) transition-colors duration-200 ease-out group-hover:text-(--color-sage-800) group-focus-visible:text-(--color-sage-800) md:text-[30px] md:leading-[36px]">
    <span class={ENTRY_ROW_TITLE_LINK}>{report.title}</span>
  </h3>
  <p class="mt-space-sm font-sans text-[16px] leading-[25px] text-(--color-cream-700)">
    {card.finding}
  </p>
  <dl class="mt-space-md grid grid-cols-3 gap-4 border-t border-(--color-border) pt-space-sm">
    {card.stats.map((stat) => (
      <div class="flex flex-col-reverse gap-1">
        <dt class="font-sans text-[13px] leading-[18px] text-(--color-cream-700)">{stat.label}</dt>
        <dd class="font-display text-[24px] leading-[30px] text-(--color-cream-900) md:text-[28px] md:leading-[34px]">{stat.value}</dd>
      </div>
    ))}
  </dl>
  <p class="mt-auto flex items-center justify-between gap-4 pt-space-md font-sans text-[14px] leading-5 text-(--color-cream-700)">
    <time datetime={report.date}>{longDate(report.date)}</time>
    <span class="text-(--color-sage-800)">View the results <span aria-hidden="true">→</span></span>
  </p>
</a>
