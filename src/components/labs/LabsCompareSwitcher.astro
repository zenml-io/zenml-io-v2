---
import type { CompareSwitcherGroup } from "../../lib/labsComparison";

interface Props {
  currentLabel: string;
  currentMark?: { url: string; alt: string };
  groups: readonly CompareSwitcherGroup[];
}

const { currentLabel, currentMark, groups } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "");
---

<div class="relative z-20 min-w-0 max-w-full" data-compare-switcher>
  <button
    type="button"
    id="compare-switcher-trigger"
    class="flex min-h-11 max-w-full cursor-pointer items-center gap-3 rounded-full border border-(--color-border) bg-card px-4 py-2 font-sans text-[15px] leading-5 font-medium text-(--color-cream-900) transition-colors duration-200 ease-out hover:border-(--color-sage-400) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-sage-600)"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="compare-switcher-menu"
    aria-label={`Switch comparison. Currently ${currentLabel}.`}
    data-compare-switcher-trigger
  >
    {currentMark ? (
      <img src={currentMark.url} alt="" aria-hidden="true" class="h-10 w-10 shrink-0 object-contain" />
    ) : (
      <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-(--color-sage-100) font-sans text-[16px] text-(--color-sage-800)" aria-hidden="true">
        {currentLabel.charAt(0)}
      </span>
    )}
    <span class="min-w-0 truncate">{currentLabel}</span>
    <svg class="h-4 w-4 shrink-0 text-(--color-cream-500)" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m5 7.5 5 5 5-5" />
    </svg>
  </button>

  <div
    id="compare-switcher-menu"
    class="compare-switcher-menu absolute top-[calc(100%+8px)] left-0 hidden w-[min(420px,calc(100vw-2*var(--spacing-gutter)))] overflow-hidden rounded-[20px] border border-(--color-border) bg-card"
    role="menu"
    aria-labelledby="compare-switcher-trigger"
    data-compare-switcher-menu
  >
    <div class="compare-switcher-scroll max-h-[60vh] min-h-[min(24rem,60vh)] overflow-y-scroll overscroll-contain">
      {groups.map((group) => (
        <section aria-label={group.label}>
          <h2 class="sticky top-0 z-10 border-b border-(--color-border) bg-(--color-sage-50) px-5 py-2 font-sans text-[13px] leading-4 font-medium text-(--color-cream-700)">
            {group.label}
          </h2>
          <ul class="list-none">
            {group.options.map((option) => (
              <li class="border-b border-(--color-border) last:border-b-0" role="none">
                <a
                  href={option.href}
                  role="menuitem"
                  aria-current={option.href.replace(/\/$/, "") === currentPath ? "page" : undefined}
                  class="group flex min-h-12 items-center gap-3 px-5 py-3 font-sans text-[15px] leading-5 text-(--color-cream-800) transition-colors duration-200 ease-out hover:bg-(--color-sage-50) hover:text-(--color-cream-900) focus-visible:bg-(--color-sage-50) focus-visible:outline-none aria-[current=page]:bg-(--color-sage-100)"
                >
                  {option.mark ? (
                    <img src={option.mark.url} alt="" aria-hidden="true" class="h-6 w-6 shrink-0 object-contain" loading="lazy" />
                  ) : (
                    <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-(--color-sage-100) text-[12px] text-(--color-sage-800)" aria-hidden="true">
                      {option.label.charAt(0)}
                    </span>
                  )}
                  <span class="min-w-0 flex-1 group-hover:underline group-hover:decoration-(--color-sage-400) group-hover:underline-offset-4 group-focus-visible:underline group-focus-visible:underline-offset-4">{option.label}</span>
                  <svg class="h-4 w-4 shrink-0 text-(--color-cream-500) transition-colors duration-200 ease-out group-hover:text-(--color-sage-800)" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m7.5 5 5 5-5 5" />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</div>

<style>
  @media (max-width: 639px) {
    .compare-switcher-menu { position: fixed; top: var(--compare-menu-top); left: var(--spacing-gutter); }
  }
  .compare-switcher-scroll {
    scrollbar-color: var(--color-sage-500) var(--color-sage-100);
    scrollbar-gutter: stable;
    scrollbar-width: auto;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-compare-switcher]").forEach((root) => {
    const trigger = root.querySelector<HTMLButtonElement>("[data-compare-switcher-trigger]");
    const menu = root.querySelector<HTMLElement>("[data-compare-switcher-menu]");
    if (!trigger || !menu || root.dataset.compareSwitcherWired === "true") return;
    root.dataset.compareSwitcherWired = "true";

    const items = () => Array.from(menu.querySelectorAll<HTMLAnchorElement>('[role="menuitem"]'));
    const close = (returnFocus = false) => {
      menu.classList.add("hidden");
      trigger.setAttribute("aria-expanded", "false");
      if (returnFocus) trigger.focus();
    };
    const open = (focus: "first" | "last" | false = false) => {
      menu.style.setProperty("--compare-menu-top", `${Math.min(trigger.getBoundingClientRect().bottom + 8, window.innerHeight - Math.min(window.innerHeight * 0.6, 384) - 16)}px`);
      menu.classList.remove("hidden");
      trigger.setAttribute("aria-expanded", "true");
      if (focus) {
        const menuItems = items();
        (focus === "first" ? menuItems[0] : menuItems.at(-1))?.focus();
      }
    };

    trigger.addEventListener("click", () => {
      trigger.getAttribute("aria-expanded") === "true" ? close() : open();
    });
    trigger.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown" || event.key === "ArrowUp") {
        event.preventDefault();
        open(event.key === "ArrowDown" ? "first" : "last");
      }
    });
    menu.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        event.preventDefault();
        close(true);
        return;
      }
      if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
      event.preventDefault();
      const menuItems = items();
      const index = menuItems.indexOf(document.activeElement as HTMLAnchorElement);
      const delta = event.key === "ArrowDown" ? 1 : -1;
      menuItems[(index + delta + menuItems.length) % menuItems.length]?.focus();
    });
    document.addEventListener("click", (event) => {
      if (!root.contains(event.target as Node)) close();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && trigger.getAttribute("aria-expanded") === "true") close(true);
    });
  });
</script>
