---
/**
 * LabsButton — the one pill CTA of the Labs shell. Two tones: `dark` (ink on
 * cream, the hero/product cards) and `sage` (nav + closing band). Every
 * instance carries the same hover transition; call sites only pick the tone.
 * Renders <a> when `href` is given, <button> otherwise.
 */
import type { LabsCta } from "../../lib/labs-home";

type Tone = "dark" | "sage";

interface Props {
  cta: LabsCta;
  tone?: Tone;
  class?: string;
}

const { cta, tone = "dark", class: className } = Astro.props;

const TONE_CLASSES: Record<Tone, string> = {
  dark: "bg-(--color-cream-900) text-(--color-cream-50) hover:bg-(--color-sage-800)",
  sage: "bg-(--color-sage-400) text-(--color-cream-800) hover:bg-(--color-sage-500)",
};

const classes = [
  "inline-flex h-12 cursor-pointer items-center justify-center rounded-full px-[26px] font-label text-[13px] uppercase tracking-[0.05em] transition-colors duration-200 ease-out",
  TONE_CLASSES[tone],
  className,
]
  .filter(Boolean)
  .join(" ");
---

<a href={cta.href} data-analytics={cta.analytics} class={classes}>{cta.label}</a>
