---
/**
 * LabsButton — the one pill CTA of the Labs shell. Four tones: `dark` (ink on
 * cream, the hero/product cards), `sage` (nav + closing band), `orange` (the
 * same slots on Kitaru pages — orange-600, the one orange the page uses) and
 * `ghost` (hairline outline, the secondary next to a filled pill). Every
 * instance carries the same hover transition; call sites only pick the tone.
 * Renders <a> when `href` is given, <button> otherwise.
 *
 * `target="_blank"` also emits `rel="noopener noreferrer"` — the two always
 * travel together, so a call site can't ship one without the other. The
 * default slot renders after the label inside the `<a>`, for an inline icon
 * (e.g. the external-link arrow on a "View source" pill).
 *
 * Class strings live in `labsButtonStyles.ts` so a Preact island can wear
 * the same pill (an island can't render an `.astro` component).
 */
import type { LabsCta } from "../../lib/labs-home";
import { type LabsButtonTone, labsButtonClasses } from "./labsButtonStyles";

interface Props {
  cta: LabsCta;
  tone?: LabsButtonTone;
  class?: string;
  /** External link: also emits rel="noopener noreferrer". */
  target?: "_blank";
}

const { cta, tone = "dark", class: className, target } = Astro.props;

const classes = labsButtonClasses(tone, className);
---

<a
  href={cta.href}
  data-analytics={cta.analytics}
  class={classes}
  target={target}
  rel={target === "_blank" ? "noopener noreferrer" : undefined}
>{cta.label}<slot /></a>
