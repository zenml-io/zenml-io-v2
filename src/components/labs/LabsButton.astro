---
/**
 * LabsButton — the one pill CTA of the Labs shell. Four tones: `dark` (ink on
 * cream, the hero/product cards), `sage` (nav + closing band), `orange` (the
 * same slots on Kitaru pages — orange-600, the one orange the page uses) and
 * `ghost` (hairline outline, the secondary next to a filled pill). Every
 * instance carries the same hover transition; call sites only pick the tone.
 * Renders <a> when `href` is given, <button> otherwise.
 */
import type { LabsCta } from "../../lib/labs-home";
import {
  BASE_PILL_CLASSES,
  type LabsButtonTone,
  TONE_CLASSES,
} from "./labsButtonStyles";

interface Props {
  cta: LabsCta;
  tone?: LabsButtonTone;
  class?: string;
  external?: boolean;
}

const { cta, tone = "dark", class: className, external = false } = Astro.props;

const classes = [BASE_PILL_CLASSES, TONE_CLASSES[tone], className]
  .filter(Boolean)
  .join(" ");
---

<a href={cta.href} data-analytics={cta.analytics} class={classes} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined}>{cta.label}</a>
