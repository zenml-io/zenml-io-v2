---
/**
 * CustomerStoryCards — Labs "Customer stories" band: an optional headline +
 * "all case studies" link, then either case-study cards (light sage grain
 * panel with customer logos, title, "read the story" label, four-up,
 * `slice(0, 4)`) or quote cards (testimonial + attribution, three-up, no
 * slice) — a card is a quote when `"quote" in card`. Copy and card data
 * arrive through the `content` prop (`PRO_QUOTES` on `/pro`).
 */
import type {
  CaseStudyCard,
  QuoteCard,
  StoryCardsContent,
} from "../../lib/labs-home";
import LabsStoryCard from "./LabsStoryCard.astro";
import "../../styles/labs-scroll-reveal.css";
import LabsTextLink from "./LabsTextLink.astro";

interface Props {
  content: StoryCardsContent;
}
const { content } = Astro.props;

const isQuote = (card: CaseStudyCard | QuoteCard): card is QuoteCard =>
  "quote" in card;

const quoteCards = content.cards.filter(isQuote);
const hasQuoteCards = quoteCards.length > 0;
const storyCards = hasQuoteCards
  ? []
  : (content.cards as readonly CaseStudyCard[]).slice(0, 4);
---

<section class="py-24 md:py-32">
  <div class="scroll-reveal-section mx-auto max-w-content px-gutter">
    {(content.headline || content.allLink) && (
      <div class="reveal-child flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
        {content.headline && (
          <h2 class="font-display text-[32px] leading-[38px] text-(--color-cream-900) text-balance md:text-[48px] md:leading-[54px]">
            {content.headline}
          </h2>
        )}
        {content.allLink && (
          <LabsTextLink cta={content.allLink} />
        )}
      </div>
    )}

    {hasQuoteCards ? (
      <div class="reveal-child stagger-1 mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {quoteCards.map((card) => (
          <div class:list={[card.wide && "lg:col-span-2"]}>
            <LabsStoryCard
              kind="quote"
              quote={card.quote}
              name={card.name}
              title={card.title}
              avatar={card.avatar}
              logo={card.logo}
              wide={card.wide}
            />
          </div>
        ))}
      </div>
    ) : (
      <div class="reveal-child stagger-1 mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
        {storyCards.map((card) => (
          <LabsStoryCard
            href={card.href}
            title={card.title}
            company={card.companyLogoAlt}
            logos={[
              { url: card.companyLogo, alt: card.companyLogoAlt },
              ...(card.secondaryLogo ? [{ url: card.secondaryLogo, alt: card.secondaryLogoAlt }] : []),
            ]}
            readLabel={content.readLabel}
          />
        ))}
      </div>
    )}
  </div>
</section>
