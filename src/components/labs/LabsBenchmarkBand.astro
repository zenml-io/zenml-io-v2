---
/**
 * LabsBenchmarkBand (`labs.benchmark-band`) — a band that points
 * at the published benchmarks: eyebrow, headline, deck and a text link on
 * the left (above on phones), the named reports as `labs.benchmark-card`s
 * on the right, one column below md and two from md. Reports are looked up
 * by slug, so a slug that is not published renders nothing. Copy arrives
 * through `content` (an industry page's `benchmarks`).
 */
import {
  BENCHMARK_PREVIEWS,
  BENCHMARK_REPORTS,
} from "../../lib/benchmarkReports";
import type { BenchmarkBandContent } from "../../lib/labs-industries";
import { LABS_EYEBROW_CLASS } from "../templates/pageHeaderPresets";
import LabsBenchmarkCard from "./LabsBenchmarkCard.astro";

interface Props {
  content: BenchmarkBandContent;
}
const { content } = Astro.props;
const reports = content.slugs
  .map((slug) => BENCHMARK_REPORTS.find((report) => report.slug === slug))
  .filter((report) => report !== undefined);
---

{reports.length > 0 && (
  <section class="scroll-reveal-section py-24 md:py-32" aria-labelledby="benchmark-band-title">
    <div class="mx-auto grid max-w-content grid-cols-1 gap-10 px-gutter lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
      <div class="reveal-child">
        <p class={LABS_EYEBROW_CLASS}>{content.eyebrow}</p>
        <h2 id="benchmark-band-title" class="mt-3 font-display text-[32px] leading-[38px] text-balance text-(--color-cream-900) md:text-[44px] md:leading-[50px]">
          {content.headline}
        </h2>
        <p class="mt-6 font-sans text-[17px] leading-[27px] text-(--color-cream-700)">{content.deck}</p>
        <a
          href={content.link.href}
          data-analytics={content.link.analytics}
          class="mt-6 inline-flex min-h-11 items-center gap-2 font-sans text-[16px] leading-6 text-(--color-sage-800) underline decoration-(--color-sage-400) underline-offset-4 transition-colors duration-200 ease-out hover:text-(--color-sage-900)"
        >
          {content.link.label} <span aria-hidden="true">→</span>
        </a>
      </div>
      <ul class="grid list-none grid-cols-1 gap-4 md:grid-cols-2">
        {reports.map((report, index) => (
          <li class:list={["reveal-child min-w-0", index === 1 && "stagger-1"]}>
            <LabsBenchmarkCard report={report} preview={BENCHMARK_PREVIEWS[report.slug]} />
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
