---
/**
 * LabsIntegrationsGrid — static grid of integration logos on a sage tint
 * band, left-aligned like every other section head. No marquee; the head,
 * grid and pill arrive with the house reveal. Logos come from the
 * `integrations` content collection at build time, read the same way
 * `IntegrationsMarquee.astro` reads them, sorted by title, first 12 shown
 * (6x2 from md, 3x3 below); the rest of the count lives in the CTA row.
 */
import { getCollection } from "astro:content";
import "../../styles/labs-scroll-reveal.css";
import type { IntegrationsContent } from "../../lib/labs-product-zenml";
import LabsButton from "./LabsButton.astro";

interface Props {
  content: IntegrationsContent;
}
const { headline, deck, cta } = Astro.props.content;

type LogoItem = {
  name: string;
  src: string;
  alt: string;
  href: string;
};

const integrations = await getCollection(
  "integrations",
  ({ data }) => !data.draft,
);
const logos: LogoItem[] = integrations
  .flatMap((i) => {
    const logo = i.data.logo;
    if (!logo?.url) {
      return [];
    }

    return [
      {
        name: i.data.title,
        src: logo.url,
        alt: logo.alt || i.data.title,
        href: `/integrations/${i.data.slug}`,
      },
    ];
  })
  .sort((a, b) => a.name.localeCompare(b.name));
/** Two rows of six from md, three rows of three below; "See all
 *  integrations" carries the rest. */
const gridLogos = logos.slice(0, 12);
---

<section class="bg-(--color-sage-100) py-24 md:py-32">
  <div class="scroll-reveal-section mx-auto max-w-content px-gutter">
    <h2 class="reveal-child font-display text-[32px] leading-[38px] text-(--color-cream-900) text-balance md:text-[48px] md:leading-[54px]">
      {headline}
    </h2>
    {
      deck && (
        <p class="reveal-child stagger-1 mt-space-sm max-w-[640px] font-sans text-[17px] leading-[26px] text-(--color-cream-800) md:text-[18px] md:leading-[27px]">
          {deck}
        </p>
      )
    }

    <div class="scroll-reveal-section mt-space-xl grid grid-cols-3 gap-3 md:grid-cols-6 md:gap-4">
      {
        gridLogos.map((logo, index) => (
          <a
            href={logo.href}
            class:list={[index >= 9 && "max-md:hidden", `stagger-${Math.min(index + 1, 4)}`, "reveal-child group flex h-[88px] cursor-pointer items-center justify-center rounded-[16px] border border-border bg-card px-4 transition-colors duration-200 ease-out hover:border-(--color-sage-400)"]}
            aria-label={logo.name}
          >
            {/* aria-label above names the link; the image is decorative on
               purpose so screen readers announce the logo once, not twice. */}
            <img
              src={logo.src}
              alt=""
              aria-hidden="true"
              class="h-9 w-9 object-contain"
              width="36"
              height="36"
              loading="lazy"
            />
          </a>
        ))
      }
    </div>

    <div class="reveal-child stagger-2 mt-space-mlg flex">
      <LabsButton cta={cta} tone="ghost" />
    </div>
  </div>
</section>
