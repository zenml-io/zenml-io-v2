---
/**
 * LabsModelFanout — one recorded call fanned out to several candidate
 * models. The call card sits on the left from `lg` (on top below it) and a
 * sage spine branches to one lane per candidate; each lane ends in an
 * outcome chip that either matches the recording or asks for review. The
 * branch lines are borders on the lanes themselves, so the same markup
 * draws a horizontal fan on desktop and a vertical one on phones — the
 * narrow variant keeps the causal order (call first, then candidates)
 * instead of shrinking a wide drawing.
 *
 * The section's one motion moment: once the shared reveal marks it in
 * view, each branch draws out from the spine and its lane fades in, one
 * candidate after another. The resting state is fully drawn, so no-JS and
 * reduced-motion visitors see the finished diagram.
 */
import type { FanoutContent, FanoutLane } from "../../lib/labs-home";
import "../../styles/labs-scroll-reveal.css";

interface Props {
  content: FanoutContent;
}
const { content } = Astro.props;

const CHIP_CLASSES: Record<FanoutLane["outcomeKind"], string> = {
  match:
    "bg-(--color-sage-200) text-(--color-sage-900) border-(--color-sage-200)",
  review:
    "bg-(--color-cream-50) text-(--color-cream-900) border-(--color-cream-400)",
};
---

<section class="bg-(--color-sage-50) py-16 md:py-[112px]">
  <div class="scroll-reveal-section mx-auto flex max-w-content flex-col gap-12 px-gutter md:gap-16">
    <div class="reveal-child flex max-w-[880px] flex-col gap-5">
      <h2 class="font-display text-[31px] leading-[33px] text-(--color-cream-900) md:text-[56px] md:leading-[60px]">
        {content.headline}
      </h2>
      <p class="font-sans text-[17px] leading-[26px] text-foreground md:text-[18px] md:leading-[28px]">
        {content.deck}
      </p>
    </div>

    <div class="reveal-child stagger-1 grid grid-cols-1 items-center lg:grid-cols-[minmax(0,4fr)_minmax(0,7fr)]">
      <div class="fanout-call relative min-w-0 rounded-[20px] border border-(--color-border) bg-card p-8 md:p-10">
        <p class="font-label text-[13px] leading-5 uppercase tracking-[0.05em] text-(--color-sage-800)">
          {content.call.label}
        </p>
        <p class="mt-4 font-display text-[24px] leading-[30px] text-(--color-cream-900) md:text-[28px] md:leading-[34px]">
          {content.call.input}
        </p>
        <div class="mt-6 border-t border-(--color-border) pt-5">
          <p class="font-sans text-[14px] leading-5 text-(--color-cream-700)">
            {content.call.recordedLabel}
          </p>
          <code class="mt-2 inline-block rounded-[8px] bg-(--color-sage-100) px-3 py-1.5 font-mono text-[14px] leading-5 text-(--color-sage-900)">
            {content.call.recorded}
          </code>
        </div>
      </div>

      <ol class="fanout-lanes relative flex min-w-0 flex-col gap-4">
        {content.lanes.map((lane, i) => (
          <li class="fanout-lane relative" style={`--lane-delay: ${200 + i * 140}ms`}>
            <div class="flex flex-col gap-4 rounded-[16px] border border-(--color-border) bg-card px-6 py-5 transition-colors duration-200 ease-out hover:border-(--color-sage-400) sm:flex-row sm:items-center sm:justify-between">
              <div class="min-w-0">
                <p class="font-display text-[20px] leading-[26px] text-(--color-cream-900)">
                  {lane.model}
                </p>
                <p class="mt-1 font-sans text-[15px] leading-[22px] text-(--color-cream-700)">
                  {lane.detail}
                </p>
              </div>
              <span
                class={`inline-flex w-fit shrink-0 items-center gap-2 whitespace-nowrap rounded-full border px-3 py-1.5 font-label text-[13px] leading-5 uppercase tracking-[0.05em] ${CHIP_CLASSES[lane.outcomeKind]}`}
              >
                {lane.outcomeKind === "match" ? (
                  <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L19 7" /></svg>
                ) : (
                  <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 8v5M12 16.5v.5" /><circle cx="12" cy="12" r="9" /></svg>
                )}
                {lane.outcome}
                {lane.outcomeKind === "review" && <span class="sr-only">, for you to review</span>}
              </span>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <p class="reveal-child stagger-2 max-w-[720px] font-sans text-[14px] leading-[22px] text-(--color-cream-700)">
      {content.caption}
    </p>
  </div>
</section>

<style>
  /* The spine and branches are drawn with pseudo-elements on the lanes, so
     the drawing reflows with the layout instead of being a fixed SVG. */
  .fanout-lanes {
    --fan-gap: 40px;
    margin-top: var(--fan-gap);
    padding-left: var(--fan-gap);
  }
  /* Below lg: the call card is on top, a stem drops from it to the spine. */
  .fanout-lanes::before {
    content: "";
    position: absolute;
    left: 12px;
    top: calc(var(--fan-gap) * -1);
    bottom: 36px;
    border-left: 1px solid var(--color-sage-400);
  }
  .fanout-lane::before {
    content: "";
    position: absolute;
    left: calc(var(--fan-gap) * -1 + 12px);
    width: calc(var(--fan-gap) - 12px);
    top: 50%;
    border-top: 1px solid var(--color-sage-400);
  }
  .fanout-lane::before {
    transform-origin: left center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1) var(--lane-delay);
  }
  .fanout-lane > div {
    transition:
      opacity 0.5s ease-out calc(var(--lane-delay) + 150ms),
      transform 0.5s ease-out calc(var(--lane-delay) + 150ms),
      border-color 0.2s ease-out;
  }
  :global(.reveal-armed:not(.in-view)) .fanout-lane::before {
    transform: scaleX(0);
  }
  :global(.reveal-armed:not(.in-view)) .fanout-lane > div {
    opacity: 0;
    transform: translateX(-8px);
  }
  @media (prefers-reduced-motion: reduce) {
    .fanout-lane::before,
    .fanout-lane > div {
      transition: none;
    }
  }
  @media (min-width: 1024px) {
    .fanout-lanes {
      --fan-gap: 64px;
      margin-top: 0;
      margin-left: var(--fan-gap);
    }
    /* From lg: a vertical spine spans the lanes, fed by a line from the card. */
    .fanout-lanes::before {
      left: 32px;
      top: 36px;
      bottom: 36px;
    }
    .fanout-lane::before {
      left: calc(var(--fan-gap) * -1 + 32px);
      width: calc(var(--fan-gap) - 32px);
    }
    .fanout-call::after {
      content: "";
      position: absolute;
      top: 50%;
      right: calc(-1 * (var(--fan-gap-call, 96px)));
      width: var(--fan-gap-call, 96px);
      border-top: 1px solid var(--color-sage-400);
    }
  }
</style>
