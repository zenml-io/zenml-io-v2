---
/**
 * LabsOpenSourceBand (`labs.open-source-band`) — a product page's
 * open-source section: eyebrow, headline and deck in the left column with
 * the install command and a GitHub pill carrying the live star count (filled
 * by BaseLayout's `[data-github-stars-count]` loader, blank until it lands),
 * then four numbered facts on hairlines in a 1 → 2 grid on the right
 * (stacked below lg), and a row of community links under them. `tint` picks
 * the accent: sage on /product/zenml, orange on /product/kitaru. Static.
 * Copy arrives through `content` (ZENML_OPEN_SOURCE, KITARU_OPEN_SOURCE in
 * src/lib/openSource.ts).
 */
import type { OpenSourceBandContent } from "../../lib/openSource";
import { LABS_EYEBROW_CLASS } from "../templates/pageHeaderPresets";
import LabsInstallChip from "./LabsInstallChip.astro";

interface Props {
  content: OpenSourceBandContent;
  tint: "sage" | "orange";
}
const { content, tint } = Astro.props;

const ACCENT = {
  sage: "text-(--color-sage-700)",
  orange: "text-(--color-orange-600)",
} as const;
---

<section class="scroll-reveal-section py-24 md:py-32" aria-labelledby="open-source-title">
  <div class="mx-auto grid max-w-content grid-cols-1 gap-12 px-gutter lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
    <div class="reveal-child">
      <p class={LABS_EYEBROW_CLASS}>{content.eyebrow}</p>
      <h2 id="open-source-title" class="mt-3 font-display text-[32px] leading-[38px] text-balance text-(--color-cream-900) md:text-[48px] md:leading-[54px]">
        {content.headline}
      </h2>
      <p class="mt-6 font-sans text-[17px] leading-[27px] text-(--color-cream-700)">{content.deck}</p>
      <div class="mt-space-mlg flex flex-wrap items-center gap-space-sm">
        <div class="flex max-w-full"><LabsInstallChip content={content.install} /></div>
        <a
          href={content.github.href}
          target="_blank"
          rel="noopener noreferrer"
          data-analytics={content.github.analytics}
          class="inline-flex h-12 items-center gap-2.5 rounded-full border border-(--color-border) bg-card px-5 font-label text-[13px] uppercase tracking-[0.05em] text-(--color-cream-900) transition-colors duration-200 ease-out hover:border-(--color-sage-400)"
        >
          <svg aria-hidden="true" focusable="false" class="h-4 w-4 shrink-0" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.49c-2.23.49-2.7-.95-2.7-.95-.36-.93-.89-1.18-.89-1.18-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.22 1.87.87 2.33.67.07-.51.28-.87.51-1.07-1.78-.2-3.65-.88-3.65-3.94 0-.87.31-1.58.82-2.14-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.7 7.7 0 0 1 8 3.87c.68 0 1.36.09 2 .27 1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.14 0 3.07-1.87 3.74-3.66 3.94.29.25.54.73.54 1.48v2.2c0 .21.14.46.55.38A8 8 0 0 0 8 0Z" /></svg>
          {content.github.label}
          <span data-github-stars-count data-github-stars-repo={content.github.starsRepo} class:list={["tabular-nums", ACCENT[tint]]}></span>
        </a>
      </div>
    </div>

    <div class="reveal-child stagger-1 min-w-0">
      <ol class="grid list-none grid-cols-1 gap-x-10 md:grid-cols-2">
        {content.facts.map((fact, index) => (
          <li class="border-t border-(--color-cream-900) pt-5 pb-8">
            <span class:list={["font-mono text-[13px] leading-5", ACCENT[tint]]}>{String(index + 1).padStart(2, "0")}</span>
            <h3 class="mt-2 font-display text-[24px] leading-[30px] text-(--color-cream-900)">{fact.title}</h3>
            <p class="mt-2 font-sans text-[16px] leading-[25px] text-(--color-cream-700)">{fact.body}</p>
          </li>
        ))}
      </ol>
      <ul class="mt-2 flex list-none flex-wrap gap-x-6 gap-y-2 border-t border-(--color-border) pt-5">
        {content.links.map((link) => (
          <li>
            <a
              href={link.href}
              {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              class="inline-flex min-h-11 items-center gap-1.5 font-sans text-[15px] leading-6 text-(--color-cream-900) underline decoration-(--color-cream-400) underline-offset-4 transition-colors duration-200 ease-out hover:decoration-(--color-cream-900)"
            >
              {link.label}{link.external && <span aria-hidden="true">↗</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
