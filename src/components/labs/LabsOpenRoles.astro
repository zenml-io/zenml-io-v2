---
interface Position {
  title: string;
  type: string;
  href: string;
  department?: string;
}

interface Props {
  heading?: string;
  positions: readonly Position[];
}

const { heading = "Open positions", positions } = Astro.props;
const groupedPositions = positions.reduce<Map<string, Position[]>>(
  (groups, position) => {
    const key = position.department ?? "";
    const group = groups.get(key) ?? [];
    group.push(position);
    groups.set(key, group);
    return groups;
  },
  new Map(),
);

const positionLabel =
  positions.length === 1 ? "open position" : "open positions";
---

<section id="open-positions" class="py-space-xl md:py-space-xxl">
  <div class="mx-auto max-w-content px-gutter">
    <h2 class="font-display text-[32px] leading-[38px] text-(--color-cream-900) md:text-[40px] md:leading-[46px]">
      {heading}
    </h2>

    {positions.length > 0 ? (
      <>
        <p class="mt-space-sm font-sans text-[16px] leading-[24px] text-(--color-cream-700)">
          {positions.length} {positionLabel} available
        </p>
        <div class="mt-space-lg">
          <div class="space-y-space-lg">
            {[...groupedPositions.entries()].map(([department, departmentPositions]) => (
              <div>
                {department && (
                  <h3 class="mb-space-sm font-sans text-[13px] leading-[18px] text-(--color-cream-700)">
                    {department} <span aria-hidden="true">({departmentPositions.length})</span>
                  </h3>
                )}
                <ul class="divide-y divide-(--color-border) border-y border-(--color-border)">
                  {departmentPositions.map((position) => (
                    <li>
                      <a
                        href={position.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group flex min-h-11 cursor-pointer items-center justify-between gap-space-md py-space-sm text-(--color-cream-900) transition-colors duration-200 ease-out hover:text-(--color-sage-700)"
                      >
                        <span class="min-w-0">
                          <span class="block font-display text-[16px] leading-[24px] font-medium">
                            {position.title}
                          </span>
                          <span class="mt-1 block font-sans text-[14px] leading-[20px] text-(--color-cream-700)">
                            {position.type}
                          </span>
                        </span>
                        <span aria-hidden="true" class="shrink-0 text-[20px] leading-none">
                          &rarr;
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </>
    ) : (
      <p class="mt-space-sm font-sans text-[16px] leading-[24px] text-(--color-cream-700)">
        No open positions right now.
      </p>
    )}
  </div>
</section>
