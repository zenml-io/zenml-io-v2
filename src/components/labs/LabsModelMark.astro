---
/**
 * LabsModelMark — a model's mark at text size: the brand icon where the
 * service-logo set has one, otherwise a neutral glyph (an open-weights
 * circle or a local-hardware chip). Inherits `currentColor`.
 */
import type { HeroVisualModel } from "../../lib/labs-home";
import { AnthropicIcon, OpenAIIcon } from "../kitaru/islands/brand-icons";

interface Props {
  mark: HeroVisualModel["mark"];
}
const { mark } = Astro.props;
const size = "size-3.5 shrink-0";
---

{mark === "openai" && <OpenAIIcon class={size} />}
{mark === "anthropic" && <AnthropicIcon class={size} />}
{mark === "open" && (
  <svg class={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="9" />
    <path d="M8 12h8M12 8v8" />
  </svg>
)}
{mark === "chip" && (
  <svg class={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <rect x="6" y="6" width="12" height="12" rx="2" />
    <path d="M10 2v4M14 2v4M10 18v4M14 18v4" />
  </svg>
)}
