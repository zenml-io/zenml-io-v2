---
/**
 * LabsOnboardingWidget — one labs.onboarding-steps thread: the question, the
 * engineer's answer with when it landed, and a widget with the proof, drawn
 * from the product's own components (the kaizen app in the frontend monorepo):
 *   - report: the gap rows, each with a bar sized to its session count
 *   - results: a titled table of what changed, before and after
 *   - pipeline: the steps of a ZenML pipeline and its result
 * Rendered twice per step by LabsOnboardingSteps (under the step on small
 * screens and with no JS, and as a panel of the scroll window from lg), so
 * the markup lives here once. Both render the finished state (bars full).
 * Inside the active scroll-window panel the
 * widget plays its arrival on the product's motion (and below lg, when the
 * inline copy scrolls into view): blocks settle 70ms apart. Every
 * animation fills backwards only, so nothing is held hidden; reduced motion
 * skips them. Decorative: the step text carries the meaning, so callers
 * mark it aria-hidden.
 */
import type { OnboardingStep } from "../../lib/labs-home";
import { GAP_TAG, GAP_TAG_BASE } from "./gapTags";

interface Props {
  step: OnboardingStep;
}
const { title, ask, reply, when, widget } = Astro.props.step;

const BAR_TONE = {
  wrong: "bg-destructive",
  missing: "bg-(--color-cream-400)",
} as const;
const maxCount =
  widget.kind === "report"
    ? Math.max(
        ...widget.items.map((item) => Number.parseInt(item.count, 10) || 0),
        1,
      )
    : 1;
---

<div class="ow-arrive flex flex-col gap-4 p-4 md:p-5">
<p class="ml-auto max-w-[85%] rounded-[12px] rounded-br-[4px] bg-(--secondary-fill) px-3.5 py-2 font-sans text-[14px] leading-5 text-(--color-cream-900)">{ask}</p>
<div>
  <p class="flex flex-wrap items-baseline gap-x-2 font-sans text-[12px] leading-4">
    <span class="font-semibold text-(--color-cream-900)">{title}</span>
    <span class="text-(--color-cream-600)">{when}</span>
  </p>
  <p class="mt-1 font-sans text-[14px] leading-5 text-(--color-cream-800)">{reply}</p>
</div>
<div class="overflow-hidden rounded-[8px] border border-(--color-border)">
{widget.kind === "report" && (
  <ul class="ow-arrive flex flex-col divide-y divide-(--color-border)">
    {widget.items.map((item, index) => (
      <li class="flex flex-col gap-2.5 px-4 py-3.5" style={`--i: ${index}`}>
        <span class="flex items-center gap-3">
          <span class:list={[GAP_TAG_BASE, GAP_TAG[item.kind]]}>
            {widget.kindLabels[item.kind]}
          </span>
          <span class="min-w-0 flex-1 font-sans text-[15px] leading-[22px] text-(--color-cream-900)">{item.title}</span>
          <span class="font-mono text-[13px] leading-5 text-(--color-cream-900) tabular-nums">{item.count}</span>
        </span>
        <span class="h-1 overflow-hidden rounded-full bg-(--color-cream-100)">
          <span
            class:list={["ow-bar block h-full rounded-full", BAR_TONE[item.kind]]}
            style={`width: ${((Number.parseInt(item.count, 10) || 0) / maxCount) * 100}%; --i: ${index}`}
          ></span>
        </span>
      </li>
    ))}
  </ul>
)}

{widget.kind === "results" && (
  <div class="ow-arrive flex flex-col">
    <p class="border-b border-(--color-border) px-5 py-3.5 font-sans text-[15px] leading-[22px] font-semibold text-(--color-cream-900)">{widget.title}</p>
    <dl class="flex flex-col divide-y divide-(--color-border)">
      {widget.rows.map((row) => (
        <div class="flex items-center justify-between gap-4 px-5 py-3">
          <dt class="min-w-0 font-sans text-[14px] leading-5 text-(--color-cream-800)">{row.label}</dt>
          <dd class="flex shrink-0 items-center gap-2 font-sans text-[14px] leading-5 tabular-nums">
            <span class="text-(--color-cream-600)">{row.before}</span>
            <span aria-hidden="true" class="text-(--color-cream-500)">→</span>
            <span class="font-semibold text-(--color-sage-700)">{row.after}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
)}

{widget.kind === "pipeline" && (
  <div class="ow-arrive flex flex-col">
    <div class="flex items-center justify-between gap-3 border-b border-(--color-border) px-5 py-3.5">
      <p class="min-w-0 truncate font-mono text-[13px] leading-[18px] text-(--color-cream-900)">{widget.name}</p>
      <span class="shrink-0 rounded-full bg-(--muted) px-2.5 py-0.5 font-sans text-[12px] leading-4 font-medium text-(--muted-foreground)">ZenML pipeline</span>
    </div>
    <ol class="flex flex-col gap-2.5 px-5 py-4">
      {widget.steps.map((step) => (
        <li class="flex items-center gap-2.5 font-sans text-[14px] leading-5 text-(--color-cream-800)">
          <span aria-hidden="true" class="size-4 shrink-0 rounded-full border border-dashed border-(--color-cream-400)"></span>
          {step}
        </li>
      ))}
    </ol>
    <div class="flex items-baseline justify-between gap-3 border-t border-(--color-border) px-5 py-3.5">
      <span class="font-sans text-[13px] leading-[18px] text-(--color-cream-700)">{widget.resultLabel}</span>
      <span class="font-sans text-[18px] leading-6 font-semibold text-(--color-sage-700) tabular-nums">{widget.result}</span>
    </div>
  </div>
)}
</div>
</div>

<style>
  /* The product's motion (kaizen kz-motion.css): settle 420ms on
     cubic-bezier(0.22, 1, 0.36, 1), blocks 70ms apart. Played only inside the
     scroll window's active panel, and replayed each time it becomes active. */
  @media (prefers-reduced-motion: no-preference) {
    :global(:is(.onboarding-panel.is-active, .onboarding-inline.in-view)) .ow-arrive > * {
      animation: ow-settle 420ms var(--ease-out-quint) backwards;
    }
    :global(:is(.onboarding-panel.is-active, .onboarding-inline.in-view)) .ow-arrive > :nth-child(2) { animation-delay: 70ms; }
    :global(:is(.onboarding-panel.is-active, .onboarding-inline.in-view)) .ow-arrive > :nth-child(3) { animation-delay: 140ms; }
    :global(:is(.onboarding-panel.is-active, .onboarding-inline.in-view)) .ow-arrive > :nth-child(n + 4) { animation-delay: 210ms; }


    :global(:is(.onboarding-panel.is-active, .onboarding-inline.in-view)) .ow-bar {
      transform-origin: left;
      animation: ow-grow var(--duration-slow) var(--ease-out-quint) calc(240ms + var(--i, 0) * 110ms) backwards;
    }

  }

  /* Below lg the inline widget waits for the house reveal (labs-scroll-reveal)
     to mark it in view. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.onboarding-inline.reveal-armed:not(.in-view)) .ow-arrive > * {
      opacity: 0;
    }
  }

  @keyframes ow-settle {
    from { opacity: 0; filter: blur(4px); transform: translateY(6px); }
  }
  @keyframes ow-grow {
    from { transform: scaleX(0); }
  }
</style>
