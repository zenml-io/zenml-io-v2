---
/**
 * CodePane — single syntax-highlighted code pane.
 *
 * Use inside a FeatureWithGraphic `graphic` slot when a feature row should
 * pair prose with a code block instead of a custom graphic.
 *
 * Kitaru compare pages use the Kitaru code styling — the `kitaru-light` /
 * `kitaru-dark` Shiki themes on a warm cream panel, matching the kitaru.ai
 * site. ZenML-side pages keep the `zenml-light` theme via the site-wide
 * markdown Shiki config in `astro.config.ts` — the two are intentionally
 * kept separate so each product's code blocks stay on-brand.
 */
import { Code } from 'astro:components';
import { kitaruLight, kitaruDark } from '../../../styles/kitaru-themes';

type CodeLang = Parameters<typeof Code>[0]["lang"];

interface Props {
  code: string;
  lang?: CodeLang;
}

const { code, lang = 'python' } = Astro.props;
---

<article class="codepane">
  <Code
    code={code}
    lang={lang}
    themes={{ light: kitaruLight, dark: kitaruDark }}
    defaultColor="light"
  />
</article>

<style>
  /* Warm cream panel matching the Kitaru site's code surface — the
   * kitaru-light theme's editor.background (#FAF6EF) is the same value. */
  .codepane {
    width: 100%;
    border: 1px solid oklch(0.85 0.08 60);
    border-radius: 12px;
    background: #FAF6EF;
    overflow: hidden;
  }
  .codepane :global(pre) {
    margin: 0;
    padding: 20px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
    background: transparent !important;
    border: 0 !important;
    border-radius: 0 !important;
    overflow-x: auto;
  }
  .codepane :global(code) {
    font-family: inherit;
  }
</style>
