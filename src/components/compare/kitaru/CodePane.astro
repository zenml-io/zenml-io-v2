---
/**
 * CodePane — single syntax-highlighted code pane.
 *
 * Use inside a FeatureWithGraphic `graphic` slot when a feature row should
 * pair prose with a code block instead of a custom graphic.
 */
import { Code } from 'astro:components';

type CodeLang = Parameters<typeof Code>[0]["lang"];

interface Props {
  code: string;
  lang?: CodeLang;
}

const { code, lang = 'python' } = Astro.props;
---

<article class="codepane">
  <Code code={code} lang={lang} theme="github-light" />
</article>

<style>
  /* Light panel matching the rest of the article column. Uses the site's
   * standard Shiki theme (zenml-light) so code reads consistently with
   * blog/docs/blog post code blocks. The Kitaru-themed kitaru-light has
   * very dark token colors (#1A1310 fg, #9A3F10 keywords) that read too
   * dense on the cream panel — zenml-light has proper contrast. */
  .codepane {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-surface);
    overflow: hidden;
  }
  .codepane :global(pre) {
    margin: 0;
    padding: 20px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
    background: transparent !important;
    border: 0 !important;
    border-radius: 0 !important;
    overflow-x: auto;
  }
  .codepane :global(code) {
    font-family: inherit;
  }
</style>
