---
import LabsComparisonTable, {
  type ComparisonStatus,
} from "../../labs/LabsComparisonTable.astro";

interface Props {
  rows: {
    feature: string;
    kitaru: ComparisonStatus;
    competitor: ComparisonStatus;
    note?: string;
  }[];
  competitorLabel?: string;
}
const { rows, competitorLabel = "Alternative" } = Astro.props;
---

<LabsComparisonTable
  mode="structured"
  primaryLabel="Kitaru"
  competitorLabel={competitorLabel}
  rows={rows.map((row) => ({
    feature: row.feature,
    primary: row.kitaru,
    competitor: row.competitor,
    note: row.note,
  }))}
/>
