---
import LabsComparisonShowdown from "../../labs/LabsComparisonShowdown.astro";

interface Side {
  title: string;
  items: string[];
}
interface Props {
  kitaru: Side;
  competitor: Side;
  competitorLabel?: string;
}
const { kitaru, competitor, competitorLabel = "Alternative" } = Astro.props;
---

<LabsComparisonShowdown
  primaryLabel="Kitaru"
  competitorLabel={competitorLabel}
  primary={kitaru}
  competitor={competitor}
/>
