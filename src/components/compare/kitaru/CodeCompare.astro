---
import type { LabsCompareLang } from "../../../lib/labsComparison";
import LabsCodeCompare from "../../labs/LabsCodeCompare.astro";

interface Props {
  title?: string;
  eyebrow?: string;
  kitaruLabel?: string;
  competitorLabel?: string;
  kitaruCode: string;
  competitorCode: string;
  lang?: LabsCompareLang;
  competitorLang?: LabsCompareLang;
}
const {
  title,
  eyebrow,
  kitaruLabel = "Kitaru",
  competitorLabel = "Alternative",
  kitaruCode,
  competitorCode,
  lang = "python",
  competitorLang = lang,
} = Astro.props;
---

<LabsCodeCompare
  title={title}
  eyebrow={eyebrow}
  primaryLabel={kitaruLabel}
  competitorLabel={competitorLabel}
  primaryCode={kitaruCode}
  competitorCode={competitorCode}
  primaryLang={lang}
  competitorLang={competitorLang}
/>
