---
---

<figure class="fig">
  <div class="panel panel--competitor">
    <div class="panel-label">OpenAI Agents SDK alone</div>
    <div class="panel-sub">A trace of the run, read only</div>
    <div class="rail">
      <div class="step">
        <span class="step-num">1</span>
        <span class="step-mono">model.request</span>
        <span class="step-cost">gpt-5-nano</span>
      </div>
      <div class="step">
        <span class="step-num">2</span>
        <span class="step-mono">tool.check_order</span>
        <span class="step-cost">live call</span>
      </div>
      <div class="step step--fail">
        <span class="step-num">3</span>
        <span class="step-mono">handoff</span>
        <span class="step-cost">trace ends here</span>
      </div>
      <div class="redo">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 12 A9 9 0 1 1 12 21" />
          <path d="M3 6 L3 12 L9 12" />
        </svg>
        <span class="redo-label">read the trace again: that's the only rerun you get</span>
      </div>
      <div class="repay">a trace can't answer &ldquo;what if&rdquo; about the run</div>
    </div>
  </div>

  <div class="panel panel--kitaru">
    <div class="panel-label">Kitaru-wrapped</div>
    <div class="panel-sub">Recorded once, replayed for the experiment</div>
    <div class="rail">
      <div class="step step--cached">
        <span class="step-num">1</span>
        <span class="step-mono">tool.check_order</span>
        <span class="badge-cached">answered from recording</span>
      </div>
      <div class="step step--cached">
        <span class="step-num">2</span>
        <span class="step-mono">tool.refund_payment</span>
        <span class="badge-cached">answered from recording</span>
      </div>
      <div class="step step--retry">
        <span class="step-num">3</span>
        <span class="step-mono">model.request</span>
        <span class="badge-retry">live · gpt-5-mini</span>
      </div>
      <div class="cmd">
        <span class="cmd-prompt">&gt;&gt;&gt;</span>
        <span class="cmd-text">kitaru experiment run start cheaper-model --agent reviewer@2 --wait</span>
      </div>
      <div class="repay repay--ok">named tools answered from the recording; only the model changes</div>
    </div>
  </div>
</figure>

<style>
  .fig {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin: 0;
    padding: 0;
  }
  .panel {
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 16px 16px 18px;
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
  }
  .panel--competitor { background: var(--color-surface-warm); }
  .panel--kitaru { border-color: var(--color-accent); }

  .panel-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .panel--kitaru .panel-label { color: var(--color-accent); }
  .panel-sub {
    font-size: 12px;
    color: var(--color-secondary);
    margin-bottom: 14px;
  }

  .rail {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .step {
    display: grid;
    grid-template-columns: 22px 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border: 1px solid var(--color-border-light);
    border-radius: 6px;
    background: var(--color-surface);
  }
  .step--fail {
    border-color: var(--color-cost-up);
    background: var(--color-cost-up-bg);
  }
  .step--cached {
    border-color: var(--color-border);
    background: var(--color-bg);
    opacity: 0.78;
  }
  .step--retry {
    border-color: var(--color-accent);
    background: var(--color-accent-light);
  }
  .step-num {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    color: var(--color-muted);
    text-align: center;
    padding: 2px 0;
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    border-radius: 3px;
  }
  .step-mono {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--color-primary);
    font-weight: 600;
  }
  .step-cost {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--color-muted);
  }
  .step--fail .step-cost {
    color: var(--color-cost-up);
    font-weight: 700;
  }
  .badge-cached {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    padding: 2px 6px;
    background: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: 3px;
  }
  .badge-retry {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-accent-deep);
    padding: 2px 6px;
    background: var(--color-surface);
    border: 1px solid var(--color-accent);
    border-radius: 3px;
  }

  .redo {
    margin-top: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border: 1px dashed var(--color-cost-up);
    border-radius: 6px;
    background: var(--color-surface);
  }
  .redo svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: var(--color-cost-up);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
  }
  .redo-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--color-cost-up);
  }

  .cmd {
    margin-top: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg);
  }
  .cmd-prompt {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-accent);
    font-weight: 700;
  }
  .cmd-text {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--color-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .repay {
    margin-top: 10px;
    font-size: 11px;
    font-style: italic;
    color: var(--color-cost-up);
    font-weight: 600;
  }
  .repay--ok {
    color: var(--color-accent-deep);
  }

  @media (max-width: 520px) {
    .fig { grid-template-columns: 1fr; }
  }
</style>
