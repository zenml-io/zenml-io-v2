---
import type { LabsProductBandContent } from "../../../lib/labs-home";
import { ZENML_LINKS } from "../../../lib/productZenml";
import LabsCloseCta from "../../labs/LabsCloseCta.astro";

interface Props {
  headline: string;
  eyebrow?: string;
  primaryCtaText?: string;
  primaryCtaHref?: string;
}
const {
  headline,
  primaryCtaText = ZENML_LINKS.signup.label,
  primaryCtaHref = ZENML_LINKS.signup.href,
} = Astro.props;
const words = headline.split(" ");
const midpoint = Math.ceil(words.length / 2);
const content: LabsProductBandContent = {
  headlineLines: [
    words.slice(0, midpoint).join(" "),
    words.slice(midpoint).join(" "),
  ],
  deck: "",
  cta: {
    label: primaryCtaText,
    href: primaryCtaHref,
    analytics: "ZenML-Compare-CTA-Signup",
  },
};
---

<div class="scroll-reveal-section">
  <div class="reveal-child">
    <LabsCloseCta content={content} preset="comparison">
      <Fragment slot="deck"><slot /></Fragment>
    </LabsCloseCta>
  </div>
</div>
