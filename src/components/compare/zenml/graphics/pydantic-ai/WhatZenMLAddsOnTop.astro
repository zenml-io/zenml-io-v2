---
---

<figure class="fig">
  <div class="layer layer--zenml">
    <div class="layer-head">
      <span class="layer-label">ZenML · orchestration</span>
      <span class="layer-sub">Adds on top, no agent rewrite</span>
    </div>
    <div class="caps">
      <div class="cap">
        <span class="mono ckey">@pipeline</span>
        <span class="cval">wraps the agent in a run you can inspect</span>
      </div>
      <div class="cap">
        <span class="mono ckey">enable_cache</span>
        <span class="cval">unchanged steps served from cache, keyed on step, params, inputs</span>
      </div>
      <div class="cap">
        <span class="mono ckey">zenml pipeline deploy</span>
        <span class="cval">serve it; every request is a run with lineage</span>
      </div>
      <div class="cap">
        <span class="mono ckey">wait()</span>
        <span class="cval">pause for a human, resume the run later</span>
      </div>
      <div class="cap">
        <span class="mono ckey">zenml stack set</span>
        <span class="cval">same code on K8s, Vertex, SageMaker, AzureML</span>
      </div>
      <div class="cap">
        <span class="mono ckey">sandbox</span>
        <span class="cval">isolated exec() for the agent's tools</span>
      </div>
    </div>
  </div>

  <div class="connector" aria-hidden="true">
    <div class="connector-pill">
      <span class="connector-arrow">&darr;</span>
      <span class="connector-label">wraps</span>
    </div>
  </div>

  <div class="layer layer--competitor">
    <div class="layer-head">
      <span class="layer-label layer-label--muted">Pydantic AI · harness</span>
      <span class="layer-sub">Your existing agent, unchanged</span>
    </div>
    <div class="adapter">
      <span class="mono adapter-key">agent.run_sync(...) inside a @step</span>
      <span class="adapter-sub">no adapter, no rewrite &middot; the validated output becomes a versioned artifact</span>
    </div>
  </div>
</figure>

<style>
  .fig {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
  }

  .layer {
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 16px 16px 14px;
    background: var(--color-card);
  }
  .layer--zenml {
    border-color: var(--color-sage-500);
    background: var(--color-sage-50);
  }
  .layer--competitor {
    background: var(--color-cream-50);
  }

  .layer-head {
    margin-bottom: 12px;
  }
  .layer-label {
    display: block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-sage-800);
    margin-bottom: 4px;
  }
  .layer-label--muted { color: var(--color-cream-700); }
  .layer-sub {
    display: block;
    font-size: 12px;
    color: var(--color-cream-700);
  }

  .caps {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .cap {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 9px 11px;
    border: 1px solid var(--color-sage-500);
    border-radius: 8px;
    background: var(--color-sage-200);
  }
  .ckey {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 700;
    color: var(--color-sage-800);
  }
  .cval {
    font-size: 10.5px;
    line-height: 1.4;
    color: var(--color-cream-700);
  }

  .connector {
    display: flex;
    justify-content: center;
  }
  .connector-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 12px;
    border: 1px solid var(--color-sage-500);
    border-radius: 999px;
    background: var(--color-sage-200);
  }
  .connector-arrow {
    font-size: 13px;
    line-height: 1;
    color: var(--color-sage-800);
    font-weight: 700;
  }
  .connector-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-sage-800);
  }

  .adapter {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 10px 12px;
    border: 1px dashed var(--color-border);
    border-radius: 8px;
    background: var(--color-card);
  }
  .adapter-key {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    color: var(--color-cream-900);
  }
  .adapter-sub {
    font-size: 11px;
    color: var(--color-cream-700);
  }

  @media (max-width: 560px) {
    .caps { grid-template-columns: 1fr; }
  }
</style>
