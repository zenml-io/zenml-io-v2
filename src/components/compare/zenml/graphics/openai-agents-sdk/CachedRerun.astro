---
---

<figure class="fig">
  <div class="panel panel--competitor">
    <div class="panel-label">OpenAI Agents SDK alone</div>
    <div class="panel-sub">Crash mid-run, restart from step 1</div>
    <div class="rail">
      <div class="step">
        <span class="step-num">1</span>
        <span class="step-mono">research</span>
        <span class="step-cost">$0.04</span>
      </div>
      <div class="step">
        <span class="step-num">2</span>
        <span class="step-mono">draft</span>
        <span class="step-cost">$0.09</span>
      </div>
      <div class="step step--fail">
        <span class="step-num">3</span>
        <span class="step-mono">review</span>
        <span class="step-cost">crash</span>
      </div>
      <div class="redo">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 12 A9 9 0 1 1 12 21" />
          <path d="M3 6 L3 12 L9 12" />
        </svg>
        <span class="redo-label">restart from step 1</span>
      </div>
      <div class="repay">re-pays $0.13 in tokens already spent</div>
    </div>
  </div>

  <div class="panel panel--zenml">
    <div class="panel-label">ZenML-wrapped</div>
    <div class="panel-sub">Retry: completed steps are reused</div>
    <div class="rail">
      <div class="step step--cached">
        <span class="step-num">1</span>
        <span class="step-mono">@step research</span>
        <span class="badge-cached">reused</span>
      </div>
      <div class="step step--cached">
        <span class="step-num">2</span>
        <span class="step-mono">@step draft</span>
        <span class="badge-cached">reused</span>
      </div>
      <div class="step step--retry">
        <span class="step-num">3</span>
        <span class="step-mono">@step review</span>
        <span class="badge-retry">re-run</span>
      </div>
      <div class="cmd">
        <span class="cmd-prompt">$</span>
        <span class="cmd-text">zenml pipeline runs retry &lt;run&gt;</span>
      </div>
      <div class="repay repay--ok">only the failing step re-bills</div>
    </div>
  </div>
</figure>

<style>
  .fig {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin: 0;
    padding: 0;
  }
  .panel {
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 16px 16px 18px;
    background: var(--color-card);
    display: flex;
    flex-direction: column;
  }
  .panel--competitor { background: var(--color-cream-50); }
  .panel--zenml { border-color: var(--color-sage-500); background: var(--color-sage-50); }

  .panel-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-cream-700);
  }
  .panel--zenml .panel-label { color: var(--color-sage-800); }
  .panel-sub {
    font-size: 12px;
    color: var(--color-cream-700);
    margin-bottom: 14px;
  }

  .rail {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .step {
    display: grid;
    grid-template-columns: 22px 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-card);
  }
  .step--fail {
    border-color: var(--color-cream-700);
    background: var(--color-cream-100);
  }
  .step--cached {
    border-color: var(--color-border);
    background: var(--color-cream-50);
    opacity: 0.78;
  }
  .step--retry {
    border-color: var(--color-sage-500);
    background: var(--color-sage-200);
  }
  .step-num {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    color: var(--color-cream-700);
    text-align: center;
    padding: 2px 0;
    background: var(--color-cream-50);
    border: 1px solid var(--color-border);
    border-radius: 3px;
  }
  .step-mono {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--color-cream-900);
    font-weight: 600;
  }
  .step-cost {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--color-cream-700);
  }
  .step--fail .step-cost {
    color: var(--color-cream-700);
    font-weight: 700;
  }
  .badge-cached {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    text-transform: none;
    letter-spacing: 0;
    color: var(--color-cream-700);
    padding: 2px 6px;
    background: var(--color-card);
    border: 1px dashed var(--color-border);
    border-radius: 3px;
  }
  .badge-retry {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    text-transform: none;
    letter-spacing: 0;
    color: var(--color-sage-800);
    padding: 2px 6px;
    background: var(--color-card);
    border: 1px solid var(--color-sage-500);
    border-radius: 3px;
  }

  .redo {
    margin-top: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border: 1px dashed var(--color-cream-700);
    border-radius: 6px;
    background: var(--color-card);
  }
  .redo svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: var(--color-cream-700);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
  }
  .redo-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--color-cream-700);
  }

  .cmd {
    margin-top: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-cream-50);
  }
  .cmd-prompt {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-sage-800);
    font-weight: 700;
  }
  .cmd-text {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--color-cream-900);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .repay {
    margin-top: 10px;
    font-size: 11px;
    font-style: italic;
    color: var(--color-cream-700);
    font-weight: 600;
  }
  .repay--ok {
    color: var(--color-sage-800);
  }

  @media (max-width: 520px) {
    .fig { grid-template-columns: 1fr; }
  }
</style>
