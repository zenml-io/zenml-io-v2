---
import LabsComparisonShowdown from "../../labs/LabsComparisonShowdown.astro";

interface Side {
  title: string;
  items: string[];
}
interface Props {
  zenml: Side;
  competitor: Side;
  competitorLabel?: string;
}
const { zenml, competitor, competitorLabel = "Alternative" } = Astro.props;
---

<LabsComparisonShowdown
  primaryLabel="ZenML"
  competitorLabel={competitorLabel}
  primary={zenml}
  competitor={competitor}
/>
