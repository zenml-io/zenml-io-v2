---
import type { LabsCompareLang } from "../../../lib/labsComparison";
import LabsCodeCompare from "../../labs/LabsCodeCompare.astro";

interface Props {
  title?: string;
  eyebrow?: string;
  zenmlLabel?: string;
  competitorLabel?: string;
  zenmlCode: string;
  competitorCode: string;
  lang?: LabsCompareLang;
}
const {
  title,
  eyebrow,
  zenmlLabel = "ZenML",
  competitorLabel = "Alternative",
  zenmlCode,
  competitorCode,
  lang = "python",
} = Astro.props;
---

<LabsCodeCompare
  title={title}
  eyebrow={eyebrow}
  primaryLabel={zenmlLabel}
  competitorLabel={competitorLabel}
  primaryCode={zenmlCode}
  competitorCode={competitorCode}
  primaryLang={lang}
  competitorLang={lang}
/>
