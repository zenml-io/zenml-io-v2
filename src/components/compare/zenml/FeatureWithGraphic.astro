---
import LabsComparisonValue from "../../labs/LabsComparisonValue.astro";

interface Props {
  title: string;
  image?: string;
  imageAlt?: string;
  reverse?: boolean;
  headingLevel?: 2 | 3;
  number?: string;
  bgStrip?: boolean;
  layout?: "default" | "list";
}
const {
  title,
  image,
  imageAlt,
  reverse = false,
  number,
  layout = "default",
} = Astro.props;
const hasGraphic = Astro.slots.has("graphic");
const hasBullets = Astro.slots.has("bullets");
---

<LabsComparisonValue
  title={title}
  product="zenml"
  image={image ? { url: image, alt: imageAlt } : undefined}
  mediaSide={reverse ? "left" : "right"}
  number={number}
  layout={layout === "list" || hasBullets ? "list" : "split"}
>
  <slot />
  {hasGraphic && <Fragment slot="media"><slot name="graphic" /></Fragment>}
  {hasBullets && <Fragment slot="bullets"><slot name="bullets" /></Fragment>}
</LabsComparisonValue>
