---
/**
 * ZenML MDX comparison layout. The MDX vocabulary is now a set of thin
 * wrappers over the same Labs primitives used by the blocks family.
 */
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { BAND_CONTENT_GAP, blogLaneStyle } from "../../../lib/blogLayout";
import {
  type CompareSwitcherGroup,
  comparisonDisplayHeading,
} from "../../../lib/labsComparison";
import { compareOgUrl } from "../../../lib/seo";
import LabsComparisonBand from "../../labs/LabsComparisonBand.astro";
import { comparisonProse } from "../ComparisonProse";
import "../../../styles/comparison-prose.css";

interface Props {
  entry: CollectionEntry<"compare-zenml">;
  switcherGroups: readonly CompareSwitcherGroup[];
}
const { entry, switcherGroups } = Astro.props;
const { Content } = await render(entry);
const ogImage = entry.data.ogImage ?? compareOgUrl("zenml", entry.id);
const breadcrumb = [
  { label: "Compare", href: "/compare" },
  { label: entry.data.title },
] as const;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={ogImage}
  surface="ml"
  app="labs"
  product="zenml"
>
  <LabsComparisonBand
    breadcrumb={breadcrumb}
    eyebrow="Compare"
    headline={comparisonDisplayHeading(entry.data.title, "ZenML", entry.data.competitor)}
    deck={entry.data.description}
    product="zenml"
    competitor={entry.data.competitor}
    competitorMark={entry.data.competitorLogo ? { url: entry.data.competitorLogo, alt: entry.data.competitor } : undefined}
    switcherGroups={switcherGroups}
  />

  <main class={BAND_CONTENT_GAP} style={blogLaneStyle()}>
    <article class="compare-body-inner">
      <Content components={comparisonProse} />
    </article>
  </main>

  <script>
    import { initCodeCopy } from "../../../scripts/code-copy";
    import { initScrollReveal } from "../../../scripts/labs-scroll-reveal";
    initCodeCopy();
    initScrollReveal();
  </script>
</BaseLayout>
