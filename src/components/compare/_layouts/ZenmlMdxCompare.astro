---
/**
 * ZenmlMdxCompare — ZenML-vs-X comparison detail template (MDX-driven).
 *
 * The ZenML-themed twin of KitaruCompare.astro. Same rich section vocabulary
 * (ComparisonTable, CodeCompare, FeatureWithGraphic, WhenToUseEach, PullQuote,
 * ComparisonCta), rendered in ZenML's palette by wrapping the body in
 * <div data-app="zenml-compare">.
 *
 * This is deliberately NOT MlopsCompare.astro. That template is driven by
 * structured frontmatter on the legacy Webflow-migrated `compare` collection
 * (25 pages, 9 fixed sections, no code panes or graphics). This one renders an
 * MDX body, which is what the agent-era comparisons need.
 *
 * Loaded by src/pages/compare/[slug].astro for any slug in the compare-zenml
 * collection.
 */
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { compareOgUrl } from "../../../lib/seo";
// Structure first, then the ZenML token layer that re-points it.
import "../../../styles/kitaru-compat.css";
import "../../../styles/zenml-compare-compat.css";
import ComparisonHero from "../zenml/ComparisonHero.astro";

interface Props {
  entry: CollectionEntry<"compare-zenml">;
  competitorOptions: Array<{
    slug: string;
    competitor: string;
    competitorLogo?: string;
  }>;
}
const { entry, competitorOptions } = Astro.props;
const { Content } = await render(entry);
// Auto-generated OG card at a deterministic R2 key (scripts/og/generate-compare-og.ts,
// ZenML brand variant). `ogImage:` still wins if a page wants a custom card.
const ogImage = entry.data.ogImage ?? compareOgUrl("zenml", entry.id);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={ogImage}
  surface="ml"
>
  <div data-app="zenml-compare" class="bg-background text-foreground">
    <main id="zenml-compare-main" class="compare-page">
      <ComparisonHero
        title={entry.data.title}
        shortTitle={entry.data.shortTitle}
        description={entry.data.description}
        competitor={entry.data.competitor}
        competitorLogo={entry.data.competitorLogo}
        competitorTagline={entry.data.competitorTagline}
        competitorOptions={competitorOptions}
        currentSlug={entry.id}
      />

      <div class="compare-body">
        <article class="compare-body-inner">
          <Content />
        </article>
      </div>
    </main>
  </div>
</BaseLayout>

{/* IntersectionObserver-driven [data-reveal] fade-in. The ported components
    ship at opacity:0 and wait for this; without it the article body renders
    blank. Shared with the Kitaru compare pages — brand-neutral. */}
<script>
  import "../../../scripts/kitaru/scroll-reveal";
</script>

<style>
  /* Mirrors KitaruCompare's layout + article typography. Astro scopes this
   * <style> to the component, so no [data-app] prefix is used: adding one
   * would raise specificity above the compare components' own styles and
   * inflate their typography. Only the two rules noted below diverge. */
  .compare-page {
    padding-top: 0;
    /* White ground rather than Kitaru's warm paper. */
    background: #ffffff;
  }
  .compare-body {
    padding: 40px 24px 60px;
    max-width: 1192px;
    margin: 0 auto;
  }
  @media (min-width: 820px) {
    .compare-body {
      padding: 48px 32px 80px;
    }
    .compare-body-inner :global(p),
    .compare-body-inner :global(ul),
    .compare-body-inner :global(h1),
    .compare-body-inner :global(h2),
    .compare-body-inner :global(h3) {
      max-width: 820px;
      margin-left: auto;
      margin-right: auto;
    }
  }
  /* Article typography (matches kitaru/site original) */
  .compare-body-inner :global(h2) {
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin: 56px 0 16px;
    color: var(--color-primary);
  }
  .compare-body-inner :global(h3) {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.005em;
    line-height: 1.3;
    margin: 36px 0 12px;
    color: var(--color-primary);
  }
  .compare-body-inner :global(p) {
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-secondary);
    margin: 0 0 18px;
  }
  /* Lead paragraph treatment — the intro reads as a preamble via a darker
     color and a centered max-width column.

     Scoped by position, not by count: a top-level <p> is intro copy unless it
     follows a heading or a component, in which case it is body copy and falls
     through to the base rule above. The Kitaru original hardcodes
     `:nth-of-type(-n+2)`, which drops a third intro paragraph into body
     styling — grey and left-aligned, because the base `margin: 0 0 18px`
     shorthand zeroes the auto side margins. `:where()` adds no specificity,
     so this stays at (0,1,1) like the base rule and wins on source order. */
  .compare-body-inner
    :global(> p:not(:where(h2, h3, ul, table, div, figure, section) ~ p)) {
    color: var(--color-primary);
    margin-bottom: 24px;
    max-width: 820px;
    margin-inline: auto;
  }
  .compare-body-inner :global(ul) {
    padding-left: 22px;
    margin: 0 0 18px;
  }
  .compare-body-inner :global(li) {
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-secondary);
    margin-bottom: 8px;
  }
  .compare-body-inner :global(code) {
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--color-primary);
  }
  .compare-body-inner :global(pre) {
    padding: 20px 22px;
    border-radius: 10px;
    margin: 22px 0 26px;
    font-size: 14px;
    line-height: 1.7;
  }
  .compare-body-inner :global(pre code) {
    background: transparent;
  }
  .compare-body-inner :global(a:not([class*="btn-"])) {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  /* Markdown pipe-tables */
  .compare-body-inner :global(table:not(.ctable)) {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    margin: 24px 0 40px;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
    background: var(--color-surface);
    font-size: 15px;
    line-height: 1.55;
  }
  .compare-body-inner :global(table:not(.ctable) thead) {
    background: var(--color-surface-warm);
  }
  .compare-body-inner :global(table:not(.ctable) th),
  .compare-body-inner :global(table:not(.ctable) td) {
    padding: 14px 18px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-secondary);
  }
  .compare-body-inner :global(table:not(.ctable) th) {
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-primary);
  }
  .compare-body-inner :global(table:not(.ctable) tbody tr:last-child td) {
    border-bottom: none;
  }
  .compare-body-inner :global(table:not(.ctable) td:first-child) {
    font-weight: 600;
    color: var(--color-primary);
  }
</style>
