---
/**
 * Blocks-driven comparison template for the 25 `/compare` entries and three
 * `/vs` category entries. Both families share the Labs shell and section
 * primitives while retaining their distinct content schemas.
 */
import type { CollectionEntry } from "astro:content";
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getBlogProduct, getMainFeedPosts } from "../../../lib/blog";
import { BAND_CONTENT_GAP } from "../../../lib/blogLayout";
import {
  type CompareCard,
  getZenmlCompareCards,
} from "../../../lib/compareHub";
import type {
  FeaturePanel,
  FeaturePanelTone,
  LabsProductBandContent,
} from "../../../lib/labs-home";
import {
  type CompareSwitcherGroup,
  comparisonDisplayHeading,
  type LabsCompareLang,
} from "../../../lib/labsComparison";
import FeatureSplit from "../../labs/FeatureSplit.astro";
import LabsCloseCta from "../../labs/LabsCloseCta.astro";
import LabsCodeCompare from "../../labs/LabsCodeCompare.astro";
import LabsComparisonBand from "../../labs/LabsComparisonBand.astro";
import LabsComparisonBlogRail from "../../labs/LabsComparisonBlogRail.astro";
import LabsComparisonCard from "../../labs/LabsComparisonCard.astro";
import LabsComparisonQuote from "../../labs/LabsComparisonQuote.astro";
import LabsComparisonStrategyCta from "../../labs/LabsComparisonStrategyCta.astro";
import LabsComparisonTable from "../../labs/LabsComparisonTable.astro";
import type { RelatedRailItem } from "../../templates/RelatedRail.astro";

type CompareBlock = CollectionEntry<"compare">["data"]["blocks"][number];
type VsBlock = CollectionEntry<"vs-pages">["data"]["blocks"][number];
type ValueBlock = Extract<CompareBlock, { kind: "value" }>;
type FeatureTableBlock = Extract<CompareBlock, { kind: "featureTable" }>;
type CodeComparisonBlock = Extract<CompareBlock, { kind: "codeComparison" }>;
type Cta02Block = Extract<CompareBlock, { kind: "cta02" }>;

interface ResolvedQuoteBlock {
  kind: "quote";
  text: string;
  author: string;
  position?: string;
  avatar?: { url: string; alt?: string };
  companyLogo?: { url: string; alt?: string };
}
interface ResolvedStrategyCtaBlock {
  kind: "strategyCta";
  headline: string;
  /** Advantages resolved into feature panels; index and tone come from position. */
  panels: FeaturePanel[];
}
interface ResolvedRailBlock {
  kind: "showdown" | "blogRail";
  eyebrow: string;
  headline: string;
  items: RelatedRailItem[];
}
type ResolvedBlock =
  | ValueBlock
  | ResolvedQuoteBlock
  | FeatureTableBlock
  | CodeComparisonBlock
  | ResolvedStrategyCtaBlock
  | ResolvedRailBlock
  | Cta02Block;

type Props =
  | {
      item: CollectionEntry<"compare">;
      switcherGroups: readonly CompareSwitcherGroup[];
      related?: never;
    }
  | {
      item: CollectionEntry<"vs-pages">;
      switcherGroups: readonly CompareSwitcherGroup[];
      related: RelatedRailItem[];
    };
/**
 * Panel tones cycle by position. `canvas` goes last: it matches the page
 * ground, so with three advantages the third panel would have no edge.
 */
const STRATEGY_PANEL_TONES: readonly FeaturePanelTone[] = [
  "sage-tint",
  "sage-deep",
  "sage-light",
  "canvas",
];

const props = Astro.props;
const hubCardsByHref = new Map(
  (await getZenmlCompareCards()).map((card) => [card.href, card]),
);

function relatedComparisonCard(
  item: Extract<RelatedRailItem, { kind: "icon-link" }>,
): CompareCard {
  const card = hubCardsByHref.get(item.href);
  return {
    href: item.href,
    title: item.title,
    name: item.icon?.alt || card?.name || item.title,
    logo: item.icon?.src || card?.logo,
    meta: card?.meta || "",
    blurb: card?.blurb || "",
  };
}

function isCompareProps(
  value: Props,
): value is Extract<Props, { item: CollectionEntry<"compare"> }> {
  return value.item.collection === "compare";
}

async function buildShowdownItems(
  current: CollectionEntry<"compare">,
): Promise<RelatedRailItem[]> {
  const allItems = await getCollection("compare", ({ data }) => !data.draft);
  return allItems
    .filter(
      (item) =>
        item.data.category === current.data.category &&
        item.data.slug !== current.data.slug,
    )
    .map((item) => {
      const toolName =
        item.data.toolName || item.data.title.replace("ZenML vs ", "");
      return {
        kind: "icon-link" as const,
        href: `/compare/${item.data.slug}`,
        title: `ZenML vs ${toolName}`,
        icon: item.data.toolIcon
          ? {
              src: item.data.toolIcon.url,
              alt: item.data.toolIcon.alt || toolName,
            }
          : undefined,
      };
    });
}

async function buildBlogRailItems(): Promise<RelatedRailItem[]> {
  const recentPosts = await getMainFeedPosts();
  return recentPosts.slice(0, 3).map((post) => ({
    kind: "blog-card" as const,
    href: `/blog/${post.data.slug}`,
    title: post.data.title,
    image: post.data.mainImage,
    excerpt: post.data.seo?.description,
    product: getBlogProduct(post),
  }));
}

async function resolveBlock(
  item: CollectionEntry<"compare">,
  block: CompareBlock,
): Promise<ResolvedBlock | null> {
  switch (block.kind) {
    case "value":
    case "featureTable":
    case "codeComparison":
    case "cta02":
      return block;
    case "quote": {
      const entry = await getEntry("quotes", block.quote);
      return entry
        ? {
            kind: "quote",
            text: entry.data.text,
            author: entry.data.author,
            position: entry.data.position,
            avatar: entry.data.avatar,
            companyLogo: entry.data.companyLogo,
          }
        : null;
    }
    case "strategyCta": {
      const entries = await Promise.all(
        block.advantages.map((slug) => getEntry("advantages", slug)),
      );
      const found = entries.filter((entry) => entry !== undefined);
      return {
        kind: "strategyCta",
        headline: block.headline,
        panels: found.map((entry, index) => ({
          index: `${String(index + 1).padStart(2, "0")}.`,
          title: entry.data.title,
          body: entry.data.content,
          icon: entry.data.icon,
          tone: STRATEGY_PANEL_TONES[index % STRATEGY_PANEL_TONES.length],
        })),
      };
    }
    case "showdown":
    case "blogRail": {
      const items =
        block.kind === "showdown"
          ? await buildShowdownItems(item)
          : await buildBlogRailItems();
      return items.length > 0 ? { ...block, items } : null;
    }
    default: {
      const unreachable: never = block;
      throw new Error(
        `Unhandled comparison block: ${JSON.stringify(unreachable)}`,
      );
    }
  }
}

function splitHeadline(headline: string): readonly [string, string] {
  const words = headline.split(" ");
  if (words.length < 2) return [headline, ""];
  const midpoint = Math.ceil(words.length / 2);
  return [words.slice(0, midpoint).join(" "), words.slice(midpoint).join(" ")];
}

function closeContent(
  block: Cta02Block | Extract<VsBlock, { kind: "cta02" }>,
  family: "Compare" | "Vs",
): LabsProductBandContent {
  return {
    headlineLines: splitHeadline(block.headline),
    deck: block.bullets.join(" "),
    cta: {
      ...block.primaryCta,
      analytics: `${family}-Close-${block.primaryCta.label.replaceAll(" ", "-")}`,
    },
  };
}

let seoTitle: string;
let seoDescription: string | undefined;
let ogTitle: string | undefined;
let ogDescription: string | undefined;
let ogImage: string | undefined;
let canonical: string | undefined;
let compareResolvedBlocks: ResolvedBlock[] = [];
if (isCompareProps(props)) {
  compareResolvedBlocks = (
    await Promise.all(
      props.item.data.blocks.map((block) => resolveBlock(props.item, block)),
    )
  ).filter((block): block is ResolvedBlock => block !== null);
  seoTitle = props.item.data.seo?.title || `${props.item.data.title} - ZenML`;
  seoDescription =
    props.item.data.seo?.description ||
    props.item.data.seoDescription ||
    props.item.data.hero.deck;
  ogTitle = props.item.data.seo?.ogTitle;
  ogDescription = props.item.data.seo?.ogDescription;
  ogImage = props.item.data.seo?.ogImage || props.item.data.openGraphImage?.url;
  canonical = props.item.data.seo?.canonical;
} else {
  seoTitle =
    props.item.data.seo?.title || `${props.item.data.hero.headline} - ZenML`;
  seoDescription =
    props.item.data.seo?.description || props.item.data.hero.deck;
  ogTitle = props.item.data.seo?.ogTitle;
  ogDescription = props.item.data.seo?.ogDescription;
  ogImage = props.item.data.seo?.ogImage;
  canonical = props.item.data.seo?.canonical;
}
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  ogImage={ogImage}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  canonical={canonical}
  surface="ml"
  app="labs"
  product="zenml"
>
  {isCompareProps(props) ? (
    (() => {
      const item = props.item;
      const toolName =
        item.data.toolName || item.data.title.replace("ZenML vs ", "");
      return (
        <>
          <LabsComparisonBand
            breadcrumb={[
              { label: "Compare", href: "/compare" },
              { label: item.data.title },
            ]}
            eyebrow={item.data.category || "Comparison"}
            headline={comparisonDisplayHeading(item.data.hero.headline, "ZenML")}
            deck={item.data.hero.deck}
            product="zenml"
            competitor={toolName}
            competitorMark={
              item.data.toolIcon
                ? {
                    url: item.data.toolIcon.url,
                    alt: item.data.toolIcon.alt || toolName,
                  }
                : undefined
            }
            switcherGroups={props.switcherGroups}
          />
          <main class:list={[BAND_CONTENT_GAP, "comparison-blocks-body"]}>
            {compareResolvedBlocks.map((block) => {
                switch (block.kind) {
                  case "value":
                    return (
                      <section class="scroll-reveal-section py-8 md:py-10">
                        <div class="reveal-child mx-auto max-w-content px-gutter">
                          <FeatureSplit
                            title={block.title}
                            bullets={block.bullets}
                            image={block.image}
                            imageSide={block.imageSide || "right"}
                          />
                        </div>
                      </section>
                    );
                  case "quote":
                    return (
                          <LabsComparisonQuote
                            quote={block.text}
                            name={block.author}
                            title={block.position || ""}
                            avatar={block.avatar?.url}
                            logo={
                              block.companyLogo
                                ? {
                                    url: block.companyLogo.url,
                                    alt:
                                      block.companyLogo.alt || block.author,
                                  }
                                : undefined
                            }
                          />
                    );
                  case "featureTable":
                    return (
                      <div id="feature-comparison">
                        <LabsComparisonTable
                          mode="html"
                          title="Explore in Detail What Makes ZenML Unique"
                          primaryLabel="ZenML"
                          competitorLabel={toolName}
                          tableHtml={block.tableHtml}
                        />
                      </div>
                    );
                  case "codeComparison":
                    return (
                      <LabsCodeCompare
                        title={`ZenML and ${toolName} side by side`}
                        eyebrow="Code comparison"
                        primaryLabel="ZenML"
                        competitorLabel={toolName}
                        primaryCode={block.zenmlCode}
                        competitorCode={block.toolCode}
                        primaryLang={block.zenmlLanguage as LabsCompareLang}
                        competitorLang={block.toolLanguage as LabsCompareLang}
                      />
                    );
                  case "strategyCta":
                    return (
                      <LabsComparisonStrategyCta
                        headline={block.headline}
                        panels={block.panels}
                        cta={{
                          label: "Book a demo",
                          href: "/book-your-demo",
                          analytics: "Compare-Strategy-Book-a-demo",
                        }}
                      />
                    );
                  case "showdown":
                    return (
                      <section class="scroll-reveal-section py-8 md:py-10">
                        <div class="mx-auto max-w-content px-gutter">
                          <p class="reveal-child font-sans text-[15px] leading-5 text-(--color-cream-700)">
                            {block.eyebrow}
                          </p>
                          <h2 class="reveal-child stagger-1 mt-3 mb-8 font-display text-[32px] leading-[36px] text-(--color-cream-900) md:text-[44px] md:leading-[48px]">
                            {block.headline}
                          </h2>
                          <ul class="scroll-reveal-section grid list-none grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
                            {block.items.map(
                              (related, index) =>
                                related.kind === "icon-link" && (
                                  <li class:list={["reveal-child min-w-0", index % 3 === 1 && "stagger-1", index % 3 === 2 && "stagger-2"]}>
                                    <LabsComparisonCard card={relatedComparisonCard(related)} />
                                  </li>
                                ),
                            )}
                          </ul>
                        </div>
                      </section>
                    );
                  case "blogRail":
                    return (
                      <LabsComparisonBlogRail
                        heading={block.headline}
                        items={block.items.filter((item) => item.kind === "blog-card")}
                      />
                    );
                  case "cta02":
                    return (
                      <div class="scroll-reveal-section">
                        <div class="reveal-child">
                          <LabsCloseCta
                            preset="comparison"
                            content={closeContent(block, "Compare")}
                          />
                        </div>
                      </div>
                    );
                  default: {
                    const unreachable: never = block;
                    throw new Error(
                      `Unhandled resolved block: ${JSON.stringify(unreachable)}`,
                    );
                  }
                }
            })}
          </main>
        </>
      );
    })()
  ) : (
    (() => {
      const { item, related } = props;
      const category = item.data.hero.compareCategory;
      return (
        <>
          <LabsComparisonBand
            breadcrumb={[
              { label: "Compare", href: "/compare" },
              { label: category },
            ]}
            eyebrow={item.data.hero.eyebrow || "Comparison"}
            headline={comparisonDisplayHeading(item.data.hero.headline, "ZenML")}
            deck={item.data.hero.deck}
            product="zenml"
            competitor={category}
            switcherGroups={props.switcherGroups}
          />
          <main class:list={[BAND_CONTENT_GAP, "comparison-blocks-body"]}>
            {item.data.blocks.map((block) => {
              switch (block.kind) {
                case "intro":
                  return (
                    <section class="scroll-reveal-section py-10">
                      <p class="reveal-child mx-auto max-w-[768px] px-gutter font-sans text-[17px] leading-[26px] text-(--color-cream-700)">
                        {block.body}
                      </p>
                    </section>
                  );
                case "value":
                  return (
                    <section class="scroll-reveal-section py-8 md:py-10">
                      <div class="reveal-child mx-auto max-w-content px-gutter">
                        <FeatureSplit
                          title={block.title}
                          body={block.body}
                          bullets={block.bullets}
                          image={block.image}
                          imageSide={block.imageSide || "right"}
                        />
                      </div>
                    </section>
                  );
                case "testimonial":
                  return (
                        <LabsComparisonQuote
                          quote={block.quote}
                          name={block.name}
                          title={block.title || ""}
                          avatar={block.avatar?.url}
                          logo={
                            block.companyLogo
                              ? {
                                  url: block.companyLogo.url,
                                  alt:
                                    block.companyLogo.alt || block.name,
                                }
                              : undefined
                          }
                        />
                  );
                case "relatedCompare":
                  return (
                    related.length > 0 && (
                      <section class="scroll-reveal-section py-8 md:py-10">
                        <div class="mx-auto max-w-content px-gutter">
                          {block.eyebrow && (
                            <p class="reveal-child font-sans text-[15px] leading-5 text-(--color-cream-700)">
                              {block.eyebrow}
                            </p>
                          )}
                          {block.headline && (
                            <h2 class="reveal-child stagger-1 mt-3 mb-8 font-display text-[32px] leading-[36px] text-(--color-cream-900) md:text-[44px] md:leading-[48px]">
                              {block.headline}
                            </h2>
                          )}
                          <ul class="scroll-reveal-section grid list-none grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
                            {related.map(
                              (entry, index) =>
                                entry.kind === "icon-link" && (
                                  <li class:list={["reveal-child min-w-0", index % 3 === 1 && "stagger-1", index % 3 === 2 && "stagger-2"]}>
                                    <LabsComparisonCard card={relatedComparisonCard(entry)} />
                                  </li>
                                ),
                            )}
                          </ul>
                        </div>
                      </section>
                    )
                  );
                case "cta02":
                  return (
                    <div class="scroll-reveal-section">
                      <div class="reveal-child">
                        <LabsCloseCta content={closeContent(block, "Vs")} preset="comparison" />
                      </div>
                    </div>
                  );
                default: {
                  const unreachable: never = block;
                  throw new Error(
                    `Unhandled /vs block: ${JSON.stringify(unreachable)}`,
                  );
                }
              }
            })}
          </main>
        </>
      );
    })()
  )}

  <script>
    import { initCodeCopy } from "../../../scripts/code-copy";
    import { initScrollReveal } from "../../../scripts/labs-scroll-reveal";
    initCodeCopy();
    initScrollReveal();
  </script>
</BaseLayout>

<style>
  .comparison-blocks-body :global(> section:first-child) { padding-top: 0; }
</style>
