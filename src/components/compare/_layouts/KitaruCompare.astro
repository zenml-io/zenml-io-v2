---
/**
 * Kitaru MDX comparison layout on the Labs shell. The content keeps its
 * Kitaru scope so the established Labs-to-Kitaru token bridge remains the
 * single translation layer for Kitaru-origin graphics.
 */
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { BAND_CONTENT_GAP, blogLaneStyle } from "../../../lib/blogLayout";
import {
  type CompareSwitcherGroup,
  comparisonDisplayHeading,
} from "../../../lib/labsComparison";
import { compareOgUrl } from "../../../lib/seo";
import "../../../styles/kitaru-compat.css";
import LabsComparisonBand from "../../labs/LabsComparisonBand.astro";
import { comparisonProse } from "../ComparisonProse";
import "../../../styles/comparison-prose.css";

interface Props {
  entry: CollectionEntry<"compare-kitaru">;
  switcherGroups: readonly CompareSwitcherGroup[];
}
const { entry, switcherGroups } = Astro.props;
const { Content } = await render(entry);
const ogImage = entry.data.ogImage ?? compareOgUrl("kitaru", entry.id);
const breadcrumb = [
  { label: "Compare", href: "/compare" },
  { label: entry.data.title },
] as const;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={ogImage}
  surface="agent"
  app="labs"
  product="kitaru"
>
  <LabsComparisonBand
    breadcrumb={breadcrumb}
    eyebrow="Compare"
    headline={comparisonDisplayHeading(entry.data.title, "Kitaru", entry.data.competitor)}
    deck={entry.data.description}
    product="kitaru"
    competitor={entry.data.competitor}
    competitorMark={entry.data.competitorLogo ? { url: entry.data.competitorLogo, alt: entry.data.competitor } : undefined}
    switcherGroups={switcherGroups}
  />

  <div data-app="kitaru" style="background: transparent;">
    <main class={BAND_CONTENT_GAP} style={blogLaneStyle()}>
      <article class="compare-body-inner">
        <Content components={comparisonProse} />
      </article>
    </main>
  </div>

  <script>
    import { initCodeCopy } from "../../../scripts/code-copy";
    import { initScrollReveal } from "../../../scripts/labs-scroll-reveal";
    initCodeCopy();
    initScrollReveal();
  </script>
</BaseLayout>
