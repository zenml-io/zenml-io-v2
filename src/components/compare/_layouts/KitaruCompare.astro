---
/**
 * KitaruCompare — Kitaru-vs-X comparison detail template.
 *
 * Ported from `kitaru/site/src/pages/compare/[slug].astro`. Wraps content
 * in <div data-app="kitaru"> so the warm cream + orange tokens activate
 * for the page chrome. The MDX body renders inline-imported Kitaru
 * compare components (ComparisonTable, CodeCompare, FeatureWithGraphic,
 * etc.) which live at src/components/compare/kitaru/.
 *
 * Loaded by src/pages/compare/[slug].astro for any slug in the
 * compare-kitaru collection.
 */
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ComparisonHero from "../kitaru/ComparisonHero.astro";
import "../../../styles/kitaru-compat.css";

interface Props {
  entry: CollectionEntry<"compare-kitaru">;
  competitorOptions: Array<{
    slug: string;
    competitor: string;
    competitorLogo?: string;
  }>;
}
const { entry, competitorOptions } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.ogImage}
  surface="agent"
>
  <div data-app="kitaru" class="bg-background text-foreground">
    <main id="kitaru-main" class="compare-page">
      <ComparisonHero
        title={entry.data.title}
        shortTitle={entry.data.shortTitle}
        description={entry.data.description}
        competitor={entry.data.competitor}
        competitorLogo={entry.data.competitorLogo}
        competitorTagline={entry.data.competitorTagline}
        competitorOptions={competitorOptions}
        currentSlug={entry.id}
      />

      <div class="compare-body">
        <article class="compare-body-inner">
          <Content />
        </article>
      </div>
    </main>
  </div>
</BaseLayout>

{/* IntersectionObserver-driven [data-reveal] fade-in. Without it, every
    Kitaru component (FeatureWithGraphic, WhenToUseEach, CodeCompare, ...)
    stays opacity:0 — the whole article body looks blank. */}
<script>
  import "../../../scripts/kitaru/scroll-reveal";
</script>

<style>
  /* Match kitaru.ai's pages/compare/[slug].astro layout rules verbatim.
   * Astro already scopes this <style> to the component, so no `[data-app]`
   * selector prefix is used — adding one raises specificity above the ported
   * Kitaru compare components' own styles and inflates their typography. */
  .compare-page {
    padding-top: 0;
    background: oklch(0.995 0.002 75);
  }
  .compare-body {
    padding: 40px 24px 60px;
    max-width: 1192px;
    margin: 0 auto;
  }
  .compare-body-inner {
    max-width: none;
    margin: 0;
  }
  @media (min-width: 820px) {
    .compare-body {
      padding: 48px 32px 80px;
    }
    .compare-body-inner :global(p),
    .compare-body-inner :global(ul),
    .compare-body-inner :global(h1),
    .compare-body-inner :global(h2),
    .compare-body-inner :global(h3) {
      max-width: 820px;
      margin-left: auto;
      margin-right: auto;
    }
  }
  /* Article typography (matches kitaru/site original) */
  .compare-body-inner :global(h2) {
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin: 56px 0 16px;
    color: var(--color-primary);
  }
  .compare-body-inner :global(h3) {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.005em;
    line-height: 1.3;
    margin: 36px 0 12px;
    color: var(--color-primary);
  }
  .compare-body-inner :global(p) {
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-secondary);
    margin: 0 0 18px;
  }
  .compare-body-inner :global(> p:nth-of-type(-n+2)) {
    font-size: 24px;
    line-height: 1.5;
    color: var(--color-primary);
    margin-bottom: 24px;
    max-width: 820px;
    margin-left: auto;
    margin-right: auto;
  }
  .compare-body-inner :global(> p:nth-of-type(2)) {
    margin-bottom: 40px;
  }
  .compare-body-inner :global(ul) {
    padding-left: 22px;
    margin: 0 0 18px;
  }
  .compare-body-inner :global(li) {
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-secondary);
    margin-bottom: 8px;
  }
  .compare-body-inner :global(code) {
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--color-primary);
  }
  .compare-body-inner :global(pre) {
    padding: 20px 22px;
    border-radius: 10px;
    margin: 22px 0 26px;
    font-size: 14px;
    line-height: 1.7;
  }
  .compare-body-inner :global(pre code) {
    background: transparent;
  }
  .compare-body-inner :global(a:not([class*="btn-"])) {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  /* Markdown pipe-tables */
  .compare-body-inner :global(table:not(.ctable)) {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    margin: 24px 0 40px;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
    background: var(--color-surface);
    font-size: 15px;
    line-height: 1.55;
  }
  .compare-body-inner :global(table:not(.ctable) thead) {
    background: var(--color-surface-warm);
  }
  .compare-body-inner :global(table:not(.ctable) th),
  .compare-body-inner :global(table:not(.ctable) td) {
    padding: 14px 18px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-secondary);
  }
  .compare-body-inner :global(table:not(.ctable) th) {
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-primary);
  }
  .compare-body-inner :global(table:not(.ctable) tbody tr:last-child td) {
    border-bottom: none;
  }
  .compare-body-inner :global(table:not(.ctable) td:first-child) {
    font-weight: 600;
    color: var(--color-primary);
  }
</style>
