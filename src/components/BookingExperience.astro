---
import { FOOTER_LEGAL } from "../lib/footer";
import {
  CAL_EMBED_SCRIPT,
  CAL_ORIGIN,
  TURNSTILE_SITE_KEY,
} from "../lib/formConstants";
import type { CalEmbedConfig, PlaceholderField } from "../lib/formTypes";
import { KITARU_GRAIN } from "../lib/kitaru-grain-palettes";
import { LABS_GRAIN } from "../lib/labs-grain-palettes";
import { LABS_FOOTER } from "../lib/labs-home";
import KitaruLockup from "./brand/KitaruLockup.astro";
import ZenmlLabsLogo from "./brand/ZenmlLabsLogo.astro";
/**
 * BookingExperience — shared two-column demo-booking body.
 *
 * Rendered by both /book-your-demo (ZenML) and /book-your-demo/kitaru
 * (Kitaru co-brand). Everything that differs between the two is a prop;
 * the markup, form wiring, and calendar-transition script are shared so
 * the two routes can never drift apart.
 *
 * Brand colour: the page uses `text-zenml-500` / `bg-zenml-500` utilities
 * throughout (including inside the DemoRequestForm island). Those compile
 * to `var(--color-zenml-500)`, so the Kitaru variant re-skins the whole
 * subtree to orange via the shared `.kitaru-brand-vars` class (global.css)
 * on the wrapper — no per-element or per-island edits.
 *
 * NOTE: this deliberately does NOT use the usual `data-app="kitaru"` brand
 * switch. The `--color-zenml-*` ladder is intentionally data-app-invariant
 * (global.css), so `data-app="kitaru"` would leave these utilities purple;
 * and the form island hardcodes `bg-zenml-500`, which `text-primary` can't
 * reach. `.kitaru-brand-vars` is the one lever that recolours both the
 * markup and the island. If you audit Kitaru surfaces by grepping
 * `data-app="kitaru"`, remember this page brands itself a different way.
 */
import DemoRequestForm from "./islands/DemoRequestForm.tsx";
import { GrainBackdrop } from "./islands/GrainBackdrop";

interface Props {
  /** Drives the header logo and the orange brand-token override. */
  brand: "zenml" | "kitaru";
  /** Where the header logo links ("/" for ZenML, "/product/kitaru" for Kitaru). */
  homeHref: string;
  hero: {
    headlinePrefix: string;
    headlineHighlight: string;
    headlineSuffix: string;
    deck: string;
  };
  /** Optional credibility line shown above the customer logos. */
  proofLabel?: string;
  /** Optional 2×2 stat grid. Omit to hide it (Kitaru co-brand does). */
  stats?: { value: string; label: string }[];
  logos: { name: string; src: string }[];
  form: {
    headline: string;
    deck: string;
    calHeadline: string;
    calDeck: string;
  };
  fields: PlaceholderField[];
  cal: CalEmbedConfig;
}

const { brand, homeHref, hero, proofLabel, stats, logos, form, fields, cal } =
  Astro.props;
const isKitaru = brand === "kitaru";
const grain = isKitaru ? KITARU_GRAIN.hero : LABS_GRAIN.hero;
---

<div class:list={["booking-root relative min-h-screen overflow-hidden bg-(--color-sage-50)", isKitaru && "kitaru-brand-vars"]}>
  <GrainBackdrop client:visible config={grain} class="absolute inset-0" />
  {/* Logo header */}
  <header class="relative bg-transparent">
    <div class="mx-auto max-w-content px-gutter py-5">
      {isKitaru ? (
        <a href={homeHref} aria-label="Kitaru home" class="inline-flex h-8 text-foreground">
          <KitaruLockup class="h-full w-auto" />
        </a>
      ) : (
        <a href={homeHref} aria-label="ZenML Labs home" class="inline-flex h-8 text-foreground">
          <ZenmlLabsLogo class="h-full w-auto" />
        </a>
      )}
    </div>
  </header>

  <main class="relative">
    {/* Two-column section */}
    <section class="py-space-xl sm:py-space-xxl">
      <div class="mx-auto max-w-content px-gutter">
        <div id="demo-form-grid" class="grid items-start gap-space-xl lg:grid-cols-2 lg:gap-space-xxl">
          {/* ── Left column: marketing copy ── */}
          <div id="demo-form-marketing">
            <p class="font-sans text-sm text-(--color-sage-800)">Personalized product walkthrough</p>
            <h1 class="mt-4 font-display text-5xl text-foreground sm:text-6xl">
              {hero.headlinePrefix}<span class={isKitaru ? "text-(--color-orange-700)" : "text-(--color-sage-800)"}>{hero.headlineHighlight}</span>{hero.headlineSuffix}
            </h1>
            <p class="mt-5 max-w-xl font-sans text-lg leading-relaxed text-muted-foreground">
              {hero.deck}
            </p>

            {/* Stats 2×2 grid */}
            {stats && stats.length > 0 && (
              <div class="mt-space-lg grid grid-cols-2 gap-3">
                {stats.map((stat) => (
                  <div class="rounded-[12px] border border-border bg-card px-4 py-5">
                    <p class="font-display text-3xl text-foreground">
                      {stat.value}
                    </p>
                    <p class="mt-2 font-sans text-sm leading-snug text-muted-foreground">
                      {stat.label}
                    </p>
                  </div>
                ))}
              </div>
            )}

            {/* Co-brand credibility line */}
            {proofLabel && (
              <p class="mt-space-lg font-sans text-sm leading-relaxed text-muted-foreground">
                {proofLabel}
              </p>
            )}

            {/* Customer logos */}
            <div class:list={["flex flex-wrap items-center gap-6 sm:gap-8", proofLabel ? "mt-6" : "mt-space-lg"]}>
              {logos.map((logo) => (
                <img
                  src={logo.src}
                  alt={logo.name}
                  class="h-6 max-w-[100px] object-contain sm:h-7 sm:max-w-[120px]"
                  loading="lazy"
                />
              ))}
            </div>
          </div>

          {/* ── Right column: form → calendar ── */}
          <div id="demo-form-col">
            <div class="mt-6">
              <DemoRequestForm
                client:load
                endpoint="/api/forms/demo-request"
                fields={fields}
                submitLabel="Send Request"
                loadingLabel="Sending…"
                calConfig={cal}
                calOrigin={CAL_ORIGIN}
                calEmbedScript={CAL_EMBED_SCRIPT}
                turnstileSiteKey={TURNSTILE_SITE_KEY}
                heading={form.headline}
                deck={form.deck}
                calendarHeading={form.calHeadline}
                calendarDeck={form.calDeck}
              />
            </div>

            {/* Privacy note */}
            <p id="demo-form-privacy" class="mt-3 text-center font-sans text-xs text-muted-foreground">
              By continuing, you agree to our{" "}
              <a href="/privacy-policy" class="text-(--color-sage-800) underline decoration-(--color-sage-500) underline-offset-4 hover:text-foreground">
                privacy policy
              </a>.
            </p>
          </div>
        </div>
      </div>
    </section>

  </main>

  <footer class="relative mt-space-xl border-t border-border/70 bg-transparent">
    <div class="mx-auto flex max-w-content flex-col gap-4 px-gutter py-8 md:flex-row md:items-center md:justify-between">
      <p class="font-sans text-[16px] text-foreground">&copy; {new Date().getFullYear()} {LABS_FOOTER.copyright}</p>
      <nav aria-label="Legal" class="flex flex-wrap items-center gap-6">
        {FOOTER_LEGAL.map((link) => (
          <a href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noopener noreferrer" : undefined} class="cursor-pointer font-label text-[12px] uppercase tracking-[0.05em] text-foreground hover:text-(--color-sage-700)">{link.label}</a>
        ))}
      </nav>
    </div>
  </footer>
</div>

<style>
  @keyframes demoFormSlideUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  /* Applied by JS when calendar replaces the form */
  #demo-form-grid.demo-cal-active {
    grid-template-columns: 1fr;
    max-width: 56rem;
    margin-left: auto;
    margin-right: auto;
  }
  #demo-form-marketing.demo-cal-hidden {
    display: none;
  }
</style>
