---
/**
 * Button — renders <a> when href is provided, <button> otherwise.
 * Encapsulates consistent CTA styling (shadows, radius, hover effects).
 */
import {
  BUTTON_BASE_CLASSES,
  BUTTON_SIZE_CLASSES,
  BUTTON_VARIANT_CLASSES,
  type ButtonSize as Size,
  type ButtonVariant as Variant,
} from "../lib/buttonStyles";

interface Props {
  href?: string;
  type?: "button" | "submit" | "reset";
  variant?: Variant;
  size?: Size;
  target?: string;
  rel?: string;
  disabled?: boolean;
  class?: string;
  /** Plausible event name — rendered as data-analytics for click tracking. */
  dataAnalytics?: string;
}

const {
  href,
  type = "button",
  variant = "primary",
  size = "md",
  target,
  rel,
  disabled = false,
  class: className,
  dataAnalytics,
} = Astro.props;

const disabledClasses = disabled ? "opacity-50 pointer-events-none" : "";

const classes = [
  BUTTON_BASE_CLASSES,
  BUTTON_VARIANT_CLASSES[variant],
  BUTTON_SIZE_CLASSES[size],
  disabledClasses,
  className,
]
  .filter(Boolean)
  .join(" ");
---

{
  href ? (
    <a href={href} class={classes} target={target} rel={rel} data-analytics={dataAnalytics}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} disabled={disabled} data-analytics={dataAnalytics}>
      <slot />
    </button>
  )
}
