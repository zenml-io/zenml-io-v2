---
/**
 * CaseStudySidebar — metadata sidebar for case study detail pages.
 *
 * Renders company info, website link, ML team size, cloud provider,
 * industry, use case badges, and optional PDF download.
 * Styled to match the Webflow original with icons and purple labels.
 */
import DescriptionList, {
  type DescriptionListItem,
} from "../templates/DescriptionList.astro";

interface Props {
  company: string;
  website?: { label: string; href: string };
  mlTeamSize?: string;
  cloudProvider?: string;
  industry?: string;
  useCases: string[];
  pdfDownload?: { label: string; href: string };
}

const {
  company,
  website,
  mlTeamSize,
  cloudProvider,
  industry,
  useCases,
  pdfDownload,
} = Astro.props;

const items: DescriptionListItem[] = [];
if (company) {
  items.push({ term: "Company", value: { kind: "text", text: company, icon: "building" } });
}
if (website) {
  items.push({
    term: "Website",
    value: { kind: "link", href: website.href, label: website.label, icon: "link" },
  });
}
if (mlTeamSize) {
  items.push({ term: "ML Team Size", value: { kind: "text", text: mlTeamSize, icon: "people" } });
}
if (cloudProvider) {
  items.push({ term: "Cloud Provider", value: { kind: "text", text: cloudProvider, icon: "cloud" } });
}
if (industry) {
  items.push({ term: "Industry", value: { kind: "text", text: industry, icon: "store" } });
}
---

<aside class="rounded-2xl border border-gray-200 bg-gray-50 p-6 lg:p-8">
  {pdfDownload && (
    <a
      href={pdfDownload.href}
      target="_blank"
      rel="noopener noreferrer"
      class="mb-6 inline-flex items-center gap-2 text-base font-semibold text-zenml-600 hover:text-zenml-700 transition-colors"
    >
      {/* Download icon */}
      <svg class="h-5 w-5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v3.6c0 .56 0 .84-.109 1.054a1 1 0 0 1-.437.437C20.24 20.2 19.96 20.2 19.4 20.2H4.6c-.56 0-.84 0-1.054-.109a1 1 0 0 1-.437-.437C3 19.44 3 19.16 3 18.6V15M17 10l-5 5m0 0-5-5m5 5V3" />
      </svg>
      {pdfDownload.label}
    </a>
  )}

  <DescriptionList
    items={items}
    trailing={{ term: "Use Cases", chips: useCases }}
    space="sm"
  />
</aside>
