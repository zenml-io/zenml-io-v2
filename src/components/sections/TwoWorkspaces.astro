---
import { Code } from "astro:components";
import zenmlLight from "../../styles/zenml-light.json";
import { HOMEPAGE_UNIFIED_WIDGET } from "../../lib/homepage-unified";

/**
 * TwoWorkspaces — Variant C workspace widget (ElevenLabs-style).
 *
 * Pill switcher + active surface label + two-column body (pipelines/flows
 * list left, code definition right) + feature subtabs row. Both tab
 * variants are server-rendered; a tiny vanilla-JS handler flips a
 * `data-active-tab` attribute on the root to swap which is visible.
 *
 * Per-brand restraint: violet (ZenML) and orange (Kitaru) appear only
 * inside their own tab. The shared surface stays neutral.
 *
 * Code blocks render through Astro's `<Code>` component with the site's
 * `zenml-light` Shiki theme — same theme as blog/docs/get-started so
 * tokens read consistently across the surface.
 *
 * Reads from `HOMEPAGE_UNIFIED_WIDGET` in src/lib/homepage-unified.ts.
 */

const { tabs } = HOMEPAGE_UNIFIED_WIDGET;

type Tab = (typeof tabs)[number];
type Row = Tab["rows"][number];

const isSelected = (row: Row) => "selected" in row && row.selected === true;

const dotClass = (tab: Tab) =>
  tab.id === "zenml" ? "bg-zenml-500" : "bg-orange-400";

const selectedRowClass = (tab: Tab) =>
  tab.id === "zenml"
    ? "border-zenml-300 bg-zenml-50"
    : "border-orange-300 bg-orange-50";
---

<section class="bg-white">
  <div class="mx-auto max-w-[1440px] px-6 pt-6 pb-20 sm:px-10 lg:pb-28">
    <div
      id="two-workspaces"
      data-active-tab="zenml"
      class="mx-auto flex max-w-[1280px] flex-col gap-4 rounded-2xl border border-gray-200 bg-gray-50 p-5 shadow-[0_1px_0_rgba(15,15,18,0.04),_0_24px_48px_-24px_rgba(15,15,18,0.12)]"
    >
      {/* Top bar — tabs + active surface label */}
      <div class="flex flex-col items-start justify-between gap-3 px-1 pt-1 sm:flex-row sm:items-start">
        {/* Pill switcher */}
        <div
          role="tablist"
          aria-label="Workspace"
          class="inline-flex items-center rounded-full border border-gray-200 bg-white p-1.5 shadow-[0_1px_2px_rgba(15,15,18,0.04)]"
        >
          {tabs.map((tab) => (
            <button
              type="button"
              role="tab"
              id={`workspace-tab-${tab.id}`}
              data-tab-trigger={tab.id}
              aria-controls={`workspace-panel-${tab.id}`}
              aria-selected={tab.id === "zenml" ? "true" : "false"}
              tabindex={tab.id === "zenml" ? 0 : -1}
              class="group inline-flex cursor-pointer items-center gap-2 rounded-full px-3.5 py-1.5 text-sm font-medium text-gray-900 transition-colors aria-selected:bg-gray-900 aria-selected:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zenml-500"
            >
              <span
                class={`inline-block size-2 shrink-0 rounded-full ${dotClass(tab)}`}
                aria-hidden="true"
              ></span>
              <span>{tab.label}</span>
              <span class="text-[11px] font-normal text-gray-400 group-aria-selected:text-white/60">
                {tab.sublabel}
              </span>
            </button>
          ))}
        </div>

        {/* Active surface label (right) — swaps per tab, grid-stacked so the
            row height stays constant when the active tab changes */}
        <div class="workspace-stack items-start sm:items-end sm:pt-1">
          {tabs.map((tab) => (
            <div
              data-surface-label={tab.id}
              class="flex flex-col items-start sm:items-end"
            >
              <p class="text-xl font-medium leading-6 tracking-[-0.015em] text-gray-900">
                {tab.surfaceTitle}
              </p>
              <p class="text-[13px] leading-4 text-gray-500">
                {tab.surfaceSubtitle}
              </p>
            </div>
          ))}
        </div>
      </div>

      {/* Body — two panes per tab; both panels are rendered (grid-stacked)
          so the widget keeps the taller variant's height and the layout
          never shifts when the active tab changes */}
      <div class="workspace-stack px-1">
        {tabs.map((tab) => (
          <div
            id={`workspace-panel-${tab.id}`}
            role="tabpanel"
            data-tab-content={tab.id}
            aria-labelledby={`workspace-tab-${tab.id}`}
            class="grid grid-cols-1 gap-4 lg:grid-cols-2"
          >
            {/* Left pane — list */}
            <div class="flex flex-col rounded-md border border-gray-200 bg-white p-1.5">
              {tab.rows.map((row) =>
                isSelected(row) ? (
                  <div
                    class={`flex items-center gap-3 rounded-md border p-3 ${selectedRowClass(tab)}`}
                  >
                    <span
                      class={`inline-block size-5 shrink-0 rounded-full ${dotClass(tab)}`}
                      aria-hidden="true"
                    ></span>
                    <div class="flex min-w-0 flex-1 flex-col">
                      <span class="truncate text-[15px] font-medium leading-[18px] text-gray-900">
                        {row.name}
                      </span>
                      <span class="truncate font-mono text-[11px] leading-[14px] text-gray-600">
                        {row.meta}
                      </span>
                    </div>
                    <button
                      type="button"
                      aria-label={`Run ${row.name}`}
                      class="inline-flex size-9 shrink-0 cursor-pointer items-center justify-center rounded-full bg-gray-900 text-white transition-colors hover:bg-gray-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zenml-500 sm:size-8"
                    >
                      <svg
                        viewBox="0 0 12 12"
                        class="size-2.5"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d="M2 1.5v9l8-4.5z" />
                      </svg>
                    </button>
                  </div>
                ) : (
                  <div class="flex items-center gap-3 px-3 py-2.5">
                    <span
                      class="inline-block size-5 shrink-0 rounded-full bg-gray-400"
                      aria-hidden="true"
                    ></span>
                    <div class="flex min-w-0 flex-1 flex-col">
                      <span class="truncate text-[15px] font-medium leading-[18px] text-gray-900">
                        {row.name}
                      </span>
                      <span class="truncate font-mono text-[11px] leading-[14px] text-gray-600">
                        {row.meta}
                      </span>
                    </div>
                    {row.badge && (
                      <span class="inline-block shrink-0 rounded-full border border-gray-200 bg-gray-50 px-2.5 py-1 font-mono text-[11px] leading-[14px] tracking-[0.04em] text-gray-500">
                        {row.badge}
                      </span>
                    )}
                  </div>
                )
              )}

              {/* List footer */}
              <div class="mt-1.5 flex items-center justify-between border-t border-gray-200 px-3 pt-2.5 pb-1">
                <span class="text-[13px] font-medium text-gray-900">
                  {tab.listFooter}
                </span>
                <div class="flex items-center gap-1">
                  <button
                    type="button"
                    aria-label="Previous page"
                    class="inline-flex size-9 cursor-pointer items-center justify-center rounded-full text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zenml-500 sm:size-8"
                  >
                    <svg viewBox="0 0 16 16" class="size-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M10 12L6 8l4-4" />
                    </svg>
                  </button>
                  <button
                    type="button"
                    aria-label="Next page"
                    class="inline-flex size-9 cursor-pointer items-center justify-center rounded-full text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zenml-500 sm:size-8"
                  >
                    <svg viewBox="0 0 16 16" class="size-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M6 4l4 4-4 4" />
                    </svg>
                  </button>
                </div>
              </div>
            </div>

            {/* Right pane — code definition */}
            <div class="flex flex-col gap-3 rounded-md border border-gray-200 bg-white p-4">
              <div class="flex items-center justify-between">
                <span class="text-[13px] text-gray-500">{tab.codeTitle}</span>
                <span class="inline-block rounded-md border border-gray-200 bg-gray-50 px-2.5 py-1 font-mono text-[11px] leading-[14px] text-gray-500">
                  {tab.codeFile}
                </span>
              </div>
              <div class="workspace-code min-w-0 flex-1 overflow-x-auto">
                <Code code={tab.code} lang="python" theme={zenmlLight as any} />
              </div>
              <div class="flex items-center gap-3 border-t border-gray-200 pt-2.5">
                <span class="font-mono text-[11px] uppercase leading-[14px] tracking-[0.04em] text-gray-500">
                  <span
                    class={`mr-2 inline-block size-1.5 rounded-full align-middle ${tab.id === "zenml" ? "bg-success-500" : "bg-orange-400"}`}
                    aria-hidden="true"
                  ></span>
                  {tab.footerMeta}
                </span>
              </div>
            </div>
          </div>
        ))}
      </div>

      {/* Feature subtabs — first is the active surface. Grid-stacked so
          the row height stays constant on tab switch. */}
      <div class="workspace-stack px-1 pt-1.5 pb-0.5">
        {tabs.map((tab) => (
          <div
            data-subtabs={tab.id}
            class="flex flex-wrap items-center justify-center gap-5"
          >
            {tab.subtabs.map((label, idx) =>
              idx === 0 ? (
                <span class="inline-flex items-center gap-2 rounded-full bg-gray-900 px-4 py-1.5 text-sm font-medium text-white">
                  <svg viewBox="0 0 14 14" class="size-3.5" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
                    <circle cx="3" cy="3" r="1.5" fill="currentColor" />
                    <circle cx="11" cy="3" r="1.5" fill="currentColor" />
                    <circle cx="3" cy="11" r="1.5" fill="currentColor" />
                    <circle cx="11" cy="11" r="1.5" fill="currentColor" />
                    <line x1="3" y1="3" x2="11" y2="3" />
                    <line x1="3" y1="3" x2="3" y2="11" />
                  </svg>
                  {label}
                </span>
              ) : (
                <span class="px-1 py-2 text-sm font-medium text-gray-500">
                  {label}
                </span>
              )
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Grid-stack the three swap surfaces (tab body, surface label, subtabs)
     so the widget always reserves the height of the taller variant —
     switching tabs doesn't shift the page layout. The inactive variant
     stays in the DOM but hides via visibility so it still claims space. */
  .workspace-stack {
    display: grid;
    grid-template-areas: "stack";
  }
  .workspace-stack > * {
    grid-area: stack;
    min-width: 0;
  }
  .workspace-stack > [data-tab-content],
  .workspace-stack > [data-surface-label],
  .workspace-stack > [data-subtabs] {
    visibility: hidden;
    pointer-events: none;
  }
  #two-workspaces[data-active-tab="zenml"] .workspace-stack > [data-tab-content="zenml"],
  #two-workspaces[data-active-tab="zenml"] .workspace-stack > [data-surface-label="zenml"],
  #two-workspaces[data-active-tab="zenml"] .workspace-stack > [data-subtabs="zenml"],
  #two-workspaces[data-active-tab="kitaru"] .workspace-stack > [data-tab-content="kitaru"],
  #two-workspaces[data-active-tab="kitaru"] .workspace-stack > [data-surface-label="kitaru"],
  #two-workspaces[data-active-tab="kitaru"] .workspace-stack > [data-subtabs="kitaru"] {
    visibility: visible;
    pointer-events: auto;
  }

  /* Strip Shiki defaults so its <pre> lays flush inside our panel */
  .workspace-code :global(pre) {
    margin: 0;
    padding: 0;
    background: transparent !important;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.55;
  }
  .workspace-code :global(code) {
    font-family: inherit;
  }
</style>

<script>
  const root = document.getElementById("two-workspaces");
  if (root) {
    const triggers = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-tab-trigger]"),
    );

    const setActive = (id: string, focus = false) => {
      root.dataset.activeTab = id;
      triggers.forEach((btn) => {
        const isActive = btn.dataset.tabTrigger === id;
        btn.setAttribute("aria-selected", isActive ? "true" : "false");
        // Roving tabindex: only the active tab is in the sequential tab order.
        btn.tabIndex = isActive ? 0 : -1;
        if (isActive && focus) btn.focus();
      });
    };

    // Sync initial state (SSR sets a default; this normalizes after hydration).
    setActive(root.dataset.activeTab || "zenml");

    triggers.forEach((btn, idx) => {
      btn.addEventListener("click", () => {
        const next = btn.dataset.tabTrigger;
        if (next) setActive(next);
      });

      // ARIA tab-pattern keyboard nav: Arrow keys + Home/End rotate focus.
      btn.addEventListener("keydown", (e: KeyboardEvent) => {
        let nextIdx: number | null = null;
        if (e.key === "ArrowRight") nextIdx = (idx + 1) % triggers.length;
        else if (e.key === "ArrowLeft")
          nextIdx = (idx - 1 + triggers.length) % triggers.length;
        else if (e.key === "Home") nextIdx = 0;
        else if (e.key === "End") nextIdx = triggers.length - 1;
        if (nextIdx === null) return;
        e.preventDefault();
        const target = triggers[nextIdx]?.dataset.tabTrigger;
        if (target) setActive(target, true);
      });
    });
  }
</script>
