---
import { HOMEPAGE_UNIFIED_WIDGET } from "../../lib/homepage-unified";
import ArtifactDetailLayout from "./two-workspaces/ArtifactDetailLayout.astro";
import StacksTableLayout from "./two-workspaces/StacksTableLayout.astro";
import PipelinesLayout from "./two-workspaces/PipelinesLayout.astro";
import ModelsLayout from "./two-workspaces/ModelsLayout.astro";
import IntegrationsMLLayout from "./two-workspaces/IntegrationsMLLayout.astro";
import FlowsLayout from "./two-workspaces/FlowsLayout.astro";
import CheckpointsLayout from "./two-workspaces/CheckpointsLayout.astro";
import ReplayLayout from "./two-workspaces/ReplayLayout.astro";
import DeploymentsLayout from "./two-workspaces/DeploymentsLayout.astro";
import IntegrationsAgentsLayout from "./two-workspaces/IntegrationsAgentsLayout.astro";

/**
 * TwoWorkspaces — Variant C workspace widget (ElevenLabs-style).
 *
 * Two axes of switching:
 *   1. Outer tab pill: ML (ZenML) ↔ Agents (Kitaru)
 *   2. Inner subtabs strip per tab: Pipelines/Artifacts/Stacks/Models/Integrations
 *      (ML) and Flows/Checkpoints/Replay/Deployments/Integrations (Agents)
 *
 * Each of the 10 subtab views has its own bespoke layout component
 * (PipelinesLayout, ArtifactDetailLayout, StacksTableLayout, ModelsLayout,
 * IntegrationsMLLayout / FlowsLayout, CheckpointsLayout, ReplayLayout,
 * DeploymentsLayout, IntegrationsAgentsLayout). All ten render real
 * ZenML / Kitaru product surfaces — the homepage hero stops being a
 * marketing illustration and starts looking like the actual product.
 *
 * All 10 body panels + 10 surface labels are server-rendered and
 * grid-stacked. A single `data-active-view="tab.subtab"` attribute on the
 * root drives visibility via attribute selectors — the widget always
 * reserves the height of the tallest panel so switching never shifts the
 * page layout.
 *
 * Per-brand restraint: zenml-500 / orange-400 stay inside their own tab.
 *
 * Reads from `HOMEPAGE_UNIFIED_WIDGET` in src/lib/homepage-unified.ts.
 */

const { tabs } = HOMEPAGE_UNIFIED_WIDGET;

type Tab = (typeof tabs)[number];

const dotClass = (tab: Tab) =>
  tab.id === "zenml" ? "bg-zenml-500" : "bg-orange-400";

const allViews = tabs.flatMap((tab) =>
  tab.subtabs.map((sub) => ({ tab, sub, view: `${tab.id}.${sub.id}` as const })),
);

/** Default view = first subtab of the first tab (ML.Pipelines). */
const defaultView = allViews[0];
---

<section class="bg-white">
  <div class="mx-auto max-w-[1440px] px-6 pt-6 pb-20 sm:px-10 lg:pb-28">
    <div
      id="two-workspaces"
      data-active-tab={defaultView.tab.id}
      data-active-view={defaultView.view}
      class="mx-auto flex max-w-[1280px] flex-col gap-4 rounded-2xl border border-gray-200 bg-gray-50 p-5 shadow-subtle"
    >
      {/* Top bar — workspace pill (left) + subtab pill (right).
          Stacks vertically on narrow viewports. */}
      <div class="flex flex-col items-start justify-between gap-3 px-1 pt-1 sm:flex-row sm:items-center">
        {/* Pill switcher (outer tab) — buttons baseline-align their label
            + sublabel so "ML" / "ZenML" sit on one line. */}
        <div
          role="tablist"
          aria-label="Workspace"
          class="inline-flex items-center rounded-md border border-gray-200 bg-white p-1.5 shadow-[0_1px_2px_rgba(15,15,18,0.04)]"
        >
          {tabs.map((tab) => (
            <button
              type="button"
              role="tab"
              id={`workspace-tab-${tab.id}`}
              data-tab-trigger={tab.id}
              aria-controls={`workspace-panel-${tab.id}-${tab.subtabs[0].id}`}
              aria-selected={tab.id === defaultView.tab.id ? "true" : "false"}
              tabindex={tab.id === defaultView.tab.id ? 0 : -1}
              class="group inline-flex cursor-pointer items-baseline gap-2 rounded-sm px-3 py-1.5 text-sm font-medium text-gray-900 transition-colors aria-selected:bg-gray-900 aria-selected:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zenml-500"
            >
              <span
                class={`inline-block size-2 shrink-0 self-center rounded-full ${dotClass(tab)}`}
                aria-hidden="true"
              ></span>
              <span>{tab.label}</span>
              <span class="text-[11px] font-normal text-gray-400 group-aria-selected:text-white/60">
                {tab.sublabel}
              </span>
            </button>
          ))}
        </div>

        {/* Subtabs strip — one per tab, grid-stacked so they overlay in
            the same slot. Each strip is its own tablist; arrow-key nav
            rotates focus within the active strip. Right-aligned in the
            top bar so it floats opposite the workspace switcher. */}
        <div class="workspace-stack sm:justify-items-end">
          {tabs.map((tab) => (
            <div
              role="tablist"
              aria-label={`${tab.label} views`}
              data-subtabs={tab.id}
              class="inline-flex flex-wrap items-center gap-1 rounded-md border border-gray-200 bg-white p-1.5 shadow-[0_1px_2px_rgba(15,15,18,0.04)]"
            >
              {tab.subtabs.map((sub) => (
                <button
                  type="button"
                  role="tab"
                  id={`workspace-subtab-${tab.id}-${sub.id}`}
                  data-subtab-trigger={`${tab.id}.${sub.id}`}
                  aria-controls={`workspace-panel-${tab.id}-${sub.id}`}
                  aria-selected={
                    `${tab.id}.${sub.id}` === defaultView.view ? "true" : "false"
                  }
                  tabindex={
                    tab.id === defaultView.tab.id && sub.id === defaultView.sub.id
                      ? 0
                      : -1
                  }
                  class="inline-flex cursor-pointer items-center gap-1.5 rounded-sm px-3 py-1 text-xs font-medium text-gray-500 transition-colors hover:text-gray-900 aria-selected:bg-gray-900 aria-selected:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zenml-500"
                >
                  {sub.label}
                </button>
              ))}
            </div>
          ))}
        </div>
      </div>

      {/* Body — all 10 subtab panels grid-stacked so height stays constant */}
      <div class="workspace-stack px-1">
        {allViews.map(({ tab, sub, view }) => (
          <div
            id={`workspace-panel-${tab.id}-${sub.id}`}
            role="tabpanel"
            data-view={view}
            aria-labelledby={`workspace-subtab-${tab.id}-${sub.id}`}
          >
            {sub.layout === "pipelines" && (
              <PipelinesLayout
                title={sub.title}
                countLabel={sub.countLabel}
                subheader={sub.subheader}
                rows={sub.rows}
                fileName={sub.fileName}
                rightSubhead={sub.rightSubhead}
                steps={sub.steps as any}
                inputs={sub.inputs as any}
                output={sub.output}
              />
            )}
            {sub.layout === "models" && (
              <ModelsLayout
                title={sub.title}
                subheader={sub.subheader}
                countLabel={sub.countLabel}
                rows={sub.rows}
                modelName={sub.modelName}
                modelMeta={sub.modelMeta}
                versionBadge={sub.versionBadge}
                evolutionEyebrow={sub.evolutionEyebrow}
                evolutionSubhead={sub.evolutionSubhead}
                envStripEyebrow={sub.envStripEyebrow}
                envStripSubhead={sub.envStripSubhead}
                envs={sub.envs}
                footerMeta={sub.footerMeta}
              />
            )}
            {sub.layout === "integrations-ml" && (
              <IntegrationsMLLayout
                title={sub.title}
                subheader={sub.subheader}
                countLabel={sub.countLabel}
                rows={sub.rows}
                rightEyebrow={sub.rightEyebrow}
                rightSubhead={sub.rightSubhead}
                satellites={sub.satellites}
                footerMeta={sub.footerMeta}
              />
            )}
            {sub.layout === "flows" && (
              <FlowsLayout
                title={sub.title}
                subheader={sub.subheader}
                countLabel={sub.countLabel}
                rows={sub.rows}
                fileName={sub.fileName}
                rightEyebrow={sub.rightEyebrow}
                rightSubhead={sub.rightSubhead}
                code={sub.code}
                flowNodes={sub.flowNodes}
                footerMeta={sub.footerMeta}
              />
            )}
            {sub.layout === "checkpoints" && (
              <CheckpointsLayout
                title={sub.title}
                subheader={sub.subheader}
                countLabel={sub.countLabel}
                rows={sub.rows}
                rightEyebrow={sub.rightEyebrow}
                rightSubhead={sub.rightSubhead}
                recoveredPill={sub.recoveredPill}
                marks={sub.marks}
                failureCard={sub.failureCard}
                resumeCard={sub.resumeCard}
                footerMeta={sub.footerMeta}
              />
            )}
            {sub.layout === "replay" && (
              <ReplayLayout
                title={sub.title}
                subheader={sub.subheader}
                countLabel={sub.countLabel}
                packs={sub.packs}
                subhead={sub.subhead}
                winsPill={sub.winsPill}
                baseline={sub.baseline}
                candidate={sub.candidate}
                deltaChips={sub.deltaChips}
                steps={sub.steps}
                verdictEyebrow={sub.verdictEyebrow}
                verdictHeadline={sub.verdictHeadline}
                promoteLabel={sub.promoteLabel}
              />
            )}
            {sub.layout === "deployments" && (
              <DeploymentsLayout
                title={sub.title}
                subheader={sub.subheader}
                countLabel={sub.countLabel}
                rows={sub.rows}
                rightEyebrow={sub.rightEyebrow}
                rightSubhead={sub.rightSubhead}
                inboundLabel={sub.inboundLabel}
                inboundMeta={sub.inboundMeta}
                runtimePills={sub.runtimePills}
                substrateName={sub.substrateName}
                substrateRegion={sub.substrateRegion}
                podsActive={sub.podsActive}
                podsTotal={sub.podsTotal}
                footerMeta={sub.footerMeta}
              />
            )}
            {sub.layout === "integrations-agents" && (
              <IntegrationsAgentsLayout
                title={sub.title}
                subheader={sub.subheader}
                countLabel={sub.countLabel}
                rows={sub.rows}
                rightEyebrow={sub.rightEyebrow}
                rightSubhead={sub.rightSubhead}
                wrapEyebrow={sub.wrapEyebrow}
                wrapMeta={sub.wrapMeta}
                wrapRight={sub.wrapRight}
                activeFrameworkName={sub.activeFrameworkName}
                activeFrameworkInitial={sub.activeFrameworkInitial}
                activeFrameworkColor={sub.activeFrameworkColor}
                code={sub.code}
                swapChips={sub.swapChips}
                footerMeta={sub.footerMeta}
              />
            )}
            {sub.layout === "stacks-table" && (
              <StacksTableLayout
                tabId={tab.id}
                title={sub.title}
                subtitle={sub.subtitle}
                countLabel={sub.countLabel}
                columns={sub.columns}
                rows={sub.rows}
                cliLabel={sub.cliLabel}
                cliCommand={sub.cliCommand}
                codeTitle={sub.codeTitle}
                codeFile={sub.codeFile}
                code={sub.code}
                footerMeta={sub.footerMeta}
              />
            )}
            {sub.layout === "artifact-detail" && (
              <ArtifactDetailLayout
                tabId={tab.id}
                versions={sub.versions}
                versionsCount={sub.versionsCount}
                chartTitle={sub.chartTitle}
                chartSubtitle={sub.chartSubtitle}
                chartFile={sub.chartFile}
                chartFileMeta={sub.chartFileMeta}
                mean={sub.mean}
                std={sub.std}
                minLabel={sub.minLabel}
                maxLabel={sub.maxLabel}
                evolutionPoints={sub.evolutionPoints}
                evolutionNote={sub.evolutionNote}
                metaFields={sub.metaFields}
                lineageStep={sub.lineageStep}
                lineageDetail={sub.lineageDetail}
                listFooter={sub.listFooter}
                footerMeta={sub.footerMeta}
              />
            )}
          </div>
        ))}
      </div>

      {/* Active-view subtitle — sits bottom-left as a quiet caption.
          The title is omitted because the subtab pill already labels the
          active view. */}
      <div class="workspace-stack px-1 pb-0.5">
        {allViews.map(({ sub, view }) => (
          <p
            data-view={view}
            class="max-w-[640px] text-[13px] leading-5 text-gray-500"
          >
            {sub.surfaceSubtitle}
          </p>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  /* Grid-stack: render all variants in the same grid cell so the parent
     always reserves the height of the tallest child. Inactive variants
     stay in the DOM but hide via visibility so they still claim space. */
  .workspace-stack {
    display: grid;
    grid-template-areas: "stack";
  }
  .workspace-stack > * {
    grid-area: stack;
    min-width: 0;
  }
  .workspace-stack > [data-view],
  .workspace-stack > [data-subtabs] {
    visibility: hidden;
    pointer-events: none;
  }

  /* Show whichever view matches the root's data-active-view. Ten rules
     (one per view) — verbose but pure CSS, works without JS. */
  #two-workspaces[data-active-view="zenml.pipelines"] .workspace-stack > [data-view="zenml.pipelines"],
  #two-workspaces[data-active-view="zenml.artifacts"] .workspace-stack > [data-view="zenml.artifacts"],
  #two-workspaces[data-active-view="zenml.stacks"] .workspace-stack > [data-view="zenml.stacks"],
  #two-workspaces[data-active-view="zenml.models"] .workspace-stack > [data-view="zenml.models"],
  #two-workspaces[data-active-view="zenml.integrations"] .workspace-stack > [data-view="zenml.integrations"],
  #two-workspaces[data-active-view="kitaru.flows"] .workspace-stack > [data-view="kitaru.flows"],
  #two-workspaces[data-active-view="kitaru.checkpoints"] .workspace-stack > [data-view="kitaru.checkpoints"],
  #two-workspaces[data-active-view="kitaru.replay"] .workspace-stack > [data-view="kitaru.replay"],
  #two-workspaces[data-active-view="kitaru.deployments"] .workspace-stack > [data-view="kitaru.deployments"],
  #two-workspaces[data-active-view="kitaru.integrations"] .workspace-stack > [data-view="kitaru.integrations"] {
    visibility: visible;
    pointer-events: auto;
  }

  /* The subtabs strip swaps on the tab dimension only (5 buttons per tab). */
  #two-workspaces[data-active-tab="zenml"] .workspace-stack > [data-subtabs="zenml"],
  #two-workspaces[data-active-tab="kitaru"] .workspace-stack > [data-subtabs="kitaru"] {
    visibility: visible;
    pointer-events: auto;
  }
</style>

<script>
  const root = document.getElementById("two-workspaces");
  if (root) {
    const tabTriggers = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-tab-trigger]"),
    );
    const subTriggers = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-subtab-trigger]"),
    );

    // Per-tab memory of the last-active subtab — lets the user resume where
    // they were when they swing back to a tab.
    const lastSubtab: Record<string, string> = {};
    subTriggers.forEach((btn) => {
      const view = btn.dataset.subtabTrigger;
      if (!view) return;
      const [tabId, subId] = view.split(".");
      if (!(tabId in lastSubtab)) lastSubtab[tabId] = subId;
    });

    const applyView = (view: string, focus = false) => {
      const [tabId] = view.split(".");
      root.dataset.activeTab = tabId;
      root.dataset.activeView = view;
      lastSubtab[tabId] = view.split(".")[1];

      tabTriggers.forEach((btn) => {
        const isActive = btn.dataset.tabTrigger === tabId;
        btn.setAttribute("aria-selected", isActive ? "true" : "false");
        btn.tabIndex = isActive ? 0 : -1;
      });

      subTriggers.forEach((btn) => {
        const isActiveView = btn.dataset.subtabTrigger === view;
        btn.setAttribute("aria-selected", isActiveView ? "true" : "false");
        // Roving tabindex inside the active strip only.
        const isInActiveStrip = btn.dataset.subtabTrigger?.startsWith(`${tabId}.`);
        btn.tabIndex = isInActiveStrip && isActiveView ? 0 : -1;
        if (isActiveView && focus) btn.focus();
      });
    };

    // Tab click: swap to the tab's last-active subtab (or its default).
    tabTriggers.forEach((btn, idx) => {
      btn.addEventListener("click", () => {
        const tabId = btn.dataset.tabTrigger;
        if (!tabId) return;
        applyView(`${tabId}.${lastSubtab[tabId]}`);
      });
      btn.addEventListener("keydown", (e: KeyboardEvent) => {
        let nextIdx: number | null = null;
        if (e.key === "ArrowRight") nextIdx = (idx + 1) % tabTriggers.length;
        else if (e.key === "ArrowLeft")
          nextIdx = (idx - 1 + tabTriggers.length) % tabTriggers.length;
        else if (e.key === "Home") nextIdx = 0;
        else if (e.key === "End") nextIdx = tabTriggers.length - 1;
        if (nextIdx === null) return;
        e.preventDefault();
        const targetTab = tabTriggers[nextIdx]?.dataset.tabTrigger;
        if (targetTab) {
          applyView(`${targetTab}.${lastSubtab[targetTab]}`);
          tabTriggers[nextIdx].focus();
        }
      });
    });

    // Subtab click + keyboard nav (rotates inside the same strip).
    subTriggers.forEach((btn) => {
      btn.addEventListener("click", () => {
        const view = btn.dataset.subtabTrigger;
        if (view) applyView(view);
      });
      btn.addEventListener("keydown", (e: KeyboardEvent) => {
        const view = btn.dataset.subtabTrigger;
        if (!view) return;
        const [tabId] = view.split(".");
        const strip = subTriggers.filter((b) =>
          b.dataset.subtabTrigger?.startsWith(`${tabId}.`),
        );
        const idx = strip.indexOf(btn);
        let nextIdx: number | null = null;
        if (e.key === "ArrowRight") nextIdx = (idx + 1) % strip.length;
        else if (e.key === "ArrowLeft")
          nextIdx = (idx - 1 + strip.length) % strip.length;
        else if (e.key === "Home") nextIdx = 0;
        else if (e.key === "End") nextIdx = strip.length - 1;
        if (nextIdx === null) return;
        e.preventDefault();
        const target = strip[nextIdx]?.dataset.subtabTrigger;
        if (target) applyView(target, true);
      });
    });

    // Normalize after hydration in case SSR + JS drift.
    applyView(root.dataset.activeView || `${tabTriggers[0].dataset.tabTrigger}.${lastSubtab[tabTriggers[0].dataset.tabTrigger || ""]}`);
  }
</script>
