---
import { HOMEPAGE_UNIFIED_WIDGET } from "../../lib/homepage-unified";

/**
 * TwoWorkspaces — Variant C workspace widget (ElevenLabs-style).
 *
 * Pill switcher + active surface label + two-column body (pipelines/flows
 * list left, code definition right) + feature subtabs row. Both tab
 * variants are server-rendered; a tiny vanilla-JS handler flips a
 * `data-active-tab` attribute on the root to swap which is visible.
 *
 * Per-brand restraint: violet (ZenML) and orange (Kitaru) appear only
 * inside their own tab. The shared surface stays neutral.
 *
 * Reads from `HOMEPAGE_UNIFIED_WIDGET` in src/lib/homepage-unified.ts.
 */

const { tabs } = HOMEPAGE_UNIFIED_WIDGET;

type Tab = (typeof tabs)[number];
type Row = Tab["rows"][number];

const isSelected = (row: Row) => "selected" in row && row.selected === true;

const dotClass = (tab: Tab) =>
  tab.id === "zenml" ? "bg-zenml-500" : "bg-orange-400";

const selectedRowClass = (tab: Tab) =>
  tab.id === "zenml"
    ? "border-zenml-300 bg-zenml-50"
    : "border-orange-300 bg-orange-50";
---

<section class="bg-white">
  <div class="mx-auto max-w-[1440px] px-6 pt-8 pb-24 sm:px-10 lg:pb-32">
    <div
      id="two-workspaces"
      data-active-tab="zenml"
      class="mx-auto flex max-w-[1280px] flex-col gap-5 rounded-2xl border border-gray-200 bg-gray-50 p-6 shadow-[0_1px_0_rgba(15,15,18,0.04),_0_24px_48px_-24px_rgba(15,15,18,0.12)]"
    >
      {/* Top bar — tabs + active surface label */}
      <div class="flex flex-col items-start justify-between gap-4 px-1 pt-1 sm:flex-row sm:items-start">
        {/* Pill switcher */}
        <div
          role="tablist"
          aria-label="Workspace"
          class="inline-flex items-center rounded-full border border-gray-200 bg-white p-1.5 shadow-[0_1px_2px_rgba(15,15,18,0.04)]"
        >
          {tabs.map((tab) => (
            <button
              type="button"
              role="tab"
              data-tab-trigger={tab.id}
              aria-controls={`workspace-panel-${tab.id}`}
              class="group inline-flex cursor-pointer items-center gap-2.5 rounded-full px-3.5 py-2 text-sm font-medium text-gray-900 transition-colors aria-selected:bg-gray-900 aria-selected:text-white"
            >
              <span
                class={`inline-block size-2.5 shrink-0 rounded-full ${dotClass(tab)}`}
                aria-hidden="true"
              ></span>
              <span>{tab.label}</span>
            </button>
          ))}
        </div>

        {/* Active surface label (right) — swaps per tab */}
        <div class="flex flex-col items-start sm:items-end sm:pt-1.5">
          {tabs.map((tab) => (
            <div
              data-surface-label={tab.id}
              class="flex flex-col items-start sm:items-end"
            >
              <p class="text-2xl font-medium leading-7 tracking-[-0.015em] text-gray-900">
                {tab.surfaceTitle}
              </p>
              <p class="text-[13px] leading-4 text-gray-500">
                {tab.surfaceSubtitle}
              </p>
            </div>
          ))}
        </div>
      </div>

      {/* Body — two panes per tab; only the active tab's body is shown */}
      <div class="px-1">
        {tabs.map((tab) => (
          <div
            id={`workspace-panel-${tab.id}`}
            role="tabpanel"
            data-tab-content={tab.id}
            aria-labelledby={`workspace-tab-${tab.id}`}
            class="grid grid-cols-1 gap-4 lg:grid-cols-2"
          >
            {/* Left pane — list */}
            <div class="flex flex-col rounded-md border border-gray-200 bg-white p-2">
              {tab.rows.map((row) =>
                isSelected(row) ? (
                  <div
                    class={`flex items-center gap-3.5 rounded-md border p-4 ${selectedRowClass(tab)}`}
                  >
                    <span
                      class={`inline-block size-[26px] shrink-0 rounded-full ${dotClass(tab)}`}
                      aria-hidden="true"
                    ></span>
                    <div class="flex min-w-0 flex-1 flex-col">
                      <span class="truncate text-[15px] font-medium leading-[18px] text-gray-900">
                        {row.name}
                      </span>
                      <span class="truncate font-mono text-[11px] leading-[14px] text-gray-500">
                        {row.meta}
                      </span>
                    </div>
                    <button
                      type="button"
                      aria-label={`Run ${row.name}`}
                      class="inline-flex size-8 shrink-0 cursor-pointer items-center justify-center rounded-full bg-gray-900 text-white transition-colors hover:bg-gray-800"
                    >
                      <svg
                        viewBox="0 0 12 12"
                        class="size-2.5"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d="M2 1.5v9l8-4.5z" />
                      </svg>
                    </button>
                  </div>
                ) : (
                  <div class="flex items-center gap-3.5 px-4 py-3.5">
                    <span
                      class="inline-block size-[26px] shrink-0 rounded-full bg-gray-700"
                      aria-hidden="true"
                    ></span>
                    <div class="flex min-w-0 flex-1 flex-col">
                      <span class="truncate text-[15px] font-medium leading-[18px] text-gray-900">
                        {row.name}
                      </span>
                      <span class="truncate font-mono text-[11px] leading-[14px] text-gray-500">
                        {row.meta}
                      </span>
                    </div>
                    {row.badge && (
                      <span class="inline-block shrink-0 rounded-full border border-gray-200 bg-gray-50 px-2.5 py-1 font-mono text-[11px] leading-[14px] tracking-[0.04em] text-gray-500">
                        {row.badge}
                      </span>
                    )}
                  </div>
                )
              )}

              {/* List footer */}
              <div class="mt-2 flex items-center justify-between border-t border-gray-200 px-4 pt-3 pb-1.5">
                <span class="text-[13px] font-medium text-gray-900">
                  {tab.listFooter}
                </span>
                <div class="flex items-center gap-1">
                  <button
                    type="button"
                    aria-label="Previous page"
                    class="inline-flex size-8 cursor-pointer items-center justify-center rounded-full text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-900"
                  >
                    <svg viewBox="0 0 16 16" class="size-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M10 12L6 8l4-4" />
                    </svg>
                  </button>
                  <button
                    type="button"
                    aria-label="Next page"
                    class="inline-flex size-8 cursor-pointer items-center justify-center rounded-full text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-900"
                  >
                    <svg viewBox="0 0 16 16" class="size-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M6 4l4 4-4 4" />
                    </svg>
                  </button>
                </div>
              </div>
            </div>

            {/* Right pane — code definition */}
            <div class="flex flex-col gap-4 rounded-md border border-gray-200 bg-white p-6">
              <div class="flex items-center justify-between">
                <span class="text-[13px] text-gray-500">{tab.codeTitle}</span>
                <span class="inline-block rounded-md border border-gray-200 bg-gray-50 px-2.5 py-1 font-mono text-[11px] leading-[14px] text-gray-500">
                  {tab.codeFile}
                </span>
              </div>
              <pre class="m-0 flex-1 overflow-x-auto bg-transparent p-0"><code class="block font-mono text-[13.5px] leading-[22px] text-gray-900">{tab.code}</code></pre>
              <div class="flex items-center justify-between gap-3 border-t border-gray-200 pt-3">
                <span class="font-mono text-[11px] uppercase leading-[14px] tracking-[0.04em] text-gray-500">
                  <span
                    class={`mr-2 inline-block size-1.5 rounded-full align-middle ${tab.id === "zenml" ? "bg-success-500" : "bg-orange-400"}`}
                    aria-hidden="true"
                  ></span>
                  {tab.footerMeta}
                </span>
                <button
                  type="button"
                  class="inline-flex cursor-pointer items-center gap-2 rounded-full bg-gray-900 px-4 py-2 text-[13px] font-medium text-white transition-colors hover:bg-gray-800"
                >
                  <svg viewBox="0 0 12 12" class="size-2.5" fill="currentColor" aria-hidden="true">
                    <path d="M2 1.5v9l8-4.5z" />
                  </svg>
                  {tab.runLabel}
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>

      {/* Feature subtabs — first is the active surface */}
      <div class="flex flex-wrap items-center justify-center gap-6 px-1 pt-2 pb-1">
        {tabs.map((tab) => (
          <div
            data-subtabs={tab.id}
            class="flex flex-wrap items-center justify-center gap-6"
          >
            {tab.subtabs.map((label, idx) =>
              idx === 0 ? (
                <span class="inline-flex items-center gap-2.5 rounded-full bg-gray-900 px-[18px] py-2 text-sm font-medium text-white">
                  <svg viewBox="0 0 14 14" class="size-3.5" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
                    <circle cx="3" cy="3" r="1.5" fill="currentColor" />
                    <circle cx="11" cy="3" r="1.5" fill="currentColor" />
                    <circle cx="3" cy="11" r="1.5" fill="currentColor" />
                    <circle cx="11" cy="11" r="1.5" fill="currentColor" />
                    <line x1="3" y1="3" x2="11" y2="3" />
                    <line x1="3" y1="3" x2="3" y2="11" />
                  </svg>
                  {label}
                </span>
              ) : (
                <span class="px-1 py-2 text-sm font-medium text-gray-500">
                  {label}
                </span>
              )
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Hide inactive tab content + surface label + subtabs row */
  #two-workspaces[data-active-tab="zenml"] [data-tab-content="kitaru"],
  #two-workspaces[data-active-tab="zenml"] [data-surface-label="kitaru"],
  #two-workspaces[data-active-tab="zenml"] [data-subtabs="kitaru"] {
    display: none;
  }

  #two-workspaces[data-active-tab="kitaru"] [data-tab-content="zenml"],
  #two-workspaces[data-active-tab="kitaru"] [data-surface-label="zenml"],
  #two-workspaces[data-active-tab="kitaru"] [data-subtabs="zenml"] {
    display: none;
  }
</style>

<script>
  const root = document.getElementById("two-workspaces");
  if (root) {
    const setActive = (id: string) => {
      root.dataset.activeTab = id;
      root
        .querySelectorAll<HTMLButtonElement>("[data-tab-trigger]")
        .forEach((btn) => {
          btn.setAttribute(
            "aria-selected",
            btn.dataset.tabTrigger === id ? "true" : "false",
          );
        });
    };

    // Initial selected state
    setActive(root.dataset.activeTab || "zenml");

    root
      .querySelectorAll<HTMLButtonElement>("[data-tab-trigger]")
      .forEach((btn) => {
        btn.addEventListener("click", () => {
          const next = btn.dataset.tabTrigger;
          if (next) setActive(next);
        });
      });
  }
</script>
