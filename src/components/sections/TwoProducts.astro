---
/**
 * TwoProducts — unified homepage section introducing ZenML + Kitaru.
 *
 * Three-beat composition: eyebrow + three-sentence headline + two
 * product cards (white fill, gray-200 border, FeatureCard typography).
 * The cards are one data array + one map — Kitaru listed first;
 * reverting the order is swapping two array entries.
 *
 * Brand-rule compliance:
 *   - Section ground is a subtle bottom-up zenml-50 → white gradient.
 *     Brand colors otherwise live only as restrained accent marks
 *     (dots, CTA text). No cross-brand surface mixing.
 *
 * Voice tier: ZenML (with Kitaru permission-granting register inside
 * the Kitaru descriptor copy). Banned terms swept clean — Kitaru side
 * uses sessions / replay / cohorts / evaluators (the replay-based-evals
 * vocabulary), not pipeline / orchestrator.
 */
import SectionIntro from "../system/SectionIntro.astro";

const CARDS = [
  {
    eyebrow: "Kitaru — Agent Evals",
    eyebrowClass: "text-orange-700",
    title: "Turn agent failures into regression tests.",
    body: "Your agent’s real traces become frozen, replayable worlds. Evaluate what happened, replay your real code against it, and keep every fix as a regression test. Self-hosted, framework-agnostic, no lock-in.",
    bullets: [
      "Your production traces are already a test suite: import them from anywhere",
      "Replay them against your next change and see what would have broken",
      "Keep what caught the failure as a permanent regression test",
    ],
    bulletBgClass: "bg-orange-50",
    bulletIconClass: "text-orange-700",
    href: "/product/kitaru",
    linkLabel: "Explore Kitaru",
    linkClass: "text-orange-700 group-hover:text-orange-800",
  },
  {
    eyebrow: "ZenML — ML/AI Orchestration",
    eyebrowClass: "text-zenml-500",
    title: "The open-source platform for production ML systems.",
    body: "Orchestrate workflows across your existing tools, clouds, and environments. Modular, agnostic, no lock-in.",
    bullets: [
      "Pipelines and stacks across any cloud",
      "Model registry, lineage, and reproducibility built in",
      "Open source — your stack, your data, your governance",
    ],
    bulletBgClass: "bg-zenml-50",
    bulletIconClass: "text-zenml-600",
    href: "/features",
    linkLabel: "Explore ZenML",
    linkClass: "text-zenml-500 group-hover:text-zenml-600",
  },
];
---

<section class="scroll-reveal-section border-b border-gray-200 bg-linear-to-t from-zenml-50 to-white py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header: eyebrow + headline -->
    <div class="scroll-slide-top max-w-3xl">
      <SectionIntro
        eyebrow="Two products · one team"
        heading="Agent systems today. ML systems all along. One engineering team underneath both."
        classOverrides={{
          eyebrow: "text-[13px] font-semibold uppercase tracking-[0.08em] text-gray-600",
          heading: "text-3xl font-bold leading-tight tracking-tight text-gray-900",
          headingSpacing: "mt-5",
        }}
      />
    </div>

    <!-- Descriptor row: two product cards -->
    <div class="scroll-fade-in stagger-1 mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
      {CARDS.map((card) => (
        <div class="group flex flex-col rounded-md border border-gray-200 bg-white p-8 transition-colors hover:border-gray-300">
          <SectionIntro
            eyebrow={card.eyebrow}
            heading={card.title}
            headingLevel={3}
            description={card.body}
            classOverrides={{
              eyebrow: `text-sm font-semibold uppercase tracking-wider ${card.eyebrowClass}`,
              heading: "text-2xl font-bold leading-snug text-gray-900",
              headingSpacing: "mt-3",
              description: "text-base leading-relaxed text-gray-600",
              descriptionSpacing: "mt-3",
            }}
          />
          <ul class="mt-6 flex flex-1 flex-col gap-3">
            {card.bullets.map((item) => (
              <li class="flex items-start gap-3">
                <span class:list={["mt-0.5 flex h-[18px] w-[18px] shrink-0 items-center justify-center rounded", card.bulletBgClass]}>
                  <svg class:list={["h-3 w-3", card.bulletIconClass]} viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M2.5 6.25L4.75 8.5L9.5 3.75" stroke="currentColor" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="text-[15px] leading-relaxed text-gray-700">{item}</span>
              </li>
            ))}
          </ul>
          <a
            href={card.href}
            class:list={["mt-7 inline-flex items-center gap-1 self-start text-sm font-semibold transition-colors", card.linkClass]}
          >
            <span>{card.linkLabel}</span>
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 21 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M4.667 10h11.666m0 0L10.5 4.167M16.333 10 10.5 15.833" stroke="currentColor" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  /* Slide-in-from-top for the header */
  .scroll-slide-top {
    opacity: 0;
    transform: translateY(-30px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  /* Fade-in for descriptor row + product frame */
  .scroll-fade-in {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }

  /* Stagger delay — match FeatureTabs / ValueProps / NewsSection convention */
  .stagger-1 { transition-delay: 0.15s; }

  /* Revealed state */
  .scroll-reveal-section.in-view .scroll-slide-top,
  .scroll-reveal-section.in-view .scroll-fade-in {
    opacity: 1;
    transform: none;
  }

  /* Respect reduced-motion preference */
  @media (prefers-reduced-motion: reduce) {
    .scroll-slide-top,
    .scroll-fade-in {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.scroll-reveal-section').forEach((section) => {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          section.classList.add('in-view');
          observer.disconnect();
        }
      },
      { threshold: 0.15 }
    );
    observer.observe(section);
  });
</script>