---
import { Code } from "astro:components";
import zenmlLight from "../../../styles/zenml-light.json";

/**
 * Layout for Pipelines / Flows — the execution-centric subtabs.
 * Left pane = paginated list of recent runs with a play button on the
 * selected row. Right pane = the selected definition's source in Shiki.
 */

type Row = {
  name: string;
  meta: string;
  badge: string | null;
  selected?: boolean;
};

interface Props {
  tabId: "zenml" | "kitaru";
  rows: ReadonlyArray<Row>;
  listFooter: string;
  codeTitle: string;
  codeFile: string;
  code: string;
  footerMeta: string;
}

const { tabId, rows, listFooter, codeTitle, codeFile, code, footerMeta } =
  Astro.props;

const dotClass = tabId === "zenml" ? "bg-zenml-500" : "bg-orange-400";
const selectedRowClass =
  tabId === "zenml"
    ? "border-zenml-300 bg-zenml-50"
    : "border-orange-300 bg-orange-50";
const statusDotClass =
  tabId === "zenml" ? "bg-success-500" : "bg-orange-400";
---

<div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
  {/* Left pane — list */}
  <div class="flex flex-col rounded-md border border-gray-200 bg-white p-1.5">
    {rows.map((row) =>
      row.selected ? (
        <div
          class={`flex items-center gap-3 rounded-md border p-3 ${selectedRowClass}`}
        >
          <span
            class={`inline-block size-5 shrink-0 rounded-full ${dotClass}`}
            aria-hidden="true"
          ></span>
          <div class="flex min-w-0 flex-1 flex-col">
            <span class="truncate text-[15px] font-medium leading-[18px] text-gray-900">
              {row.name}
            </span>
            <span class="truncate font-mono text-[11px] leading-[14px] text-gray-600">
              {row.meta}
            </span>
          </div>
          <button
            type="button"
            aria-label={`Run ${row.name}`}
            class="inline-flex size-9 shrink-0 cursor-pointer items-center justify-center rounded-full bg-gray-900 text-white transition-colors hover:bg-gray-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zenml-500 sm:size-8"
          >
            <svg viewBox="0 0 12 12" class="size-2.5" fill="currentColor" aria-hidden="true">
              <path d="M2 1.5v9l8-4.5z" />
            </svg>
          </button>
        </div>
      ) : (
        <div class="flex items-center gap-3 px-3 py-2.5">
          <span
            class="inline-block size-5 shrink-0 rounded-full bg-gray-400"
            aria-hidden="true"
          ></span>
          <div class="flex min-w-0 flex-1 flex-col">
            <span class="truncate text-[15px] font-medium leading-[18px] text-gray-900">
              {row.name}
            </span>
            <span class="truncate font-mono text-[11px] leading-[14px] text-gray-600">
              {row.meta}
            </span>
          </div>
          {row.badge && (
            <span class="inline-block shrink-0 rounded-full border border-gray-200 bg-gray-50 px-2.5 py-1 font-mono text-[11px] leading-[14px] tracking-[0.04em] text-gray-600">
              {row.badge}
            </span>
          )}
        </div>
      )
    )}

    <div class="mt-1.5 flex items-center justify-between border-t border-gray-200 px-3 pt-2.5 pb-1">
      <span class="text-[13px] font-medium text-gray-900">{listFooter}</span>
      <div class="flex items-center gap-1">
        <button
          type="button"
          aria-label="Previous page"
          class="inline-flex size-9 cursor-pointer items-center justify-center rounded-full text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zenml-500 sm:size-8"
        >
          <svg viewBox="0 0 16 16" class="size-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10 12L6 8l4-4" />
          </svg>
        </button>
        <button
          type="button"
          aria-label="Next page"
          class="inline-flex size-9 cursor-pointer items-center justify-center rounded-full text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zenml-500 sm:size-8"
        >
          <svg viewBox="0 0 16 16" class="size-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 4l4 4-4 4" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  {/* Right pane — code */}
  <div class="flex flex-col gap-3 rounded-md border border-gray-200 bg-white p-4">
    <div class="flex items-center justify-between">
      <span class="text-[13px] text-gray-500">{codeTitle}</span>
      <span class="inline-block rounded-md border border-gray-200 bg-gray-50 px-2.5 py-1 font-mono text-[11px] leading-[14px] text-gray-600">
        {codeFile}
      </span>
    </div>
    <div class="workspace-code min-w-0 flex-1 overflow-x-auto">
      <Code code={code} lang="python" theme={zenmlLight as any} />
    </div>
    <div class="flex items-center gap-3 border-t border-gray-200 pt-2.5">
      <span class="font-mono text-[11px] uppercase leading-[14px] tracking-[0.04em] text-gray-600">
        <span
          class={`mr-2 inline-block size-1.5 rounded-full align-middle ${statusDotClass}`}
          aria-hidden="true"
        ></span>
        {footerMeta}
      </span>
    </div>
  </div>
</div>

<style>
  .workspace-code :global(pre) {
    margin: 0;
    padding: 0;
    background: transparent !important;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.55;
  }
  .workspace-code :global(code) {
    font-family: inherit;
  }
</style>
