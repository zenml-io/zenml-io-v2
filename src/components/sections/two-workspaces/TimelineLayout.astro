---
/**
 * Layout for Stacks / Checkpoints / Replay — vertical step sequences.
 * Stacks reads as a layered composition (orchestrator → store → tracker).
 * Checkpoints and Replay read as an execution trace through a single run.
 *
 * Each step renders a bullet (filled / half / hollow per status), a
 * name + detail, and a small right-aligned meta tag. Steps are connected
 * by a thin vertical guide line.
 */

type Status = "done" | "active" | "pending";

type Step = {
  status: Status;
  name: string;
  detail: string;
  meta: string;
};

interface Props {
  tabId: "zenml" | "kitaru";
  steps: ReadonlyArray<Step>;
  listFooter: string;
  footerMeta: string;
}

const { tabId, steps, listFooter, footerMeta } = Astro.props;

const brandBullet = tabId === "zenml" ? "bg-zenml-500" : "bg-orange-400";
const brandBorder = tabId === "zenml" ? "border-zenml-300" : "border-orange-300";
const brandRing = tabId === "zenml" ? "ring-zenml-200" : "ring-orange-200";
const statusDot = tabId === "zenml" ? "bg-success-500" : "bg-orange-400";

const bulletClass = (status: Status) => {
  if (status === "done") return `${brandBullet} text-white`;
  if (status === "active")
    return `bg-white ${brandBorder} border-2 ring-4 ${brandRing} text-gray-900`;
  return "bg-white border-2 border-gray-300 text-gray-400";
};

const metaTone = (status: Status) => {
  if (status === "done") return "text-gray-600";
  if (status === "active") return "text-gray-900 font-medium";
  return "text-gray-400";
};
---

<div class="flex flex-col gap-3 rounded-md border border-gray-200 bg-white p-4">
  <ol class="relative flex flex-col gap-3">
    {/* Vertical guide line — sits behind the bullets */}
    <span
      class="absolute left-[11px] top-3 bottom-3 w-px bg-gray-200"
      aria-hidden="true"
    ></span>

    {steps.map((step, idx) => (
      <li class="relative flex items-start gap-3">
        <span
          class={`relative z-[1] inline-flex size-[22px] shrink-0 items-center justify-center rounded-full text-[11px] font-semibold leading-none ${bulletClass(step.status)}`}
          aria-hidden="true"
        >
          {step.status === "done" ? "✓" : idx + 1}
        </span>
        <div class="flex min-w-0 flex-1 items-start justify-between gap-3 pt-0.5">
          <div class="flex min-w-0 flex-col gap-0.5">
            <span class="truncate text-[14px] font-medium leading-[18px] text-gray-900">
              {step.name}
            </span>
            <span class="truncate font-mono text-[11px] leading-[14px] text-gray-600">
              {step.detail}
            </span>
          </div>
          <span
            class={`shrink-0 font-mono text-[11px] leading-[14px] tracking-[0.04em] ${metaTone(step.status)}`}
          >
            {step.meta}
          </span>
        </div>
      </li>
    ))}
  </ol>

  <div class="flex items-center justify-between border-t border-gray-200 px-1 pt-2.5">
    <span class="text-[13px] font-medium text-gray-900">{listFooter}</span>
    <span class="font-mono text-[11px] uppercase leading-[14px] tracking-[0.04em] text-gray-600">
      <span
        class={`mr-2 inline-block size-1.5 rounded-full align-middle ${statusDot}`}
        aria-hidden="true"
      ></span>
      {footerMeta}
    </span>
  </div>
</div>
