---
/**
 * Deployments subtab — "One runtime. Your substrate." (artboard 9AH-0).
 * Left: deploy targets list.
 * Right: 3-layer architecture diagram (Inbound → Kitaru runtime band → Substrate w/ pod grid).
 */

type Row = {
  initial: string;
  initialColor: string;
  name: string;
  meta: string;
  statusLabel: "LIVE" | "WARM" | "IDLE";
  selected?: boolean;
};

type Pill = string;

interface Props {
  title: string;
  subheader: string;
  countLabel: string;
  rows: ReadonlyArray<Row>;
  rightEyebrow: string;
  rightSubhead: string;
  inboundLabel: string;
  inboundMeta: string;
  runtimePills: ReadonlyArray<Pill>;
  substrateName: string;
  substrateRegion: string;
  podsActive: number;
  podsTotal: number;
}

const {
  title,
  subheader,
  countLabel,
  rows,
  rightEyebrow,
  rightSubhead,
  inboundLabel,
  inboundMeta,
  runtimePills,
  substrateName,
  substrateRegion,
  podsActive,
  podsTotal,
} = Astro.props;

const statusDot = (s: Row["statusLabel"]) => {
  if (s === "LIVE") return "bg-success-500";
  if (s === "WARM") return "bg-[#fbbf24]";
  return "bg-gray-300";
};

const statusText = (s: Row["statusLabel"]) => {
  if (s === "LIVE") return "text-success-700";
  if (s === "WARM") return "text-stage-fg";
  return "text-gray-500";
};

const pods = Array.from({ length: podsTotal }, (_, i) => i + 1);
---

<div class="grid grid-cols-1 gap-3 lg:grid-cols-[360px_1fr]">
  {/* Left pane */}
  <aside class="flex flex-col gap-2 rounded-md border border-gray-200 bg-white p-3">
    <div class="flex items-start justify-between gap-3 border-b border-gray-100 pb-2">
      <div class="flex flex-col gap-0.5">
        <span class="font-mono text-[11px] uppercase leading-[14px] tracking-[0.08em] text-gray-500">
          {title}
        </span>
        <span class="text-[13px] leading-4 text-gray-500">{subheader}</span>
      </div>
      <span class="font-mono text-[11px] leading-[14px] text-gray-500">{countLabel}</span>
    </div>

    <div class="flex flex-col gap-1">
      {rows.map((row) => (
        <div
          class:list={[
            "flex items-center gap-2.5 rounded-md px-2 py-2",
            row.selected && "border border-orange-200 bg-orange-50",
          ]}
        >
          <span
            class="inline-flex size-7 shrink-0 items-center justify-center rounded-md font-mono text-[13px] font-semibold leading-none text-white"
            style={`background:${row.initialColor}`}
            aria-hidden="true"
          >
            {row.initial}
          </span>
          <div class="flex min-w-0 flex-1 flex-col gap-0.5">
            <span
              class:list={[
                "truncate text-[13px] leading-4",
                row.selected
                  ? "font-semibold text-orange-600"
                  : "font-semibold text-gray-900",
              ]}
            >
              {row.name}
            </span>
            <span class="truncate font-mono text-[11px] leading-[14px] text-gray-500">
              {row.meta}
            </span>
          </div>
          <span class="inline-flex shrink-0 items-center gap-1 font-mono text-[10px] font-semibold leading-3 tracking-wide">
            <span class:list={["inline-block size-1.5 rounded-full", statusDot(row.statusLabel)]} aria-hidden="true"></span>
            <span class={statusText(row.statusLabel)}>{row.statusLabel}</span>
          </span>
        </div>
      ))}
    </div>
  </aside>

  {/* Right pane */}
  <section class="flex flex-col gap-3 rounded-md border border-gray-200 bg-white p-3">
    <div class="flex items-start justify-between gap-3 border-b border-gray-100 pb-2">
      <div class="flex flex-col gap-0.5">
        <span class="font-mono text-[11px] uppercase leading-[14px] tracking-[0.08em] text-gray-500">
          {rightEyebrow}
        </span>
        {rightSubhead && <span class="text-[13px] leading-[18px] text-gray-700">{rightSubhead}</span>}
      </div>
    </div>

    {/* 3-layer arch */}
    <div class="flex flex-col items-stretch gap-0 rounded-md border border-gray-100 bg-cream-canvas p-3">
      {/* Inbound */}
      <div class="flex items-center justify-between rounded-md border border-gray-200 bg-white px-3.5 py-2">
        <span class="font-mono text-[11px] font-semibold uppercase leading-3 tracking-wide text-gray-500">
          {inboundLabel}
        </span>
        <span class="font-mono text-[11px] leading-3 text-gray-400">{inboundMeta}</span>
      </div>

      {/* Connector */}
      <div class="flex justify-center py-1">
        <span class="block h-3.5 w-px bg-orange-200"></span>
      </div>

      {/* Kitaru runtime band */}
      <div class="flex flex-col gap-2 rounded-md bg-orange-400 px-3.5 py-2.5 shadow-[0_1px_2px_rgba(15,15,18,0.04)]">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="inline-flex size-5 items-center justify-center rounded bg-white font-mono text-[10px] font-semibold leading-none text-orange-400">
              K
            </span>
            <span class="text-[13px] font-semibold leading-4 text-white">
              Kitaru durable runtime
            </span>
          </div>
          <span class="font-mono text-[10px] font-semibold uppercase leading-3 tracking-wide text-white/80">
            PORTABLE LAYER
          </span>
        </div>
        <div class="flex flex-wrap gap-1.5">
          {runtimePills.map((pill) => (
            <span class="inline-flex items-center rounded-full bg-white/15 px-2.5 py-1 font-mono text-[11px] font-semibold leading-3 text-white">
              {pill}
            </span>
          ))}
        </div>
      </div>

      {/* Connector */}
      <div class="flex justify-center py-1">
        <span class="block h-3.5 w-px bg-orange-200"></span>
      </div>

      {/* Substrate */}
      <div class="flex flex-col gap-2 rounded-md border border-gray-200 bg-white px-3.5 py-2.5">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="inline-flex size-5 items-center justify-center rounded bg-orange-400 font-mono text-[10px] font-semibold leading-none text-white">
              K
            </span>
            <span class="text-[13px] font-semibold leading-4 text-gray-900">
              {substrateName}
            </span>
            <span class="font-mono text-[11px] leading-3 text-gray-500">· {substrateRegion}</span>
          </div>
          <span class="font-mono text-[10px] font-semibold uppercase leading-3 tracking-wide text-success-700">
            {podsActive} / {podsTotal} PODS
          </span>
        </div>
        <div class="grid grid-cols-8 gap-1">
          {pods.map((n) => (
            <div
              class:list={[
                "flex aspect-square items-center justify-center rounded font-mono text-[10px] font-medium leading-none",
                podsActive >= n
                  ? "border border-orange-400 bg-orange-200 text-orange-600"
                  : "border border-dashed border-gray-300 bg-white text-gray-400",
              ]}
            >
              {n}
            </div>
          ))}
        </div>
      </div>
    </div>

  </section>
</div>
