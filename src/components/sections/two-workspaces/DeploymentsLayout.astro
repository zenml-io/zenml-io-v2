---
import {
  CAPABILITY_PILLS,
  DEPLOYMENTS_LIST,
  type DeploymentStatus,
  ENV_CARDS,
  type EnvCard,
  FOOTER_META,
  RIGHT_HEADER,
} from "../../../lib/two-workspaces/deployments-data";

/**
 * DeploymentsLayout — TwoWorkspaces v2 · Kitaru · artboard A3R-0.
 *
 * Static port of the "v2-Deployments (Kitaru)" artboard. No JS, no
 * interactivity — the left list renders all 5 rows with the pre-selected
 * state baked in (support_agent highlighted).
 *
 * Layout:
 *   Left pane: DEPLOYMENTS list — letter badge, name, version/env subtitle,
 *     status pill. Selected row: orange-50 bg + orange-200 border.
 *   Right pane: DURABLE BY DEFAULT header strip (eyebrow + title + context
 *     chip), capability pill row, 3-env card grid (PROD / CANARY / DEV),
 *     footer meta strip.
 *
 * Takes NO props — all copy lives in deployments-data.ts.
 */

/** Env dot color. */
const envDotColor = (env: EnvCard["env"]) =>
  ({
    PROD: "#F97316", // orange-500 — primary/live
    CANARY: "#FB923C", // orange-400 — in-flight
    DEV: "#B9A98C", // warm-taupe — inactive
  })[env];

/** Pill dot color for the left-list status pill. */
const statusDotColor = (status: DeploymentStatus) =>
  ({
    PROD: "#F97316",
    CANARY: "#FB923C",
    DEV: "#B9A98C",
    "ROLLED BACK": "#A89478",
  })[status];
---

<div class="flex flex-col gap-3">
  <div class="grid grid-cols-1 gap-3 lg:grid-cols-[360px_1fr]">

    {/* ── Left pane: DEPLOYMENTS list ─────────────────────────────── */}
    <aside
      class="flex flex-col rounded-md border border-[#EFE7DA] bg-cream-warm"
      style="padding: 20px 16px;"
    >
      {/* List header */}
      <div
        class="flex items-start justify-between"
        style="border-bottom: 1px solid #F0E8DA; padding-bottom: 8px; padding-left: 4px; padding-right: 4px; margin-bottom: 14px;"
      >
        <div class="flex flex-col" style="gap: 3px;">
          <span
            class="font-sans uppercase"
            style="font-size: 10px; font-weight: 600; letter-spacing: 0.08em; line-height: 12px; color: #7A6B57; font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
          >
            DEPLOYMENTS
          </span>
          <span
            class="font-mono"
            style="font-size: 10px; line-height: 12px; color: #8C7E68;"
          >
            5 flows · 3 envs
          </span>
        </div>
        <span
          class="font-mono"
          style="font-size: 10px; line-height: 12px; color: #8C7E68;"
        >
          5 total
        </span>
      </div>

      {/* Deployment rows */}
      <div class="flex flex-col" style="gap: 8px;">
        {DEPLOYMENTS_LIST.map((dep) => (
          <div
            class:list={[
              "depl-row flex items-center",
              dep.selected ? "depl-row--selected" : "",
            ]}
            style="gap: 12px; border-radius: 8px; padding: 12px; border: 1px solid transparent;"
          >
            {/* Letter badge */}
            <span
              class:list={["depl-badge inline-flex shrink-0 items-center justify-center font-sans font-bold"]}
              aria-hidden="true"
              style={`width: 32px; height: 32px; border-radius: 8px; font-size: 14px; line-height: 14px; color: #FFFFFF; background-color: ${dep.selected ? "#FB923C" : "#1F1B14"}; font-family: 'Plus Jakarta Sans', system-ui, sans-serif;`}
            >
              {dep.letter}
            </span>

            {/* Name + subtitle */}
            <div class="flex min-w-0 flex-1 flex-col" style="gap: 3px;">
              <span
                class="font-mono truncate"
                style={`font-size: 13px; font-weight: ${dep.selected ? 600 : 500}; line-height: 14px; color: #1F1B14;`}
              >
                {dep.name}
              </span>
              <span
                class="font-mono truncate"
                style="font-size: 10px; font-weight: 400; line-height: 12px; color: #8C7E68;"
              >
                {dep.subtitle}
              </span>
            </div>

            {/* Status pill */}
            <span
              class="inline-flex shrink-0 items-center"
              style={`gap: 5px; border-radius: 999px; border: 1px solid ${dep.selected ? "#FED7AA" : "#EFE7DA"}; background-color: ${dep.selected ? "#FFF4E6" : "#FFFFFF"}; padding: 3px 8px;`}
            >
              <span
                aria-hidden="true"
                style={`width: 5px; height: 5px; border-radius: 999px; flex-shrink: 0; background-color: ${statusDotColor(dep.status)};`}
              ></span>
              <span
                class="font-mono"
                style={`font-size: 9px; font-weight: 500; letter-spacing: 0.06em; line-height: 12px; color: ${dep.selected ? "#C2410C" : "#7A6B57"};`}
              >
                {dep.status}
              </span>
            </span>
          </div>
        ))}
      </div>
    </aside>

    {/* ── Right pane: DURABLE BY DEFAULT ──────────────────────────── */}
    <section
      class="flex flex-col rounded-md border border-[#EFE7DA] bg-cream-warm"
      style="padding: 20px 22px; gap: 18px;"
    >
      {/* Header: eyebrow + title + context chip */}
      <div class="flex items-start justify-between" style="gap: 24px;">
        <div class="flex min-w-0 flex-1 flex-col" style="gap: 5px;">
          <span
            class="font-sans uppercase"
            style="font-size: 10px; font-weight: 600; letter-spacing: 0.08em; line-height: 12px; color: #C2410C; font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
          >
            {RIGHT_HEADER.eyebrow}
          </span>
          <span
            class="font-sans"
            style="font-size: 17px; font-weight: 600; letter-spacing: -0.005em; line-height: 22px; color: #1F1B14; font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
          >
            {RIGHT_HEADER.title}
          </span>
        </div>
        {/* Context chip */}
        <span
          class="inline-flex shrink-0 items-center"
          style="gap: 6px; border-radius: 999px; border: 1px solid #FFD08A; background-color: #FFF4E6; padding: 4px 10px;"
        >
          <span
            aria-hidden="true"
            style="width: 5px; height: 5px; border-radius: 999px; flex-shrink: 0; background-color: #F97316;"
          ></span>
          <span
            class="font-mono"
            style="font-size: 10px; font-weight: 500; line-height: 12px; color: #C2410C;"
          >
            {RIGHT_HEADER.contextChip}
          </span>
        </span>
      </div>

      {/* Capability pills */}
      <div class="flex flex-wrap items-center" style="gap: 8px;">
        {CAPABILITY_PILLS.map((pill) => (
          <span
            class="inline-flex items-center"
            style="gap: 8px; border-radius: 999px; border: 1px solid #FFD08A; background-color: #FFF4E6; padding: 7px 12px;"
          >
            <span
              aria-hidden="true"
              style="width: 6px; height: 6px; border-radius: 999px; flex-shrink: 0; background-color: #F97316;"
            ></span>
            <span
              class="font-sans"
              style="font-size: 12px; font-weight: 600; line-height: 14px; color: #C2410C; white-space: nowrap; font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
            >
              {pill}
            </span>
          </span>
        ))}
      </div>

      {/* ── Versioned deployment lifecycle (item 9) ─────────────────── */}
      {/* v1 → v2 → v3 (rolled back) → v4 (current). Each bubble is a
          version node connected by a horizontal track line. v3 shows a
          red-tinted "ROLLED BACK" pill; v4 is the active orange node.
          Layout: two rows — labels row (fixed 25px height so connectors
          align) then bubbles row — keeps connectors pixel-perfect. */}
      <div
        class="flex flex-col"
        style="border-radius: 8px; border: 1px solid #EFE7DA; background-color: #FFFFFF; padding: 14px 16px; gap: 10px;"
      >
        <span
          class="font-sans uppercase"
          style="font-size: 9px; font-weight: 600; letter-spacing: 0.1em; line-height: 12px; color: #9C8060; font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
        >
          VERSION HISTORY
        </span>
        {/* Labels row — fixed 25px so all columns are the same height */}
        <div class="flex" style="gap: 0;">
          <div class="flex flex-col items-center" style="flex:1; height:25px; justify-content:flex-end; padding-bottom:0;">
            <span class="font-mono" style="font-size:9px; font-weight:500; line-height:12px; color:#B9A98C;">v1</span>
          </div>
          <div style="flex:1;"></div>
          <div class="flex flex-col items-center" style="flex:1; height:25px; justify-content:flex-end;">
            <span class="font-mono" style="font-size:9px; font-weight:500; line-height:12px; color:#B9A98C;">v2</span>
          </div>
          <div style="flex:1;"></div>
          <div class="flex flex-col items-center" style="flex:1; height:25px; justify-content:flex-end; gap:2px;">
            <span class="font-mono" style="font-size:9px; font-weight:500; line-height:12px; color:#DC2626;">v3</span>
            <span class="font-mono uppercase" style="font-size:7px; font-weight:600; letter-spacing:0.04em; line-height:10px; color:#DC2626; white-space:nowrap;">rolled back</span>
          </div>
          <div style="flex:1;"></div>
          <div class="flex flex-col items-center" style="flex:1; height:25px; justify-content:flex-end;">
            <span class="font-mono" style="font-size:9px; font-weight:700; line-height:12px; color:#C2410C;">v4</span>
          </div>
        </div>
        {/* Bubbles + connector row — items-center aligns connectors with bubble midpoints */}
        <div class="flex items-center" style="gap: 0;">
          {/* v1 */}
          <span
            style="width:28px; height:28px; border-radius:999px; background-color:#F5EFE6; border:1.5px solid #E8DBC8; display:flex; align-items:center; justify-content:center; flex-shrink:0;"
          >
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2 6.5L4.5 9L10 3" stroke="#9C8060" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <div style="flex:1; height:1.5px; background-color:#E8DBC8;"></div>
          {/* v2 */}
          <span
            style="width:28px; height:28px; border-radius:999px; background-color:#F5EFE6; border:1.5px solid #E8DBC8; display:flex; align-items:center; justify-content:center; flex-shrink:0;"
          >
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2 6.5L4.5 9L10 3" stroke="#9C8060" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <div style="flex:1; height:1.5px; background-color:#FECACA;"></div>
          {/* v3 — rolled back */}
          <span
            style="width:28px; height:28px; border-radius:999px; background-color:#FEF2F2; border:1.5px solid #FECACA; display:flex; align-items:center; justify-content:center; flex-shrink:0;"
          >
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M3 3L9 9M9 3L3 9" stroke="#DC2626" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
          </span>
          <div style="flex:1; height:1.5px; background-color:#FB923C;"></div>
          {/* v4 — current */}
          <span
            style="width:28px; height:28px; border-radius:999px; background-color:#FB923C; border:1.5px solid #EA580C; display:flex; align-items:center; justify-content:center; flex-shrink:0; box-shadow:0 0 0 3px rgba(251,146,60,0.18);"
          >
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2 6.5L4.5 9L10 3" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </div>
      </div>

      {/* 3-env card grid */}
      <div class="grid" style="grid-template-columns: repeat(3, 1fr); gap: 14px;">
        {ENV_CARDS.map((card) => (
          <div
            class="flex flex-col"
            style={`border-radius: 8px; border: 1px solid ${card.env === "PROD" ? "#FFD7B5" : "#EFE7DA"}; background-color: ${card.env === "PROD" ? "#FFF4E6" : "#FFFFFF"}; padding: 16px 16px 14px; gap: 12px;`}
          >
            {/* Env header: dot + label + traffic % */}
            <div class="flex items-center justify-between" style="gap: 8px;">
              <div class="flex items-center" style="gap: 6px;">
                <span
                  aria-hidden="true"
                  style={`width: 6px; height: 6px; border-radius: 999px; flex-shrink: 0; background-color: ${envDotColor(card.env)};`}
                ></span>
                <span
                  class="font-sans uppercase"
                  style="font-size: 10px; font-weight: 600; letter-spacing: 0.08em; line-height: 12px; color: #1F1B14; font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
                >
                  {card.env}
                </span>
              </div>
              <span
                class="font-mono"
                style={`font-size: 10px; line-height: 12px; color: ${card.env === "PROD" ? "#9C7B5A" : "#8C7E68"};`}
              >
                {card.trafficLabel}
              </span>
            </div>

            {/* Version + deployer */}
            <div class="flex flex-col" style="gap: 4px;">
              <span
                class="font-mono"
                style="font-size: 18px; font-weight: 600; letter-spacing: -0.01em; line-height: 20px; color: #1F1B14;"
              >
                {card.version}
              </span>
              <span
                class="font-mono"
                style="font-size: 10px; line-height: 14px; color: #8C7E68;"
              >
                {card.deployerMeta}
              </span>
            </div>

            {/* Action button */}
            {card.action.variant === "primary" ? (
              <button
                type="button"
                class="depl-action-btn depl-action-btn--primary flex cursor-pointer items-center justify-center"
                style="gap: 6px; border-radius: 6px; border: 1px solid #F97316; background-color: #FB923C; padding: 7px 10px;"
              >
                {/* Up arrow icon */}
                <svg width="11" height="11" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="flex-shrink: 0;">
                  <path d="M6 9.5V2.5M6 2.5L3 5.5M6 2.5L9 5.5" stroke="#FFFFFF" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span
                  class="font-sans"
                  style="font-size: 11px; font-weight: 600; line-height: 12px; color: #FFFFFF; font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
                >
                  {card.action.label}
                </span>
              </button>
            ) : card.action.icon === "rollback" ? (
              <button
                type="button"
                class="depl-action-btn flex cursor-pointer items-center justify-center"
                style="gap: 6px; border-radius: 6px; border: 1px solid #FFD08A; background-color: #FFFFFF; padding: 7px 10px;"
              >
                {/* Rollback / undo arrow icon */}
                <svg width="11" height="11" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="flex-shrink: 0;">
                  <path d="M4.5 2.5L2 5L4.5 7.5M2 5H7.5C8.88 5 10 6.12 10 7.5C10 8.88 8.88 10 7.5 10H5.5" stroke="#C2410C" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span
                  class="font-sans"
                  style="font-size: 11px; font-weight: 600; line-height: 12px; color: #C2410C; font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
                >
                  {card.action.label}
                </span>
              </button>
            ) : (
              <button
                type="button"
                class="depl-action-btn flex cursor-pointer items-center justify-center"
                style="gap: 6px; border-radius: 6px; border: 1px solid #E5D9C5; background-color: #FFFFFF; padding: 7px 10px;"
              >
                {/* Shadow / two-circles icon */}
                <svg width="11" height="11" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="flex-shrink: 0;">
                  <circle cx="4.5" cy="6" r="2.5" stroke="#5A4F3F" stroke-width="1.2" />
                  <circle cx="7.5" cy="6" r="2.5" stroke="#5A4F3F" stroke-width="1.2" />
                </svg>
                <span
                  class="font-sans"
                  style="font-size: 11px; font-weight: 600; line-height: 12px; color: #5A4F3F; font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
                >
                  {card.action.label}
                </span>
              </button>
            )}

            {/* History */}
            <div
              class="flex flex-col"
              style={`border-top: 1px solid ${card.env === "PROD" ? "#FFD7B5" : "#F0E8DA"}; padding-top: 8px; gap: 5px;`}
            >
              <span
                class="font-sans uppercase"
                style="font-size: 9px; font-weight: 600; letter-spacing: 0.08em; line-height: 12px; color: #9C7B5A; font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
              >
                HISTORY
              </span>
              {card.history.map((entry) => (
                <div class="flex items-center" style="gap: 6px;">
                  <span
                    class="font-mono"
                    style="font-size: 10px; font-weight: 500; line-height: 12px; color: #5A4F3F;"
                  >
                    {entry.version}
                  </span>
                  <span
                    class="font-mono"
                    style="font-size: 10px; line-height: 12px; color: #9C7B5A;"
                  >
                    · {entry.age}
                  </span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      {/* Footer meta strip */}
      <div
        class="flex items-center justify-between"
        style="border-top: 1px solid #F0E8DA; padding-top: 14px; margin-top: auto;"
      >
        <span
          class="font-mono"
          style="font-size: 10px; line-height: 12px; color: #8C7E68;"
        >
          {FOOTER_META.left}
        </span>
        <span class="inline-flex items-center" style="gap: 6px;">
          <span
            aria-hidden="true"
            style="width: 6px; height: 6px; border-radius: 999px; flex-shrink: 0; background-color: #F97316;"
          ></span>
          <span
            class="font-mono"
            style="font-size: 10px; font-weight: 500; letter-spacing: 0.04em; line-height: 12px; color: #C2410C;"
          >
            {FOOTER_META.rightLabel}
          </span>
        </span>
      </div>
    </section>

  </div>
</div>

<style>
  /* Selected deployment row */
  .depl-row--selected {
    background-color: #fff4ec; /* orange-50 */
    border-color: #ffd7b5 !important; /* orange-200 */
  }

  /* Action buttons — hover state (no JS required). */
  .depl-action-btn:hover {
    opacity: 0.88;
  }
  .depl-action-btn--primary:hover {
    background-color: #ea580c; /* orange-600 */
    border-color: #ea580c;
    opacity: 1;
  }
</style>
