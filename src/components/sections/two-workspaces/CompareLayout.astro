---
/**
 * CompareLayout — TwoWorkspaces v2 · Kitaru · the flagship subtab.
 *
 * Left pane: clickable RUNS list (3 runs over one immutable cohort).
 *   Each row: run-number badge, run label, mono experiment·version
 *   descriptor, status pill (CANDIDATE / BASELINE). The cohort every run
 *   was made over is pinned as a chip at the foot of the list.
 *   Selected row: cream-orange fill + orange border + badge fill orange-400.
 *   Non-selected: transparent border, white-bordered badge, ink letter.
 *
 * Right pane: RUN VS RUN panel — kept lean. Three blocks:
 *   - Header strip: eyebrow (orange-600) + headline + evaluator chip.
 *   - 2-col metric panel (BASELINE left / CANDIDATE right with delta badges).
 *   - Human-judgment strip: the count of sessions Kitaru opened, and a
 *     button to read them. Never a verdict — Kitaru does not rule on the
 *     remainder, it hands it to you.
 *
 * Interactive: clicking a run row sets `data-active-example` on the
 * layout root; CSS attribute selectors reveal the matching right panel and
 * selected-row chrome. All 3 runs are server-rendered + stacked.
 * A small scoped vanilla script wires clicks. No Preact island.
 *
 * Tokens:
 *   bg-cream-warm #FAF8F4, border #EAE5DC
 *   orange-50 #FFF4EC, orange-200 #FFD7B5, orange-400 #FB923C
 *   orange-600 #EA580C, orange-700 #C2410C
 *   ink #1F1A14, warm-taupe #8B7E6E, warm-taupe-mid #52473A
 */

import {
  COMPARE_COHORT,
  COMPARE_EXAMPLES,
  DEFAULT_COMPARE_EXAMPLE_ID,
  type DeltaTone,
} from "../../../lib/two-workspaces/compare-examples";

const defaultId = DEFAULT_COMPARE_EXAMPLE_ID;

/**
 * Delta badge appearance. "gain" is the warm orange badge; "watch" is the
 * quiet neutral badge — a count to go and read, not a failure. No red
 * anywhere: a red badge would be a verdict.
 */
const deltaBadgeStyle = (tone: DeltaTone | undefined) =>
  tone === "watch"
    ? "background-color: #F1ECE2; color: #52473A;"
    : "background-color: #FFF4EC; color: #C2410C;";
---

<div
  class="compare-layout flex flex-col gap-3"
  data-active-example={defaultId}
>
  <div class="grid grid-cols-1 gap-3 lg:grid-cols-[304px_1fr]">

    {/* --------------------------------------------------------- */}
    {/* LEFT PANE — RUNS list                                     */}
    {/* --------------------------------------------------------- */}
    <aside
      class="flex flex-col rounded-md border bg-cream-warm p-4"
      style="border-color: #EAE5DC;"
    >
      {/* Header */}
      <div class="flex items-start justify-between gap-2 pb-3" style="border-bottom: 1px solid #EAE5DC; margin-bottom: 12px;">
        <div class="flex flex-col gap-1">
          <span
            class="font-sans text-[11px] font-semibold uppercase leading-[14px] tracking-[0.08em]"
            style="color: #8B7E6E; font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
          >
            RUNS
          </span>
          <span
            class="text-xs font-medium leading-4"
            style="color: #52473A; font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
          >
            2 candidates · 1 baseline
          </span>
        </div>
        <span
          class="text-xs font-medium leading-4"
          style="color: #8B7E6E; font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
        >
          3 total
        </span>
      </div>

      {/* Run rows */}
      <div class="flex flex-col gap-1">
        {COMPARE_EXAMPLES.map((ex) => (
          <button
            type="button"
            data-compare-row={ex.run.id}
            aria-pressed={ex.run.id === defaultId ? "true" : "false"}
            class="compare-row flex w-full cursor-pointer items-center gap-3 text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500"
          >
            {/* Run-number badge */}
            <span
              class="compare-badge inline-flex size-9 shrink-0 items-center justify-center rounded-md"
              aria-hidden="true"
            >
              <span
                class="compare-badge-letter font-sans text-[15px] font-bold leading-[18px]"
                style="font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
              >
                {ex.run.rowLetter}
              </span>
            </span>

            {/* Label + descriptor */}
            <div class="flex min-w-0 flex-1 flex-col gap-0.5">
              <span
                class="compare-row-name truncate font-sans text-[14px] leading-[18px]"
                style="font-family: 'Plus Jakarta Sans', system-ui, sans-serif; color: #1F1A14;"
              >
                {ex.run.versionLabel}
              </span>
              <span
                class="truncate font-mono text-[10px] font-medium leading-3"
                style="color: #8B7E6E; font-family: 'JetBrains Mono', monospace;"
              >
                {ex.run.descriptor}
              </span>
            </div>

            {/* CANDIDATE pill — neutral border, no bg */}
            {ex.run.statusPill.label === "CANDIDATE" && (
              <span
                class="inline-flex shrink-0 rounded-full px-2.5 py-1"
                style="border: 1px solid #EAE5DC;"
              >
                <span
                  class="font-mono text-[10px] font-semibold leading-3 tracking-[0.04em]"
                  style="color: #8B7E6E; font-family: 'JetBrains Mono', monospace;"
                >
                  CANDIDATE
                </span>
              </span>
            )}

            {/* BASELINE pill — warm fill */}
            {ex.run.statusPill.label === "BASELINE" && (
              <span
                class="inline-flex shrink-0 rounded-full px-2.5 py-1"
                style="background-color: #F1ECE2; border: 1px solid #EAE5DC;"
              >
                <span
                  class="font-mono text-[10px] font-semibold leading-3 tracking-[0.04em]"
                  style="color: #52473A; font-family: 'JetBrains Mono', monospace;"
                >
                  BASELINE
                </span>
              </span>
            )}
          </button>
        ))}
      </div>

      {/* Cohort block — the one immutable set every run above was made over.
          Two lines rather than a pill: the full string wraps awkwardly at
          this column width. */}
      <div class="mt-auto pt-3" style="border-top: 1px solid #EAE5DC; margin-top: 12px;">
        <div
          class="flex items-start gap-2 rounded-md px-3 py-2"
          style="background-color: #FFF4EC; border: 1px solid #FFD7B5;"
        >
          <span
            class="mt-1 size-1.5 shrink-0 rounded-full"
            style="background-color: #EA580C;"
            aria-hidden="true"
          ></span>
          <div class="flex min-w-0 flex-col gap-0.5">
            <span
              class="truncate font-mono text-[11px] font-semibold leading-4"
              style="color: #C2410C; font-family: 'JetBrains Mono', monospace;"
            >
              {COMPARE_COHORT.name}
            </span>
            <span
              class="font-mono text-[9px] font-medium leading-3"
              style="color: #8B7E6E; font-family: 'JetBrains Mono', monospace;"
            >
              {COMPARE_COHORT.detail}
            </span>
          </div>
        </div>
      </div>
    </aside>

    {/* --------------------------------------------------------- */}
    {/* RIGHT PANE — all 3 comparison panels stacked;            */}
    {/* CSS reveals only the active one.                         */}
    {/* --------------------------------------------------------- */}
    <section
      class="flex flex-col rounded-md border bg-cream-warm p-[22px] gap-[18px]"
      style="border-color: #EAE5DC;"
    >
      {COMPARE_EXAMPLES.map((ex) => (
        <div
          data-compare-pane={ex.run.id}
          class="compare-pane flex flex-col gap-[18px]"
        >
          {/* ---- Header strip ---- */}
          <div class="flex items-start justify-between gap-4">
            <div class="flex flex-col gap-1.5 min-w-0">
              <span
                class="font-sans text-[11px] font-semibold uppercase leading-[14px] tracking-[0.1em]"
                style="color: #EA580C; font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
              >
                {ex.comparison.eyebrow}
              </span>
              <span
                class="font-sans text-base font-semibold leading-[22px]"
                style="color: #1F1A14; font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
              >
                {ex.comparison.headline}
              </span>
            </div>
            <span
              class="inline-flex shrink-0 items-center gap-2 rounded-full bg-white px-3 py-1.5"
              style="border: 1px solid #EAE5DC;"
            >
              <span
                class="size-1.5 shrink-0 rounded-full"
                style="background-color: #EA580C;"
                aria-hidden="true"
              ></span>
              <span
                class="font-mono text-[11px] font-medium leading-[14px]"
                style="color: #52473A; font-family: 'JetBrains Mono', monospace;"
              >
                {ex.comparison.contextChip}
              </span>
            </span>
          </div>

          {/* ---- 2-col metric panel ---- */}
          <div
            class="flex overflow-hidden rounded-md"
            style="border: 1px solid #EAE5DC; background-color: #FFFFFF;"
          >
            {/* Baseline half */}
            <div
              class="flex flex-1 flex-col gap-2.5 px-4 py-3.5 min-w-0"
              style="border-right: 1px solid #EAE5DC;"
            >
              <div class="flex flex-col gap-1">
                <span
                  class="font-mono text-[10px] font-semibold leading-3 tracking-[0.08em] uppercase"
                  style="color: #8B7E6E; font-family: 'JetBrains Mono', monospace;"
                >
                  {ex.comparison.baselineLabel}
                </span>
                <span
                  class="font-mono text-[12px] font-medium leading-4"
                  style="color: #1F1A14; font-family: 'JetBrains Mono', monospace;"
                >
                  {ex.comparison.baselineName}
                </span>
              </div>
              <div class="flex gap-3.5 min-w-0 flex-wrap">
                {ex.comparison.metrics.map((m) => (
                  <div class="flex flex-1 flex-col gap-0.5" style="min-width: 0;">
                    <span
                      class="font-sans text-[10px] font-medium leading-3 uppercase tracking-[0.06em]"
                      style="color: #8B7E6E; font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
                    >
                      {m.label}
                    </span>
                    <span
                      class="font-mono text-[14px] font-medium leading-[18px] tabular-nums"
                      style="color: #1F1A14; font-family: 'JetBrains Mono', monospace;"
                    >
                      {m.baseline}
                    </span>
                  </div>
                ))}
              </div>
            </div>

            {/* Candidate half — warm tint bg */}
            <div
              class="flex flex-1 flex-col gap-2.5 px-4 py-3.5 min-w-0"
              style="background-color: #FFF9F2;"
            >
              <div class="flex flex-col gap-1">
                <span
                  class="font-mono text-[10px] font-semibold leading-3 tracking-[0.08em] uppercase"
                  style="color: #C2410C; font-family: 'JetBrains Mono', monospace;"
                >
                  {ex.comparison.candidateLabel}
                </span>
                <span
                  class="font-mono text-[12px] font-medium leading-4"
                  style="color: #1F1A14; font-family: 'JetBrains Mono', monospace;"
                >
                  {ex.comparison.candidateName}
                </span>
              </div>
              <div class="flex gap-3.5 min-w-0 flex-wrap">
                {ex.comparison.metrics.map((m) => (
                  <div class="flex flex-1 flex-col gap-0.5" style="min-width: 0;">
                    <span
                      class="font-sans text-[10px] font-medium leading-3 uppercase tracking-[0.06em]"
                      style="color: #8B7E6E; font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
                    >
                      {m.label}
                    </span>
                    <div class="flex flex-col gap-0.5">
                      <span
                        class="font-mono text-[14px] font-medium leading-[18px] tabular-nums"
                        style="color: #1F1A14; font-family: 'JetBrains Mono', monospace;"
                      >
                        {m.candidate}
                      </span>
                      {m.delta === null ? (
                        <span
                          class="font-mono text-[9px] font-medium leading-3"
                          style="color: #8B7E6E; font-family: 'JetBrains Mono', monospace;"
                        >
                          {m.deltaQualifier ?? "same"}
                        </span>
                      ) : (
                        <span
                          class="inline-block self-start rounded px-1.5 py-px font-mono text-[10px] font-semibold leading-3"
                          style={deltaBadgeStyle(m.deltaTone)}
                        >
                          {m.delta}
                        </span>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>

          {/* ---- Human-judgment strip ----
              Replaces the old verdict band. Kitaru states the count and
              opens the sessions; whether that count is shippable is not
              its call. */}
          <div
            class="flex items-center justify-between gap-4 rounded-md px-[18px] py-3.5"
            style="background-color: #FFF4EC; border: 1px solid #FFD7B5;"
          >
            <div class="flex flex-1 flex-col gap-1 min-w-0">
              <span
                class="font-sans text-base font-semibold leading-5"
                style="color: #1F1A14; font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
              >
                {ex.comparison.readHeadline}
              </span>
              <span
                class="font-sans text-[12px] font-medium leading-4"
                style="color: #52473A; font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
              >
                {ex.comparison.readSubline}
              </span>
            </div>
            <button
              type="button"
              class="inline-flex shrink-0 cursor-pointer items-center gap-1.5 rounded-md px-3.5 py-2.5 font-sans text-[12px] font-semibold leading-4 transition-colors hover:bg-orange-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500"
              style="background-color: #FFF4EC; border: 1px solid #FB923C; color: #C2410C; font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
            >
              {ex.comparison.readButtonLabel}
              <span aria-hidden="true">→</span>
            </button>
          </div>
        </div>
      ))}
    </section>
  </div>
</div>

<style>
  /* ------------------------------------------------------------------ */
  /* SELECTED-ROW SPEC                                                    */
  /*                                                                      */
  /* Every row carries a transparent 1px border at rest — no layout      */
  /* shift when a border is added on selection.                           */
  /* ------------------------------------------------------------------ */
  .compare-row {
    border-radius: 8px;
    padding: 12px;
    background-color: transparent;
    border: 1px solid transparent;
    cursor: pointer;
  }
  .compare-row:hover {
    background-color: rgba(255, 244, 236, 0.5);
  }
  .compare-row[aria-pressed="true"] {
    background-color: #fff4ec; /* --kitaru-selected-row-bg / orange-50 */
    border-color: #ffd7b5;     /* --kitaru-selected-row-border */
    /* Compensate for the 1px border added — avoid layout shift */
    padding: 11px 11px 11px 11px;
  }
  /* Row label: semibold when selected */
  .compare-row[aria-pressed="true"] .compare-row-name {
    font-weight: 600;
  }
  .compare-row .compare-row-name {
    font-weight: 500;
  }

  /* Badge — orange-400 fill on selected, white+border on idle */
  .compare-badge {
    background-color: #ffffff;
    border: 1px solid #eae5dc;
  }
  .compare-badge .compare-badge-letter {
    color: #52473a;
  }
  .compare-row[aria-pressed="true"] .compare-badge {
    background-color: #fb923c; /* orange-400 */
    border-color: #fb923c;
  }
  .compare-row[aria-pressed="true"] .compare-badge .compare-badge-letter {
    color: #ffffff;
  }

  /* ------------------------------------------------------------------ */
  /* RIGHT-PANE GRID STACK                                               */
  /* All 3 panels are rendered; only the active one is displayed.        */
  /* ------------------------------------------------------------------ */
  .compare-pane {
    display: none;
  }
  .compare-layout[data-active-example="run_3_pr_311"]      [data-compare-pane="run_3_pr_311"],
  .compare-layout[data-active-example="run_2_v1"]          [data-compare-pane="run_2_v1"],
  .compare-layout[data-active-example="run_1_cheap_model"] [data-compare-pane="run_1_cheap_model"] {
    display: flex;
  }
</style>

<script>
  /**
   * Wire row clicks → swap the active run on the CompareLayout root.
   * Scoped to the closest [data-active-example] ancestor so multiple
   * instances don't cross-talk (defensive — only one in TwoWorkspaces today).
   */
  const applyCompareExample = (root: HTMLElement, id: string) => {
    root.dataset.activeExample = id;
    root
      .querySelectorAll<HTMLButtonElement>("[data-compare-row]")
      .forEach((row) => {
        row.setAttribute(
          "aria-pressed",
          row.dataset.compareRow === id ? "true" : "false",
        );
      });
  };

  document
    .querySelectorAll<HTMLButtonElement>("[data-compare-row]")
    .forEach((btn) => {
      btn.addEventListener("click", () => {
        const root = btn.closest<HTMLElement>("[data-active-example]");
        const id = btn.dataset.compareRow;
        if (root && id) applyCompareExample(root, id);
      });
    });
</script>
