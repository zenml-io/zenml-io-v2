---
/**
 * Layout for Artifacts / Models / Integrations / Deployments — discovery
 * surfaces where individual items deserve equal visual weight. 5 cards in a
 * responsive grid (3-up desktop, 2-up tablet, 1-up mobile). Selected card
 * gets the tab's brand tint; others stay neutral. Per-card `glyph` is a
 * single character drawn in a square tile (acts as a logomark proxy).
 */

type GlyphTone = "brand" | "neutral" | "success" | "warning" | "muted";

type Card = {
  glyph: string;
  glyphTone: GlyphTone;
  tag: string;
  name: string;
  meta: string;
  selected?: boolean;
};

interface Props {
  tabId: "zenml" | "kitaru";
  cards: ReadonlyArray<Card>;
  listFooter: string;
  footerMeta: string;
}

const { tabId, cards, listFooter, footerMeta } = Astro.props;

const brandTile = tabId === "zenml" ? "bg-zenml-500 text-white" : "bg-orange-400 text-white";
const brandBorder = tabId === "zenml" ? "border-zenml-300" : "border-orange-300";
const brandBg = tabId === "zenml" ? "bg-zenml-50" : "bg-orange-50";
const statusDot = tabId === "zenml" ? "bg-success-500" : "bg-orange-400";

const toneTile = (tone: GlyphTone) => {
  if (tone === "brand") return brandTile;
  if (tone === "success") return "bg-success-500 text-white";
  if (tone === "warning") return "bg-warning-500 text-white";
  if (tone === "muted") return "bg-gray-200 text-gray-600";
  return "bg-gray-900 text-white";
};
---

<div class="flex flex-col gap-3 rounded-md border border-gray-200 bg-white p-3">
  <div class="grid grid-cols-1 gap-2.5 sm:grid-cols-2 lg:grid-cols-3">
    {cards.map((card) => (
      <article
        class={`flex flex-col gap-2.5 rounded-md border p-3 transition-colors ${
          card.selected
            ? `${brandBorder} ${brandBg}`
            : "border-gray-200 bg-white hover:border-gray-300"
        }`}
      >
        <div class="flex items-start justify-between gap-2">
          <span
            class={`inline-flex size-8 shrink-0 items-center justify-center rounded-md text-[13px] font-semibold leading-none ${toneTile(card.glyphTone)}`}
            aria-hidden="true"
          >
            {card.glyph}
          </span>
          <span class="inline-block rounded-full border border-gray-200 bg-gray-50 px-2 py-0.5 font-mono text-[10px] uppercase leading-[14px] tracking-[0.06em] text-gray-600">
            {card.tag}
          </span>
        </div>
        <div class="flex flex-col gap-0.5">
          <span class="truncate text-[14px] font-medium leading-[18px] text-gray-900">
            {card.name}
          </span>
          <span class="truncate font-mono text-[11px] leading-[14px] text-gray-600">
            {card.meta}
          </span>
        </div>
      </article>
    ))}
  </div>

  <div class="flex items-center justify-between border-t border-gray-200 px-1 pt-2.5">
    <span class="text-[13px] font-medium text-gray-900">{listFooter}</span>
    <span class="font-mono text-[11px] uppercase leading-[14px] tracking-[0.04em] text-gray-600">
      <span
        class={`mr-2 inline-block size-1.5 rounded-full align-middle ${statusDot}`}
        aria-hidden="true"
      ></span>
      {footerMeta}
    </span>
  </div>
</div>
