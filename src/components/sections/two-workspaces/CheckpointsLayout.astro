---
/**
 * CheckpointsLayout — TwoWorkspaces v2 · Kitaru · artboard A3P-0.
 *
 * STATIC port — no interactivity, no JS, single state.
 *
 * Layout:
 *   Left pane: RECENT RUNS list — 5 rows with letter badge, run name,
 *     subtitle, status pill. Selected row uses orange-50 bg + #FFD7B5
 *     border + RESUMED pill (orange). Idle rows use ink bg + neutral pill.
 *
 *   Right pane: header strip (eyebrow + title + context chip), then a
 *     white card containing the EXECUTION TIMELINE — horizontal circular-
 *     node track with 8 nodes (hollow / done / failure / resume / pending)
 *     and a dashed rate-limit arc above the failure→resume span. Then a
 *     paired failure card + resume card (with CLI line). Footer meta strip.
 *
 * The circular-node timeline is bespoke to this tab — built as inline SVG
 * arcs and HTML nodes here. No shared component extracted.
 *
 * Data: src/lib/two-workspaces/checkpoints-data.ts (all copy + node list).
 */

import { CHECKPOINTS_DATA } from "../../../lib/two-workspaces/checkpoints-data";

const d = CHECKPOINTS_DATA;

/** Pill tone map for status pills on non-selected rows */
const idlePillStyle = (status: string) => {
  if (status === "ACTIVE") {
    return {
      bg: "#FFFFFF",
      border: "#E7E2D6",
      dot: "#101828",
      text: "#101828",
    };
  }
  if (status === "PAUSED") {
    return {
      bg: "#FFFFFF",
      border: "#E7E2D6",
      dot: "#B6AC97",
      text: "#7A6F5C",
    };
  }
  // IDLE
  return {
    bg: "#FFFFFF",
    border: "#E7E2D6",
    dot: "#B6AC97",
    text: "#7A6F5C",
  };
};

/**
 * Node layout note:
 * The track is evenly spaced (justify-between) across the full width.
 * Arc positions are hard-coded in the SVG viewBox coordinates
 * (failure = slot 3/7, resume = slot 4/7 of the 700-unit track).
 * Matches artboard: failure at index 3 (llm.write), resume at index 4.
 */
---

<div class="flex flex-col gap-3">
  <div class="grid grid-cols-1 gap-3 lg:grid-cols-[360px_1fr]">

    {/* ── Left pane — RECENT RUNS ── */}
    <aside class="flex flex-col rounded-md border border-[#EFE8DC] bg-cream-warm p-5" style="gap:14px">
      {/* Header */}
      <div class="flex items-start justify-between gap-3">
        <div class="flex flex-col gap-0.5">
          <span
            class="font-sans text-[10px] font-semibold uppercase leading-3 tracking-[0.08em]"
            style="color:#7A6F5C; font-family:'Plus Jakarta Sans',system-ui,sans-serif"
          >
            {d.leftHeader.title}
          </span>
          <span
            class="font-mono text-[10px] leading-3"
            style="color:#9A8E78"
          >
            {d.leftHeader.subtitle}
          </span>
        </div>
        <span
          class="font-mono text-[10px] leading-3"
          style="color:#9A8E78; padding-top:2px"
        >
          {d.leftHeader.countLabel}
        </span>
      </div>

      {/* Run rows */}
      <div class="flex flex-col gap-1.5">
        {d.runs.map((run) => {
          const isSelected = run.selected;
          const pill = isSelected ? null : idlePillStyle(run.status);
          return (
            <div
              class="ckpt-row flex w-full items-center gap-3"
              aria-current={isSelected ? "true" : undefined}
            >
              {/* Letter badge */}
              <span
                class="ckpt-row-badge inline-flex size-8 shrink-0 items-center justify-center font-sans text-sm font-bold leading-none text-white"
                style={`font-family:'Plus Jakarta Sans',system-ui,sans-serif; border-radius:8px; background-color:${isSelected ? "#FB923C" : "#101828"}`}
                aria-hidden="true"
              >
                {run.letter}
              </span>

              {/* Name + subtitle */}
              <div class="flex min-w-0 flex-1 flex-col gap-[3px]">
                <span
                  class="ckpt-row-name truncate text-[14px] leading-[18px]"
                  style={`font-family:'Plus Jakarta Sans',system-ui,sans-serif; font-weight:${isSelected ? 600 : 500}; color:${isSelected ? "#101828" : "#1F2937"}`}
                >
                  {run.name}
                </span>
                <span
                  class="truncate font-mono text-[10px] leading-3"
                  style="color:#6B7280"
                >
                  {run.subtitle}
                </span>
              </div>

              {/* Status pill */}
              {isSelected ? (
                <span
                  class="ckpt-pill inline-flex shrink-0 items-center gap-1.5 rounded-full"
                  style="background-color:#FFF4EC; border:1px solid #FFD7B5; padding:3px 8px"
                >
                  <span
                    class="size-1.5 shrink-0 rounded-full"
                    style="background-color:#FB923C"
                    aria-hidden="true"
                  ></span>
                  <span
                    class="font-mono font-semibold uppercase"
                    style="font-size:9px; line-height:12px; letter-spacing:0.04em; color:#C2410C"
                  >
                    {run.status}
                  </span>
                </span>
              ) : (
                <span
                  class="inline-flex shrink-0 items-center gap-1.5 rounded-full"
                  style={`background-color:${pill!.bg}; border:1px solid ${pill!.border}; padding:3px 8px`}
                >
                  <span
                    class="size-1.5 shrink-0 rounded-full"
                    style={`background-color:${pill!.dot}`}
                    aria-hidden="true"
                  ></span>
                  <span
                    class="font-mono font-semibold uppercase"
                    style={`font-size:9px; line-height:12px; letter-spacing:0.04em; color:${pill!.text}`}
                  >
                    {run.status}
                  </span>
                </span>
              )}
            </div>
          );
        })}
      </div>
    </aside>

    {/* ── Right pane — EXECUTION CHECKPOINTS ── */}
    <section
      class="flex flex-col rounded-md border border-[#EFE8DC] bg-cream-warm"
      style="padding:22px 24px; gap:16px"
    >
      {/* Header strip */}
      <div class="flex items-start justify-between gap-4">
        <div class="flex min-w-0 flex-1 flex-col gap-1.5">
          <span
            class="font-sans font-semibold uppercase leading-3"
            style="font-family:'Plus Jakarta Sans',system-ui,sans-serif; font-size:10px; letter-spacing:0.08em; color:#C2410C"
          >
            {d.rightEyebrow}
          </span>
          <span
            class="font-sans font-semibold leading-6"
            style="font-family:'Plus Jakarta Sans',system-ui,sans-serif; font-size:17px; color:#101828; max-width:560px"
          >
            {d.rightTitle}
          </span>
        </div>
        {/* Context chip */}
        <span
          class="inline-flex shrink-0 items-center gap-1.5 rounded-full"
          style="background-color:#FFF4EC; border:1px solid #FFD7B5; padding:4px 9px; margin-top:2px; height:22px"
        >
          <span
            class="size-1.5 shrink-0 rounded-full"
            style="background-color:#FB923C"
            aria-hidden="true"
          ></span>
          <span
            class="font-mono font-semibold"
            style="font-size:10px; line-height:12px; color:#C2410C"
          >
            {d.contextChip}
          </span>
        </span>
      </div>

      {/* ── Timeline card ── */}
      <div
        class="flex flex-col rounded-md border border-[#EFE8DC] bg-white"
        style="padding:18px 16px 14px; gap:12px"
      >
        {/* Card header: label + legend */}
        <div class="flex items-center justify-between">
          <span
            class="font-sans font-semibold uppercase leading-3"
            style="font-family:'Plus Jakarta Sans',system-ui,sans-serif; font-size:10px; letter-spacing:0.08em; color:#7A6F5C"
          >
            {d.timelineLabel}
          </span>
          {/* Legend */}
          <div class="flex items-center gap-3.5">
            {/* checkpoint */}
            <span class="inline-flex items-center gap-1.5">
              <span
                class="size-1.5 shrink-0 rounded-full"
                style="background-color:#FB923C"
                aria-hidden="true"
              ></span>
              <span class="font-mono" style="font-size:9px; line-height:12px; color:#6B7280">
                checkpoint
              </span>
            </span>
            {/* failure */}
            <span class="inline-flex items-center gap-1.5">
              <span
                class="shrink-0"
                style="display:inline-block; width:6px; height:6px; border-radius:1px; background-color:#EF4444"
                aria-hidden="true"
              ></span>
              <span class="font-mono" style="font-size:9px; line-height:12px; color:#6B7280">
                failure
              </span>
            </span>
            {/* resume */}
            <span class="inline-flex items-center gap-1.5">
              <span
                class="font-mono font-bold"
                style="font-size:11px; line-height:14px; color:#FB923C"
                aria-hidden="true"
              >&#x203A;</span>
              <span class="font-mono" style="font-size:9px; line-height:12px; color:#6B7280">
                resume
              </span>
            </span>
          </div>
        </div>

        {/* Node track: baseline + SVG dashed arc + 8 circular nodes (justify-between) + labels row */}
        <div style="padding:4px 4px 0; gap:10px; display:flex; flex-direction:column">
          {/* Track area with SVG arc overlay */}
          <div class="relative" style="height:40px">
            {/* Baseline rule */}
            <div
              class="absolute"
              style="left:0; right:0; top:50%; height:2px; background-color:#FFE3CC; border-radius:1px; transform:translateY(-50%)"
              aria-hidden="true"
            ></div>

            {/* Dashed arc SVG — rate-limit: semicircle above baseline, failure idx3 to resume idx4 */}
            <svg
              class="absolute inset-0 w-full h-full overflow-visible"
              preserveAspectRatio="none"
              viewBox="0 0 700 40"
              aria-hidden="true"
            >
              <path
                d="M 300 20 A 50 22 0 0 1 400 20"
                fill="none"
                stroke="#FB923C"
                stroke-width="1.5"
                stroke-dasharray="3 3"
                stroke-linecap="round"
              />
              <text
                x="350"
                y="1"
                text-anchor="middle"
                fill="#C2410C"
                font-family='"JetBrains Mono", system-ui, sans-serif'
                font-size="8"
                font-style="italic"
              >
                rate-limit
              </text>
            </svg>

            {/* Node row */}
            <div class="absolute inset-0 flex items-center justify-between px-0">
              {d.nodes.map((node) => {
                if (node.kind === "failure") {
                  return (
                    <div
                      class="inline-flex shrink-0 items-center justify-center"
                      style="width:18px; height:18px; border-radius:999px; background-color:#FEF2F2; border:2px solid #EF4444"
                      aria-label={`Failure: ${node.label}`}
                    >
                      <svg width="9" height="9" viewBox="0 0 9 9" fill="none" aria-hidden="true">
                        <path d="M1.5 1.5 L7.5 7.5 M7.5 1.5 L1.5 7.5" stroke="#EF4444" stroke-width="1.6" stroke-linecap="round" />
                      </svg>
                    </div>
                  );
                }
                if (node.kind === "resume") {
                  return (
                    <div
                      class="inline-flex shrink-0 items-center justify-center"
                      style="width:18px; height:18px; border-radius:999px; background-color:#FB923C; border:2px solid #C2410C"
                      aria-label={`Resume: ${node.label}`}
                    >
                      <svg width="9" height="9" viewBox="0 0 9 9" fill="none" aria-hidden="true">
                        <path d="M2 1.5 L6.5 4.5 L2 7.5 Z" fill="#FFFFFF" />
                      </svg>
                    </div>
                  );
                }
                if (node.kind === "done") {
                  return (
                    <div
                      class="inline-flex shrink-0 items-center justify-center"
                      style="width:14px; height:14px; border-radius:999px; background-color:#FB923C; border:2px solid #C2410C"
                      aria-label={node.label}
                    ></div>
                  );
                }
                if (node.kind === "pending") {
                  return (
                    <div
                      class="inline-flex shrink-0 items-center justify-center"
                      style="width:14px; height:14px; border-radius:999px; background-color:#FFFFFF; border:2px solid #C2410C; opacity:0.55"
                      aria-label={`Pending: ${node.label}`}
                    ></div>
                  );
                }
                // hollow
                return (
                  <div
                    class="inline-flex shrink-0 items-center justify-center"
                    style="width:14px; height:14px; border-radius:999px; background-color:#FFFFFF; border:2px solid #C2410C"
                    aria-label={node.label}
                  ></div>
                );
              })}
            </div>
          </div>

          {/* Labels row — matches node positions */}
          <div class="flex items-start justify-between">
            {d.nodes.map((node) => {
              const isOrange = node.kind === "done" || node.kind === "resume";
              const isRed    = node.kind === "failure";
              const isMuted  = node.kind === "pending";
              const labelColor = isOrange ? "#C2410C" : isRed ? "#B91C1C" : isMuted ? "#9A8E78" : "#1F2937";
              const labelWeight = isOrange || isRed ? 600 : 500;
              const durColor    = isOrange ? "#C2410C" : isRed ? "#B91C1C" : "#9A8E78";
              return (
                <div
                  class="flex flex-col items-center gap-[3px] shrink-0"
                  style="width:80px"
                >
                  <span
                    class="font-mono text-center leading-3"
                    style={`font-size:10px; font-weight:${labelWeight}; color:${labelColor}`}
                  >
                    {node.label}
                  </span>
                  <span
                    class="font-mono text-center leading-3"
                    style={`font-size:9px; color:${durColor}`}
                  >
                    {node.duration}
                  </span>
                </div>
              );
            })}
          </div>
        </div>
      </div>

      {/* ── Paired cards ── */}
      <div class="flex gap-3">
        {/* Failure card */}
        <div
          class="flex flex-1 flex-col rounded-md"
          style="background-color:#FEF2F2; border:1px solid #FECACA; padding:14px 16px; gap:6px"
        >
          <div class="flex items-center justify-between">
            <span
              class="font-mono font-semibold"
              style="font-size:11px; line-height:14px; letter-spacing:0.04em; color:#B91C1C"
            >
              {d.failureCard.title}
            </span>
            <span
              class="font-mono"
              style="font-size:10px; line-height:12px; color:#B91C1C; opacity:0.7"
            >
              {d.failureCard.timestamp}
            </span>
          </div>
          <span
            class="font-mono"
            style="font-size:10px; line-height:12px; color:#7F1D1D"
          >
            {d.failureCard.body}
          </span>
        </div>

        {/* Resume card */}
        <div
          class="flex flex-1 flex-col rounded-md"
          style="background-color:#FFF4EC; border:1px solid #FFD7B5; padding:14px 16px; gap:10px"
        >
          <div class="flex items-center justify-between">
            <span
              class="font-sans font-semibold"
              style="font-family:'Plus Jakarta Sans',system-ui,sans-serif; font-size:12px; line-height:16px; letter-spacing:0.04em; color:#C2410C"
            >
              {d.resumeCard.title}
            </span>
            <span
              class="font-mono"
              style="font-size:10px; line-height:12px; color:#C2410C; opacity:0.75"
            >
              {d.resumeCard.timestamp}
            </span>
          </div>
          {/* CLI block */}
          <div
            class="flex items-center gap-2 rounded-[6px]"
            style="background-color:#FFFFFF; border:1px solid #FFD7B5; padding:9px 12px"
          >
            <span
              class="font-mono font-semibold shrink-0"
              style="font-size:11px; line-height:14px; color:#C2410C"
            >
              $
            </span>
            <span
              class="font-mono"
              style="font-size:11px; line-height:14px; color:#1F2937"
            >
              {d.resumeCard.cliCommand}
            </span>
          </div>
          {/* Savings */}
          <div class="flex items-center gap-1.5" style="padding-top:2px">
            <span class="font-mono" style="font-size:10px; line-height:12px; color:#374151">Saved</span>
            <span class="font-mono font-semibold" style="font-size:10px; line-height:12px; color:#C2410C">
              {d.resumeCard.savings.savedTime}
            </span>
            <span class="font-mono" style="font-size:10px; line-height:12px; color:#9A8E78">·</span>
            <span class="font-mono font-semibold" style="font-size:10px; line-height:12px; color:#C2410C">
              {d.resumeCard.savings.callsSkipped}
            </span>
            <span class="font-mono" style="font-size:10px; line-height:12px; color:#374151">not re-issued</span>
          </div>
        </div>
      </div>

      {/* ── Footer meta strip ── */}
      <div
        class="flex items-center justify-between"
        style="border-top:1px solid #EFE8DC; padding-top:8px"
      >
        <div class="flex items-center gap-2">
          <span class="font-mono" style="font-size:11px; line-height:14px; color:#374151">
            {d.footer.runId}
          </span>
          <span class="font-mono" style="font-size:11px; line-height:14px; color:#9A8E78">·</span>
          <span class="font-mono" style="font-size:11px; line-height:14px; color:#374151">
            {d.footer.checkpointsLabel}
          </span>
          <span class="font-mono" style="font-size:11px; line-height:14px; color:#9A8E78">·</span>
          <span class="font-mono" style="font-size:11px; line-height:14px; color:#374151">
            {d.footer.duration}
          </span>
        </div>
        <div class="flex items-center gap-1.5">
          <span
            class="shrink-0 rounded-full"
            style="width:7px; height:7px; background-color:#FB923C; display:inline-block"
            aria-hidden="true"
          ></span>
          <span
            class="font-mono font-semibold"
            style="font-size:11px; line-height:14px; color:#C2410C"
          >
            {d.footer.statusLabel}
          </span>
        </div>
      </div>
    </section>

  </div>
</div>

<style>
  /* ── Selected-row spec ────────────────────────────────────────────────── */
  /* Static layout — the highlight marks which run the right pane details;
     rows are not interactive, so no cursor/hover/focus affordances. */
  .ckpt-row {
    border-radius: 8px;
    padding: 10px 12px;
    background-color: transparent;
    border: 1px solid transparent;
  }
  .ckpt-row[aria-current="true"] {
    background-color: #fff4ec; /* orange-50 */
    border-color: #ffd7b5;     /* --kitaru-selected-row-border */
    /* Keep stable by matching the same box model — 1px border, 10px block padding */
  }
  .ckpt-row-badge {
    border-radius: 8px;
  }
</style>
