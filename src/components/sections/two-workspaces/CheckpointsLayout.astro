---
/**
 * Checkpoints subtab — "Resume from any checkpoint" (artboard 96B-0).
 * Left: recent runs with progress bars.
 * Right: 8-step timeline with rate-limit→resume arc, then paired failure + resume cards.
 */

type Row = {
  initial: string;
  initialTone?: "orange" | "dark" | "yellow";
  name: string;
  runId: string;
  meta: string;
  statusPill?: { label: string; tone: "warning" | "success" | "neutral" };
  progress: { done: number; total: number };
  statusDot: "success" | "warning";
  selected?: boolean;
};

type CheckpointMark = {
  kind: "done" | "failed" | "resume" | "pending";
  label?: string;
  index: number; // 1-based for the bottom label
};

interface Props {
  title: string;
  subheader: string;
  countLabel: string;
  rows: ReadonlyArray<Row>;
  rightEyebrow: string;
  rightSubhead: string;
  recoveredPill: string;
  marks: ReadonlyArray<CheckpointMark>;
  failureCard: { eyebrow: string; timestamp: string; message: string; subtext: string };
  resumeCard: {
    eyebrow: string;
    timestamp: string;
    message: string;
    subtext: string;
    cliPrefix: string;
    cliArgs: string;
  };
}

const {
  title,
  subheader,
  countLabel,
  rows,
  rightEyebrow,
  rightSubhead,
  recoveredPill,
  marks,
  failureCard,
  resumeCard,
} = Astro.props;

const glyphTone = (tone?: Row["initialTone"]) => {
  if (tone === "dark") return "bg-gray-900 text-white";
  if (tone === "yellow") return "bg-[#fbbf24] text-stage-fg";
  return "bg-orange-400 text-white";
};

const pillClass = (tone?: "warning" | "success" | "neutral") => {
  if (tone === "warning") return "bg-stage-bg text-stage-fg";
  if (tone === "success") return "bg-success-50 text-success-700";
  return "bg-gray-100 text-gray-600";
};

const dotClass = (s: Row["statusDot"]) =>
  s === "success" ? "bg-success-500" : "bg-[#fbbf24]";

// SVG horizontal positions for the 8 checkpoint marks (x coordinate)
const STEP_X = [40, 130, 220, 325, 430, 520, 615, 710];
---

<div class="grid grid-cols-1 gap-3 lg:grid-cols-[360px_1fr]">
  {/* Left pane — recent runs */}
  <aside class="flex flex-col gap-2 rounded-md border border-gray-200 bg-white p-3">
    <div class="flex items-start justify-between gap-3 border-b border-gray-100 pb-2">
      <div class="flex flex-col gap-0.5">
        <span class="font-mono text-[11px] uppercase leading-[14px] tracking-[0.08em] text-gray-500">
          {title}
        </span>
        <span class="text-[13px] leading-4 text-gray-500">{subheader}</span>
      </div>
      <span class="font-mono text-[11px] leading-[14px] text-gray-500">
        {countLabel}
      </span>
    </div>

    <div class="flex flex-col gap-1">
      {rows.map((row) => (
        <div
          class:list={[
            "flex flex-col gap-1.5 rounded-md px-2 py-2",
            row.selected && "border border-orange-200 bg-orange-50",
          ]}
        >
          <div class="flex items-center gap-2.5">
            <span
              class:list={[
                "inline-flex size-7 shrink-0 items-center justify-center rounded-md font-mono text-[13px] font-semibold leading-none",
                glyphTone(row.initialTone),
              ]}
              aria-hidden="true"
            >
              {row.initial}
            </span>
            <div class="flex min-w-0 flex-1 flex-col gap-0.5">
              <div class="flex items-center gap-1.5">
                <span class:list={[
                  "truncate text-[13px] font-semibold leading-4",
                  row.selected ? "text-orange-600" : "text-gray-900",
                ]}>
                  {row.name}
                </span>
                <span class="font-mono text-[10px] leading-3 text-gray-400">{row.runId}</span>
              </div>
              <span class="truncate font-mono text-[11px] leading-[14px] text-gray-500">
                {row.meta}
              </span>
            </div>
            <span class:list={["inline-block size-1.5 shrink-0 rounded-full", dotClass(row.statusDot)]} aria-hidden="true"></span>
          </div>

          <div class="flex items-center gap-2">
            <div class="relative h-1 flex-1 overflow-hidden rounded-full bg-gray-100">
              <div
                class:list={[
                  "absolute inset-y-0 left-0 rounded-full",
                  row.selected ? "bg-gray-400" : "bg-gray-300",
                ]}
                style={`width:${Math.round((row.progress.done / row.progress.total) * 100)}%`}
              ></div>
            </div>
            {row.statusPill && (
              <span class:list={[
                "inline-flex shrink-0 items-center rounded-full px-1.5 py-0.5 font-mono text-[10px] font-semibold uppercase leading-3 tracking-wide",
                pillClass(row.statusPill.tone),
              ]}>
                {row.statusPill.label}
              </span>
            )}
            <span class="shrink-0 font-mono text-[10px] leading-3 text-gray-500">
              {row.progress.done}/{row.progress.total}
            </span>
          </div>
        </div>
      ))}
    </div>
  </aside>

  {/* Right pane — timeline + detail cards */}
  <section class="flex flex-col gap-3 rounded-md border border-gray-200 bg-white p-3">
    <div class="flex items-start justify-between gap-3 border-b border-gray-100 pb-2">
      <div class="flex flex-col gap-0.5">
        <span class="font-mono text-[11px] uppercase leading-[14px] tracking-[0.08em] text-gray-500">
          {rightEyebrow}
        </span>
        <span class="text-[13px] leading-[18px] text-gray-700">{rightSubhead}</span>
      </div>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-success-50 px-2.5 py-1 font-mono text-[10px] font-semibold leading-3 text-success-700">
        <span class="inline-block size-1.5 rounded-full bg-success-500" aria-hidden="true"></span>
        {recoveredPill}
      </span>
    </div>

    {/* Timeline card */}
    <div class="rounded-md border border-gray-100 bg-cream-canvas px-4 py-3">
      <svg viewBox="0 0 760 150" width="100%" height="150" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
        <defs>
          <marker id="ck-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 0 L 10 5 L 0 10 z" fill="#fb923c" />
          </marker>
        </defs>

        {/* Track segments */}
        <line x1="40" y1="100" x2="320" y2="100" stroke="#fb923c" stroke-width="2" />
        <line x1="320" y1="100" x2="430" y2="100" stroke="#e5e7eb" stroke-width="2" />
        <line x1="430" y1="100" x2="720" y2="100" stroke="#fb923c" stroke-width="2" />

        {/* Curved arrow from failure to resume */}
        <path d="M 325 70 Q 380 25, 430 70" stroke="#fb923c" stroke-width="2" stroke-dasharray="5 4" fill="none" marker-end="url(#ck-arrow)" />

        {/* Marks */}
        {marks.map((m, i) => {
          const x = STEP_X[i];
          return (
            <>
              {m.kind === "done" && (
                <>
                  <circle cx={x} cy="100" r="9" fill="#fb923c" />
                  <circle cx={x} cy="100" r="4" fill="#ffffff" />
                </>
              )}
              {m.kind === "failed" && (
                <>
                  <circle cx={x} cy="100" r="13" fill="#ffffff" stroke="#ef4444" stroke-width="2" />
                  <path d={`M ${x - 4} 96 L ${x + 4} 104 M ${x - 4} 104 L ${x + 4} 96`} stroke="#ef4444" stroke-width="2" stroke-linecap="round" />
                  <text x={x} y="60" text-anchor="middle" fill="#b91c1c" font-family="JetBrains Mono, ui-monospace, monospace" font-size="11" font-weight="600">{m.label}</text>
                </>
              )}
              {m.kind === "resume" && (
                <>
                  <circle cx={x} cy="100" r="13" fill="#fff4ec" stroke="#fb923c" stroke-width="2" />
                  <circle cx={x} cy="100" r="5" fill="#fb923c" />
                  <text x={x} y="60" text-anchor="middle" fill="#ea580c" font-family="JetBrains Mono, ui-monospace, monospace" font-size="11" font-weight="600">{m.label}</text>
                </>
              )}
              {m.kind === "pending" && (
                <circle cx={x} cy="100" r="9" fill="#ffffff" stroke="#fb923c" stroke-width="1.5" />
              )}
              <text
                x={x}
                y="138"
                text-anchor="middle"
                font-family="JetBrains Mono, ui-monospace, monospace"
                font-size="10"
                font-weight={m.kind === "failed" ? "700" : "500"}
                fill={
                  m.kind === "failed"
                    ? "#b91c1c"
                    : m.kind === "resume"
                      ? "#ea580c"
                      : m.kind === "pending"
                        ? "#9ca3af"
                        : "#6b7280"
                }
              >
                {m.index}
              </text>
            </>
          );
        })}
      </svg>
    </div>

    {/* Detail strip — failure + resume cards */}
    <div class="grid grid-cols-1 gap-2 lg:grid-cols-2">
      {/* Failure card */}
      <div class="flex flex-col gap-1.5 rounded-md border border-error-200 bg-error-50 p-3">
        <div class="flex items-center justify-between">
          <span class="font-mono text-[10px] font-semibold uppercase leading-3 tracking-wide text-error-700">
            {failureCard.eyebrow}
          </span>
          <span class="font-mono text-[10px] leading-3 text-error-700/70">{failureCard.timestamp}</span>
        </div>
        <span class="text-[13px] leading-4 text-error-700">{failureCard.message}</span>
      </div>

      {/* Resume card */}
      <div class="flex flex-col gap-1.5 rounded-md border border-orange-200 bg-orange-50 p-3">
        <div class="flex items-center justify-between">
          <span class="font-mono text-[10px] font-semibold uppercase leading-3 tracking-wide text-orange-600">
            {resumeCard.eyebrow}
          </span>
          <span class="font-mono text-[10px] leading-3 text-orange-600/70">{resumeCard.timestamp}</span>
        </div>
        <span class="text-[13px] leading-4 text-orange-800">{resumeCard.message}</span>
        <span class="font-mono text-[10px] leading-[14px] text-orange-600/80">{resumeCard.subtext}</span>
        <div class="mt-1 rounded border border-orange-200 bg-white px-2.5 py-1.5 font-mono text-[11px] leading-[16px]">
          <span class="text-ink">{resumeCard.cliPrefix} </span>
          <span class="text-orange-600">{resumeCard.cliArgs}</span>
        </div>
      </div>
    </div>

  </section>
</div>
