---
/**
 * Integrations · ML subtab — "Native to your stack" (artboard 8XU-0).
 * Left: installed providers list.
 * Right: hub-and-spoke SVG with 6 absolute-positioned satellite chips.
 */

type Row = {
  initial: string;
  tone?: "purple" | "neutral";
  name: string;
  meta: string;
  selected?: boolean;
};

type Satellite = {
  initial: string;
  initialColor: string; // hex for the letter chip background
  name: string;
  /** absolute % position from left and top (px from container top) */
  left: string;
  top: string;
  selected?: boolean;
};

interface Props {
  title: string;
  subheader: string;
  countLabel?: string;
  rows: ReadonlyArray<Row>;
  rightEyebrow: string;
  rightSubhead: string;
  satellites: ReadonlyArray<Satellite>;
  footerMeta?: string;
}

const {
  title,
  subheader,
  countLabel,
  rows,
  rightEyebrow,
  rightSubhead,
  satellites,
  footerMeta,
} = Astro.props;

const glyphTone = (tone?: Row["tone"]) =>
  tone === "purple" ? "bg-zenml-500 text-white" : "bg-gray-900 text-white";
---

<div class="grid grid-cols-1 gap-4 lg:grid-cols-[360px_1fr]">
  {/* Left pane — installed */}
  <aside class="flex flex-col gap-2.5 rounded-md border border-gray-200 bg-white p-4">
    <div class="flex items-start justify-between gap-3 border-b border-gray-100 pb-2">
      <div class="flex flex-col gap-0.5">
        <span class="font-mono text-[11px] uppercase leading-[14px] tracking-[0.08em] text-gray-500">
          {title}
        </span>
        <span class="text-[13px] leading-4 text-gray-500">{subheader}</span>
      </div>
      {countLabel && (
        <span class="font-mono text-[11px] leading-[14px] text-gray-500">
          {countLabel}
        </span>
      )}
    </div>

    <div class="flex flex-col gap-1">
      {rows.map((row) => (
        <div
          class:list={[
            "flex items-center gap-2.5 rounded-md px-2 py-2",
            row.selected && "border border-zenml-300 bg-zenml-50",
          ]}
        >
          <span
            class:list={[
              "inline-flex size-7 shrink-0 items-center justify-center rounded-md font-mono text-[13px] font-semibold leading-none",
              glyphTone(row.tone),
            ]}
            aria-hidden="true"
          >
            {row.initial}
          </span>
          <div class="flex min-w-0 flex-1 flex-col gap-0.5">
            <span
              class:list={[
                "truncate text-[13px] leading-4",
                row.selected
                  ? "font-semibold text-zenml-600"
                  : "font-semibold text-gray-900",
              ]}
            >
              {row.name}
            </span>
            <span class="truncate font-mono text-[11px] leading-[14px] text-gray-500">
              {row.meta}
            </span>
          </div>
          <span class="inline-flex shrink-0 items-center gap-1 rounded-full bg-success-50 px-2 py-0.5 font-mono text-[10px] font-semibold leading-3 tracking-wide text-success-700">
            <span class="inline-block size-1.5 rounded-full bg-success-500" aria-hidden="true"></span>
            INSTALLED
          </span>
        </div>
      ))}
    </div>
  </aside>

  {/* Right pane — hub-and-spoke */}
  <section class="flex flex-col gap-4 rounded-md border border-gray-200 bg-white p-4">
    <div class="flex items-start justify-between gap-3 border-b border-gray-100 pb-2">
      <div class="flex flex-col gap-0.5">
        <span class="font-mono text-[11px] uppercase leading-[14px] tracking-[0.08em] text-gray-500">
          {rightEyebrow}
        </span>
        <span class="text-[13px] leading-[18px] text-gray-700">{rightSubhead}</span>
      </div>
    </div>

    <div class="relative flex-1 overflow-hidden rounded-md border border-gray-100 bg-cream-canvas" style="min-height: 360px">
      <svg viewBox="0 0 760 360" width="100%" height="100%" preserveAspectRatio="xMidYMid meet" aria-hidden="true" class="absolute inset-0">
        <defs>
          <radialGradient id="zml-hub-glow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#7a3ef4" stop-opacity="0.32" />
            <stop offset="100%" stop-color="#7a3ef4" stop-opacity="0" />
          </radialGradient>
        </defs>

        {/* Outer dashed ring */}
        <circle cx="380" cy="180" r="140" fill="none" stroke="var(--color-gray-300)" stroke-width="1" stroke-dasharray="4 5" />
        {/* Inner solid ring */}
        <circle cx="380" cy="180" r="90" fill="none" stroke="var(--color-gray-200)" stroke-width="1" />

        {/* 6 spokes */}
        <line x1="380" y1="180" x2="380" y2="40" stroke="var(--color-gray-200)" stroke-width="1" />
        <line x1="380" y1="180" x2="500" y2="110" stroke="var(--color-gray-200)" stroke-width="1" />
        <line x1="380" y1="180" x2="500" y2="250" stroke="var(--color-gray-200)" stroke-width="1" />
        <line x1="380" y1="180" x2="380" y2="320" stroke="var(--color-gray-200)" stroke-width="1" />
        <line x1="380" y1="180" x2="260" y2="250" stroke="var(--color-gray-200)" stroke-width="1" />
        <line x1="380" y1="180" x2="260" y2="110" stroke="var(--color-gray-200)" stroke-width="1" />

        {/* Hub glow + circle */}
        <circle cx="380" cy="180" r="60" fill="url(#zml-hub-glow)" />
        <circle cx="380" cy="180" r="32" fill="#7a3ef4" />
        <text x="380" y="185" text-anchor="middle" fill="#ffffff" font-family="JetBrains Mono, ui-monospace, monospace" font-size="13" font-weight="700">ZenML</text>
      </svg>

      {/* Satellite chips */}
      {satellites.map((sat) => (
        <div
          class:list={[
            "absolute inline-flex -translate-x-1/2 -translate-y-1/2 items-center gap-1.5 rounded-full border bg-white px-2.5 py-1.5 shadow-[0_1px_2px_rgba(15,15,18,0.04)]",
            sat.selected ? "border-zenml-300" : "border-gray-200",
          ]}
          style={`left:${sat.left}; top:${sat.top}`}
        >
          <span
            class="inline-flex size-[18px] shrink-0 items-center justify-center rounded-full font-mono text-[10px] font-semibold leading-none text-white"
            style={`background:${sat.initialColor}`}
            aria-hidden="true"
          >
            {sat.initial}
          </span>
          <span class="font-mono text-[10px] font-semibold leading-3 text-gray-900">
            {sat.name}
          </span>
        </div>
      ))}
    </div>

    {footerMeta && (
      <div class="flex items-center gap-3 border-t border-gray-200 pt-2">
        <span class="font-mono text-[11px] uppercase leading-[14px] tracking-[0.04em] text-gray-600">
          <span class="mr-2 inline-block size-1.5 rounded-full bg-success-500 align-middle" aria-hidden="true"></span>
          {footerMeta}
        </span>
      </div>
    )}
  </section>
</div>
