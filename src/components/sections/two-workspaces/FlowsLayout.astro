---
import { Code } from "astro:components";
import zenmlLight from "../../../styles/zenml-light.json";

/**
 * Flows subtab — "Two decorators. That's the whole API." (artboard 93H-0).
 * Left: agent flows list.
 * Right: code panel + 3-node flow diagram side-by-side.
 */

type Row = {
  initial: string;
  initialTone?: "orange" | "dark" | "yellow" | "orange-faded";
  name: string;
  meta: string;
  selected?: boolean;
};

type FlowNode = {
  kind: "flow" | "checkpoint";
  name: string;
  status?: "running" | "done" | "pending";
};

interface Props {
  title: string;
  subheader: string;
  countLabel: string;
  rows: ReadonlyArray<Row>;
  fileName: string;
  rightEyebrow: string;
  rightSubhead: string;
  code: string;
  flowNodes: ReadonlyArray<FlowNode>;
  footerMeta?: string;
}

const {
  title,
  subheader,
  countLabel,
  rows,
  fileName,
  rightEyebrow,
  rightSubhead,
  code,
  flowNodes,
  footerMeta,
} = Astro.props;

const glyphTone = (tone?: Row["initialTone"]) => {
  if (tone === "dark") return "bg-gray-900 text-white";
  if (tone === "yellow") return "bg-[#fbbf24] text-stage-fg";
  if (tone === "orange-faded") return "bg-orange-200 text-orange-800";
  return "bg-orange-400 text-white";
};

---

<div class="grid grid-cols-1 gap-4 lg:grid-cols-[360px_1fr]">
  {/* Left pane */}
  <aside class="flex flex-col gap-2.5 rounded-md border border-gray-200 bg-white p-4">
    <div class="flex items-start justify-between gap-3 border-b border-gray-100 pb-2">
      <div class="flex flex-col gap-0.5">
        <span class="font-mono text-[11px] uppercase leading-[14px] tracking-[0.08em] text-gray-500">
          {title}
        </span>
        <span class="text-[13px] leading-4 text-gray-500">{subheader}</span>
      </div>
      <span class="font-mono text-[11px] leading-[14px] text-gray-500">
        {countLabel}
      </span>
    </div>

    <div class="flex flex-col gap-1">
      {rows.map((row) => (
        <div
          class:list={[
            "flex items-center gap-2.5 rounded-md px-2 py-2",
            row.selected && "border border-orange-200 bg-orange-50",
          ]}
        >
          <span
            class:list={[
              "inline-flex size-7 shrink-0 items-center justify-center rounded-md font-mono text-[13px] font-semibold leading-none",
              glyphTone(row.initialTone),
            ]}
            aria-hidden="true"
          >
            {row.initial}
          </span>
          <div class="flex min-w-0 flex-1 flex-col gap-0.5">
            <span
              class:list={[
                "truncate text-[13px] leading-4",
                row.selected
                  ? "font-semibold text-orange-600"
                  : "font-semibold text-gray-900",
              ]}
            >
              {row.name}
            </span>
            <span class="truncate font-mono text-[11px] leading-[14px] text-gray-500">
              {row.meta}
            </span>
          </div>
          {row.selected ? (
            <button
              type="button"
              class="inline-flex size-6 shrink-0 cursor-pointer items-center justify-center rounded-full bg-orange-400 text-white shadow-[0_1px_2px_rgba(15,15,18,0.18)]"
              aria-label={`Run ${row.name}`}
            >
              <svg viewBox="0 0 24 24" class="size-3" fill="currentColor" aria-hidden="true">
                <path d="M8 5v14l11-7z" />
              </svg>
            </button>
          ) : (
            <span class="font-mono text-[14px] leading-[14px] text-gray-300">···</span>
          )}
        </div>
      ))}
    </div>
  </aside>

  {/* Right pane */}
  <section class="flex flex-col gap-3 rounded-md border border-gray-200 bg-white p-4">
    <div class="flex items-start justify-between gap-3 border-b border-gray-100 pb-2">
      <div class="flex flex-col gap-0.5">
        <span class="font-mono text-[11px] uppercase leading-[14px] tracking-[0.08em] text-gray-500">
          {rightEyebrow}
        </span>
        <span class="text-[13px] leading-[18px] text-gray-700">{rightSubhead}</span>
      </div>
      <span class="inline-flex items-center gap-1.5 rounded-full border border-gray-200 bg-white px-2.5 py-1 font-mono text-[11px] font-medium leading-[14px] text-gray-900">
        <span class="inline-block size-1.5 rounded-full bg-orange-400" aria-hidden="true"></span>
        {fileName}
      </span>
    </div>

    <div class="flex flex-1 flex-col gap-2 rounded-md border border-gray-100 bg-cream-canvas p-3">
      <div class="flex items-center gap-1.5">
        <span class="inline-flex items-center rounded-full border border-orange-200 bg-orange-50 px-2 py-0.5 font-mono text-[10px] font-semibold leading-3 text-orange-600">
          @flow
        </span>
        <span class="inline-flex items-center rounded-full border border-orange-200 bg-orange-50 px-2 py-0.5 font-mono text-[10px] font-semibold leading-3 text-orange-600">
          @checkpoint
        </span>
      </div>
      <div class="workspace-code min-w-0 flex-1 overflow-x-auto">
        <Code code={code} lang="python" theme={zenmlLight as any} />
      </div>
    </div>

    {footerMeta && (
      <div class="flex items-center gap-3 border-t border-gray-200 pt-2">
        <span class="font-mono text-[11px] uppercase leading-[14px] tracking-[0.04em] text-gray-600">
          <span class="mr-2 inline-block size-1.5 rounded-full bg-orange-400 align-middle" aria-hidden="true"></span>
          {footerMeta}
        </span>
      </div>
    )}
  </section>
</div>

<style>
  .workspace-code :global(pre) {
    margin: 0;
    padding: 0;
    background: transparent !important;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.7;
  }
  .workspace-code :global(code) {
    font-family: inherit;
  }
</style>
