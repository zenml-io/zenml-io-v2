---
import { Code } from "astro:components";
import zenmlLight from "../../../styles/zenml-light.json";

/**
 * Integrations · Agents subtab — "Framework-agnostic" (artboard 9F8-0).
 * Left: frameworks list.
 * Right: wrap-sandwich diagram (Kitaru boundary, framework slot w/ active card).
 */

type Row = {
  initial: string;
  initialColor: string;
  name: string;
  meta: string;
  active?: boolean;
  selected?: boolean;
};

type SwapChip = {
  initial: string;
  initialColor: string;
  name: string;
  dashed?: boolean;
};

interface Props {
  title: string;
  subheader: string;
  countLabel: string;
  rows: ReadonlyArray<Row>;
  rightEyebrow: string;
  rightSubhead: string;
  wrapEyebrow: string;
  wrapMeta: string;
  wrapRight: string;
  activeFrameworkName: string;
  activeFrameworkInitial: string;
  activeFrameworkColor: string;
  code: string;
  swapChips: ReadonlyArray<SwapChip>;
}

const {
  title,
  subheader,
  countLabel,
  rows,
  rightEyebrow,
  rightSubhead,
  wrapEyebrow,
  wrapMeta,
  wrapRight,
  activeFrameworkName,
  activeFrameworkInitial,
  activeFrameworkColor,
  code,
  swapChips,
} = Astro.props;
---

<div class="grid grid-cols-1 gap-3 lg:grid-cols-[360px_1fr]">
  {/* Left pane — frameworks */}
  <aside class="flex flex-col gap-2 rounded-md border border-gray-200 bg-white p-3">
    <div class="flex items-start justify-between gap-3 border-b border-gray-100 pb-2">
      <div class="flex flex-col gap-0.5">
        <span class="font-mono text-[11px] uppercase leading-[14px] tracking-[0.08em] text-gray-500">
          {title}
        </span>
        <span class="text-[13px] leading-4 text-gray-500">{subheader}</span>
      </div>
      <span class="font-mono text-[11px] leading-[14px] text-gray-500">{countLabel}</span>
    </div>

    <div class="flex flex-col gap-1">
      {rows.map((row) => (
        <div
          class:list={[
            "flex items-center gap-2.5 rounded-md px-2 py-1.5",
            row.selected && "border border-orange-200 bg-orange-50",
          ]}
        >
          <span
            class="inline-flex size-7 shrink-0 items-center justify-center rounded-md font-mono text-[13px] font-semibold leading-none text-white"
            style={`background:${row.initialColor}`}
            aria-hidden="true"
          >
            {row.initial}
          </span>
          <div class="flex min-w-0 flex-1 flex-col gap-0.5">
            <span
              class:list={[
                "truncate text-[13px] leading-4",
                row.selected
                  ? "font-semibold text-orange-600"
                  : "font-semibold text-gray-900",
              ]}
            >
              {row.name}
            </span>
            <span class="truncate font-mono text-[11px] leading-[14px] text-gray-500">
              {row.meta}
            </span>
          </div>
          {row.active && (
            <span class="inline-flex shrink-0 items-center rounded-full bg-white px-2 py-0.5 font-mono text-[10px] font-semibold uppercase leading-3 tracking-wide text-orange-600">
              ACTIVE
            </span>
          )}
        </div>
      ))}
    </div>
  </aside>

  {/* Right pane — wrap sandwich */}
  <section class="flex flex-col gap-3 rounded-md border border-gray-200 bg-white p-3">
    <div class="flex items-start justify-between gap-3 border-b border-gray-100 pb-2">
      <div class="flex flex-col gap-0.5">
        <span class="font-mono text-[11px] uppercase leading-[14px] tracking-[0.08em] text-gray-500">
          {rightEyebrow}
        </span>
        <span class="text-[13px] leading-[18px] text-gray-700">{rightSubhead}</span>
      </div>
    </div>

    <div class="flex flex-col gap-0 rounded-md border border-gray-100 bg-cream-canvas p-3">
      {/* Top Kitaru boundary */}
      <div class="flex flex-wrap items-center justify-between gap-2 rounded-t-md border border-orange-200 bg-orange-50 px-3.5 py-2">
        <div class="flex items-center gap-2">
          <span class="inline-flex size-5 items-center justify-center rounded bg-orange-400 font-mono text-[10px] font-semibold leading-none text-white">
            K
          </span>
          <span class="font-mono text-[11px] font-semibold leading-3 text-orange-600">{wrapEyebrow}</span>
          <span class="font-mono text-[11px] leading-3 text-gray-500">— {wrapMeta}</span>
        </div>
        {wrapRight && (
          <span class="font-mono text-[10px] leading-3 text-orange-600">{wrapRight}</span>
        )}
      </div>

      {/* Framework slot */}
      <div class="flex flex-col gap-3 rounded-b-md border-x border-b border-orange-200 bg-white p-3 lg:flex-row">
        {/* Active framework card */}
        <div class="flex flex-1 flex-col gap-2 rounded-md bg-ink px-3 py-2.5">
          <div class="flex items-center gap-2">
            <span
              class="inline-flex size-5 items-center justify-center rounded font-mono text-[10px] font-semibold leading-none text-white"
              style={`background:${activeFrameworkColor}`}
              aria-hidden="true"
            >
              {activeFrameworkInitial}
            </span>
            <span class="text-[13px] font-semibold leading-4 text-white">{activeFrameworkName}</span>
            <span class="font-mono text-[11px] leading-3 text-orange-400">· your inner loop</span>
            <span class="ml-auto inline-flex items-center rounded-full bg-orange-400 px-2 py-0.5 font-mono text-[10px] font-semibold uppercase leading-3 tracking-wide text-white">
              ACTIVE
            </span>
          </div>
          <div class="workspace-code-light min-w-0 overflow-x-auto">
            <Code code={code} lang="python" theme={zenmlLight as any} />
          </div>
        </div>

        {/* Swap slot */}
        <div class="flex w-full shrink-0 flex-col gap-2 lg:w-[180px]">
          <div class="flex flex-wrap gap-1.5">
            {swapChips.map((chip) => (
              <div
                class:list={[
                  "inline-flex items-center gap-1.5 rounded-md px-2 py-1",
                  chip.dashed
                    ? "border border-dashed border-gray-300 bg-white"
                    : "border border-gray-200 bg-white",
                ]}
              >
                <span
                  class="inline-flex size-3.5 items-center justify-center rounded font-mono text-[8.5px] font-semibold leading-none text-white"
                  style={`background:${chip.initialColor}`}
                  aria-hidden="true"
                >
                  {chip.initial}
                </span>
                <span class="font-mono text-[10px] font-medium leading-3 text-gray-700">{chip.name}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

  </section>
</div>

<style>
  .workspace-code-light :global(pre) {
    margin: 0;
    padding: 0;
    background: transparent !important;
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.65;
  }
  .workspace-code-light :global(code) {
    font-family: inherit;
  }
</style>
