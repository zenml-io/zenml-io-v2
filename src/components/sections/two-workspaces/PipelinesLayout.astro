---
import StepNode from "./_StepNode.astro";
import ArtifactPill from "./_ArtifactPill.astro";

/**
 * Pipelines subtab — "Same code, three destinations" (artboard 8OJ-0).
 * Left: recent pipelines list. Right: target switcher + vertical DAG with
 * fork/merge connectors illustrating data flow through artifacts.
 */

type Row = {
  initial: string;
  initialTone?: "purple" | "dark" | "purple-300";
  name: string;
  meta: string;
  target: string;
  selected?: boolean;
};

type StepSpec = { name: string; duration: string };
type ArtifactSpec = { name: string; type: string };

interface Props {
  title: string;
  countLabel: string;
  subheader: string;
  rows: ReadonlyArray<Row>;
  fileName: string;
  rightEyebrow?: string;
  rightSubhead: string;
  targets: ReadonlyArray<string>;
  activeTarget: string;
  steps: [StepSpec, StepSpec]; // [load_data, train_model]
  inputs: [ArtifactSpec, ArtifactSpec]; // [features, labels]
  output: ArtifactSpec; // churn_predictor
  footerMeta?: string;
}

const {
  title,
  countLabel,
  subheader,
  rows,
  fileName,
  rightEyebrow,
  rightSubhead,
  targets,
  activeTarget,
  steps,
  inputs,
  output,
  footerMeta,
} = Astro.props;

const glyphTone = (tone?: Row["initialTone"]) => {
  if (tone === "dark") return "bg-gray-900 text-white";
  if (tone === "purple-300") return "bg-[#d6c0ff] text-[#5b2bbf]";
  return "bg-zenml-500 text-white"; // default purple
};
---

<div class="grid grid-cols-1 gap-4 lg:grid-cols-[360px_1fr]">
  {/* Left pane — recent pipelines */}
  <aside class="flex flex-col gap-2.5 rounded-md border border-gray-200 bg-white p-4">
    <div class="flex items-start justify-between gap-3 border-b border-gray-100 pb-2">
      <div class="flex flex-col gap-0.5">
        <span class="font-mono text-[11px] uppercase leading-[14px] tracking-[0.08em] text-gray-500">
          {title}
        </span>
        <span class="text-[12px] leading-4 text-gray-500">{subheader}</span>
      </div>
      <span class="font-mono text-[11px] leading-[14px] text-gray-500">
        {countLabel}
      </span>
    </div>

    <div class="flex flex-col gap-1">
      {rows.map((row) => (
        <div
          class:list={[
            "flex items-center gap-2.5 rounded-md px-2 py-2",
            row.selected && "border border-zenml-300 bg-zenml-50",
          ]}
        >
          <span
            class:list={[
              "inline-flex size-7 shrink-0 items-center justify-center rounded-md font-mono text-[12px] font-semibold leading-none",
              glyphTone(row.initialTone),
            ]}
            aria-hidden="true"
          >
            {row.initial}
          </span>
          <div class="flex min-w-0 flex-1 flex-col gap-0.5">
            <span
              class:list={[
                "truncate text-[13px] leading-4",
                row.selected
                  ? "font-semibold text-zenml-600"
                  : "font-semibold text-gray-900",
              ]}
            >
              {row.name}
            </span>
            <span class="truncate font-mono text-[10.5px] leading-[14px] text-gray-500">
              {row.meta}
            </span>
          </div>
          <span
            class:list={[
              "inline-flex shrink-0 items-center rounded-full border px-2 py-0.5 font-mono text-[10px] font-medium leading-3",
              row.selected
                ? "border-zenml-300 bg-white text-zenml-600"
                : "border-gray-200 bg-white text-gray-600",
            ]}
          >
            {row.target}
          </span>
          {row.selected && (
            <button
              type="button"
              class="inline-flex size-6 shrink-0 cursor-pointer items-center justify-center rounded-full bg-zenml-500 text-white shadow-[0_1px_2px_rgba(15,15,18,0.18)]"
              aria-label={`Run ${row.name}`}
            >
              <svg viewBox="0 0 24 24" class="size-3" fill="currentColor" aria-hidden="true">
                <path d="M8 5v14l11-7z" />
              </svg>
            </button>
          )}
        </div>
      ))}
    </div>
  </aside>

  {/* Right pane — target switcher + DAG */}
  <section class="flex flex-col gap-4 rounded-md border border-gray-200 bg-white p-4">
    <div class="flex items-start justify-between gap-3 border-b border-gray-100 pb-2">
      <div class="flex flex-col gap-0.5">
        {rightEyebrow && (
          <span class="font-mono text-[11px] uppercase leading-[14px] tracking-[0.08em] text-gray-500">
            {rightEyebrow}
          </span>
        )}
        <span class="text-[13px] leading-[18px] text-gray-700">
          {rightSubhead}
        </span>
      </div>
      <span class="inline-flex items-center gap-1.5 rounded-full border border-gray-200 bg-white px-2.5 py-1 font-mono text-[11px] font-medium leading-[14px] text-gray-900">
        <span class="inline-block size-1.5 rounded-full bg-zenml-500" aria-hidden="true"></span>
        {fileName}
      </span>
    </div>

    {/* Target switcher */}
    <div class="flex justify-center">
      <div class="inline-flex items-center gap-0.5 rounded-md border border-gray-200 bg-gray-50 p-1">
        {targets.map((target) => {
          const isActive = target === activeTarget;
          return (
            <button
              type="button"
              class:list={[
                "inline-flex cursor-default items-center gap-1.5 rounded-sm px-3 py-1.5 font-mono text-[11px] font-medium leading-[14px] transition-colors",
                isActive
                  ? "bg-gray-900 text-white"
                  : "text-gray-600 hover:text-gray-900",
              ]}
              aria-pressed={isActive ? "true" : "false"}
            >
              {isActive && (
                <span class="inline-block size-1.5 rounded-full bg-zenml-400" aria-hidden="true"></span>
              )}
              {target}
            </button>
          );
        })}
      </div>
    </div>

    {/* DAG */}
    <div class="flex flex-1 items-center justify-center rounded-md border border-gray-100 bg-[#fafaf7] px-6 py-6">
      <div class="flex flex-col items-center gap-0">
        {/* Step 1: load_data */}
        <StepNode name={steps[0].name} duration={steps[0].duration} width="240px" />

        {/* Fork connector */}
        <svg width="240" height="56" viewBox="0 0 240 56" aria-hidden="true">
          <path d="M120 0 L120 18 Q120 28 110 28 L60 28 Q50 28 50 38 L50 56" stroke="#d1d5db" stroke-width="1" fill="none" />
          <path d="M120 18 Q120 28 130 28 L180 28 Q190 28 190 38 L190 56" stroke="#d1d5db" stroke-width="1" fill="none" />
        </svg>

        {/* Two artifact pills side-by-side */}
        <div class="flex items-center gap-10">
          <ArtifactPill name={inputs[0].name} type={inputs[0].type} width="160px" />
          <ArtifactPill name={inputs[1].name} type={inputs[1].type} width="160px" />
        </div>

        {/* Merge connector */}
        <svg width="240" height="56" viewBox="0 0 240 56" aria-hidden="true">
          <path d="M50 0 L50 18 Q50 28 60 28 L110 28 Q120 28 120 38 L120 56" stroke="#d1d5db" stroke-width="1" fill="none" />
          <path d="M190 0 L190 18 Q190 28 180 28 L130 28 Q120 28 120 38 L120 56" stroke="#d1d5db" stroke-width="1" fill="none" />
        </svg>

        {/* Step 2: train_model */}
        <StepNode name={steps[1].name} duration={steps[1].duration} width="240px" />

        {/* Down connector */}
        <svg width="2" height="28" viewBox="0 0 2 28" aria-hidden="true">
          <line x1="1" y1="0" x2="1" y2="28" stroke="#d1d5db" stroke-width="1" />
        </svg>

        {/* Output artifact */}
        <ArtifactPill name={output.name} type={output.type} width="180px" />
      </div>
    </div>

    {/* Footer meta */}
    {footerMeta && (
      <div class="flex items-center gap-3 border-t border-gray-200 pt-2">
        <span class="font-mono text-[11px] uppercase leading-[14px] tracking-[0.04em] text-gray-600">
          <span class="mr-2 inline-block size-1.5 rounded-full bg-success-500 align-middle" aria-hidden="true"></span>
          {footerMeta}
        </span>
      </div>
    )}
  </section>
</div>
