---
/**
 * ResourcesLayout — TwoWorkspaces v2 · ZenML · artboard A3N-0
 * "v2-Resources (ZenML — new)"
 *
 * Static single-state port of the Paper artboard. No interactivity — no JS,
 * no data-active-example switching. The left list renders all 5 pools; the
 * selected pool (production-gpu-pool) is highlighted. The right pane shows
 * that pool's full detail: header, 6-tile metric grid, Active Jobs list, and
 * CONNECTED footer strip.
 *
 * Data: imported from src/lib/two-workspaces/resources-data.ts
 * Layout mirrors PipelinesLayout's root: flex flex-col gap-3 outer wrapper
 * + grid grid-cols-[<left>_1fr] inner grid.
 */

import {
  ACTIVE_JOBS,
  type ActiveJob,
  CONNECTIONS,
  CONNECTIONS_ACTIVE_COUNT,
  type JobPriority,
  LEFT_HEADER,
  METRIC_TILES,
  type MetricBarColor,
  type MetricTile,
  RESOURCE_POOLS,
  type ResourcePool,
  type ResourcePoolStatus,
  SELECTED_POOL,
} from "../../../lib/two-workspaces/resources-data";

// ── Status-pill style map ──────────────────────────────────────────────────

type PillStyle = {
  bg: string;
  border: string;
  text: string;
  hasDot: boolean;
  dotColor: string;
};

const poolStatusStyle = (status: ResourcePoolStatus): PillStyle => {
  switch (status) {
    case "HIGH LOAD":
      return {
        bg: "bg-[#FFF4EC]",
        border: "border-[#FED7AA]",
        text: "text-[#C2410C]",
        hasDot: false,
        dotColor: "",
      };
    case "queued":
      return {
        bg: "bg-[#FEF3C7]",
        border: "border-[#FDE68A]",
        text: "text-[#92400E]",
        hasDot: false,
        dotColor: "",
      };
    case "active":
      return {
        bg: "bg-[#ECFDF3]",
        border: "border-[#ABEFC6]",
        text: "text-[#15803D]",
        hasDot: true,
        dotColor: "bg-[#16A34A]",
      };
    case "idle":
    default:
      return {
        bg: "bg-[#F2F4F7]",
        border: "border-[#E4E7EC]",
        text: "text-[#667085]",
        hasDot: false,
        dotColor: "",
      };
  }
};

// ── Bar color map ──────────────────────────────────────────────────────────

const barColorClass = (color: MetricBarColor): string => {
  switch (color) {
    case "amber":
      return "bg-[#FB923C]";
    case "red":
      return "bg-[#EF4444]";
    case "purple":
      return "bg-zenml-500";
    case "green":
      return "bg-[#16A34A]";
    default:
      return "bg-gray-300";
  }
};

// ── Priority badge style map ───────────────────────────────────────────────

type BadgeStyle = { bg: string; border: string; text: string };

const priorityBadgeStyle = (priority: JobPriority): BadgeStyle => {
  switch (priority) {
    case "CRITICAL":
      return {
        bg: "bg-[#FEF2F2]",
        border: "border-[#FECACA]",
        text: "text-[#B91C1C]",
      };
    case "HIGH":
      return {
        bg: "bg-[#FFF4EC]",
        border: "border-[#FED7AA]",
        text: "text-[#C2410C]",
      };
    case "MEDIUM":
      return {
        bg: "bg-[#FEF3C7]",
        border: "border-[#FDE68A]",
        text: "text-[#92400E]",
      };
  }
};
---

<div class="resources-layout flex flex-col gap-3">
  <div class="grid grid-cols-1 gap-3 lg:grid-cols-[372px_1fr]">

    {/* ── Left pane: RESOURCE POOLS list ───────────────────────────────── */}
    <aside class="flex flex-col gap-3.5 rounded-md border border-gray-200 bg-white p-4">

      {/* Header */}
      <div class="flex items-start justify-between gap-3">
        <div class="flex flex-col gap-1.5">
          <span class="font-mono text-[10px] uppercase leading-3 tracking-[0.1em] text-zenml-500">
            {LEFT_HEADER.eyebrow}
          </span>
          <span class="text-[14px] font-semibold leading-[18px] text-gray-900" style="font-family: 'Plus Jakarta Sans', system-ui, sans-serif;">
            {LEFT_HEADER.title}
          </span>
        </div>
        <span class="shrink-0 pt-0.5 font-mono text-[11px] leading-[14px] text-[#667085]">
          {LEFT_HEADER.countLabel}
        </span>
      </div>

      {/* Pool rows */}
      <div class="flex flex-col gap-1">
        {RESOURCE_POOLS.map((pool: ResourcePool) => {
          const pill = poolStatusStyle(pool.status);
          return (
            <div
              class:list={[
                "resource-pool-row flex items-center gap-3 rounded-md px-2.5 py-0 h-16",
                pool.selected
                  ? "bg-zenml-50 border border-zenml-300"
                  : "border border-transparent",
              ]}
            >
              {/* Letter badge */}
              <span
                class:list={[
                  "inline-flex size-8 shrink-0 items-center justify-center rounded-md font-mono text-[13px] font-semibold leading-4 text-white",
                  pool.selected ? "bg-zenml-500" : "bg-[#101828]",
                ]}
                aria-hidden="true"
              >
                {pool.letter}
              </span>

              {/* Name + subtitle */}
              <div class="flex min-w-0 flex-1 flex-col gap-[3px]">
                <span
                  class:list={[
                    "truncate text-[14px] leading-[18px] text-gray-900 resource-pool-name",
                    pool.selected ? "font-semibold" : "font-semibold",
                  ]}
                  style="font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
                >
                  {pool.name}
                </span>
                <span class="truncate font-mono text-[11px] leading-[14px] text-[#667085]">
                  {pool.subtitle}
                </span>
              </div>

              {/* Status pill */}
              <span
                class:list={[
                  "inline-flex shrink-0 items-center gap-[5px] rounded-full border py-[3px] px-2",
                  pill.bg,
                  pill.border,
                ]}
              >
                {pill.hasDot && (
                  <span
                    class:list={["size-[5px] shrink-0 rounded-full", pill.dotColor]}
                    aria-hidden="true"
                  />
                )}
                <span class:list={["font-mono text-[9px] font-medium leading-3 tracking-[0.04em]", pill.text]}>
                  {pool.status}
                </span>
              </span>
            </div>
          );
        })}
      </div>
    </aside>

    {/* ── Right pane: selected pool detail ─────────────────────────────── */}
    <section class="flex flex-col gap-4 rounded-md border border-gray-200 bg-white p-4">

      {/* Header: hex glyph + pool id + HIGH LOAD pill */}
      <div class="flex items-center gap-[10px]">
        {/* Hexagon glyph — matches artboard SVG exactly */}
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0" aria-hidden="true">
          <path d="M12 2.5L20.5 7.25V16.75L12 21.5L3.5 16.75V7.25L12 2.5Z" fill="#F6F2FF" stroke="#7F56D9" stroke-width="1.5" stroke-linejoin="round" />
          <path d="M9 9.5L12 8L15 9.5V12.5L12 14L9 12.5V9.5Z" fill="#7F56D9" />
        </svg>
        <span class="shrink-0 font-mono text-[11px] leading-[14px] text-[#667085]">
          {SELECTED_POOL.hexId}
        </span>
        <span
          class="shrink-0 text-[18px] font-semibold leading-[22px] text-gray-900"
          style="font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
        >
          {SELECTED_POOL.name}
        </span>
        {/* HIGH LOAD pill */}
        <span class="inline-flex shrink-0 items-center rounded-full border border-[#FED7AA] bg-[#FFF4EC] py-[3px] px-2">
          <span class="font-mono text-[9px] font-medium leading-3 tracking-[0.04em] text-[#C2410C]">
            {SELECTED_POOL.status}
          </span>
        </span>
      </div>

      {/* 6-tile metric grid — 2 rows × 3 cols */}
      <div class="flex flex-col gap-3">
        {/* Row 1: GPUs, CPU Cores, Memory */}
        <div class="grid grid-cols-3 gap-3">
          {METRIC_TILES.slice(0, 3).map((tile: MetricTile) => (
            <div class="flex flex-col gap-2.5 rounded-md border border-gray-200 bg-white p-3.5">
              <div class="flex items-center justify-between">
                <span
                  class="text-[11px] font-medium leading-[14px] text-[#344054]"
                  style="font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
                >
                  {tile.label}
                </span>
                <span
                  class:list={["text-[11px] font-semibold leading-[14px]", tile.percentageColorClass]}
                  style="font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
                >
                  {tile.percentage}
                </span>
              </div>
              <div class="flex items-baseline gap-1">
                <span
                  class="text-[28px] font-semibold leading-[30px] text-gray-900"
                  style="font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
                >
                  {tile.value}
                </span>
                <span
                  class="text-[14px] leading-[18px] text-[#667085]"
                  style="font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
                >
                  {tile.denominator}
                </span>
              </div>
              {/* Progress bar */}
              <div class="h-1 w-full shrink-0 overflow-hidden rounded-full bg-[#F2F4F7]">
                <div
                  class:list={["h-1 rounded-full", barColorClass(tile.barColor)]}
                  style={`width: ${tile.barWidthPct}%`}
                />
              </div>
            </div>
          ))}
        </div>
        {/* Row 2: Parallel Pipelines, Parallel Steps, A100 */}
        <div class="grid grid-cols-3 gap-3">
          {METRIC_TILES.slice(3, 6).map((tile: MetricTile) => (
            <div class="flex flex-col gap-2.5 rounded-md border border-gray-200 bg-white p-3.5">
              <div class="flex items-center justify-between">
                <span
                  class="text-[11px] font-medium leading-[14px] text-[#344054]"
                  style="font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
                >
                  {tile.label}
                </span>
                <span
                  class:list={["text-[11px] font-semibold leading-[14px]", tile.percentageColorClass]}
                  style="font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
                >
                  {tile.percentage}
                </span>
              </div>
              <div class="flex items-baseline gap-1">
                <span
                  class="text-[28px] font-semibold leading-[30px] text-gray-900"
                  style="font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
                >
                  {tile.value}
                </span>
                <span
                  class="text-[14px] leading-[18px] text-[#667085]"
                  style="font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
                >
                  {tile.denominator}
                </span>
              </div>
              {/* Progress bar */}
              <div class="h-1 w-full shrink-0 overflow-hidden rounded-full bg-[#F2F4F7]">
                <div
                  class:list={["h-1 rounded-full", barColorClass(tile.barColor)]}
                  style={`width: ${tile.barWidthPct}%`}
                />
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* Active Jobs section */}
      <div class="flex flex-col gap-2">
        {/* Section label with chevron-down */}
        <div class="flex items-center gap-[7px] py-0.5">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0" aria-hidden="true">
            <path d="M6 9l6 6 6-6" stroke="#667085" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span
            class="text-[13px] font-semibold leading-4 text-gray-900"
            style="font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
          >
            Active Jobs
          </span>
        </div>

        {/* Job rows */}
        <div class="flex flex-col gap-1">
          {ACTIVE_JOBS.map((job: ActiveJob) => {
            const badge = priorityBadgeStyle(job.priority);
            return (
              <div class="flex h-9 shrink-0 items-center gap-3">
                {/* Running spinner icon — orange circle with refresh arrow */}
                <span
                  class="inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-[#FB923C]"
                  aria-hidden="true"
                >
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M21 12a9 9 0 1 1-2.64-6.36M21 3v6h-6" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>

                {/* Step id + instance id — fixed-width slot */}
                <div class="flex w-[140px] shrink-0 flex-col gap-px">
                  <span
                    class="text-[12px] font-semibold leading-4 text-gray-900"
                    style="font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
                  >
                    {job.stepId}
                  </span>
                  <span class="font-mono text-[10px] leading-3 text-[#667085]">
                    {job.instanceId}
                  </span>
                </div>

                {/* Pipeline chip — fixed-width slot */}
                <div class="flex w-[150px] shrink-0">
                  <span class="inline-flex items-center rounded-[6px] bg-zenml-50 px-2 py-[3px]">
                    <span class="font-mono text-[11px] leading-[14px] text-[#5B2BBF]">
                      {job.pipelineLabel}
                    </span>
                  </span>
                </div>

                {/* Resource allocation chip — flex-grow */}
                <div class="flex min-w-0 flex-1">
                  <span class="inline-flex items-center rounded-[6px] bg-[#F2F4F7] px-2 py-[3px]">
                    <span class="font-mono text-[10px] leading-3 text-[#344054]">
                      {job.allocation}
                    </span>
                  </span>
                </div>

                {/* Elapsed time — fixed-width slot */}
                <span class="w-11 shrink-0 text-right font-mono text-[11px] leading-[14px] text-[#344054]">
                  {job.elapsed}
                </span>

                {/* Priority badge — fixed-width slot */}
                <div class="flex w-20 shrink-0 justify-end">
                  <span
                    class:list={[
                      "inline-flex items-center rounded-full border py-[3px] px-2",
                      badge.bg,
                      badge.border,
                    ]}
                  >
                    <span class:list={["font-mono text-[9px] font-medium leading-3 tracking-[0.04em]", badge.text]}>
                      {job.priority}
                    </span>
                  </span>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      {/* CONNECTED footer strip */}
      <div class="flex items-center justify-between gap-4 border-t border-gray-200 pt-3.5">
        {/* Label + chips */}
        <div class="flex flex-wrap items-center gap-2">
          <span class="shrink-0 font-mono text-[10px] font-medium leading-3 tracking-[0.08em] text-[#667085]">
            CONNECTED
          </span>
          {CONNECTIONS.map((conn: string) => (
            <span class="inline-flex items-center rounded-[6px] border border-[#E4E7EC] bg-[#F9FAFB] px-2 py-[3px]">
              <span class="font-mono text-[11px] leading-[14px] text-[#344054]">
                {conn}
              </span>
            </span>
          ))}
        </div>

        {/* Active count indicator */}
        <div class="flex shrink-0 items-center gap-1.5">
          <span class="size-1.5 shrink-0 rounded-full bg-[#16A34A]" aria-hidden="true" />
          <span
            class="text-[11px] font-medium leading-[14px] text-[#344054]"
            style="font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
          >
            {CONNECTIONS_ACTIVE_COUNT} active
          </span>
        </div>
      </div>

    </section>
  </div>
</div>
