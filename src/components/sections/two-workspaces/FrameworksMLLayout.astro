---
/**
 * FrameworksMLLayout — TwoWorkspaces v2 · ZenML · artboard A3M-0
 * "v2-FrameworksML (ZenML — replaces Integrations)"
 *
 * Layout:
 *   Left pane  — clickable ML FRAMEWORKS list (10 rows). The row list
 *     scrolls inside a capped aside height so the 10 rows never force the
 *     tab taller than the right pane. Each row: 32×32
 *     brand-color letter badge, framework name, descriptor. Selected row:
 *     bg zenml-50 + 1px zenml-300 border + "SELECTED" pill. Every row
 *     carries a transparent 1px border so selection never shifts layout.
 *
 *   Right pane — "INSIDE THE @STEP". Header (eyebrow + title + body +
 *     version chip), then a code card (traffic-light bar + filename +
 *     @step·zenml chip + tokenized code), then "WHAT ZENML GIVES YOU"
 *     pill row, then a good-fit / trade-off block.
 *
 * Interactivity:
 *   `data-active-example` on the root. CSS attribute selectors swap the
 *   right pane. Vanilla script handles row clicks. No Preact island.
 *
 * Code tokenizer:
 *   Inline regex — same TOKEN_CLASS / highlightLine / tokenize pattern
 *   as PipelinesLayout.astro. No Shiki, no astro:components <Code>.
 */

import {
  DEFAULT_FRAMEWORK_ML_EXAMPLE_ID,
  FRAMEWORK_ML_EXAMPLES,
} from "../../../lib/two-workspaces/frameworks-ml-examples";

/** Token categories → Tailwind class names (match PipelinesLayout). */
type Token = { text: string; cls: string };
const TOKEN_CLASS = {
  keyword: "text-[#F53D81]", // @step, def, return, from, import
  fn: "text-zenml-600 font-semibold", // function names after def
  ident: "text-gray-900", // everything else
  muted: "text-gray-500", // comments, import paths, return values
};

const highlightLine = (line: string): Token[] => {
  const trimmed = line.replace(/\s+$/, "");
  if (trimmed.length === 0) return [{ text: "", cls: "" }];

  // @step / @pipeline decorators — full line in keyword color
  if (trimmed.trimStart().startsWith("@")) {
    const indent = trimmed.match(/^\s*/)?.[0] ?? "";
    return [
      { text: indent, cls: "" },
      { text: trimmed.trim(), cls: TOKEN_CLASS.keyword },
    ];
  }

  // def fn(args) -> Ret:
  const defMatch = trimmed.match(/^(\s*)(def)\s+(\w+)(.*)$/);
  if (defMatch) {
    return [
      { text: defMatch[1], cls: "" },
      { text: "def ", cls: TOKEN_CLASS.keyword },
      { text: defMatch[3], cls: TOKEN_CLASS.fn },
      { text: defMatch[4], cls: TOKEN_CLASS.ident },
    ];
  }

  // return ...
  const retMatch = trimmed.match(/^(\s*)(return)\s+(.+)$/);
  if (retMatch) {
    return [
      { text: retMatch[1], cls: "" },
      { text: "return ", cls: TOKEN_CLASS.keyword },
      { text: retMatch[3], cls: TOKEN_CLASS.muted },
    ];
  }

  // from X import Y / import X
  const importMatch = trimmed.match(/^(\s*)(from|import)\s+(.+)$/);
  if (importMatch) {
    return [
      { text: importMatch[1], cls: "" },
      { text: `${importMatch[2]} `, cls: TOKEN_CLASS.keyword },
      { text: importMatch[3], cls: TOKEN_CLASS.muted },
    ];
  }

  // # comments
  if (trimmed.trimStart().startsWith("#")) {
    return [{ text: trimmed, cls: TOKEN_CLASS.muted }];
  }

  return [{ text: trimmed, cls: TOKEN_CLASS.ident }];
};

const tokenize = (source: string) => source.split("\n").map(highlightLine);

const examples = FRAMEWORK_ML_EXAMPLES;
const defaultId = DEFAULT_FRAMEWORK_ML_EXAMPLE_ID;
---

<div
  class="frameworks-layout flex flex-col gap-3"
  data-active-example={defaultId}
>
  <div class="grid grid-cols-1 gap-3 lg:grid-cols-[360px_1fr]">

    {/* ================================================================ */}
    {/* LEFT PANE — ML FRAMEWORKS list                                   */}
    {/* ================================================================ */}
    <aside class="flex max-h-[475px] flex-col gap-0 rounded-md border border-gray-200 bg-white">

      {/* Pane header */}
      <div
        class="flex items-end justify-between border-b border-[#F2F4F7] px-4 pb-2.5 pt-3"
        style="padding-left: 12px; padding-right: 12px;"
      >
        <div class="flex flex-col gap-1">
          <span
            class="font-mono text-[11px] uppercase leading-[14px] tracking-[0.12em] text-gray-500"
            style="font-family: 'JetBrains Mono', monospace;"
          >
            ML Frameworks
          </span>
          <span
            class="text-[14px] font-semibold leading-5 text-[#101828]"
            style="font-family: 'Plus Jakarta Sans', sans-serif;"
          >
            Fits the stack you already have.
          </span>
        </div>
        <span
          class="pb-0.5 font-mono text-[11px] leading-[14px] text-gray-400"
          style="font-family: 'JetBrains Mono', monospace;"
        >
          10 supported
        </span>
      </div>

      {/* Framework rows — scroll inside the capped aside height */}
      <div class="flex min-h-0 flex-1 flex-col overflow-y-auto overscroll-contain px-2 py-2">
        {examples.map((ex) => (
          <button
            type="button"
            data-example-id={ex.id}
            data-framework-row
            aria-label={`Show ${ex.name} example`}
            class="framework-row group flex w-full cursor-pointer items-center gap-3 rounded-md px-2 py-2.5 text-left transition-colors hover:bg-gray-50"
          >
            {/* 32×32 brand-color badge */}
            <span
              class="inline-flex size-8 shrink-0 items-center justify-center rounded-md"
              aria-hidden="true"
              style={`background-color: ${ex.badgeColor};`}
            >
              <span
                class="font-mono text-[13px] font-bold leading-4 tracking-[-0.03em]"
                style={`color: ${ex.badgeTextColor}; font-family: 'JetBrains Mono', monospace;`}
              >
                {ex.badgeLetter}
              </span>
            </span>

            {/* Name + descriptor */}
            <div class="flex min-w-0 flex-1 flex-col gap-[1px]">
              <span
                class="framework-row-label block truncate text-[14px] leading-[18px] font-semibold text-[#101828]"
                style="font-family: 'Plus Jakarta Sans', sans-serif;"
              >
                {ex.name}
              </span>
              <span
                class="block truncate font-mono text-[11px] leading-[14px] text-[#667085]"
                style="font-family: 'JetBrains Mono', monospace;"
              >
                {ex.descriptor}
              </span>
            </div>

            {/* SELECTED badge — visible only on the active row */}
            <span
              class="framework-row-selected-badge inline-flex shrink-0 items-center rounded-[4px] bg-[#E9D7FE] px-[7px] py-[3px]"
            >
              <span
                class="font-mono text-[10px] font-medium leading-[12px] tracking-[0.04em] text-[#5B2BBF]"
                style="font-family: 'JetBrains Mono', monospace;"
              >
                SELECTED
              </span>
            </span>
          </button>
        ))}
      </div>
    </aside>

    {/* ================================================================ */}
    {/* RIGHT PANE — INSIDE THE @STEP                                    */}
    {/* ================================================================ */}
    <section class="flex flex-col gap-3 rounded-md border border-gray-200 bg-white p-3.5">
      {examples.map((ex) => {
        const codeLines = tokenize(ex.codeSource);
        return (
          <div
            data-example-id={ex.id}
            class="framework-pane flex flex-col gap-2.5"
          >
            {/* Header strip -------------------------------------------- */}
            <div class="flex items-start justify-between gap-6">
              {/* Eyebrow + title + body */}
              <div class="flex min-w-0 flex-1 flex-col gap-1">
                <span
                  class="font-mono text-[10px] uppercase leading-[12px] tracking-[0.1em] text-[#7F56D9]"
                  style="font-family: 'JetBrains Mono', monospace;"
                >
                  {ex.eyebrow}
                </span>
                <span
                  class="text-sm font-semibold leading-5 tracking-[-0.01em] text-[#101828]"
                  style="font-family: 'Plus Jakarta Sans', sans-serif;"
                >
                  {ex.title}
                </span>
                <span
                  class="text-[13px] font-medium leading-[18px] text-[#475467]"
                  style="font-family: 'Plus Jakarta Sans', sans-serif; max-width: 560px;"
                >
                  {ex.body}
                </span>
              </div>

              {/* Version chip */}
              <span
                class="inline-flex shrink-0 items-center gap-1.5 rounded-md border border-[#E4E7EC] bg-[#F9FAFB] px-[10px] py-[6px]"
              >
                <span
                  class="size-1.5 shrink-0 rounded-full bg-[#12B76A]"
                  aria-hidden="true"
                ></span>
                <span
                  class="font-mono text-[11px] font-medium leading-[14px] tracking-[0.02em] text-[#101828]"
                  style="font-family: 'JetBrains Mono', monospace;"
                >
                  {ex.versionChip}
                </span>
              </span>
            </div>

            {/* Code card ----------------------------------------------- */}
            <div
              class="flex flex-col overflow-hidden rounded-md border border-[#E4E7EC]"
              style="background-color: #FAFAFA;"
            >
              {/* Traffic-light bar */}
              <div
                class="flex items-center justify-between border-b border-[#E4E7EC] bg-white px-[14px] py-[9px]"
              >
                <div class="flex items-center gap-1.5">
                  <span class="size-[9px] shrink-0 rounded-full bg-[#FB7185]" aria-hidden="true"></span>
                  <span class="size-[9px] shrink-0 rounded-full bg-[#FBBF24]" aria-hidden="true"></span>
                  <span class="size-[9px] shrink-0 rounded-full bg-[#34D399]" aria-hidden="true"></span>
                  <span
                    class="ml-[10px] font-mono text-[12px] font-medium leading-[16px] text-[#667085]"
                    style="font-family: 'JetBrains Mono', monospace;"
                  >
                    {ex.codeFilename}
                  </span>
                </div>
                {/* @step · zenml chip */}
                <span class="flex items-center gap-1.5">
                  <span
                    class="size-1.5 shrink-0 rounded-full bg-[#7F56D9]"
                    aria-hidden="true"
                  ></span>
                  <span
                    class="font-mono text-[11px] font-medium leading-[14px] tracking-[0.04em] text-[#5B2BBF]"
                    style="font-family: 'JetBrains Mono', monospace;"
                  >
                    @step · zenml
                  </span>
                </span>
              </div>

              {/* Code body */}
              <pre
                class="flex flex-col overflow-x-auto bg-white px-3.5 py-3 font-mono"
                style="font-family: 'JetBrains Mono', monospace;"
              ><code class="text-[10px] leading-[16px]">{codeLines.map((tokens) => (<span class="block">{tokens.length === 1 && tokens[0].text === "" ? <span>&nbsp;</span> : tokens.map((t) => (<span class={t.cls}>{t.text}</span>))}</span>))}</code></pre>
            </div>

            {/* WHAT ZENML GIVES YOU pills ------------------------------ */}
            <div class="flex flex-wrap items-center gap-1.5">
              <span
                class="mr-1 font-mono text-[11px] font-medium uppercase leading-[14px] tracking-[0.08em] text-[#667085]"
                style="font-family: 'JetBrains Mono', monospace;"
              >
                What ZenML gives you
              </span>
              {ex.pills.map((pill) => (
                <span
                  class="inline-flex items-center gap-1.5 rounded-full border border-[#E9D7FE] bg-[#F6F2FF] px-3 py-1"
                >
                  <span
                    class="inline-flex size-[14px] shrink-0 items-center justify-center rounded-full bg-[#7F56D9]"
                    aria-hidden="true"
                  >
                    <span
                      class="font-mono text-[9px] font-bold leading-3 text-white"
                      style="font-family: 'JetBrains Mono', monospace;"
                    >
                      {pill.letter}
                    </span>
                  </span>
                  <span
                    class="text-[12px] font-semibold leading-4 tracking-[0.01em] text-[#5B2BBF]"
                    style="font-family: 'Plus Jakarta Sans', sans-serif;"
                  >
                    {pill.label}
                  </span>
                </span>
              ))}
            </div>

            {/* Good fit / trade-off — honest pros & cons --------------- */}
            <div
              class="flex flex-col gap-2 rounded-md border border-[#E4E7EC] bg-white px-[14px] py-3"
            >
              {/* Good fit */}
              <div class="flex items-start gap-2">
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="#7F56D9"
                  stroke-width="2.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="mt-px shrink-0"
                  aria-hidden="true"
                >
                  <polyline points="20 6 9 17 4 12" />
                </svg>
                <span
                  class="w-[64px] shrink-0 font-mono text-[10px] font-semibold uppercase leading-4 tracking-[0.08em] text-[#5B2BBF]"
                  style="font-family: 'JetBrains Mono', monospace;"
                >
                  Good fit
                </span>
                <span
                  class="flex-1 text-[12px] font-medium leading-4 text-[#475467]"
                  style="font-family: 'Plus Jakarta Sans', sans-serif;"
                >
                  {ex.goodFit}
                </span>
              </div>
              {/* Trade-off */}
              <div class="flex items-start gap-2">
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="#98897A"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="mt-px shrink-0"
                  aria-hidden="true"
                >
                  <path d="M12 4 L22 20 L2 20 Z" />
                </svg>
                <span
                  class="w-[64px] shrink-0 font-mono text-[10px] font-semibold uppercase leading-4 tracking-[0.08em] text-[#667085]"
                  style="font-family: 'JetBrains Mono', monospace;"
                >
                  Trade-off
                </span>
                <span
                  class="flex-1 text-[12px] font-medium leading-4 text-[#475467]"
                  style="font-family: 'Plus Jakarta Sans', sans-serif;"
                >
                  {ex.tradeOff}
                </span>
              </div>
            </div>
          </div>
        );
      })}
    </section>
  </div>
</div>

<style>
  /* ------------------------------------------------------------------ */
  /* RIGHT PANE — show only the active example pane                     */
  /* ------------------------------------------------------------------ */
  .frameworks-layout [data-example-id].framework-pane {
    display: none;
  }
  .frameworks-layout[data-active-example="pytorch"]      [data-example-id="pytorch"].framework-pane,
  .frameworks-layout[data-active-example="tensorflow"]   [data-example-id="tensorflow"].framework-pane,
  .frameworks-layout[data-active-example="sklearn"]      [data-example-id="sklearn"].framework-pane,
  .frameworks-layout[data-active-example="pandas"]       [data-example-id="pandas"].framework-pane,
  .frameworks-layout[data-active-example="huggingface"]  [data-example-id="huggingface"].framework-pane,
  .frameworks-layout[data-active-example="xgboost"]      [data-example-id="xgboost"].framework-pane,
  .frameworks-layout[data-active-example="lightgbm"]     [data-example-id="lightgbm"].framework-pane,
  .frameworks-layout[data-active-example="numpy"]        [data-example-id="numpy"].framework-pane,
  .frameworks-layout[data-active-example="polars"]       [data-example-id="polars"].framework-pane,
  .frameworks-layout[data-active-example="wandb"]        [data-example-id="wandb"].framework-pane {
    display: flex;
  }

  /* ------------------------------------------------------------------ */
  /* LEFT PANE — selected-row chrome                                    */
  /*                                                                    */
  /* Every row carries border: 1px solid transparent so selecting a    */
  /* row never causes a layout shift (no thick left rail antipattern). */
  /* Selected row: zenml-50 bg + 1px zenml-300 border + bold label.   */
  /* SELECTED badge hidden by default; shown only on active row.       */
  /* ------------------------------------------------------------------ */
  .framework-row[data-example-id] {
    border: 1px solid transparent;
  }
  .framework-row[data-example-id] .framework-row-selected-badge {
    display: none;
  }

  /* Selected row state — one rule per framework id */
  .frameworks-layout[data-active-example="pytorch"]
    .framework-row[data-example-id="pytorch"],
  .frameworks-layout[data-active-example="tensorflow"]
    .framework-row[data-example-id="tensorflow"],
  .frameworks-layout[data-active-example="sklearn"]
    .framework-row[data-example-id="sklearn"],
  .frameworks-layout[data-active-example="pandas"]
    .framework-row[data-example-id="pandas"],
  .frameworks-layout[data-active-example="huggingface"]
    .framework-row[data-example-id="huggingface"],
  .frameworks-layout[data-active-example="xgboost"]
    .framework-row[data-example-id="xgboost"],
  .frameworks-layout[data-active-example="lightgbm"]
    .framework-row[data-example-id="lightgbm"],
  .frameworks-layout[data-active-example="numpy"]
    .framework-row[data-example-id="numpy"],
  .frameworks-layout[data-active-example="polars"]
    .framework-row[data-example-id="polars"],
  .frameworks-layout[data-active-example="wandb"]
    .framework-row[data-example-id="wandb"] {
    background: var(--color-zenml-50);
    border-color: var(--color-zenml-300);
  }

  /* Bold the label on the selected row */
  .frameworks-layout[data-active-example="pytorch"]
    .framework-row[data-example-id="pytorch"] .framework-row-label,
  .frameworks-layout[data-active-example="tensorflow"]
    .framework-row[data-example-id="tensorflow"] .framework-row-label,
  .frameworks-layout[data-active-example="sklearn"]
    .framework-row[data-example-id="sklearn"] .framework-row-label,
  .frameworks-layout[data-active-example="pandas"]
    .framework-row[data-example-id="pandas"] .framework-row-label,
  .frameworks-layout[data-active-example="huggingface"]
    .framework-row[data-example-id="huggingface"] .framework-row-label,
  .frameworks-layout[data-active-example="xgboost"]
    .framework-row[data-example-id="xgboost"] .framework-row-label,
  .frameworks-layout[data-active-example="lightgbm"]
    .framework-row[data-example-id="lightgbm"] .framework-row-label,
  .frameworks-layout[data-active-example="numpy"]
    .framework-row[data-example-id="numpy"] .framework-row-label,
  .frameworks-layout[data-active-example="polars"]
    .framework-row[data-example-id="polars"] .framework-row-label,
  .frameworks-layout[data-active-example="wandb"]
    .framework-row[data-example-id="wandb"] .framework-row-label {
    font-weight: 600;
  }

  /* Show SELECTED badge on the active row */
  .frameworks-layout[data-active-example="pytorch"]
    .framework-row[data-example-id="pytorch"] .framework-row-selected-badge,
  .frameworks-layout[data-active-example="tensorflow"]
    .framework-row[data-example-id="tensorflow"] .framework-row-selected-badge,
  .frameworks-layout[data-active-example="sklearn"]
    .framework-row[data-example-id="sklearn"] .framework-row-selected-badge,
  .frameworks-layout[data-active-example="pandas"]
    .framework-row[data-example-id="pandas"] .framework-row-selected-badge,
  .frameworks-layout[data-active-example="huggingface"]
    .framework-row[data-example-id="huggingface"] .framework-row-selected-badge,
  .frameworks-layout[data-active-example="xgboost"]
    .framework-row[data-example-id="xgboost"] .framework-row-selected-badge,
  .frameworks-layout[data-active-example="lightgbm"]
    .framework-row[data-example-id="lightgbm"] .framework-row-selected-badge,
  .frameworks-layout[data-active-example="numpy"]
    .framework-row[data-example-id="numpy"] .framework-row-selected-badge,
  .frameworks-layout[data-active-example="polars"]
    .framework-row[data-example-id="polars"] .framework-row-selected-badge,
  .frameworks-layout[data-active-example="wandb"]
    .framework-row[data-example-id="wandb"] .framework-row-selected-badge {
    display: inline-flex;
  }
</style>

<script>
  /**
   * Row-click handler — sets `data-active-example` on the layout root.
   * CSS attribute selectors handle all visual switching (right-pane content
   * + selected-row chrome). Pure DOM, no Preact island.
   */
  const layouts = document.querySelectorAll<HTMLElement>(".frameworks-layout");
  layouts.forEach((layout) => {
    const rows = layout.querySelectorAll<HTMLButtonElement>(
      "[data-framework-row]"
    );
    rows.forEach((row) => {
      row.addEventListener("click", () => {
        const id = row.dataset.exampleId;
        if (id) layout.dataset.activeExample = id;
      });
    });
  });
</script>
