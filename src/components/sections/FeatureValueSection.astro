---
import Split from "../system/layout/Split.astro";
/**
 * FeatureValueSection — a two-column section with text + image.
 *
 * Renders one "value block" from the feature page: heading, body,
 * bullet list, and a screenshot/illustration. Image side alternates.
 *
 * Matches Webflow's uui-layout08 section: 48px heading, circle-check
 * bullets in ZenML purple, 4rem grid gap, 4rem vertical padding.
 */
import SectionIntro from "../system/SectionIntro.astro";

interface Props {
  eyebrow?: string;
  title: string;
  body?: string;
  bullets?: string[];
  learnMoreHref?: string;
  learnMoreLabel?: string;
  image?: { url: string; alt?: string };
  imageSide?: "left" | "right";
}

const {
  eyebrow,
  title,
  body,
  bullets,
  learnMoreHref,
  learnMoreLabel = "Learn More",
  image,
  imageSide = "right",
} = Astro.props;
const isImageLeft = imageSide === "left";
---

<section class="bg-white py-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <Split
      mediaSide={isImageLeft ? "left" : "right"}
      space={{ base: "mlg", lg: "xl" }}
    >
      {/* lg:ml-auto: with media on the left, the width-capped prose box
          right-aligns in its lane so the two lanes stay mirror-symmetric. */}
      <div class:list={["max-w-[80%]", isImageLeft && "lg:ml-auto"]} data-reveal>
        <SectionIntro
          eyebrow={eyebrow}
          heading={title}
          description={body}
          classOverrides={{
            heading:
              "text-3xl font-semibold text-gray-900 leading-tight sm:text-[2.75rem] lg:text-[3rem]",
            headingSpacing: eyebrow ? "mt-3" : "",
          }}
        />
        {bullets && bullets.length > 0 && (
          <ul class="mt-8 space-y-5">
            {bullets.map((item) => (
              <li class="flex items-start gap-3 text-gray-600">
                <svg class="mt-0.5 h-7 w-7 flex-shrink-0" viewBox="0 0 28 29" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M8.75 14.38l3.5 3.5 7-7m6.417 3.5c0 6.443-5.224 11.667-11.667 11.667S2.333 20.823 2.333 14.38 7.557 2.713 14 2.713s11.667 5.224 11.667 11.667z" stroke="#7A3EF4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="text-base leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>
        )}
        {learnMoreHref && (
          <a href={learnMoreHref} class="mt-6 inline-flex items-center gap-2 text-base font-semibold text-zenml-500 transition-colors hover:text-zenml-600">
            {learnMoreLabel}
            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638l-3.47-3.47a.75.75 0 1 1 1.06-1.06l4.773 4.773a.748.748 0 0 1 0 1.014l-4.773 4.773a.75.75 0 0 1-1.06-1.06l3.47-3.47H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
          </a>
        )}
      </div>
      {image?.url && (
        <div slot="media" class="overflow-hidden rounded-lg" data-reveal>
          <img
            src={image.url}
            alt={image.alt || title}
            class="w-full"
            loading="lazy"
          />
        </div>
      )}
    </Split>
  </div>
</section>
