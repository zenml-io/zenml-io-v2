---
/**
 * IntegrationsMarquee — infinite horizontal scroll of integration logos.
 *
 * Pattern A (two-product, unified section):
 * - Headline and subheadline are product-neutral ("any framework", both ecosystems).
 * - ZenML integrations marquee (60+ from the integrations collection).
 * - Kitaru agent frameworks listed as a compact labeled pill row below.
 * - Single CTA pair pointing to /get-started and /integrations.
 *
 * Fetches logos from the integrations content collection and renders
 * them in a CSS-animated marquee strip. The strip is duplicated for
 * seamless looping. Pauses on hover.
 */
import { getCollection } from "astro:content";
import { INTEGRATIONS_MARQUEE } from "../../lib/homepage";
import Button from "../Button.astro";

type LogoItem = {
  name: string;
  src: string;
  alt: string;
  href: string;
};

const integrations = await getCollection(
  "integrations",
  ({ data }) => !data.draft,
);
const logos: LogoItem[] = integrations.flatMap((i) => {
  const logo = i.data.logo;
  if (!logo?.url) {
    return [];
  }

  return [
    {
      name: i.data.title,
      src: logo.url,
      alt: logo.alt || i.data.title,
      href: `/integrations/${i.data.slug}`,
    },
  ];
});

const marqueeItems = [
  ...logos.map((logo) => ({ ...logo, isDuplicate: false })),
  ...logos.map((logo) => ({ ...logo, isDuplicate: true })),
];
---

<section class="relative overflow-hidden bg-white bg-cover bg-center border-t border-gray-200 pt-16 pb-16 sm:pt-20 sm:pb-20 scroll-reveal-section" style="background-image: url('/images/zenml_light_bg-02.avif')">
  <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
    <div class="scroll-slide-top">
      <h2 class="text-3xl font-bold text-gray-900 sm:text-4xl">
        {INTEGRATIONS_MARQUEE.headline}
      </h2>
      <p class="mt-3 text-lg text-gray-600">{INTEGRATIONS_MARQUEE.subheadline}</p>
    </div>
  </div>

  <!-- ZenML integrations marquee -->
  <div class="group relative mt-10 scroll-fade-in stagger-1">
    <!-- Product label -->
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="mb-4 text-xs font-semibold uppercase tracking-wider text-zenml-500">ZenML — 60+ ML integrations</p>
    </div>
    <!-- Fade edges -->
    <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-white/80 to-transparent"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-white/80 to-transparent"></div>

    <div
      class="flex animate-marquee gap-4"
    >
      {/* Render logos twice for seamless loop */}
      {marqueeItems.map((logo) => (
        <a
          href={logo.href}
          class="flex h-[60px] w-[60px] flex-shrink-0 items-center justify-center rounded-lg border-2 border-gray-200 bg-white transition-all duration-200 hover:scale-[1.3] hover:border-zenml-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zenml-500"
          aria-hidden={logo.isDuplicate ? "true" : undefined}
          tabindex={logo.isDuplicate ? -1 : undefined}
        >
          <img
            src={logo.src}
            alt={logo.alt}
            class="h-10 w-10 object-contain"
            width="40"
            height="40"
            loading="lazy"
          />
        </a>
      ))}
    </div>
  </div>

  <!-- Kitaru agent frameworks — text pill row -->
  <div class="mx-auto mt-8 max-w-7xl px-4 sm:px-6 lg:px-8 scroll-fade-in stagger-2">
    <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-orange-700">Kitaru — agent framework compatible</p>
    <div class="flex flex-wrap gap-2">
      {INTEGRATIONS_MARQUEE.agentFrameworks.map((name) => (
        <span class="inline-flex items-center rounded-md border border-gray-200 bg-white px-3 py-1 text-sm font-medium text-gray-700">
          {name}
        </span>
      ))}
    </div>
  </div>

  <!-- CTAs -->
  <div class="mt-10 flex flex-wrap justify-center gap-4 scroll-fade-in stagger-2">
    <Button href={INTEGRATIONS_MARQUEE.primaryCta.href} size="lg">
      {INTEGRATIONS_MARQUEE.primaryCta.label}
    </Button>
    <Button href={INTEGRATIONS_MARQUEE.secondaryCta.href} variant="secondary" size="lg">
      {INTEGRATIONS_MARQUEE.secondaryCta.label}
    </Button>
  </div>

</section>

<style>
  @keyframes marquee-slide {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  .animate-marquee {
    animation: marquee-slide 150s linear infinite;
    width: max-content;
  }
  .group:hover .animate-marquee,
  .group:focus-within .animate-marquee {
    animation-play-state: paused;
  }

  /* Scroll reveal */
  .scroll-slide-top {
    opacity: 0;
    transform: translateY(-24px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
  .scroll-fade-in {
    opacity: 0;
    transition: opacity 0.8s ease-out;
  }
  .stagger-1 { transition-delay: 0.15s; }
  .stagger-2 { transition-delay: 0.3s; }
  .scroll-reveal-section.in-view .scroll-slide-top,
  .scroll-reveal-section.in-view .scroll-fade-in {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-marquee {
      animation: none;
    }
    .scroll-slide-top,
    .scroll-fade-in {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.scroll-reveal-section').forEach((section) => {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          section.classList.add('in-view');
          observer.disconnect();
        }
      },
      { threshold: 0.1 }
    );
    observer.observe(section);
  });
</script>
