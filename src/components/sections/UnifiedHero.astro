---
import {
  HOMEPAGE_INSTALL_COMMANDS,
  HOMEPAGE_UNIFIED_HERO,
} from "../../lib/homepage-unified";
import { brandButtonClass } from "../../lib/productCtas";
import Button from "../Button.astro";

/**
 * UnifiedHero — hero for the unified `/` (Variant C copy).
 *
 * Matches the existing homepage Hero.astro structure exactly — same
 * gradient surface, container widths, type scale, and Button component
 * — but renders the unified copy (no Lottie below; the
 * TwoWorkspaces widget plays that role on the unified page).
 *
 * Reads from `HOMEPAGE_UNIFIED_HERO` in src/lib/homepage-unified.ts.
 * Both signup buttons are `primary`; `brandButtonClass` turns the Kitaru one orange.
 */

const {
  headlinePrefix,
  headlineAccent,
  headlineSuffix,
  subtitle,
  productCtas,
} = HOMEPAGE_UNIFIED_HERO;
const headline = `${headlinePrefix}${headlineAccent}${headlineSuffix}`;
---

<header class="relative overflow-hidden pb-8 pt-12 sm:pb-12 sm:pt-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl lg:text-[3.5rem] lg:leading-[1.1]">
        {headline}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-gray-600 sm:text-xl">
        {subtitle}
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        {productCtas.map((cta) => (
          <Button
            href={cta.href}
            variant={cta.variant ?? "primary"}
            size="lg"
            class={brandButtonClass(cta.brand)}
            dataAnalytics={cta.analytics}
          >
            {cta.label}
          </Button>
        ))}
      </div>

      {/* Install lines: the terminal is the front door for both products. */}
      <ul class="mt-5 flex flex-col items-stretch gap-2 sm:flex-row sm:flex-wrap sm:items-center sm:justify-center">
        {HOMEPAGE_INSTALL_COMMANDS.map((item) => (
          <li class="flex items-center gap-2.5 rounded-md border border-gray-200 bg-white px-3 py-2.5 text-left font-mono text-[13px] leading-snug shadow-sm sm:w-auto sm:leading-none">
            <span
              class={[
                "shrink-0 rounded px-1.5 py-1 text-[10px] font-semibold uppercase leading-none tracking-[0.12em]",
                item.brand === "kitaru"
                  ? "bg-orange-100 text-orange-700"
                  : "bg-zenml-100 text-zenml-700",
              ].join(" ")}
            >
              {item.label}
            </span>
            <span class="shrink-0 text-gray-400" aria-hidden="true">$</span>
            <code class="min-w-0 break-all text-gray-900 sm:whitespace-nowrap">{item.cmd}</code>
            <button
              type="button"
              class="ml-auto inline-flex shrink-0 items-center pl-1 text-gray-400 transition-colors hover:text-gray-800"
              aria-label={`Copy ${item.label} install command`}
              data-copy={item.cmd}
              data-analytics={`Home-Hero-Install-${item.label}`}
            >
              <svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg>
              <svg class="check-icon hidden text-green-600" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </div>
</header>

<script>
  // Copy-to-clipboard for the hero install lines; swaps the icon briefly.
  document.querySelectorAll<HTMLButtonElement>("header [data-copy]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const text = btn.dataset.copy;
      if (!text) return;
      navigator.clipboard?.writeText(text).then(() => {
        btn.querySelector(".copy-icon")?.classList.add("hidden");
        btn.querySelector(".check-icon")?.classList.remove("hidden");
        setTimeout(() => {
          btn.querySelector(".copy-icon")?.classList.remove("hidden");
          btn.querySelector(".check-icon")?.classList.add("hidden");
        }, 1500);
      });
    });
  });
</script>
