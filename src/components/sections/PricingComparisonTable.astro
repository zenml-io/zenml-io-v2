---
/**
 * PricingComparisonTable — sectioned feature comparison with ✓/✗ icons.
 *
 * Thin adapter from the pricing page's data shape onto `SpecTable`
 * (`data-display.spec-table`). Used on /pricing — one instance per
 * workspace, swapped by the plan-cards workspace toggle.
 */
import type { PricingCompareTableData } from "../../lib/marketingPageTypes";
import SpecTable from "../templates/SpecTable.astro";

interface Props {
  data: PricingCompareTableData;
}

const { data } = Astro.props;
---

<SpecTable
  heading={data.heading}
  subheading={data.subheading}
  rowHeaderLabel="Plans"
  columns={data.columnHeaders}
  sections={data.sections.map((section) => ({
    heading: section.heading,
    rows: section.rows.map((row) => ({
      label: row.feature,
      href: row.link,
      values: row.values,
    })),
  }))}
  actions={data.ctaButtons.map((cta) => ({
    label: cta.label,
    href: cta.href,
    variant: cta.variant ?? "primary",
    analytics: cta.analytics,
  }))}
/>
