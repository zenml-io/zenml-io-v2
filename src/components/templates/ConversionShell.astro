---
/**
 * ConversionShell — hero + widget shell for conversion-utility pages
 * (Cal.com scheduling embeds and short lead-capture forms).
 *
 * Two arrangements selected by `frame`. Their section/wrapper structures
 * are unrelated, but the inner h1 + deck block is the same markup in both
 * branches — duplicated deliberately (Astro has no local partials; a
 * separate component for two lines isn't worth it). Keep the two copies
 * in sync when editing the hero block.
 *
 * `calendar` renders two sections — a centered `max-w-3xl` hero band, then
 * a wider `max-w-5xl` band housing the widget — matching the Cal-hero
 * trio (`success-calendar`, `book-a-demo-success`, `schedule-a-demo`).
 * `form` renders one `max-w-xl` section with the hero block sitting
 * directly above the widget, matching the short-form pages
 * (`book-a-demo`, `signup-for-demo`). The default slot is the widget
 * itself (a `CalEmbed` or a `ContactForm` island) in both arrangements.
 *
 * Absence collapses: an omitted `deck` renders no `<p>`.
 */
export interface Props {
  headline: string;
  deck?: string;
  frame: "calendar" | "form";
}

const { headline, deck, frame } = Astro.props;
---

{
  frame === "calendar" ? (
    <>
      <section class="bg-white pt-16 pb-4 sm:pt-24 sm:pb-8">
        <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
          <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl">
            {headline}
          </h1>
          {deck && <p class="mt-3 text-lg text-gray-600">{deck}</p>}
        </div>
      </section>

      <section class="bg-white pb-16 sm:pb-20">
        <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
          <slot />
        </div>
      </section>
    </>
  ) : (
    <section class="bg-white py-16 sm:py-24">
      <div class="mx-auto max-w-xl px-4 sm:px-6 lg:px-8">
        <div class="mb-8 text-center">
          <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl">
            {headline}
          </h1>
          {deck && <p class="mt-3 text-lg text-gray-600">{deck}</p>}
        </div>
        <slot />
      </div>
    </section>
  )
}
