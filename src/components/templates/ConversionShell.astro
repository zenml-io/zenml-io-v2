---
/**
 * ConversionShell — hero + widget shell for conversion-utility pages
 * (Cal.com scheduling embeds and short lead-capture forms).
 *
 * Two arrangements selected by `frame`. Their section/wrapper structures
 * are unrelated, but the inner h1 + deck block is the same markup in both
 * branches — duplicated deliberately (Astro has no local partials; a
 * separate component for two lines isn't worth it). Keep the two copies
 * in sync when editing the hero block.
 *
 * `calendar` renders the shared Labs interior band, then a cream section
 * housing the widget — matching the two canonical calendar pages
 * (`success-calendar`, `schedule-a-demo`).
 * `form` renders one `max-w-xl` section with the hero block sitting
 * directly above the widget, matching the short-form pages
 * (`book-a-demo`, `signup-for-demo`). The default slot is the widget
 * itself (a `CalEmbed` or a `ContactForm` island) in both arrangements.
 *
 * Absence collapses: an omitted `deck` renders no `<p>`.
 */
import LabsBand from "../labs/LabsBand.astro";

interface ConversionShellBase {
  headline: string;
  deck?: string;
}

type Props =
  | (ConversionShellBase & { frame: "calendar" })
  | (ConversionShellBase & { frame: "form" });

const { headline, deck, frame } = Astro.props;
---

{
  frame === "calendar" ? (
    <>
      <LabsBand size="short">
        <div class="max-w-3xl">
          <h1 class="font-display text-[44px] leading-[48px] text-foreground md:text-[72px] md:leading-[78px]">
            {headline}
          </h1>
          {deck && (
            <p class="mt-6 max-w-2xl font-sans text-xl leading-[30px] text-(--color-cream-700)">
              {deck}
            </p>
          )}
        </div>
      </LabsBand>

      <section class="bg-(--color-cream-50) pt-space-xs pb-space-xl md:pb-space-xxl">
        <div class="mx-auto max-w-content px-gutter">
          <slot />
        </div>
      </section>
    </>
  ) : (
    <section class="bg-(--color-cream-50) py-space-xl md:py-space-xxl">
      <div class="mx-auto max-w-content px-gutter">
        <div class="mb-8 text-center">
          <h1 class="font-display text-[44px] leading-[48px] text-foreground md:text-[72px] md:leading-[78px]">
            {headline}
          </h1>
          {deck && (
            <p class="mt-6 font-sans text-xl leading-[30px] text-(--color-cream-700)">
              {deck}
            </p>
          )}
        </div>
        <slot />
      </div>
    </section>
  )
}
