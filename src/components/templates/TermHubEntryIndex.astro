---
/**
 * TermHubEntryIndex — the database-side term-page listing (issue #249).
 *
 * Covers `/llmops-tags/[slug]`, `/mlops-tags/[slug]`, and
 * `/industry-tags/[slug]` (`entries` arrangement, `skin="labs"`, databases
 * cutover #256), plus `/tags/[slug]` (blog cutover, D2d ruling — `items`
 * arrangement, `skin="labs"`). Renders only the listing — the page keeps
 * its own container and header exactly as before.
 *
 * Two live pieces, both collapsing on absence:
 *   - `crossLinks` — the "Common industries" / "Common technologies" /
 *     "Common MLOps topics" cross-link blocks (badges on `skin="default"`,
 *     a sibling-chip strip on `skin="labs"`). One group renders as a single
 *     block; two groups (industry-tags' dual collection) render side by
 *     side on `skin="default"`, stacked on `skin="labs"`. A group with no
 *     items renders nothing; the wrapper itself renders nothing when every
 *     group is empty.
 *   - `sections` — the entry rows themselves. One section (llmops-tags,
 *     mlops-tags) renders with no heading; two sections (industry-tags'
 *     "LLMOps entries" / "MLOps entries" split) each get their own `<h2>`
 *     (or `<h3>` via `headingLevel` when nested under a section heading).
 *
 * A section carries EXACTLY ONE of `cards`, `items` or `entries` — enforced
 * by the `TermHubEntrySection` union, not just documented:
 *   - `cards` — the entry card grid (`grid gap-6 md:grid-cols-2
 *     lg:grid-cols-3`, title + company/meta line + summary + up to 4 tag
 *     badges + overflow badge). This was the parity arrangement every
 *     llmops-tags/mlops-tags/industry-tags term route rendered before the
 *     databases cutover (#256); no live route sets it any more, kept for
 *     `/styleguide`.
 *   - `items` — `data-display.stacked-list` rows. `/styleguide`'s demo
 *     stays on `skin="default"` (title/meta/count only, no summary, no
 *     per-row tag chips); `/tags/[slug]` is the first live caller, on
 *     `skin="labs"` (excerpt + sibling-tag chips + a fixed author/year
 *     lane — see `StackedList`'s own doc comment).
 *   - `entries` — `labs.entry-row` rows (#256). The research-database term
 *     hubs' live arrangement: `/llmops-tags/[slug]`, `/mlops-tags/[slug]`
 *     and `/industry-tags/[slug]`, always on `skin="labs"`. An optional
 *     `seeAll` link (industry-tags' "See all N in the … Database →") renders
 *     after the row list.
 *
 * `crossLinks` render above the sections on `skin="default"` (the pre-
 * cutover badge blocks). On `skin="labs"` they render AFTER the sections
 * instead, as the blog's sibling-chip strip (`/tags/[slug]`'s "Other tags"
 * treatment, with a count appended to each chip) — one bordered block per
 * group, stacked.
 *
 * `emptyHeading` renders only when every section is empty combined —
 * matches the live pages' single catch-all zero state.
 */
import Badge from "../Badge.astro";
import {
  TERM_CHIP,
  TERM_CHIP_HEXAGON_PATH,
  TERM_CHIP_HEXAGON_VIEWBOX,
} from "../blog/termChipStyles";
import EntryRow, { type EntryRowItem } from "../labs/EntryRow.astro";
import EmptyState from "../system/EmptyState.astro";
import { EMPTY_STATE_PRESETS } from "../system/emptyStateStyles";
import StackedList, { type StackedListItem } from "./StackedList.astro";

export interface TermHubCrossLinkItem {
  name: string;
  slug: string;
  count: number;
  href: string;
}

export interface TermHubCrossLinkGroup {
  heading: string;
  viewAllHref: string;
  viewAllLabel: string;
  items: readonly TermHubCrossLinkItem[];
  badgeVariant?: "primary" | "blue" | "success";
}

export interface TermHubEntryCardTag {
  label: string;
  href: string;
}

export interface TermHubEntryCardItem {
  title: string;
  href: string;
  /** Defaults to 2. industry-tags nests cards under its own section `<h2>`, so its cards use 3. */
  headingLevel?: 2 | 3;
  /** Plain "company" line (llmops shape) — renders a bare `<p>` only when present. */
  company?: string;
  /** Dot-joined meta line (mlops shape: company · platformName · contentType) — renders a `<div>` flex row only when present. Mutually exclusive with `company`. */
  metaLine?: readonly string[];
  summary?: string;
  tags?: readonly TermHubEntryCardTag[];
  extraTagCount?: number;
  tagVariant?: "blue" | "success";
}

interface TermHubEntrySectionBase {
  /** Omit for a single-collection page (no `<h2>` renders); set for a dual-collection split. */
  heading?: string;
}

/** The pre-cutover parity arrangement — no live route sets `cards` any more; kept for `/styleguide`. */
export interface TermHubEntryCardsSection extends TermHubEntrySectionBase {
  cards: readonly TermHubEntryCardItem[];
  items?: never;
  entries?: never;
}

/** The stacked-row arrangement — `/tags/[slug]` (blog cutover, D2d). */
export interface TermHubEntryStackedSection extends TermHubEntrySectionBase {
  items: readonly StackedListItem[];
  cards?: never;
  entries?: never;
}

/**
 * The research-database term hubs' live arrangement (#256):
 * `/llmops-tags/[slug]`, `/mlops-tags/[slug]`, `/industry-tags/[slug]`.
 * `seeAll` renders a link after the row list — industry-tags' "See all N in
 * the … Database →" into the filtered index, omitted otherwise.
 */
export interface TermHubEntryRowsSection extends TermHubEntrySectionBase {
  entries: readonly EntryRowItem[];
  cards?: never;
  items?: never;
  seeAll?: { href: string; label: string };
}

export type TermHubEntrySection =
  | TermHubEntryCardsSection
  | TermHubEntryStackedSection
  | TermHubEntryRowsSection;

interface Props {
  crossLinks?: readonly TermHubCrossLinkGroup[];
  sections: readonly TermHubEntrySection[];
  /** e.g. "No LLMOps entries with this tag yet." — shown only when every section is empty. */
  emptyHeading: string;
  /**
   * Forwarded to `StackedList` for every `items` section (blog cutover,
   * `/tags/[slug]`). Also chooses the `entries` arrangement's row heading
   * style and the `crossLinks` placement (below sections, sibling-chip
   * strip) for the research-database term hubs (#256). Default keeps the
   * pre-cutover `StackedList`/badge look for the database term hubs' demo
   * path untouched.
   */
  skin?: "default" | "labs";
  /** Forwarded to `StackedList`/`entries` rows — 12 or 24/page client-side pagination markers. */
  paginate?: boolean;
  pageSize?: number;
  /** id for `HubPagination`/`HubEntryPagination` to scope its `[data-page]` query to; forwarded to the single `items`/`entries` section's list. */
  id?: string;
}

const {
  crossLinks = [],
  sections,
  emptyHeading,
  skin = "default",
  paginate = false,
  pageSize,
  id,
} = Astro.props;

function sectionCount(section: TermHubEntrySection): number {
  return (
    section.cards?.length ??
    section.items?.length ??
    section.entries?.length ??
    0
  );
}

const isLabs = skin === "labs";
const hasCrossLinks = crossLinks.some((group) => group.items.length > 0);
const totalEntries = sections.reduce((sum, s) => sum + sectionCount(s), 0);
const sectionHeadingClass = isLabs
  ? "mb-6 font-display text-[28px] leading-[34px] text-(--color-cream-800)"
  : "mb-6 text-2xl font-bold tracking-tight text-gray-900";
---

{!isLabs && hasCrossLinks && (
  <section
    class:list={[
      "mb-10",
      crossLinks.length > 1 && "grid gap-6 md:grid-cols-2",
    ]}
  >
    {crossLinks.map(
      (group) =>
        group.items.length > 0 && (
          <div>
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-400">
                {group.heading}
              </h2>
              <a
                href={group.viewAllHref}
                class="text-xs font-medium text-primary-600 hover:text-primary-700"
              >
                {group.viewAllLabel} &rarr;
              </a>
            </div>
            <div class="mt-3 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <Badge variant={group.badgeVariant ?? "primary"} href={item.href}>
                  {item.name} ({item.count})
                </Badge>
              ))}
            </div>
          </div>
        ),
    )}
  </section>
)}

{sections.map((section, i) => {
  const count = sectionCount(section);
  return (
    count > 0 && (
      <section
        class={
          sections.slice(i + 1).some((s) => sectionCount(s) > 0)
            ? "mb-14"
            : undefined
        }
      >
        {section.heading && (
          <h2 class={sectionHeadingClass}>{section.heading}</h2>
        )}
        {section.cards ? (
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {section.cards.map((card) => {
              const CardHeading = card.headingLevel === 3 ? "h3" : "h2";
              return (
                <div class="group relative flex flex-col rounded-lg border border-gray-200 bg-white p-5 transition-shadow hover:shadow-md">
                  <CardHeading class="text-lg font-semibold text-gray-900 group-hover:text-primary-600">
                    <a
                      href={card.href}
                      class="before:absolute before:inset-0 before:content-['']"
                    >
                      {card.title}
                    </a>
                  </CardHeading>
                  {card.company && (
                    <p class="mt-1 text-sm text-gray-500">{card.company}</p>
                  )}
                  {card.metaLine && (
                    <div class="mt-1 flex flex-wrap items-center gap-2 text-sm text-gray-500">
                      {card.metaLine.map((part, partIndex) => (
                        <>
                          {partIndex > 0 && <span aria-hidden="true">&middot;</span>}
                          <span class:list={[partIndex === card.metaLine!.length - 1 && "capitalize"]}>
                            {part}
                          </span>
                        </>
                      ))}
                    </div>
                  )}
                  {card.summary && (
                    <p class="mt-2 line-clamp-3 text-sm text-gray-600">{card.summary}</p>
                  )}
                  {/* Rendered even with zero tags: the live pages emit this
                      row unconditionally, so a tagless card keeps its 16px
                      pt-4 foot. Collapsing it is a cutover change. */}
                  <div class="mt-auto flex flex-wrap gap-1.5 pt-4">
                    {card.tags?.map((tag) => (
                      <Badge variant={card.tagVariant ?? "blue"} href={tag.href} class="relative">
                        {tag.label}
                      </Badge>
                    ))}
                    {(card.extraTagCount ?? 0) > 0 && (
                      <Badge variant="gray">+{card.extraTagCount}</Badge>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        ) : section.items ? (
          <StackedList
            items={section.items}
            skin={skin}
            paginate={paginate}
            pageSize={pageSize}
            id={id}
          />
        ) : (
          <>
            <ul id={id} class="flex flex-col list-none">
              {section.entries.map((entry, entryIndex) => {
                const rowPageSize = pageSize ?? section.entries.length;
                return (
                  <li
                    data-page={
                      paginate
                        ? Math.floor(entryIndex / rowPageSize) + 1
                        : undefined
                    }
                    hidden={paginate && entryIndex >= rowPageSize ? true : undefined}
                  >
                    <EntryRow {...entry} headingLevel={3} />
                  </li>
                );
              })}
            </ul>
            {section.seeAll && (
              <a
                href={section.seeAll.href}
                class="mt-6 inline-flex text-[14px] font-medium text-(--color-sage-700) hover:text-(--color-sage-800)"
              >
                {section.seeAll.label} &rarr;
              </a>
            )}
          </>
        )}
      </section>
    )
  );
})}

{isLabs && hasCrossLinks && (
  <div class="mt-14 flex flex-col gap-10">
    {crossLinks.map(
      (group) =>
        group.items.length > 0 && (
          <div class="flex flex-col gap-4 border-t border-(--color-border) pt-8">
            <p class="text-[12px] font-medium text-(--color-cream-800)">
              {group.heading}
            </p>
            <div class="flex flex-wrap items-center gap-2">
              {group.items.map((item) => (
                <a href={item.href} class={TERM_CHIP}>
                  <svg
                    viewBox={TERM_CHIP_HEXAGON_VIEWBOX}
                    class="h-[14px] w-3 fill-(--color-sage-600)"
                    aria-hidden="true"
                  >
                    <path d={TERM_CHIP_HEXAGON_PATH} />
                  </svg>
                  {item.name}
                  <span class="text-(--color-cream-600) tabular-nums">
                    {item.count}
                  </span>
                </a>
              ))}
              <a
                href={group.viewAllHref}
                class="ml-1 text-[13px] font-medium text-(--color-sage-700) hover:text-(--color-sage-800)"
              >
                {group.viewAllLabel} &rarr;
              </a>
            </div>
          </div>
        ),
    )}
  </div>
)}

{totalEntries === 0 && (
  <EmptyState
    heading={emptyHeading}
    reserveHeight={false}
    classOverrides={{
      ...EMPTY_STATE_PRESETS.bareList,
      heading: "text-center text-gray-500",
    }}
  />
)}
