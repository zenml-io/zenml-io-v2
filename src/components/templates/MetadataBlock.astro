---
/**
 * MetadataBlock — a stack of "small-caps label + value" pairs (issue #249).
 *
 * Owns: the label typography (`labelTag` h2/h3, small-caps gray-400 style)
 * and the vertical gap between label and value, and between items. Owns no
 * surrounding whitespace — the page that places this component owns the gap
 * above and below it via the `class` passthrough.
 *
 * `value` is a small closed set of the shapes real sidebars/detail pages
 * actually put under a label: a single pill link, a list of icon+text
 * links, a row of chips, or the "vs" compare card. Each item picks one kind
 * — there is no `show*` boolean; an item simply isn't in `items` when its
 * data is absent, and a chips list with one entry is how a single badge
 * (e.g. one industry tag) renders, not a special case.
 *
 * `sticky` reproduces a sidebar that positions itself independent of any
 * sibling content. Where a page composes this block next to another
 * sidebar template (e.g. a related-content rail) under one shared sticky
 * wrapper, leave `sticky` off here and let the page own the shared
 * position — a component can't safely claim `position: sticky` on behalf
 * of markup it doesn't render.
 */
import { cn } from "../../lib/utils";
import type { SpaceStep } from "../../lib/section";
import Stack from "../system/layout/Stack.astro";

export type MetadataLinkIcon = "docs" | "github";

export interface MetadataLink {
  href: string;
  label: string;
  icon: MetadataLinkIcon;
}

export interface MetadataChip {
  label: string;
  href?: string;
  variant?: "gray" | "primary" | "success" | "warning" | "blue";
}

export type MetadataValue =
  | { kind: "pill"; href: string; label: string }
  | { kind: "links"; links: readonly MetadataLink[] }
  | { kind: "chips"; chips: readonly MetadataChip[] }
  | {
      kind: "compare";
      href: string;
      label: string;
      leftImage: { src: string; alt: string };
      rightImage?: { src: string; alt: string };
      vsLabel?: string;
    };

export interface MetadataBlockItem {
  label: string;
  value: MetadataValue;
}

interface Props {
  items: readonly MetadataBlockItem[];
  /** Label heading level. Sidebars use h3; page-body meta sections use h2. */
  labelTag?: "h2" | "h3";
  /** Gap between items. Default reproduces the sticky-sidebar spacing (32px). */
  space?: SpaceStep;
  sticky?: boolean;
  class?: string;
}

const {
  items,
  labelTag = "h3",
  space = "md",
  sticky = false,
  class: className,
} = Astro.props;

const Label = labelTag;
const LABEL_CLASS =
  "text-xs font-semibold uppercase tracking-wider text-gray-400";

const CHIP_VARIANT_CLASS: Record<
  NonNullable<MetadataChip["variant"]>,
  string
> = {
  gray: "bg-gray-100 text-gray-700 hover:bg-gray-200",
  primary: "bg-zenml-50 text-zenml-700 hover:bg-zenml-100",
  success: "bg-success-50 text-success-700",
  warning: "bg-orange-50 text-orange-700",
  blue: "bg-blue-50 text-blue-700",
};
const CHIP_BASE =
  "inline-flex items-center rounded-pill px-2.5 py-0.5 text-xs font-medium transition-colors";
---

<Stack space={space} class={cn(sticky && "sticky top-24", className)}>
  {
    items.map((item) => (
      <div>
        <Label class={LABEL_CLASS}>{item.label}</Label>
        {item.value.kind === "pill" && (
          <a
            href={item.value.href}
            class="mt-space-xxs inline-block rounded-full bg-primary-50 px-3 py-1 text-sm font-medium text-primary-700 hover:bg-primary-100"
          >
            {item.value.label}
          </a>
        )}
        {item.value.kind === "links" && (
          <div class="mt-space-xxs space-y-space-xxs">
            {item.value.links.map((link) =>
              link.icon === "docs" ? (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 text-sm font-medium text-primary-600 hover:text-primary-700"
                >
                  <svg
                    class="h-5 w-5 shrink-0"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M20 19V16H7C5.34315 16 4 17.3431 4 19M8.8 22H16.8C17.9201 22 18.4802 22 18.908 21.782C19.2843 21.5903 19.5903 21.2843 19.782 20.908C20 20.4802 20 19.9201 20 18.8V5.2C20 4.07989 20 3.51984 19.782 3.09202C19.5903 2.71569 19.2843 2.40973 18.908 2.21799C18.4802 2 17.9201 2 16.8 2H8.8C7.11984 2 6.27976 2 5.63803 2.32698C5.07354 2.6146 4.6146 3.07354 4.32698 3.63803C4 4.27976 4 5.11984 4 6.8V17.2C4 18.8802 4 19.7202 4.32698 20.362C4.6146 20.9265 5.07354 21.3854 5.63803 21.673C6.27976 22 7.11984 22 8.8 22Z" />
                  </svg>
                  {link.label}
                </a>
              ) : (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 text-sm font-medium text-gray-700 hover:text-gray-900"
                >
                  <svg
                    class="h-5 w-5 shrink-0"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      clip-rule="evenodd"
                      d="M12.008 2C6.474 2 2 6.583 2 12.254c0 5.532 2.867 9.37 6.843 10.727.5.1.523-.312.523-.58v-2.042c-3.1.374-3.224-1.517-3.432-1.824-.42-.724-1.414-.908-1.118-1.253.706-.374 1.427.093 2.262 1.36.605.92 1.784.764 2.381.612.094-.503.322-.951.644-1.312-3.211-.577-4.552-2.543-4.552-4.881 0-1.133.372-2.175 1.103-3.017-.465-1.38.044-2.562.113-2.753 1.326-.119 2.707.95 2.814 1.035.754-.204 1.616-.312 2.536-.312.924 0 1.79.112 2.549.318.255-.194 1.52-1.1 2.746-.988.066.191.566 1.346.125 2.695.74.845 1.116 1.895 1.116 3.031 0 2.345-1.35 4.31-4.571 4.88.456.478.738 1.136.738 1.868v2.97c.02.244 0 .485.396.485C19.161 21.578 22 17.757 22 12.255 22 6.583 17.526 2 12.008 2Z"
                    />
                  </svg>
                  {link.label}
                </a>
              ),
            )}
          </div>
        )}
        {/* A single chip sits inline in a plain block (the badge line-box is
            a few px taller than a flex row would be); several get the
            wrapping flex row. Both are live shapes — don't unify them. */}
        {item.value.kind === "chips" && (
          <div
            class:list={[
              "mt-space-xxs",
              item.value.chips.length > 1 && "flex flex-wrap gap-space-xxs",
            ]}
          >
            {item.value.chips.map((chip) => {
              const variantClass = CHIP_VARIANT_CLASS[chip.variant ?? "gray"];
              return chip.href ? (
                <a href={chip.href} class={cn(CHIP_BASE, variantClass)}>
                  {chip.label}
                </a>
              ) : (
                <span class={cn(CHIP_BASE, variantClass)}>{chip.label}</span>
              );
            })}
          </div>
        )}
        {item.value.kind === "compare" && (
          <a
            href={item.value.href}
            class="mt-space-xxs flex items-center gap-space-xxs rounded-lg border border-gray-200 bg-white p-3 transition-shadow hover:shadow-sm"
          >
            <div class="flex items-center gap-1.5">
              <img
                src={item.value.leftImage.src}
                alt={item.value.leftImage.alt}
                width="32"
                height="32"
                class="h-8 w-8 rounded"
              />
              <span class="text-xs font-medium text-gray-400">
                {item.value.vsLabel ?? "vs"}
              </span>
              {item.value.rightImage && (
                <img
                  src={item.value.rightImage.src}
                  alt={item.value.rightImage.alt}
                  width="32"
                  height="32"
                  class="h-8 w-8 rounded object-contain"
                />
              )}
            </div>
            <span class="text-sm font-medium text-gray-700">
              {item.value.label}
            </span>
          </a>
        )}
      </div>
    ))
  }
</Stack>
