---
/**
 * TermHubCatalog — the integration-type term-page listing (issue #249).
 *
 * Covers `/integration-type/[slug]` and the integration detail's "More
 * integrations" row. Renders only the listing — the page keeps its own
 * container and heading.
 *
 * The tile is `labs.integration-card`: the Labs card shell with the
 * full-width logo band. One skin only — there is no consumer left on the
 * pre-cutover tile. A "thin" grid — fewer items than the widest
 * breakpoint's column count — centers instead of packing to the left with
 * trailing empty columns; this only changes rows that would otherwise
 * render with visible empty grid cells, not the populated 3-column case.
 */
import IntegrationCard from "../labs/IntegrationCard.astro";

export interface TermHubCatalogItem {
  href: string;
  title: string;
  categoryLabel: string;
  logo?: { url: string; alt?: string };
}

interface Props {
  items: readonly TermHubCatalogItem[];
  /** e.g. "No integrations of this type yet." */
  emptyHeading: string;
  /**
   * Centre a row thinner than the 3-column breakpoint instead of leaving
   * left-packed empty cells — the drawn cutover treatment. Off by default:
   * the live routes render the plain grid at every count today, and four of
   * them are thin.
   */
  centerThin?: boolean;
  /** Optional id on the grid element, for page-level anchors and checks. */
  id?: string;
}

const { items, emptyHeading, centerThin = false, id } = Astro.props;

const isThin = centerThin && items.length > 0 && items.length < 3;
---

<div
  id={id}
  class:list={[
    isThin
      ? "flex flex-wrap justify-center gap-6"
      : "grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3",
  ]}
>
  {items.map((item) => (
    <IntegrationCard
      href={item.href}
      title={item.title}
      typeLabel={item.categoryLabel}
      logo={item.logo}
      class={isThin ? "w-full sm:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)]" : undefined}
    />
  ))}
</div>

{items.length === 0 && (
  <p class="py-12 font-sans text-[16px] leading-6 text-(--color-cream-700)">
    {emptyHeading}
  </p>
)}
