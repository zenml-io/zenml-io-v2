---
/**
 * ProcessSteps — the numbered-step family (issue #249).
 *
 * `layout` picks between two structurally different arrangements — not a
 * collapsing prop, because the two live encodings share no markup:
 * `vertical-code` (a dark-band walkthrough, each step title + copy + a
 * pre-highlighted code block) and `compact-list` (a light card grid, each
 * step a numeral circle + title + optional duration + copy).
 *
 * Emits a semantic `<ol>`/`<li>` regardless of arrangement — Tailwind's
 * preflight already zeroes `ol`/`li` margin, padding, and markers, so the
 * added semantics don't move a pixel from the `<div>`s the live pages used.
 *
 * Owns no surrounding whitespace (no heading, no intro copy, no top
 * margin to whatever precedes it) — same rule as `SectionIntro`. The page
 * keeps its own heading/intro paragraphs and supplies the gap above this
 * component via `class`.
 *
 * `highlightedHtml` (vertical-code) is pre-highlighted Shiki HTML — Shiki
 * only runs at build time in the page, never in this component.
 *
 * `numeralStyle="zero-padded"` (compact-list) is the new-brand/demo path
 * only (DECISIONS #76); live `careers.astro` numerals stay raw `1`-`4` via
 * the default `"raw"`. `CAREERS_HIRING_PROCESS` itself is never edited —
 * its 4th step's empty `duration` collapses here instead (no empty node).
 */
export interface ProcessStepsVerticalCodeStep {
  title: string;
  /** Pre-rendered HTML (may include inline markup). */
  body: string;
  /** Pre-rendered Shiki HTML for the step's code block. */
  highlightedHtml: string;
}

export interface ProcessStepsCompactListStep {
  number: number;
  title: string;
  /** Empty/absent collapses — no empty node reserved for it. */
  duration?: string;
  body: string;
}

type Props =
  | {
      layout: "vertical-code";
      steps: readonly ProcessStepsVerticalCodeStep[];
      class?: string;
    }
  | {
      layout: "compact-list";
      steps: readonly ProcessStepsCompactListStep[];
      /** Default "raw" (live parity: `1`-`4`, not `01`-`04`). */
      numeralStyle?: "raw" | "zero-padded";
      class?: string;
    };

const props = Astro.props;
const className = props.class;

const isVerticalCode = props.layout === "vertical-code";
const verticalSteps = props.layout === "vertical-code" ? props.steps : [];
const compactSteps = props.layout === "compact-list" ? props.steps : [];
const numeralStyle =
  (props.layout === "compact-list" ? props.numeralStyle : undefined) ?? "raw";

function formatNumeral(n: number): string {
  return numeralStyle === "zero-padded"
    ? String(n).padStart(2, "0")
    : String(n);
}
---

{
  isVerticalCode ? (
    <ol class:list={["space-y-10", className]}>
      {verticalSteps.map((step) => (
        <li>
          <h3 class="text-lg font-semibold text-white">{step.title}</h3>
          <p class="mt-1 text-sm text-gray-300" set:html={step.body} />
          <div class="mt-3 dark-code-block" set:html={step.highlightedHtml} />
        </li>
      ))}
    </ol>
  ) : (
    <ol class:list={["grid gap-8 sm:grid-cols-2", className]}>
      {compactSteps.map((step) => (
        <li class="rounded-md border border-gray-200 bg-white p-6">
          <div class="flex h-10 w-10 items-center justify-center rounded-full border-2 border-zenml-500 text-lg font-bold text-zenml-500">
            {formatNumeral(step.number)}
          </div>
          <h3 class="mt-3 text-lg font-semibold text-gray-900">{step.title}</h3>
          {step.duration && (
            <p class="mt-1 text-xs font-medium text-gray-400">{step.duration}</p>
          )}
          <p class="mt-2 text-sm text-gray-600 leading-relaxed">{step.body}</p>
        </li>
      ))}
    </ol>
  )
}
