---
/**
 * Bleed — breaks a child out of the horizontal inset it would otherwise
 * inherit (#248).
 *
 * `to="viewport"` breaks all the way to the browser edge, using the
 * established full-bleed trick already in this codebase (see
 * `CodeCompare.astro` / `PullQuote.astro`): `width: 100vw` with negative
 * margins computed from the viewport, centered independent of where the
 * element sits in the DOM.
 *
 * `to="container"` cancels exactly the page's own lateral gutter
 * (`--spacing-gutter`) rather than reaching for the viewport, so the result
 * stays correct whatever width the enclosing container actually has —
 * Bleed never hardcodes a container pixel width.
 *
 * `below` scopes the break-out to viewports narrower than that breakpoint;
 * at and above it, Bleed renders as a plain, uninset block.
 *
 * Preact twin: `Bleed.tsx` (same directory) — islands cannot import .astro
 * components. Keep the two emitting identical markup/classes.
 */
import type { Breakpoint } from "../../../lib/section";
import { BLEED_RESET_AT } from "./classMaps";

type BleedTo = "container" | "viewport";

interface Props {
  to?: BleedTo;
  below?: Breakpoint;
  class?: string;
}

const { to = "viewport", below, class: className } = Astro.props;

const BLEED_CLASS: Record<BleedTo, string> = {
  viewport: "w-[100vw] ml-[calc(50%-50vw)] mr-[calc(50%-50vw)]",
  container:
    "ml-[calc(-1*var(--spacing-gutter))] mr-[calc(-1*var(--spacing-gutter))]",
};

const classes = [BLEED_CLASS[to], below ? BLEED_RESET_AT[below] : "", className]
  .filter(Boolean)
  .join(" ");
---

<div class={classes}>
  <slot />
</div>
