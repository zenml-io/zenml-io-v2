---
import type { ResponsiveSpace } from "./spacing.shared";
/**
 * Stack — vertical flow, one gap step between every child (issue #248).
 *
 * Owns no surrounding whitespace: the gap is only ever *between* children
 * (`gap-space-*`), never a margin the caller has to cancel. `space` accepts
 * either a single `SpaceStep` or a per-breakpoint override object; see
 * `./spacing.shared` for how that resolves to classes.
 *
 * `dividers` draws a hairline between children using `--section-border`
 * (never a fixed gray literal), so it stays correct under whichever
 * `[data-tone]` the Stack renders inside.
 *
 * A Preact twin (`Stack.tsx`) exists because islands cannot import `.astro`
 * components; both render through `./stack.shared` so they can't drift.
 */
import { type StackAlign, stackClasses } from "./stack.shared";

interface Props {
  space?: ResponsiveSpace;
  align?: StackAlign;
  dividers?: boolean;
  class?: string;
}

const {
  space,
  align = "stretch",
  dividers = false,
  class: className,
} = Astro.props;

const classes = stackClasses({ space, align, dividers, className });
---

<div class={classes}>
  <slot />
</div>
