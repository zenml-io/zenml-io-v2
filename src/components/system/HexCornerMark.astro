---
/**
 * HexCornerMark — the hex-corner treatment: an 80px hexagon docked into the
 * host's bottom-right corner, with a halo hexagon (the page/band colour)
 * around it so it reads as an object biting into the card. At rest only the
 * hexagon's upper-left shoulder shows; on hover the card flips dark, the halo
 * fades, and the hexagon shrinks to half size (~40px, scaled about the same
 * origin it rotates around so its centre doesn't drift) while it walks
 * up-left (41px, 31px) and turns from edge-top to point-top, landing inside
 * the card with room to the padding edge; its arrow grows from a smaller,
 * off-centre rest mark to full size, re-centring on the shrunken hexagon —
 * the small silhouette resolves against the dark surface.
 *
 * A treatment, not a card: it renders only the surface and the corner
 * layers, absolutely positioned to fill its host. The host owns
 * `position: relative`, `overflow: clip` (that is what clips the shoulder at
 * rest), its 24px radius on every corner, and a `group` class this reads
 * hover from. Keep the host's bottom-right ~110×100 free of content.
 *
 * Everything that animates is compositor-only (background-color, opacity,
 * translate, rotate). Under `prefers-reduced-motion` only the colour flip
 * runs; the hexagon stays docked.
 */
interface Props {
  /** Colour token of the surface behind the card (the halo must match it). */
  haloVar?: string;
}
const { haloVar = "--color-sage-100" } = Astro.props;
---

<div
  class="hex-corner-surface absolute inset-0 z-0 rounded-[24px] bg-(--color-card) transition-colors duration-500 ease-out group-hover:bg-(--color-sage-900)"
  aria-hidden="true"
>
</div>
<svg
  class="hex-corner-svg absolute right-[-51px] bottom-[-39px] z-0 h-[106px] w-[106px] overflow-visible"
  viewBox="-53 -53 106 106"
  aria-hidden="true"
>
  <g class="hex-corner-walk">
    <g class="hex-corner-spin">
      <path
        class="hex-corner-halo"
        d="M-5.5 -50.1A11 11 0 0 1 5.5 -50.1L44.5 -27.6A11 11 0 0 1 50 -18.1L50 26.9A11 11 0 0 1 44.5 36.4L5.5 58.9A11 11 0 0 1 -5.5 58.9L-44.5 36.4A11 11 0 0 1 -50 26.9L-50 -18.1A11 11 0 0 1 -44.5 -27.6Z"
        style={`fill: var(${haloVar})`}
        transform="translate(0 -4.4) scale(0.93)"
      ></path>
      <path
        class="hex-corner-hex"
        d="M-5.5 -43.8A11 11 0 0 1 5.5 -43.8L33 -27.9A11 11 0 0 1 38.5 -18.4L38.5 13.4A11 11 0 0 1 33 22.9L5.5 38.8A11 11 0 0 1 -5.5 38.8L-33 22.9A11 11 0 0 1 -38.5 13.4L-38.5 -18.4A11 11 0 0 1 -33 -27.9Z"
        fill="var(--color-sage-400)"
        transform="translate(0 2.5)"
      ></path>
    </g>
    <g class="hex-corner-arrow" fill="none" stroke="var(--color-sage-900)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M-8 0H8"></path>
      <path d="M2 -6 8 0 2 6"></path>
    </g>
  </g>
</svg>

<style>
  .hex-corner-walk,
  .hex-corner-spin,
  .hex-corner-arrow,
  .hex-corner-halo {
    transition:
      translate 500ms cubic-bezier(0.2, 0.7, 0.2, 1),
      rotate 500ms cubic-bezier(0.2, 0.7, 0.2, 1),
      scale 500ms cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 400ms ease-out;
  }
  .hex-corner-spin {
    /* Edge-top at rest (the shoulder that shows through the corner), point-top when revealed.
       Rotates and scales about the same origin the hexagon path is centred on, so shrinking
       it on hover doesn't shift where its centre lands. */
    rotate: 30deg;
    scale: 1;
    transform-origin: 0 0;
  }
  .hex-corner-arrow {
    /* Off-centre at rest, sat on the visual centre of the wedge that's actually visible past
       the card's clip (not the hexagon's geometric centre, which sits almost exactly on the
       corner and is mostly clipped away). The arrow keeps this one size in every state; only
       its position moves. */
    translate: -17px -10px;
    scale: 0.72;
  }
  :global(.group:hover) .hex-corner-walk {
    translate: -41px -31px;
  }
  :global(.group:hover) .hex-corner-spin {
    rotate: 0deg;
    scale: 0.5;
  }
  :global(.group:hover) .hex-corner-arrow {
    translate: 0 0;
  }
  :global(.group:hover) .hex-corner-halo {
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .hex-corner-walk,
    .hex-corner-spin,
    .hex-corner-arrow,
    .hex-corner-halo {
      transition: none;
    }
    :global(.group:hover) .hex-corner-walk {
      translate: 0 0;
    }
    :global(.group:hover) .hex-corner-spin {
      rotate: 30deg;
      scale: 1;
    }
    :global(.group:hover) .hex-corner-arrow {
      translate: -17px -10px;
      scale: 0.72;
    }
    :global(.group:hover) .hex-corner-halo {
      opacity: 1;
    }
  }
</style>
