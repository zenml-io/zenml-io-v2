---
/**
 * PlausibleBridge — global click delegation for Plausible analytics.
 *
 * Provides:
 * 1. `window.__zenmlPlausibleTrack(eventName, props?)` — consent-safe helper
 * 2. Delegated click handler: any element with `data-analytics="EventName"`
 *    automatically fires `plausible("EventName")` on click.
 * 3. Delegated copy tracking: a click on any `[data-copy]` button (the install
 *    command chips on the homepage, product pages, compare pages, and the
 *    Kitaru hero) fires `Install Command Copied` with the command and product,
 *    so Plausible can show how many visitors copy the one-liner.
 *
 * Consent-safe / existence-safe: only fires if `window.plausible` exists.
 * Plausible itself is loaded directly by SiteHeaderScripts on production hostnames.
 *
 * Included by both BaseLayout and MinimalLayout.
 */
---

<script is:inline>
  if (!window.__zenmlPlausibleBridgeInstalled) {
    window.__zenmlPlausibleBridgeInstalled = true;

    // Read `surface` once from <html data-surface> (set by BaseLayout/MinimalLayout)
    // so every custom event carries the surface prop alongside pageviews (D3).
    var __surface = document.documentElement.dataset.surface || "ml";

    window.__zenmlPlausibleTrack = function (eventName, props) {
      if (!window.plausible || !eventName) return;
      var merged = Object.assign({ surface: __surface }, props || {});
      window.plausible(eventName, { props: merged });
    };

    document.addEventListener("click", function (e) {
      if (!e.target || !e.target.closest) return;
      var el = e.target.closest("[data-analytics]");
      if (el) {
        var name = el.getAttribute("data-analytics");
        if (name) window.__zenmlPlausibleTrack(name);
      }
      var copy = e.target.closest("[data-copy]");
      if (copy) {
        var cmd = copy.getAttribute("data-copy") || "";
        window.__zenmlPlausibleTrack("Install Command Copied", {
          command: cmd,
          product: cmd.indexOf("kitaru") !== -1 ? "kitaru" : "zenml",
        });
      }
    });
  }
</script>
