---
/**
 * Integration detail sticky sidebar.
 *
 * Matches Webflow: Category badge, Learn More links, Compare block, Related Resources.
 * All sections are conditionally rendered based on available data.
 */
import MetadataBlock, {
  type MetadataBlockItem,
} from "../templates/MetadataBlock.astro";

interface RelatedPost {
  href: string;
  title: string;
  imageUrl?: string;
}

interface Props {
  type?: { slug: string; name: string };
  docsUrl?: string;
  documentationLinkText?: string;
  githubUrl?: string;
  githubLinkText?: string;
  compareSlug?: string;
  compareName?: string;
  integrationLogo?: { url: string; alt?: string };
  relatedPosts: RelatedPost[];
}

const {
  type,
  docsUrl,
  documentationLinkText,
  githubUrl,
  githubLinkText,
  compareSlug,
  compareName,
  integrationLogo,
  relatedPosts,
} = Astro.props;

const metadataItems: MetadataBlockItem[] = [];

if (type) {
  metadataItems.push({
    label: "Category",
    value: { kind: "pill", href: `/integration-type/${type.slug}`, label: type.name },
  });
}

if (docsUrl || githubUrl) {
  metadataItems.push({
    label: "Learn More",
    value: {
      kind: "links",
      links: [
        ...(docsUrl
          ? [{ href: docsUrl, label: documentationLinkText || "Documentation", icon: "docs" as const }]
          : []),
        ...(githubUrl
          ? [{ href: githubUrl, label: githubLinkText || "Get Started", icon: "github" as const }]
          : []),
      ],
    },
  });
}

if (compareSlug) {
  metadataItems.push({
    label: "Compare",
    value: {
      kind: "compare",
      href: `/compare/${compareSlug}`,
      label: compareName || compareSlug.replace("zenml-vs-", "ZenML vs "),
      leftImage: { src: "/images/zenml-icon.webp", alt: "ZenML" },
      rightImage: integrationLogo
        ? { src: integrationLogo.url, alt: compareName || "" }
        : undefined,
    },
  });
}
---

<aside class="w-full shrink-0 lg:w-64">
  <div class="sticky top-24 space-y-8">
    <MetadataBlock items={metadataItems} labelTag="h3" space="md" />

    {/* Related Resources */}
    {relatedPosts.length > 0 && (
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-400">Related Resources</h3>
        <div class="mt-2 space-y-3">
          {relatedPosts.map((post) => (
            <a href={post.href} class="flex items-center gap-3 group">
              {post.imageUrl && (
                <img src={post.imageUrl} alt="" aria-hidden="true" width="56" height="56" class="h-14 w-14 shrink-0 rounded-lg object-cover" loading="lazy" />
              )}
              <span class="line-clamp-2 text-sm font-medium text-gray-700 group-hover:text-primary-600">
                {post.title}
              </span>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</aside>
