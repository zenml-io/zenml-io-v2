---
/**
 * Integration detail sticky sidebar.
 *
 * Matches Webflow: Category badge, Learn More links, Compare block, Related Resources.
 * All sections are conditionally rendered based on available data.
 */
import MetadataBlock, {
  type MetadataBlockItem,
} from "../templates/MetadataBlock.astro";
import RelatedRail, {
  type RelatedRailItem,
} from "../templates/RelatedRail.astro";

interface RelatedPost {
  href: string;
  title: string;
  imageUrl?: string;
}

interface Props {
  type?: { slug: string; name: string };
  docsUrl?: string;
  documentationLinkText?: string;
  githubUrl?: string;
  githubLinkText?: string;
  compareSlug?: string;
  compareName?: string;
  integrationLogo?: { url: string; alt?: string };
  relatedPosts: RelatedPost[];
}

const {
  type,
  docsUrl,
  documentationLinkText,
  githubUrl,
  githubLinkText,
  compareSlug,
  compareName,
  integrationLogo,
  relatedPosts,
} = Astro.props;

const metadataItems: MetadataBlockItem[] = [];

if (type) {
  metadataItems.push({
    label: "Category",
    value: {
      kind: "pill",
      href: `/integration-type/${type.slug}`,
      label: type.name,
    },
  });
}

if (docsUrl || githubUrl) {
  metadataItems.push({
    label: "Learn More",
    value: {
      kind: "links",
      links: [
        ...(docsUrl
          ? [
              {
                href: docsUrl,
                label: documentationLinkText || "Documentation",
                icon: "docs" as const,
              },
            ]
          : []),
        ...(githubUrl
          ? [
              {
                href: githubUrl,
                label: githubLinkText || "Get Started",
                icon: "github" as const,
              },
            ]
          : []),
      ],
    },
  });
}

if (compareSlug) {
  metadataItems.push({
    label: "Compare",
    value: {
      kind: "compare",
      href: `/compare/${compareSlug}`,
      label: compareName || compareSlug.replace("zenml-vs-", "ZenML vs "),
      leftImage: { src: "/images/zenml-icon.webp", alt: "ZenML" },
      rightImage: integrationLogo
        ? {
            src: integrationLogo.url,
            alt: compareName || compareSlug.replace("zenml-vs-", "ZenML vs "),
          }
        : undefined,
    },
  });
}

const relatedItems: RelatedRailItem[] = relatedPosts.map((post) => ({
  kind: "thumbnail",
  href: post.href,
  title: post.title,
  imageUrl: post.imageUrl,
}));
---

<aside class="w-full shrink-0 lg:w-64">
  <div class="sticky top-24 space-y-8">
    {metadataItems.length > 0 && (
      <MetadataBlock items={metadataItems} labelTag="h3" space="md" />
    )}

    {/* Related Resources */}
    {relatedItems.length > 0 && (
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-400">Related Resources</h3>
        <RelatedRail items={relatedItems} class="mt-space-xxs" />
      </div>
    )}
  </div>
</aside>
