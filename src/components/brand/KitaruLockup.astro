---
/**
 * KitaruLockup — the Kitaru wordmark with the ZenML symbol: the shared Z
 * mark followed by the "Kitaru" letterforms, one inline SVG filled with
 * `currentColor`. Decorative (`aria-hidden`): the wrapping element names
 * what it links to. It is drawn at the same mark height and proportions as
 * ZenmlLabsLogo, so the two can crossfade in one slot with the Z mark
 * staying in place (the Labs nav does this on Kitaru pages).
 *
 * The lockup is a fixed brand asset: never redraw or recolour its parts.
 * The only edit to the delivered artwork is a whole-group translate on the
 * letterforms (Zuri, 2026-09-08) that closes the mark-to-letter gap to the
 * company lockup's; the paths themselves are untouched.
 * KitaruWordmark.astro is the standalone wordmark with the ring glyph.
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
