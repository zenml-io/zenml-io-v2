---
/**
 * ZenmlWordmark — the rebrand ZenML product wordmark (stacked-layers mark +
 * "ZenML" letterforms) as one inline SVG filled with `currentColor`, so the
 * caller sets its colour. Used decoratively (huge, `aria-hidden`) in the
 * Labs footer, where the site name is already announced by the nav.
 *
 * Geometry matches the designed footer logo; the lockup with "labs" lives in
 * ZenmlLabsLogo.astro.
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
