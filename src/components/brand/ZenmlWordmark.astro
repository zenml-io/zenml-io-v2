---
/**
 * ZenmlWordmark — the rebrand ZenML product wordmark (Z mark + "ZenML"
 * letterforms) as one inline SVG filled with `currentColor`, so the caller
 * sets its colour. Decorative (`aria-hidden`): the wrapping element names the
 * product where it matters (product cards); the footer uses it huge, where the
 * nav already announces the site name.
 *
 * The lockup with "labs" lives in ZenmlLabsLogo.astro.
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
