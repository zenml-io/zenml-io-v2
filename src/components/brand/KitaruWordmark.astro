 * sets its colour. Decorative (`aria-hidden`): the wrapping element names the
 * product. The pre-rebrand mark with the spinning ring is KitaruLogo.astro.
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
