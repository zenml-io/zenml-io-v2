---
/**
 * ZenML product wordmark compatibility wrapper. Uses the rebrand artwork
 * directly so legacy callers cannot retain the retired static purple asset.
 *
 * `alt="ZenML"` gives crawlers a non-empty alt. Every caller's anchor has
 * `aria-label="ZenML"`, which wins as the link's accessible name, so screen
 * readers still announce it exactly once (no double-announcement).
 */
import ZenmlWordmark from "./ZenmlWordmark.astro";

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<span role="img" aria-label="ZenML" class={className}><ZenmlWordmark class="h-full w-full" /></span>
