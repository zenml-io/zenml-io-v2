---
/**
 * ZenML wordmark — original purple ZenML logo.
 *
 * The unified rebrand is deferred until Zuri delivers final brand assets,
 * so we render the original purple SVG asset directly. Once a new
 * unified wordmark is approved, either:
 *   (a) replace `/images/zenml-logo.svg`, or
 *   (b) inline the new SVG paths here.
 *
 * `alt="ZenML"` gives crawlers a non-empty alt. Every caller's anchor has
 * `aria-label="ZenML"`, which wins as the link's accessible name, so screen
 * readers still announce it exactly once (no double-announcement).
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<img src="/images/zenml-logo.svg" alt="ZenML" class={className} />
