---
/**
 * TemplateStage — renders a `built` template registry entry live, inside a
 * bordered stage, for the Components section of /styleguide.
 *
 * Wave 1 (#248) landed the first `built` entries — the section primitives
 * under `src/components/system/` — so this component now has live callers
 * and is exercised by `pnpm build`. See CLAUDE.md's derivation rule and
 * issue #266.
 *
 * Resolution is by componentPath, via Vite's import.meta.glob over both the
 * templates and system-primitives directories (eager, so this stays a
 * static page — no client JS). A path that doesn't resolve to a real file
 * renders an honest notice instead of failing the build, since a stale
 * registry entry (path edited, file moved) should be visible on the page,
 * not a 500.
 *
 * `demoProps` is the registry entry's own `demoProps` field, spread onto the
 * live component. `demoSlots` is its sibling for slot-composed primitives
 * (the layout set): static demo HTML for the `default` and `media` slots,
 * so Stack/Inline/Split/Bleed/Grid render with visible children instead of
 * as empty elements.
 */
interface Props {
  componentPath: string;
  demoProps?: Readonly<Record<string, unknown>>;
  demoSlots?: Readonly<Partial<Record<"default" | "media", string>>>;
}

const { componentPath, demoProps, demoSlots } = Astro.props;

const templateModules = {
  ...import.meta.glob("/src/components/templates/**/*.astro", { eager: true }),
  ...import.meta.glob("/src/components/system/**/*.astro", { eager: true }),
} as Record<string, { default: unknown }>;

const key = componentPath.startsWith("/") ? componentPath : `/${componentPath}`;
const Component = templateModules[key]?.default;
---

{
  Component ? (
    <div class="rounded-md border border-gray-200 p-space-sm">
      {/* @ts-expect-error — resolved dynamically from the registry's componentPath; not statically typeable */}
      <Component {...(demoProps ?? {})}>
        {demoSlots?.default && <Fragment set:html={demoSlots.default} />}
        {demoSlots?.media && <Fragment slot="media" set:html={demoSlots.media} />}
      </Component>
    </div>
  ) : (
    <p class="rounded-md border border-gray-200 bg-gray-50 p-space-xs font-mono text-sm text-gray-500">
      Registry says built, but no file resolves at {componentPath}.
    </p>
  )
}
