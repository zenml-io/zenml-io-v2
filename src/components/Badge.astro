---
/**
 * Badge — small chip for tags, categories, status indicators.
 * Renders as <a> when href is provided, <span> otherwise.
 */
import { CHIP_VARIANT_CLASS, type ChipVariant } from "../lib/chipStyles";

type Variant = ChipVariant;

interface Props {
  href?: string;
  variant?: Variant;
  class?: string;
}

const { href, variant = "gray", class: className } = Astro.props;

const baseClasses =
  "inline-flex items-center rounded-pill px-2.5 py-0.5 text-xs font-medium transition-colors";

const variantClasses: Record<Variant, string> = CHIP_VARIANT_CLASS;

const classes = [baseClasses, variantClasses[variant], className]
  .filter(Boolean)
  .join(" ");
---

{
  href ? (
    <a href={href} class={classes}>
      <slot />
    </a>
  ) : (
    <span class={classes}>
      <slot />
    </span>
  )
}
