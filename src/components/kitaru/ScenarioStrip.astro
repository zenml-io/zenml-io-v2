---
const checkpoints = ["prompt", "search", "retrieve", "tool", "model", "answer"];
const changes = ["Prompt", "Tool input", "Tool output", "Step code", "Model"];
---

<section id="scenario-strip" class="scenario-section section-pad" aria-labelledby="scenario-title">
  <div class="section-inner">
    <header class="scenario-head" data-reveal>
      <div>
        <span class="section-eyebrow">TEST AGAINST WHAT REALLY HAPPENED</span>
        <h2 id="scenario-title" class="scenario-title">
          Change one thing.<br /><span>See what would have happened.</span>
        </h2>
      </div>
      <p class="scenario-sub">
        Start from a real agent run. Try a different prompt, tool input, tool output, piece of code, or model.
        Compare the replay with what actually happened.
      </p>
    </header>

    <div class="replay-scene" data-reveal>
      <div class="scene-light" aria-hidden="true"></div>

      <div class="scene-topline">
        <span><i></i> ONE REAL AGENT RUN</span>
        <code>original stays untouched</code>
      </div>

      <div class="scene-body">
        <div class="source-object">
          <span class="object-label">WHAT ACTUALLY HAPPENED</span>
          <div class="trace-stack">
            <div class="trace-shadow trace-shadow-two" aria-hidden="true"></div>
            <div class="trace-shadow trace-shadow-one" aria-hidden="true"></div>
            <div class="trace-card">
              <div class="trace-card-head">
                <div>
                  <small>EXECUTION</small>
                  <strong>support-agent</strong>
                </div>
                <code>tr_8f3a91c2</code>
              </div>

              <ol class="trace-line" aria-label="Recorded execution checkpoints">
                {checkpoints.map((checkpoint) => (
                  <li><i></i><span>{checkpoint}</span></li>
                ))}
              </ol>
            </div>
          </div>
          <p><span>THE ORIGINAL</span> stays intact</p>
        </div>

        <div class="replay-action">
          <div class="connector connector-in" aria-hidden="true"></div>
          <div class="replay-orbit">
            <span class="orbit-arrow" aria-hidden="true">↻</span>
            <small>TRY</small>
            <strong>One<br />change</strong>
          </div>
          <div class="connector connector-out" aria-hidden="true"></div>

          <ul class="change-legend" aria-label="Things that can change in a replay">
            {changes.map((change) => <li>{change}</li>)}
          </ul>
        </div>

        <div class="diff-object">
          <div class="diff-topline">
            <span>WHAT CHANGED</span>
            <code>ONE EXAMPLE</code>
          </div>

          <div class="diff-pair">
            <div class="diff-value">
              <small>ORIGINAL</small>
              <strong>Refund<br />failed</strong>
            </div>
            <i aria-hidden="true">→</i>
            <div class="diff-value diff-value-new">
              <small>WITH ONE CHANGE</small>
              <strong>Refund<br />issued</strong>
            </div>
          </div>

          <div class="change-summary" aria-label="The payment tool result changed from error to success">
            <span>CHANGED</span>
            <p>Payment tool result: <del>error</del><i aria-hidden="true">→</i><ins>success</ins></p>
          </div>
        </div>
      </div>

      <div class="scene-outcome">
        <p><span>ONE RUN</span> Did the change help?</p>
        <i aria-hidden="true"></i>
        <p><span>MANY RUNS</span> Does it keep helping?</p>
        <small>Repeat the same test across related production runs.</small>
      </div>
    </div>
  </div>
</section>

<style>
  .scenario-section {
    position: relative;
    overflow: hidden;
    border-block: 1px solid #e0cfb7;
    background: #fcfaf6;
  }

  .scenario-section::before {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 11% 20%, #fbe8db 0, transparent 25%),
      radial-gradient(circle at 88% 78%, #ebf0d8 0, transparent 28%);
    content: "";
    pointer-events: none;
  }

  .scenario-head {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(280px, 0.55fr);
    gap: clamp(32px, 7vw, 96px);
    align-items: end;
    margin-bottom: clamp(34px, 5vw, 58px);
  }

  .scenario-title {
    max-width: 860px;
    margin: 14px 0 0;
    color: var(--color-primary);
    font-size: clamp(2.25rem, 4.8vw, 4rem);
    font-weight: 700;
    line-height: 1.01;
    letter-spacing: -0.045em;
  }

  .scenario-title span { color: #b65916; }

  .scenario-sub {
    max-width: 390px;
    margin: 0 0 4px;
    color: var(--color-secondary);
    font-size: clamp(1rem, 1.4vw, 1.12rem);
    font-weight: 300;
    line-height: 1.65;
  }

  .replay-scene {
    --green-50: #f6f9f1;
    --green-100: #ebf0d8;
    --green-200: #e3e8cd;
    --green-400: #becaa6;
    --green-600: #7a9268;
    --green-700: #63775e;
    --green-800: #3c4c38;
    --green-900: #151e19;
    --orange-50: #fcf7f2;
    --orange-100: #fbe8db;
    --orange-300: #f7b382;
    --orange-500: #eb7119;
    --orange-700: #844315;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--green-200);
    border-radius: 26px;
    background: var(--green-50);
    color: var(--green-900);
    box-shadow: 0 36px 84px -56px rgb(60 76 56 / 0.44), inset 0 1px rgb(255 255 255 / 0.92);
  }

  .scene-light {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 37% 42%, rgb(247 179 130 / 0.24), transparent 24%),
      radial-gradient(circle at 73% 55%, rgb(190 202 166 / 0.48), transparent 30%);
    pointer-events: none;
  }

  .scene-topline {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 48px;
    padding: 0 20px;
    border-bottom: 1px solid var(--green-200);
    background: rgb(255 255 255 / 0.58);
    color: var(--green-700);
    font-family: var(--font-mono);
    font-size: 0.59rem;
    letter-spacing: 0.09em;
  }

  .scene-topline > span { display: flex; gap: 8px; align-items: center; }
  .scene-topline i { width: 7px; height: 7px; border-radius: 50%; background: var(--orange-500); box-shadow: 0 0 0 4px rgb(235 113 25 / 0.11); }
  .scene-topline code { color: var(--green-600); font-size: 0.58rem; }

  .scene-body {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(180px, 0.62fr) minmax(0, 1fr);
    gap: clamp(22px, 3vw, 42px);
    align-items: center;
    min-height: 400px;
    padding: clamp(44px, 6vw, 72px) clamp(28px, 5vw, 62px) 46px;
  }

  .object-label {
    display: block;
    margin-bottom: 13px;
    color: var(--green-700);
    font-family: var(--font-mono);
    font-size: 0.53rem;
    letter-spacing: 0.09em;
  }

  .trace-stack { position: relative; padding: 0 12px 13px 0; }
  .trace-shadow { position: absolute; border: 1px solid rgb(122 146 104 / 0.16); border-radius: 18px; background: rgb(227 232 205 / 0.6); }
  .trace-shadow-one { inset: 8px 4px 5px 8px; transform: translateY(8px); }
  .trace-shadow-two { inset: 14px 0 0 15px; transform: translateY(13px); opacity: 0.65; }
  .trace-card { position: relative; z-index: 1; min-height: 178px; padding: 20px; border: 1px solid rgb(122 146 104 / 0.22); border-radius: 18px; background: rgb(255 255 255 / 0.85); box-shadow: 0 20px 42px rgb(60 76 56 / 0.08), inset 0 1px white; }
  .trace-card-head { display: flex; justify-content: space-between; gap: 20px; align-items: start; }
  .trace-card-head > div { display: flex; flex-direction: column; gap: 5px; }
  .trace-card-head small { color: var(--green-600); font-family: var(--font-mono); font-size: 0.48rem; letter-spacing: 0.08em; }
  .trace-card-head strong { font-size: 0.86rem; }
  .trace-card-head code { color: var(--green-600); font-size: 0.52rem; }
  .trace-line { display: grid; grid-template-columns: repeat(6, 1fr); margin: 38px 0 0; padding: 0; list-style: none; }
  .trace-line li { position: relative; display: flex; flex-direction: column; gap: 9px; align-items: center; color: var(--green-700); font-family: var(--font-mono); font-size: 0.43rem; text-transform: uppercase; }
  .trace-line li::after { position: absolute; top: 7px; left: 50%; width: 100%; height: 1px; background: var(--green-400); content: ""; }
  .trace-line li:last-child::after { display: none; }
  .trace-line i { position: relative; z-index: 1; width: 14px; height: 14px; border: 4px solid white; border-radius: 4px; background: var(--green-600); box-shadow: 0 0 0 1px rgb(60 76 56 / 0.2); transform: rotate(45deg); }
  .source-object > p { margin: 14px 0 0; color: var(--green-700); font-size: 0.66rem; }
  .source-object > p span { color: var(--orange-700); font-family: var(--font-mono); font-size: 0.56rem; letter-spacing: 0.06em; text-transform: uppercase; }

  .replay-action { position: relative; display: flex; flex-direction: column; align-items: center; min-width: 0; }
  .connector { position: absolute; top: 82px; height: 1px; background: linear-gradient(90deg, var(--green-400), var(--orange-300)); }
  .connector::after { position: absolute; top: -3px; width: 7px; height: 7px; border-radius: 50%; background: var(--orange-500); content: ""; }
  .connector-in { right: calc(50% + 64px); left: calc(-1 * clamp(22px, 3vw, 42px)); }
  .connector-in::after { right: 0; }
  .connector-out { right: calc(-1 * clamp(22px, 3vw, 42px)); left: calc(50% + 64px); }
  .connector-out::after { left: 0; }
  .replay-orbit { position: relative; display: grid; width: 142px; height: 142px; place-content: center; border: 1px solid var(--orange-300); border-radius: 50%; background: var(--orange-50); box-shadow: 0 0 0 12px rgb(251 232 219 / 0.44), 0 18px 34px rgb(132 67 21 / 0.09); text-align: center; }
  .replay-orbit::before { position: absolute; inset: 11px; border: 1px dashed rgb(235 113 25 / 0.34); border-radius: 50%; content: ""; }
  .orbit-arrow { position: absolute; top: -13px; left: 50%; display: grid; width: 27px; height: 27px; place-items: center; border: 1px solid var(--orange-300); border-radius: 50%; background: white; color: var(--orange-500); font-size: 1rem; transform: translateX(-50%); }
  .replay-orbit small { position: relative; color: var(--orange-700); font-family: var(--font-mono); font-size: 0.49rem; letter-spacing: 0.1em; }
  .replay-orbit strong { position: relative; margin-top: 6px; font-size: 1rem; line-height: 1.05; }
  .change-legend { display: flex; flex-wrap: wrap; gap: 5px; justify-content: center; max-width: 230px; margin: 22px 0 0; padding: 0; list-style: none; }
  .change-legend li { padding: 5px 7px; border-radius: 999px; background: rgb(255 255 255 / 0.66); color: var(--green-700); font-family: var(--font-mono); font-size: 0.44rem; white-space: nowrap; }

  .diff-object { overflow: hidden; border: 1px solid rgb(122 146 104 / 0.22); border-radius: 18px; background: rgb(255 255 255 / 0.84); box-shadow: 0 20px 42px rgb(60 76 56 / 0.08), inset 0 1px white; }
  .diff-topline { display: flex; justify-content: space-between; padding: 12px 15px; border-bottom: 1px solid var(--green-200); color: var(--green-600); font-family: var(--font-mono); font-size: 0.49rem; letter-spacing: 0.08em; }
  .diff-topline code { color: var(--orange-700); font-size: 0.52rem; }
  .diff-pair { display: grid; grid-template-columns: 1fr auto 1fr; gap: 9px; align-items: center; padding: 20px 17px 14px; }
  .diff-value { display: flex; flex-direction: column; gap: 7px; min-width: 0; padding: 15px 12px; border: 1px solid var(--green-200); border-radius: 12px; background: var(--green-50); }
  .diff-value small { color: var(--green-600); font-family: var(--font-mono); font-size: 0.46rem; letter-spacing: 0.08em; }
  .diff-value strong { color: var(--green-900); font-size: 0.78rem; font-weight: 650; line-height: 1.12; }
  .diff-value-new { border-color: var(--orange-300); background: var(--orange-50); color: var(--orange-700); }
  .diff-value-new strong { color: var(--orange-700); }
  .diff-pair > i { color: var(--orange-500); font-style: normal; }
  .change-summary { display: flex; gap: 10px; align-items: center; margin: 0 17px 18px; padding: 10px 11px; border-radius: 8px; background: var(--orange-50); }
  .change-summary > span { flex: 0 0 auto; color: var(--orange-700); font-family: var(--font-mono); font-size: 0.44rem; letter-spacing: 0.08em; }
  .change-summary p { display: flex; flex-wrap: wrap; gap: 5px; align-items: center; margin: 0; color: var(--green-800); font-size: 0.58rem; }
  .change-summary del { color: #8c7d70; }
  .change-summary ins { color: var(--orange-700); font-weight: 600; text-decoration: none; }
  .change-summary i { color: var(--orange-500); font-style: normal; }

  .scene-outcome { position: relative; display: grid; grid-template-columns: 1fr auto 1fr auto; gap: clamp(18px, 3vw, 42px); align-items: center; padding: 21px clamp(28px, 5vw, 62px); border-top: 1px solid var(--green-200); background: rgb(255 255 255 / 0.52); }
  .scene-outcome p { margin: 0; color: var(--green-800); font-size: 0.76rem; }
  .scene-outcome p span { margin-right: 7px; color: var(--orange-700); font-family: var(--font-mono); font-size: 0.53rem; letter-spacing: 0.07em; }
  .scene-outcome > i { width: 1px; height: 22px; background: var(--green-200); }
  .scene-outcome small { color: var(--green-700); font-size: 0.6rem; }

  @media (max-width: 900px) {
    .scene-body { grid-template-columns: minmax(0, 1fr) minmax(150px, 0.55fr) minmax(0, 1fr); gap: 18px; padding-inline: 20px; }
    .connector-in { left: -20px; }
    .connector-out { right: -20px; }
    .replay-orbit { width: 122px; height: 122px; }
  }

  @media (max-width: 820px) {
    .scenario-head { grid-template-columns: 1fr; gap: 22px; }
    .scenario-sub { max-width: 650px; }
    .scene-body { grid-template-columns: 1fr; gap: 22px; padding: 30px 20px 28px; }
    .source-object, .diff-object { width: 100%; max-width: 520px; margin-inline: auto; }
    .replay-action { width: 100%; max-width: 520px; min-height: 0; margin-inline: auto; }
    .connector { display: none; }
    .replay-orbit { display: flex; gap: 9px; align-items: center; justify-content: center; width: 100%; height: auto; padding: 13px 16px; border-radius: 14px; box-shadow: 0 0 0 6px rgb(251 232 219 / 0.4), 0 12px 25px rgb(132 67 21 / 0.07); }
    .replay-orbit::before { display: none; }
    .orbit-arrow { position: static; flex: 0 0 auto; transform: none; }
    .replay-orbit small { padding-right: 9px; border-right: 1px solid var(--orange-300); }
    .replay-orbit strong { margin-top: 0; font-size: 0.9rem; }
    .replay-orbit strong br { display: none; }
    .change-legend { display: grid; grid-template-columns: repeat(3, auto); gap: 6px; max-width: 360px; margin-top: 13px; }
    .change-legend li { padding: 6px 9px; font-size: 0.5rem; text-align: center; }
    .scene-outcome { grid-template-columns: 1fr; gap: 9px; }
    .scene-outcome > i { width: 100%; height: 1px; }
  }

  @media (max-width: 560px) {
    .scenario-section.section-pad { padding-block: 28px; }
    .scenario-head { margin-bottom: 24px; }
    .scenario-title { font-size: clamp(2rem, 9.5vw, 2.45rem); }
    .scenario-sub { display: none; }
    .replay-scene { margin-inline: 0; border-radius: 15px; }
    .scene-topline { min-height: 40px; padding-inline: 11px; font-size: 0.5rem; }
    .scene-topline code { font-size: 0; }
    .scene-topline code::after { font-size: 0.52rem; content: "FIXED"; }
    .scene-body { gap: 14px; padding: 18px 12px 17px; }
    .scene-body > * { min-width: 0; }
    .object-label { margin-bottom: 8px; }
    .trace-stack { padding-bottom: 10px; }
    .trace-card { min-height: 112px; padding: 13px 11px; }
    .trace-card-head code { display: none; }
    .trace-line { margin-top: 23px; }
    .trace-line span { display: none; }
    .trace-line i { width: 12px; height: 12px; }
    .source-object > p { margin-top: 8px; }
    .replay-orbit { width: 100%; height: auto; }
    .replay-orbit { padding-block: 9px; }
    .orbit-arrow { width: 23px; height: 23px; }
    .change-legend { margin-top: 9px; }
    .change-legend li { padding-block: 4px; }
    .diff-topline { padding: 9px 11px; }
    .diff-pair { padding: 12px 10px 9px; }
    .diff-value { gap: 4px; padding: 9px 7px; }
    .change-summary { margin: 0 10px 11px; padding-block: 8px; }
    .scene-outcome { gap: 7px; padding: 13px 12px; }
    .scene-outcome small { display: none; }
  }
</style>
