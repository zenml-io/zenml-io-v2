---
// Faq.astro — product questions, in the register of the rest of the page.
// Static (native <details>/<summary>, zero JS); scroll-reveal comes from
// the page-level reveal-static script like Features and Cta.
import { FAQ_HELP_LINKS, FAQ_ITEMS } from "../../lib/kitaru-landing";
---

<section id="faq" class="relative w-full bg-background text-foreground">
  <div class="mx-auto w-full max-w-content px-gutter py-20 md:py-28">
    <div class="grid grid-cols-1 gap-14 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-20">
      {/* Left column: eyebrow, headline, lede, help links */}
      <div class="lg:sticky lg:top-24 lg:self-start">
        <div class="reveal">
          <span class="inline-block font-label text-[13px] tracking-[0.05em] text-ember uppercase">
            FAQ
          </span>
          <h2 class="mt-space-sm font-display text-[32px] leading-[36px] text-balance text-(--color-cream-900) md:text-[44px] md:leading-[48px]">
            Frequently asked
            <br />
            <span class="text-ember">questions</span>
          </h2>
          <p class="mt-space-sm font-sans text-[17px] leading-[26px] text-foreground md:text-[18px] md:leading-[27px]">
            Everything you need to know about Kitaru.
          </p>
        </div>

        <div class="reveal mt-12" style="--reveal-delay: 120ms">
          <span class="inline-block font-label text-[13px] tracking-[0.05em] text-ink-soft uppercase">
            Help
          </span>
          <div class="mt-4">
            {FAQ_HELP_LINKS.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener"
                data-analytics={link.analytics}
                class="group flex cursor-pointer items-center justify-between border-b border-border py-4 first:border-t"
              >
                <span class="font-sans text-[16px] text-ink">{link.label}</span>
                <svg
                  class="size-3.5 shrink-0 text-ink-soft transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-ember"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              </a>
            ))}
          </div>
        </div>
      </div>

      {/* Right column: FAQ accordion. One reveal wrapper — per-item reveal
          would give each <details> its own observer (dead delay + invisible
          focusable summaries), and the max-w keeps summary rows readable at
          840–1023px where the grid is still single-column. */}
      <div class="reveal max-w-3xl border-t border-border" style="--reveal-delay: 120ms">
        {FAQ_ITEMS.map((item) => (
          <details class="group border-b border-border">
            <summary class="flex cursor-pointer items-center justify-between gap-6 py-6 text-left font-display text-[20px] leading-[26px] text-(--color-cream-900) [&::-webkit-details-marker]:hidden">
              <span>{item.question}</span>
              <span
                class="font-label text-[20px] leading-none text-ember transition-transform duration-200 group-open:rotate-45"
                aria-hidden="true">+</span
              >
            </summary>
            <p
              class="pb-7 max-w-2xl text-[16px] leading-[1.6] text-ink-soft [&_a]:underline [&_a]:decoration-ember/40 [&_a]:underline-offset-2 hover:[&_a]:decoration-ember"
              set:html={item.answer}
            />
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

{/* Accordion open/close transition — CSS-only progressive enhancement.
    Scoped here (not in kitaru-compat.css) so the rules live and die with the
    markup. The @supports gate matters: Firefox/Safari versions that support
    ::details-content but not interpolate-size would otherwise get a broken
    discrete half-animation instead of a clean instant toggle. */}
<style>
  @media (prefers-reduced-motion: no-preference) {
    @supports (interpolate-size: allow-keywords) {
      section {
        interpolate-size: allow-keywords;
      }
      details::details-content {
        opacity: 0;
        block-size: 0;
        overflow-y: clip;
        transition:
          content-visibility 300ms allow-discrete,
          opacity 300ms ease,
          block-size 300ms ease;
      }
      details[open]::details-content {
        opacity: 1;
        block-size: auto;
      }
    }
  }
</style>
