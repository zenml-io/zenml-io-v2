---
// _HighlightPanel.astro — shared shell for the step-card product-UI
// highlights: fixed-height bordered panel with the hover-revealed grain
// backdrop. Panel contents slot in and must lift themselves above the
// grain with `relative z-10`.
import { KitaruGrain } from "./islands/KitaruGrain";
---

<div
  class="group relative isolate mt-6 flex h-[210px] flex-col overflow-hidden rounded-lg border border-border bg-surface p-3.5"
>
  {/* hover: hover — the grain is only ever revealed by group-hover, so
      touch devices skip hydrating it entirely (same gate as CategoryBar). */}
  <KitaruGrain variant="card" client:media="(hover: hover)" class="z-0" />
  <slot />
</div>
