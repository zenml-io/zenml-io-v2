---
// Features.astro — the what-if workflow, told as the cheap-model use case:
// replay 200 real runs with a cheaper model and a faked checkpoint result,
// then diff.
// Replaces the old durable-execution scroll-stack. No fragile scroll JS —
// data-reveal only.
const steps = [
  {
    n: "01",
    tag: "Replay",
    title: "Start from execution IDs",
    body: "200 real executions whose Kitaru-visible steps and model/tool calls are already checkpointed. Production stays untouched.",
    code: "exec_ids = cohort.exec_ids",
  },
  {
    n: "02",
    tag: "Change one thing",
    title: "Cheaper model, flaky tool",
    body: "Replay from the decision point with a cheaper model, or replace a recorded lookup result. Production stays exactly as it was.",
    code: 'replay(id, from_="decide", model="fast")',
  },
  {
    n: "03",
    tag: "Diff",
    title: "See what would have happened",
    body: "Compare each candidate to its source execution: cost, changed outputs, first divergence. The decision now has evidence.",
    code: "kitaru.diff_matrix(exec_ids)",
  },
] as const;

// Source logos for the "Start from" panel. slug → /images/kitaru-sources/{slug}.png
const recordedSources = [
  { slug: "pydantic", name: "Pydantic AI" },
  { slug: "langgraph", name: "LangGraph" },
  { slug: "openai", name: "OpenAI Agents SDK" },
  { slug: "claude", name: "Claude Agent SDK" },
  { slug: "python", name: "Raw Python" },
] as const;
---

<section id="how-it-works" class="whatif-section section-pad">
  <div class="section-inner">
    <div class="whatif-header" data-reveal>
      <span class="section-eyebrow">THE WHAT-IF WORKFLOW</span>
      <h2 class="section-title">Find a cheaper model without touching production.</h2>
      <p class="section-desc">
        Same question every time: can it run cheaper, and does it survive a flaky tool result? Replay the runs you already have, change one thing, read the diff.
      </p>

    </div>

    <div class="whatif-sources" data-reveal>
      <span class="whatif-sources-label">Start from</span>
      <span class="src-pill">Kitaru-recorded executions</span>
    </div>

    <div class="src-panels" data-reveal>
      <div class="src-panel is-active" id="src-recorded" role="region" aria-label="Start from Kitaru-recorded executions">
        <p class="src-line">Wrap your agent so model/tool calls and steps exposed through Kitaru primitives or adapters become replayable checkpoints.</p>
        <div class="src-logos">
          {
            recordedSources.map((s) => (
              <span class="src-logo">
                <img src={`/images/kitaru-sources/${s.slug}.png`} alt="" aria-hidden="true" width="22" height="22" loading="lazy" />
                {s.name}
              </span>
            ))
          }
        </div>
      </div>
    </div>

    <div class="whatif-steps">
      {
        steps.map((s, i) => (
          <div class="whatif-step" data-reveal="fade-up" data-reveal-delay={i + 1}>
            <div class="whatif-step-head">
              <span class="whatif-step-n">{s.n}</span>
              <span class="whatif-step-tag">{s.tag}</span>
            </div>
            <h3 class="whatif-step-title">{s.title}</h3>
            <p class="whatif-step-body">{s.body}</p>
            <code class="whatif-step-code">{s.code}</code>
          </div>
        ))
      }
    </div>

    <div class="whatif-payoff" data-reveal="fade-up" data-reveal-delay="3">
      <div class="whatif-payoff-label">
        <span class="whatif-payoff-eyebrow">The diff</span>
        <p>Same 200 executions. Cheap model. Order lookup result replaced.</p>
      </div>
      <div class="whatif-payoff-metrics">
        <div class="whatif-metric">
          <span class="whatif-metric-value whatif-metric-win">&minus;61%</span>
          <span class="whatif-metric-key">median cost</span>
        </div>
        <div class="whatif-metric">
          <span class="whatif-metric-value">196 / 200</span>
          <span class="whatif-metric-key">outputs identical</span>
        </div>
        <div class="whatif-metric">
          <span class="whatif-metric-value whatif-metric-warn">4</span>
          <span class="whatif-metric-key">to review</span>
        </div>
      </div>
    </div>

    <p class="whatif-foot" data-reveal>
      Illustrative numbers. Tool-level detail depends on the primitives or adapter boundaries your agent exposes to Kitaru.
    </p>
  </div>
</section>

<style>
  .whatif-section {
    background: var(--color-surface-warm);
    border-top: 1px solid var(--color-border);
  }

  .whatif-header {
    max-width: 760px;
    margin-bottom: 28px;
  }

  .section-desc {
    margin-top: 16px;
    color: var(--color-secondary);
    font-size: clamp(1rem, 1.6vw, 1.1rem);
    line-height: 1.65;
    font-weight: 300;
  }

  /* ─── "Start from" source panel ─── */
  .whatif-sources {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 24px;
  }

  .whatif-sources-label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .src-pill {
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-accent);
    padding: 6px 14px;
    border: 1px solid oklch(0.65 0.16 45 / 0.4);
    border-radius: 100px;
    background: oklch(0.65 0.16 45 / 0.08);
  }

  /* Reveal panels */
  .src-panels {
    margin-top: 16px;
    margin-bottom: 48px;
  }

  .src-panel {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 28px 30px;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-surface);
    animation: src-fade 0.3s ease;
  }


  @keyframes src-fade {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .src-line {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--color-primary);
    font-weight: 500;
  }

  .src-logos {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .src-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-primary);
    padding: 11px 18px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-surface-warm);
  }

  .src-logo img {
    width: 22px;
    height: 22px;
    border-radius: 5px;
    object-fit: contain;
    flex-shrink: 0;
  }

  /* ─── Steps ─── */
  .whatif-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .whatif-step {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
    padding: 28px 26px;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-surface);
    transition: border-color 0.25s, transform 0.25s;
  }

  .whatif-step:hover {
    border-color: oklch(0.65 0.16 45 / 0.3);
    transform: translateY(-3px);
  }

  .whatif-step-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .whatif-step-n {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .whatif-step-tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    padding: 3px 9px;
    border: 1px solid var(--color-border);
    border-radius: 100px;
  }

  .whatif-step-title {
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-primary);
    margin: 0;
  }

  .whatif-step-body {
    flex: 1;
    font-size: 0.95rem;
    line-height: 1.6;
    font-weight: 300;
    color: var(--color-secondary);
    margin: 0;
  }

  .whatif-step-code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-accent);
    background: oklch(0.65 0.16 45 / 0.07);
    border: 1px solid oklch(0.65 0.16 45 / 0.18);
    border-radius: 8px;
    padding: 10px 12px;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  /* ─── Payoff: the diff ─── */
  .whatif-payoff {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 32px;
    align-items: center;
    margin-top: 24px;
    padding: 28px 32px;
    border: 1px solid oklch(0.65 0.16 45 / 0.3);
    border-radius: 16px;
    background: linear-gradient(
      180deg,
      oklch(0.65 0.16 45 / 0.07) 0%,
      oklch(0.65 0.16 45 / 0.02) 100%
    );
  }

  .whatif-payoff-eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 8px;
  }

  .whatif-payoff-label p {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.5;
    color: var(--color-primary);
    font-weight: 400;
  }

  .whatif-payoff-metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .whatif-metric {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 18px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }

  .whatif-metric-value {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-primary);
  }

  .whatif-metric-win {
    color: var(--color-accent);
  }

  .whatif-metric-warn {
    color: var(--color-cost-up);
  }

  .whatif-metric-key {
    font-size: 0.72rem;
    color: var(--color-muted);
    letter-spacing: 0.01em;
  }

  .whatif-foot {
    margin: 20px 0 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--color-muted);
    font-style: italic;
  }

  @media (max-width: 900px) {
    .whatif-steps {
      grid-template-columns: 1fr;
    }
    .whatif-payoff {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  @media (max-width: 540px) {
    .whatif-payoff-metrics {
      grid-template-columns: 1fr;
    }
  }
</style>
