---
// Features.astro — The migration wedge: model swap + comparison
import { STEPS } from "../../lib/kitaru-landing";
---

<section id="how-it-works" class="relative w-full bg-surface text-foreground">
  <div class="mx-auto w-full max-w-[1180px] px-6 py-24 md:py-36">
    {/* Header with eyebrow, title, lede */}
    <div class="reveal max-w-3xl">
      <span class="inline-block font-mono text-[11px] tracking-[0.22em] text-ember uppercase">
        The migration you keep postponing
      </span>
      <h2 class="mt-5 text-balance text-3xl leading-[1.1] font-medium tracking-[-0.02em] md:text-[2.75rem]">
        Ship the cheaper model without shipping a regression.
      </h2>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-soft md:text-lg">
        Nobody moves, because nobody can say what it would break. Two runs over your real
        sessions can.
      </p>
    </div>

    {/* Three-column steps grid */}
    <div class="mt-16 grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-8">
      {STEPS.map((s, i) => (
        <div
          class="reveal relative"
          style={`--reveal-delay: ${i * 110}ms`}
        >
          <div class="flex items-baseline gap-3">
            <span class="font-mono text-[11px] text-ember">{s.n}</span>
            <span class="font-mono text-[11px] tracking-[0.16em] text-muted-foreground uppercase">
              {s.tag}
            </span>
          </div>
          <div class="mt-4 h-px w-full bg-border" />
          <h3 class="mt-5 text-[19px] leading-snug font-medium tracking-[-0.015em]">
            {s.title}
          </h3>
          <p class="mt-3 text-[14px] leading-relaxed text-ink-soft">{s.body}</p>
          <pre class="mt-6 block overflow-x-auto rounded-md border border-border bg-background px-3 py-2 font-mono text-[11.5px] text-ink-soft">
            <code class="code-syntax">
              {s.n === "01" && (
                <>
                  <span class="fn">kitaru</span> cohort <span class="fn">create</span> <span class="str">"checkout-flow"</span>
                </>
              )}
              {s.n === "02" && (
                <>
                  <span class="fn">kitaru</span> experiment <span class="fn">create</span> cheap-model
                </>
              )}
              {s.n === "03" && (
                <>
                  <span class="fn">kitaru</span> experiment <span class="fn">run</span> cheap-model
                </>
              )}
            </code>
          </pre>
        </div>
      ))}
    </div>

    {/* The diff stats box */}
    <div
      class="reveal mt-16"
      style={`--reveal-delay: 260ms`}
    >
      <div class="grid grid-cols-1 gap-8 rounded-xl border border-border bg-background p-8 md:grid-cols-[1fr_1.4fr] md:items-center md:p-10">
        <div>
          <span class="font-mono text-[11px] tracking-[0.16em] text-ember uppercase">
            The diff
          </span>
          <p class="mt-3 text-[15px] leading-relaxed text-ink-soft">
            Same 200 sessions. Same evaluator. One model swapped.
          </p>
        </div>
        <div class="grid grid-cols-3 gap-6">
          {[
            { v: "−61%", k: "median cost", tone: "text-success" },
            { v: "196 / 200", k: "outputs identical", tone: "" },
            { v: "4", k: "to review", tone: "text-warn" },
          ].map((m) => (
            <div>
              <div class={`font-mono text-2xl tracking-[-0.02em] md:text-3xl ${m.tone}`}>
                {m.v}
              </div>
              <div class="mt-1.5 text-[11.5px] text-muted-foreground">{m.k}</div>
            </div>
          ))}
        </div>
      </div>
    </div>

    {/* Disclaimer note */}
    <div class="reveal mt-6" style={`--reveal-delay: 320ms`}>
      <p class="max-w-2xl text-[12.5px] leading-relaxed text-muted-foreground">
        Illustrative numbers. Kitaru grades every session ready, partial or unavailable at
        import, so you know before you rely on it.
      </p>
    </div>
  </div>
</section>
