---
// Features.astro — the model-migration wedge, which the Jul 24 research called
// the killer use case and noted was unnamed: everything it needs already exists
// in Act 4, so this is a naming and packaging job.
//
// Rewritten against the Jul 29 v2 vocabulary. A cohort is an immutable set of
// sessions. An experiment is pure configuration — model, prompt, tool policy —
// and is NOT tied to a cohort or an agent version. An experiment RUN is that
// config plus a cohort plus a version, and runs are what you compare.
const steps = [
  {
    n: "01",
    tag: "Cohort",
    title: "Freeze the sessions that matter",
    body: "The sessions you care about, frozen as a named set. Immutable, so a run's result keeps meaning what it meant.",
    code: 'kitaru cohort create "checkout-flow"',
  },
  {
    n: "02",
    tag: "Experiment",
    title: "State one hypothesis",
    body: "Just configuration: model, system prompt, tool policy. Swap the model and you have stated a different hypothesis.",
    code: "kitaru experiment create cheap-model",
  },
  {
    n: "03",
    tag: "Two runs",
    title: "Compare like with like",
    body: "Twice over the same cohort, one version apart. One variable moved, so the numbers mean what they look like.",
    code: "kitaru experiment run cheap-model",
  },
] as const;
---

<section id="how-it-works" class="whatif-section section-pad">
  <div class="section-inner">
    <div class="whatif-header" data-reveal>
      <span class="section-eyebrow">THE MIGRATION YOU KEEP POSTPONING</span>
      <h2 class="section-title">Ship the cheaper model without shipping a regression.</h2>
      <p class="section-desc">
        Nobody moves, because nobody can say what it would break. Two runs over your real sessions can.
      </p>

    </div>

    <div class="whatif-steps">
      {
        steps.map((s, i) => (
          <div class="whatif-step" data-reveal="fade-up" data-reveal-delay={i + 1}>
            <div class="whatif-step-head">
              <span class="whatif-step-n">{s.n}</span>
              <span class="whatif-step-tag">{s.tag}</span>
            </div>
            <h3 class="whatif-step-title">{s.title}</h3>
            <p class="whatif-step-body">{s.body}</p>
            <code class="whatif-step-code">{s.code}</code>
          </div>
        ))
      }
    </div>

    <div class="whatif-payoff" data-reveal="fade-up" data-reveal-delay="3">
      <div class="whatif-payoff-label">
        <span class="whatif-payoff-eyebrow">The diff</span>
        <p>Same 200 sessions. Same evaluator. One model swapped.</p>
      </div>
      <div class="whatif-payoff-metrics">
        <div class="whatif-metric">
          <span class="whatif-metric-value whatif-metric-win">&minus;61%</span>
          <span class="whatif-metric-key">median cost</span>
        </div>
        <div class="whatif-metric">
          <span class="whatif-metric-value">196 / 200</span>
          <span class="whatif-metric-key">outputs identical</span>
        </div>
        <div class="whatif-metric">
          <span class="whatif-metric-value whatif-metric-warn">4</span>
          <span class="whatif-metric-key">to review</span>
        </div>
      </div>
    </div>

    <p class="whatif-foot" data-reveal>
      Illustrative numbers. Kitaru grades every session ready, partial or unavailable at import, so you know before you rely on it.
    </p>
  </div>
</section>

<style>
  .whatif-section {
    background: var(--color-surface-warm);
    border-top: 1px solid var(--color-border);
  }

  .whatif-header {
    max-width: 760px;
    margin-bottom: 48px;
  }

  .section-desc {
    margin-top: 16px;
    color: var(--color-secondary);
    font-size: clamp(1rem, 1.6vw, 1.1rem);
    line-height: 1.65;
    font-weight: 300;
  }

  /* ─── Steps ─── */
  .whatif-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .whatif-step {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
    padding: 28px 26px;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-surface);
    transition: border-color 0.25s, transform 0.25s;
  }

  .whatif-step:hover {
    border-color: oklch(0.65 0.16 45 / 0.3);
    transform: translateY(-3px);
  }

  .whatif-step-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .whatif-step-n {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .whatif-step-tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    padding: 3px 9px;
    border: 1px solid var(--color-border);
    border-radius: 100px;
  }

  .whatif-step-title {
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-primary);
    margin: 0;
  }

  .whatif-step-body {
    flex: 1;
    font-size: 0.95rem;
    line-height: 1.6;
    font-weight: 300;
    color: var(--color-secondary);
    margin: 0;
  }

  .whatif-step-code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-accent);
    background: oklch(0.65 0.16 45 / 0.07);
    border: 1px solid oklch(0.65 0.16 45 / 0.18);
    border-radius: 8px;
    padding: 10px 12px;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  /* ─── Payoff: the diff ─── */
  .whatif-payoff {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 32px;
    align-items: center;
    margin-top: 24px;
    padding: 28px 32px;
    border: 1px solid oklch(0.65 0.16 45 / 0.3);
    border-radius: 16px;
    background: linear-gradient(
      180deg,
      oklch(0.65 0.16 45 / 0.07) 0%,
      oklch(0.65 0.16 45 / 0.02) 100%
    );
  }

  .whatif-payoff-eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 8px;
  }

  .whatif-payoff-label p {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.5;
    color: var(--color-primary);
    font-weight: 400;
  }

  .whatif-payoff-metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .whatif-metric {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 18px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }

  .whatif-metric-value {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-primary);
  }

  .whatif-metric-win {
    color: var(--color-accent);
  }

  .whatif-metric-warn {
    color: var(--color-cost-up);
  }

  .whatif-metric-key {
    font-size: 0.72rem;
    color: var(--color-muted);
    letter-spacing: 0.01em;
  }

  .whatif-foot {
    margin: 20px 0 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--color-muted);
    font-style: italic;
  }

  @media (max-width: 900px) {
    .whatif-steps {
      grid-template-columns: 1fr;
    }
    .whatif-payoff {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  @media (max-width: 540px) {
    .whatif-payoff-metrics {
      grid-template-columns: 1fr;
    }
  }
</style>
