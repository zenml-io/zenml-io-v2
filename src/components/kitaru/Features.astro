---
// Features.astro — model choice: compare on recorded calls, choose, confirm with a replay
import { STEPS } from "../../lib/kitaru-landing";
import SectionIntro from "../system/SectionIntro.astro";
import HighlightPanel from "./_HighlightPanel.astro";
---

<section id="how-it-works" class="relative w-full bg-surface text-foreground">
  <div class="mx-auto w-full max-w-content px-gutter py-20 md:py-28">
    {/* Header with eyebrow, title, lede */}
    <div class="reveal max-w-3xl">
      <span class="inline-block font-label text-[13px] tracking-[0.05em] text-ember uppercase">
        Not locked in
      </span>
      <h2 class="mt-space-sm font-display text-[32px] leading-[36px] text-balance text-(--color-cream-900) md:text-[44px] md:leading-[48px]">
        Cheaper, faster, better, or open?<br />
        <span class="text-ember">See which, on calls your agent really made.</span>
      </h2>
      <p class="mt-space-sm max-w-2xl font-sans text-[17px] leading-[26px] text-foreground md:text-[18px] md:leading-[27px]">
        Most teams pick a model once and never revisit it, because finding out is a project.
        Kitaru makes it an afternoon: compare at every recorded step, choose with the
        trade-offs in view, then confirm the winner with a full replay.
      </p>
    </div>

    {/* Three-column steps grid */}
    <div class="mt-16 grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-8">
      {STEPS.map((s, i) => (
        <div
          class="reveal relative"
          style={`--reveal-delay: ${i * 110}ms`}
        >
          <div class="flex items-baseline gap-3 font-label text-[13px] tracking-[0.05em]">
            <span class="text-ember">{s.n}</span>
            <span class="text-muted-foreground uppercase">
              {s.tag}
            </span>
          </div>
          <div class="mt-4 h-px w-full bg-border" />
          <SectionIntro
            heading={s.title}
            headingLevel={3}
            description={s.body}
            classOverrides={{
              heading: "font-display text-[24px] leading-[30px] text-(--color-cream-900)",
              headingSpacing: "mt-5",
              description: "text-[15px] leading-[1.6] text-ink-soft",
              descriptionSpacing: "mt-3",
            }}
          />

          {/* Minimal product-UI highlight — visual abstractions of the MVP screens
              in the Paper "Kitaru MVP" file (05 Cohorts / 07a New experiment /
              13 Comparison · run vs run): skeleton bars carry the shape, one
              fact per panel carries the meaning. */}
          {s.n === "01" && (
            <HighlightPanel>
              <div class="relative z-10 flex flex-1 flex-col justify-center space-y-1.5 font-mono text-[10.5px]">
                {[
                  { name: "gpt-5", tag: "today", hot: false, delay: 250 },
                  { name: "gpt-5-mini", tag: "cheaper tier", hot: true, delay: 400 },
                  { name: "open model", tag: "your provider", hot: true, delay: 550 },
                  { name: "llama (Ollama)", tag: "local", hot: true, delay: 700 },
                ].map((c) => (
                  <div
                    class={c.hot
                      ? "fh-wash flex items-center gap-2 rounded border border-ember/30 bg-ember-light/50 px-2 py-1.5"
                      : "flex items-center gap-2 px-2 py-1.5"}
                    style={`--fh-delay: ${c.delay + 300}ms`}
                  >
                    <span class={`fh-pop size-1.5 shrink-0 rounded-full ${c.hot ? "bg-ember" : "bg-border"}`} style={`--fh-delay: ${c.delay}ms`}></span>
                    <span class="fh-pop" style={`--fh-delay: ${c.delay}ms`}>{c.name}</span>
                    <span class="fh-pop ml-auto text-muted-foreground" style={`--fh-delay: ${c.delay}ms`}>{c.tag}</span>
                  </div>
                ))}
              </div>
              <div class="relative z-10 mt-auto flex items-center justify-between border-t border-border/60 pt-2.5 font-mono text-[10.5px]">
                <span class="text-muted-foreground">412 recorded calls</span>
                <span class="fh-pop rounded-full bg-ember px-2.5 py-1 font-medium text-(--color-cream-50)" style="--fh-delay: 1050ms">&times; 4 models</span>
              </div>
            </HighlightPanel>
          )}
          {s.n === "02" && (
            <HighlightPanel>
              <div class="relative z-10 flex flex-1 flex-col justify-center space-y-1.5 font-mono text-[10.5px]">
                {[
                  { goal: "closest to today", pick: "gpt-5-mini", delay: 300 },
                  { goal: "cheapest", pick: "open model", delay: 420 },
                  { goal: "fastest", pick: "gpt-5-mini", delay: 540 },
                ].map((r) => (
                  <div class="flex items-center gap-2 px-2 py-1">
                    <span class="fh-pop text-muted-foreground" style={`--fh-delay: ${r.delay}ms`}>{r.goal}</span>
                    <span class="fh-pop ml-auto" style={`--fh-delay: ${r.delay}ms`}>{r.pick}</span>
                  </div>
                ))}
                <div class="fh-wash flex items-center gap-2 rounded border border-ember/30 bg-ember-light/50 px-2 py-1.5" style="--fh-delay: 900ms">
                  <span class="fh-pop text-ember-deep" style="--fh-delay: 700ms">best mix</span>
                  <span class="fh-pop ml-auto text-ember-deep" style="--fh-delay: 750ms">3 models &middot; &minus;68%</span>
                </div>
              </div>
              <div class="relative z-10 mt-auto border-t border-border/60 pt-2.5 font-mono text-[10.5px] text-muted-foreground">
                <span class="line-through">model-x</span> excluded by your origin rule
              </div>
            </HighlightPanel>
          )}
          {s.n === "03" && (
            <HighlightPanel>
              <div class="relative z-10 border-b border-border/60 pb-2">
                <div class="fh-pop font-mono text-[10.5px] font-medium" style="--fh-delay: 250ms">same cohort &middot; same agent version</div>
                <div class="mt-1.5 flex flex-col gap-1 font-mono text-[10px]">
                  <span class="fh-pop flex items-center gap-1.5 text-muted-foreground" style="--fh-delay: 330ms"><span class="size-1.5 shrink-0 rounded-full bg-border"></span>baseline &middot; gpt-5</span>
                  <span class="fh-pop flex items-center gap-1.5 text-ember-deep" style="--fh-delay: 410ms"><span class="size-1.5 shrink-0 rounded-full bg-ember"></span>best mix &middot; 3 models</span>
                </div>
              </div>
              <div class="relative z-10 flex flex-1 flex-col justify-evenly">
                <div class="flex items-center gap-3 font-mono text-[10.5px]">
                  <div class="flex-1 space-y-1" aria-hidden="true">
                    <div class="fh-bar h-1.5 w-[72%] rounded-full bg-border/70" style="--fh-delay: 350ms"></div>
                    <div class="fh-bar h-1.5 w-[46%] rounded-full bg-ember/60" style="--fh-delay: 430ms"></div>
                  </div>
                  <span class="fh-pop w-10 text-right text-muted-foreground" style="--fh-delay: 600ms">&minus;31%</span>
                  <span class="fh-pop w-10 text-right" style="--fh-delay: 600ms">&minus;52%</span>
                  <span class="fh-pop w-12 text-right text-success" style="--fh-delay: 700ms">&minus;21pp</span>
                </div>
                <div class="flex items-center gap-3 font-mono text-[10.5px]">
                  <div class="flex-1 space-y-1" aria-hidden="true">
                    <div class="fh-bar h-1.5 w-[60%] rounded-full bg-border/70" style="--fh-delay: 550ms"></div>
                    <div class="fh-bar h-1.5 w-[38%] rounded-full bg-ember/60" style="--fh-delay: 630ms"></div>
                  </div>
                  <span class="fh-pop w-10 text-right text-muted-foreground" style="--fh-delay: 800ms">&minus;3.9s</span>
                  <span class="fh-pop w-10 text-right" style="--fh-delay: 800ms">&minus;5.9s</span>
                  <span class="fh-pop w-12 text-right text-success" style="--fh-delay: 900ms">&minus;2.0s</span>
                </div>
                <div class="flex items-center gap-3 font-mono text-[10.5px]">
                  <div class="flex-1 space-y-1" aria-hidden="true">
                    <div class="fh-bar h-1.5 w-[64%] rounded-full bg-border/70" style="--fh-delay: 750ms"></div>
                    <div class="fh-bar h-1.5 w-[71%] rounded-full bg-ember/60" style="--fh-delay: 830ms"></div>
                  </div>
                  <span class="fh-pop w-10 text-right text-muted-foreground" style="--fh-delay: 1000ms">0.73</span>
                  <span class="fh-pop w-10 text-right" style="--fh-delay: 1000ms">0.81</span>
                  <span class="fh-pop w-12 text-right text-success" style="--fh-delay: 1100ms">+0.08</span>
                </div>
              </div>
            </HighlightPanel>
          )}

        </div>
      ))}
    </div>

    {/* The verdict box — the section's payoff: what reading the diff feels like */}
    <div
      class="reveal mt-16"
      style={`--reveal-delay: 260ms`}
    >
      <div class="grid grid-cols-1 gap-8 rounded-[20px] border border-border bg-surface p-8 md:grid-cols-[1fr_1.4fr] md:items-center md:p-10">
        <div>
          <span class="font-label text-[13px] tracking-[0.05em] text-ember uppercase">
            The report
          </span>
          <p class="mt-3 text-[16px] leading-[1.6] text-ink-soft">
            Out of 412 recorded calls, the best mix picked the same tool as today on 389.
            You review the 23 that differ, then replay the winner on a cohort before
            anything ships.
          </p>
          <p class="mt-3 text-[11.5px] leading-relaxed text-muted-foreground">
            Illustrative numbers from a sample run. Per-call costs assume the agent takes
            the same steps; the replay measures cost per task.
          </p>
        </div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3 sm:gap-6">
          {[
            { v: "389 / 412", k: "same tool as today", tone: "" },
            { v: "23", k: "differences to review", tone: "text-warn" },
            { v: "−68%", k: "cost per call", tone: "text-success" },
          ].map((m) => (
            <div>
              <div class={`font-display text-[28px] leading-[32px] md:text-[32px] md:leading-[36px] ${m.tone}`}>
                {m.v}
              </div>
              <div class="mt-1.5 text-[11.5px] text-muted-foreground">{m.k}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Highlight-panel choreography, keyed off the reveal system's data-shown
     contract: bars draw in from the left, chips/values fade up, selection
     washes tint in last. Delays are per-element via --fh-delay. */
  .fh-bar {
    transform-origin: left center;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--fh-delay, 0ms);
  }
  .reveal:not([data-shown="true"]) .fh-bar {
    transform: scaleX(0);
  }

  .fh-pop {
    transition:
      opacity 0.5s ease-out,
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--fh-delay, 0ms);
  }
  .reveal:not([data-shown="true"]) .fh-pop {
    opacity: 0;
    transform: translateY(4px);
  }

  .fh-wash {
    transition:
      background-color 0.6s ease-out,
      border-color 0.6s ease-out;
    transition-delay: var(--fh-delay, 0ms);
  }
  .reveal:not([data-shown="true"]) .fh-wash {
    background-color: transparent;
    border-color: transparent;
  }

  @media (prefers-reduced-motion: reduce) {
    .fh-bar,
    .fh-pop,
    .fh-wash {
      transition: none;
    }
  }
</style>
