---
// Features.astro — how it works: the four things open-source Kitaru does,
// then one card for the hosted part (our AI engineer). Static; scroll reveal
// comes from the page-level reveal-static script.
import { HOSTED_NOTE, STEPS } from "../../lib/kitaru-landing";
import LabsButton from "../labs/LabsButton.astro";
---

<section id="how-it-works" class="relative w-full bg-surface text-foreground">
  <div class="mx-auto w-full max-w-content px-gutter py-20 md:py-28">
    <div class="reveal max-w-3xl">
      <span class="inline-block font-label text-[13px] tracking-[0.05em] text-ember uppercase">
        How it works
      </span>
      <h2 class="mt-space-sm font-display text-[32px] leading-[36px] text-balance text-(--color-cream-900) md:text-[44px] md:leading-[48px]">
        From traces to a tested fix
      </h2>
    </div>

    <ol class="mt-12 grid grid-cols-1 gap-10 md:grid-cols-2 md:gap-8 lg:grid-cols-4">
      {STEPS.map((s, i) => (
        <li class="reveal" style={`--reveal-delay: ${i * 110}ms`}>
          <span class="font-label text-[13px] tracking-[0.05em] text-ember">{s.n}</span>
          <div class="mt-4 h-px w-full bg-border"></div>
          <h3 class="mt-5 font-display text-[24px] leading-[30px] text-(--color-cream-900)">{s.title}</h3>
          <p class="mt-3 text-[15px] leading-[1.6] text-ink-soft">{s.body}</p>
        </li>
      ))}
    </ol>

    <div
      class="reveal mt-14 flex flex-col gap-space-md rounded-[20px] border border-border bg-background p-6 transition-colors duration-200 ease-out hover:border-ember/60 md:flex-row md:items-center md:justify-between md:p-8"
      style="--reveal-delay: 440ms"
    >
      <div class="max-w-2xl">
        <h3 class="font-display text-[22px] leading-[28px] text-(--color-cream-900)">{HOSTED_NOTE.title}</h3>
        <p class="mt-2 text-[15px] leading-[1.6] text-ink-soft">{HOSTED_NOTE.body}</p>
      </div>
      <LabsButton cta={HOSTED_NOTE.link} tone="orange" class="shrink-0 self-start md:self-auto" />
    </div>
  </div>
</section>
