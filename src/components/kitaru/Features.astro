---
// Features.astro — The migration wedge: model swap + comparison
import { STEPS } from "../../lib/kitaru-landing";
import HighlightPanel from "./_HighlightPanel.astro";
---

<section id="how-it-works" class="relative w-full bg-surface text-foreground">
  <div class="mx-auto w-full max-w-[1440px] px-6 py-20 md:py-28">
    {/* Header with eyebrow, title, lede */}
    <div class="reveal max-w-3xl">
      <span class="inline-block font-mono text-[11px] tracking-[0.22em] text-ember uppercase">
        The migration you keep postponing
      </span>
      <h2 class="mt-5 text-balance text-3xl leading-[1.1] font-medium tracking-[-0.02em] md:text-[2.75rem]">
        Ship the cheaper model without shipping a regression.
      </h2>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-soft md:text-lg">
        Nobody moves, because nobody can say what it would break. Two runs over your real
        sessions can.
      </p>
    </div>

    {/* Three-column steps grid */}
    <div class="mt-16 grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-8">
      {STEPS.map((s, i) => (
        <div
          class="reveal relative"
          style={`--reveal-delay: ${i * 110}ms`}
        >
          <div class="flex items-baseline gap-3">
            <span class="font-mono text-[11px] text-ember">{s.n}</span>
            <span class="font-mono text-[11px] tracking-[0.16em] text-muted-foreground uppercase">
              {s.tag}
            </span>
          </div>
          <div class="mt-4 h-px w-full bg-border" />
          <h3 class="mt-5 text-[19px] leading-snug font-medium tracking-[-0.015em]">
            {s.title}
          </h3>
          <p class="mt-3 text-[14px] leading-relaxed text-ink-soft">{s.body}</p>

          {/* Minimal product-UI highlight — visual abstractions of the MVP screens
              in the Paper "Kitaru MVP" file (05 Cohorts / 07a New experiment /
              13 Comparison · run vs run): skeleton bars carry the shape, one
              fact per panel carries the meaning. */}
          {s.n === "01" && (
            <HighlightPanel>
              <div class="relative z-10 flex flex-1 flex-col justify-center space-y-1.5" aria-hidden="true">
                <div class="fh-wash flex items-center gap-2 rounded border border-ember/30 bg-ember-light/50 px-2 py-1.5" style="--fh-delay: 700ms">
                  <span class="fh-pop size-1.5 shrink-0 rounded-full bg-ember" style="--fh-delay: 700ms"></span>
                  <span class="fh-bar h-1.5 w-2/3 rounded-full bg-ember/30" style="--fh-delay: 250ms"></span>
                </div>
                <div class="flex items-center gap-2 px-2 py-1.5">
                  <span class="fh-pop size-1.5 shrink-0 rounded-full bg-border" style="--fh-delay: 340ms"></span>
                  <span class="fh-bar h-1.5 w-3/5 rounded-full bg-border/70" style="--fh-delay: 340ms"></span>
                </div>
                <div class="fh-wash flex items-center gap-2 rounded border border-ember/30 bg-ember-light/50 px-2 py-1.5" style="--fh-delay: 800ms">
                  <span class="fh-pop size-1.5 shrink-0 rounded-full bg-ember" style="--fh-delay: 800ms"></span>
                  <span class="fh-bar h-1.5 w-1/2 rounded-full bg-ember/30" style="--fh-delay: 430ms"></span>
                </div>
                <div class="fh-wash flex items-center gap-2 rounded border border-ember/30 bg-ember-light/50 px-2 py-1.5" style="--fh-delay: 900ms">
                  <span class="fh-pop size-1.5 shrink-0 rounded-full bg-ember" style="--fh-delay: 900ms"></span>
                  <span class="fh-bar h-1.5 w-3/4 rounded-full bg-ember/30" style="--fh-delay: 520ms"></span>
                </div>
                <div class="flex items-center gap-2 px-2 py-1.5">
                  <span class="fh-pop size-1.5 shrink-0 rounded-full bg-border" style="--fh-delay: 610ms"></span>
                  <span class="fh-bar h-1.5 w-2/5 rounded-full bg-border/70" style="--fh-delay: 610ms"></span>
                </div>
              </div>
              <div class="relative z-10 mt-auto flex items-center justify-between border-t border-border/60 pt-2.5 font-mono text-[10.5px]">
                <span class="text-muted-foreground">200 sessions &middot; v1 &middot; fixed</span>
                <span class="fh-pop rounded-md bg-ember px-2.5 py-1 font-medium text-accent-foreground" style="--fh-delay: 1050ms">Create "checkout-flow"</span>
              </div>
            </HighlightPanel>
          )}
          {s.n === "02" && (
            <HighlightPanel>
              <div class="relative z-10 flex flex-1 flex-col justify-center space-y-2">
                <div class="flex items-center gap-2 px-2 py-1">
                  <span class="font-mono text-[10.5px] text-muted-foreground">name</span>
                  <span class="fh-pop ml-auto rounded-md border border-border bg-background px-2 py-1 font-mono text-[10.5px]" style="--fh-delay: 350ms">cheap-model</span>
                </div>
                <div class="fh-wash flex items-center gap-2 rounded border border-ember/30 bg-ember-light/50 px-2 py-1.5" style="--fh-delay: 700ms">
                  <span class="font-mono text-[10.5px] text-muted-foreground">model</span>
                  <span class="fh-pop ml-auto flex items-center gap-1.5 rounded-md border border-ember/40 bg-background px-2 py-1 font-mono text-[10.5px] text-ember-deep" style="--fh-delay: 850ms">
                    claude-haiku-4.5
                    <svg class="size-3 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </span>
                </div>
                <div class="flex items-center gap-2 px-2 py-1.5" aria-hidden="true">
                  <span class="fh-bar h-1.5 w-10 shrink-0 rounded-full bg-border/70" style="--fh-delay: 430ms"></span>
                  <span class="fh-bar h-1.5 flex-1 rounded-full bg-border/50" style="--fh-delay: 500ms"></span>
                </div>
                <div class="flex items-center gap-2 px-2 py-1.5" aria-hidden="true">
                  <span class="fh-bar h-1.5 w-16 shrink-0 rounded-full bg-border/70" style="--fh-delay: 520ms"></span>
                  <span class="fh-bar h-1.5 flex-1 rounded-full bg-border/50" style="--fh-delay: 590ms"></span>
                </div>
              </div>
              <div class="relative z-10 mt-auto border-t border-border/60 pt-2.5 font-mono text-[10.5px] text-muted-foreground">
                1 of 4 overridden
              </div>
            </HighlightPanel>
          )}
          {s.n === "03" && (
            <HighlightPanel>
              <div class="relative z-10 border-b border-border/60 pb-2">
                <div class="fh-pop font-mono text-[10.5px] font-medium" style="--fh-delay: 250ms">same cohort &middot; same agent version</div>
                <div class="mt-1.5 flex flex-col gap-1 font-mono text-[10px]">
                  <span class="fh-pop flex items-center gap-1.5 text-muted-foreground" style="--fh-delay: 330ms"><span class="size-1.5 shrink-0 rounded-full bg-border"></span>baseline &middot; claude-sonnet-4.5</span>
                  <span class="fh-pop flex items-center gap-1.5 text-ember-deep" style="--fh-delay: 410ms"><span class="size-1.5 shrink-0 rounded-full bg-ember"></span>cheap-model &middot; claude-haiku-4.5</span>
                </div>
              </div>
              <div class="relative z-10 flex flex-1 flex-col justify-evenly">
                <div class="flex items-center gap-3 font-mono text-[10.5px]">
                  <div class="flex-1 space-y-1" aria-hidden="true">
                    <div class="fh-bar h-1.5 w-[72%] rounded-full bg-border/70" style="--fh-delay: 350ms"></div>
                    <div class="fh-bar h-1.5 w-[46%] rounded-full bg-ember/60" style="--fh-delay: 430ms"></div>
                  </div>
                  <span class="fh-pop w-10 text-right text-muted-foreground" style="--fh-delay: 600ms">&minus;31%</span>
                  <span class="fh-pop w-10 text-right" style="--fh-delay: 600ms">&minus;52%</span>
                  <span class="fh-pop w-12 text-right text-success" style="--fh-delay: 700ms">&minus;21pp</span>
                </div>
                <div class="flex items-center gap-3 font-mono text-[10.5px]">
                  <div class="flex-1 space-y-1" aria-hidden="true">
                    <div class="fh-bar h-1.5 w-[60%] rounded-full bg-border/70" style="--fh-delay: 550ms"></div>
                    <div class="fh-bar h-1.5 w-[38%] rounded-full bg-ember/60" style="--fh-delay: 630ms"></div>
                  </div>
                  <span class="fh-pop w-10 text-right text-muted-foreground" style="--fh-delay: 800ms">&minus;3.9s</span>
                  <span class="fh-pop w-10 text-right" style="--fh-delay: 800ms">&minus;5.9s</span>
                  <span class="fh-pop w-12 text-right text-success" style="--fh-delay: 900ms">&minus;2.0s</span>
                </div>
                <div class="flex items-center gap-3 font-mono text-[10.5px]">
                  <div class="flex-1 space-y-1" aria-hidden="true">
                    <div class="fh-bar h-1.5 w-[64%] rounded-full bg-border/70" style="--fh-delay: 750ms"></div>
                    <div class="fh-bar h-1.5 w-[71%] rounded-full bg-ember/60" style="--fh-delay: 830ms"></div>
                  </div>
                  <span class="fh-pop w-10 text-right text-muted-foreground" style="--fh-delay: 1000ms">0.73</span>
                  <span class="fh-pop w-10 text-right" style="--fh-delay: 1000ms">0.81</span>
                  <span class="fh-pop w-12 text-right text-success" style="--fh-delay: 1100ms">+0.08</span>
                </div>
              </div>
            </HighlightPanel>
          )}

          <pre class="mt-3 block overflow-x-auto rounded-md border border-border bg-night px-3.5 py-2.5 font-mono text-[11.5px] text-night-text/85"><code>{s.command}</code></pre>
        </div>
      ))}
    </div>

    {/* The diff stats box */}
    <div
      class="reveal mt-16"
      style={`--reveal-delay: 260ms`}
    >
      <div class="grid grid-cols-1 gap-8 rounded-xl border border-border bg-surface p-8 md:grid-cols-[1fr_1.4fr] md:items-center md:p-10">
        <div>
          <span class="font-mono text-[11px] tracking-[0.16em] text-ember uppercase">
            The diff
          </span>
          <p class="mt-3 text-[15px] leading-relaxed text-ink-soft">
            Same 200 sessions. Same evaluator. One model swapped.
          </p>
        </div>
        <div class="grid grid-cols-3 gap-6">
          {[
            { v: "−61%", k: "median cost", tone: "text-success" },
            { v: "196 / 200", k: "outputs identical", tone: "" },
            { v: "4", k: "to review", tone: "text-warn" },
          ].map((m) => (
            <div>
              <div class={`font-mono text-2xl tracking-[-0.02em] md:text-3xl ${m.tone}`}>
                {m.v}
              </div>
              <div class="mt-1.5 text-[11.5px] text-muted-foreground">{m.k}</div>
            </div>
          ))}
        </div>
      </div>
    </div>

    {/* Disclaimer note */}
    <div class="reveal mt-6" style={`--reveal-delay: 320ms`}>
      <p class="max-w-2xl text-[12.5px] leading-relaxed text-muted-foreground">
        Illustrative numbers. Kitaru grades every session ready, partial or unavailable at
        import, so you know before you rely on it.
      </p>
    </div>
  </div>
</section>

<style>
  /* Highlight-panel choreography, keyed off the reveal system's data-shown
     contract: bars draw in from the left, chips/values fade up, selection
     washes tint in last. Delays are per-element via --fh-delay. */
  .fh-bar {
    transform-origin: left center;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--fh-delay, 0ms);
  }
  .reveal:not([data-shown="true"]) .fh-bar {
    transform: scaleX(0);
  }

  .fh-pop {
    transition:
      opacity 0.5s ease-out,
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--fh-delay, 0ms);
  }
  .reveal:not([data-shown="true"]) .fh-pop {
    opacity: 0;
    transform: translateY(4px);
  }

  .fh-wash {
    transition:
      background-color 0.6s ease-out,
      border-color 0.6s ease-out;
    transition-delay: var(--fh-delay, 0ms);
  }
  .reveal:not([data-shown="true"]) .fh-wash {
    background-color: transparent;
    border-color: transparent;
  }

  @media (prefers-reduced-motion: reduce) {
    .fh-bar,
    .fh-pop,
    .fh-wash {
      transition: none;
    }
  }
</style>
