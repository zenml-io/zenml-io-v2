---
// AgentDriven.astro — agent-driven experimentation via Kitaru's MCP server.
// Your coding agent (Claude Code, Codex, Cursor, Gemini CLI) drives the
// replay/diff loop and hill-climbs toward a cheaper, safer variant.
//
// Second half: the self-extending pitch. Every part of Kitaru is a plugin —
// importers, scorers, and the skills themselves — so the same agent that runs
// the loop can write the parts the next loop needs.
const agents = [
  { slug: "claude", name: "Claude Code" },
  { slug: "openai", name: "Codex" },
  { slug: "cursor", name: "Cursor" },
  { slug: "gemini", name: "Gemini CLI" },
] as const;

const plugins = [
  {
    kind: "Importers",
    title: "Your trace format, not just ours",
    body: "Langfuse and LangSmith are only the ones we happened to write first. Point a skill at whatever you have and it writes the importer, registers it, and your worker loads it.",
  },
  {
    kind: "Scorers",
    title: "What good looks like can't ship in a box",
    body: "It is different for every team, so it has to be written, not configured. Describe it once while staring at a broken session and the skill compiles your answer into a scorer.",
  },
  {
    kind: "Skills",
    title: "The procedures are plugins too",
    body: "Mine the sessions that went unusually well, distill what they did right, and hand it back to your agent as a skill it uses next time. The system teaches itself from its own best runs.",
  },
] as const;
---

<section id="agent-driven" class="ad-section section-pad">
  <div class="section-inner">
    <div class="ad-grid">
      <div class="ad-copy" data-reveal>
        <span class="section-eyebrow">AGENT-DRIVEN EXPERIMENTATION</span>
        <h2 class="ad-title">Don&rsquo;t run the experiments. Let your agent hill-climb.</h2>
        <p class="ad-desc">
          Kitaru exposes replay and diff over an MCP server and a CLI. Point your coding agent at it: it replays a run, changes one thing, reads the diff, and tries the next idea, climbing toward a cheaper, safer version while you watch.
        </p>
        <div class="ad-agents">
          <span class="ad-agents-label">Drive it from</span>
          <div class="ad-agent-list">
            {
              agents.map((a) => (
                <span class="ad-agent">
                  <img src={`/images/kitaru-sources/${a.slug}.png`} alt="" aria-hidden="true" width="20" height="20" loading="lazy" />
                  {a.name}
                </span>
              ))
            }
            <span class="ad-agent ad-agent-more">or any harness that speaks MCP</span>
          </div>
        </div>
      </div>

      <div class="ad-loop" data-reveal="fade-left" data-reveal-delay="2">
        <div class="ad-window">
          <div class="ad-window-head">
            <span class="ad-dots" aria-hidden="true"><span></span><span></span><span></span></span>
            <span class="ad-window-title">agent · kitaru mcp</span>
          </div>
          <div class="ad-transcript">
            <div class="ad-line ad-line-agent">replay #4127 &middot; from_=<span class="ad-str">"decide"</span> · model=<span class="ad-str">"gpt-5-mini"</span></div>
            <div class="ad-line ad-line-out ad-bad">81% cheaper, but skipped the escalation &#10007;</div>
            <div class="ad-line ad-line-agent">replay #4127 &middot; from_=<span class="ad-str">"decide"</span> · model=<span class="ad-str">"fast"</span></div>
            <div class="ad-line ad-line-out ad-good">78% cheaper, decisions match &#10003;</div>
            <div class="ad-line ad-line-agent ad-kept">kept this variant, opening a PR</div>
          </div>
        </div>
        <p class="ad-loop-caption">A few replays, no human in the loop. The diff is the agent&rsquo;s reward signal.</p>
      </div>
    </div>

    <div class="ad-plugins">
      <div class="ad-plugins-head" data-reveal>
        <span class="section-eyebrow">AND IT WRITES ITS OWN PARTS</span>
        <h3 class="ad-plugins-title">
          Every piece of Kitaru is a plugin &mdash;<br />
          <span class="ad-plugins-accent">including the pieces that write plugins.</span>
        </h3>
        <p class="ad-plugins-desc">
          Nothing here is a fixed menu. The importer that reads your traces, the scorer that decides what good means, and the skill that runs the interview are all just code, registered to the server and loaded by your worker. Your agent can write any of them.
        </p>
      </div>

      <div class="ad-plugin-grid">
        {
          plugins.map((p, i) => (
            <div class="ad-plugin-card" data-reveal="fade-up" data-reveal-delay={i + 1}>
              <span class="ad-plugin-kind">{p.kind}</span>
              <h4 class="ad-plugin-title">{p.title}</h4>
              <p class="ad-plugin-body">{p.body}</p>
            </div>
          ))
        }
      </div>

      <p class="ad-plugins-foot" data-reveal>
        The agent writes the scorer, runs the experiment, reads the diff, and opens the PR. Every pass leaves behind a part the next pass can use.
      </p>
    </div>
  </div>
</section>

<style>
  .ad-section {
    background: var(--color-surface-warm);
    border-bottom: 1px solid var(--color-border);
  }

  .ad-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 48px;
    align-items: center;
  }

  .ad-title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--color-primary);
    margin: 14px 0 16px;
  }

  .ad-desc {
    font-size: clamp(1rem, 1.5vw, 1.1rem);
    line-height: 1.65;
    font-weight: 300;
    color: var(--color-secondary);
    margin: 0 0 26px;
    max-width: 52ch;
  }

  .ad-agents {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .ad-agents-label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .ad-agent-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .ad-agent-more {
    color: var(--color-muted);
    background: transparent;
    border-style: dashed;
    font-weight: 500;
  }

  .ad-agent {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-primary);
    padding: 8px 14px;
    border: 1px solid var(--color-border);
    border-radius: 11px;
    background: var(--color-surface);
  }

  .ad-agent img {
    width: 20px;
    height: 20px;
    border-radius: 5px;
    object-fit: contain;
    flex-shrink: 0;
  }

  /* ─── Agent transcript window ─── */
  .ad-window {
    background: oklch(0.16 0.015 60);
    border: 1px solid oklch(1 0 0 / 0.08);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 24px 60px -36px oklch(0.13 0.015 60 / 0.5);
  }

  .ad-window-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-bottom: 1px solid oklch(1 0 0 / 0.06);
  }

  .ad-dots {
    display: inline-flex;
    gap: 6px;
  }

  .ad-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: oklch(1 0 0 / 0.15);
  }

  .ad-window-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: oklch(1 0 0 / 0.4);
    letter-spacing: 0.02em;
  }

  .ad-transcript {
    padding: 18px 20px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.95;
    color: var(--color-dark-text);
  }

  .ad-line {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .ad-line-agent::before {
    content: "\203a  ";
    color: var(--color-accent);
  }

  .ad-line-out {
    color: oklch(1 0 0 / 0.55);
    padding-left: 16px;
  }

  .ad-good {
    color: oklch(0.74 0.14 155);
  }

  .ad-bad {
    color: oklch(0.7 0.16 25);
  }

  .ad-kept {
    color: var(--color-accent);
  }

  .ad-str {
    color: oklch(0.62 0.13 155);
  }

  .ad-loop-caption {
    margin: 14px 0 0;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--color-muted);
    text-align: center;
  }

  /* ─── Self-extending: everything is a plugin ─── */
  .ad-plugins {
    margin-top: 72px;
    padding-top: 56px;
    border-top: 1px solid var(--color-border);
  }

  .ad-plugins-head {
    max-width: 760px;
    margin-bottom: 36px;
  }

  .ad-plugins-title {
    font-size: clamp(1.4rem, 2.6vw, 1.95rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-primary);
    margin: 14px 0 16px;
  }

  .ad-plugins-accent {
    color: var(--color-accent);
  }

  .ad-plugins-desc {
    margin: 0;
    font-size: clamp(1rem, 1.5vw, 1.08rem);
    line-height: 1.65;
    font-weight: 300;
    color: var(--color-secondary);
  }

  .ad-plugin-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .ad-plugin-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
    padding: 28px 26px;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-surface);
    transition: border-color 0.25s, transform 0.25s;
  }

  .ad-plugin-card:hover {
    border-color: oklch(0.65 0.16 45 / 0.3);
    transform: translateY(-3px);
  }

  .ad-plugin-kind {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    padding: 4px 10px;
    border: 1px solid oklch(0.65 0.16 45 / 0.28);
    border-radius: 100px;
    background: oklch(0.65 0.16 45 / 0.07);
  }

  .ad-plugin-title {
    margin: 0;
    font-size: clamp(1.02rem, 1.5vw, 1.15rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--color-primary);
  }

  .ad-plugin-body {
    margin: 0;
    font-size: 0.93rem;
    line-height: 1.6;
    font-weight: 300;
    color: var(--color-secondary);
  }

  .ad-plugins-foot {
    max-width: 68ch;
    margin: 28px 0 0;
    font-size: 0.95rem;
    line-height: 1.6;
    font-weight: 300;
    color: var(--color-secondary);
  }

  @media (max-width: 900px) {
    .ad-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .ad-plugin-grid {
      grid-template-columns: 1fr;
    }

    .ad-plugins {
      margin-top: 48px;
      padding-top: 40px;
    }
  }
</style>
