---
// AgentDriven.astro — your coding agent drives Kitaru's MCP server and CLI;
// the human supplies the judgment. Acceptance is a one-use token minted by a
// human UI control, never inferred from model-authored chat.

const agents = [
  { slug: "claude", name: "Claude Code" },
  { slug: "openai", name: "Codex" },
  { slug: "cursor", name: "Cursor" },
  { slug: "gemini", name: "Gemini CLI" },
] as const;
---

<section id="agent-driven" class="ad-section section-pad">
  <div class="section-inner">
    <div class="ad-grid">
      <div class="ad-copy" data-reveal>
        <span class="section-eyebrow">AGENT-DRIVEN EXPERIMENTATION</span>
        <h2 class="ad-title">Your agent does the driving. You do the deciding.</h2>
        <p class="ad-desc">
          Kitaru speaks MCP. Your coding agent does the tedious parts &mdash; import, group, run, read back. It cannot decide what good means, and Kitaru is built to stop it trying.
        </p>
        <div class="ad-agents">
          <span class="ad-agents-label">Drive it from</span>
          <div class="ad-agent-list">
            {
              agents.map((a) => (
                <span class="ad-agent">
                  <img src={`/images/kitaru-sources/${a.slug}.png`} alt="" aria-hidden="true" width="20" height="20" loading="lazy" />
                  {a.name}
                </span>
              ))
            }
            <span class="ad-agent ad-agent-more">or any harness that speaks MCP</span>
          </div>
        </div>
      </div>

      <div class="ad-loop" data-reveal="fade-left" data-reveal-delay="2">
        <div class="ad-window">
          <div class="ad-window-head">
            <span class="ad-dots" aria-hidden="true"><span></span><span></span><span></span></span>
            <span class="ad-window-title">agent · kitaru mcp</span>
          </div>
          <div class="ad-transcript">
            <div class="ad-line ad-line-agent">run cheap-model &middot; cohort=<span class="ad-str">"checkout-flow"</span> &middot; version=<span class="ad-str">"v1"</span></div>
            <div class="ad-line ad-line-out">90 sessions &middot; cited-superseded-doc true 90 &middot; false 0</div>
            <div class="ad-line ad-line-agent">run cheap-model &middot; version=<span class="ad-str">"pr-311"</span></div>
            <div class="ad-line ad-line-out ad-good">cited-superseded-doc true 4 &middot; false 86</div>
            <div class="ad-line ad-line-out ad-bad">4 still failing &mdash; opening these for you to read</div>
          </div>
        </div>
        <p class="ad-loop-caption">The agent ran it and laid out the rows. Whether four remaining failures is shippable is not its call.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .ad-section {
    background: var(--color-surface-warm);
    border-bottom: 1px solid var(--color-border);
  }

  .ad-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 48px;
    align-items: center;
  }

  .ad-title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--color-primary);
    margin: 14px 0 16px;
  }

  .ad-desc {
    font-size: clamp(1rem, 1.5vw, 1.1rem);
    line-height: 1.65;
    font-weight: 300;
    color: var(--color-secondary);
    margin: 0 0 26px;
    max-width: 52ch;
  }

  .ad-agents {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .ad-agents-label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .ad-agent-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .ad-agent-more {
    color: var(--color-muted);
    background: transparent;
    border-style: dashed;
    font-weight: 500;
  }

  .ad-agent {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-primary);
    padding: 8px 14px;
    border: 1px solid var(--color-border);
    border-radius: 11px;
    background: var(--color-surface);
  }

  .ad-agent img {
    width: 20px;
    height: 20px;
    border-radius: 5px;
    object-fit: contain;
    flex-shrink: 0;
  }

  /* ─── Agent transcript window ─── */
  .ad-window {
    background: oklch(0.16 0.015 60);
    border: 1px solid oklch(1 0 0 / 0.08);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 24px 60px -36px oklch(0.13 0.015 60 / 0.5);
  }

  .ad-window-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-bottom: 1px solid oklch(1 0 0 / 0.06);
  }

  .ad-dots {
    display: inline-flex;
    gap: 6px;
  }

  .ad-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: oklch(1 0 0 / 0.15);
  }

  .ad-window-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: oklch(1 0 0 / 0.4);
    letter-spacing: 0.02em;
  }

  .ad-transcript {
    padding: 18px 20px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.95;
    color: var(--color-dark-text);
  }

  .ad-line {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .ad-line-agent::before {
    content: "\203a  ";
    color: var(--color-accent);
  }

  .ad-line-out {
    color: oklch(1 0 0 / 0.55);
    padding-left: 16px;
  }

  .ad-good {
    color: oklch(0.74 0.14 155);
  }

  .ad-bad {
    color: oklch(0.7 0.16 25);
  }

  .ad-str {
    color: oklch(0.62 0.13 155);
  }

  .ad-loop-caption {
    margin: 14px 0 0;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--color-muted);
    text-align: center;
  }

  @media (max-width: 900px) {
    .ad-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
