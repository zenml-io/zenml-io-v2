---
// GroundTruth.astro — The labels already exist in the system of record
import { GROUND_TRUTH_POINTS } from "../../lib/kitaru-landing";
---

<section id="ground-truth" class="relative w-full bg-surface text-foreground">
  <div class="mx-auto w-full max-w-[1180px] px-6 py-24 md:py-36">
    <div class="grid grid-cols-1 gap-14 lg:grid-cols-[1.15fr_1fr] lg:gap-24">
      {/* Left column: Headline + description */}
      <div class="reveal">
        <span class="inline-block font-mono text-[11px] tracking-[0.22em] text-ember uppercase">
          The labels you already have
        </span>
        <h2 class="mt-5 text-balance text-3xl leading-[1.08] font-medium tracking-[-0.025em] md:text-[2.75rem]">
          Every correction your ops team makes
          <br />
          <span class="text-ember">is a label nobody is using.</span>
        </h2>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-ink-soft md:text-lg">
          Somebody fixes the agent's booking by hand. That corrected record is ground
          truth, in your schema, from a domain expert — accumulating daily, and no eval
          tool has ever asked for it.
        </p>
      </div>

      {/* Right column: Definition list */}
      <dl class="flex flex-col justify-center">
        {GROUND_TRUTH_POINTS.map((p, i) => (
          <div
            class="reveal-right border-t border-border py-6 last:border-b"
            style={`--reveal-delay: ${i * 120}ms`}
          >
            <dt class="font-mono text-[11px] tracking-[0.16em] text-ember uppercase">
              {p.kind}
            </dt>
            <dd class="mt-3 text-[15.5px] leading-relaxed text-ink-soft">{p.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
