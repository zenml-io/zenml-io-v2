---
// TheLoop.astro — the onboarding narrative: zero to a scored cohort in seven
// steps. Carries the parts of the story the page never told before: login,
// skills, the worker, triage, and the UI as a place you act.
//
// `where` marks which surface each step happens on — the "mixture of UI and
// local" point is the whole architecture, so it has to be visible at a glance.
const steps = [
  {
    n: "01",
    where: "terminal",
    tag: "Connect",
    title: "Install and log in",
    body: "One command connects your machine to your workspace. OAuth completes in the browser, and from then on your client knows which server it is talking to.",
    code: "uv add kitaru && kitaru login",
    note: "Self-hosting? kitaru login --local.",
  },
  {
    n: "02",
    where: "skill",
    tag: "Equip",
    title: "Install the skills",
    body: "Drop the Kitaru skills into your coding agent and setup becomes a conversation instead of documentation. They ask the questions; you answer in your own words.",
    code: "kitaru skills install",
    note: "Optional. Every skill is a thin procedure over a CLI verb.",
  },
  {
    n: "03",
    where: "skill",
    tag: "Ingest",
    title: "Get your traces in",
    body: "The import skill asks where they live — Langfuse, LangSmith, an OTel JSONL file — writes the importer, and registers the agent from the repo you are standing in. No traces yet? Wrap your agent and make some. Neither? Clone the template repo.",
    code: "kitaru agents register . && kitaru import langfuse",
    note: "Imported and recorded sessions are the same object downstream.",
  },
  {
    n: "04",
    where: "terminal",
    tag: "Execute",
    title: "Start the worker",
    body: "Importing is a job, and jobs need a worker. One general-purpose process on your machine polls the server and runs whatever it is handed — imports now, replays and scorers later.",
    code: "kitaru worker start",
    note: "Your code, your keys, your virtualenv. Nothing runs in the cloud.",
  },
  {
    n: "05",
    where: "skill",
    tag: "Triage",
    title: "Group what went wrong",
    body: "The triage skill reads your sessions, asks a few questions about what bad looks like to you, and groups them into cohorts. No triage service to deploy — conversation and grouping, landing in the UI.",
    code: "kitaru cohorts create --from triage",
    note: "Or filter and select by hand in the dashboard.",
  },
  {
    n: "06",
    where: "skill",
    tag: "Fix one",
    title: "Close the loop on a single session",
    body: "Pick one broken session and replay it. While you are looking at what went wrong, the skill interviews you: what does good look like here? Your answers compile into a bespoke scorer, registered to the server and loaded by your worker.",
    code: "kitaru replay ses_8f3a91c2 --scorer refund-resolved",
    note: "Replay, score, fix, replay again, watch it pass.",
  },
  {
    n: "07",
    where: "ui",
    tag: "Scale",
    title: "Run it against everything like it",
    body: "What worked on one session runs on the whole cohort. Create the experiment, press run in the dashboard, and your worker replays each session, scores it, and sends the results back.",
    code: "kitaru experiments run refund-errors",
    note: "The button is in the UI. The work happens on your machine.",
  },
] as const;

const whereLabels = {
  terminal: "your terminal",
  skill: "your coding agent",
  ui: "the dashboard",
} as const;
---

<section id="the-loop" class="loop-section section-pad">
  <div class="section-inner">
    <div class="loop-header" data-reveal>
      <span class="section-eyebrow">FROM ZERO TO A SCORED COHORT</span>
      <h2 class="section-title">
        Seven steps, and none of them are<br />
        <span class="loop-title-accent">&ldquo;now go read the docs.&rdquo;</span>
      </h2>
      <p class="section-desc">
        Every step tells you the next one. Skills ask the questions, the CLI takes the same answers typed by hand, and the dashboard shows you what exists.
      </p>
    </div>

    <ol class="loop-list">
      {
        steps.map((s, i) => (
          <li class="loop-step" data-reveal="fade-up" data-reveal-delay={Math.min(i + 1, 8)}>
            <div class="loop-rail" aria-hidden="true">
              <span class="loop-n">{s.n}</span>
            </div>
            <div class="loop-body">
              <div class="loop-head">
                <span class="loop-tag">{s.tag}</span>
                <span class={`loop-where loop-where-${s.where}`}>{whereLabels[s.where]}</span>
              </div>
              <h3 class="loop-step-title">{s.title}</h3>
              <p class="loop-text">{s.body}</p>
              <code class="loop-code">{s.code}</code>
              <p class="loop-note">{s.note}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <p class="loop-foot" data-reveal>
      You register things before you run things. That is the whole trick &mdash; once an agent, a scorer, or a cohort exists, anything can trigger it.
    </p>
  </div>
</section>

<style>
  .loop-section {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }

  .loop-header {
    max-width: 760px;
    margin-bottom: 48px;
  }

  .loop-title-accent {
    color: var(--color-accent);
  }

  .section-desc {
    margin-top: 16px;
    color: var(--color-secondary);
    font-size: clamp(1rem, 1.6vw, 1.1rem);
    line-height: 1.65;
    font-weight: 300;
  }

  /* ─── The stepped rail ─── */
  .loop-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .loop-step {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 24px;
  }

  .loop-rail {
    position: relative;
    display: flex;
    justify-content: center;
  }

  /* Connecting line between the number badges. */
  .loop-rail::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    transform: translateX(-50%);
    background: var(--color-border);
  }

  .loop-step:first-child .loop-rail::before {
    top: 22px;
  }

  .loop-step:last-child .loop-rail::before {
    bottom: calc(100% - 22px);
  }

  .loop-n {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-surface);
    border: 1px solid oklch(0.65 0.16 45 / 0.32);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .loop-body {
    min-width: 0;
    padding-bottom: 40px;
  }

  .loop-step:last-child .loop-body {
    padding-bottom: 0;
  }

  .loop-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }

  .loop-tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    padding: 3px 9px;
    border: 1px solid var(--color-border);
    border-radius: 100px;
  }

  .loop-where {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--color-secondary);
  }

  .loop-where::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-muted);
  }

  .loop-where-terminal::before {
    background: var(--color-primary);
  }

  .loop-where-skill::before {
    background: var(--color-accent);
  }

  .loop-where-ui::before {
    background: var(--color-accent-light, var(--color-accent));
    box-shadow: 0 0 0 3px oklch(0.65 0.16 45 / 0.16);
  }

  .loop-step-title {
    margin: 0 0 10px;
    font-size: clamp(1.15rem, 1.9vw, 1.45rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-primary);
  }

  .loop-text {
    margin: 0;
    max-width: 68ch;
    font-size: 0.98rem;
    line-height: 1.65;
    font-weight: 300;
    color: var(--color-secondary);
  }

  .loop-code {
    display: block;
    width: fit-content;
    max-width: 100%;
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--color-accent);
    background: oklch(0.65 0.16 45 / 0.07);
    border: 1px solid oklch(0.65 0.16 45 / 0.18);
    border-radius: 8px;
    padding: 10px 14px;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .loop-note {
    margin: 10px 0 0;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .loop-foot {
    max-width: 68ch;
    margin: 8px 0 0 88px;
    padding-top: 28px;
    border-top: 1px solid var(--color-border);
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-secondary);
    font-weight: 300;
  }

  @media (max-width: 700px) {
    .loop-step {
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 16px;
    }

    .loop-n {
      width: 34px;
      height: 34px;
      font-size: 0.72rem;
    }

    .loop-step:first-child .loop-rail::before {
      top: 17px;
    }

    .loop-step:last-child .loop-rail::before {
      bottom: calc(100% - 17px);
    }

    .loop-foot {
      margin-left: 0;
    }
  }
</style>
