---
// TheLoop.astro — the arc, in four beats: traces in, group them, fix one,
// run it against everything like it.
//
// Deliberately NOT a quickstart. Login, installing skills, and starting the
// worker are setup mechanics — they live in the docs and in the /product/
// kitaru.md mirror, not on the marketing page. What survives here is the shape
// of the work, plus the two claims that are load-bearing for a buyer: setup is
// a conversation, and execution never leaves your machine.
const steps = [
  {
    n: "01",
    tag: "Import",
    title: "Bring in the runs you already have",
    body: "Langfuse, LangSmith, an OTel JSONL file — the import skill asks where yours live and wires it up. No traces yet? Wrap your agent and make some. Either way you end up with the same thing.",
  },
  {
    n: "02",
    tag: "Triage",
    title: "Group them by what went wrong",
    body: "Answer a few questions about what bad looks like to you, and your sessions become cohorts: the twenty-three that failed the same way, sitting together and waiting.",
  },
  {
    n: "03",
    tag: "Fix one",
    title: "Close the loop on a single session",
    body: "Replay it against your real code. While you are looking at what went wrong, describe what good would have looked like — that answer becomes a scorer. Replay, score, fix, replay again, watch it pass.",
  },
  {
    n: "04",
    tag: "Scale",
    title: "Run it against everything like it",
    body: "What worked on one session runs on the whole cohort. Press run, and every one of them replays and scores against the fix.",
  },
] as const;
---

<section id="the-loop" class="loop-section section-pad">
  <div class="section-inner">
    <div class="loop-header" data-reveal>
      <span class="section-eyebrow">HOW THE WORK ACTUALLY GOES</span>
      <h2 class="section-title">
        One bad session in.<br />
        <span class="loop-title-accent">A regression test out.</span>
      </h2>
      <p class="section-desc">
        Every step tells you the next one, and each one is a conversation with your coding agent &mdash; or the same thing typed by hand, if you would rather.
      </p>
    </div>

    <ol class="loop-list">
      {
        steps.map((s, i) => (
          <li class="loop-step" data-reveal="fade-up" data-reveal-delay={i + 1}>
            <div class="loop-rail" aria-hidden="true">
              <span class="loop-n">{s.n}</span>
            </div>
            <div class="loop-body">
              <span class="loop-tag">{s.tag}</span>
              <h3 class="loop-step-title">{s.title}</h3>
              <p class="loop-text">{s.body}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <p class="loop-foot" data-reveal>
      The dashboard is where you look and decide. Every replay runs on your own machine, against your own code, with your own keys &mdash; nothing about your agent leaves your infrastructure.
    </p>
  </div>
</section>

<style>
  .loop-section {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }

  .loop-header {
    max-width: 760px;
    margin-bottom: 48px;
  }

  .loop-title-accent {
    color: var(--color-accent);
  }

  .section-desc {
    margin-top: 16px;
    color: var(--color-secondary);
    font-size: clamp(1rem, 1.6vw, 1.1rem);
    line-height: 1.65;
    font-weight: 300;
  }

  /* ─── The stepped rail ─── */
  .loop-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .loop-step {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 24px;
  }

  .loop-rail {
    position: relative;
    display: flex;
    justify-content: center;
  }

  /* Connecting line between the number badges. */
  .loop-rail::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    transform: translateX(-50%);
    background: var(--color-border);
  }

  .loop-step:first-child .loop-rail::before {
    top: 22px;
  }

  .loop-step:last-child .loop-rail::before {
    bottom: calc(100% - 22px);
  }

  .loop-n {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-surface);
    border: 1px solid oklch(0.65 0.16 45 / 0.32);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .loop-body {
    min-width: 0;
    padding-bottom: 36px;
  }

  .loop-step:last-child .loop-body {
    padding-bottom: 0;
  }

  .loop-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    padding: 3px 9px;
    border: 1px solid var(--color-border);
    border-radius: 100px;
    margin-bottom: 10px;
  }

  .loop-step-title {
    margin: 0 0 10px;
    font-size: clamp(1.15rem, 1.9vw, 1.45rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-primary);
  }

  .loop-text {
    margin: 0;
    max-width: 68ch;
    font-size: 0.98rem;
    line-height: 1.65;
    font-weight: 300;
    color: var(--color-secondary);
  }

  .loop-foot {
    max-width: 68ch;
    margin: 8px 0 0 88px;
    padding-top: 28px;
    border-top: 1px solid var(--color-border);
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-secondary);
    font-weight: 300;
  }

  @media (max-width: 700px) {
    .loop-step {
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 16px;
    }

    .loop-n {
      width: 34px;
      height: 34px;
      font-size: 0.72rem;
    }

    .loop-step:first-child .loop-rail::before {
      top: 17px;
    }

    .loop-step:last-child .loop-rail::before {
      bottom: calc(100% - 17px);
    }

    .loop-foot {
      margin-left: 0;
    }
  }
</style>
