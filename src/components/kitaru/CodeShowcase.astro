---
// CodeShowcase.astro — "Show me the code" section with all 8 primitives + hover highlight
---

<section class="dark-section section-pad" id="code-showcase">
  <div class="section-inner">
    <span class="section-eyebrow" data-reveal>SEE THE CODE</span>
    <h2 class="section-title showcase-title" data-reveal data-reveal-delay="1">
      Every counterfactual is one replay call.
    </h2>
    <p class="showcase-note" data-reveal data-reveal-delay="1">
      Swap the model, fake a tool, fail a call &mdash; each a simulation against the recorded world, one keyword apart. Hover any line to see what it does.
    </p>

    <div class="showcase-grid">

      <!-- Left: code window -->
      <div class="showcase-code" data-reveal="fade-left" data-reveal-delay="2">
        <div class="showcase-code-window">
          <div class="showcase-code-header">
            <div class="showcase-code-dots">
              <span class="code-dot"></span>
              <span class="code-dot"></span>
              <span class="code-dot"></span>
            </div>
            <span class="showcase-code-filename">whatif.py</span>
          </div>
          <pre class="showcase-code-pre code-syntax" aria-label="Example Kitaru what-if: replay real runs on a cheaper model with a faked tool, then diff"><code><span class="code-line"><span class="kw">from</span> kitaru <span class="kw">import</span> flow, checkpoint</span>
<span class="code-line"> </span>
<span class="code-line"><span class="cmt"># your agent's steps are durable checkpoints</span></span>
<span class="code-line" data-primitive="run">exec <span class="op">=</span> support_agent.<span class="fn">run</span>(ticket).<span class="fn">wait</span>()</span>
<span class="code-line"> </span>
<span class="code-line"><span class="cmt"># reproduce faithfully, then change ONE thing</span></span>
<span class="code-line" data-primitive="rerun">rerun   <span class="op">=</span> support_agent.<span class="fn">replay</span>(exec, from_<span class="op">=</span><span class="str">"decide"</span>)</span>
<span class="code-line" data-primitive="model">cheaper <span class="op">=</span> support_agent.<span class="fn">replay</span>(exec, from_<span class="op">=</span><span class="str">"decide"</span>, model<span class="op">=</span><span class="str">"glm-4.6"</span>)</span>
<span class="code-line" data-primitive="output">faked   <span class="op">=</span> support_agent.<span class="fn">replay</span>(exec, from_<span class="op">=</span><span class="str">"decide"</span>, output<span class="op">=</span>stale_order)</span>
<span class="code-line" data-primitive="raise">failed  <span class="op">=</span> support_agent.<span class="fn">replay</span>(exec, from_<span class="op">=</span><span class="str">"decide"</span>, raise_<span class="op">=</span>Timeout)</span>
<span class="code-line"> </span>
<span class="code-line" data-primitive="diff">cheaper.<span class="fn">diff</span>(rerun)<span class="cmt">   # did the decision move?</span></span></code></pre>
        </div>
      </div>

      <!-- Right: annotation callouts -->
      <div class="showcase-annotations" data-reveal="fade-right" data-reveal-delay="3">
        <div class="annotation" data-highlight="run">
          <code class="annotation-label">support_agent.run()</code>
          <p>Run in production. Every step is a durable checkpoint, addressable later.</p>
        </div>
        <div class="annotation" data-highlight="rerun">
          <code class="annotation-label">replay(from_="decide")</code>
          <p>Reproduce from a checkpoint with no change. Earlier steps come from cache. The faithful baseline.</p>
        </div>
        <div class="annotation" data-highlight="model">
          <code class="annotation-label">model="glm-4.6"</code>
          <p>Replay that step on a cheaper model. Same inputs, different model.</p>
        </div>
        <div class="annotation" data-highlight="output">
          <code class="annotation-label">output=</code>
          <p>Return a different tool result instead of calling it.</p>
        </div>
        <div class="annotation" data-highlight="raise">
          <code class="annotation-label">raise_=</code>
          <p>Make a tool call fail, to test how the agent recovers.</p>
        </div>
        <div class="annotation" data-highlight="diff">
          <code class="annotation-label">.diff(rerun)</code>
          <p>Did the decision move? Compared against the faithful baseline, with cost and quality deltas.</p>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .showcase-title {
    color: var(--color-dark-text);
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 40px;
    align-items: start;
    margin-top: 40px;
  }

  /* Code window — reuses Architecture patterns */
  .showcase-code-window {
    background: oklch(0.16 0.015 60);
    border: 1px solid oklch(1 0 0 / 0.08);
    border-radius: 12px;
    overflow: hidden;
  }

  .showcase-code-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid oklch(1 0 0 / 0.06);
  }

  .showcase-code-dots {
    display: flex;
    gap: 6px;
  }

  .showcase-code-filename {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: oklch(1 0 0 / 0.35);
  }

  .showcase-code-pre {
    padding: 20px;
    margin: 0;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.7;
    color: var(--color-dark-text);
    -webkit-overflow-scrolling: touch;
  }

  /* Highlight lines */
  .code-line {
    transition: background 0.2s, opacity 0.2s;
    border-radius: 3px;
    padding: 0 4px;
    margin: 0 -4px;
  }

  .code-line[data-primitive] {
    cursor: default;
  }

  .code-line.highlighted {
    background: oklch(0.65 0.16 45 / 0.12);
  }

  /* Dim non-highlighted lines when any highlight is active */
  .showcase-code-pre.has-highlight .code-line:not(.highlighted) {
    opacity: 0.35;
  }

  .showcase-code-pre.has-highlight .code-line.highlighted {
    opacity: 1;
  }

  /* Dim non-active annotations when a highlight is active */
  .showcase-annotations.has-highlight .annotation:not(.active) {
    opacity: 0.4;
  }

  .showcase-annotations.has-highlight .annotation.active {
    opacity: 1;
  }

  /* Annotations */
  .showcase-annotations {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 16px;
  }

  .annotation {
    padding: 14px 18px;
    border-radius: 10px;
    border: 1px solid oklch(1 0 0 / 0.08);
    background: oklch(1 0 0 / 0.03);
    cursor: default;
    transition: border-color 0.2s, background 0.2s, opacity 0.2s;
  }

  .annotation:hover,
  .annotation.active {
    border-color: oklch(0.65 0.16 45 / 0.3);
    background: oklch(0.65 0.16 45 / 0.06);
  }

  .annotation-label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-accent);
    margin-bottom: 4px;
  }

  .annotation p {
    font-size: 0.8rem;
    line-height: 1.5;
    color: oklch(1 0 0 / 0.55);
    margin: 0;
  }

  /* Intended-API note under the title */
  .showcase-note {
    max-width: 760px;
    margin: 14px 0 0;
    font-size: 0.85rem;
    line-height: 1.6;
    font-weight: 300;
    color: oklch(1 0 0 / 0.5);
  }

  @media (max-width: 768px) {
    .showcase-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .showcase-code-window::after {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: 32px;
      background: linear-gradient(90deg, transparent, oklch(0.16 0.015 60));
      pointer-events: none;
      border-radius: 0 12px 12px 0;
    }

    .showcase-code {
      position: relative;
    }

    .showcase-code-pre {
      font-size: 0.68rem;
    }
  }
</style>

<script>
  const section = document.getElementById('code-showcase');
  if (section) {
    const annotations = section.querySelectorAll<HTMLElement>('.annotation');
    const codeBlock = section.querySelector<HTMLElement>('.showcase-code-pre');
    const annContainer = section.querySelector<HTMLElement>('.showcase-annotations');
    // Touch devices can't hover — the highlight would get stuck on one item and
    // dim the rest, reading as "disabled". Keep the static code + list instead.
    const canHover = window.matchMedia('(hover: hover)').matches;
    if (codeBlock && annContainer && canHover) {
      // Build lookup maps
      const annByPrimitive = new Map<string, HTMLElement>();
      annotations.forEach(ann => {
        const p = ann.dataset.highlight;
        if (p) annByPrimitive.set(p, ann);
      });

      function activate(primitive: string) {
        codeBlock!.classList.add('has-highlight');
        annContainer!.classList.add('has-highlight');
        const ann = annByPrimitive.get(primitive);
        if (ann) ann.classList.add('active');
        codeBlock!.querySelectorAll<HTMLElement>(`.code-line[data-primitive="${primitive}"]`)
          .forEach(l => l.classList.add('highlighted'));
      }

      function deactivate(primitive: string) {
        codeBlock!.classList.remove('has-highlight');
        annContainer!.classList.remove('has-highlight');
        const ann = annByPrimitive.get(primitive);
        if (ann) ann.classList.remove('active');
        codeBlock!.querySelectorAll<HTMLElement>(`.code-line[data-primitive="${primitive}"]`)
          .forEach(l => l.classList.remove('highlighted'));
      }

      // Annotation hover → highlight code lines
      annotations.forEach(ann => {
        const primitive = ann.dataset.highlight;
        if (!primitive) return;
        ann.addEventListener('mouseenter', () => activate(primitive));
        ann.addEventListener('mouseleave', () => deactivate(primitive));
      });

      // Code line hover → highlight annotation
      codeBlock.querySelectorAll<HTMLElement>('.code-line[data-primitive]').forEach(line => {
        const primitive = line.dataset.primitive;
        if (!primitive) return;
        line.addEventListener('mouseenter', () => activate(primitive));
        line.addEventListener('mouseleave', () => deactivate(primitive));
      });
    }
  }
</script>
