---
// CodeShowcase.astro — "Show me the code" for the experiment / run model: an
// experiment is pure configuration (model, prompt, tool policy); a run is that
// config plus a cohort plus an agent version. Tool interception is one of four
// policies — history, passthrough, static, llm — set on the experiment.
---

<section class="dark-section section-pad" id="code-showcase">
  <div class="section-inner">
    <span class="section-eyebrow" data-reveal>SEE THE CODE</span>
    <h2 class="section-title showcase-title" data-reveal data-reveal-delay="1">
      One cohort, one changed variable, two runs.
    </h2>
    <p class="showcase-note" data-reveal data-reveal-delay="1">
An experiment holds the configuration; a run pins it to a cohort and a version. Same model in Python and TypeScript. Hover any line.
    </p>

    <div class="showcase-grid">

      <!-- Left: code window -->
      <div class="showcase-code" data-reveal="fade-left" data-reveal-delay="2">
        <div class="showcase-code-window">
          <div class="showcase-code-header">
            <div class="showcase-code-dots">
              <span class="code-dot"></span>
              <span class="code-dot"></span>
              <span class="code-dot"></span>
            </div>
            <div class="showcase-lang-tabs" role="tablist" aria-label="SDK language">
              <button type="button" role="tab" aria-selected="true" data-lang-tab="python">Python</button>
              <button type="button" role="tab" aria-selected="false" data-lang-tab="typescript">TypeScript</button>
            </div>
            <span class="showcase-code-filename" data-code-filename>migration.py</span>
          </div>
          <pre class="showcase-code-pre code-syntax" data-lang-panel="python" data-filename="migration.py" aria-label="Example Kitaru migration in Python: build a cohort, define an experiment whose tool calls are answered from recorded history, then run it twice one agent version apart and compare"><code><span class="code-line"><span class="kw">import</span> kitaru</span>
<span class="code-line"> </span>
<span class="code-line">client <span class="op">=</span> kitaru.<span class="fn">KitaruClient</span>()</span>
<span class="code-line"> </span>
<span class="code-line"><span class="cmt"># the sessions that matter, frozen as a named set</span></span>
<span class="code-line" data-primitive="cohort">cohort <span class="op">=</span> client.cohorts.<span class="fn">create</span>(</span>
<span class="code-line code-line-indent" data-primitive="cohort"><span class="str">"checkout-flow"</span>, sessions<span class="op">=</span>session_ids,</span>
<span class="code-line" data-primitive="cohort">)</span>
<span class="code-line"> </span>
<span class="code-line"><span class="cmt"># configuration only — no cohort, no version</span></span>
<span class="code-line" data-primitive="experiment">experiment <span class="op">=</span> client.experiments.<span class="fn">create</span>(</span>
<span class="code-line code-line-indent" data-primitive="experiment"><span class="str">"cheap-model"</span>,</span>
<span class="code-line code-line-indent" data-primitive="model">model<span class="op">=</span><span class="str">"glm-5.4"</span>,</span>
<span class="code-line code-line-indent" data-primitive="policy">tool_policy<span class="op">=</span><span class="fn">History</span>(scope<span class="op">=</span><span class="str">"cohort"</span>, on_miss<span class="op">=</span><span class="str">"fail"</span>),</span>
<span class="code-line" data-primitive="experiment">)</span>
<span class="code-line"> </span>
<span class="code-line"><span class="cmt"># a run is config + cohort + version. runs are what you compare.</span></span>
<span class="code-line" data-primitive="run">before <span class="op">=</span> experiment.<span class="fn">run</span>(cohort<span class="op">=</span>cohort, version<span class="op">=</span><span class="str">"v1"</span>)</span>
<span class="code-line" data-primitive="run">after <span class="op">=</span> experiment.<span class="fn">run</span>(cohort<span class="op">=</span>cohort, version<span class="op">=</span><span class="str">"pr-311"</span>)</span>
<span class="code-line"> </span>
<span class="code-line" data-primitive="compare">client.<span class="fn">compare</span>(before, after)</span></code></pre>
          <pre class="showcase-code-pre code-syntax" data-lang-panel="typescript" data-filename="migration.ts" hidden aria-label="Example Kitaru migration in TypeScript: build a cohort, define an experiment whose tool calls are answered from recorded history, then run it twice one agent version apart and compare"><code><span class="code-line"><span class="kw">import</span> &#123; KitaruClient, History &#125; <span class="kw">from</span> <span class="str">"kitaru"</span>;</span>
<span class="code-line"> </span>
<span class="code-line"><span class="kw">const</span> client <span class="op">=</span> <span class="kw">new</span> <span class="fn">KitaruClient</span>();</span>
<span class="code-line"> </span>
<span class="code-line"><span class="cmt">// the sessions that matter, frozen as a named set</span></span>
<span class="code-line" data-primitive="cohort"><span class="kw">const</span> cohort <span class="op">=</span> <span class="kw">await</span> client.cohorts.<span class="fn">create</span>(</span>
<span class="code-line code-line-indent" data-primitive="cohort"><span class="str">"checkout-flow"</span>, &#123; sessions: sessionIds &#125;,</span>
<span class="code-line" data-primitive="cohort">);</span>
<span class="code-line"> </span>
<span class="code-line"><span class="cmt">// configuration only — no cohort, no version</span></span>
<span class="code-line" data-primitive="experiment"><span class="kw">const</span> experiment <span class="op">=</span> <span class="kw">await</span> client.experiments.<span class="fn">create</span>(<span class="str">"cheap-model"</span>, &#123;</span>
<span class="code-line code-line-indent" data-primitive="model">model: <span class="str">"glm-5.4"</span>,</span>
<span class="code-line code-line-indent" data-primitive="policy">toolPolicy: <span class="fn">History</span>(&#123; scope: <span class="str">"cohort"</span>, onMiss: <span class="str">"fail"</span> &#125;),</span>
<span class="code-line" data-primitive="experiment">&#125;);</span>
<span class="code-line"> </span>
<span class="code-line"><span class="cmt">// a run is config + cohort + version. runs are what you compare.</span></span>
<span class="code-line" data-primitive="run"><span class="kw">const</span> before <span class="op">=</span> <span class="kw">await</span> experiment.<span class="fn">run</span>(&#123; cohort, version: <span class="str">"v1"</span> &#125;);</span>
<span class="code-line" data-primitive="run"><span class="kw">const</span> after <span class="op">=</span> <span class="kw">await</span> experiment.<span class="fn">run</span>(&#123; cohort, version: <span class="str">"pr-311"</span> &#125;);</span>
<span class="code-line"> </span>
<span class="code-line" data-primitive="compare"><span class="kw">await</span> client.<span class="fn">compare</span>(before, after);</span></code></pre>
        </div>
      </div>

      <!-- Right: annotation callouts -->
      <div class="showcase-annotations" data-reveal="fade-right" data-reveal-delay="3">
        <div class="annotation" data-highlight="cohort">
          <code class="annotation-label">cohorts.create()</code>
          <p>An immutable set of sessions &mdash; a run depends on its cohort, so a mutable one would make old results meaningless.</p>
        </div>
        <div class="annotation" data-highlight="experiment">
          <code class="annotation-label">experiments.create()</code>
          <p>Pure configuration. Change the code and you get a new run; change the prompt and you get a new experiment.</p>
        </div>
        <div class="annotation" data-highlight="model">
          <code class="annotation-label">model="glm-5.4"</code>
          <p>The variable under test. A run that moved two things cannot tell you which one did it.</p>
        </div>
        <div class="annotation" data-highlight="policy">
          <code class="annotation-label">History(scope="cohort")</code>
          <p>One of four policies &mdash; <code>history</code>, <code>passthrough</code>, <code>static</code>, <code>llm</code>. Every intercepted node is stamped with the one that answered it.</p>
        </div>
        <div class="annotation" data-highlight="run">
          <code class="annotation-label">experiment.run()</code>
          <p>Each replay creates a new session instead of overwriting the original, so the baseline survives intact.</p>
        </div>
        <div class="annotation" data-highlight="compare">
          <code class="annotation-label">compare(before, after)</code>
          <p>No verdict, no blended score. Two runs, side by side, read by you.</p>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .showcase-title {
    color: var(--color-dark-text);
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 1fr);
    gap: 40px;
    align-items: start;
    margin-top: 40px;
  }

  .showcase-code {
    min-width: 0;
  }

  /* Code window — reuses Architecture patterns */
  .showcase-code-window {
    background: oklch(0.16 0.015 60);
    border: 1px solid oklch(1 0 0 / 0.08);
    border-radius: 12px;
    overflow: hidden;
  }

  .showcase-code-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid oklch(1 0 0 / 0.06);
  }

  .showcase-code-dots {
    display: flex;
    gap: 6px;
  }

  .showcase-code-filename {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: oklch(1 0 0 / 0.35);
    margin-left: auto;
  }

  /* Python / TypeScript toggle in the window header */
  .showcase-lang-tabs {
    display: inline-flex;
    gap: 2px;
    padding: 2px;
    background: oklch(1 0 0 / 0.05);
    border: 1px solid oklch(1 0 0 / 0.08);
    border-radius: 6px;
  }

  .showcase-lang-tabs button {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 3px 10px;
    border: none;
    background: transparent;
    color: oklch(1 0 0 / 0.45);
    border-radius: 4px;
    cursor: pointer;
    transition: color 0.2s, background 0.2s;
  }

  .showcase-lang-tabs button[aria-selected="true"] {
    background: oklch(0.65 0.16 45 / 0.18);
    color: var(--color-dark-text);
  }

  .showcase-lang-tabs button:not([aria-selected="true"]):hover {
    color: oklch(1 0 0 / 0.7);
  }

  .showcase-code-pre {
    padding: 20px;
    margin: 0;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.65;
    color: var(--color-dark-text);
    -webkit-overflow-scrolling: touch;
  }

  /* Highlight lines */
  .code-line {
    transition: background 0.2s, opacity 0.2s;
    border-radius: 3px;
    padding: 0 4px;
    margin: 0 -4px;
  }

  .code-line-indent {
    padding-left: 22px;
  }

  .code-line[data-primitive] {
    cursor: default;
  }

  .code-line.highlighted {
    background: oklch(0.65 0.16 45 / 0.12);
  }

  /* Dim non-highlighted lines when any highlight is active */
  .showcase-code-pre.has-highlight .code-line:not(.highlighted) {
    opacity: 0.35;
  }

  .showcase-code-pre.has-highlight .code-line.highlighted {
    opacity: 1;
  }

  /* Dim non-active annotations when a highlight is active */
  .showcase-annotations.has-highlight .annotation:not(.active) {
    opacity: 0.4;
  }

  .showcase-annotations.has-highlight .annotation.active {
    opacity: 1;
  }

  /* Annotations */
  .showcase-annotations {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  .annotation {
    padding: 14px 18px;
    border-radius: 10px;
    border: 1px solid oklch(1 0 0 / 0.08);
    background: oklch(1 0 0 / 0.03);
    cursor: default;
    transition: border-color 0.2s, background 0.2s, opacity 0.2s;
  }

  .annotation:hover,
  .annotation.active {
    border-color: oklch(0.65 0.16 45 / 0.3);
    background: oklch(0.65 0.16 45 / 0.06);
  }

  .annotation-label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-accent);
    margin-bottom: 4px;
  }

  .annotation p {
    font-size: 0.8rem;
    line-height: 1.5;
    color: oklch(1 0 0 / 0.55);
    margin: 0;
  }

  /* Intended-API note under the title */
  .showcase-note {
    max-width: 760px;
    margin: 14px 0 0;
    font-size: 0.85rem;
    line-height: 1.6;
    font-weight: 300;
    color: oklch(1 0 0 / 0.5);
  }

  @media (max-width: 768px) {
    .showcase-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .showcase-code-window::after {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: 32px;
      background: linear-gradient(90deg, transparent, oklch(0.16 0.015 60));
      pointer-events: none;
      border-radius: 0 12px 12px 0;
    }

    .showcase-code {
      position: relative;
    }

    .showcase-code-pre {
      font-size: 0.68rem;
    }
  }
</style>

<script>
  const section = document.getElementById('code-showcase');
  if (section) {
    const annotations = section.querySelectorAll<HTMLElement>('.annotation');
    const codeBlocks = Array.from(
      section.querySelectorAll<HTMLElement>('.showcase-code-pre'),
    );
    const annContainer = section.querySelector<HTMLElement>('.showcase-annotations');
    // Touch devices can't hover — the highlight would get stuck on one item and
    // dim the rest, reading as "disabled". Keep the static code + list instead.
    const canHover = window.matchMedia('(hover: hover)').matches;
    if (codeBlocks.length && annContainer && canHover) {
      // Build lookup maps once. Both language panes carry the same
      // data-primitive markers, so highlight state is applied to every pane
      // (via the cached line lists) and survives a toggle.
      const annByPrimitive = new Map<string, HTMLElement>();
      annotations.forEach(ann => {
        const p = ann.dataset.highlight;
        if (p) annByPrimitive.set(p, ann);
      });

      const linesByPrimitive = new Map<string, HTMLElement[]>();
      codeBlocks.forEach(block => {
        block.querySelectorAll<HTMLElement>('.code-line[data-primitive]').forEach(line => {
          const primitive = line.dataset.primitive;
          if (!primitive) return;
          const lines = linesByPrimitive.get(primitive) ?? [];
          lines.push(line);
          linesByPrimitive.set(primitive, lines);
          // Code line hover → highlight annotation
          line.addEventListener('mouseenter', () => activate(primitive));
          line.addEventListener('mouseleave', () => deactivate(primitive));
        });
      });

      function activate(primitive: string) {
        annContainer!.classList.add('has-highlight');
        annByPrimitive.get(primitive)?.classList.add('active');
        codeBlocks.forEach(block => block.classList.add('has-highlight'));
        linesByPrimitive.get(primitive)?.forEach(l => l.classList.add('highlighted'));
      }

      function deactivate(primitive: string) {
        annContainer!.classList.remove('has-highlight');
        annByPrimitive.get(primitive)?.classList.remove('active');
        codeBlocks.forEach(block => block.classList.remove('has-highlight'));
        linesByPrimitive.get(primitive)?.forEach(l => l.classList.remove('highlighted'));
      }

      // Annotation hover → highlight code lines
      annotations.forEach(ann => {
        const primitive = ann.dataset.highlight;
        if (!primitive) return;
        ann.addEventListener('mouseenter', () => activate(primitive));
        ann.addEventListener('mouseleave', () => deactivate(primitive));
      });
    }

    // Python / TypeScript toggle. Python is the launch-decision default;
    // both panes are server-rendered and this only flips `hidden`.
    const langTabs = Array.from(
      section.querySelectorAll<HTMLButtonElement>('[data-lang-tab]'),
    );
    const langPanels = Array.from(
      section.querySelectorAll<HTMLElement>('[data-lang-panel]'),
    );
    const filename = section.querySelector<HTMLElement>('[data-code-filename]');
    langTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const lang = tab.dataset.langTab;
        if (!lang) return;
        langTabs.forEach(t =>
          t.setAttribute('aria-selected', t === tab ? 'true' : 'false'),
        );
        let shown: HTMLElement | undefined;
        langPanels.forEach(p => {
          p.hidden = p.dataset.langPanel !== lang;
          if (!p.hidden) shown = p;
        });
        // Each pane owns its filename via data-filename — no parallel map.
        if (filename && shown?.dataset.filename) {
          filename.textContent = shown.dataset.filename;
        }
        (window as any).__zenmlPlausibleTrack?.('Kitaru: SDK Language Switch', { lang });
      });
    });
  }
</script>
