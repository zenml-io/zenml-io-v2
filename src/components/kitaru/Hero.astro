---
// Hero.astro — Centered hero with dot-grid canvas + mesh gradient background
import {
  KITARU_INSTALL_CMD,
  KITARU_LICENSE,
  KITARU_LINKS,
} from "../../lib/productKitaru";
---

<section class="hero-section" id="hero">
  <canvas class="ascii-canvas" aria-hidden="true"></canvas>
  <div class="mesh-gradient" aria-hidden="true">
    <div class="mesh-blob mesh-blob-1"></div>
    <div class="mesh-blob mesh-blob-2"></div>
    <div class="mesh-blob mesh-blob-3"></div>
  </div>

  <div class="hero-content">
    <div class="hero-copy">
      <div class="hero-badges" data-reveal>
        <span class="pill-badge">
          <span class="pulse-dot"></span>
          Kitaru by ZenML
        </span>
        <span class="pill-badge">
          Open source · {KITARU_LICENSE}
        </span>
      </div>

      <h1 class="hero-headline" data-reveal data-reveal-delay="1">
        Traces you can <span class="hero-accent">run</span>, not just read
      </h1>

      <p class="hero-kicker" data-reveal data-reveal-delay="2">
        Score what happened. Replay what could have.
      </p>

      <p class="hero-subtitle" data-reveal data-reveal-delay="2">
        Your agent&rsquo;s real traces become frozen, replayable worlds for your real code &mdash; the test suite production already wrote.
      </p>

      <p class="hero-install-tag" data-reveal data-reveal-delay="3">Lightweight, wraps your existing agent</p>

      <div class="hero-install" data-reveal data-reveal-delay="3">
        <code class="install-cmd">{KITARU_INSTALL_CMD}</code>
        <button class="copy-btn" aria-label="Copy install command" data-copy={KITARU_INSTALL_CMD}>
          <svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
          <svg class="check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
        </button>
      </div>

      <div class="hero-buttons" data-reveal data-reveal-delay="4">
        <a href={KITARU_LINKS.demo.href} class="btn-primary">{KITARU_LINKS.demo.label}</a>
        <a href={KITARU_LINKS.github.href} target="_blank" rel="noopener" class="btn-secondary hero-gh-btn">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
          {KITARU_LINKS.github.label}
        </a>
      </div>
    </div>

    <div class="hero-visual" data-reveal data-reveal-delay="3">
      <div class="hv-panel" role="img" aria-label="Example: wrap your agent with the Kitaru adapter, import a failing production trace onto it, score it, replay it against the agent's real code until it reproduces, then verify the fix on the cohort of 23 sessions like it">
        <div class="hv-panel-head">
          <span class="hv-panel-dots">
            <span class="hv-dot"></span>
            <span class="hv-dot"></span>
            <span class="hv-dot"></span>
          </span>
          <span class="hv-panel-title">replay · support-agent</span>
          <span class="hv-panel-badge">case</span>
        </div>

        <div class="hv-code">
          <div class="hv-code-line hv-code-comment"># wrap your agent, then pull in a real failure</div>
          <div class="hv-code-line">agent <span class="hv-code-op">=</span> <span class="hv-code-fn">KitaruAgent</span>(support_agent)</div>
          <div class="hv-code-line">bad <span class="hv-code-op">=</span> agent.sessions.<span class="hv-code-fn">import_</span>(<span class="hv-code-str">"trace://8f3a91c2"</span>)</div>
          <div class="hv-code-line">&nbsp;</div>
          <div class="hv-code-line hv-code-comment"># score what happened &mdash; the agent never runs</div>
          <div class="hv-code-line hv-code-hl">agent.<span class="hv-code-fn">score</span>(bad, scorers<span class="hv-code-op">=</span>[<span class="hv-code-str">"refund_resolved"</span>])</div>
          <div class="hv-code-line">&nbsp;</div>
          <div class="hv-code-line hv-code-comment"># replay it against your real code</div>
          <div class="hv-code-line hv-code-hl">agent.<span class="hv-code-fn">replay</span>(bad, repeats<span class="hv-code-op">=</span><span class="hv-code-str">10</span>)</div>
          <div class="hv-code-line">&nbsp;</div>
          <div class="hv-code-line hv-code-comment"># fork the failing step, swap the tool</div>
          <div class="hv-code-line hv-code-hl">agent.<span class="hv-code-fn">replay</span>(bad, tools<span class="hv-code-op">=</span>&#123;<span class="hv-code-str">"refund"</span>: stub_ok&#125;)</div>
          <div class="hv-code-line">&nbsp;</div>
          <div class="hv-code-line hv-code-comment"># fix &mdash; then verify on every failure like it</div>
          <div class="hv-code-line">cohort <span class="hv-code-op">=</span> agent.<span class="hv-code-fn">cohort</span>(refund_resolved <span class="hv-code-op">&lt;</span> <span class="hv-code-str">0.5</span>)</div>
          <div class="hv-code-line hv-code-hl">agent.<span class="hv-code-fn">replay</span>(cohort, name<span class="hv-code-op">=</span><span class="hv-code-str">"refund-errors"</span>)</div>
        </div>

        <div class="hv-diff">
          <div class="hv-diff-row hv-diff-head">
            <span>Step</span>
            <span>Outcome</span>
          </div>
          <div class="hv-diff-row">
            <span class="hv-diff-label">Score every session</span>
            <span class="hv-mono-cell">23 fail the same way</span>
          </div>
          <div class="hv-diff-row">
            <span class="hv-diff-label">Replay &times;10</span>
            <span class="hv-mono-cell">failure reproduces 10 / 10</span>
          </div>
          <div class="hv-diff-row">
            <span class="hv-diff-label">Fork &middot; healthy tool</span>
            <span class="hv-mono-cell">agent recovers &mdash; fault isolated</span>
          </div>
          <div class="hv-diff-row">
            <span class="hv-diff-label">Fix &middot; all 23</span>
            <span class="hv-mono-cell hv-diff-win">PASS &mdash; guards every PR</span>
          </div>
        </div>

        <div class="hv-caption">
          The complaint is now a regression test that runs on every PR.
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(72px, 12vh, 120px) clamp(24px, 5vw, 80px) clamp(56px, 9vh, 88px);
    overflow: hidden;
  }

  .ascii-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  /* ─── Mesh gradient ─── */
  .mesh-gradient {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }

  .mesh-blob {
    position: absolute;
    border-radius: 50%;
    will-change: transform;
  }

  .mesh-blob-1 {
    width: 1100px;
    height: 1100px;
    top: -20%;
    left: -15%;
    background: radial-gradient(circle, oklch(0.65 0.16 45 / 0.18) 0%, oklch(0.65 0.16 45 / 0.06) 40%, transparent 65%);
    animation: meshFloat1 10s ease-in-out infinite alternate;
  }

  .mesh-blob-2 {
    width: 1000px;
    height: 1000px;
    bottom: -25%;
    right: -15%;
    background: radial-gradient(circle, oklch(0.68 0.08 55 / 0.14) 0%, oklch(0.68 0.08 55 / 0.05) 40%, transparent 65%);
    animation: meshFloat2 13s ease-in-out infinite alternate;
  }

  .mesh-blob-3 {
    width: 900px;
    height: 900px;
    top: 20%;
    left: 30%;
    background: radial-gradient(circle, oklch(0.65 0.16 45 / 0.12) 0%, oklch(0.65 0.16 45 / 0.04) 40%, transparent 65%);
    animation: meshFloat3 8s ease-in-out infinite alternate;
  }

  @keyframes meshFloat1 {
    0%   { transform: translate(0, 0) scale(1); }
    25%  { transform: translate(20%, 12%) scale(1.2); }
    50%  { transform: translate(-8%, 25%) scale(0.9); }
    75%  { transform: translate(15%, -8%) scale(1.15); }
    100% { transform: translate(-5%, 15%) scale(1.05); }
  }

  @keyframes meshFloat2 {
    0%   { transform: translate(0, 0) scale(1); }
    25%  { transform: translate(-18%, -10%) scale(1.15); }
    50%  { transform: translate(12%, -20%) scale(0.85); }
    75%  { transform: translate(-10%, 8%) scale(1.1); }
    100% { transform: translate(8%, -12%) scale(0.95); }
  }

  @keyframes meshFloat3 {
    0%   { transform: translate(0, 0) scale(1); }
    33%  { transform: translate(-25%, 20%) scale(1.25); }
    66%  { transform: translate(20%, -15%) scale(0.85); }
    100% { transform: translate(-10%, 5%) scale(1.1); }
  }

  .hero-content {
    position: relative;
    z-index: 10;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
    max-width: 1200px;
    width: 100%;
    text-align: left;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: flex-start;
    margin-bottom: 32px;
  }

  .hero-headline {
    font-size: clamp(2.4rem, 4.4vw, 3.6rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin: 0 0 18px;
    color: var(--color-primary);
  }

  .hero-accent {
    color: var(--color-accent);
    background: linear-gradient(
      90deg,
      var(--color-accent) 0%,
      oklch(0.78 0.14 55) 40%,
      var(--color-accent) 80%
    );
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: accent-shimmer 4s ease-in-out infinite;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    font-weight: 300;
    line-height: 1.65;
    color: var(--color-secondary);
    max-width: 560px;
    margin: 0 0 40px;
  }

  .hero-slogan {
    display: block;
    color: var(--color-primary);
    font-weight: 500;
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }

  .hero-kicker {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.01em;
    color: var(--color-accent);
    font-weight: 500;
    margin: 0 0 18px;
  }

  .hero-buttons {
    display: flex;
    gap: 14px;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero-gh-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  /* Install command */
  .hero-install {
    display: inline-flex;
    align-items: center;
    gap: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 4px 4px 4px 20px;
    margin-bottom: 20px;
    transition: border-color 0.3s, box-shadow 0.3s;
  }

  .hero-install:hover {
    border-color: oklch(0.65 0.16 45 / 0.3);
    box-shadow: 0 0 0 3px oklch(0.65 0.16 45 / 0.06);
  }

  .install-cmd {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-primary);
    user-select: all;
    letter-spacing: -0.01em;
  }

  .hero-install-tag {
    margin: 0 0 8px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.01em;
    color: var(--color-muted);
    white-space: nowrap;
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: none;
    background: transparent;
    color: var(--color-muted);
    border-radius: 6px;
    cursor: pointer;
    transition: color 0.2s, background 0.2s;
    margin-left: 8px;
    flex-shrink: 0;
  }

  .copy-btn:hover {
    color: var(--color-primary);
    background: oklch(0 0 0 / 0.04);
  }

  .copy-btn .copy-icon,
  .copy-btn .check-icon {
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.15s;
  }

  .copy-btn .check-icon {
    display: none;
    color: var(--color-success);
  }

  .copy-btn.copied .copy-icon {
    display: none;
  }

  .copy-btn.copied .check-icon {
    display: block;
    animation: check-pop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes check-pop {
    0% { transform: scale(0); opacity: 0; }
    60% { transform: scale(1.2); }
    100% { transform: scale(1); opacity: 1; }
  }

  /* ─── Hero visual: replay-with-variants demo panel ─── */
  .hero-visual {
    display: flex;
    justify-content: flex-end;
    width: 100%;
    min-width: 0;
  }

  .hv-panel {
    width: 100%;
    max-width: 540px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
    font-family: var(--font-mono);
    box-shadow:
      0 0 0 1px oklch(0.65 0.16 45 / 0.06),
      0 30px 80px -40px oklch(0.65 0.16 45 / 0.35),
      0 12px 32px -16px oklch(0 0 0 / 0.15);
  }

  .hv-panel-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 16px;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-warm);
  }

  .hv-panel-dots {
    display: inline-flex;
    gap: 6px;
  }

  .hv-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: oklch(0.13 0.015 60 / 0.15);
  }

  .hv-panel-dots .hv-dot:nth-child(1) { background: oklch(0.72 0.16 25 / 0.45); }
  .hv-panel-dots .hv-dot:nth-child(2) { background: oklch(0.82 0.15 75 / 0.5); }
  .hv-panel-dots .hv-dot:nth-child(3) { background: oklch(0.74 0.12 145 / 0.45); }

  .hv-panel-title {
    flex: 1;
    font-size: 0.74rem;
    color: var(--color-muted);
    letter-spacing: 0.02em;
  }

  .hv-panel-badge {
    font-size: 0.66rem;
    color: var(--color-accent);
    background: oklch(0.65 0.16 45 / 0.08);
    border: 1px solid oklch(0.65 0.16 45 / 0.28);
    border-radius: 100px;
    padding: 3px 10px;
    text-transform: lowercase;
    letter-spacing: 0.06em;
    font-weight: 600;
  }

  .hv-code {
    padding: 11px 18px 12px;
    font-size: 0.76rem;
    line-height: 1.45;
    color: var(--color-primary);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    overflow-x: auto;
  }

  .hv-code-line { white-space: pre; }
  .hv-code-comment { color: var(--color-muted); font-style: italic; }
  .hv-code-fn { color: var(--color-accent); font-weight: 500; }
  .hv-code-str { color: oklch(0.5 0.13 155); }
  .hv-code-op { color: var(--color-muted); }
  .hv-code-hl {
    display: block;
    background: oklch(0.65 0.16 45 / 0.1);
    border-radius: 4px;
    margin: 0 -8px;
    padding: 0 8px;
  }

  /* ─── Hero visual: what-if diff table ─── */
  .hv-diff {
    display: flex;
    flex-direction: column;
  }

  .hv-diff-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 10px;
    padding: 8px 18px;
    font-size: 0.8rem;
    border-bottom: 1px solid var(--color-border);
  }

  .hv-diff-row:last-child {
    border-bottom: none;
  }

  .hv-diff-head {
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    font-weight: 600;
    background: var(--color-surface-warm);
    padding-top: 6px;
    padding-bottom: 6px;
  }

  .hv-diff-label {
    color: var(--color-secondary);
  }

  .hv-diff-win {
    color: var(--color-accent);
    font-weight: 600;
  }

  .hv-diff-was {
    color: var(--color-muted);
    text-decoration: line-through;
    margin-right: 6px;
  }

  .hv-mono-cell {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--color-primary);
  }

  .hv-caption {
    padding: 9px 16px;
    font-size: 0.7rem;
    color: var(--color-muted);
    text-align: center;
    letter-spacing: 0.01em;
    border-top: 1px solid var(--color-border);
    background: var(--color-surface-warm);
  }

  /* ─── Collapse to single column on narrower screens ─── */
  @media (max-width: 1024px) {
    .hero-content {
      grid-template-columns: 1fr;
      max-width: 720px;
      text-align: center;
    }

    .hero-copy {
      align-items: center;
    }

    .hero-badges {
      justify-content: center;
    }

    .hero-headline,
    .hero-subtitle {
      text-align: center;
    }

    .hero-subtitle {
      max-width: 560px;
    }

    .hero-buttons {
      justify-content: center;
    }

    .hero-visual {
      justify-content: center;
      margin-top: 8px;
    }

    .hv-panel {
      max-width: 480px;
    }
  }

  @media (max-width: 540px) {
    .hv-code {
      font-size: 0.72rem;
    }
  }

  @media (max-width: 768px) {
    .ascii-canvas {
      display: none;
    }

    .hero-section {
      min-height: auto;
      padding: 60px 24px 48px;
    }

    .hero-headline {
      font-size: clamp(2rem, 7vw, 2.6rem);
    }

    .hero-buttons {
      flex-direction: column;
      width: 100%;
      max-width: 320px;
    }

    .hero-buttons .btn-primary,
    .hero-buttons .btn-secondary {
      width: 100%;
      justify-content: center;
      text-align: center;
    }

    .mesh-blob-1 { width: 420px; height: 420px; }
    .mesh-blob-2 { width: 350px; height: 350px; }
    .mesh-blob-3 { width: 280px; height: 280px; }
  }

  @media (max-width: 480px) {
    .hero-section {
      padding: 48px 16px 36px;
    }

    .hero-badges {
      margin-bottom: 24px;
    }

    .hero-headline {
      font-size: clamp(2rem, 7vw, 2.6rem);
      margin-bottom: 18px;
    }

    .hero-subtitle {
      font-size: 0.95rem;
      margin-bottom: 32px;
    }

    .pill-badge {
      font-size: 0.7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mesh-blob {
      animation: none;
    }

    .hero-accent {
      -webkit-text-fill-color: var(--color-accent);
      background: none;
      animation: none;
    }
  }
</style>

<script>
  // ─── Copy-to-clipboard for Hero install command only ───
  import { copyToClipboard } from '../../scripts/kitaru/clipboard';

  document.querySelectorAll<HTMLButtonElement>('#hero .copy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const text = btn.dataset.copy ?? '';
      copyToClipboard(text).then(() => {
        btn.classList.add('copied');
        setTimeout(() => btn.classList.remove('copied'), 1500);
      }).catch(() => {
        btn.setAttribute('aria-label', 'Copy failed');
        setTimeout(() => btn.setAttribute('aria-label', 'Copy install command'), 2000);
      });
    });
  });
</script>

<script>
  // ─── Dot-grid background — WebGL2 fragment shader ───
  import { attachMouseTracker, attachResizeHandler } from '../../scripts/kitaru/canvas-utils';
  import { initHeroGL } from '../../scripts/kitaru/hero-gl';

  const canvas = document.querySelector<HTMLCanvasElement>('.ascii-canvas');
  if (canvas) {
    const section = canvas.closest('section')!;
    const controller = initHeroGL(canvas);

    if (!controller) {
      // No WebGL2 — hide canvas, mesh gradient blobs remain as visual fallback
      canvas.style.display = 'none';
    } else {
      const cleanupMouse = attachMouseTracker(
        section,
        canvas,
        (x, y) => controller.setMouse(x, y, true),
        () => controller.setMouse(-9999, -9999, false)
      );

      const observer = new IntersectionObserver((entries) => {
        controller.setVisible(entries[0].isIntersecting);
      }, { threshold: 0 });
      observer.observe(section);

      const cleanupResize = attachResizeHandler(() => controller.resize());

      // Unified teardown (available for future client-side transitions / HMR)
      (canvas as any).__heroCleanup = () => {
        cleanupMouse();
        cleanupResize();
        observer.disconnect();
        controller.destroy();
      };
    }
  }
</script>
