{
  "name": "zenml-io-v2",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:node": "DEV_NODE=1 astro dev",
    "build": "astro build && pagefind --site dist/client --glob '*ops-database/*.html'",
    "preview": "astro preview",
    "check": "astro check --tsconfig ./tsconfig.check.json",
    "check:tests": "astro sync && tsc --noEmit -p tsconfig.tests.json",
    "check:surface": "tsx scripts/check-surface-coverage.ts",
    "check:alt": "tsx scripts/check-alt-coverage.ts",
    "check:blog-covers": "tsx scripts/migrations/blog-covers-16x9.ts --check",
    "check:registry": "tsx scripts/check-registry.ts",
    "check:lockfile": "tsx scripts/check-lockfile.ts",
    "smoke:dist": "tsx scripts/check-dist-smoke.ts",
    "check:snapshots": "tsx scripts/check-dist-snapshots.ts",
    "snapshots:update": "tsx scripts/check-dist-snapshots.ts --update",
    "check:og": "tsx scripts/check-og-golden.ts",
    "og:golden:update": "tsx scripts/check-og-golden.ts --update",
    "check:worker": "tsx scripts/check-worker-runtime.ts",
    "check:worker-bindings": "tsx scripts/check-worker-bindings.ts",
    "check:islands": "tsx scripts/check-island-hydration.ts",
    "check:motion": "tsx scripts/check-motion.ts",
    "lint:design": "eslint \"src/**/*.{astro,ts,tsx}\" \"src/content/{compare-kitaru,compare-zenml}/**/*.mdx\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "tsx scripts/phase2/validate-content.ts",
    "validate:llmops": "tsx scripts/phase2/validate-content.ts --collection=llmops-database",
    "validate:mlops": "tsx scripts/phase2/validate-content.ts --collection=mlops-database",
    "og:compare": "tsx scripts/og/generate-compare-og.ts",
    "og:compare:write": "tsx scripts/og/generate-compare-og.ts --write",
    "og:sync": "tsx scripts/og/sync-default-og.ts",
    "og:default": "tsx scripts/og/generate-default-og.ts",
    "og:default:write": "tsx scripts/og/generate-default-og.ts --write",
    "images:convert": "tsx scripts/convert-images.ts",
    "lint": "biome check src/ tests/ vitest.config.ts scripts/check-dist-smoke.ts scripts/check-dist-snapshots.ts scripts/check-og-golden.ts scripts/og/ scripts/check-lockfile.ts scripts/check-island-hydration.ts scripts/check-motion.ts scripts/check-worker-bindings.ts scripts/check-worker-runtime.ts scripts/convert-images.ts && pnpm lint:design",
    "lint:fix": "biome check --fix src/ tests/ vitest.config.ts scripts/check-dist-smoke.ts scripts/check-dist-snapshots.ts scripts/check-og-golden.ts scripts/og/ scripts/check-lockfile.ts scripts/check-island-hydration.ts scripts/check-motion.ts scripts/check-worker-bindings.ts scripts/check-worker-runtime.ts scripts/convert-images.ts",
    "format": "biome format --write src/",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/cloudflare": "14.3.0",
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/mdx": "8.0.0",
    "@astrojs/preact": "6.0.5",
    "@astrojs/sitemap": "3.7.4",
    "@paper-design/shaders-react": "^0.0.81",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.3.1",
    "preact": "10.29.8",
    "sharp": "0.35.4",
    "shiki": "4.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@shadcn/lint": "0.1.1",
    "@types/culori": "^4.0.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "22.20.4",
    "@typescript-eslint/parser": "8.70.0",
    "cheerio": "^1.2.0",
    "culori": "^4.0.2",
    "domhandler": "^6.0.1",
    "eslint": "10.10.0",
    "eslint-plugin-astro": "3.1.0",
    "eslint-plugin-mdx": "3.8.1",
    "gray-matter": "^4.0.3",
    "pagefind": "^1.5.2",
    "playwright": "^1.63.0",
    "satori": "^0.33.4",
    "tsx": "^4.23.13",
    "vitest": "^5.0.0",
    "wrangler": "4.113.0",
    "yaml": "2.9.1"
  }
}
