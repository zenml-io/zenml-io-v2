{
  "name": "zenml-io-v2",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist --glob '*ops-database/*.html'",
    "preview": "astro preview",
    "check": "astro check --tsconfig ./tsconfig.check.json",
    "check:tests": "astro sync && tsc --noEmit -p tsconfig.tests.json",
    "check:surface": "tsx scripts/check-surface-coverage.ts",
    "check:alt": "tsx scripts/check-alt-coverage.ts",
    "smoke:dist": "tsx scripts/check-dist-smoke.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "tsx scripts/phase2/validate-content.ts",
    "validate:llmops": "tsx scripts/phase2/validate-content.ts --collection=llmops-database",
    "validate:mlops": "tsx scripts/phase2/validate-content.ts --collection=mlops-database",
    "og:compare": "tsx scripts/og/generate-compare-og.ts",
    "og:compare:write": "tsx scripts/og/generate-compare-og.ts --write",
    "lint": "biome check src/ tests/ vitest.config.ts scripts/check-dist-smoke.ts",
    "lint:fix": "biome check --fix src/ tests/ vitest.config.ts scripts/check-dist-smoke.ts",
    "format": "biome format --write src/",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "^12.6.12",
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/preact": "^4.1.3",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^5.17.1",
    "lottie-web": "^5.13.0",
    "preact": "^10.29.3",
    "sharp": "^0.35.2",
    "shiki": "^4.2.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@resvg/resvg-js": "^2.6.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.0.1",
    "cheerio": "^1.2.0",
    "domhandler": "^6.0.1",
    "gray-matter": "^4.0.3",
    "pagefind": "^1.5.2",
    "playwright": "^1.61.1",
    "satori": "^0.26.0",
    "tsx": "^4.22.4",
    "vitest": "^3.2.6",
    "wrangler": "^4.105.0"
  }
}
